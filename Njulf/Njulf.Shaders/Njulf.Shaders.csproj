        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiGuidedShaderVariant Include="ddgi_simple_blend_guided.comp">
        <Source>ddgi_simple_blend.comp</Source>
      </SimpleDdgiGuidedShaderVariant>
      <SimpleDdgiGuidedShaderVariant Include="ddgi_simple_relocate_classify_guided.comp">
