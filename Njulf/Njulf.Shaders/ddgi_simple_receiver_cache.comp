#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#ifndef NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
#define NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION 0
#endif

#include "common.glsl"
#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
#include "ddgi_receiver_feedback_source_abi.glsl"
#include "ddgi_receiver_feedback_producer.glsl"
#endif

// Current-frame depth prediction is the sole owner of opaque page demand.
// This cache remains read-only with respect to residency, while one cache
// invocation per 8x8 source-pixel tile contributes to the independent B1
// scheduler-priority bank.
#define SIMPLE_DDGI_GATHER_DIAGNOSTIC_SAMPLE_WEIGHT 0u
#define SIMPLE_DDGI_RECEIVER_DEMAND_SAMPLE false
#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
#define SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE false
#else
#define SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE (((gl_GlobalInvocationID.x & 3u) == 0u) && ((gl_GlobalInvocationID.y & 3u) == 0u))
#endif
#define SIMPLE_DDGI_RECEIVER_COVERAGE_HASH (((gl_GlobalInvocationID.x >> 2u) * 73856093u) ^ ((gl_GlobalInvocationID.y >> 2u) * 19349663u))
#define SIMPLE_DDGI_RECEIVER_CONSUMER_FLAGS SIMPLE_DDGI_RECEIVER_CONSUMER_OPAQUE
#define SIMPLE_DDGI_RECEIVER_RESIDENCY_FEEDBACK 0
#define SIMPLE_DDGI_RECEIVER_TOUCHES_RESIDENT 0
#define SIMPLE_DDGI_RECEIVER_DEMAND_FRAME_OFFSET 0u
#define SIMPLE_DDGI_OPAQUE_GATHER_ORACLE 0
#include "ddgi_simple_shared.glsl"
#undef SIMPLE_DDGI_RECEIVER_CONSUMER_FLAGS
#undef SIMPLE_DDGI_RECEIVER_COVERAGE_HASH
#undef SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE

const uint SIMPLE_DDGI_RECEIVER_CACHE_REFLECTION_ENABLED_FLAG = 1u << 0u;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform SimpleDdgiReceiverCachePushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndPadding;
    uint ScreenWidth;
    uint ScreenHeight;
    uint CacheWidth;
    uint CacheHeight;
    uint ParamsBufferIndex;
    uint DepthTextureIndex;
    uint CacheBufferIndex;
    uint ReceiverScale;
    uint FeedbackControlOffsetWords;
    uint FeedbackSamplePeriod;
    uint FeedbackSamplePhase;
    uint FeedbackMaximumOwnersPerTile;
} pc;

bool ReceiverCacheFinite(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool ReconstructReceiverPosition(
    ivec2 pixel,
    out vec3 worldPosition,
    out float depth)
{
    ivec2 extent = ivec2(int(pc.ScreenWidth), int(pc.ScreenHeight));
    if (any(lessThan(pixel, ivec2(0))) ||
        any(greaterThanEqual(pixel, extent)))
    {
        worldPosition = vec3(0.0);
        depth = 0.0;
        return false;
    }

    depth = texelFetch(
        BindlessTextures[nonuniformEXT(pc.DepthTextureIndex)],
        pixel,
        0).r;
    // Njulf uses reverse-Z and clears depth to zero.
    if (depth <= 0.000001 || isnan(depth) || isinf(depth))
    {
        worldPosition = vec3(0.0);
        return false;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) /
        vec2(max(pc.ScreenWidth, 1u), max(pc.ScreenHeight, 1u));
    vec4 world = MulRowMajor(
        vec4(uv * 2.0 - vec2(1.0), depth, 1.0),
        pc.InverseViewProjectionMatrix);
    if (abs(world.w) <= 0.000001 || isnan(world.w) || isinf(world.w))
    {
        worldPosition = vec3(0.0);
        return false;
    }

    worldPosition = world.xyz / world.w;
    return ReceiverCacheFinite(worldPosition);
}

bool ReconstructReceiverPosition(ivec2 pixel, out vec3 worldPosition)
{
    float ignoredDepth;
    return ReconstructReceiverPosition(pixel, worldPosition, ignoredDepth);
}

bool SelectRepresentativeReceiver(
    uvec2 cacheCoord,
    out ivec2 pixel,
    out vec3 worldPosition,
    out float receiverDepth)
{
    uint scale = max(pc.ReceiverScale, 1u);
    ivec2 blockBase = ivec2(cacheCoord * scale);
    ivec2 centerPixel = blockBase + ivec2(int(scale / 2u));
    float centerDepth;
    if (ReconstructReceiverPosition(
            centerPixel,
            worldPosition,
            centerDepth))
    {
        pixel = centerPixel;
        receiverDepth = centerDepth;
        return true;
    }

    float closestDepth = 0.0;
    bool found = false;
    pixel = blockBase;
    worldPosition = vec3(0.0);
    receiverDepth = -1.0;

    // Most occupied cells finish after one depth fetch. If the center is clear,
    // scan the complete bounded tile. This makes cache coverage a strict
    // consequence of current-frame opaque depth: every tile that can shade an
    // opaque fragment receives a valid representative, including one-pixel
    // rails, foliage cutouts, and triangle tips.
    for (uint sampleY = 0u; sampleY < scale; sampleY++)
    for (uint sampleX = 0u; sampleX < scale; sampleX++)
    {
        ivec2 candidatePixel = blockBase +
            ivec2(int(sampleX), int(sampleY));
        vec3 candidatePosition;
        float candidateDepth;
        if (!ReconstructReceiverPosition(
                candidatePixel,
                candidatePosition,
                candidateDepth))
        {
            continue;
        }

        if (!found || candidateDepth > closestDepth)
        {
            found = true;
            closestDepth = candidateDepth;
            pixel = candidatePixel;
            worldPosition = candidatePosition;
            receiverDepth = candidateDepth;
        }
    }

    return found;
}

bool SelectScreenDerivative(
    vec3 center,
    bool negativeValid,
    vec3 negativePosition,
    bool positiveValid,
    vec3 positivePosition,
    out vec3 derivative)
{
    vec3 negativeDerivative = center - negativePosition;
    vec3 positiveDerivative = positivePosition - center;
    if (negativeValid && positiveValid)
    {
        derivative = dot(negativeDerivative, negativeDerivative) <=
                dot(positiveDerivative, positiveDerivative)
            ? negativeDerivative
            : positiveDerivative;
        return true;
    }
    if (negativeValid)
    {
        derivative = negativeDerivative;
        return true;
    }
    if (positiveValid)
    {
        derivative = positiveDerivative;
        return true;
    }
    derivative = vec3(0.0);
    return false;
}

vec3 ReconstructReceiverNormal(ivec2 pixel, vec3 worldPosition, vec3 viewDirection)
{
    vec3 leftPosition;
    vec3 rightPosition;
    vec3 upPosition;
    vec3 downPosition;
    bool leftValid = ReconstructReceiverPosition(pixel + ivec2(-1, 0), leftPosition);
    bool rightValid = ReconstructReceiverPosition(pixel + ivec2(1, 0), rightPosition);
    bool upValid = ReconstructReceiverPosition(pixel + ivec2(0, -1), upPosition);
    bool downValid = ReconstructReceiverPosition(pixel + ivec2(0, 1), downPosition);

    vec3 dx;
    vec3 dy;
    bool dxValid = SelectScreenDerivative(
        worldPosition,
        leftValid,
        leftPosition,
        rightValid,
        rightPosition,
        dx);
    bool dyValid = SelectScreenDerivative(
        worldPosition,
        upValid,
        upPosition,
        downValid,
        downPosition,
        dy);

    vec3 normal = viewDirection;
    if (dxValid && dyValid)
    {
        vec3 candidate = cross(dx, dy);
        float lengthSquared = dot(candidate, candidate);
        if (lengthSquared > 0.0000001 && !isnan(lengthSquared) && !isinf(lengthSquared))
            normal = candidate * inversesqrt(lengthSquared);
    }

    // Opaque forward flips back-facing geometric normals toward the visible
    // side. Apply the same convention to the depth-derived normal.
    if (dot(normal, viewDirection) < 0.0)
        normal = -normal;
    return normalize(normal);
}

void StoreReceiverCacheSample(uint entryIndex, uvec4 packed)
{
    uint word = entryIndex * 4u;
    WriteStorageWordUniform(pc.CacheBufferIndex, word + 0u, packed.x);
    WriteStorageWordUniform(pc.CacheBufferIndex, word + 1u, packed.y);
    WriteStorageWordUniform(pc.CacheBufferIndex, word + 2u, packed.z);
    WriteStorageWordUniform(pc.CacheBufferIndex, word + 3u, packed.w);
}

uvec4 EmptyReceiverCacheSample()
{
    // A zero ten-bit depth code is reserved for invalid/empty entries.
    return uvec4(0u);
}

#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
uint CountCoveredReceiverPixels(uvec2 cacheCoord)
{
    uint scale = max(pc.ReceiverScale, 1u);
    ivec2 blockBase = ivec2(cacheCoord * scale);
    uint covered = 0u;
    for (uint sampleY = 0u; sampleY < scale; ++sampleY)
    for (uint sampleX = 0u; sampleX < scale; ++sampleX)
    {
        vec3 ignoredPosition;
        if (ReconstructReceiverPosition(
                blockBase + ivec2(int(sampleX), int(sampleY)),
                ignoredPosition))
        {
            covered++;
        }
    }
    return covered;
}

void EmitExactReceiverFeedbackProducer(
    SimpleDdgiGatherResult gather,
    uvec2 cacheCoord,
    uint entryIndex,
    float ownership,
    float leakAttenuation,
    float indirectIntensity)
{
    uint effectiveProducer =
        gather.exactFeedbackRefinementOrBaseFallback != 0u ? 6u : 0u;
    if (!SimpleDdgiReceiverFeedbackProducerControlIsValid(
            pc.FeedbackControlOffsetWords,
            effectiveProducer))
    {
        return;
    }
    uint samplingPeriod = SimpleDdgiReceiverFeedbackProducerControlWord(
        pc.FeedbackControlOffsetWords,
        SIMPLE_DDGI_RECEIVER_FEEDBACK_CAPTURE_CONTROL_SAMPLE_PERIOD);
    uint samplingPhase = SimpleDdgiReceiverFeedbackProducerControlWord(
        pc.FeedbackControlOffsetWords,
        SIMPLE_DDGI_RECEIVER_FEEDBACK_CAPTURE_CONTROL_SAMPLE_PHASE);
    uint maximumOwners = min(
        SimpleDdgiReceiverFeedbackProducerControlWord(
            pc.FeedbackControlOffsetWords,
            SIMPLE_DDGI_RECEIVER_FEEDBACK_CAPTURE_CONTROL_MAXIMUM_OWNERS),
        SIMPLE_DDGI_EXACT_FEEDBACK_MAX_OWNERS);
    if (samplingPeriod == 0u || samplingPhase >= samplingPeriod ||
        maximumOwners == 0u)
    {
        SimpleDdgiReceiverFeedbackMarkProducerFailure(
            pc.FeedbackControlOffsetWords,
            effectiveProducer,
            1u);
        return;
    }
    if (entryIndex % samplingPeriod != samplingPhase)
        return;

    if (gather.exactFeedbackOverflow != 0u ||
        gather.exactFeedbackOwnerCount > maximumOwners)
    {
        SimpleDdgiReceiverFeedbackMarkProducerFailure(
            pc.FeedbackControlOffsetWords,
            effectiveProducer,
            max(gather.exactFeedbackOwnerCount, 1u));
        return;
    }

    uint coveredPixels = CountCoveredReceiverPixels(cacheCoord);
    float physicalContribution = float(coveredPixels) *
        max(indirectIntensity, 0.0) *
        clamp(ownership, 0.0, 1.0) *
        clamp(leakAttenuation, 0.0, 1.0);
    if (coveredPixels == 0u || !(physicalContribution > 0.0) ||
        isnan(physicalContribution) || isinf(physicalContribution))
    {
        return;
    }

    SimpleDdgiReceiverFeedbackProducerReservation reservation =
        SimpleDdgiReceiverFeedbackReserveProducerRecords(
            pc.FeedbackControlOffsetWords,
            effectiveProducer,
            gather.exactFeedbackOwnerCount);
    uvec2 stableReceiverIdentity = uvec2(
        entryIndex,
        pc.CacheWidth ^ (pc.CacheHeight << 16u));
    float inverseInclusionProbability = float(samplingPeriod);
    for (uint ownerIndex = 0u;
         ownerIndex < gather.exactFeedbackOwnerCount;
         ++ownerIndex)
    {
        SimpleDdgiExactFeedbackOwner owner =
            gather.exactFeedbackOwners[ownerIndex];
        uint recordIndex;
        bool reserved = SimpleDdgiReceiverFeedbackTryGetReservationRecord(
            reservation,
            ownerIndex,
            recordIndex);
        if (!reserved)
            continue;

        SimpleDdgiReceiverFeedbackWriteCandidate(
            pc.FeedbackControlOffsetWords,
            recordIndex,
            effectiveProducer,
            owner.fallbackRole,
            owner.requestedProbe,
            owner.resolvedProbe,
            owner.resolvedPage,
            owner.requestedPage,
            entryIndex,
            owner.normalizedWeight,
            inverseInclusionProbability,
            physicalContribution,
            owner.pageGeneration,
            stableReceiverIdentity);
    }
}
#endif

uint EncodeReceiverCacheDepth(float depth)
{
    // Ten logarithmic bits cover reverse-Z through 2^-16 with roughly 1.1%
    // relative spacing. Code zero remains the invalid sentinel.
    float normalized = clamp(
        (log2(max(depth, 1.0 / 65536.0)) + 16.0) / 16.0,
        0.0,
        1.0);
    return 1u + uint(round(normalized * 1022.0));
}

uint EncodeReceiverCacheMetadata(
    float depth,
    float indirectSpecularVisibility,
    uint residencyFlags)
{
    // The gather entry remains sixteen bytes. Its metadata word carries a
    // 10-bit reverse-Z code, 10-bit rough-reflection visibility, and the two
    // 6-bit roughness-band edges consumed by the native cache shader:
    // [ depth:10 | visibility:10 | minimum:6 | full:6 ].
    uint visibilityCode = uint(round(
        clamp(indirectSpecularVisibility, 0.0, 1.0) * 1023.0));
    uint minimumCode = uint(round(clamp(
        SimpleDdgiRoughSpecularMinimumRoughness(residencyFlags),
        0.0,
        1.0) * 63.0));
    uint fullCode = uint(round(clamp(
        SimpleDdgiRoughSpecularFullWeightRoughness(residencyFlags),
        0.0,
        1.0) * 63.0));
    return EncodeReceiverCacheDepth(depth) |
        (visibilityCode << 10u) |
        (minimumCode << 20u) |
        (fullCode << 26u);
}

void main()
{
    uvec2 cacheCoord = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(cacheCoord, uvec2(pc.CacheWidth, pc.CacheHeight))))
        return;

    uint entryIndex = cacheCoord.y * pc.CacheWidth + cacheCoord.x;
    ivec2 receiverPixel;
    vec3 worldPosition;
    float receiverDepth;
    if (!SelectRepresentativeReceiver(
            cacheCoord,
            receiverPixel,
            worldPosition,
            receiverDepth))
    {
        StoreReceiverCacheSample(entryIndex, EmptyReceiverCacheSample());
        return;
    }

    vec3 viewVector = pc.CameraPositionAndPadding.xyz - worldPosition;
    float cameraDistance = length(viewVector);
    if (!(cameraDistance > 0.00001) || isnan(cameraDistance) || isinf(cameraDistance))
    {
        StoreReceiverCacheSample(entryIndex, EmptyReceiverCacheSample());
        return;
    }

    vec3 viewDirection = viewVector / cameraDistance;
    vec3 normal = ReconstructReceiverNormal(
        receiverPixel,
        worldPosition,
        viewDirection);
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    SimpleDdgiGatherResult gather = SampleSimpleDdgiGather(
        params,
        worldPosition,
        normal,
        viewDirection);

    vec3 irradiance = clamp(gather.irradiance, vec3(0.0), vec3(65504.0));
    if (!ReceiverCacheFinite(irradiance))
        irradiance = vec3(0.0);
    float ownership = clamp(SimpleDdgiRadiometricOwnership(gather), 0.0, 1.0);
    float leakAttenuation = clamp(
        SimpleDdgiLeakAttenuation(gather, params),
        0.0,
        1.0);
    float indirectSpecularVisibility =
        SimpleDdgiIndirectSpecularVisibility(gather, params);
    float environmentFallbackWeight =
        (1.0 - ownership) * params.environmentFallbackIntensity;
    GPUEnvironmentData environment = ReadEnvironmentData();
    GPUReflectionProbeHeader reflectionHeader = ReadReflectionProbeHeader();
    bool indirectReflectionsActive =
        environment.Enabled != 0u &&
        environment.SpecularIntensity > 0.0 &&
        (reflectionHeader.Flags &
            SIMPLE_DDGI_RECEIVER_CACHE_REFLECTION_ENABLED_FLAG) != 0u &&
        reflectionHeader.Intensity > 0.0;
    bool evaluateFarFieldFallback =
        environmentFallbackWeight >
            SIMPLE_DDGI_ENVIRONMENT_FALLBACK_MIN_WEIGHT ||
        (params.flags &
            SIMPLE_DDGI_FLAG_FORCE_LEGACY_FAR_FIELD_FALLBACK) != 0u;
    float farFieldSkyVisibility = 1.0;
    if ((evaluateFarFieldFallback || indirectReflectionsActive) &&
        (params.flags & SIMPLE_DDGI_FLAG_SKY_VISIBILITY_ENABLED) != 0u)
    {
        farFieldSkyVisibility = EstimateFarFieldSkyVisibility(
            worldPosition,
            normal,
            params,
            0u);
    }
    if (indirectReflectionsActive)
    {
        // Probe-to-receiver visibility only proves that the diffuse field can
        // reach this surface. Broad reflection lobes also need a far-field
        // enclosure test; otherwise an interior wall reflects the outdoor sky
        // at grazing angles and reads as a uniform metallic sheen. This runs
        // once per low-resolution cache receiver and leaves sharp lobes open
        // through the roughness weighting applied by the forward shader.
        indirectSpecularVisibility = min(
            indirectSpecularVisibility,
            farFieldSkyVisibility);
    }
    // All remaining composition is linear. Fold the global intensity,
    // radiometric ownership, leak attenuation, and far-field visibility here
    // so cache-specific mesh programs can reconstruct the four-corner field
    // without repeating transport composition.
    vec3 weightedIrradiance = clamp(
        irradiance * params.indirectIntensity * ownership * leakAttenuation,
        vec3(0.0),
        vec3(65504.0));
    float weightedEnvironmentFallback = clamp(
        environmentFallbackWeight * farFieldSkyVisibility,
        0.0,
        1.0);
    vec3 weightedEnvironmentIrradiance = vec3(0.0);
    if (environment.Enabled != 0u && weightedEnvironmentFallback > 0.0)
    {
        weightedEnvironmentIrradiance =
            EvaluateEnvironmentDiffuseIrradiance(environment, normal) *
            weightedEnvironmentFallback;
        if (!ReceiverCacheFinite(weightedEnvironmentIrradiance))
            weightedEnvironmentIrradiance = vec3(0.0);
        weightedEnvironmentIrradiance = clamp(
            weightedEnvironmentIrradiance,
            vec3(0.0),
            vec3(65504.0));
    }
    StoreReceiverCacheSample(
        entryIndex,
        uvec4(
            packHalf2x16(weightedIrradiance.xy),
            packHalf2x16(vec2(
                weightedIrradiance.z,
                weightedEnvironmentIrradiance.x)),
            packHalf2x16(weightedEnvironmentIrradiance.yz),
            // Keep reconstruction/visibility metadata separate from the six
            // FP16 radiance channels so neither irradiance field loses precision.
            EncodeReceiverCacheMetadata(
                receiverDepth,
                indirectSpecularVisibility,
                params.residencyFlags)));
#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
    EmitExactReceiverFeedbackProducer(
        gather,
        cacheCoord,
        entryIndex,
        ownership,
        leakAttenuation,
        params.indirectIntensity);
#endif
}
