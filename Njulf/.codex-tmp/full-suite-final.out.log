            controlOffsetWords,
            recordIndex,
            effectiveProducer,
            owner.fallbackRole,
            owner.requestedProbe,
            owner.resolvedProbe,
            owner.resolvedPage,
            owner.requestedPage,
            workgroupId,
            owner.normalizedWeight,
            float(samplingPeriod),
            physicalContribution,
            owner.pageGeneration,
            stableReceiverIdentity);
