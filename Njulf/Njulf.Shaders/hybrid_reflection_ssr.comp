#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionSsrPushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndMaximumDistance;
    uint ScreenWidth;
    uint ScreenHeight;
    uint MaximumSteps;
    uint HiZMipCount;
    float FullResolutionRoughness;
    float HalfResolutionRoughness;
    float QuarterResolutionRoughness;
    float ConfidenceThreshold;
    uint TemporalSampleIndex;
    uint HistoryValidAndCurrentFrameIndex;
    uint RayQueriesEnabled;
    uint RayAdmissionThreshold;
} pc;

struct HybridSsrTraceResult
{
    vec3 Radiance;
    float Confidence;
    vec2 HitUv;
    float HitDistance;
    bool Hit;
    bool LeftScreen;
};

uint HybridCurrentFrameIndex()
{
    return (pc.HistoryValidAndCurrentFrameIndex >> 1u) & 0x3u;
}

uint HybridHiZMipCount()
{
    return pc.HiZMipCount & 0xffffu;
}

uint HybridColorMipCount()
{
    return pc.HiZMipCount >> 16u;
}

bool HybridProjectRayDistance(
    vec3 origin,
    vec3 direction,
    float distanceAlongRay,
    mat4 viewProjection,
    out vec2 uv,
    out float reverseZ)
{
    vec3 position = origin + direction * distanceAlongRay;
    vec4 clip = MulRowMajor(vec4(position, 1.0), viewProjection);
    if (!HybridFinite(clip) || clip.w <= 1.0e-6)
    {
        uv = vec2(0.0);
        reverseZ = 0.0;
        return false;
    }
    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + vec2(0.5);
    reverseZ = ndc.z;
    return HybridFinite(uv) && HybridFinite(reverseZ);
}

bool HybridClipAxis(
    float start,
    float end,
    inout float minimumT,
    inout float maximumT)
{
    float delta = end - start;
    if (abs(delta) <= 1.0e-8)
        return start >= 0.0 && start <= 1.0;
    float first = (0.0 - start) / delta;
    float second = (1.0 - start) / delta;
    minimumT = max(minimumT, min(first, second));
    maximumT = min(maximumT, max(first, second));
    return maximumT >= minimumT;
}

bool HybridClipRayToScreen(
    vec2 startUv,
    vec2 endUv,
    inout float minimumDistance,
    inout float maximumDistance)
{
    float minimumT = 0.0;
    float maximumT = 1.0;
    if (!HybridClipAxis(startUv.x, endUv.x, minimumT, maximumT) ||
        !HybridClipAxis(startUv.y, endUv.y, minimumT, maximumT))
    {
        return false;
    }
    float range = maximumDistance - minimumDistance;
    float clippedMinimum = minimumDistance + range * clamp(minimumT, 0.0, 1.0);
    float clippedMaximum = minimumDistance + range * clamp(maximumT, 0.0, 1.0);
    minimumDistance = clippedMinimum;
    maximumDistance = clippedMaximum;
    return maximumDistance > minimumDistance + 1.0e-5;
}

float HybridDepthDifference(
    vec3 origin,
    vec3 direction,
    float distanceAlongRay,
    mat4 viewProjection,
    out vec2 uv,
    out float rayDepth)
{
    if (!HybridProjectRayDistance(origin, direction, distanceAlongRay,
            viewProjection, uv, rayDepth) ||
        any(lessThan(uv, vec2(0.0))) ||
        any(greaterThanEqual(uv, vec2(1.0))))
    {
        return -1.0;
    }
    return texture(HybridSceneDepth, uv).r - rayDepth;
}

float HybridRefineSsrCandidate(
    vec3 origin,
    vec3 direction,
    float frontDistance,
    float backDistance,
    mat4 viewProjection,
    out vec2 hitUv,
    out float hitRayDepth)
{
    float front = max(frontDistance, 0.0);
    float back = max(backDistance, front + 1.0e-5);
    vec2 ignoredUv;
    float ignoredDepth;
    float frontDifference = HybridDepthDifference(
        origin, direction, front, viewProjection,
        ignoredUv, ignoredDepth);
    float backDifference = HybridDepthDifference(
        origin, direction, back, viewProjection,
        hitUv, hitRayDepth);
    for (uint iteration = 0u; iteration < 4u; iteration++)
    {
        float denominator = backDifference - frontDifference;
        float candidate = abs(denominator) > 1.0e-7
            ? (front * backDifference - back * frontDifference) /
                denominator
            : 0.5 * (front + back);
        candidate = clamp(candidate,
            front + (back - front) * 0.1,
            back - (back - front) * 0.1);
        vec2 candidateUv;
        float candidateDepth;
        float difference = HybridDepthDifference(
            origin, direction, candidate, viewProjection,
            candidateUv, candidateDepth);
        if (difference >= 0.0)
        {
            back = candidate;
            backDifference = difference;
            hitUv = candidateUv;
            hitRayDepth = candidateDepth;
        }
        else
        {
            front = candidate;
            frontDifference = difference;
        }
    }
    return back;
}

bool HybridReconstructAtUv(
    vec2 uv,
    float depth,
    out vec3 worldPosition)
{
    vec4 world = MulRowMajor(
        vec4(uv * 2.0 - vec2(1.0), depth, 1.0),
        pc.InverseViewProjectionMatrix);
    if (!HybridFinite(world) || abs(world.w) <= 1.0e-7)
    {
        worldPosition = vec3(0.0);
        return false;
    }
    worldPosition = world.xyz / world.w;
    return HybridFinite(worldPosition);
}

float HybridProjectedPixelWorldSize(vec2 uv, float depth)
{
    vec3 centre;
    vec3 adjacent;
    vec2 onePixel = vec2(1.0 / max(float(pc.ScreenWidth), 1.0), 0.0);
    return HybridReconstructAtUv(uv, depth, centre) &&
           HybridReconstructAtUv(clamp(uv + onePixel,
               vec2(0.0), vec2(1.0)), depth, adjacent)
        ? max(length(adjacent - centre), 1.0e-4)
        : 0.01;
}

vec3 HybridSampleSceneColorCone(vec2 uv, float logicalLod)
{
    uint mipCount = min(HybridColorMipCount(),
        uint(MAX_BLOOM_MIP_TEXTURES));
    vec3 fullResolution = textureLod(
        BindlessTextures[nonuniformEXT(HDR_SCENE_COLOR_TEXTURE_INDEX)],
        uv, 0.0).rgb;
    if (mipCount == 0u || logicalLod <= 0.0)
        return max(fullResolution, vec3(0.0));

    float tailLod = max(logicalLod - 1.0, 0.0);
    uint lower = min(uint(floor(tailLod)), mipCount - 1u);
    uint upper = min(lower + 1u, mipCount - 1u);
    vec3 lowerValue = textureLod(
        BindlessTextures[nonuniformEXT(
            BLOOM_MIP_TEXTURE_BASE + int(lower))], uv, 0.0).rgb;
    vec3 upperValue = textureLod(
        BindlessTextures[nonuniformEXT(
            BLOOM_MIP_TEXTURE_BASE + int(upper))], uv, 0.0).rgb;
    vec3 tail = mix(lowerValue, upperValue, fract(tailLod));
    return max(mix(fullResolution, tail,
        clamp(logicalLod, 0.0, 1.0)), vec3(0.0));
}

HybridSsrTraceResult HybridTraceHierarchicalSsr(
    vec3 worldPosition,
    vec3 direction,
    float roughness,
    uint tier)
{
    HybridSsrTraceResult result;
    result.Radiance = vec3(0.0);
    result.Confidence = 0.0;
    result.HitUv = vec2(0.0);
    result.HitDistance = 0.0;
    result.Hit = false;
    result.LeftScreen = false;

    mat4 viewProjection =
        ReadMeshletTaskViewProjectionMatrix(HybridCurrentFrameIndex());
    float minimumDistance = 0.02;
    float maximumDistance = pc.CameraPositionAndMaximumDistance.w;
    vec2 startUv;
    vec2 endUv;
    float ignoredDepth;
    if (!HybridProjectRayDistance(worldPosition, direction,
            minimumDistance, viewProjection, startUv, ignoredDepth))
    {
        return result;
    }

    if (!HybridProjectRayDistance(worldPosition, direction,
            maximumDistance, viewProjection, endUv, ignoredDepth))
    {
        float low = minimumDistance;
        float high = maximumDistance;
        for (uint iteration = 0u; iteration < 8u; iteration++)
        {
            float middle = 0.5 * (low + high);
            vec2 candidateUv;
            float candidateDepth;
            if (HybridProjectRayDistance(worldPosition, direction,
                    middle, viewProjection, candidateUv, candidateDepth))
            {
                low = middle;
                endUv = candidateUv;
            }
            else
            {
                high = middle;
            }
        }
        maximumDistance = low;
    }
    if (!HybridClipRayToScreen(
            startUv, endUv, minimumDistance, maximumDistance))
    {
        result.LeftScreen = true;
        return result;
    }

    uint hizMipCount = max(HybridHiZMipCount(), 1u);
    vec2 dimensions = vec2(pc.ScreenWidth, pc.ScreenHeight);
    vec2 screenDirection = endUv - startUv;
    float screenLength = length(screenDirection * dimensions);
    vec2 normalizedScreenDirection = screenLength > 1.0e-5
        ? normalize(screenDirection * dimensions)
        : vec2(1.0, 0.0);
    float distanceAlongRay = minimumDistance;
    float previousDistance = minimumDistance;
    uint maximumSteps = max(pc.MaximumSteps / max(tier, 1u), 8u);
    uint currentMip = min(
        uint(max(floor(log2(float(max(tier, 1u)))), 0.0)),
        hizMipCount - 1u);

    for (uint stepIndex = 0u;
         stepIndex < maximumSteps && distanceAlongRay <= maximumDistance;
         stepIndex++)
    {
        vec2 uv;
        float rayDepth;
        if (!HybridProjectRayDistance(worldPosition, direction,
                distanceAlongRay, viewProjection, uv, rayDepth) ||
            any(lessThan(uv, vec2(0.0))) ||
            any(greaterThanEqual(uv, vec2(1.0))))
        {
            result.LeftScreen = true;
            break;
        }

        float cameraDistance = length(
            worldPosition + direction * distanceAlongRay -
            pc.CameraPositionAndMaximumDistance.xyz);
        float coneRadius = distanceAlongRay *
            tan(min(roughness * roughness * 0.78539816339, 0.75));
        float projectedFootprint = max(float(tier),
            coneRadius * max(dimensions.x, dimensions.y) /
                max(cameraDistance, 0.1));
        uint footprintMip = min(
            uint(max(floor(log2(max(projectedFootprint, 1.0))), 0.0)),
            hizMipCount - 1u);
        currentMip = min(currentMip, footprintMip);
        float farthestDepth = textureLod(
            BindlessTextures[nonuniformEXT(HIZ_DEPTH_TEXTURE_INDEX)],
            uv, float(currentMip)).r;
        float ndcThickness = 0.0005 +
            projectedFootprint / max(dimensions.y, 1.0) * 0.02;
        bool possibleIntersection = farthestDepth > 0.0 &&
            rayDepth <= farthestDepth + ndcThickness;
        if (possibleIntersection && currentMip > 0u)
        {
            currentMip--;
            continue;
        }
        if (possibleIntersection)
        {
            vec2 refinedUv = uv;
            float refinedRayDepth = rayDepth;
            float refinedDistance = HybridRefineSsrCandidate(
                worldPosition,
                direction,
                previousDistance,
                distanceAlongRay,
                viewProjection,
                refinedUv,
                refinedRayDepth);
            float sceneDepth = texture(HybridSceneDepth, refinedUv).r;
            vec3 sceneWorld;
            vec3 rayWorld = worldPosition + direction * refinedDistance;
            float thickness = max(0.01,
                HybridProjectedPixelWorldSize(refinedUv, sceneDepth) *
                    (2.0 + float(tier)));
            if (sceneDepth > 0.0 &&
                HybridReconstructAtUv(refinedUv, sceneDepth, sceneWorld) &&
                length(sceneWorld - rayWorld) <= thickness)
            {
                float edge = min(min(refinedUv.x, refinedUv.y),
                    min(1.0 - refinedUv.x, 1.0 - refinedUv.y));
                float edgeConfidence = smoothstep(0.0, 0.08, edge);
                float distanceConfidence = 1.0 - clamp(
                    refinedDistance / max(maximumDistance, 0.001),
                    0.0, 1.0);
                result.Confidence = clamp(edgeConfidence *
                    mix(0.55, 1.0, distanceConfidence), 0.0, 1.0);
                float colorLod = clamp(log2(max(projectedFootprint, 1.0)),
                    0.0, float(max(int(HybridColorMipCount()), 0)));
                result.Radiance = HybridSampleSceneColorCone(
                    refinedUv, colorLod);
                result.HitUv = refinedUv;
                result.HitDistance = refinedDistance;
                result.Hit = HybridFinite(result.Radiance);
                return result;
            }
        }

        previousDistance = distanceAlongRay;
        float cellPixels = exp2(float(currentMip + 1u));
        vec2 pixelPosition = uv * dimensions;
        vec2 nextBoundary = vec2(
            normalizedScreenDirection.x >= 0.0
                ? (floor(pixelPosition.x / cellPixels) + 1.0) * cellPixels
                : (ceil(pixelPosition.x / cellPixels) - 1.0) * cellPixels,
            normalizedScreenDirection.y >= 0.0
                ? (floor(pixelPosition.y / cellPixels) + 1.0) * cellPixels
                : (ceil(pixelPosition.y / cellPixels) - 1.0) * cellPixels);
        vec2 boundaryDistance = abs(nextBoundary - pixelPosition) /
            max(abs(normalizedScreenDirection), vec2(1.0e-4));
        float advancePixels = max(min(boundaryDistance.x,
            boundaryDistance.y) + 0.5, 1.0);
        float distancePerPixel = (maximumDistance - minimumDistance) /
            max(screenLength, 1.0);
        distanceAlongRay += max(advancePixels * distancePerPixel,
            (maximumDistance - minimumDistance) / float(maximumSteps));
        currentMip = min(currentMip + 1u, footprintMip);
    }
    return result;
}

bool IsDisoccluded(
    ivec2 pixel,
    uint identity,
    vec3 worldPosition,
    vec3 currentNormal)
{
    if ((pc.HistoryValidAndCurrentFrameIndex & 1u) == 0u)
        return false;
    vec2 dimensions = vec2(pc.ScreenWidth, pc.ScreenHeight);
    vec2 uv = (vec2(pixel) + vec2(0.5)) / dimensions;
    vec2 motion = texelFetch(HybridMotionVectors, pixel, 0).rg;
    vec2 previousUv = uv - motion;
    if (!HybridFinite(motion) || any(lessThan(previousUv, vec2(0.0))) ||
        any(greaterThanEqual(previousUv, vec2(1.0))))
    {
        return true;
    }
    uint frameIndex = HybridCurrentFrameIndex();
    if (ReadMeshletTaskPreviousHiZFrameValid(frameIndex) == 0u)
        return true;
    vec4 previousClip = MulRowMajor(vec4(worldPosition, 1.0),
        ReadMeshletTaskPreviousHiZViewProjectionMatrix(frameIndex));
    if (!HybridFinite(previousClip) || abs(previousClip.w) <= 1.0e-7)
        return true;
    float expectedDepth = previousClip.z / previousClip.w;
    float depthTolerance = max(0.0005, abs(expectedDepth) * 0.002);
    if (!HybridFinite(expectedDepth))
        return true;

    vec2 historyPosition = previousUv * dimensions - vec2(0.5);
    ivec2 historyBase = ivec2(floor(historyPosition));
    for (int tapY = 0; tapY < 2; tapY++)
    {
        for (int tapX = 0; tapX < 2; tapX++)
        {
            ivec2 previousPixel = historyBase + ivec2(tapX, tapY);
            if (any(lessThan(previousPixel, ivec2(0))) ||
                any(greaterThanEqual(previousPixel,
                    ivec2(pc.ScreenWidth, pc.ScreenHeight))))
            {
                continue;
            }
            uvec2 previousMetadata = imageLoad(
                HybridMetadataPrevious, previousPixel).xy;
            if (!HybridHistoryMetadataValid(previousMetadata) ||
                HybridHistoryMetadataIdentity(previousMetadata) != identity)
            {
                continue;
            }
            float previousDepth =
                HybridHistoryMetadataDepth(previousMetadata);
            vec3 previousNormal =
                HybridHistoryMetadataNormal(previousMetadata);
            if (HybridFinite(previousDepth) &&
                abs(previousDepth - expectedDepth) <= depthTolerance &&
                HybridFinite(previousNormal) &&
                dot(currentNormal, previousNormal) >= 0.9)
            {
                return false;
            }
        }
    }
    return true;
}

void HybridStoreLobe(
    ivec2 pixel,
    uint lobeId,
    vec4 radiance,
    uint metadata)
{
    if (lobeId == 0u)
        imageStore(HybridRawRadiance, pixel, radiance);
    else
        imageStore(HybridDdgiCohorts, pixel, radiance);
    uvec4 pair = imageLoad(HybridRawMetadata, pixel);
    if (lobeId == 0u)
        pair.x = metadata;
    else
        pair.y = metadata;
    imageStore(HybridRawMetadata, pixel, pair);
}

void HybridRejectLobe(
    ivec2 pixel,
    uint lobeId,
    uint reason,
    uint identity,
    uint tier,
    uvec2 lobeExtension)
{
    HybridStoreLobe(pixel, lobeId, vec4(0.0),
        HybridPackMetadata(HYBRID_REFLECTION_SOURCE_NONE, 0.0,
            reason, 0u, false));
    if (tier != 0u && pc.RayQueriesEnabled != 0u &&
        pc.RayAdmissionThreshold != 0u &&
        !HybridAppendRayTask(uvec2(pixel), reason, identity, tier,
            lobeId, lobeExtension, pc.TemporalSampleIndex,
            pc.RayAdmissionThreshold))
    {
        HybridStoreLobe(pixel, lobeId, vec4(0.0),
            HybridPackMetadata(HYBRID_REFLECTION_SOURCE_NONE, 0.0,
                HYBRID_REFLECTION_REASON_RAY_BUDGET, 0u, false));
    }
}

void HybridTraceLobe(
    ivec2 pixel,
    uvec4 payload,
    uvec2 lobeExtension,
    uint lobeId,
    vec3 worldPosition,
    vec3 geometricNormal,
    vec3 normal,
    vec3 tangent,
    float schedulingRoughness,
    float roughness,
    float anisotropyStrength,
    vec3 f0,
    float specularOcclusion,
    bool disoccluded)
{
    uint tier = HybridResolveAdaptiveReflectionTier(
        schedulingRoughness, f0, specularOcclusion,
        lobeId == 0u ? HybridReflectionPayloadLobeFlags(payload) : 0u,
        pc.FullResolutionRoughness,
        pc.HalfResolutionRoughness,
        pc.QuarterResolutionRoughness);
    uint identity = HybridReceiverIdentity(payload);
    if (tier == 0u)
    {
        HybridRejectLobe(pixel, lobeId,
            HYBRID_REFLECTION_REASON_ROUGHNESS_FALLBACK,
            identity, tier, lobeExtension);
        return;
    }

    uvec2 invocation = uvec2(pixel);
    uint phase = HybridHash(pc.TemporalSampleIndex ^
        (lobeId * 0x9e3779b9u)) % (tier * tier);
    uint lane = (invocation.y % tier) * tier + invocation.x % tier;
    if (lane != phase)
    {
        HybridStoreLobe(pixel, lobeId, vec4(0.0),
            HybridPackMetadata(HYBRID_REFLECTION_SOURCE_NONE, 0.0,
                HYBRID_REFLECTION_REASON_RESOLUTION_SKIP, 0u, false));
        return;
    }

    vec3 viewDirection = normalize(
        pc.CameraPositionAndMaximumDistance.xyz - worldPosition);
    vec3 reflectionDirection = HybridReflectionSampleDirection(
        viewDirection, normal, tangent, roughness, anisotropyStrength,
        identity, invocation, pc.TemporalSampleIndex, lobeId);
    if (!HybridFinite(reflectionDirection) ||
        dot(reflectionDirection, geometricNormal) <= 0.001)
    {
        HybridRejectLobe(pixel, lobeId,
            HYBRID_REFLECTION_REASON_INVALID_OR_OFFSCREEN,
            identity, tier, lobeExtension);
        return;
    }

    HybridSsrTraceResult trace = HybridTraceHierarchicalSsr(
        worldPosition, reflectionDirection, roughness, tier);
    if (trace.Hit && !disoccluded &&
        trace.Confidence >= pc.ConfidenceThreshold)
    {
        HybridStoreLobe(pixel, lobeId,
            vec4(trace.Radiance, trace.Confidence),
            HybridPackMetadata(HYBRID_REFLECTION_SOURCE_SSR,
                trace.Confidence, HYBRID_REFLECTION_REASON_NONE, 0u, true));
        HybridAccumulateScreenCounter(
            HYBRID_REFLECTION_COUNTER_SSR_HITS, invocation);
        return;
    }

    uint reason = disoccluded
        ? HYBRID_REFLECTION_REASON_DISOCCLUDED
        : trace.Hit
            ? HYBRID_REFLECTION_REASON_LOW_CONFIDENCE
            : HYBRID_REFLECTION_REASON_INVALID_OR_OFFSCREEN;
    HybridRejectLobe(pixel, lobeId, reason,
        identity, tier, lobeExtension);
}

void main()
{
    bool adaptiveDispatch =
        (pc.HistoryValidAndCurrentFrameIndex & 0x80000000u) != 0u;
    uvec2 invocation = adaptiveDispatch
        ? HybridTiles[gl_WorkGroupID.x].xy * uvec2(8u) +
            gl_LocalInvocationID.xy
        : gl_GlobalInvocationID.xy;
    if (invocation.x >= pc.ScreenWidth || invocation.y >= pc.ScreenHeight)
        return;

    ivec2 pixel = ivec2(invocation);
    uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
    uvec2 lobeExtension = imageLoad(HybridRawMetadata, pixel).xy;
    imageStore(HybridRawMetadata, pixel, uvec4(0u));
    if (!HybridReflectionPayloadValid(payload))
    {
        imageStore(HybridRawRadiance, pixel, vec4(0.0));
        imageStore(HybridDdgiCohorts, pixel, vec4(0.0));
        return;
    }

    vec3 worldPosition;
    float receiverDepth;
    uint identity = HybridReceiverIdentity(payload);
    if (!HybridReconstructWorldPosition(pixel,
            uvec2(pc.ScreenWidth, pc.ScreenHeight),
            pc.InverseViewProjectionMatrix,
            worldPosition, receiverDepth))
    {
        HybridRejectLobe(pixel, 0u,
            HYBRID_REFLECTION_REASON_INVALID_OR_OFFSCREEN,
            identity, 1u, lobeExtension);
        HybridStoreLobe(pixel, 1u, vec4(0.0), 0u);
        return;
    }

    vec3 geometricNormal =
        HybridReflectionPayloadGeometricNormal(payload);
    vec3 shadingNormal =
        HybridReflectionPayloadShadingNormal(payload);
    vec3 clearcoatNormal;
    float clearcoatFactor;
    float clearcoatRoughness;
    float anisotropyStrength;
    vec3 tangent;
    NjulfHybridReflectionDecodeLobeExtension(
        lobeExtension,
        shadingNormal,
        clearcoatNormal,
        clearcoatFactor,
        clearcoatRoughness,
        anisotropyStrength,
        tangent);
    bool disoccluded = IsDisoccluded(
        pixel, identity, worldPosition, shadingNormal);

    HybridTraceLobe(
        pixel,
        payload,
        lobeExtension,
        0u,
        worldPosition,
        geometricNormal,
        HybridReflectionTraceNormal(payload),
        tangent,
        HybridReflectionPayloadSchedulingRoughness(payload),
        HybridReflectionPayloadPhysicalRoughness(payload),
        anisotropyStrength,
        HybridReflectionPayloadF0(payload),
        HybridReflectionPayloadSpecularOcclusion(payload),
        disoccluded);

    bool hasClearcoat =
        (HybridReflectionPayloadLobeFlags(payload) &
            NJULF_HYBRID_REFLECTION_LOBE_CLEARCOAT) != 0u &&
        clearcoatFactor > 0.0;
    if (hasClearcoat)
    {
        HybridTraceLobe(
            pixel,
            payload,
            lobeExtension,
            1u,
            worldPosition,
            geometricNormal,
            clearcoatNormal,
            NjulfHybridReflectionCanonicalTangentBasisX(clearcoatNormal),
            max(clearcoatRoughness, 0.02),
            max(clearcoatRoughness, 0.02),
            0.0,
            vec3(0.04),
            1.0,
            disoccluded);
    }
    else
    {
        HybridStoreLobe(pixel, 1u, vec4(0.0), 0u);
    }

    // Raw FP16 alpha is transient after source confidence has been quantized
    // into metadata. Preserve the two scalar clearcoat parameters needed by
    // resolve without allocating another full-resolution attachment.
    vec4 baseRaw = imageLoad(HybridRawRadiance, pixel);
    vec4 clearcoatRaw = imageLoad(HybridDdgiCohorts, pixel);
    baseRaw.a = hasClearcoat ? clearcoatRoughness : 0.0;
    clearcoatRaw.a = hasClearcoat ? clearcoatFactor : 0.0;
    imageStore(HybridRawRadiance, pixel, baseRaw);
    imageStore(HybridDdgiCohorts, pixel, clearcoatRaw);
}
