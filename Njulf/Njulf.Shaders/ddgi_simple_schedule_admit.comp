#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Admission is intentionally serialized in lane order.  Classification and
// compaction are massively parallel; this small bounded pass is the single
// deterministic authority for reservations, cursors, and queue indices.  It
// avoids making atomic arrival order a hidden priority rule.
void main()
{
    if (gl_GlobalInvocationID.x != 0u)
        return;

    if (SchedulerArenaRead(
            pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW) != 0u)
        return;

    uint requestCapacity = SchedulerRequestCapacity();
    uint requestBudget = min(SchedulerRequestBudget(), requestCapacity);
    uint activeVolumes = min(SchedulerActiveVolumeCount(), SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES);
    uint primaryBudget = SchedulerPrimaryRayBudget();
    uint sourceBudget = SchedulerSourceTargetRays();
    bool sourceBudgetLimited = sourceBudget != 0u;

    uint quotas[16];
    uint volumeUsage[16];
    uint sourceVolumeBudgets[16];
    uint sourceVolumeUsage[16];
    uint pendingByClass[16 * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint classReservations[16 * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint classUsage[16 * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint minimumTotal = 0u;
    uint quotaTotal = 0u;
    // Distribute each volume's fractional source cadence independently. Over
    // one complete interval every volume receives exactly its probe count,
    // preventing a high-ray near ring from consuming the shared target before
    // a lower-ray offscreen ring can be admitted.
    uint sourceInterval = clamp(SchedulerFrame(29u), 1u, 65535u);
    uint sourcePhase = SchedulerFrameIndex() % sourceInterval;
    for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
    {
        quotas[volume] = 0u;
        volumeUsage[volume] = 0u;
        sourceVolumeBudgets[volume] = 0u;
        sourceVolumeUsage[volume] = 0u;
        for (uint workClass = 0u; workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES; workClass++)
        {
            pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] = 0u;
            classReservations[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] = 0u;
            classUsage[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] = 0u;
        }
        if (volume >= activeVolumes)
            continue;
        uint capacity = SchedulerVolumeProbeCount(volume);
        uint baseSourceTarget = capacity / sourceInterval;
        uint sourceRemainder = capacity % sourceInterval;
        uint sourceBefore = sourcePhase * sourceRemainder / sourceInterval;
        uint sourceAfter = (sourcePhase + 1u) * sourceRemainder / sourceInterval;
        uint volumeSourceProbeTarget = baseSourceTarget + sourceAfter - sourceBefore;
        sourceVolumeBudgets[volume] = volumeSourceProbeTarget *
            clamp(
                SchedulerVolumeFullRays(volume),
                1u,
                SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
        uint minimum = min(SchedulerVolumeWord(volume, 26u), capacity);
        uint maximum = min(max(SchedulerVolumeWord(volume, 27u), minimum), capacity);
        quotas[volume] = minimum;
        minimumTotal += minimum;
        quotaTotal += maximum;
    }

    if (minimumTotal > requestBudget)
    {
        uint excess = minimumTotal - requestBudget;
        for (uint reverse = 0u; reverse < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; reverse++)
        {
            uint volume = SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES - 1u - reverse;
            if (volume >= activeVolumes || excess == 0u)
                continue;
            uint reduction = min(quotas[volume], excess);
            quotas[volume] -= reduction;
            excess -= reduction;
        }
    }
    else
    {
        uint remaining = requestBudget - minimumTotal;
        // Match the CPU oracle's two weighted quota passes: preferred maxima
        // are filled first, then unused budget is returned to volumes up to
        // their physical capacities. Stable volume order is the remainder
        // tie-break in both passes.
        for (uint quotaPass = 0u; quotaPass < 2u && remaining > 0u; quotaPass++)
        {
            while (remaining > 0u)
            {
                uint weightTotal = 0u;
                for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
                {
                    if (volume >= activeVolumes)
                        continue;
                    uint preferred = min(max(SchedulerVolumeWord(volume, 27u),
                        SchedulerVolumeWord(volume, 26u)), SchedulerVolumeProbeCount(volume));
                    uint maximum = quotaPass == 0u
                        ? preferred
                        : SchedulerVolumeProbeCount(volume);
                    if (quotas[volume] < maximum)
                        weightTotal += max(SchedulerVolumeWord(volume, 28u), 1u);
                }
                if (weightTotal == 0u)
                    break;

                uint distributed = 0u;
                uint bestVolume = SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES;
                uint bestRemainder = 0u;
                for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
                {
                    if (volume >= activeVolumes)
                        continue;
                    uint preferred = min(max(SchedulerVolumeWord(volume, 27u),
                        SchedulerVolumeWord(volume, 26u)), SchedulerVolumeProbeCount(volume));
                    uint maximum = quotaPass == 0u
                        ? preferred
                        : SchedulerVolumeProbeCount(volume);
                    if (quotas[volume] >= maximum)
                        continue;
                    uint weight = max(SchedulerVolumeWord(volume, 28u), 1u);
                    uint share = min(maximum - quotas[volume],
                        (remaining * weight) / weightTotal);
                    if (share > 0u)
                    {
                        quotas[volume] += share;
                        distributed += share;
                    }
                    uint remainder = (remaining * weight) % weightTotal;
                    if (bestVolume == SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES ||
                        remainder > bestRemainder)
                    {
                        bestVolume = volume;
                        bestRemainder = remainder;
                    }
                }
                if (distributed > remaining)
                    distributed = remaining;
                remaining -= distributed;
                if (distributed == 0u)
                {
                    if (bestVolume == SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES)
                        break;
                    quotas[bestVolume]++;
                    remaining--;
                }
            }
        }
    }

    // Mirror the CPU oracle's per-volume class reservations. A single global
    // maintenance reservation is insufficient: it lets a busy near volume
    // consume the reservation belonging to an outer volume. The reservation
    // is applied to every priority phase below; phase 10 returns unused
    // reservations in deterministic policy order.
    for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
    {
        if (volume >= activeVolumes || quotas[volume] == 0u)
            continue;

        for (uint workClass = 0u; workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES; workClass++)
        {
            for (uint transport = 0u; transport < SIMPLE_DDGI_SCHEDULER_TRANSPORT_CATEGORIES; transport++)
            {
                for (uint rayTier = 0u; rayTier < SIMPLE_DDGI_SCHEDULER_RAY_TIERS; rayTier++)
                {
                    uint lane = SchedulerLaneIndex(volume, workClass, transport, rayTier);
                    pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] +=
                        SchedulerArenaRead(pc.LaneCandidateCountsOffsetWords + lane);
                }
            }
        }

        uint zeroSupport = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
            SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT];
        uint fresh = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
            SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE];
        uint dirty = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
            SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY];
        uint retry = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
            SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY];
        uint maintenanceClass = SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
        for (uint workClass = SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE;
             workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
             workClass++)
        {
            if (pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] != 0u)
            {
                maintenanceClass = workClass;
                break;
            }
        }
        uint maintenance = maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES
            ? pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + maintenanceClass]
            : 0u;
        uint maintenanceReservation = maintenance != 0u && quotas[volume] >= 4u
            ? min(maintenance, max(1u, quotas[volume] / 16u))
            : 0u;
        uint retryReservation = retry != 0u && quotas[volume] >= 3u
            ? min(retry, max(1u, quotas[volume] / 8u))
            : 0u;
        uint dirtyReservation = dirty != 0u && quotas[volume] >= 2u
            ? min(dirty, max(1u, quotas[volume] / 4u))
            : 0u;
        uint lowerReservations = maintenanceReservation + retryReservation + dirtyReservation;
        if (lowerReservations >= quotas[volume] &&
            (zeroSupport != 0u || fresh != 0u || dirty != 0u || retry != 0u))
        {
            if (maintenanceReservation != 0u)
                maintenanceReservation--;
            else if (retryReservation != 0u)
                retryReservation--;
            else if (dirtyReservation != 0u)
                dirtyReservation--;
            lowerReservations--;
        }

        uint primaryClass = zeroSupport != 0u
            ? SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT
            : (fresh != 0u
                ? SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE
                : (dirty != 0u
                    ? SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY
                    : (retry != 0u
                        ? SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY
                        : maintenanceClass)));
        if (primaryClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
        {
            uint primaryBase = volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
            if (primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT ||
                primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE)
            {
                classReservations[primaryBase + primaryClass] =
                    max(0u, quotas[volume] - lowerReservations);
                classReservations[primaryBase + SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY] = dirtyReservation;
                classReservations[primaryBase + SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY] = retryReservation;
                if (maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
                    classReservations[primaryBase + maintenanceClass] = maintenanceReservation;
            }
            else if (primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY)
            {
                classReservations[primaryBase + primaryClass] =
                    max(0u, quotas[volume] - maintenanceReservation - retryReservation);
                classReservations[primaryBase + SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY] = retryReservation;
                if (maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
                    classReservations[primaryBase + maintenanceClass] = maintenanceReservation;
            }
            else if (primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY)
            {
                classReservations[primaryBase + primaryClass] =
                    max(0u, quotas[volume] - maintenanceReservation);
                if (maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
                    classReservations[primaryBase + maintenanceClass] = maintenanceReservation;
            }
            else
            {
                classReservations[primaryBase + primaryClass] = min(maintenance, quotas[volume]);
            }
        }
    }

    uint accepted = 0u;
    uint primaryUsed = 0u;
    uint sourceUsed = 0u;
    uint transportUsed = 0u;
    uint sourceProbeUsed = 0u;
    uint hardSourceProbeUsed = 0u;
    uint routineSourceProbeUsed = 0u;
    uint cachedSolverProbeUsed = 0u;
    // Tail mode gives phase zero to the incomplete source cohort. It may use
    // the volume quota directly because a complete current cache is a
    // certificate prerequisite. Hard repair uses the global request and
    // primary-ray limits instead of the periodic source cadence; otherwise a
    // cohort paced across the entire refresh interval leaves no solve/audit
    // opportunity before its oldest entry expires. Phases 1..4 then retain
    // visible-class priority. Non-tail mode preserves the legacy 0..3 class
    // ordering and phase-four hard-source fallback used by the CPU oracle.
    for (uint phase = 0u; phase <= 10u; phase++)
    {
        for (uint workClass = 0u; workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES; workClass++)
        {
            for (uint transport = 0u; transport < SIMPLE_DDGI_SCHEDULER_TRANSPORT_CATEGORIES; transport++)
            {
                for (uint rayTier = 0u; rayTier < SIMPLE_DDGI_SCHEDULER_RAY_TIERS; rayTier++)
                {
                    for (uint volumeIndex = 0u; volumeIndex < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volumeIndex++)
                    {
                        bool tailSourceCohortPhase =
                            SchedulerTailCertification() && phase == 0u;
                        bool phaseMatches = phase == 10u;
                        if (SchedulerTailCertification() && phase <= 4u)
                        {
                            phaseMatches = phase == 0u
                                ? transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE
                                : workClass == phase - 1u &&
                                    transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
                        }
                        else if (!SchedulerTailCertification() && phase <= 3u)
                            phaseMatches = workClass == phase &&
                                transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
                        else if (!SchedulerTailCertification() && phase == 4u)
                            phaseMatches = transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
                        else if (phase == 5u)
                            phaseMatches = transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
                        else if (phase == 6u)
                            phaseMatches = transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER;
                        else if (phase >= 7u && phase <= 9u)
                            phaseMatches = workClass == SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE + phase - 7u;
                        if (!phaseMatches)
                            continue;

                        uint lane = SchedulerLaneIndex(volumeIndex, workClass, transport, rayTier);
                        if (lane >= SIMPLE_DDGI_SCHEDULER_MAX_LANES)
                            continue;
                        uint laneCount = SchedulerArenaRead(pc.LaneCandidateCountsOffsetWords + lane);
                        if (laneCount == 0u)
                            continue;

                        // LaneCursors is the persistent rotating start. The
                        // compacted LanePrefixes base is never stored in it,
                        // and admission does not advance it speculatively.
                        uint laneStart = SchedulerArenaRead(
                            pc.LaneCursorsOffsetWords + lane) % laneCount;
                        uint laneBase = SchedulerArenaRead(pc.LanePrefixesOffsetWords + lane);
                        for (uint local = 0u; local < laneCount; local++)
                        {
                            uint candidateIndex = laneBase + ((laneStart + local) % laneCount);
                            if (candidateIndex >= SchedulerCandidateCapacity())
                                continue;
                            uint compactBase = pc.CandidateOutputOffsetWords +
                                candidateIndex * SIMPLE_DDGI_SCHEDULER_COMPACT_OUTPUT_WORDS;
                            uint inputIndex = SchedulerArenaRead(compactBase);
                            if (inputIndex >= SchedulerCandidateCapacity())
                            {
                                SchedulerArenaAtomicAdd(
                                    pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW,
                                    1u);
                                continue;
                            }
                            uint candidateBase = pc.CandidateInputOffsetWords +
                                inputIndex * SIMPLE_DDGI_SCHEDULER_CANDIDATE_WORDS;
                            uint probeIndex;
                            uint candidateVolumeIndex;
                            uint expectedGeneration;
                            uint sequenceOrdinal;
                            uint workClassAndTransport;
                            uint rayTierAndReason;
                            uint activeRayCount;
                            uint sourceRayCount;
                            SchedulerReadCandidate(candidateBase, probeIndex, candidateVolumeIndex,
                                expectedGeneration, sequenceOrdinal, workClassAndTransport,
                                rayTierAndReason, activeRayCount, sourceRayCount);
                            if (probeIndex == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                                continue;

                            uint consumed = SchedulerCandidateWord(candidateBase, 0u);
                            if (consumed == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                                continue;
                            uint candidateWorkClass = workClassAndTransport & 7u;
                            uint candidateTransport = (workClassAndTransport >> 3u) & 3u;
                            uint candidateRayTier = rayTierAndReason & 0xffu;
                            uint candidateReasons = rayTierAndReason >> 8u;
                            if (candidateWorkClass != workClass ||
                                candidateTransport != transport ||
                                candidateRayTier != rayTier ||
                                candidateVolumeIndex != volumeIndex)
                                continue;
                            uint tailSourceReasonMask =
                                SIMPLE_DDGI_SCHEDULER_REASON_FRESH |
                                SIMPLE_DDGI_SCHEDULER_REASON_SCROLL |
                                SIMPLE_DDGI_SCHEDULER_REASON_REGIONAL_DIRTY |
                                SIMPLE_DDGI_SCHEDULER_REASON_GLOBAL_DIRTY |
                                SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID |
                                SIMPLE_DDGI_SCHEDULER_REASON_RELOCATION_RETRY;
                            if (tailSourceCohortPhase &&
                                (candidateReasons & tailSourceReasonMask) == 0u)
                                continue;
                            if (accepted >= requestBudget || volumeIndex >= activeVolumes ||
                                volumeUsage[volumeIndex] >= quotas[volumeIndex])
                                continue;

                            uint classBase = volumeIndex * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
                            uint classLimit = phase == 10u || tailSourceCohortPhase
                                ? quotas[volumeIndex]
                                : classReservations[classBase + workClass];
                            if (classUsage[classBase + workClass] >= classLimit)
                                continue;

                            bool sourceWork = candidateTransport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
                                candidateTransport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
                            uint requiredSourceRayCount = clamp(
                                SchedulerVolumeFullRays(volumeIndex),
                                1u,
                                SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
                            // A V2 cached update must evaluate the same complete
                            // directional sequence that the certificate audits.
                            // SourceRayCount describes the immutable cache
                            // cardinality and activeRayCount describes cached
                            // transport work. Cached work never consumes the
                            // primary/source-ray budgets below.
                            sourceRayCount = SchedulerTransportV2()
                                ? requiredSourceRayCount
                                : (sourceWork ? requiredSourceRayCount : 0u);
                            // A source refresh is an atomic replacement of the
                            // complete cache sequence. A maintenance-tier subset
                            // may be used only by cached solver work; accepting it
                            // as a source refresh would leave unaudited stale
                            // entries behind while publishing a current epoch.
                            if (SchedulerTransportV2() || sourceWork)
                                activeRayCount = requiredSourceRayCount;
                            if (sourceWork && (primaryBudget == 0u ||
                                activeRayCount > primaryBudget - min(primaryUsed, primaryBudget)))
                            {
                                SchedulerArenaWrite(candidateBase, SIMPLE_DDGI_SCHEDULER_INVALID_PROBE);
                                SchedulerArenaWrite(pc.CountersOffsetWords +
                                    SIMPLE_DDGI_SCHEDULER_COUNTER_REJECTED,
                                    SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_REJECTED) + 1u);
                                continue;
                            }
                            uint volumeSourceBudget = sourceVolumeBudgets[volumeIndex];
                            if (sourceWork && !tailSourceCohortPhase &&
                                sourceBudgetLimited &&
                                (sourceRayCount > volumeSourceBudget - min(
                                    sourceVolumeUsage[volumeIndex],
                                    volumeSourceBudget)))
                            {
                                SchedulerArenaWrite(candidateBase, SIMPLE_DDGI_SCHEDULER_INVALID_PROBE);
                                SchedulerArenaWrite(pc.CountersOffsetWords +
                                    SIMPLE_DDGI_SCHEDULER_COUNTER_REJECTED,
                                    SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_REJECTED) + 1u);
                                continue;
                            }

                            uint flags = activeRayCount << SIMPLE_DDGI_SCHEDULER_UPDATE_RAY_SHIFT;
                            if ((candidateReasons & SIMPLE_DDGI_SCHEDULER_REASON_FRESH) != 0u)
                                flags |= SIMPLE_DDGI_SCHEDULER_PROBE_FRESH;
                            if ((candidateReasons & SIMPLE_DDGI_SCHEDULER_REASON_SCROLL) != 0u)
                                flags |= SIMPLE_DDGI_SCHEDULER_PROBE_SCROLL;
                            if (candidateRayTier == SIMPLE_DDGI_SCHEDULER_RAY_MAINTENANCE)
                                flags |= SIMPLE_DDGI_SCHEDULER_UPDATE_MAINTENANCE;
                            if ((candidateReasons & (
                                    SIMPLE_DDGI_SCHEDULER_REASON_FRESH |
                                    SIMPLE_DDGI_SCHEDULER_REASON_SCROLL |
                                    SIMPLE_DDGI_SCHEDULER_REASON_REGIONAL_DIRTY |
                                    SIMPLE_DDGI_SCHEDULER_REASON_GLOBAL_DIRTY |
                                    SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID |
                                    SIMPLE_DDGI_SCHEDULER_REASON_RELOCATION_RETRY)) != 0u)
                                flags |= SIMPLE_DDGI_SCHEDULER_UPDATE_INVALIDATE;
                            if (sourceWork)
                            {
                                flags |= SIMPLE_DDGI_SCHEDULER_UPDATE_SOURCE_REFRESH;
                                if (candidateTransport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE)
                                    flags |= SIMPLE_DDGI_SCHEDULER_UPDATE_ROUTINE_SOURCE;
                            }
                            uint cascade = min(SchedulerVolumeWord(volumeIndex, 32u), 6u) + 1u;
                            uint maxLights = min(SchedulerVolumeWord(volumeIndex, 33u), 62u) + 1u;
                            flags |= cascade << 3u;
                            flags |= maxLights << 6u;
                            uint publicStateBase = probeIndex * SIMPLE_DDGI_PROBE_STATE_WORDS;
                            uint schedulingAge = ReadStorageWordUniform(
                                pc.ProbeStateBufferIndex,
                                publicStateBase + 5u);
                            uint schedulerStateBase = pc.SchedulerProbeStateOffsetWords +
                                probeIndex * SIMPLE_DDGI_SCHEDULER_PROBE_STATE_WORDS;
                            uint updateSourceGeneration = sourceWork
                                ? SchedulerSourceGeneration()
                                : SchedulerArenaRead(schedulerStateBase + 2u);
                            SchedulerWriteUpdate(
                                accepted,
                                probeIndex,
                                volumeIndex,
                                flags,
                                expectedGeneration,
                                schedulingAge,
                                sourceRayCount,
                                updateSourceGeneration,
                                candidateReasons);
                            SchedulerArenaWrite(candidateBase, SIMPLE_DDGI_SCHEDULER_INVALID_PROBE);
                            accepted++;
                            volumeUsage[volumeIndex]++;
                            classUsage[classBase + workClass]++;
                            transportUsed += activeRayCount;
                            if (sourceWork)
                            {
                                primaryUsed += activeRayCount;
                                sourceUsed += sourceRayCount;
                                sourceVolumeUsage[volumeIndex] += sourceRayCount;
                                sourceProbeUsed++;
                            }
                            if (candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE)
                            {
                                hardSourceProbeUsed++;
                            }
                            else if (candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE)
                            {
                                routineSourceProbeUsed++;
                            }
                            else if (candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER)
                            {
                                cachedSolverProbeUsed++;
                            }
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_ACCEPTED, accepted);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_PRIMARY_USED, primaryUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_USED, sourceUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_TRANSPORT_USED, transportUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_PROBE_USED, sourceProbeUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_HARD_SOURCE_PROBE_USED,
                                hardSourceProbeUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_ROUTINE_SOURCE_PROBE_USED,
                                routineSourceProbeUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_CACHED_SOLVER_PROBE_USED,
                                cachedSolverProbeUsed);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_VOLUME_USAGE_BASE + volumeIndex,
                                volumeUsage[volumeIndex]);
                            SchedulerArenaWrite(pc.CountersOffsetWords +
                                SIMPLE_DDGI_SCHEDULER_COUNTER_CLASS_USAGE_BASE + min(candidateWorkClass, 15u),
                                SchedulerArenaRead(pc.CountersOffsetWords +
                                    SIMPLE_DDGI_SCHEDULER_COUNTER_CLASS_USAGE_BASE + min(candidateWorkClass, 15u)) + 1u);
                            SchedulerArenaWrite(pc.LaneAdmissionOffsetWords + lane,
                                SchedulerArenaRead(pc.LaneAdmissionOffsetWords + lane) + 1u);
                        }
                    }
                }
            }
        }
    }

    // Advance persistent cursors only by candidates that were actually
    // admitted. Empty lanes retain their previous cursor exactly.
    for (uint lane = 0u; lane < SIMPLE_DDGI_SCHEDULER_MAX_LANES; lane++)
    {
        uint laneCount = SchedulerArenaRead(pc.LaneCandidateCountsOffsetWords + lane);
        uint laneAccepted = SchedulerArenaRead(pc.LaneAdmissionOffsetWords + lane);
        if (laneCount == 0u || laneAccepted == 0u)
            continue;
        uint oldCursor = SchedulerArenaRead(pc.LaneCursorsOffsetWords + lane) % laneCount;
        SchedulerArenaWrite(
            pc.LaneCursorsOffsetWords + lane,
            (oldCursor + laneAccepted) % laneCount);
    }

    SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_EMIT, 1u, 1u, 1u);
}
