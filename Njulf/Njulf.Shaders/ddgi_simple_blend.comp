#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint SIMPLE_DDGI_BLEND_FLAG_SHARED_RAY_CACHE = 1u << 3;

shared vec4 SharedSimpleRayRadianceDistance[256];
shared vec4 SharedSimpleRayDirectionHit[256];

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint Padding0;
} pc;

vec4 ReadSimpleRayRadianceDistance(uint rayResultIndex)
{
    return ReadStorageVec4(pc.RayResultScratchBufferIndex, rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 0u);
}

vec4 ReadSimpleRayDirectionHit(uint rayResultIndex)
{
    return ReadStorageVec4(pc.RayResultScratchBufferIndex, rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 4u);
}

float SimpleDdgiLuminance(vec3 value)
{
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

float SimpleDdgiAdaptiveIrradianceHysteresis(SimpleDdgiParams params, vec4 previous, vec3 irradiance, float probeHysteresis)
{
    if ((params.flags & SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS) == 0u || probeHysteresis <= 0.0001 || previous.w <= 0.0001)
        return probeHysteresis;

    float previousLuma = SimpleDdgiLuminance(previous.rgb);
    float currentLuma = SimpleDdgiLuminance(irradiance);
    float relativeDelta = abs(currentLuma - previousLuma) / max(max(previousLuma, currentLuma), 0.01);
    float changeT = smoothstep(params.hysteresisChangeThreshold, params.hysteresisStepThreshold, relativeDelta);
    float softHysteresis = probeHysteresis * 0.5;
    float stepHysteresis = min(probeHysteresis, 0.30);
    return mix(probeHysteresis, mix(softHysteresis, stepHysteresis, changeT), smoothstep(params.hysteresisChangeThreshold * 0.75, params.hysteresisChangeThreshold, relativeDelta));
}

float SimpleDdgiAdaptiveVisibilityHysteresis(SimpleDdgiParams params, vec4 previous, vec2 moments, float probeHysteresis)
{
    if ((params.flags & SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS) == 0u || probeHysteresis <= 0.0001 || previous.z <= 0.5)
        return probeHysteresis;

    float relativeDelta = abs(moments.x - previous.x) / max(max(abs(previous.x), abs(moments.x)), 0.01);
    float changeT = smoothstep(params.hysteresisChangeThreshold, params.hysteresisStepThreshold, relativeDelta);
    float softHysteresis = probeHysteresis * 0.75;
    float stepHysteresis = max(min(probeHysteresis, 0.55), 0.0);
    return mix(probeHysteresis, mix(softHysteresis, stepHysteresis, changeT), smoothstep(params.hysteresisChangeThreshold * 0.75, params.hysteresisChangeThreshold, relativeDelta));
}

void LoadSimpleRayCache(SimpleDdgiParams params, uint localProbeOffset, uint activeRayCount)
{
    uint local = gl_LocalInvocationID.x;
    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = local; ray < rayCount; ray += gl_WorkGroupSize.x)
    {
        uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
        SharedSimpleRayDirectionHit[ray] = ReadSimpleRayDirectionHit(rayResultIndex);
        SharedSimpleRayRadianceDistance[ray] = ReadSimpleRayRadianceDistance(rayResultIndex);
    }

    barrier();
}

vec4 ReadCachedSimpleRayRadianceDistance(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    if (sharedRayCacheEnabled)
        return SharedSimpleRayRadianceDistance[ray];

    uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
    return ReadSimpleRayRadianceDistance(rayResultIndex);
}

vec4 ReadCachedSimpleRayDirectionHit(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    if (sharedRayCacheEnabled)
        return SharedSimpleRayDirectionHit[ray];

    uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
    return ReadSimpleRayDirectionHit(rayResultIndex);
}

vec3 ClampSimpleRadiance(vec3 v)
{
    if (any(isnan(v)) || any(isinf(v)))
        return vec3(0.0);
    float luma = dot(max(v, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
    float clampScale = luma > 64.0 ? 64.0 / luma : 1.0;
    return clamp(v * clampScale, vec3(0.0), vec3(65504.0));
}

float BlendIrradianceTexel(SimpleDdgiParams params, uint probeIndex, uint localProbeOffset, uint texel, float probeHysteresis, bool sharedRayCacheEnabled, uint activeRayCount)
{
    uint x = texel % params.irradianceTexels;
    uint y = texel / params.irradianceTexels;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(params.irradianceTexels);
    vec3 texelDirection = SimpleDdgiOctDecode(uv);
    vec3 accumulated = vec3(0.0);
    float weightSum = 0.0;

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, sharedRayCacheEnabled);
        vec4 radianceDistance = ReadCachedSimpleRayRadianceDistance(params, localProbeOffset, ray, sharedRayCacheEnabled);
        float weight = max(dot(texelDirection, normalize(directionHit.xyz)), 0.0);
        accumulated += ClampSimpleRadiance(radianceDistance.rgb) * weight;
        weightSum += weight;
    }

    vec3 irradiance = weightSum > 0.000001
        ? accumulated * (SIMPLE_DDGI_PI / max(weightSum, 0.000001))
        : vec3(0.0);
    vec4 previous = ReadSimpleDdgiAtlasTexel(pc.IrradianceAtlasBufferIndex, probeIndex, texel, params.irradianceTexels);
    float texelHysteresis = SimpleDdgiAdaptiveIrradianceHysteresis(params, previous, irradiance, probeHysteresis);
    vec4 blended = mix(vec4(irradiance, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    if (weightSum <= 0.000001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_ZERO_RAY_WEIGHT_PROBE_COUNTER, 1u);
    if (SimpleDdgiLuminance(irradiance) > 0.00001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_NONZERO_IRRADIANCE_PROBE_COUNTER, 1u);
    if (probeHysteresis > 0.0001 && previous.w > 0.0001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_PREVIOUS_ATLAS_USED_COUNTER, 1u);
    WriteSimpleDdgiAtlasTexel(pc.IrradianceAtlasBufferIndex, probeIndex, texel, params.irradianceTexels, blended);
    return previous.w > 0.0001
        ? abs(SimpleDdgiLuminance(irradiance) - SimpleDdgiLuminance(previous.rgb)) / max(max(SimpleDdgiLuminance(irradiance), SimpleDdgiLuminance(previous.rgb)), 0.01)
        : 1.0;
}

void BlendVisibilityTexel(SimpleDdgiParams params, SimpleDdgiVolume volume, uint probeIndex, uint localProbeOffset, uint texel, float probeHysteresis, bool sharedRayCacheEnabled, uint activeRayCount)
{
    uint x = texel % params.visibilityTexels;
    uint y = texel / params.visibilityTexels;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(params.visibilityTexels);
    vec3 texelDirection = SimpleDdgiOctDecode(uv);
    float mean = 0.0;
    float mean2 = 0.0;
    float weightSum = 0.0;

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, sharedRayCacheEnabled);
        vec4 radianceDistance = ReadCachedSimpleRayRadianceDistance(params, localProbeOffset, ray, sharedRayCacheEnabled);
        float weight = pow(max(dot(texelDirection, normalize(directionHit.xyz)), 0.0), 16.0);
        float d = max(radianceDistance.w, 0.0);
        mean += d * weight;
        mean2 += d * d * weight;
        weightSum += weight;
    }

    vec4 previous = ReadSimpleDdgiAtlasTexel(pc.VisibilityAtlasBufferIndex, probeIndex, texel, params.visibilityTexels);
    vec2 moments;
    if (weightSum > 0.000001)
    {
        moments = vec2(mean, mean2) / weightSum;
    }
    else if (previous.z > 0.5)
    {
            return;
    }
    else
    {
        moments = vec2(volume.spacing * 4.0, volume.spacing * volume.spacing * 16.0);
    }
    float texelHysteresis = SimpleDdgiAdaptiveVisibilityHysteresis(params, previous, moments, probeHysteresis);
    vec4 blended = mix(vec4(moments, 1.0, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    WriteSimpleDdgiAtlasTexel(pc.VisibilityAtlasBufferIndex, probeIndex, texel, params.visibilityTexels, blended);
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint localProbeOffset = gl_WorkGroupID.x;
    if (localProbeOffset >= params.probesToUpdate || params.probeCount == 0u)
        return;

    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, localProbeOffset);
    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
        return;

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
        return;
    uint local = gl_LocalInvocationID.x;
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    float probeHysteresis = (update.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u ? 0.0 : params.hysteresis;
    bool sharedRayCacheEnabled = (pc.Flags & SIMPLE_DDGI_BLEND_FLAG_SHARED_RAY_CACHE) != 0u;
    if (sharedRayCacheEnabled)
        LoadSimpleRayCache(params, localProbeOffset, activeRayCount);

    if (local == 0u)
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_PROBE_COUNTER, 1u);
        if (probeHysteresis <= 0.0001)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_HYSTERESIS_ZERO_FRAME_COUNTER, 1u);
    }

    float localIrradianceDelta = 0.0;
    for (uint texel = local; texel < params.irradianceTexels * params.irradianceTexels; texel += gl_WorkGroupSize.x)
    {
        float texelDelta = BlendIrradianceTexel(params, probeIndex, localProbeOffset, texel, probeHysteresis, sharedRayCacheEnabled, activeRayCount);
        if (texel == 0u)
            localIrradianceDelta = texelDelta;
    }

    for (uint texel = local; texel < params.visibilityTexels * params.visibilityTexels; texel += gl_WorkGroupSize.x)
        BlendVisibilityTexel(params, volume, probeIndex, localProbeOffset, texel, probeHysteresis, sharedRayCacheEnabled, activeRayCount);

    if (local == 0u)
    {
        SimpleDdgiProbeState state = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
        state.luminanceChangeEma = mix(max(state.luminanceChangeEma, 0.0), clamp(localIrradianceDelta, 0.0, 8.0), 0.20);
        WriteSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex, state);
    }
}
