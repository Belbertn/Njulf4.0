#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

// transport_participant.glsl is also compiled by the feedback and audit
// roles; keep the public inactive classification value explicit in this lean
// scheduler role rather than pulling in the full DDGI storage ABI.
const uint SIMPLE_DDGI_CLASSIFICATION_INACTIVE = 1u;

#include "ddgi_simple_transport_participant.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

uint SchedulerNextGeneration(uint generation)
{
    uint next = generation + 1u;
    next &= 0x00ffffffu;
    return next == 0u ? 1u : next;
}

void main()
{
    if (SchedulerCertifiedQuiesced())
        return;

    SchedulerPrepareReceiverFeedbackWorkgroup();

    uint sequenceOrdinal = gl_GlobalInvocationID.x;
    if (sequenceOrdinal >= SchedulerActiveProbeCount())
        return;

    uint candidateBase = pc.CandidateInputOffsetWords +
        sequenceOrdinal * SIMPLE_DDGI_SCHEDULER_CANDIDATE_WORDS;
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_CONSIDERED], 1u);

    uint volumeIndex;
    uint localOrdinal;
    if (!SchedulerFindSequenceVolume(sequenceOrdinal, volumeIndex, localOrdinal))
    {
        SchedulerWriteInvalidCandidate(candidateBase);
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
            pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION], 1u);
        return;
    }

    uint probeIndex = SchedulerSequenceProbeIndex(volumeIndex, localOrdinal);
    uint physicalProbeIndex;
    uint pageMappingGeneration;
    if (!SchedulerResolvePayloadAddress(
            probeIndex,
            volumeIndex,
            physicalProbeIndex,
            pageMappingGeneration))
    {
        // Nonresident sparse probes are not convergence or maintenance
        // participants. Page admission has a separate authority and wake path.
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }
    uint stateBase = probeIndex * SIMPLE_DDGI_PROBE_STATE_WORDS;
    uint stateFlags = ReadStorageWordUniform(pc.ProbeStateBufferIndex, stateBase + 4u);
    uint persistedStateAge = ReadStorageWordUniform(
        pc.ProbeStateBufferIndex,
        stateBase + 5u);
    uint expectedGeneration = (stateFlags & SIMPLE_DDGI_PROBE_FLAG_GENERATION_MASK) >>
        SIMPLE_DDGI_PROBE_FLAG_GENERATION_SHIFT;
    if (expectedGeneration == 0u)
    {
        SchedulerWriteInvalidCandidate(candidateBase);
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
            pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION], 1u);
        return;
    }

    uint schedulerStateBase = pc.SchedulerProbeStateOffsetWords +
        probeIndex * SIMPLE_DDGI_SCHEDULER_PROBE_STATE_WORDS;
    uint stateAge = SchedulerProbeUpdateAge(
        persistedStateAge,
        SchedulerArenaRead(schedulerStateBase + 0u));
    // Word 8 is the last applied invalidation marker. Dirty-latency start
    // remains in word 6 so the bootstrap ABI retains both pieces of state.
    uint invalidationMarker = SchedulerArenaRead(schedulerStateBase + 8u);
    uint schedulerMetadata = SchedulerArenaRead(schedulerStateBase + 5u);
    uint dirtyReasons;
    bool regionalDirtySignal = SchedulerDirtyIntersects(volumeIndex, localOrdinal, dirtyReasons);
    bool sourceInvalid =
        (stateFlags & SIMPLE_DDGI_PROBE_FLAG_SOURCE_CACHE_INVALID) != 0u ||
        (schedulerMetadata & SIMPLE_DDGI_SCHEDULER_PROBE_META_REPAIR) != 0u;
    uint sourceGeneration = SchedulerArenaRead(schedulerStateBase + 2u);
    uint sourceRays = SchedulerArenaRead(schedulerStateBase + 7u) & 0x1ffu;
    uint requiredSourceRays = clamp(
        SchedulerVolumeFullRays(volumeIndex),
        1u,
        SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
    uint sourceEpoch = SchedulerArenaRead(schedulerStateBase + 3u);
    uint sourceVolumeGeneration = SchedulerArenaRead(schedulerStateBase + 4u);
    uint solveEpoch = SchedulerSolveEpoch();
    uint lastSolveEpoch = SchedulerArenaRead(schedulerStateBase + 9u);
    uint cacheProbeBaseWordPlusOne = SchedulerArenaRead(schedulerStateBase + 10u);
    bool sourceReady = SchedulerTransportV2() &&
        SimpleDdgiTransportSourceReady(
            stateFlags,
            sourceRays,
            requiredSourceRays,
            sourceGeneration,
            SchedulerSourceGeneration(),
            sourceEpoch,
            sourceVolumeGeneration,
            SchedulerVolumeGeneration(),
            schedulerMetadata,
            cacheProbeBaseWordPlusOne);
    // Evaluate geometry readiness against the committed public state before
    // this invocation proposes FRESH for a private invalidation transaction.
    bool cachedGeometryReady = SchedulerTransportV2() &&
        sourceGeneration != 0u &&
        SimpleDdgiTransportSourceReady(
            stateFlags,
            sourceRays,
            requiredSourceRays,
            sourceGeneration,
            sourceGeneration,
            sourceEpoch,
            sourceVolumeGeneration,
            SchedulerVolumeGeneration(),
            schedulerMetadata,
            cacheProbeBaseWordPlusOne);
    bool globalDirtySignal = SchedulerDirtyReasonFlags() != 0u;
    bool globalDirty = globalDirtySignal && sourceGeneration != SchedulerSourceGeneration();
    bool radiometricRelightGeneration = globalDirty && !sourceInvalid &&
        SchedulerSourceModeUsesRadiometricRelight(
            SchedulerSourceRefreshMode());
    bool regionalDirty = regionalDirtySignal &&
        invalidationMarker != SchedulerVolumeDirtyGeneration(volumeIndex);
    bool fresh = (stateFlags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u;
    bool scrollExposed = (stateFlags & SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED) != 0u;
    bool relocationRetry = (stateFlags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u;
    uint classification = ReadStorageWordUniform(
        pc.ProbeStateBufferIndex,
        stateBase + 6u);
    float activeWeight = ReadStorageFloatUniform(
        pc.ProbeStateBufferIndex,
        stateBase + 3u);
    bool inactive =
        (stateFlags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ||
        classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE ||
        isnan(activeWeight) || isinf(activeWeight) ||
        activeWeight <= 0.001;
    uint retryFrames = max(SchedulerFrame(28u), 1u);
    // The exact tail participant denominator is frozen while a global
    // source/solve/audit transaction is in progress. Inactive probes are
    // excluded from that denominator; admitting their periodic reactivation
    // here would continuously grow the source cohort underneath delayed
    // feedback and prevent the final active probes from ever reaching zero.
    // Certified/tracking frames reopen the retry policy, and any successful
    // reactivation then starts a new bounded certificate wave normally.
    bool tailParticipantCutFrozen = SchedulerTailCertification() &&
        SchedulerGlobalConvergence();
    bool inactiveRetry = inactive && !tailParticipantCutFrozen &&
        stateAge >= retryFrames;

    uint countX = max(SchedulerVolumeCurrentCountX(volumeIndex), 1u);
    uint countY = max(SchedulerVolumeCurrentCountY(volumeIndex), 1u);
    uint countZ = max(SchedulerVolumeCurrentCountZ(volumeIndex), 1u);
    uint logical = (localOrdinal * max(SchedulerVolumeSequenceStride(volumeIndex), 1u)) %
        max(SchedulerVolumeProbeCount(volumeIndex), 1u);
    uint logicalZ = logical / (countX * countY);
    uint logicalRem = logical - logicalZ * countX * countY;
    uint logicalY = logicalRem / countX;
    uint logicalX = logicalRem - logicalY * countX;
    int deltaX = int(SchedulerVolumeWord(volumeIndex, 36u));
    int deltaY = int(SchedulerVolumeWord(volumeIndex, 37u));
    int deltaZ = int(SchedulerVolumeWord(volumeIndex, 38u));
    bool cellAligned = (SchedulerVolumeLayoutFlags(volumeIndex) & 2u) != 0u;
    bool topologyInvalid = (SchedulerVolumeLayoutFlags(volumeIndex) & 1u) == 0u ||
        SchedulerVolumeCurrentCountX(volumeIndex) != SchedulerVolumePreviousCountX(volumeIndex) ||
        SchedulerVolumeCurrentCountY(volumeIndex) != SchedulerVolumePreviousCountY(volumeIndex) ||
        SchedulerVolumeCurrentCountZ(volumeIndex) != SchedulerVolumePreviousCountZ(volumeIndex);
    bool exposed = SchedulerToroidal() && cellAligned &&
        (deltaX != 0 || deltaY != 0 || deltaZ != 0) &&
        (int(logicalX) - deltaX < 0 || int(logicalX) - deltaX >= int(countX) ||
         int(logicalY) - deltaY < 0 || int(logicalY) - deltaY >= int(countY) ||
         int(logicalZ) - deltaZ < 0 || int(logicalZ) - deltaZ >= int(countZ));

    bool segmentSelectiveEligible = regionalDirty &&
        SchedulerSourceRefreshMode() ==
            SIMPLE_DDGI_SCHEDULER_SOURCE_MODE_SEGMENT_SELECTIVE &&
        cachedGeometryReady && !topologyInvalid && !exposed &&
        !SchedulerAtlasFresh() && !sourceInvalid && !relocationRetry;

    uint invalidationReasons = regionalDirty
        ? SIMPLE_DDGI_SCHEDULER_REASON_REGIONAL_DIRTY
        : 0u;
    if (globalDirty && !radiometricRelightGeneration)
        invalidationReasons |= SIMPLE_DDGI_SCHEDULER_REASON_GLOBAL_DIRTY;
    if (exposed)
        invalidationReasons |= SIMPLE_DDGI_SCHEDULER_REASON_SCROLL;
    bool atlasFresh = SchedulerAtlasFresh();
    if (topologyInvalid || atlasFresh)
        invalidationReasons |= SIMPLE_DDGI_SCHEDULER_REASON_FRESH;
    if (topologyInvalid)
        invalidationReasons |= SIMPLE_DDGI_SCHEDULER_REASON_TOPOLOGY;
    if (sourceInvalid)
        invalidationReasons |= SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID;

    // Atlas freshness is a volume-layout event. Its dirty generation may be
    // zero during startup, which means "always invalidate" and would trap the
    // complete source cohort in hard-source work forever. Use the stable
    // volume generation for the same one-shot semantics as topology/scroll.
    uint marker = topologyInvalid || exposed || atlasFresh
        ? SchedulerVolumeGeneration()
        : (globalDirty || sourceInvalid
            ? SchedulerSourceGeneration()
            : SchedulerVolumeDirtyGeneration(volumeIndex));
    bool invalidate = invalidationReasons != 0u &&
        (marker == 0u || invalidationMarker != marker);
    if (invalidate)
    {
        // Classification is a private proposal stage in resident mode. The
        // public probe record remains byte-identical until CommitLocal has
        // validated every producer and publication generation.
        stateFlags |= SIMPLE_DDGI_PROBE_FLAG_FRESH;
        if ((invalidationReasons & SIMPLE_DDGI_SCHEDULER_REASON_SCROLL) != 0u)
            stateFlags |= SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED;
        fresh = true;
        scrollExposed = (invalidationReasons & SIMPLE_DDGI_SCHEDULER_REASON_SCROLL) != 0u;
    }

    // A toroidal physical slot can retain the classification of the world cell
    // it represented before the scroll. Once layout ownership changes, that
    // inactive classification is stale: the compact receiver record has
    // already been invalidated and the new cell must earn replacement geometry
    // evidence immediately. Match the CPU scheduler's fresh/remap semantics by
    // bypassing inactive retry throttling for this one-shot layout transaction.
    // Keeping the slot inactive here can strand an invalid receiver record
    // indefinitely while the tail participant cut is frozen.
    bool layoutOwnershipChanged = invalidate &&
        (topologyInvalid || exposed || atlasFresh);
    if (layoutOwnershipChanged)
        inactive = false;

    // Geometry readiness remains valid for radiometric and segment-copy
    // transactions even though sourceReady may target a newer lighting epoch.
    bool radiometricRelightEligible = radiometricRelightGeneration &&
        cachedGeometryReady && !regionalDirty && !topologyInvalid &&
        !exposed && !atlasFresh && !relocationRetry;
    uint lastSourceFrame = SchedulerArenaRead(schedulerStateBase + 1u);
    uint sourceRefreshInterval = max(SchedulerFrame(29u), 1u);
    uint periodicControlFrame = SchedulerPeriodicSourceRefreshControlFrame();
    bool periodicWaveMember = SchedulerPeriodicSourceRefreshWave() &&
        SchedulerSourceRefreshDueAtCutoff(
            lastSourceFrame,
            periodicControlFrame,
            sourceRefreshInterval);
    bool periodicRefreshGateOpen = SchedulerFrameReached(
        SchedulerFrameIndex(),
        periodicControlFrame);
    bool routineDue = SchedulerTransportV2() && sourceReady &&
        (SchedulerTailCertification()
            ? solveEpoch == 0u &&
                (periodicWaveMember ||
                    (!SchedulerGlobalConvergence() &&
                     !SchedulerPeriodicSourceRefreshWave() &&
                     periodicRefreshGateOpen &&
                     SchedulerFrameIndex() - lastSourceFrame >=
                        sourceRefreshInterval))
            : SchedulerFrameIndex() - lastSourceFrame >=
                sourceRefreshInterval);

    uint ring = min(SchedulerVolumeRing(volumeIndex), 2u);
    uint workClass;
    uint transport;
    uint rayTier;
    uint reasons = 0u;
    // Tail certification cannot begin until every active probe owns a complete
    // current source sequence. Keep that cohort explicit even when the public
    // invalid-cache flag was absent or a higher-priority visibility class also
    // applies; admission uses this reason to prevent an always-hot visible
    // zero-support lane from starving offscreen source repair.
    if (!sourceReady)
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID;
    if (radiometricRelightEligible)
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_RADIOMETRIC_RELIGHT;
    if (segmentSelectiveEligible)
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_SEGMENT_SELECTIVE;
    vec3 camera = vec3(
        uintBitsToFloat(SchedulerFrame(20u)),
        uintBitsToFloat(SchedulerFrame(21u)),
        uintBitsToFloat(SchedulerFrame(22u)));
    vec3 origin = SchedulerVolumeOrigin(volumeIndex);
    vec3 position = origin + vec3(logicalX, logicalY, logicalZ) * SchedulerVolumeSpacing(volumeIndex);
    float spacing = SchedulerVolumeSpacing(volumeIndex);
    uint volumeKind = SchedulerVolumeWord(volumeIndex, 2u);
    uint volumePurpose = SchedulerVolumeWord(volumeIndex, 5u);
    int baseImportance;
    if (volumeKind == 1u)
    {
        // Keep this table in lockstep with ResolveVolumeSchedulingBaseImportance
        // in SimpleDdgiVolumeManager. Authored hero/dynamic volumes are visible
        // independent of camera distance; interior/support volumes use the
        // same proximity bonus as the CPU policy.
        baseImportance = volumePurpose == 0u ? 6 :
            (volumePurpose == 2u ? 5 :
                (volumePurpose == 1u ? 2 : 1));
    }
    else
    {
        uint ringImportance = min(SchedulerVolumeRing(volumeIndex), 2u);
        baseImportance = ringImportance == 0u ? 4 :
            (ringImportance == 1u ? 1 : 0);
    }
    float authoredPadding = max(SchedulerVolumeProximityRadiusPadding(volumeIndex), 0.0);
    float proximityRadius = volumeKind == 2u
        ? spacing * 4.0
        : max(spacing * 3.0, authoredPadding);
    bool proximity = distance(camera, position) <= max(
        uintBitsToFloat(SchedulerFrame(23u)), proximityRadius);
    uint packedLifecycle = SchedulerArenaRead(schedulerStateBase + 7u);
    uint stableUpdates = (packedLifecycle & SIMPLE_DDGI_SCHEDULER_STABLE_UPDATE_MASK) >>
        SIMPLE_DDGI_SCHEDULER_STABLE_UPDATE_SHIFT;
    float residualEnvelope = ReadStorageFloatUniform(
        pc.ProbeStateBufferIndex,
        stateBase + 7u);
    bool visibilityRefreshRequired = globalDirtySignal || fresh || scrollExposed ||
        regionalDirtySignal || inactive ||
        stableUpdates < max(SchedulerFrame(30u), 1u);
    float measuredReceiverContribution;
    uint receiverCoverageAndFlags;
    bool receiverContributionFeedbackEnabled =
        SchedulerReadPreviousReceiverContribution(
            probeIndex,
            measuredReceiverContribution,
            receiverCoverageAndFlags);
    bool measuredReceiver = receiverContributionFeedbackEnabled &&
        measuredReceiverContribution > 0.0 &&
        (receiverCoverageAndFlags &
            SIMPLE_DDGI_SCHEDULER_RECEIVER_ROLE_MASK) != 0u;
    int importance = baseImportance + (proximity ? 3 : 0) +
        (scrollExposed ? 1 : 0);
    bool visible = visibilityRefreshRequired &&
        (importance >= 4 || measuredReceiver);
    if (SchedulerUrgentRelight() &&
        !(radiometricRelightEligible && visible && ring == 0u && !inactive))
    {
        // The pre-forward lane cannot wait on new geometry or repair a source
        // cache. Leave every ineligible probe byte-identical for the ordinary
        // post-forward scheduler, whose budget and complete-field authority are
        // intentionally independent of this bounded transaction.
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }
    bool cardinalityPromotionDue = sourceReady &&
        SchedulerAdaptivePromotionDue(
            volumeIndex,
            sourceRays,
            residualEnvelope,
            stableUpdates) &&
        !globalDirty && !regionalDirty && !sourceInvalid &&
        !fresh && !scrollExposed && !relocationRetry && !inactive;
    bool stableTailParticipant =
        sourceReady &&
        !cardinalityPromotionDue &&
        !fresh &&
        !scrollExposed &&
        !relocationRetry &&
        !inactive &&
        activeWeight > 0.001 &&
        !globalDirty &&
        !regionalDirty &&
        !sourceInvalid;
    bool pendingTailSource =
        !inactive &&
        activeWeight > 0.001 &&
        (!sourceReady ||
            fresh ||
            scrollExposed ||
            relocationRetry ||
            globalDirty ||
            regionalDirty ||
            sourceInvalid ||
            routineDue ||
            cardinalityPromotionDue);
    if (SchedulerTailCertification() && pendingTailSource)
    {
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_PENDING_TAIL_SOURCE],
            1u);
    }
    if (SchedulerTailCertification() &&
        solveEpoch != 0u &&
        !stableTailParticipant)
    {
        // A solve epoch and its audit certify one frozen source operator. Do
        // not repair, relocate, classify, or reactivate a probe inside that
        // epoch. Feedback still reports the pending source participant, which
        // makes the CPU controller abandon this epoch and return to source
        // repair before any replacement cache write is admitted.
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }
    if (SchedulerTailCertification() &&
        solveEpoch != 0u &&
        lastSolveEpoch == solveEpoch)
    {
        // A tail solve is an exact complete-field sweep, not an open-ended
        // maintenance queue. Once this participant has published for the
        // current epoch, exclude it from classification until the controller
        // advances the epoch. This makes progress independent of lane cursor
        // stability and prevents a warm prior from repeatedly consuming the
        // frame budget with the same high-priority subset.
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }
    bool zeroSupport = fresh || relocationRetry || activeWeight <= 0.0001 ||
        (SchedulerTransportV2() && sourceRays == 0u && !inactive);
    bool visibleZeroSupport = visible && zeroSupport;
    uint packedPropagation = SchedulerArenaRead(schedulerStateBase + 11u);
    float propagatedResidual = unpackHalf2x16(
        packedPropagation & 0xffffu).x;
    uint propagationGeneration = (packedPropagation >> 16u) & 0xffu;
    uint propagationDeadline = packedPropagation >> 24u;
    bool sparsePropagationDue = SchedulerSparseResidualPropagation() &&
        propagationGeneration == (SchedulerTransportGeneration() & 0xffu) &&
        !isnan(propagatedResidual) && !isinf(propagatedResidual) &&
        propagatedResidual > max(
            uintBitsToFloat(SchedulerFrame(39u)),
            1.0e-7);
    float orderingResidual = sparsePropagationDue &&
            (isnan(residualEnvelope) || isinf(residualEnvelope) ||
                residualEnvelope < 0.0)
        ? propagatedResidual
        : (sparsePropagationDue
            ? max(residualEnvelope, propagatedResidual)
            : residualEnvelope);
    uint packedTransport = SchedulerArenaRead(schedulerStateBase + 7u);
    uint completedTransportGeneration =
        (packedTransport & SIMPLE_DDGI_SCHEDULER_TRANSPORT_GENERATION_MASK) >>
        SIMPLE_DDGI_SCHEDULER_TRANSPORT_GENERATION_SHIFT;
    bool solverConverged = SchedulerTransportV2() && sourceReady &&
        !SchedulerTailCertification() &&
        completedTransportGeneration == (SchedulerTransportGeneration() & 0xffu) &&
        stableUpdates >= max(SchedulerFrame(30u), 1u) &&
        !isnan(residualEnvelope) && !isinf(residualEnvelope) &&
        residualEnvelope >= 0.0 &&
        residualEnvelope <= uintBitsToFloat(SchedulerFrame(39u));
    if (solverConverged && !sparsePropagationDue && !cardinalityPromotionDue &&
        !globalDirty && !regionalDirty && !fresh &&
        !scrollExposed && !sourceInvalid && !relocationRetry && !inactiveRetry)
    {
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }
    if (visible)
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_VISIBLE;
    // The reason payload is the transaction-private classification proposal.
    // Persistent visibility and invalidation metadata are applied by
    // CommitLocal only after all producer completion bits have been validated.
    // Raw dirty-region signals can remain present after this probe's marker is
    // current. Do not leak those signals into a cached-solver candidate:
    // admission interprets these reason bits as an ownership invalidation.
    // Only the effective one-shot invalidation proposal may carry them.
    if (invalidate)
    {
        reasons |= invalidationReasons & (
            SIMPLE_DDGI_SCHEDULER_REASON_FRESH |
            SIMPLE_DDGI_SCHEDULER_REASON_SCROLL |
            SIMPLE_DDGI_SCHEDULER_REASON_REGIONAL_DIRTY |
            SIMPLE_DDGI_SCHEDULER_REASON_GLOBAL_DIRTY |
            SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID |
            SIMPLE_DDGI_SCHEDULER_REASON_TOPOLOGY);
    }
    // Inactive is an admission gate, not merely a lower-priority work class.
    // A freshly classified inactive probe can legitimately retain FRESH or
    // RELOCATION_PENDING while its receiver payload is invalidated.  Testing
    // visibleZeroSupport first would let those flags bypass the bounded retry
    // interval, pollute the frozen tail cohort's per-volume quotas, and starve
    // the final active source repairs.  Initial probes are bootstrapped with an
    // active weight of one, so this ordering does not suppress first-time
    // classification; an inactive probe re-enters only through inactiveRetry.
    if (inactive && !inactiveRetry)
    {
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }
    else if (visibleZeroSupport)
    {
        workClass = SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT;
        transport = SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
        rayTier = SIMPLE_DDGI_SCHEDULER_RAY_FULL;
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_VISIBLE;
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_INACTIVE_RETRY;
        reasons |= fresh ? SIMPLE_DDGI_SCHEDULER_REASON_FRESH : 0u;
        reasons |= scrollExposed ? SIMPLE_DDGI_SCHEDULER_REASON_SCROLL : 0u;
    }
    else if (fresh || scrollExposed || (invalidate && (invalidationReasons & SIMPLE_DDGI_SCHEDULER_REASON_FRESH) != 0u))
    {
        workClass = SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE;
        transport = SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
        rayTier = SIMPLE_DDGI_SCHEDULER_RAY_FULL;
        reasons |= fresh ? SIMPLE_DDGI_SCHEDULER_REASON_FRESH : 0u;
        reasons |= scrollExposed ? SIMPLE_DDGI_SCHEDULER_REASON_SCROLL : 0u;
    }
    else if (relocationRetry || inactiveRetry)
    {
        workClass = SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY;
        transport = SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
        rayTier = SIMPLE_DDGI_SCHEDULER_RAY_FULL;
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_RETRY;
        reasons |= relocationRetry ? SIMPLE_DDGI_SCHEDULER_REASON_RELOCATION_RETRY : 0u;
        reasons |= inactiveRetry ? SIMPLE_DDGI_SCHEDULER_REASON_INACTIVE_RETRY : 0u;
    }
    else if (cardinalityPromotionDue)
    {
        // A low-cardinality source sequence is a committed pilot, not a
        // partially valid full sequence. Promote exactly one supported Sobol
        // prefix after measured solve residual (or the ring baseline) asks for
        // it; commit then freezes the new count before any audit can begin.
        workClass = SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY;
        transport = SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
        rayTier = SIMPLE_DDGI_SCHEDULER_RAY_FULL;
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_CONVERGENCE |
            SIMPLE_DDGI_SCHEDULER_REASON_ROUTINE_DUE |
            SIMPLE_DDGI_SCHEDULER_REASON_RESIDUAL_PROPAGATION;
    }
    else if (!sourceReady || sourceInvalid || globalDirty || regionalDirty)
    {
        workClass = SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY;
        transport = SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
        rayTier = SIMPLE_DDGI_SCHEDULER_RAY_FULL;
        reasons |= regionalDirty ? SIMPLE_DDGI_SCHEDULER_REASON_REGIONAL_DIRTY : 0u;
        reasons |= !sourceReady || sourceInvalid
            ? SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID
            : 0u;
        reasons |= globalDirty ? SIMPLE_DDGI_SCHEDULER_REASON_GLOBAL_DIRTY : 0u;
    }
    else
    {
        // A certified tail solve has an explicit source-cohort boundary. Do
        // not run speculative cached transport while the controller still
        // advertises epoch zero: failed pre-epoch work can set the private
        // repair bit and prevent the source cohort from ever becoming whole.
        // A genuinely due periodic source refresh remains legal after a
        // certificate has returned the controller to epoch zero.
        if (SchedulerTailCertification() &&
            solveEpoch == 0u &&
            !routineDue && !sparsePropagationDue)
        {
            SchedulerWriteInvalidCandidate(candidateBase);
            return;
        }
        workClass = SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE + ring;
        transport = sourceReady
            ? SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER
            : SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
        rayTier = sourceReady
            ? SIMPLE_DDGI_SCHEDULER_RAY_MAINTENANCE
            : SIMPLE_DDGI_SCHEDULER_RAY_FULL;
        reasons |= sourceReady ? SIMPLE_DDGI_SCHEDULER_REASON_CONVERGENCE :
            SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID;
        if (sparsePropagationDue)
            reasons |= SIMPLE_DDGI_SCHEDULER_REASON_RESIDUAL_PROPAGATION;
        if (routineDue)
        {
            transport = SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
            rayTier = SIMPLE_DDGI_SCHEDULER_RAY_FULL;
            reasons |= SIMPLE_DDGI_SCHEDULER_REASON_ROUTINE_DUE;
        }
    }

    if (SchedulerCostAwarePriority() &&
        workClass >= SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE)
    {
        // Reclassify only the three maintenance priority lanes. Volume/ring
        // quotas remain independent, and age at the hard deadline always wins
        // regardless of predicted expense. The frozen audit still visits the
        // complete participant set, so this changes order rather than quality.
        uint priorityRayCount = rayTier == SIMPLE_DDGI_SCHEDULER_RAY_FULL
            ? max(SchedulerVolumeFullRays(volumeIndex), 1u)
            : max(SchedulerVolumeMaintenanceRays(volumeIndex), 1u);
        bool cachedOnly = transport ==
            SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER;
        bool primaryTrace = (transport ==
                SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
            transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE) &&
            !SchedulerCandidateUsesRadiometricRelight(reasons);
        float normalizedResidual = orderingResidual /
            max(uintBitsToFloat(SchedulerFrame(39u)), 0.000001);
        uint maximumLatency = max(retryFrames, 60u);
        // Actual delayed contribution dominates the quality-sensitive order.
        // Retain a small camera-visible prior for the bootstrap frame and for
        // reflection/safety work that is intentionally outside the sampled
        // receiver set. Hard latency and per-ring quotas remain below/above
        // this score and therefore cannot be suppressed by absent feedback.
        float ordinaryReceiverPrior = visible
            ? max(activeWeight, 1.0)
            : activeWeight * 0.25;
        float priorityReceiverContribution = ordinaryReceiverPrior +
            (receiverContributionFeedbackEnabled
                ? measuredReceiverContribution
                : 0.0);
        float score = SchedulerErrorReductionPerCost(
            normalizedResidual,
            priorityReceiverContribution,
            stateAge,
            maximumLatency,
            SchedulerPredictedRelativeCost(
                priorityRayCount,
                primaryTrace,
                cachedOnly));
        bool propagationDeadlineReached = sparsePropagationDue &&
            (((SchedulerFrameIndex() & 0xffu) - propagationDeadline) & 0xffu) <
                0x80u;
        if (stateAge >= maximumLatency || propagationDeadlineReached || score >= 0.08)
            workClass = SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE;
        else if (score >= 0.025)
            workClass = SIMPLE_DDGI_SCHEDULER_WORK_MID_MAINTENANCE;
        else
            workClass = SIMPLE_DDGI_SCHEDULER_WORK_FAR_MAINTENANCE;
    }

    // Cardinalities are deterministic policy values for this volume, transport
    // category, and ray tier. Admission derives them after selecting a
    // candidate, so the large classification pool stores no redundant counts.
    bool sourceTransport =
        transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
        transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
    if (sourceTransport &&
        SchedulerSparseVisiblePagePublicationPending(
            probeIndex,
            volumeIndex,
            physicalProbeIndex,
            pageMappingGeneration))
    {
        reasons |= SIMPLE_DDGI_SCHEDULER_REASON_VISIBLE_PAGE_COHORT;
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_VISIBLE_PAGE_COHORT_BASE +
                    volumeIndex],
            1u);
    }
    uint lane = SchedulerLaneIndex(volumeIndex, workClass, transport, rayTier);
    if (lane >= SIMPLE_DDGI_SCHEDULER_MAX_LANES)
    {
        SchedulerWriteInvalidCandidate(candidateBase);
        return;
    }

    SchedulerWriteCandidate(candidateBase, probeIndex, volumeIndex,
        workClass | (transport << 3u),
        rayTier | ((reasons & 0xffffu) << 8u));
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
        pc.LaneCandidateCountsOffsetWords + lane], 1u);
    SchedulerAtomicIncrementGroupLaneCount(
        sequenceOrdinal / SIMPLE_DDGI_SCHEDULER_WORKGROUP_SIZE,
        lane);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE_CLASS_BASE + workClass], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(pc.ArenaBufferIndex)].Words[
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE_RING_BASE +
            min(SchedulerVolumeRing(volumeIndex), 2u)], 1u);
}
