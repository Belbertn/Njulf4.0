#version 460
#extension GL_GOOGLE_include_directive : require
#include "optical_compact.glsl"
layout(set=1,binding=0,rgba16f) uniform image2D OpticalSceneColor;
layout(set=1,binding=1,rgba16f) uniform image2D OpticalAccumulation;
bool OcNativeMatch(uint native,uint s) {
 uint a=pc.Padding0,b=pc.Current;
 if(!OcValid(b,s) || OpticalWord(a,native)!=OpticalWord(b,s) || OpticalWord(a,native+1u)!=OpticalWord(b,s+1u) || OpticalWord(a,native+33u)!=OpticalWord(b,s+15u))return false;
 vec3 n=OpticalNormal(OpticalWord(a,native+2u));
 return dot(n,OpticalNormal(OpticalWord(b,s+2u)))>.95 && abs(OpticalFloat(a,native+7u)-OpticalFloat(b,s+7u))<.1 &&
  abs(dot(n,OpticalVec(a,native+4u)-OpticalVec(b,s+4u)))<max(.003,OpticalFloat(a,native+11u)*.003);
}
void main() {
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);uint src=pc.Padding0;
 if(pc.Bypass!=0u || !OpticalPixelValid(src,p) || OpticalCount(src,p)==0u)return;
 vec3 correction=vec3(0);
 vec2 samplePosition=(vec2(p)+.5)*.5-.5;ivec2 base=ivec2(floor(samplePosition));vec2 f=fract(samplePosition);
 for(uint layer=0u;layer<OpticalCount(src,p);layer++) {
  uint r=OpticalRecord(src,p,layer); vec3 sums[2]=vec3[2](vec3(0),vec3(0));vec2 weights=vec2(0);
  for(int y=0;y<2;y++)for(int x=0;x<2;x++) { ivec2 q=base+ivec2(x,y);if(!OcInside(q))continue;
   for(uint l=0u;l<2u;l++) { uint s=OcRecord(q,l);if(!OcNativeMatch(r,s))continue;
    float w=(x==0?1.0-f.x:f.x)*(y==0?1.0-f.y:f.y);
    for(uint lobe=0u;lobe<2u;lobe++) {vec4 v=OcRadiance(pc.Current,s,24u+lobe*2u);if(v.a>0.0){sums[lobe]+=v.rgb*w;weights[lobe]+=w;}}
    break;
   }
  }
  // Deeper/nonrepresented layers get a small geometry-aware spatial estimate.
  // Their contribution still uses their own material and composition weights.
  if(any(lessThanEqual(weights,vec2(0)))) {
   for(uint lobe=0u;lobe<2u;lobe++)if(weights[lobe]<=0.0) {
    for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++) {
     uint s=OpticalMatch(src,r,src,p+ivec2(x,y)*2,false);
     if(s==OPTICAL_INVALID || OpticalFloat(src,s+15u+lobe*4u)<=0.0 || !OpticalSourceCompatible(src,r,src,s,lobe))continue;
     sums[lobe]+=OpticalVec(src,s+12u+lobe*4u);weights[lobe]+=1.0;
    }
   }
  }
  float composition=OpticalCompositionWeight(src,r,p,pc.Weighted!=0u);
  for(uint lobe=0u;lobe<2u;lobe++)if(weights[lobe]>0.0)
   correction+=(sums[lobe]/weights[lobe]-OpticalVec(src,r+12u+lobe*4u))*OpticalVec(src,r+20u+lobe*4u)*composition;
 }
 if(!OpticalFinite(correction))return;
 vec4 original=pc.Weighted!=0u?imageLoad(OpticalAccumulation,p):imageLoad(OpticalSceneColor,p);
 vec4 result=vec4(clamp(original.rgb+correction,vec3(0),vec3(65504)),original.a);
 if(pc.Weighted!=0u)imageStore(OpticalAccumulation,p,result);else imageStore(OpticalSceneColor,p,result);
}

