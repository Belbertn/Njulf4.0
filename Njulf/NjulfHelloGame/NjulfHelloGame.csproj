<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CookedAssetsOnly Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ShippingPerformance'">true</CookedAssetsOnly>
        <DefineConstants Condition="'$(CookedAssetsOnly)' != 'true'">$(DefineConstants);NJULF_EDITOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FlipBinding.CSharp" Version="1.0.3" />
      <ProjectReference Include="..\Njulf.Core\Njulf.Core.csproj" />
      <ProjectReference Include="..\Njulf.Rendering\Njulf.Rendering.csproj" />
      <ProjectReference Include="..\Njulf.Assets\Njulf.Assets.csproj" />
      <ProjectReference Include="..\Njulf.Input\Njulf.Input.csproj" />
      <ProjectReference Include="..\Njulf.Editor\Njulf.Editor.csproj" Condition="'$(CookedAssetsOnly)' != 'true'" />
    </ItemGroup>

    <ItemGroup>
      <None Update="NewSponza_Main_glTF_003.gltf" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="NewSponza_Main_glTF_003.bin" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="NewSponza_Curtains_glTF.gltf" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="NewSponza_Curtains_glTF.bin" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="Strut.glb" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="sample-asset-validation-report.json" CopyToOutputDirectory="IfDifferent" />
      <None Update="THIRD-PARTY-NOTICES.txt"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <None Include="..\Njulf.AssetTool\Imazen.WebP.provenance.json"
            Link="Imazen.WebP.provenance.json"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <None Update="Assets\**\*.*" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="Assets\Photometry\*.ies"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <None Update="Assets\Bistro_v5_2\san_giuseppe_bridge_4k.hdr"
            CopyToOutputDirectory="PreserveNewest" />
      <None Update="textures\**\*.*" CopyToOutputDirectory="IfDifferent" Condition="'$(CookedAssetsOnly)' != 'true'" />
      <None Update="textures\IvyLeaf_*.png" CopyToOutputDirectory="Never" />
      <None Update="Cooked\**\*.*" CopyToOutputDirectory="IfDifferent" />
      <None Update="Scenes\**\*.njscene.json" CopyToOutputDirectory="IfDifferent" />
    </ItemGroup>

    <!-- StbImageSharp remains a deliberate runtime dependency: the supported
         descriptor-stable texture hot-reload path decodes replacement pixels
         in cooked Release hosts without loading any model importer. -->
    <Target Name="ExcludeSourceImporterRuntimeFiles"
            AfterTargets="ResolveReferences"
            Condition="'$(CookedAssetsOnly)' == 'true'">
      <ItemGroup>
        <_SourceImporterRuntimeFile Include="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('SharpGLTF'))
                  Or $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('Silk.NET.Assimp'))
                  Or $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('Assimp'))
                  Or $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('BCnEncoder'))" />
        <ReferenceCopyLocalPaths Remove="@(_SourceImporterRuntimeFile)" />
      </ItemGroup>
    </Target>

    <Target Name="ExcludeSourceImporterPublishedFiles"
            AfterTargets="ComputeFilesToPublish"
            Condition="'$(CookedAssetsOnly)' == 'true'">
      <ItemGroup>
        <_SourceImporterPublishedFile Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('SharpGLTF'))
                  Or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('Silk.NET.Assimp'))
                  Or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('Assimp'))
                  Or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('BCnEncoder'))" />
        <ResolvedFileToPublish Remove="@(_SourceImporterPublishedFile)" />
      </ItemGroup>
    </Target>

</Project>
