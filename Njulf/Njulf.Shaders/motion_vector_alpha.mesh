#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require

#include "common.glsl"

#ifndef NJULF_MESH_LOCAL_SIZE
#ifdef MOTION_VECTOR_COMPACTED_MESH
#define NJULF_MESH_LOCAL_SIZE 64
#else
#define NJULF_MESH_LOCAL_SIZE 128
#endif
#endif
#ifndef NJULF_MESH_MAX_VERTICES
#ifdef MOTION_VECTOR_COMPACTED_MESH
#define NJULF_MESH_MAX_VERTICES 48
#define NJULF_MESH_MAX_PRIMITIVES 64
#else
#define NJULF_MESH_MAX_VERTICES 64
#define NJULF_MESH_MAX_PRIMITIVES 126
#endif
#endif
layout(local_size_x = NJULF_MESH_LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = NJULF_MESH_MAX_VERTICES, max_primitives = NJULF_MESH_MAX_PRIMITIVES) out;

#ifndef MOTION_VECTOR_COMPACTED_MESH
struct MotionVectorTaskPayload
{
    uint DrawCommandIndex;
    uint Visible;
};

taskPayloadSharedEXT MotionVectorTaskPayload motionPayload;
#endif
shared uint meshNegativeDeterminant;

layout(location = 0) noperspective out vec2 meshCurrentUv[];
layout(location = 1) noperspective out vec2 meshPreviousUv[];
layout(location = 2) out vec2 meshTexCoord[];
layout(location = 3) out vec2 meshTexCoord2[];
layout(location = 4) out vec4 meshVertexColor[];
layout(location = 5) flat out uint meshMaterialIndex[];
layout(location = 6) flat out uint meshReceiverSignature[];
layout(location = 7) flat out uint meshHistoryFrameAndFlags[];
layout(location = 8) out vec3 meshCurrentWorldPosition[];
layout(location = 9) out vec2 meshViewDepths[];

layout(push_constant) uniform MotionVectorPushConstantBlock
{
    GPUMotionVectorPushConstants Push;
} pc;

vec2 ClipToUv(vec4 clip)
{
    vec2 ndc = clip.xy / max(abs(clip.w), 0.000001);
    return ndc * 0.5 + vec2(0.5);
}

void main()
{
#ifdef MOTION_VECTOR_COMPACTED_MESH
    uint localDrawIndex = gl_WorkGroupID.x;
    if (localDrawIndex >= pc.Push.MeshletDrawCount)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint drawCommandIndex = localDrawIndex + pc.Push.FirstDraw;
#else
    if (motionPayload.Visible == 0u)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint drawCommandIndex = motionPayload.DrawCommandIndex;
#endif

    GPUMeshletDrawCommand command = ReadMeshletDrawCommandFromBase(
        pc.Push.MeshletDrawBufferBaseIndex,
        pc.Push.CurrentFrameIndex,
        drawCommandIndex);
    GPUMeshlet meshlet = ReadMeshlet(
        command.MeshletIndex,
        pc.Push.CurrentFrameIndex);
    if (meshlet.LocalVertexCount > uint(NJULF_MESH_MAX_VERTICES) ||
        meshlet.LocalTriangleCount > uint(NJULF_MESH_MAX_PRIMITIVES))
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) + pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId * uint(SIZEOF_GPU_OBJECT_DATA / 4);

    if (gl_LocalInvocationIndex == 0u)
    {
        SetMeshOutputsEXT(meshlet.LocalVertexCount, meshlet.LocalTriangleCount);
        meshNegativeDeterminant =
            ReadRowMajorLinearDeterminant(instanceBufferIndex, objectWordOffset) < 0.0
                ? 1u
                : 0u;
    }

    barrier();

    GPUObjectData objectData = ReadInstanceData(pc.Push.CurrentFrameIndex, command.InstanceId);

    for (uint vertexSlot = gl_LocalInvocationIndex;
         vertexSlot < meshlet.LocalVertexCount;
         vertexSlot += gl_WorkGroupSize.x)
    {
        uint localVertexIndex = ReadMeshletLocalVertexIndex(
            meshlet,
            vertexSlot);
        GPUVertex vertex = FetchRenderableVertex(
            meshlet,
            localVertexIndex,
            objectData,
            pc.Push.CurrentFrameIndex);

        vec4 currentWorldPosition = TransformRowMajorPoint(
            vertex.Position,
            instanceBufferIndex,
            objectWordOffset);
        vec4 previousWorldPosition = TransformRowMajorPoint(
            vertex.Position,
            instanceBufferIndex,
            objectWordOffset + 36u);
        vec4 currentClip = MulRowMajor(currentWorldPosition, pc.Push.ViewProjectionMatrix);
        vec4 previousClip = MulRowMajor(previousWorldPosition, pc.Push.PreviousViewProjectionMatrix);

        gl_MeshVerticesEXT[vertexSlot].gl_Position = currentClip;
        meshCurrentUv[vertexSlot] = ClipToUv(currentClip);
        meshPreviousUv[vertexSlot] = (pc.Push.PreviousFrameValid & 1u) != 0u
            ? ClipToUv(previousClip)
            : meshCurrentUv[vertexSlot];
        meshTexCoord[vertexSlot] = vertex.TexCoord;
        meshTexCoord2[vertexSlot] = vertex.TexCoord2;
        meshVertexColor[vertexSlot] = vertex.Color;
        meshMaterialIndex[vertexSlot] = command.MaterialIndex;
        meshReceiverSignature[vertexSlot] =
            (command.InstanceId * 0x9e3779b9u) ^
            (command.MaterialIndex * 0x85ebca6bu) ^
            (command.MeshletIndex * 0xc2b2ae35u) ^ 0x51ed270bu;
        meshHistoryFrameAndFlags[vertexSlot] =
            (pc.Push.CurrentFrameIndex & 0xffu) |
            ((pc.Push.PreviousFrameValid & 6u) << 7u);
        meshCurrentWorldPosition[vertexSlot] = currentWorldPosition.xyz;
        meshViewDepths[vertexSlot] = vec2(
            abs(currentClip.w),
            abs(previousClip.w));
    }

    for (uint triangleSlot = gl_LocalInvocationIndex;
         triangleSlot < meshlet.LocalTriangleCount;
         triangleSlot += gl_WorkGroupSize.x)
    {
        uint triangleOffset = triangleSlot * 3u;
        uint i0 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 0u);
        uint i1 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 1u);
        uint i2 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 2u);
        gl_PrimitiveTriangleIndicesEXT[triangleSlot] = ResolveMirroredInstanceTriangle(
            i0,
            i1,
            i2,
            meshNegativeDeterminant != 0u);
        gl_MeshPrimitivesEXT[triangleSlot].gl_CullPrimitiveEXT =
            !MeshletLodTransitionTriangleVisible(
                command.Flags,
                command.InstanceId,
                command.MeshletIndex,
                triangleSlot);
    }
}
