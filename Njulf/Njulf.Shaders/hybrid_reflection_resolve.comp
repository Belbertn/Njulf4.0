#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"
#include "automatic_planar_reflection.glsl"

const uint REFLECTION_BOX_PROJECTION_ENABLED_FLAG = 1u << 1u;
const uint REFLECTION_PROBE_BLENDING_ENABLED_FLAG = 1u << 2u;
const int REFLECTION_PROBE_BOX_PROJECTION_FLAG = 1;
const int REFLECTION_PROBE_CAPTURED_RADIANCE_AVAILABLE_FLAG = 1 << 1;
const int REFLECTION_PROBE_SHAPE_SPHERE = 1;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionResolvePushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndIntensity;
    uint ScreenWidth;
    uint ScreenHeight;
    uint MaximumProbesPerPixel;
    uint ReflectionDebugView;
    float SsrConfidenceThreshold;
    float AnalyticTransitionStartRoughness;
    float AnalyticTransitionEndRoughness;
    uint DdgiBaseAvailable;
    uint CurrentFrameIndex;
    uint EffectiveReflectionMode;
    uint UseActiveTileList;
    uint ManualProbeFallbackEnabled;
} pc;

vec3 HybridTransformProbePoint(GPUReflectionProbe probe, vec3 position)
{
    return MulRowMajor(vec4(position, 1.0), probe.WorldToProbe).xyz;
}

vec3 HybridTransformProbeVector(GPUReflectionProbe probe, vec3 direction)
{
    return normalize(MulRowMajor(vec4(direction, 0.0),
        probe.WorldToProbe).xyz);
}

float HybridProbeWeight(GPUReflectionProbe probe, vec3 worldPosition)
{
    float blendDistance = max(probe.BlendParams.x, 0.0);
    if (probe.Shape == REFLECTION_PROBE_SHAPE_SPHERE)
    {
        float radius = max(probe.PositionAndRadius.w, 0.0001);
        float distanceToProbe = length(worldPosition -
            probe.PositionAndRadius.xyz);
        if (distanceToProbe >= radius)
            return 0.0;
        if (blendDistance <= 0.0)
            return 1.0;
        return 1.0 - smoothstep(max(radius - blendDistance, 0.0),
            radius, distanceToProbe);
    }
    vec3 localPosition = HybridTransformProbePoint(probe, worldPosition);
    vec3 extents = max(abs(probe.BoxMax.xyz), vec3(0.0001));
    if (any(greaterThan(abs(localPosition), extents)))
        return 0.0;
    if (blendDistance <= 0.0)
        return 1.0;
    float boundary = min(extents.x - abs(localPosition.x),
        min(extents.y - abs(localPosition.y),
            extents.z - abs(localPosition.z)));
    return smoothstep(0.0, blendDistance, boundary);
}

float HybridBoxAxisDistance(float position, float direction, float extent)
{
    if (abs(direction) <= 0.00001)
        return 3.402823e38;
    return ((direction > 0.0 ? extent : -extent) - position) / direction;
}

vec3 HybridProbeDirection(
    GPUReflectionProbeHeader header,
    GPUReflectionProbe probe,
    vec3 worldPosition,
    vec3 reflectionDirection)
{
    vec3 localDirection = HybridTransformProbeVector(
        probe, reflectionDirection);
    if ((header.Flags & REFLECTION_BOX_PROJECTION_ENABLED_FLAG) == 0u ||
        (probe.Flags & REFLECTION_PROBE_BOX_PROJECTION_FLAG) == 0 ||
        probe.Shape == REFLECTION_PROBE_SHAPE_SPHERE)
    {
        return localDirection;
    }
    vec3 localPosition = HybridTransformProbePoint(probe, worldPosition);
    vec3 extents = max(abs(probe.BoxMax.xyz), vec3(0.0001));
    if (any(greaterThan(abs(localPosition), extents)))
        return localDirection;
    float distance = min(
        HybridBoxAxisDistance(localPosition.x, localDirection.x, extents.x),
        min(HybridBoxAxisDistance(localPosition.y, localDirection.y, extents.y),
            HybridBoxAxisDistance(localPosition.z, localDirection.z, extents.z)));
    return distance > 0.0 && distance < 3.402823e37
        ? normalize(localPosition + localDirection * distance)
        : localDirection;
}

bool HybridSampleLocalProbe(
    vec3 worldPosition,
    vec3 reflectionDirection,
    float roughness,
    out vec3 radiance,
    out float confidence)
{
    radiance = vec3(0.0);
    confidence = 0.0;
    GPUReflectionProbeHeader header = ReadReflectionProbeHeader();
    if (header.ProbeCount <= 0 ||
        header.ProbeCubemapArrayTextureIndex < 0)
    {
        return false;
    }
    float totalWeight = 0.0;
    uint accepted = 0u;
    uint maximum = max(pc.MaximumProbesPerPixel, 1u);
    bool blendingEnabled =
        (header.Flags & REFLECTION_PROBE_BLENDING_ENABLED_FLAG) != 0u;
    float maximumLod = max(float(header.ProbeMipCount) - 1.0, 0.0);
    float lod = maximumLod > 0.0
        ? mix(1.0, maximumLod, roughness)
        : 0.0;
    for (int probeIndex = 0;
         probeIndex < header.ProbeCount && accepted < maximum;
         probeIndex++)
    {
        GPUReflectionProbe probe = ReadReflectionProbe(uint(probeIndex));
        if (probe.CubemapArrayIndex < 0 ||
            (probe.Flags & REFLECTION_PROBE_CAPTURED_RADIANCE_AVAILABLE_FLAG) == 0)
        {
            continue;
        }
        float weight = HybridProbeWeight(probe, worldPosition);
        if (weight <= 0.0001)
            continue;
        if (!blendingEnabled)
            weight = 1.0;
        vec3 direction = HybridProbeDirection(header, probe,
            worldPosition, reflectionDirection);
        vec3 sampleValue = textureLod(
            BindlessCubeArrayTextures[nonuniformEXT(
                header.ProbeCubemapArrayTextureIndex)],
            vec4(direction, float(probe.CubemapArrayIndex)), lod).rgb;
        radiance += max(sampleValue, vec3(0.0)) *
            max(probe.BlendParams.y, 0.0) * weight;
        totalWeight += weight;
        accepted++;
        if (!blendingEnabled)
            break;
    }
    if (totalWeight <= 0.0001)
        return false;
    // The resolve epilogue applies the common reflection intensity exactly
    // once for SSR, ray-query, probe, and environment sources.
    radiance /= totalWeight;
    confidence = mix(0.55, 0.9, clamp(totalWeight, 0.0, 1.0));
    return true;
}

void HybridSampleAnalyticFallback(
    vec3 worldPosition,
    vec3 reflectionDirection,
    float roughness,
    GPUEnvironmentData environment,
    GPUReflectionProbeHeader probeHeader,
    out vec3 radiance,
    out float confidence,
    out uint source)
{
    if (pc.ManualProbeFallbackEnabled != 0u &&
        HybridSampleLocalProbe(worldPosition, reflectionDirection,
            roughness, radiance, confidence))
    {
        source = HYBRID_REFLECTION_SOURCE_LOCAL_PROBE;
        return;
    }

    float maximumLod = max(
        float(environment.PrefilteredMipCount) - 1.0, 0.0);
    radiance = SampleEnvironmentPrefilteredRadiance(
        environment, reflectionDirection, roughness * maximumLod) *
        max(probeHeader.GlobalFallbackIntensity, 0.0);
    confidence = environment.Enabled != 0u ? 0.45 : 0.0;
    source = HYBRID_REFLECTION_SOURCE_ENVIRONMENT;
}

void main()
{
    uvec2 invocation = HybridReflectionTileInvocation(
        pc.UseActiveTileList != 0u);
    if (invocation.x >= pc.ScreenWidth || invocation.y >= pc.ScreenHeight)
        return;
    ivec2 pixel = ivec2(invocation);
    uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
    if (!HybridReflectionPayloadValid(payload))
    {
        imageStore(HybridRawRadiance, pixel, vec4(0.0));
        imageStore(HybridRawMetadata, pixel, uvec4(0u));
        return;
    }

    vec3 worldPosition;
    float depth;
    if (!HybridReconstructWorldPosition(pixel,
            uvec2(pc.ScreenWidth, pc.ScreenHeight),
            pc.InverseViewProjectionMatrix,
            worldPosition, depth))
    {
        imageStore(HybridRawRadiance, pixel, vec4(0.0));
        imageStore(HybridRawMetadata, pixel, uvec4(0u));
        return;
    }

    uvec2 metadata = imageLoad(HybridRawMetadata, pixel).xy;
    vec4 raw = imageLoad(HybridRawRadiance, pixel);
    vec4 clearcoatRaw = imageLoad(HybridDdgiCohorts, pixel);
    bool planarOnly = pc.EffectiveReflectionMode == 4u;
    bool planarEnabled = planarOnly || pc.EffectiveReflectionMode == 5u;
    if (planarOnly)
    {
        // StaticProbesAndPlanar intentionally submits no SSR/ray/DDGI work.
        // Ignore all prior contents and rebuild the exact planar -> probe ->
        // environment chain for every current receiver.
        metadata = uvec2(0u);
        raw = vec4(0.0);
        clearcoatRaw = vec4(0.0);
    }
    uint source = HybridMetadataSource(metadata.x);
    float confidence = HybridMetadataConfidence(metadata.x);
    if (!planarEnabled &&
        HybridMetadataValid(metadata.x) &&
        HybridMetadataReason(metadata.x) ==
            HYBRID_REFLECTION_REASON_RESOLUTION_SKIP)
    {
        // Classification copied an already shaded, validated temporal value.
        // Do not apply the BRDF a second time during the cheap carry path.
        imageStore(HybridRawRadiance, pixel,
            vec4(max(raw.rgb, vec3(0.0)), confidence));
        return;
    }
    vec3 incidentRadiance = max(raw.rgb, vec3(0.0));
    float roughness = HybridReflectionPayloadPhysicalRoughness(payload);
    vec3 normal = HybridReflectionPayloadShadingNormal(payload);
    vec3 reflectionNormal = HybridReflectionTraceNormal(payload);
    vec3 viewDirection = normalize(
        pc.CameraPositionAndIntensity.xyz - worldPosition);
    vec3 reflectionDirection = normalize(
        reflect(-viewDirection, reflectionNormal));
    GPUEnvironmentData environment = ReadEnvironmentData();
    GPUReflectionProbeHeader probeHeader = ReadReflectionProbeHeader();
    vec4 ddgiBase = pc.DdgiBaseAvailable != 0u
        ? imageLoad(HybridHistoryCurrent, pixel)
        : vec4(0.0);
    bool ddgiBaseValid = HybridFinite(ddgiBase) &&
        ddgiBase.a > 0.0;
    vec3 planarRadiance;
    float planarConfidence;
    bool planarValid = planarEnabled && AutomaticPlanarTrySample(
        pc.CurrentFrameIndex,
        HybridReceiverIdentity(payload),
        worldPosition,
        HybridReflectionPayloadGeometricNormal(payload),
        roughness,
        planarRadiance,
        planarConfidence);
    if (planarValid)
    {
        incidentRadiance = planarRadiance;
        confidence = planarConfidence;
        source = HYBRID_REFLECTION_SOURCE_PLANAR;
        metadata.x = HybridPackMetadata(
            source,
            confidence,
            HYBRID_REFLECTION_REASON_NONE,
            0u,
            true);
    }
    if (pc.ReflectionDebugView == 11u)
    {
        imageStore(HybridRawRadiance, pixel,
            ddgiBaseValid ? ddgiBase : vec4(0.0));
        imageStore(HybridRawMetadata, pixel, uvec4(
            HybridPackMetadata(
                HYBRID_REFLECTION_SOURCE_DDGI,
                ddgiBaseValid ? clamp(ddgiBase.a, 0.0, 1.0) : 0.0,
                HYBRID_REFLECTION_REASON_NONE,
                0u,
                ddgiBaseValid),
            metadata.y, 0u, 0u));
        return;
    }
    float incidentRadianceScale =
        source == HYBRID_REFLECTION_SOURCE_ENVIRONMENT
            ? max(environment.SpecularIntensity, 0.0)
            : 1.0;

    if (!HybridMetadataValid(metadata.x))
    {
        if (ddgiBaseValid)
        {
            incidentRadiance = max(ddgiBase.rgb, vec3(0.0));
            confidence = clamp(ddgiBase.a, 0.0, 1.0);
            source = HYBRID_REFLECTION_SOURCE_DDGI;
            incidentRadianceScale = 1.0;
            HybridAccumulateScreenCounter(
                HYBRID_REFLECTION_COUNTER_DDGI_FALLBACKS, invocation);
        }
        else
        {
            HybridSampleAnalyticFallback(worldPosition, reflectionDirection,
                roughness, environment, probeHeader, incidentRadiance,
                confidence, source);
            incidentRadianceScale =
                source == HYBRID_REFLECTION_SOURCE_ENVIRONMENT
                    ? max(environment.SpecularIntensity, 0.0)
                    : 1.0;
            if (source == HYBRID_REFLECTION_SOURCE_LOCAL_PROBE)
            {
                HybridAccumulateScreenCounter(
                    HYBRID_REFLECTION_COUNTER_PROBE_FALLBACKS, invocation);
            }
            else
            {
                HybridAccumulateScreenCounter(
                    HYBRID_REFLECTION_COUNTER_ENVIRONMENT_FALLBACKS,
                    invocation);
            }
        }
    }

    // The quarter-resolution/analytic boundary can cross a high-frequency
    // roughness texture many times within one material. A hard source switch
    // there alternates dark scene hits with a bright environment at texel
    // scale. Complete only the unresolved part of a broad lobe analytically;
    // sharp glass, mirrors, and polished metal remain entirely scene-derived.
    bool geometricSource =
        source == HYBRID_REFLECTION_SOURCE_PLANAR ||
        source == HYBRID_REFLECTION_SOURCE_SSR ||
        source == HYBRID_REFLECTION_SOURCE_RAY_QUERY;
    float transitionStart = clamp(
        pc.AnalyticTransitionStartRoughness, 0.0, 1.0);
    float transitionEnd = max(transitionStart + 1.0e-4,
        clamp(pc.AnalyticTransitionEndRoughness, 0.0, 1.0));
    bool sharpImportant = HybridReflectionRequiresSharpDetail(payload);

    // Directional DDGI remains the authoritative scene-space reflection
    // source. Do not replace a valid broad DDGI lobe with the global sky: that
    // turns rough interior dielectrics into a neutral veil and removes the
    // local colour/occlusion that DDGI was selected to provide. The global
    // environment is used only when no DDGI base is available; SSR/ray query
    // continue to layer higher-frequency geometry over this base below.
    vec3 surfaceF0 = HybridReflectionPayloadF0(payload);
    float roughnessBlend = smoothstep(
        transitionStart, transitionEnd, roughness);
    // Like a confidence-alpha SSR composite, retain a valid analytic
    // background under uncertain geometric samples. Sharp/high-value lobes
    // bypass this blend and keep the exact scene result.
    float geometricWeight = sharpImportant
        ? 1.0
        : clamp(confidence, 0.0, 1.0) * (1.0 - roughnessBlend);
    float analyticBlend = geometricSource
        ? 1.0 - geometricWeight
        : 0.0;
    vec3 analyticReferenceRadiance = vec3(0.0);
    bool analyticReferenceAvailable = false;
    if (!geometricSource)
    {
        analyticReferenceRadiance =
            incidentRadiance * incidentRadianceScale;
        analyticReferenceAvailable = true;
    }
    if (analyticBlend > 0.0)
    {
        vec3 analyticRadiance;
        float analyticConfidence;
        uint analyticSource;
        if (ddgiBaseValid)
        {
            analyticRadiance = max(ddgiBase.rgb, vec3(0.0));
            analyticConfidence = clamp(ddgiBase.a, 0.0, 1.0);
            analyticSource = HYBRID_REFLECTION_SOURCE_DDGI;
        }
        else
        {
            HybridSampleAnalyticFallback(worldPosition, reflectionDirection,
                roughness, environment, probeHeader, analyticRadiance,
                analyticConfidence, analyticSource);
        }
        float analyticScale =
            analyticSource == HYBRID_REFLECTION_SOURCE_ENVIRONMENT
                ? max(environment.SpecularIntensity, 0.0)
                : 1.0;
        analyticReferenceRadiance = analyticRadiance * analyticScale;
        analyticReferenceAvailable = true;
        incidentRadiance = mix(
            incidentRadiance * incidentRadianceScale,
            analyticReferenceRadiance,
            analyticBlend);
        incidentRadianceScale = 1.0;
        confidence = mix(confidence, analyticConfidence, analyticBlend);
        if (analyticSource == HYBRID_REFLECTION_SOURCE_DDGI)
        {
            HybridAccumulateScreenCounter(
                HYBRID_REFLECTION_COUNTER_DDGI_FALLBACKS, invocation);
        }
        if (analyticBlend >= 0.999)
            source = analyticSource;
    }

    // Evaluate the BRDF over the same footprint normal used to trace/sample the
    // lobe. On broad receivers this is the geometric normal, preventing a
    // high-frequency masonry normal map from turning smooth DDGI energy into
    // Fresnel sparkle. Sharp receivers already select the shading normal.
    float nDotV = max(dot(reflectionNormal, viewDirection), 0.0);
    vec3 f0 = surfaceF0;
    vec3 fresnel = HybridFresnelSchlickRoughness(
        nDotV, f0, roughness);
    vec2 brdf = environment.BrdfLutTextureIndex >= 0
        ? texture(BindlessTextures[nonuniformEXT(
            environment.BrdfLutTextureIndex)], vec2(nDotV, roughness)).rg
        : vec2(1.0, 0.0);
    float specularOcclusion = HybridReflectionPayloadSpecularOcclusion(payload);
    // Environment.SpecularIntensity controls environment IBL only. SSR,
    // ray-query hits, and local probes already contain scene radiance and must
    // remain visible when environment lighting is disabled.
    vec3 scaledIncidentRadiance =
        incidentRadiance * incidentRadianceScale;
    if (geometricSource && !sharpImportant && analyticReferenceAvailable)
    {
        scaledIncidentRadiance = HybridLimitBroadReflectionRadiance(
            scaledIncidentRadiance,
            HybridMaximumComponent(analyticReferenceRadiance));
    }
    vec3 contribution = scaledIncidentRadiance *
        (fresnel * brdf.x + brdf.y) *
        specularOcclusion * max(pc.CameraPositionAndIntensity.w, 0.0);
    contribution = HybridLimitReflectionRadiance(contribution,
        HybridMaximumComponent(scaledIncidentRadiance));

    float clearcoatRoughness = clamp(raw.a, 0.02, 1.0);
    float clearcoatFactor = clamp(clearcoatRaw.a, 0.0, 1.0);
    uint clearcoatSource = HybridMetadataSource(metadata.y);
    float clearcoatConfidence = HybridMetadataConfidence(metadata.y);
    bool clearcoatEnabled = clearcoatFactor > 0.0 &&
        (HybridReflectionPayloadLobeFlags(payload) &
            NJULF_HYBRID_REFLECTION_LOBE_CLEARCOAT) != 0u;
    if (clearcoatEnabled)
    {
        vec3 clearcoatNormal = normal;
        vec3 clearcoatDirection = normalize(
            reflect(-viewDirection, clearcoatNormal));
        vec3 clearcoatIncident = max(clearcoatRaw.rgb, vec3(0.0));
        float clearcoatScale = 1.0;
        vec3 clearcoatPlanarRadiance;
        float clearcoatPlanarConfidence;
        bool clearcoatPlanarValid = planarEnabled &&
            AutomaticPlanarTrySample(
                pc.CurrentFrameIndex,
                HybridReceiverIdentity(payload),
                worldPosition,
                HybridReflectionPayloadGeometricNormal(payload),
                clearcoatRoughness,
                clearcoatPlanarRadiance,
                clearcoatPlanarConfidence);
        if (clearcoatPlanarValid)
        {
            clearcoatIncident = clearcoatPlanarRadiance;
            clearcoatConfidence = clearcoatPlanarConfidence;
            clearcoatSource = HYBRID_REFLECTION_SOURCE_PLANAR;
        }
        else if (!HybridMetadataValid(metadata.y))
        {
            if (ddgiBaseValid)
            {
                clearcoatIncident = max(ddgiBase.rgb, vec3(0.0));
                clearcoatConfidence = clamp(ddgiBase.a, 0.0, 1.0);
                clearcoatSource = HYBRID_REFLECTION_SOURCE_DDGI;
            }
            else
            {
                HybridSampleAnalyticFallback(
                    worldPosition,
                    clearcoatDirection,
                    clearcoatRoughness,
                    environment,
                    probeHeader,
                    clearcoatIncident,
                    clearcoatConfidence,
                    clearcoatSource);
                clearcoatScale =
                    clearcoatSource ==
                        HYBRID_REFLECTION_SOURCE_ENVIRONMENT
                    ? max(environment.SpecularIntensity, 0.0)
                    : 1.0;
            }
        }
        float clearcoatNdotV = max(
            dot(clearcoatNormal, viewDirection), 0.0);
        vec3 clearcoatFresnel = HybridFresnelSchlickRoughness(
            clearcoatNdotV, vec3(0.04), clearcoatRoughness);
        vec2 clearcoatBrdf = environment.BrdfLutTextureIndex >= 0
            ? texture(BindlessTextures[nonuniformEXT(
                environment.BrdfLutTextureIndex)],
                vec2(clearcoatNdotV, clearcoatRoughness)).rg
            : vec2(1.0, 0.0);
        vec3 clearcoatContribution = clearcoatIncident * clearcoatScale *
            (clearcoatFresnel * clearcoatBrdf.x + clearcoatBrdf.y) *
            clearcoatFactor *
            max(pc.CameraPositionAndIntensity.w, 0.0);
        // glTF clearcoat is a dielectric layer above the base. Attenuating the
        // base by the same Fresnel energy that is added by the coat keeps the
        // combined white-furnace response bounded.
        float layerTransmission = clamp(1.0 - clearcoatFactor *
            HybridMaximumComponent(clearcoatFresnel), 0.0, 1.0);
        contribution = contribution * layerTransmission +
            HybridLimitReflectionRadiance(clearcoatContribution,
                HybridMaximumComponent(clearcoatIncident));
        if (clearcoatConfidence * clearcoatFactor > confidence)
            source = clearcoatSource;
        confidence = max(confidence,
            clearcoatConfidence * clearcoatFactor);
    }
    imageStore(HybridRawRadiance, pixel,
        vec4(contribution, confidence));
    imageStore(HybridRawMetadata, pixel, uvec4(
        HybridPackMetadata(source, confidence,
            HybridMetadataReason(metadata.x), 0u, true),
        clearcoatEnabled
            ? HybridPackMetadata(clearcoatSource, clearcoatConfidence,
                HybridMetadataReason(metadata.y), 0u, true)
            : 0u,
        0u,
        0u));
}
