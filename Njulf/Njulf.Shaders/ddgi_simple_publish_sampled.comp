#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#define SIMPLE_DDGI_DISABLE_SAMPLED_ATLAS 1
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// The optional image mirror is capped independently from the SSBO probe pool.
// The manager declines this optional path when the resolved array-layer count
// would require more descriptors than this production layout.
const uint SIMPLE_DDGI_PUBLISH_MAX_IMAGE_GROUPS = 16u;
layout(set = 2, binding = 0, rgba16f) uniform image2DArray IrradianceImages[16];
layout(set = 2, binding = 1, rg16f) uniform image2DArray VisibilityImages[16];

layout(push_constant) uniform SimpleDdgiPublishPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint ProbeStateBufferIndex;
    uint ReceiverProbeBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint TransportIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint SampledAtlasGroupCount;
    uint SampledAtlasLayersPerTexture;
    uint SchedulerArenaBufferIndex;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerFrameOffsetWords;
} pc;

void CompleteSampledPublication(SimpleDdgiProbeUpdate update)
{
    if (gl_LocalInvocationID.x == 0u)
    {
        SimpleDdgiSchedulerCompleteSingle(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 6u);
    }
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint queueOffset = gl_WorkGroupID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    bool residentTransaction = gpuScheduler &&
        (ReadStorageWordUniform(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerFrameOffsetWords + 27u) & 1u) != 0u;
    uint requestCount = gpuScheduler
        ? SimpleDdgiSchedulerAcceptedCount(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerCountersOffsetWords)
        : params.probesToUpdate;
    if (queueOffset >= requestCount || params.probeCount == 0u ||
        pc.SampledAtlasGroupCount == 0u || pc.SampledAtlasLayersPerTexture == 0u)
        return;

    SimpleDdgiProbeUpdate update =
        ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, queueOffset);
    if (!SimpleDdgiSchedulerOutcomeAllowsPublication(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            true,
            pc.SchedulerFrameOffsetWords))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            SIMPLE_DDGI_SCHEDULER_FAILURE_PUBLICATION_GUARD);
        return;
    }
    if (update.probeIndex >= params.probeCount ||
        !SimpleDdgiUpdateMatchesLiveAddress(params, update))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    SimpleDdgiProbeState state =
        ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, update.probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
            params,
            update,
            state))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    SimpleDdgiVolume volume = ReadSimpleDdgiVolume(
        pc.ParamsBufferIndex,
        update.volumeIndex);
    bool irradianceMirrored =
        (volume.cacheLayoutFlags & SIMPLE_DDGI_CACHE_IRRADIANCE_MIRROR_BIT) != 0u;
    bool visibilityMirrored =
        (volume.cacheLayoutFlags & SIMPLE_DDGI_CACHE_VISIBILITY_MIRROR_BIT) != 0u;

    // A receiver-relevant mirror intentionally excludes complete volumes. Such
    // updates still satisfy the publication stage because receivers fall back
    // to the canonical SSBO payload for that volume.
    if (volume.compactMirrorFirstLayerPlusOne == 0u &&
        !irradianceMirrored && !visibilityMirrored)
    {
        CompleteSampledPublication(update);
        return;
    }

    SimpleDdgiVolumePaging paging = ReadSimpleDdgiVolumePaging(
        pc.ParamsBufferIndex,
        update.volumeIndex);
    SimpleDdgiAtlasAddress address;
    bool atlasAddressValid = TryBuildSimpleDdgiAtlasAddress(
        params,
        volume,
        paging,
        update.physicalProbeIndex,
        address);
    bool addressValid = irradianceMirrored && visibilityMirrored &&
        volume.compactMirrorFirstLayerPlusOne != 0u &&
        params.sampledAtlasLayersPerTexture == pc.SampledAtlasLayersPerTexture &&
        params.sampledAtlasTextureGroupCount == pc.SampledAtlasGroupCount &&
        atlasAddressValid &&
        (address.sampledStatusFlags &
            SIMPLE_DDGI_ATLAS_ADDRESS_MAPPING_VALID_BIT) != 0u;
    uint groupIndex = address.sampledGroupIndex;
    uint layerIndex = address.sampledLayerIndex;
    if (!addressValid ||
        groupIndex >= min(pc.SampledAtlasGroupCount, SIMPLE_DDGI_PUBLISH_MAX_IMAGE_GROUPS))
    {
        // The image is an optional accelerator. Corrupt or stale mirror
        // metadata must never reject an otherwise complete canonical update;
        // receivers validate the same mapping and take the SSBO fallback.
        CompleteSampledPublication(update);
        return;
    }
    ivec3 irradianceDimensions = imageSize(
        IrradianceImages[nonuniformEXT(groupIndex)]);
    ivec3 visibilityDimensions = imageSize(
        VisibilityImages[nonuniformEXT(groupIndex)]);
    if (layerIndex >= uint(max(irradianceDimensions.z, 0)) ||
        layerIndex >= uint(max(visibilityDimensions.z, 0)) ||
        any(notEqual(irradianceDimensions.xy, ivec2(params.irradianceTexels))) ||
        any(notEqual(visibilityDimensions.xy, ivec2(params.visibilityTexels))))
    {
        CompleteSampledPublication(update);
        return;
    }

    uint irradianceTexelCount = params.irradianceTexels * params.irradianceTexels;
    for (uint texel = gl_LocalInvocationID.x;
         texel < irradianceTexelCount;
         texel += gl_WorkGroupSize.x)
    {
        uint x = texel % params.irradianceTexels;
        uint y = texel / params.irradianceTexels;
        vec4 value = residentTransaction
            ? ReadSimpleDdgiIrradianceTexel(
                pc.TransportIrradianceAtlasBufferIndex,
                update.physicalProbeIndex,
                texel,
                params.irradianceTexels)
            : ReadSimpleDdgiIrradianceTexel(
                pc.IrradianceAtlasBufferIndex,
                update.physicalProbeIndex,
                texel,
                params.irradianceTexels);
        imageStore(
            IrradianceImages[nonuniformEXT(groupIndex)],
            ivec3(int(x), int(y), int(layerIndex)),
            value);
    }

    uint visibilityTexelCount = params.visibilityTexels * params.visibilityTexels;
    for (uint texel = gl_LocalInvocationID.x;
         texel < visibilityTexelCount;
         texel += gl_WorkGroupSize.x)
    {
        uint x = texel % params.visibilityTexels;
        uint y = texel / params.visibilityTexels;
        vec2 moments = residentTransaction
            ? ReadSimpleDdgiVisibilityMomentsAtOffset(
                pc.TransportIrradianceAtlasBufferIndex,
                pc.PrivateVisibilityAtlasOffsetWords,
                update.physicalProbeIndex,
                texel,
                params.visibilityTexels)
            : ReadSimpleDdgiVisibilityMoments(
                pc.VisibilityAtlasBufferIndex,
                update.physicalProbeIndex,
                texel,
                params.visibilityTexels);
        imageStore(
            VisibilityImages[nonuniformEXT(groupIndex)],
            ivec3(int(x), int(y), int(layerIndex)),
            vec4(moments, 0.0, 1.0));
    }

    memoryBarrierImage();
    barrier();
    memoryBarrierBuffer();
    barrier();
    CompleteSampledPublication(update);
}
