#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "area_lighting.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform LightCullPushConstantBlock
{
    GPULightCullPushConstants Push;
} pc;

shared uint SharedMinDepthBits;
shared uint SharedMaxDepthBits;
shared uint SharedCandidateCount;
shared uint SharedSelectedCount;
shared uint SharedSelectedLightIndices[128];
shared float SharedSelectedInfluences[128];
shared vec4 SharedTilePlanes[4];
shared float SharedVisibleNearDepth;
shared float SharedVisibleFarDepth;
shared vec3 SharedVisibleCenter;

uint PackDepthForAtomic(float depth)
{
    return uint(clamp(depth, 0.0, 1.0) * 4294967295.0);
}

float UnpackAtomicDepth(uint depth)
{
    return float(depth) / 4294967295.0;
}

vec3 UnprojectPixel(float pixelX, float pixelY, float depth)
{
    vec2 safeScreen = max(pc.Push.ScreenDimensions, vec2(1.0));
    vec2 ndc = vec2(pixelX, pixelY) / safeScreen * 2.0 - 1.0;
    vec4 world = MulRowMajor(vec4(ndc, depth, 1.0), pc.Push.InverseViewProjectionMatrix);
    return world.xyz / max(abs(world.w), 0.000001);
}

vec4 BuildPlane(vec3 a, vec3 b, vec3 c, vec3 interiorPoint)
{
    vec3 normal = normalize(cross(b - a, c - a));
    float d = -dot(normal, a);
    if (dot(normal, interiorPoint) + d < 0.0)
    {
        normal = -normal;
        d = -d;
    }

    return vec4(normal, d);
}

void BuildTileFrustumAndDepthInterval(uvec2 tile, float minDepth, float maxDepth)
{
    vec2 screen = max(pc.Push.ScreenDimensions, vec2(1.0));
    vec2 tileMin = vec2(tile * uvec2(16u, 16u));
    vec2 tileMax = min(tileMin + vec2(16.0), screen);
    vec3 camera = pc.Push.CameraPosition;
    vec3 topLeft = UnprojectPixel(tileMin.x, tileMin.y, 0.5);
    vec3 topRight = UnprojectPixel(tileMax.x, tileMin.y, 0.5);
    vec3 bottomRight = UnprojectPixel(tileMax.x, tileMax.y, 0.5);
    vec3 bottomLeft = UnprojectPixel(tileMin.x, tileMax.y, 0.5);
    vec3 interior = UnprojectPixel((tileMin.x + tileMax.x) * 0.5, (tileMin.y + tileMax.y) * 0.5, 0.5);

    SharedTilePlanes[0] = BuildPlane(camera, bottomLeft, topLeft, interior);
    SharedTilePlanes[1] = BuildPlane(camera, topLeft, topRight, interior);
    SharedTilePlanes[2] = BuildPlane(camera, topRight, bottomRight, interior);
    SharedTilePlanes[3] = BuildPlane(camera, bottomRight, bottomLeft, interior);
    vec2 tileCenter = (tileMin + tileMax) * 0.5;
    vec3 depthAWorld = UnprojectPixel(tileCenter.x, tileCenter.y, minDepth);
    vec3 depthBWorld = UnprojectPixel(tileCenter.x, tileCenter.y, maxDepth);
    float depthA = dot(depthAWorld - camera, pc.Push.CameraForward);
    float depthB = dot(depthBWorld - camera, pc.Push.CameraForward);
    SharedVisibleNearDepth = min(depthA, depthB);
    SharedVisibleFarDepth = max(depthA, depthB);
    SharedVisibleCenter = (depthAWorld + depthBWorld) * 0.5;
}

bool SphereOverlapsTileFrustum(vec3 center, float radius)
{
    for (int i = 0; i < 4; i++)
    {
        if (dot(SharedTilePlanes[i].xyz, center) + SharedTilePlanes[i].w < -radius)
            return false;
    }
    return true;
}

bool SphereOverlapsTileDepthRange(GPULight light)
{
    float lightDepth = dot(light.Position - pc.Push.CameraPosition, pc.Push.CameraForward);
    float radius = light.Range + NjulfAreaBoundingRadius(light);
    return lightDepth + radius >= SharedVisibleNearDepth &&
        lightDepth - radius <= SharedVisibleFarDepth;
}

float ComputeLightInfluence(GPULight light)
{
    vec3 toLight = light.Position - SharedVisibleCenter;
    float centerDistance = length(toLight);
    float distanceToEmitter = max(
        centerDistance - NjulfAreaBoundingRadius(light), 0.0);
    float distanceSquared = distanceToEmitter * distanceToEmitter;
    float rangeSquared = max(light.Range * light.Range, 0.0001);
    float attenuation = clamp(1.0 - distanceSquared / rangeSquared, 0.0, 1.0);
    float sourceWeight = NjulfIsAreaLight(light)
        ? NJULF_LTC_PI * NjulfAreaSurfaceArea(light)
        : 1.0;
    float influence = max(light.Intensity, 0.0) * sourceWeight *
        (attenuation * attenuation + 0.000001) /
        max(distanceSquared, 1.0);
    return (isnan(influence) || isinf(influence)) ? 0.0 : influence;
}

bool IsBetterLightCandidate(float influence, uint lightIndex, float otherInfluence, uint otherLightIndex)
{
    return influence > otherInfluence ||
        (influence == otherInfluence && lightIndex < otherLightIndex);
}

void InsertDeterministicLightCandidate(uint lightIndex, float influence)
{
    // Called by one invocation only during saturated-tile reconciliation.
    uint capacity = min(pc.Push.MaxLightsPerTile, 128u);
    if (SharedSelectedCount < capacity)
    {
        uint slot = SharedSelectedCount++;
        SharedSelectedLightIndices[slot] = lightIndex;
        SharedSelectedInfluences[slot] = influence;
    }
    else if (capacity > 0u)
    {
        uint worstSlot = 0u;
        for (uint slot = 1u; slot < capacity; slot++)
        {
            if (IsBetterLightCandidate(
                    SharedSelectedInfluences[worstSlot],
                    SharedSelectedLightIndices[worstSlot],
                    SharedSelectedInfluences[slot],
                    SharedSelectedLightIndices[slot]))
            {
                worstSlot = slot;
            }
        }

        if (IsBetterLightCandidate(
                influence,
                lightIndex,
                SharedSelectedInfluences[worstSlot],
                SharedSelectedLightIndices[worstSlot]))
        {
            SharedSelectedLightIndices[worstSlot] = lightIndex;
            SharedSelectedInfluences[worstSlot] = influence;
        }
    }
}

bool LightCanAffectVisibleTile(GPULight light)
{
    if (light.Type == GPU_LIGHT_TYPE_DIRECTIONAL)
        return false;

    if (light.Range <= 0.0 || light.Intensity <= 0.0)
        return false;

    float radius = light.Range + NjulfAreaBoundingRadius(light);
    return SphereOverlapsTileFrustum(light.Position, radius) &&
           SphereOverlapsTileDepthRange(light);
}

void main()
{
    uvec2 tile = gl_WorkGroupID.xy;
    if (tile.x >= pc.Push.TileCountX || tile.y >= pc.Push.TileCountY)
        return;

    uvec2 local = gl_LocalInvocationID.xy;
    uvec2 pixel = tile * uvec2(16u, 16u) + local;
    uvec2 screen = uvec2(pc.Push.ScreenDimensions);
    uint localIndex = gl_LocalInvocationIndex;
    uint tileIndex = tile.y * pc.Push.TileCountX + tile.x;
    uint tileLightOffset = tileIndex * pc.Push.MaxLightsPerTile;

    if (localIndex == 0u)
    {
        SharedMinDepthBits = 0xffffffffu;
        SharedMaxDepthBits = 0u;
        SharedCandidateCount = 0u;
        SharedSelectedCount = 0u;
    }

    barrier();

    if (pixel.x < screen.x && pixel.y < screen.y)
    {
        float depth = texelFetch(BindlessTextures[nonuniformEXT(pc.Push.DepthTextureIndex)], ivec2(pixel), 0).r;
        uint depthBits = PackDepthForAtomic(depth);
        atomicMin(SharedMinDepthBits, depthBits);
        atomicMax(SharedMaxDepthBits, depthBits);
    }

    barrier();

    float minDepth = UnpackAtomicDepth(SharedMinDepthBits);
    float maxDepth = UnpackAtomicDepth(SharedMaxDepthBits);
    if (maxDepth <= 0.0)
    {
        if (localIndex == 0u)
            WriteTiledLightHeader(tileIndex, 0u, tileLightOffset, 0u);
        return;
    }

    if (localIndex == 0u)
        BuildTileFrustumAndDepthInterval(tile, minDepth, maxDepth);

    barrier();

    for (uint lightIndex = localIndex; lightIndex < pc.Push.LightCount; lightIndex += 256u)
    {
        GPULight light = ReadLight(lightIndex);
        if (!LightCanAffectVisibleTile(light))
            continue;

        uint slot = atomicAdd(SharedCandidateCount, 1u);
        if (slot < min(pc.Push.MaxLightsPerTile, 128u))
        {
            SharedSelectedLightIndices[slot] = lightIndex;
            SharedSelectedInfluences[slot] = ComputeLightInfluence(light);
        }
    }

    barrier();

    if (localIndex == 0u)
    {
        uint capacity = min(pc.Push.MaxLightsPerTile, 128u);
        uint selectedCount = min(SharedCandidateCount, capacity);
        if (SharedCandidateCount > capacity)
        {
            // The fast parallel append path intentionally does no contended ranking.  Only a
            // saturated tile pays for this serial, deterministic top-K reconciliation.
            SharedSelectedCount = 0u;
            for (uint lightIndex = 0u; lightIndex < pc.Push.LightCount; lightIndex++)
            {
                GPULight light = ReadLight(lightIndex);
                if (LightCanAffectVisibleTile(light))
                    InsertDeterministicLightCandidate(lightIndex, ComputeLightInfluence(light));
            }
            selectedCount = SharedSelectedCount;
        }
        // Canonicalize the retained set as well as its membership.  Forward shading accumulates
        // these lights in list order, so a deterministic sort avoids frame-to-frame FP drift.
        for (uint i = 1u; i < selectedCount; i++)
        {
            uint lightIndex = SharedSelectedLightIndices[i];
            float influence = SharedSelectedInfluences[i];
            uint slot = i;
            while (slot > 0u && IsBetterLightCandidate(
                       influence,
                       lightIndex,
                       SharedSelectedInfluences[slot - 1u],
                       SharedSelectedLightIndices[slot - 1u]))
            {
                SharedSelectedLightIndices[slot] = SharedSelectedLightIndices[slot - 1u];
                SharedSelectedInfluences[slot] = SharedSelectedInfluences[slot - 1u];
                slot--;
            }
            SharedSelectedLightIndices[slot] = lightIndex;
            SharedSelectedInfluences[slot] = influence;
        }
        for (uint slot = 0u; slot < selectedCount; slot++)
            WriteTiledLightIndex(tileLightOffset + slot, SharedSelectedLightIndices[slot]);
        uint overflowCount = SharedCandidateCount > selectedCount
            ? SharedCandidateCount - selectedCount
            : 0u;
        WriteTiledLightHeader(tileIndex, selectedCount, tileLightOffset, overflowCount);
    }
}
