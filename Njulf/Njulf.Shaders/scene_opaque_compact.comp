bool SidedStreamsEnabled()
{
    return (pc.Push.Flags &
        SCENE_OPAQUE_COMPACTION_FLAG_SIDED_STREAMS) != 0u;
}

bool IsDoubleSided(GPUMeshletDrawCommand command)
{
    return SidedStreamsEnabled() &&
        (command.Flags & MESHLET_COMMAND_FLAG_MATERIAL_DOUBLE_SIDED) != 0u;
}

uint CandidateBufferBaseIndex(uint candidateIndex, out uint localDrawIndex, out uint bucket)
{
    if (candidateIndex < pc.Push.SimpleCandidateCount)
    {
        localDrawIndex = candidateIndex;
        bucket = SCENE_OPAQUE_BUCKET_SIMPLE;
        return uint(MESHLET_DRAW_BUFFER_BASE_INDEX);
    }

    uint simpleNormalStart = pc.Push.SimpleCandidateCount;
    uint fullStart = simpleNormalStart + pc.Push.SimpleNormalCandidateCount;
    if (candidateIndex < fullStart)
    {
        localDrawIndex = candidateIndex - simpleNormalStart;
        bucket = SCENE_OPAQUE_BUCKET_SIMPLE_NORMAL;
        return uint(SIMPLE_NORMAL_OPAQUE_MESHLET_DRAW_BUFFER_BASE_INDEX);
    }

    localDrawIndex = candidateIndex - fullStart;
    bucket = SCENE_OPAQUE_BUCKET_FULL;
    return uint(FULL_OPAQUE_MESHLET_DRAW_BUFFER_BASE_INDEX);
}

GPUMeshInfo ReadMeshInfo(uint meshIndex)
{
    uint baseWord = meshIndex * uint(SIZEOF_GPU_MESH_INFO / 4);
    GPUMeshInfo info;
    info.BoundingSphere = ReadStorageVec4(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 0u);
    info.SkinningDataOffset = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 4u);
    info.SkinningDataCount = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 5u);
    info.Flags = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 6u);
    info.MeshletOffset = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 7u);
    info.MeshletCount = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 8u);
    info.MeshletLod1Offset = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 9u);
    info.MeshletLod1Count = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 10u);
    info.MeshletLod2Offset = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 11u);
    info.MeshletLod2Count = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 12u);
    info.MeshletLodGeneratedCount = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 13u);
    info.MeshletLod1ErrorBits = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 14u);
    info.MeshletLod2ErrorBits = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 15u);
    info.GpuMeshletRecordCount = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 16u);
    info.HierarchyNodeOffset = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 17u);
    info.HierarchyNodeCount = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 18u);
    info.HierarchyRootNode = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 19u);
    info.StreamingRangeIndex = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 20u);
    info.ResidencyFlags = ReadStorageWord(uint(SCENE_MESH_METADATA_BUFFER_INDEX), baseWord + 21u);
    return info;
}

void WriteMeshletDrawCommandToBase(uint outputBufferIndex, uint outputIndex, GPUMeshletDrawCommand command)
{
    uint baseWord = outputIndex * uint(SIZEOF_GPU_MESHLET_DRAW_COMMAND / 4);
    WriteStorageWord(outputBufferIndex, baseWord + 0u, command.MeshletIndex);
    WriteStorageWord(outputBufferIndex, baseWord + 1u, command.InstanceId);
    WriteStorageWord(outputBufferIndex, baseWord + 2u, command.MaterialIndex);
    WriteStorageWord(outputBufferIndex, baseWord + 3u, command.Flags);
}

void WriteMeshletDrawCommand(uint outputIndex, GPUMeshletDrawCommand command)
{
    WriteMeshletDrawCommandToBase(OutputBufferIndex(), outputIndex, command);
}

void WriteOpaqueBucketMeshletDrawCommand(uint bucket, uint outputIndex, GPUMeshletDrawCommand command)
{
    uint outputBufferIndex = bucket == SCENE_OPAQUE_BUCKET_SIMPLE
        ? SimpleOutputBufferIndex()
        : bucket == SCENE_OPAQUE_BUCKET_SIMPLE_NORMAL
            ? SimpleNormalOutputBufferIndex()
            : FullOutputBufferIndex();
    WriteMeshletDrawCommandToBase(outputBufferIndex, outputIndex, command);
}

uint OpaqueBucketOutputCapacity(uint bucket)
{
    return bucket == SCENE_OPAQUE_BUCKET_SIMPLE
        ? pc.Push.SimpleOutputCapacity
        : bucket == SCENE_OPAQUE_BUCKET_SIMPLE_NORMAL
            ? pc.Push.SimpleNormalOutputCapacity
            : pc.Push.FullOutputCapacity;
}

uint OpaqueBucketAppendCounterWord(uint bucket, bool doubleSided)
{
    if (doubleSided)
    {
        return bucket == SCENE_OPAQUE_BUCKET_SIMPLE
            ? SCENE_SUBMISSION_COUNTER_SIMPLE_OPAQUE_DOUBLE_SIDED_APPEND
            : bucket == SCENE_OPAQUE_BUCKET_SIMPLE_NORMAL
                ? SCENE_SUBMISSION_COUNTER_SIMPLE_NORMAL_OPAQUE_DOUBLE_SIDED_APPEND
                : SCENE_SUBMISSION_COUNTER_FULL_OPAQUE_DOUBLE_SIDED_APPEND;
    }

    return bucket == SCENE_OPAQUE_BUCKET_SIMPLE
        ? SCENE_SUBMISSION_COUNTER_SIMPLE_OPAQUE_APPEND
        : bucket == SCENE_OPAQUE_BUCKET_SIMPLE_NORMAL
            ? SCENE_SUBMISSION_COUNTER_SIMPLE_NORMAL_OPAQUE_APPEND
            : SCENE_SUBMISSION_COUNTER_FULL_OPAQUE_APPEND;
}

