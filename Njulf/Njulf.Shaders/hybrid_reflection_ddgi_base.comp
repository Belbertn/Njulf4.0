#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#define NJULF_HYBRID_DDGI_PROGRAM_COHORT 1
#define NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT 2
#define NJULF_HYBRID_DDGI_PROGRAM_EXACT_MISS 3

#ifndef NJULF_HYBRID_DDGI_PROGRAM
#error "NJULF_HYBRID_DDGI_PROGRAM must select one specialized DDGI program"
#endif

#if NJULF_HYBRID_DDGI_PROGRAM < NJULF_HYBRID_DDGI_PROGRAM_COHORT || \
    NJULF_HYBRID_DDGI_PROGRAM > NJULF_HYBRID_DDGI_PROGRAM_EXACT_MISS
#error "NJULF_HYBRID_DDGI_PROGRAM has an unsupported value"
#endif

#include "common.glsl"

#if NJULF_HYBRID_DDGI_PROGRAM != NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT
// This pass is a read-only receiver. It never mutates sparse residency or
// contributes a second ownership stream; the depth-driven DDGI receiver cache
// remains the sole owner of those requests.
#define SIMPLE_DDGI_GATHER_DIAGNOSTIC_SAMPLE_WEIGHT 0u
#define SIMPLE_DDGI_RECEIVER_DEMAND_SAMPLE false
#define SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE false
#define SIMPLE_DDGI_RECEIVER_COVERAGE_HASH 0u
#define SIMPLE_DDGI_RECEIVER_CONSUMER_FLAGS SIMPLE_DDGI_RECEIVER_CONSUMER_OPAQUE
#define SIMPLE_DDGI_RECEIVER_RESIDENCY_FEEDBACK 0
#define SIMPLE_DDGI_RECEIVER_TOUCHES_RESIDENT 0
#define SIMPLE_DDGI_RECEIVER_DEMAND_FRAME_OFFSET 0u
#define SIMPLE_DDGI_OPAQUE_GATHER_ORACLE 0
#define SIMPLE_DDGI_DIRECTIONAL_RADIANCE_RECEIVER 1
// The DDGI reflection base is intentionally low frequency. Decode only L1;
// SSR/ray query layer high-frequency scene detail above it during resolve.
#define SIMPLE_DDGI_DIRECTIONAL_L1_PREVIEW_RECEIVER 1
#include "ddgi_simple_shared.glsl"
#endif
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionDdgiPushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndPadding;
    uint ScreenWidth;
    uint ScreenHeight;
    uint ReceiverScale;
    uint MaximumSurfaceGroupsPerTile;
    float MinimumConfidence;
    float NormalDotThreshold;
    float MinimumWorldDepthTolerance;
    float RelativeWorldDepthTolerance;
    uint Reserved;
    uint ForceExactReconstruction;
} pc;

const uint HYBRID_DDGI_MAXIMUM_COHORTS = 2u;
// Reconstruction workgroups are 8x8. At the production 2x/4x receiver
// scales, the bilinear coarse grid plus its one-tile compatibility fallback
// spans at most 6x6 tiles. Cache both cohorts once per workgroup instead of
// re-fetching their payload/depth reference for every full-resolution pixel.
const uint HYBRID_DDGI_SHARED_MAXIMUM_TILE_AXIS = 6u;
const uint HYBRID_DDGI_SHARED_MAXIMUM_RECORDS =
    HYBRID_DDGI_SHARED_MAXIMUM_TILE_AXIS *
    HYBRID_DDGI_SHARED_MAXIMUM_TILE_AXIS *
    HYBRID_DDGI_MAXIMUM_COHORTS;

#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT
shared vec4 HybridDdgiSharedRadianceConfidence[
    HYBRID_DDGI_SHARED_MAXIMUM_RECORDS];
shared vec4 HybridDdgiSharedReferenceNormalRoughness[
    HYBRID_DDGI_SHARED_MAXIMUM_RECORDS];
shared uvec2 HybridDdgiSharedReferenceIdentityDistance[
    HYBRID_DDGI_SHARED_MAXIMUM_RECORDS];
shared uint HybridDdgiMissMaskLow;
shared uint HybridDdgiMissMaskHigh;
#endif

ivec2 HybridDdgiTilePixel(ivec2 origin, uint lane, uint scale)
{
    return origin + ivec2(int(lane % scale), int(lane / scale));
}

bool HybridDdgiPixelInBounds(ivec2 pixel)
{
    return all(greaterThanEqual(pixel, ivec2(0))) &&
        all(lessThan(pixel, ivec2(pc.ScreenWidth, pc.ScreenHeight)));
}

bool HybridDdgiReceiver(
    ivec2 pixel,
    out uvec4 payload,
    out vec3 worldPosition,
    out float depth)
{
    payload = uvec4(0u);
    worldPosition = vec3(0.0);
    depth = 0.0;
    if (!HybridDdgiPixelInBounds(pixel))
        return false;

    payload = texelFetch(HybridReceiverPayload, pixel, 0);
    if (!HybridReflectionPayloadValid(payload))
        return false;

    return HybridReconstructWorldPosition(
        pixel,
        uvec2(pc.ScreenWidth, pc.ScreenHeight),
        pc.InverseViewProjectionMatrix,
        worldPosition,
        depth);
}

#if NJULF_HYBRID_DDGI_PROGRAM != NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT
bool HybridEvaluateDdgiReflection(
    uvec4 payload,
    vec3 worldPosition,
    out vec3 radiance,
    out float confidence)
{
    radiance = vec3(0.0);
    confidence = 0.0;
    SimpleDdgiParams params = ReadSimpleDdgiParams(
        uint(SIMPLE_DDGI_PARAMS_BUFFER_INDEX));
    uint directionalMode = SimpleDdgiDirectionalRadianceMode(
        params.residencyFlags);
    uint glossyMode = SimpleDdgiGlossyTransportMode(params.residencyFlags);
    float roughness = HybridReflectionPayloadPhysicalRoughness(payload);
    bool configured =
        (params.flags &
            (SIMPLE_DDGI_FLAG_ENABLED |
             SIMPLE_DDGI_FLAG_STRUCTURED_GATHER_ENABLED)) ==
            (SIMPLE_DDGI_FLAG_ENABLED |
             SIMPLE_DDGI_FLAG_STRUCTURED_GATHER_ENABLED) &&
        params.probeCount > 0u &&
        directionalMode != SIMPLE_DDGI_DIRECTIONAL_RADIANCE_MODE_OFF &&
        glossyMode != SIMPLE_DDGI_GLOSSY_TRANSPORT_MODE_OFF;
    if (!configured)
        return false;

    vec3 traceNormal = HybridReflectionTraceNormal(payload);
    vec3 viewDirection = normalize(
        pc.CameraPositionAndPadding.xyz - worldPosition);
    vec3 reflectionDirection = normalize(
        reflect(-viewDirection, traceNormal));
    SetSimpleDdgiDirectionalRadianceQuery(reflectionDirection, roughness);
    // L1 SH cannot represent a broad positive radiance lobe without ringing.
    // The per-probe non-negative clamp turns that ringing into large dark and
    // bright lobes which appear to crawl when the reflection direction moves
    // with the camera. Retain exact directionality for polished surfaces, but
    // converge rough receivers toward the stable L0 mean. This affects only
    // the hybrid reflection preview: diffuse DDGI and its bounce energy keep
    // their existing representation and code path.
    float broadLobeWeight = smoothstep(0.45, 0.85, roughness);
    SetSimpleDdgiDirectionalRadianceQueryL1Scale(
        mix(1.0, 0.25, broadLobeWeight));
    // DDGI is the stable base for every reflection lobe in this pass. SSR and
    // ray query remain responsible for sharp detail and overwrite/blend above
    // it during resolve.
    SetSimpleDdgiDirectionalRadianceQueryEligibilityWeight(1.0);
    SimpleDdgiGatherResult gather = SampleSimpleDdgiGather(
        params, worldPosition, traceNormal, viewDirection);
    radiance = gather.directionalRadiance *
        max(params.indirectIntensity, 0.0);
    confidence = clamp(
        gather.directionalRadianceSupport *
        SimpleDdgiRadiometricOwnership(gather),
        0.0,
        1.0);
    return HybridFinite(radiance) && HybridFinite(confidence) &&
        confidence >= pc.MinimumConfidence;
}
#endif

#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_COHORT
bool HybridDdgiSameSurface(
    uvec4 referencePayload,
    vec3 referenceWorldPosition,
    uvec4 candidatePayload,
    vec3 candidateWorldPosition)
{
    if (HybridReceiverIdentity(referencePayload) !=
        HybridReceiverIdentity(candidatePayload))
    {
        return false;
    }

    // Match on the footprint-aware trace normal. Broad lobes intentionally
    // use the geometric normal, so a high-frequency masonry normal map cannot
    // fragment a DDGI cohort or turn probe interpolation into sparkle.
    vec3 referenceNormal = HybridReflectionTraceNormal(referencePayload);
    vec3 candidateNormal = HybridReflectionTraceNormal(candidatePayload);
    if (dot(referenceNormal, candidateNormal) < pc.NormalDotThreshold)
        return false;

    // Receiver identity is stable at the primitive/material level, while a
    // roughness texture can still vary inside it. Do not reconstruct a glossy
    // directional query across a visibly different lobe.
    if (abs(
            HybridReflectionPayloadPhysicalRoughness(referencePayload) -
            HybridReflectionPayloadPhysicalRoughness(candidatePayload)) > 0.08)
    {
        return false;
    }

    float receiverDistance = length(
        pc.CameraPositionAndPadding.xyz - referenceWorldPosition);
    float candidateDistance = length(
        pc.CameraPositionAndPadding.xyz - candidateWorldPosition);
    float tolerance = max(
        pc.MinimumWorldDepthTolerance,
        receiverDistance * pc.RelativeWorldDepthTolerance);
    // Tangent displacement is expected across an architectural plane. Radial
    // depth is the discontinuity test after identity and normal continuity.
    return abs(candidateDistance - receiverDistance) <= tolerance;
}

vec4 HybridPackDdgiCohort(
    vec3 radiance,
    float confidence,
    uint referenceLane)
{
    // RGBA16F leaves no separate integer channel. Store lane+1 in alpha's
    // integer part and confidence in half of its fractional range. Values stay
    // below 17, where half precision still retains useful confidence steps.
    float packedLaneConfidence = float(referenceLane + 1u) +
        min(clamp(confidence, 0.0, 1.0), 0.998) * 0.5;
    return vec4(max(radiance, vec3(0.0)), packedLaneConfidence);
}
#endif

#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT
bool HybridUnpackDdgiCohort(
    vec4 record,
    uint laneCount,
    out vec3 radiance,
    out float confidence,
    out uint referenceLane)
{
    radiance = vec3(0.0);
    confidence = 0.0;
    referenceLane = 0u;
    if (!HybridFinite(record) || record.a < 1.0)
        return false;

    float lanePart = floor(record.a);
    if (lanePart < 1.0 || lanePart > float(laneCount))
        return false;
    referenceLane = uint(lanePart) - 1u;
    confidence = clamp(fract(record.a) * 2.0, 0.0, 1.0);
    radiance = max(record.rgb, vec3(0.0));
    return confidence >= pc.MinimumConfidence;
}
#endif

#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_COHORT
void HybridProduceDdgiCohorts()
{
    uint scale = clamp(pc.ReceiverScale, 1u, 4u);
    ivec2 origin = ivec2(gl_GlobalInvocationID.xy * scale);
    if (!HybridDdgiPixelInBounds(origin))
        return;

    uint laneCount = scale * scale;
    uint maximumGroups = min(
        clamp(pc.MaximumSurfaceGroupsPerTile, 1u, laneCount),
        HYBRID_DDGI_MAXIMUM_COHORTS);
    // Every slot read by reconstruction is initialized by this dispatch, so
    // quality changes and prior frames cannot leak a stale cohort.
    for (uint slot = 0u; slot < maximumGroups; slot++)
    {
        ivec2 slotPixel = origin + ivec2(int(slot), 0);
        if (HybridDdgiPixelInBounds(slotPixel))
            imageStore(HybridDdgiCohorts, slotPixel, vec4(0.0));
    }

    uint processedMask = 0u;
    for (uint group = 0u; group < maximumGroups; group++)
    {
        int referenceLane = -1;
        uvec4 referencePayload = uvec4(0u);
        vec3 referenceWorldPosition = vec3(0.0);
        float referenceDepth = 0.0;
        uint centreLow = (scale - 1u) / 2u;
        uint centreHigh = scale / 2u;
        uint examinedCentreMask = 0u;
        for (uint centre = 0u; centre < 4u; centre++)
        {
            uint laneX = (centre & 1u) == 0u ? centreLow : centreHigh;
            uint laneY = (centre & 2u) == 0u ? centreLow : centreHigh;
            uint lane = laneY * scale + laneX;
            uint laneBit = 1u << lane;
            if ((examinedCentreMask & laneBit) != 0u)
                continue;
            examinedCentreMask |= laneBit;
            if ((processedMask & (1u << lane)) != 0u)
                continue;
            ivec2 pixel = HybridDdgiTilePixel(origin, lane, scale);
            if (HybridDdgiReceiver(pixel, referencePayload,
                    referenceWorldPosition, referenceDepth))
            {
                referenceLane = int(lane);
                break;
            }
            processedMask |= 1u << lane;
        }

        // A tile can end at the viewport boundary or have no valid receiver
        // in its central footprint. Retain the bounded row-major fallback,
        // but only after the stable centre candidates have been exhausted.
        if (referenceLane < 0)
        {
            for (uint lane = 0u; lane < laneCount; lane++)
            {
                if ((processedMask & (1u << lane)) != 0u)
                    continue;
                ivec2 pixel = HybridDdgiTilePixel(origin, lane, scale);
                if (HybridDdgiReceiver(pixel, referencePayload,
                        referenceWorldPosition, referenceDepth))
                {
                    referenceLane = int(lane);
                    break;
                }
                processedMask |= 1u << lane;
            }
        }
        if (referenceLane < 0)
            break;

        vec3 ddgiRadiance;
        float ddgiConfidence;
        bool ddgiValid = HybridEvaluateDdgiReflection(
            referencePayload,
            referenceWorldPosition,
            ddgiRadiance,
            ddgiConfidence);

        // Mark every receiver in this cohort even if its representative has
        // no support. Reconstruction then evaluates those pixels exactly.
        for (uint lane = 0u; lane < laneCount; lane++)
        {
            if ((processedMask & (1u << lane)) != 0u)
                continue;
            ivec2 pixel = HybridDdgiTilePixel(origin, lane, scale);
            uvec4 payload;
            vec3 worldPosition;
            float depth;
            if (!HybridDdgiReceiver(pixel, payload, worldPosition, depth))
            {
                processedMask |= 1u << lane;
                continue;
            }
            if (HybridDdgiSameSurface(referencePayload,
                    referenceWorldPosition, payload, worldPosition))
            {
                processedMask |= 1u << lane;
            }
        }

        if (ddgiValid)
        {
            ivec2 slotPixel = origin + ivec2(int(group), 0);
            if (HybridDdgiPixelInBounds(slotPixel))
            {
                imageStore(HybridDdgiCohorts, slotPixel,
                    HybridPackDdgiCohort(ddgiRadiance, ddgiConfidence,
                        uint(referenceLane)));
            }
        }
    }
}
#endif

#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT
void HybridDdgiSharedTileRange(
    uint scale,
    out ivec2 firstTileIndex,
    out uvec2 tileCount)
{
    ivec2 workgroupOrigin = ivec2(
        gl_WorkGroupID.xy * gl_WorkGroupSize.xy);
    ivec2 workgroupLast = workgroupOrigin +
        ivec2(gl_WorkGroupSize.xy) - ivec2(1);
    float inverseScale = 1.0 / float(scale);
    vec2 firstGridPosition =
        (vec2(workgroupOrigin) + vec2(0.5)) * inverseScale - vec2(0.5);
    vec2 lastGridPosition =
        (vec2(workgroupLast) + vec2(0.5)) * inverseScale - vec2(0.5);
    firstTileIndex = ivec2(floor(firstGridPosition));
    ivec2 lastTileIndex = ivec2(floor(lastGridPosition)) + ivec2(1);
    tileCount = uvec2(lastTileIndex - firstTileIndex + ivec2(1));
}

uint HybridDdgiSharedRecordIndex(
    uvec2 tileOffset,
    uvec2 tileCount,
    uint slot,
    uint maximumGroups)
{
    return (tileOffset.y * tileCount.x + tileOffset.x) *
        maximumGroups + slot;
}

void HybridPrepareDdgiSharedCohorts(uint scale, uint maximumGroups)
{
    ivec2 firstTileIndex;
    uvec2 tileCount;
    HybridDdgiSharedTileRange(scale, firstTileIndex, tileCount);
    uint recordCount = tileCount.x * tileCount.y * maximumGroups;
    uint invocationCount = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    for (uint recordIndex = gl_LocalInvocationIndex;
        recordIndex < recordCount;
        recordIndex += invocationCount)
    {
        HybridDdgiSharedRadianceConfidence[recordIndex] = vec4(0.0);
        uint tileLinearIndex = recordIndex / maximumGroups;
        uint slot = recordIndex % maximumGroups;
        uvec2 tileOffset = uvec2(
            tileLinearIndex % tileCount.x,
            tileLinearIndex / tileCount.x);
        ivec2 tileIndex = firstTileIndex + ivec2(tileOffset);
        ivec2 tileOrigin = tileIndex * int(scale);
        if (!HybridDdgiPixelInBounds(tileOrigin))
            continue;

        ivec2 slotPixel = tileOrigin + ivec2(int(slot), 0);
        if (!HybridDdgiPixelInBounds(slotPixel))
            continue;
        vec3 cohortRadiance;
        float cohortConfidence;
        uint referenceLane;
        if (!HybridUnpackDdgiCohort(
                imageLoad(HybridDdgiCohorts, slotPixel),
                scale * scale,
                cohortRadiance,
                cohortConfidence,
                referenceLane))
        {
            continue;
        }

        ivec2 referencePixel = HybridDdgiTilePixel(
            tileOrigin, referenceLane, scale);
        uvec4 referencePayload;
        vec3 referenceWorldPosition;
        float referenceDepth;
        if (!HybridDdgiReceiver(referencePixel, referencePayload,
                referenceWorldPosition, referenceDepth))
        {
            continue;
        }

        HybridDdgiSharedReferenceNormalRoughness[recordIndex] = vec4(
            HybridReflectionTraceNormal(referencePayload),
            HybridReflectionPayloadPhysicalRoughness(referencePayload));
        HybridDdgiSharedReferenceIdentityDistance[recordIndex] = uvec2(
            HybridReceiverIdentity(referencePayload),
            floatBitsToUint(length(
                pc.CameraPositionAndPadding.xyz - referenceWorldPosition)));
        HybridDdgiSharedRadianceConfidence[recordIndex] =
            vec4(cohortRadiance, cohortConfidence);
    }

    memoryBarrierShared();
    barrier();
}

bool HybridTryCachedDdgiTile(
    ivec2 tileIndex,
    ivec2 firstTileIndex,
    uvec2 tileCount,
    uint maximumGroups,
    uint receiverIdentity,
    vec3 receiverNormal,
    float receiverRoughness,
    float receiverDistance,
    out vec3 radiance,
    out float confidence)
{
    radiance = vec3(0.0);
    confidence = 0.0;
    ivec2 signedTileOffset = tileIndex - firstTileIndex;
    if (any(lessThan(signedTileOffset, ivec2(0))) ||
        any(greaterThanEqual(signedTileOffset, ivec2(tileCount))))
    {
        return false;
    }

    uvec2 tileOffset = uvec2(signedTileOffset);
    for (uint slot = 0u; slot < maximumGroups; slot++)
    {
        uint recordIndex = HybridDdgiSharedRecordIndex(
            tileOffset, tileCount, slot, maximumGroups);
        vec4 cohort = HybridDdgiSharedRadianceConfidence[recordIndex];
        if (cohort.a < pc.MinimumConfidence || !HybridFinite(cohort))
            continue;
        uvec2 referenceIdentityDistance =
            HybridDdgiSharedReferenceIdentityDistance[recordIndex];
        if (referenceIdentityDistance.x != receiverIdentity)
            continue;

        vec4 referenceNormalRoughness =
            HybridDdgiSharedReferenceNormalRoughness[recordIndex];
        if (dot(referenceNormalRoughness.xyz, receiverNormal) <
            pc.NormalDotThreshold)
        {
            continue;
        }
        if (abs(referenceNormalRoughness.w - receiverRoughness) > 0.08)
            continue;

        float referenceDistance = uintBitsToFloat(
            referenceIdentityDistance.y);
        float tolerance = max(
            pc.MinimumWorldDepthTolerance,
            referenceDistance * pc.RelativeWorldDepthTolerance);
        if (abs(receiverDistance - referenceDistance) > tolerance)
        {
            continue;
        }

        radiance = cohort.rgb;
        confidence = cohort.a;
        return true;
    }
    return false;
}

bool HybridFindDdgiCohort(
    ivec2 pixel,
    uvec4 payload,
    vec3 worldPosition,
    out vec3 radiance,
    out float confidence)
{
    uint scale = clamp(pc.ReceiverScale, 1u, 4u);
    uint laneCount = scale * scale;
    uint maximumGroups = min(
        clamp(pc.MaximumSurfaceGroupsPerTile, 1u, laneCount),
        HYBRID_DDGI_MAXIMUM_COHORTS);
    ivec2 firstTileIndex;
    uvec2 tileCount;
    HybridDdgiSharedTileRange(scale, firstTileIndex, tileCount);
    uint receiverIdentity = HybridReceiverIdentity(payload);
    vec3 receiverNormal = HybridReflectionTraceNormal(payload);
    float receiverRoughness =
        HybridReflectionPayloadPhysicalRoughness(payload);
    float receiverDistance = length(
        pc.CameraPositionAndPadding.xyz - worldPosition);

    // Treat cohort records as samples at coarse-tile centres. The old
    // current-tile/first-neighbour lookup was a nearest-neighbour upsample:
    // it changed the entire 4x4 footprint at once as the camera crossed a
    // screen-tile boundary. Bilinear weights go continuously to zero at every
    // boundary, while the full identity/normal/roughness/depth contract keeps
    // interpolation from crossing real surface edges.
    vec2 coarsePosition =
        (vec2(pixel) + vec2(0.5)) / float(scale) - vec2(0.5);
    ivec2 baseTileIndex = ivec2(floor(coarsePosition));
    vec2 fraction = fract(coarsePosition);
    vec3 weightedRadiance = vec3(0.0);
    float weightedConfidence = 0.0;
    float weightSum = 0.0;
    for (uint corner = 0u; corner < 4u; corner++)
    {
        ivec2 cornerOffset = ivec2(
            int(corner & 1u), int((corner >> 1u) & 1u));
        float weightX = cornerOffset.x == 0
            ? 1.0 - fraction.x
            : fraction.x;
        float weightY = cornerOffset.y == 0
            ? 1.0 - fraction.y
            : fraction.y;
        float weight = weightX * weightY;
        if (weight <= 0.0)
            continue;

        vec3 cohortRadiance;
        float cohortConfidence;
        if (!HybridTryCachedDdgiTile(
                baseTileIndex + cornerOffset,
                firstTileIndex,
                tileCount,
                maximumGroups,
                receiverIdentity,
                receiverNormal,
                receiverRoughness,
                receiverDistance,
                cohortRadiance,
                cohortConfidence))
        {
            continue;
        }

        weightedRadiance += cohortRadiance * weight;
        weightedConfidence += cohortConfidence * weight;
        weightSum += weight;
    }
    if (weightSum > 1.0e-5)
    {
        radiance = weightedRadiance / weightSum;
        confidence = weightedConfidence / weightSum;
        return true;
    }

    // Preserve the old no-hole performance backstop for thin/disconnected
    // receivers not represented by the four interpolation nodes. These
    // records are already in shared memory; choose the nearest compatible
    // tile rather than a scan-order-dependent first match.
    ivec2 receiverTileIndex = pixel / int(scale);
    float bestDistanceSquared = 1.0e30;
    bool found = false;
    for (int tileY = -1; tileY <= 1; tileY++)
    {
        for (int tileX = -1; tileX <= 1; tileX++)
        {
            ivec2 candidateTileIndex = receiverTileIndex +
                ivec2(tileX, tileY);
            vec3 cohortRadiance;
            float cohortConfidence;
            if (!HybridTryCachedDdgiTile(
                    candidateTileIndex,
                    firstTileIndex,
                    tileCount,
                    maximumGroups,
                    receiverIdentity,
                    receiverNormal,
                    receiverRoughness,
                    receiverDistance,
                    cohortRadiance,
                    cohortConfidence))
            {
                continue;
            }

            vec2 tileCentre =
                (vec2(candidateTileIndex) + vec2(0.5)) * float(scale);
            vec2 centreOffset = vec2(pixel) + vec2(0.5) - tileCentre;
            float distanceSquared = dot(centreOffset, centreOffset);
            if (distanceSquared < bestDistanceSquared)
            {
                radiance = cohortRadiance;
                confidence = cohortConfidence;
                bestDistanceSquared = distanceSquared;
                found = true;
            }
        }
    }
    return found;
}

void HybridReconstructDdgiBase()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (!HybridDdgiPixelInBounds(pixel))
        return;

    uvec4 payload;
    vec3 worldPosition;
    float depth;
    if (!HybridDdgiReceiver(pixel, payload, worldPosition, depth))
    {
        imageStore(HybridHistoryCurrent, pixel, vec4(0.0));
        return;
    }

    uint rawMetadata = imageLoad(HybridRawMetadata, pixel).x;
    bool disoccluded = HybridMetadataReason(rawMetadata) ==
        HYBRID_REFLECTION_REASON_DISOCCLUDED;
    uint scale = clamp(pc.ReceiverScale, 1u, 4u);
    bool exactRequired = pc.ForceExactReconstruction != 0u || scale <= 1u ||
        HybridReflectionRequiresSharpDetail(payload) || disoccluded;
    vec3 radiance = vec3(0.0);
    float confidence = 0.0;
    bool valid = !exactRequired && HybridFindDdgiCohort(
        pixel, payload, worldPosition, radiance, confidence);
    if (!valid)
    {
        uint lane = gl_LocalInvocationIndex;
        if (lane < 32u)
            atomicOr(HybridDdgiMissMaskLow, 1u << lane);
        else
            atomicOr(HybridDdgiMissMaskHigh, 1u << (lane - 32u));
        return;
    }

    imageStore(HybridHistoryCurrent, pixel,
        vec4(max(radiance, vec3(0.0)), confidence));
}

void HybridPublishDdgiMissTile()
{
    memoryBarrierShared();
    barrier();
    if (gl_LocalInvocationIndex != 0u ||
        (HybridDdgiMissMaskLow | HybridDdgiMissMaskHigh) == 0u)
    {
        return;
    }

    uint tileIndex = atomicAdd(HybridTileCount, 1u);
    if (tileIndex < HybridTileCapacity)
    {
        HybridTiles[tileIndex] = uvec4(
            gl_WorkGroupID.xy,
            HybridDdgiMissMaskLow,
            HybridDdgiMissMaskHigh);
        atomicMax(HybridDdgiExactIndirectGroupCountX, tileIndex + 1u);
        return;
    }

    // Capacity equals the number of full-resolution reconstruction
    // workgroups, and each workgroup appends at most once. Reaching this path
    // therefore exposes a CPU/GPU dispatch-contract failure rather than a
    // quality fallback that may silently leave a hole.
    atomicAdd(HybridTileOverflow, 1u);
    atomicAdd(HybridCounters[
        HYBRID_REFLECTION_COUNTER_TILE_OVERFLOWS], 1u);
}

void HybridRunCachedDdgiReconstruction()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        HybridDdgiMissMaskLow = 0u;
        HybridDdgiMissMaskHigh = 0u;
    }
    memoryBarrierShared();
    barrier();

    uint scale = clamp(pc.ReceiverScale, 1u, 4u);
    if (pc.ForceExactReconstruction == 0u && scale > 1u)
    {
        uint laneCount = scale * scale;
        uint maximumGroups = min(
            clamp(pc.MaximumSurfaceGroupsPerTile, 1u, laneCount),
            HYBRID_DDGI_MAXIMUM_COHORTS);
        HybridPrepareDdgiSharedCohorts(scale, maximumGroups);
    }
    HybridReconstructDdgiBase();
    HybridPublishDdgiMissTile();
}
#endif

#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_EXACT_MISS
void HybridExecuteExactDdgiMiss()
{
    uint tileIndex = gl_WorkGroupID.x;
    if (tileIndex >= HybridTileCount)
        return;

    uvec4 miss = HybridTiles[tileIndex];
    uint lane = gl_LocalInvocationIndex;
    uint laneMask = lane < 32u ? miss.z : miss.w;
    uint laneBit = 1u << (lane & 31u);
    if ((laneMask & laneBit) == 0u)
        return;

    ivec2 pixel = ivec2(miss.xy * uvec2(8u)) +
        ivec2(int(lane & 7u), int(lane >> 3u));
    uvec4 payload;
    vec3 worldPosition;
    float depth;
    if (!HybridDdgiReceiver(pixel, payload, worldPosition, depth))
    {
        if (HybridDdgiPixelInBounds(pixel))
            imageStore(HybridHistoryCurrent, pixel, vec4(0.0));
        return;
    }

    vec3 radiance;
    float confidence;
    bool valid = HybridEvaluateDdgiReflection(
        payload, worldPosition, radiance, confidence);
    // This compact dispatch is the correctness backstop: every valid receiver
    // omitted by the bounded cohort cache evaluates DDGI for itself. A zero
    // output means genuine lack of DDGI support, never a sampling hole.
    imageStore(HybridHistoryCurrent, pixel,
        valid ? vec4(max(radiance, vec3(0.0)), confidence) : vec4(0.0));
}
#endif

void main()
{
#if NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_COHORT
    HybridProduceDdgiCohorts();
#elif NJULF_HYBRID_DDGI_PROGRAM == NJULF_HYBRID_DDGI_PROGRAM_RECONSTRUCT
    HybridRunCachedDdgiReconstruction();
#else
    HybridExecuteExactDdgiMiss();
#endif
}
