#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

#ifndef SIMPLE_DDGI_FEEDBACK_PARTIAL_REDUCTION
#define SIMPLE_DDGI_FEEDBACK_PARTIAL_REDUCTION 0
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Keep the feedback participant definition identical to the transport audit.
// schedule_shared intentionally does not include the larger DDGI shared ABI,
// so mirror the stable public classification value locally.
const uint SIMPLE_DDGI_CLASSIFICATION_INACTIVE = 1u;

#include "ddgi_simple_transport_participant.glsl"

// The partial variant distributes the active field across a bounded set of
// 64-lane workgroups. Each emits one compact subtotal; the final single-group
// variant combines those records and publishes the unchanged feedback ABI.
const uint SIMPLE_DDGI_FEEDBACK_PENDING_FRESH = 0u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED = 1u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION = 2u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE = 3u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID = 4u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR = 5u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY = 6u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION = 7u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER = 8u;
const uint SIMPLE_DDGI_FEEDBACK_CONVERGED = 9u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE = 10u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE = 11u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE = 12u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE = 13u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE = 14u;
const uint SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS = 15u;
const uint SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY = 16u;
const uint SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED = 17u;
const uint SIMPLE_DDGI_FEEDBACK_PARTICIPANTS = 18u;
const uint SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED = 19u;
const uint SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION = 20u;
const uint SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION = 21u;
const uint SIMPLE_DDGI_FEEDBACK_RECEIVER_PROBES = 22u;
const uint SIMPLE_DDGI_FEEDBACK_RECEIVER_COVERAGE_BUCKETS = 23u;
const uint SIMPLE_DDGI_FEEDBACK_RECEIVER_FALLBACK_PROBES = 24u;
const uint SIMPLE_DDGI_FEEDBACK_RECEIVER_CONSUMER_MASK = 25u;
const uint SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_RING = 26u;
const uint SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_RING = 29u;
const uint SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_CONTENT = 32u;
const uint SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_CONTENT = 36u;
const uint SIMPLE_DDGI_FEEDBACK_REBASE_PENDING_RING = 40u;
const uint SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS = 43u;

shared uint feedbackReduction[SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS];
shared uint feedbackSummary[64];

void main()
{
    uint localIndex = gl_LocalInvocationID.x;
    if (localIndex < SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS)
        feedbackReduction[localIndex] = 0u;
    barrier();

    // Reduce resident lifecycle state on the GPU. Only this bounded summary is
    // copied to the host; no shipping probe-state readback is required.
    uint pendingFresh = 0u;
    uint pendingExposed = 0u;
    uint pendingRelocation = 0u;
    uint pendingSource = 0u;
    uint pendingSourceInvalidFlag = 0u;
    uint pendingSourcePrivateRepair = 0u;
    uint pendingSourceCardinality = 0u;
    uint pendingSourceGeneration = 0u;
    uint pendingSolver = 0u;
    uint converged = 0u;
    uint maximumFreshAge = 0u;
    uint maximumExposedAge = 0u;
    uint maximumRelocationAge = 0u;
    uint maximumUnpublishedAge = 0u;
    uint maximumVisibleUnsupportedAge = 0u;
    uint visibleParticipants = 0u;
    uint visibleSourceReady = 0u;
    uint visiblePublished = 0u;
    uint participatingCount = 0u;
    uint solveEpochVisitedCount = 0u;
    uint activeSourceMutationCount = 0u;
    uint activeCanonicalMutationCount = 0u;
    uint receiverContributingProbeCount = 0u;
    uint receiverCoverageBucketCount = 0u;
    uint receiverFallbackProbeCount = 0u;
    uint receiverConsumerMask = 0u;
    uint adaptiveSavedRayRing[3];
    uint adaptiveMaximumErrorRing[3];
    uint adaptiveSavedRayContent[4];
    uint adaptiveMaximumErrorContent[4];
    uint rebasePendingRing[3];
    for (uint ring = 0u; ring < 3u; ring++)
    {
        adaptiveSavedRayRing[ring] = 0u;
        adaptiveMaximumErrorRing[ring] = 0u;
        rebasePendingRing[ring] = 0u;
    }
    for (uint content = 0u; content < 4u; content++)
    {
        adaptiveSavedRayContent[content] = 0u;
        adaptiveMaximumErrorContent[content] = 0u;
    }
    uint activeProbeCount = min(SchedulerActiveProbeCount(), 32768u);
#if SIMPLE_DDGI_FEEDBACK_PARTIAL_REDUCTION
    uint receiverOffsetWordsPlusOne = ReadStorageWordUniform(
        pc.ParamsBufferIndex,
        SIMPLE_DDGI_SCHEDULER_RECEIVER_OFFSET_PARAM_WORD);
    uint receiverPreviousBankBase = receiverOffsetWordsPlusOne == 0u
        ? 0u
        : receiverOffsetWordsPlusOne - 1u +
            ((SchedulerFrameIndex() - 1u) & 1u) * activeProbeCount *
                SIMPLE_DDGI_SCHEDULER_RECEIVER_WORDS_PER_PROBE;
    uint globalInvocationIndex = gl_GlobalInvocationID.x;
    uint globalInvocationCount =
        gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint probeIndex = globalInvocationIndex;
         probeIndex < activeProbeCount;
         probeIndex += globalInvocationCount)
    {
        // Classification has consumed frame N-1. Clear that bank before it is
        // reused by receivers at N+1. This runs for every virtual probe,
        // including currently nonresident sparse slots, so a later admission
        // can never inherit stale screen ownership.
        if (receiverOffsetWordsPlusOne != 0u)
        {
            uint receiverRecordBase = receiverPreviousBankBase +
                probeIndex *
                    SIMPLE_DDGI_SCHEDULER_RECEIVER_WORDS_PER_PROBE;
            uint receiverWeightQ8 = SchedulerArenaRead(
                receiverRecordBase + 0u);
            uint receiverCoverageAndFlags = SchedulerArenaRead(
                receiverRecordBase + 1u);
            bool receiverContributed = receiverWeightQ8 != 0u &&
                (receiverCoverageAndFlags &
                    SIMPLE_DDGI_SCHEDULER_RECEIVER_ROLE_MASK) != 0u;
            receiverContributingProbeCount += receiverContributed ? 1u : 0u;
            receiverCoverageBucketCount += receiverContributed
                ? uint(bitCount(
                    receiverCoverageAndFlags &
                        SIMPLE_DDGI_SCHEDULER_RECEIVER_COVERAGE_MASK))
                : 0u;
            receiverFallbackProbeCount += receiverContributed &&
                (receiverCoverageAndFlags &
                    SIMPLE_DDGI_SCHEDULER_RECEIVER_FALLBACK_MASK) != 0u
                ? 1u
                : 0u;
            if (receiverContributed)
                receiverConsumerMask |= receiverCoverageAndFlags & 0xf8000000u;
            SchedulerArenaWrite(receiverRecordBase + 0u, 0u);
            SchedulerArenaWrite(receiverRecordBase + 1u, 0u);
        }
        uint sourceVolumeIndex = 0u;
        bool sourceVolumeValid = SchedulerFindVolume(
            probeIndex,
            sourceVolumeIndex);
        bool rebuildingRing = sourceVolumeValid &&
            SchedulerVolumeIsRebuilding(sourceVolumeIndex);
        uint rebuildingRingIndex = rebuildingRing
            ? min(SchedulerVolumeRing(sourceVolumeIndex), 2u)
            : 0u;
        uint physicalProbeIndex;
        uint pageMappingGeneration;
        bool addressPublished;
        // Convergence/cohort denominators are resident-only. This explicit
        // mapping predicate is the authoritative retirement event observed by
        // the fence-complete summary; virtual near-ring capacity is never
        // mistaken for live solver work.
        if (!sourceVolumeValid ||
            !SchedulerResolvePayloadAddressDetailed(
                probeIndex,
                sourceVolumeIndex,
                physicalProbeIndex,
                pageMappingGeneration,
                addressPublished))
        {
            if (rebuildingRing)
                rebasePendingRing[rebuildingRingIndex]++;
            continue;
        }
        uint publicBase = probeIndex * SIMPLE_DDGI_PROBE_STATE_WORDS;
        uint flags = ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 4u);
        uint age = ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 5u);
        uint classification = ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 6u);
        uint privateBase = pc.SchedulerProbeStateOffsetWords +
            probeIndex * SIMPLE_DDGI_SCHEDULER_PROBE_STATE_WORDS;
        uint lastCommittedUpdateFrame = SchedulerArenaRead(privateBase + 0u);
        uint lastCommittedSourceRefreshFrame = SchedulerArenaRead(privateBase + 1u);
        uint metadata = SchedulerArenaRead(privateBase + 5u);
        uint packedLifecycle = SchedulerArenaRead(privateBase + 7u);
        uint sourceRays = packedLifecycle & SIMPLE_DDGI_SCHEDULER_SOURCE_RAY_MASK;
        uint completedTransportGeneration =
            (packedLifecycle & SIMPLE_DDGI_SCHEDULER_TRANSPORT_GENERATION_MASK) >>
            SIMPLE_DDGI_SCHEDULER_TRANSPORT_GENERATION_SHIFT;
        uint stableUpdates =
            (packedLifecycle & SIMPLE_DDGI_SCHEDULER_STABLE_UPDATE_MASK) >>
            SIMPLE_DDGI_SCHEDULER_STABLE_UPDATE_SHIFT;
        uint sourceGeneration = SchedulerArenaRead(privateBase + 2u);
        uint sourceEpoch = SchedulerArenaRead(privateBase + 3u);
        uint volumeGeneration = SchedulerArenaRead(privateBase + 4u);
        uint cacheProbeBaseWordPlusOne = SchedulerArenaRead(privateBase + 10u);
        uint requiredSourceRays = sourceVolumeValid
            ? clamp(
                SchedulerVolumeFullRays(sourceVolumeIndex),
                1u,
                SIMPLE_DDGI_SCHEDULER_MAX_RAYS)
            : 0u;
        bool visible = (metadata & SIMPLE_DDGI_SCHEDULER_PROBE_META_VISIBLE) != 0u;
        bool published = addressPublished;
        bool inactive = classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE ||
            (flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ||
            uintBitsToFloat(ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 3u)) <= 0.001;
        // Saved work is attributed only to a source refresh committed by this
        // feedback frame. Quality error is the maximum valid current
        // directional witness in each bucket. Missing witnesses remain zero
        // (invalid) rather than silently certifying a short ray prefix.
        bool adaptiveEvidenceParticipant =
            SchedulerAdaptiveRayCardinality() &&
            !inactive &&
            requiredSourceRays != 0u &&
            sourceRays != 0u &&
            sourceRays <= requiredSourceRays;
        if (adaptiveEvidenceParticipant)
        {
            uint savedRays = lastCommittedSourceRefreshFrame ==
                    SchedulerFrameIndex()
                ? requiredSourceRays - sourceRays
                : 0u;
            float quadratureError;
            uint packedMaximumError = SchedulerReadQuadratureWitness(
                    probeIndex,
                    quadratureError)
                ? SIMPLE_DDGI_SCHEDULER_QUADRATURE_WITNESS_VALID |
                    floatBitsToUint(quadratureError)
                : 0u;
            uint contentClass = min(
                SchedulerVolumeKind(sourceVolumeIndex),
                3u);
            adaptiveSavedRayContent[contentClass] += savedRays;
            adaptiveMaximumErrorContent[contentClass] = max(
                adaptiveMaximumErrorContent[contentClass],
                packedMaximumError);
            if (SchedulerVolumeKind(sourceVolumeIndex) ==
                    SIMPLE_DDGI_SCHEDULER_VOLUME_KIND_RING)
            {
                uint ring = min(SchedulerVolumeRing(sourceVolumeIndex), 2u);
                adaptiveSavedRayRing[ring] += savedRays;
                adaptiveMaximumErrorRing[ring] = max(
                    adaptiveMaximumErrorRing[ring],
                    packedMaximumError);
            }
        }
        bool sourceReady = SchedulerTransportV2() && sourceVolumeValid &&
            SimpleDdgiTransportSourceReady(
                flags,
                sourceRays,
                requiredSourceRays,
                sourceGeneration,
                SchedulerSourceGeneration(),
                sourceEpoch,
                volumeGeneration,
                SchedulerTransportTopologyGeneration(),
                metadata,
                cacheProbeBaseWordPlusOne);
        bool hasFresh = (flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u;
        bool hasExposed = (flags & SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED) != 0u;
        bool hasRelocation = (flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u;
        if (rebuildingRing)
        {
            const uint rebaseTransientFlags =
                SIMPLE_DDGI_PROBE_FLAG_FRESH |
                SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED |
                SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING |
                SIMPLE_DDGI_PROBE_FLAG_SOURCE_CACHE_INVALID;
            bool rebaseProbeReady = addressPublished &&
                (!SchedulerTransportV2() || sourceReady) &&
                (flags & rebaseTransientFlags) == 0u;
            rebasePendingRing[rebuildingRingIndex] +=
                rebaseProbeReady ? 0u : 1u;
        }
        // The certificate covers the complete active transport field. Camera
        // visibility remains a priority/telemetry signal and never changes the
        // participant denominator.
        bool participating = SimpleDdgiTransportParticipantEligible(
            SchedulerTransportV2(),
            true,
            addressPublished,
            classification,
            flags,
            uintBitsToFloat(ReadStorageWordUniform(
                pc.ProbeStateBufferIndex,
                publicBase + 3u)),
            sourceRays,
            requiredSourceRays,
            sourceGeneration,
            SchedulerSourceGeneration(),
            sourceEpoch,
            volumeGeneration,
            SchedulerTransportTopologyGeneration(),
            metadata,
            cacheProbeBaseWordPlusOne);
        participatingCount += participating ? 1u : 0u;
        activeSourceMutationCount += participating &&
            lastCommittedSourceRefreshFrame == SchedulerFrameIndex()
                ? 1u
                : 0u;
        // A deferred commit mutates the private transport bank and lifecycle
        // state, but not the receiver-visible canonical field. The manager
        // advances the canonical generation once when it records the coherent
        // whole-field copy.
        activeCanonicalMutationCount += !SchedulerDefersRadiometricPublication() &&
            participating &&
            lastCommittedUpdateFrame == SchedulerFrameIndex()
                ? 1u
                : 0u;
        uint lastSolveEpoch = SchedulerArenaRead(privateBase + 9u);
        bool solveEpochVisited = participating &&
            SchedulerTailCertification() &&
            SchedulerSolveEpoch() != 0u &&
            lastSolveEpoch == SchedulerSolveEpoch();
        solveEpochVisitedCount += solveEpochVisited ? 1u : 0u;
        bool solverReady = SchedulerTailCertification()
            ? sourceReady &&
                lastSolveEpoch == SchedulerSolveEpoch() &&
                SchedulerSolveEpoch() != 0u
            : sourceReady &&
                completedTransportGeneration == (SchedulerTransportGeneration() & 0xffu) &&
                stableUpdates >= max(SchedulerFrame(30u), 1u);
        bool hasUnpublished = visible && participating && !published;

        // These fixed feedback words are control-plane blockers, not broad
        // lifecycle diagnostics. Match classify's pending-tail-source rule:
        // transient bits on an inactive/excluded probe cannot keep the frozen
        // active participant transaction in SourceRepair forever.
        pendingFresh += !inactive && hasFresh ? 1u : 0u;
        pendingExposed += !inactive && hasExposed ? 1u : 0u;
        pendingRelocation += !inactive && hasRelocation ? 1u : 0u;
        // Source repair is counted over every active slot, independently of
        // whether it is eligible for the frozen audit denominator.
        pendingSource += SchedulerTransportV2() && !inactive && !sourceReady ? 1u : 0u;
        pendingSourceInvalidFlag += !inactive &&
            (flags & SIMPLE_DDGI_PROBE_FLAG_SOURCE_CACHE_INVALID) != 0u
                ? 1u
                : 0u;
        pendingSourcePrivateRepair += !inactive &&
            (metadata & SIMPLE_DDGI_SCHEDULER_PROBE_META_REPAIR) != 0u
                ? 1u
                : 0u;
        pendingSourceCardinality += !inactive &&
            (!sourceVolumeValid || sourceRays == 0u ||
                sourceRays > requiredSourceRays)
                ? 1u
                : 0u;
        pendingSourceGeneration += !inactive &&
            sourceGeneration != SchedulerSourceGeneration()
                ? 1u
                : 0u;
        pendingSolver += SchedulerTransportV2() && participating && sourceReady && !solverReady ? 1u : 0u;
        maximumFreshAge = max(
            maximumFreshAge,
            !inactive && hasFresh ? age : 0u);
        maximumExposedAge = max(
            maximumExposedAge,
            !inactive && hasExposed ? age : 0u);
        maximumRelocationAge = max(
            maximumRelocationAge,
            !inactive && hasRelocation ? age : 0u);
        maximumUnpublishedAge = max(maximumUnpublishedAge, hasUnpublished ? age : 0u);
        maximumVisibleUnsupportedAge = max(
            maximumVisibleUnsupportedAge,
            visible && (flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ? age : 0u);
        if (visible && participating)
        {
            visibleParticipants++;
            visibleSourceReady += sourceReady ? 1u : 0u;
            visiblePublished += published && !hasFresh && !hasExposed &&
                !hasRelocation ? 1u : 0u;
        }
        if (solverReady && !hasFresh && !hasExposed && !hasRelocation)
            converged++;
    }
#else
    // Stage two reads the compact per-workgroup records produced by the
    // partial variant. pc.Stage carries their fixed dispatch count; the
    // scheduler stage enum never reaches shader control flow.
    uint partialGroupCount = clamp(pc.Stage, 1u, 8u);
    for (uint groupIndex = localIndex;
         groupIndex < partialGroupCount;
         groupIndex += gl_WorkGroupSize.x)
    {
        uint partialBase = pc.FeedbackOffsetWords +
            groupIndex * SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS;
        pendingFresh += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_PENDING_FRESH);
        pendingExposed += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED);
        pendingRelocation += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION);
        pendingSource += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE);
        pendingSourceInvalidFlag += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID);
        pendingSourcePrivateRepair += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR);
        pendingSourceCardinality += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY);
        pendingSourceGeneration += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION);
        pendingSolver += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER);
        converged += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_CONVERGED);
        maximumFreshAge = max(
            maximumFreshAge,
            SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE));
        maximumExposedAge = max(
            maximumExposedAge,
            SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE));
        maximumRelocationAge = max(
            maximumRelocationAge,
            SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE));
        maximumUnpublishedAge = max(
            maximumUnpublishedAge,
            SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE));
        maximumVisibleUnsupportedAge = max(
            maximumVisibleUnsupportedAge,
            SchedulerArenaRead(
                partialBase +
                    SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE));
        visibleParticipants += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS);
        visibleSourceReady += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY);
        visiblePublished += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED);
        participatingCount += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_PARTICIPANTS);
        solveEpochVisitedCount += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED);
        activeSourceMutationCount += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION);
        activeCanonicalMutationCount += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION);
        receiverContributingProbeCount += SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_RECEIVER_PROBES);
        receiverCoverageBucketCount += SchedulerArenaRead(
            partialBase +
                SIMPLE_DDGI_FEEDBACK_RECEIVER_COVERAGE_BUCKETS);
        receiverFallbackProbeCount += SchedulerArenaRead(
            partialBase +
                SIMPLE_DDGI_FEEDBACK_RECEIVER_FALLBACK_PROBES);
        receiverConsumerMask |= SchedulerArenaRead(
            partialBase + SIMPLE_DDGI_FEEDBACK_RECEIVER_CONSUMER_MASK);
        for (uint ring = 0u; ring < 3u; ring++)
        {
            adaptiveSavedRayRing[ring] += SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_RING + ring);
            adaptiveMaximumErrorRing[ring] = max(
                adaptiveMaximumErrorRing[ring],
                SchedulerArenaRead(
                    partialBase + SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_RING + ring));
        }
        for (uint content = 0u; content < 4u; content++)
        {
            adaptiveSavedRayContent[content] += SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_CONTENT + content);
            adaptiveMaximumErrorContent[content] = max(
                adaptiveMaximumErrorContent[content],
                SchedulerArenaRead(
                    partialBase + SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_CONTENT + content));
        }
        for (uint ring = 0u; ring < 3u; ring++)
        {
            rebasePendingRing[ring] += SchedulerArenaRead(
                partialBase + SIMPLE_DDGI_FEEDBACK_REBASE_PENDING_RING + ring);
        }
    }
#endif

    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_FRESH], pendingFresh);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED], pendingExposed);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION], pendingRelocation);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE], pendingSource);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID], pendingSourceInvalidFlag);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR], pendingSourcePrivateRepair);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY], pendingSourceCardinality);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION], pendingSourceGeneration);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER], pendingSolver);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_CONVERGED], converged);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE], maximumFreshAge);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE], maximumExposedAge);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE], maximumRelocationAge);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE], maximumUnpublishedAge);
    atomicMax(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE],
        maximumVisibleUnsupportedAge);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS],
        visibleParticipants);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY],
        visibleSourceReady);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED],
        visiblePublished);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PARTICIPANTS], participatingCount);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED], solveEpochVisitedCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION],
        activeSourceMutationCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION],
        activeCanonicalMutationCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_PROBES],
        receiverContributingProbeCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_COVERAGE_BUCKETS],
        receiverCoverageBucketCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_FALLBACK_PROBES],
        receiverFallbackProbeCount);
    atomicOr(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_CONSUMER_MASK],
        receiverConsumerMask);
    for (uint ring = 0u; ring < 3u; ring++)
    {
        atomicAdd(
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_RING + ring],
            adaptiveSavedRayRing[ring]);
        atomicMax(
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_RING + ring],
            adaptiveMaximumErrorRing[ring]);
    }
    for (uint content = 0u; content < 4u; content++)
    {
        atomicAdd(
            feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_CONTENT + content],
            adaptiveSavedRayContent[content]);
        atomicMax(
            feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_CONTENT + content],
            adaptiveMaximumErrorContent[content]);
    }
    for (uint ring = 0u; ring < 3u; ring++)
    {
        atomicAdd(
            feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_REBASE_PENDING_RING + ring],
            rebasePendingRing[ring]);
    }
    barrier();

#if SIMPLE_DDGI_FEEDBACK_PARTIAL_REDUCTION
    if (localIndex == 0u)
    {
        uint partialBase = pc.FeedbackOffsetWords +
            gl_WorkGroupID.x * SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS;
        for (uint word = 0u;
             word < SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS;
             word++)
        {
            SchedulerArenaWrite(
                partialBase + word,
                feedbackReduction[word]);
        }
    }
    return;
#endif

    uint base = pc.FeedbackOffsetWords;
    if (localIndex == 0u)
    {
        pendingFresh = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_FRESH];
        pendingExposed = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED];
        pendingRelocation = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION];
        pendingSource = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE];
        pendingSourceInvalidFlag = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID];
        pendingSourcePrivateRepair = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR];
        pendingSourceCardinality = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY];
        pendingSourceGeneration = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION];
        pendingSolver = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER];
        converged = feedbackReduction[SIMPLE_DDGI_FEEDBACK_CONVERGED];
        maximumFreshAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE];
        maximumExposedAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE];
        maximumRelocationAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE];
        maximumUnpublishedAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE];
        maximumVisibleUnsupportedAge =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE];
        visibleParticipants = feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS];
        visibleSourceReady = feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY];
        visiblePublished = feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED];
        participatingCount = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PARTICIPANTS];
        solveEpochVisitedCount = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED];
        activeSourceMutationCount =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION];
        activeCanonicalMutationCount =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION];
        receiverContributingProbeCount =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_PROBES];
        receiverCoverageBucketCount =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_COVERAGE_BUCKETS];
        receiverFallbackProbeCount =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_FALLBACK_PROBES];
        receiverConsumerMask =
            feedbackReduction[SIMPLE_DDGI_FEEDBACK_RECEIVER_CONSUMER_MASK];
        for (uint ring = 0u; ring < 3u; ring++)
        {
            adaptiveSavedRayRing[ring] = feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_RING + ring];
            adaptiveMaximumErrorRing[ring] = feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_RING + ring];
        }
        for (uint content = 0u; content < 4u; content++)
        {
            adaptiveSavedRayContent[content] = feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_ADAPTIVE_SAVED_CONTENT + content];
            adaptiveMaximumErrorContent[content] = feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_ADAPTIVE_ERROR_CONTENT + content];
        }
        for (uint ring = 0u; ring < 3u; ring++)
        {
            rebasePendingRing[ring] = feedbackReduction[
                SIMPLE_DDGI_FEEDBACK_REBASE_PENDING_RING + ring];
        }

    uint considered = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_CONSIDERED);
    uint eligible = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE);
    uint accepted = min(
        SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ACCEPTED),
        SchedulerRequestCapacity());
    uint committed = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_COMMITTED);
    uint published = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_PUBLISHED);
    uint rejected = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_REJECTED);
    uint primaryUsed = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_PRIMARY_USED);
    uint sourceUsed = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_USED);
    uint transportUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_TRANSPORT_USED);
    uint sourceProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_PROBE_USED);
    uint hardSourceProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_HARD_SOURCE_PROBE_USED);
    uint routineSourceProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ROUTINE_SOURCE_PROBE_USED);
    uint cachedSolverProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_CACHED_SOLVER_PROBE_USED);
    uint targetSource = SchedulerSourceTargetRays();

    pendingSource = max(
        pendingSource,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_PENDING_TAIL_SOURCE));
    bool sourceCohortIncomplete = SchedulerTransportV2() && pendingSource != 0u;
    uint staticConvergedGeneration =
        !sourceCohortIncomplete && pendingSolver == 0u
            ? SchedulerSourceGeneration()
            : 0u;

    feedbackSummary[2u] = SchedulerVolumeGeneration();
    feedbackSummary[3u] = SchedulerResourceGeneration();
    feedbackSummary[4u] = SchedulerQueueGeneration();
    feedbackSummary[5u] = SchedulerSourceGeneration();
    feedbackSummary[6u] = SchedulerTransportGeneration();
    uint status = 0u;
    if (SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW) != 0u)
        status |= 1u;
    if (SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION) != 0u)
        status |= 2u;
    if (SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_EMISSION_FAILURE) != 0u)
        status |= 4u;
    feedbackSummary[7u] = status;
    feedbackSummary[8u] = considered;
    feedbackSummary[9u] = eligible;
    feedbackSummary[10u] = accepted;
    feedbackSummary[11u] = committed;
    feedbackSummary[12u] = rejected;
    feedbackSummary[13u] = SchedulerRequestBudget();
    feedbackSummary[14u] = accepted;
    feedbackSummary[15u] = SchedulerPrimaryRayBudget();
    feedbackSummary[16u] = primaryUsed;
    feedbackSummary[17u] = targetSource;
    feedbackSummary[18u] = sourceUsed;
    // An unused source budget is not a capacity shortfall once the source
    // cohort is empty. Reporting it as one kept host-side source readiness
    // permanently active during cached propagation and camera-only scrolling.
    feedbackSummary[19u] =
        pendingSource != 0u && targetSource > sourceUsed
            ? targetSource - sourceUsed
            : 0u;
    feedbackSummary[20u] = SchedulerArenaRead(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION);
    feedbackSummary[21u] = transportUsed;
    feedbackSummary[22u] = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW);
    feedbackSummary[23u] = SchedulerArenaRead(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_COMMIT_REJECTED);
    feedbackSummary[24u] = pendingFresh;
    feedbackSummary[25u] = pendingExposed;
    feedbackSummary[26u] = pendingRelocation;
    feedbackSummary[27u] = pendingSource;
    feedbackSummary[28u] = pendingSolver;
    feedbackSummary[29u] = converged;
    feedbackSummary[30u] = maximumFreshAge;
    feedbackSummary[31u] = maximumExposedAge;
    feedbackSummary[32u] = maximumRelocationAge;
    feedbackSummary[33u] = maximumUnpublishedAge;
    feedbackSummary[34u] = maximumVisibleUnsupportedAge;
    feedbackSummary[35u] = sourceCohortIncomplete
        ? SchedulerFrameIndex()
        : 0u;
    feedbackSummary[36u] = sourceCohortIncomplete
        ? 0u
        : SchedulerFrameIndex();
    feedbackSummary[37u] = sourceCohortIncomplete ? targetSource : 0u;
    feedbackSummary[38u] = sourceCohortIncomplete ? 0u : sourceUsed;
    feedbackSummary[39u] = SchedulerTransportGeneration();
    feedbackSummary[40u] = pendingSolver == 0u
        ? SchedulerTransportGeneration()
        : 0u;
    feedbackSummary[41u] = staticConvergedGeneration;
    feedbackSummary[42u] = sourceCohortIncomplete || pendingSolver != 0u
        ? 1u
        : 0u;
    feedbackSummary[43u] = hardSourceProbeUsed;
    feedbackSummary[44u] = routineSourceProbeUsed;
    feedbackSummary[45u] = cachedSolverProbeUsed;
    // Exact source-repair attribution replaces two retired dirty-latency
    // placeholders in the fixed feedback ABI. These counts distinguish a
    // public cache marker from a transaction-private resident repair without
    // any per-ray diagnostics or additional readback memory.
    feedbackSummary[46u] =
        min(pendingSourceInvalidFlag, 0xffffu) |
            (min(pendingSourceCardinality, 0xffffu) << 16u);
    feedbackSummary[47u] =
        min(pendingSourcePrivateRepair, 0xffffu) |
            (min(pendingSourceGeneration, 0xffffu) << 16u);
    for (uint bucket = 0u; bucket < 6u; bucket++)
    {
        feedbackSummary[48u + bucket] = SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_BUCKET_BASE + bucket);
    }
    uint dispatchedLanes = 0u;
    uint noOpLanes = 0u;
    if (!SchedulerCertifiedQuiesced())
    {
        // Lane-base publishes non-empty lane ids in LaneTotals. Walking that
        // compact list preserves the exact dispatched/no-op definitions while
        // avoiding a second full 896-lane diagnostic scan.
        for (uint activeIndex = 0u;
             activeIndex < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             activeIndex++)
        {
            uint lane = SchedulerArenaRead(
                pc.LaneTotalsOffsetWords + activeIndex);
            if (lane == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                break;
            uint admission = SchedulerArenaRead(pc.LaneAdmissionOffsetWords + lane);
            dispatchedLanes++;
            noOpLanes += admission == 0u ? 1u : 0u;
        }
    }
    feedbackSummary[54u] = dispatchedLanes;
    feedbackSummary[55u] = noOpLanes;
    feedbackSummary[56u] = visibleParticipants;
    feedbackSummary[57u] = visibleSourceReady;
    feedbackSummary[58u] = visiblePublished;
    feedbackSummary[59u] = participatingCount;
    feedbackSummary[60u] = solveEpochVisitedCount;
    feedbackSummary[61u] = SchedulerSolveEpoch();
    feedbackSummary[62u] = sourceProbeUsed;
    feedbackSummary[63u] = published;
    }

    // Lane zero assembles the fixed ABI in shared memory; all lanes publish
    // it concurrently. The two-word frame header is deliberately excluded
    // and written only after every summary, cursor, and extended word is done.
    barrier();
    if (localIndex >= 2u)
        SchedulerArenaWrite(base + localIndex, feedbackSummary[localIndex]);

    uint cursorCopyCount = SIMPLE_DDGI_SCHEDULER_MAX_LANES;
    if (SchedulerCertifiedQuiesced())
    {
#if SIMPLE_DDGI_FEEDBACK_PARTIAL_REDUCTION == 0
        uint partialWordCount =
            partialGroupCount * SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS;
        cursorCopyCount = partialWordCount > 64u
            ? min(
                partialWordCount - 64u,
                SIMPLE_DDGI_SCHEDULER_MAX_LANES)
            : 0u;
#else
        cursorCopyCount = 0u;
#endif
    }
    for (uint lane = localIndex;
         lane < cursorCopyCount;
         lane += gl_WorkGroupSize.x)
    {
        SchedulerArenaWrite(
            base + 64u + lane,
            SchedulerArenaRead(pc.LaneCursorsOffsetWords + lane));
    }
    barrier();

    if (localIndex != 0u)
        return;

    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_UNBUCKETED_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_UNBUCKETED));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_SCROLL_COHORT_FAILURE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_SCROLL_COHORT_FAILURE));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_SCROLL_EXPECTED_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_SCROLL_EXPECTED));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_SCROLL_ACCEPTED_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_SCROLL_ACCEPTED));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_SCROLL_TRACED_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_SCROLL_TRACED));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_SCROLL_COMMITTED_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_SCROLL_COMMITTED));
    for (uint ring = 0u; ring < 3u; ring++)
    {
        uint rebaseSerial = 0u;
        for (uint volume = 0u;
             volume < min(
                SchedulerActiveVolumeCount(),
                SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES);
             volume++)
        {
            if (SchedulerVolumeIsRebuilding(volume) &&
                min(SchedulerVolumeRing(volume), 2u) == ring)
            {
                rebaseSerial =
                    SchedulerVolumeScrollTransactionSerial(volume);
                break;
            }
        }
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_REBASE_RING_OFFSET + ring,
            min(rebasePendingRing[ring], 0xffffu) |
                ((rebaseSerial & 0xffffu) << 16u));
    }
    for (uint workClass = 0u;
         workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
         workClass++)
    {
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ELIGIBLE_CLASS_OFFSET + workClass,
            SchedulerArenaRead(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE_CLASS_BASE + workClass));
    }
    for (uint ring = 0u; ring < 3u; ring++)
    {
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ELIGIBLE_RING_OFFSET + ring,
            SchedulerArenaRead(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE_RING_BASE + ring));
    }
    for (uint category = 0u;
         category < SIMPLE_DDGI_SCHEDULER_COMMIT_FAILURE_CATEGORY_COUNT;
         category++)
    {
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_COMMIT_FAILURE_OFFSET +
                category,
            SchedulerArenaRead(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_COMMIT_FAILURE_BASE +
                    category));
    }
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_TRANSACTION_PREDICATE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_TRANSACTION_PREDICATE_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_MISSING_COMPLETION_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_MISSING_COMPLETION_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_PRODUCER_FAILURE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_PRODUCER_FAILURE_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_CACHE_READ_FAILURE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_CACHE_READ_FAILURE_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ACTIVE_SOURCE_MUTATION_OFFSET,
        activeSourceMutationCount);
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ACTIVE_CANONICAL_MUTATION_OFFSET,
        activeCanonicalMutationCount);
    for (uint residualCounter = 0u; residualCounter < 4u; residualCounter++)
    {
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_RESIDUAL_PROPAGATION_OFFSET +
                residualCounter,
            SchedulerArenaRead(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_RESIDUAL_SEEDED +
                    residualCounter));
    }
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_URGENT_RELIGHT_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_URGENT_TELEMETRY));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_RECEIVER_CONTRIBUTION_OFFSET + 0u,
        receiverContributingProbeCount);
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_RECEIVER_CONTRIBUTION_OFFSET + 1u,
        receiverCoverageBucketCount);
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_RECEIVER_CONTRIBUTION_OFFSET + 2u,
        receiverFallbackProbeCount);
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_RECEIVER_CONTRIBUTION_OFFSET + 3u,
        receiverConsumerMask);
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_TRANSPORT_TOPOLOGY_OFFSET,
        SchedulerTransportTopologyGeneration());
    for (uint ring = 0u; ring < 3u; ring++)
    {
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ADAPTIVE_SAVED_RING_OFFSET +
                ring,
            adaptiveSavedRayRing[ring]);
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ADAPTIVE_ERROR_RING_OFFSET +
                ring,
            adaptiveMaximumErrorRing[ring]);
    }
    for (uint content = 0u; content < 4u; content++)
    {
        SchedulerArenaWrite(
            base +
                SIMPLE_DDGI_SCHEDULER_FEEDBACK_ADAPTIVE_SAVED_CONTENT_OFFSET +
                content,
            adaptiveSavedRayContent[content]);
        SchedulerArenaWrite(
            base +
                SIMPLE_DDGI_SCHEDULER_FEEDBACK_ADAPTIVE_ERROR_CONTENT_OFFSET +
                content,
            adaptiveMaximumErrorContent[content]);
    }
    // Consume the mailbox after copying it into this frame-stamped feedback
    // record. Without this clear, an idle lane could reappear as current when
    // the compact 16-bit telemetry stamp wraps after 65,536 frames.
    SchedulerArenaWrite(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_URGENT_TELEMETRY,
        0u);

    // Publish the high word first and the low word last. The low word is the
    // completion marker observed by the host after readback, so no current
    // frame header can expose a partially written summary.
    memoryBarrierBuffer();
    SchedulerArenaWrite(base + 1u, SchedulerFrame(13u));
    memoryBarrierBuffer();
    SchedulerArenaWrite(base + 0u, SchedulerFrame(12u));
}
