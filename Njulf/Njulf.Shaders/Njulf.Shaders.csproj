        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1 -DSIMPLE_DDGI_TRACE_NO_LOCAL_LIGHTS=1 -DSIMPLE_DDGI_TRACE_NO_EMISSIVE_SOURCES=1 -DSIMPLE_DDGI_TRACE_ONE_DIRECTIONAL_LIGHT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_sun_split_final.comp">
