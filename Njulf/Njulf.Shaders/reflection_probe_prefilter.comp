#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform samplerCube ReflectionScratchInput;
layout(set = 2, binding = 1, rgba16f) uniform writeonly image2DArray ReflectionPrefilterOutput;

layout(push_constant) uniform ReflectionPrefilterPushBlock
{
    uint OutputSize;
    uint SampleCount;
    float Roughness;
    float SourceTexelSize;
} pc;

#include "ggx_prefilter.glsl"

vec3 ReflectionCubeDirection(uint face, vec2 uv)
{
    float a = 2.0 * uv.x - 1.0;
    float b = 1.0 - 2.0 * uv.y;
    if (face == 0u)
        return normalize(vec3(1.0, b, -a));
    if (face == 1u)
        return normalize(vec3(-1.0, b, a));
    if (face == 2u)
        return normalize(vec3(a, 1.0, -b));
    if (face == 3u)
        return normalize(vec3(a, -1.0, b));
    if (face == 4u)
        return normalize(vec3(a, b, 1.0));
    return normalize(vec3(-a, b, -1.0));
}

float ReflectionPrefilterLuminance(vec3 radiance)
{
    return dot(max(radiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

vec3 SampleReflectionPrefilterRadiance(vec3 direction)
{
    vec3 center = max(
        textureLod(ReflectionScratchInput, direction, 0.0).rgb,
        vec3(0.0));

    // A delta-like direct highlight can occupy one capture texel with many
    // thousands of nits. Straight GGX convolution spreads that undersampled
    // texel across every rough mip as visible fireflies. Derive a robust local
    // ceiling from four samples outside the source bilinear footprint. Broad
    // highlights survive because their neighbourhood is bright too, while an
    // isolated spike is bounded before it enters the convolution.
    vec3 tangent;
    vec3 bitangent;
    EnvironmentPrefilterBasis(direction, tangent, bitangent);
    float offset = max(pc.SourceTexelSize * 2.5, 0.0001);
    float l0 = ReflectionPrefilterLuminance(textureLod(
        ReflectionScratchInput,
        normalize(direction + tangent * offset),
        0.0).rgb);
    float l1 = ReflectionPrefilterLuminance(textureLod(
        ReflectionScratchInput,
        normalize(direction - tangent * offset),
        0.0).rgb);
    float l2 = ReflectionPrefilterLuminance(textureLod(
        ReflectionScratchInput,
        normalize(direction + bitangent * offset),
        0.0).rgb);
    float l3 = ReflectionPrefilterLuminance(textureLod(
        ReflectionScratchInput,
        normalize(direction - bitangent * offset),
        0.0).rgb);
    float minimumNeighbour = min(min(l0, l1), min(l2, l3));
    float maximumNeighbour = max(max(l0, l1), max(l2, l3));
    float medianNeighbour = 0.5 * (
        l0 + l1 + l2 + l3 - minimumNeighbour - maximumNeighbour);
    float luminanceLimit = max(
        medianNeighbour * 4.0,
        medianNeighbour + 4.0);
    float centerLuminance = ReflectionPrefilterLuminance(center);
    if (centerLuminance > luminanceLimit)
        center *= luminanceLimit / max(centerLuminance, 0.000001);
    return center;
}

void main()
{
    uvec3 invocation = gl_GlobalInvocationID;
    if (invocation.x >= pc.OutputSize ||
        invocation.y >= pc.OutputSize ||
        invocation.z >= 6u)
    {
        return;
    }

    vec2 uv = (vec2(invocation.xy) + vec2(0.5)) /
        max(float(pc.OutputSize), 1.0);
    vec3 reflection = ReflectionCubeDirection(invocation.z, uv);
    vec3 result = vec3(0.0);
    float totalWeight = 0.0;
    uint sampleCount = max(pc.SampleCount, 1u);
    if (pc.Roughness <= 0.0001 || sampleCount == 1u)
    {
        result = textureLod(ReflectionScratchInput, reflection, 0.0).rgb;
        totalWeight = 1.0;
    }
    else
    {
        vec3 tangent;
        vec3 bitangent;
        EnvironmentPrefilterBasis(reflection, tangent, bitangent);
        for (uint sampleIndex = 0u; sampleIndex < sampleCount; sampleIndex++)
        {
            vec2 samplePoint = vec2(
                (float(sampleIndex) + 0.5) / float(sampleCount),
                EnvironmentPrefilterRadicalInverse(sampleIndex));
            vec3 localHalf = EnvironmentPrefilterImportanceSampleGgx(
                samplePoint,
                pc.Roughness);
            vec3 halfVector = normalize(
                tangent * localHalf.x +
                bitangent * localHalf.y +
                reflection * localHalf.z);
            vec3 lightDirection = normalize(
                2.0 * dot(reflection, halfVector) * halfVector - reflection);
            float nDotL = max(dot(reflection, lightDirection), 0.0);
            if (nDotL <= 0.0)
                continue;
            result += SampleReflectionPrefilterRadiance(lightDirection) * nDotL;
            totalWeight += nDotL;
        }
    }

    if (totalWeight > 0.0)
        result /= totalWeight;
    imageStore(
        ReflectionPrefilterOutput,
        ivec3(invocation),
        vec4(max(result, vec3(0.0)), 1.0));
}
