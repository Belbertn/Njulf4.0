<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BCnEncoder.Net" Version="2.3.0">
        <ExcludeAssets Condition="'$(CookedAssetsOnly)' == 'true'">runtime</ExcludeAssets>
      </PackageReference>
      <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
      <!-- Runtime WebP upload and descriptor-stable hot reload remain supported
           by cooked hosts, so the reviewed native decoder must ship in Release. -->
      <PackageReference Include="Imazen.WebP.NativeRuntime.All" Version="1.6.1" />
      <PackageReference Include="Ktx2.NET" Version="1.0.5">
        <ExcludeAssets Condition="'$(CookedAssetsOnly)' == 'true'">runtime</ExcludeAssets>
      </PackageReference>
      <PackageReference Include="Meshoptimizer.NET" Version="1.0.7" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="System.IO.Hashing" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="SharpGLTF.Core" Version="1.0.7">
        <ExcludeAssets Condition="'$(CookedAssetsOnly)' == 'true'">runtime</ExcludeAssets>
      </PackageReference>
      <PackageReference Include="SharpGLTF.Runtime" Version="1.0.7">
        <ExcludeAssets Condition="'$(CookedAssetsOnly)' == 'true'">runtime</ExcludeAssets>
      </PackageReference>
      <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7">
        <ExcludeAssets Condition="'$(CookedAssetsOnly)' == 'true'">runtime</ExcludeAssets>
      </PackageReference>
      <PackageReference Include="Silk.NET.Assimp" Version="2.23.0">
        <ExcludeAssets Condition="'$(CookedAssetsOnly)' == 'true'">runtime</ExcludeAssets>
      </PackageReference>
      <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.16" />
      <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Njulf.Core\Njulf.Core.csproj" />
    <ProjectReference Include="..\Njulf.Graphics\Njulf.Graphics.csproj" />
    </ItemGroup>

</Project>
