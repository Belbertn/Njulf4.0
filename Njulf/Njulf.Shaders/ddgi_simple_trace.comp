#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_ray_query : require

#include "common.glsl"
#define SIMPLE_DDGI_DISABLE_SAMPLED_ATLAS 1
#include "ddgi_simple_shared.glsl"
#include "farfield_clipmap.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform accelerationStructureEXT SceneTlas;

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint TransportGeneration;
    uint PrimaryDirectionalLightIndex;
    uint DispatchQueueOffset;
    uint DispatchProbeCount;
    uint DispatchRaysPerProbe;
    uint SchedulerArenaBufferIndex;
    uint SchedulerRayBucketIndex;
    uint SchedulerRayBucketCommandsOffsetWords;
    uint SchedulerRayBucketMetadataOffsetWords;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerUpdateRecordsOffsetWords;
} pc;

const float PI = SIMPLE_DDGI_PI;
const uint DDGI_MATERIAL_TEXTURE_DISABLED_CASCADE = 4u;
// The shared hit-shading policy needs an authored-volume sentinel. The
// simple-DDGI path owns the volume convention, so provide it locally before
// including that policy.
const uint DDGI_AUTHORED_VOLUME_CASCADE = SIMPLE_DDGI_AUTHORED_VOLUME_CASCADE;
const float DDGI_DIRECTIONAL_SHADOW_RAY_DISTANCE = 256.0;
const float DDGI_PROBE_TRACE_EPSILON = 0.02;
// High and Ultra publish a TLAS only when the complete resolved ray scene fits.
// Keep that exact representation authoritative across the entire probe ray;
// the far-field cache remains a bounded streaming substitute for lower tiers.
const uint SIMPLE_DDGI_TRACE_FLAG_COMPLETE_RAY_SCENE = 1u << 6;
const uint SIMPLE_DDGI_TRACE_FLAG_ALPHA_MASK_TRANSPORT_ENABLED = 1u << 7;
const uint SIMPLE_DDGI_TRACE_FLAG_THIN_SURFACE_TRANSMISSION_ENABLED = 1u << 8;

#define DDGI_HIT_USE_SELECTED_LIGHTS 0
#define DDGI_HIT_ENABLE_ENVIRONMENT_WRAPPER 0
// These private values are written once per queued probe update below. Keeping
// the shared hit-shading policy behind macros avoids cloning material/direct
// logic while allowing the scheduler to cap far-ring work.
uint simpleDdgiCurrentMaxShadedLights;
uint simpleDdgiCurrentMaterialTextureMaxCascade;
uint simpleDdgiCurrentVolumeCascade;
bool simpleDdgiCurrentDetailedDiagnostics;
uint simpleDdgiCurrentVolumeIndex;
uint simpleDdgiCurrentReceiverInstanceIndex;
uint simpleDdgiCurrentReceiverPrimitiveIndex;
#define DDGI_HIT_DIRECT_LIGHT_CAP simpleDdgiCurrentMaxShadedLights
#define DDGI_HIT_MAX_SHADED_LIGHTS simpleDdgiCurrentMaxShadedLights
#define DDGI_HIT_MATERIAL_TEXTURE_MAX_CASCADE simpleDdgiCurrentMaterialTextureMaxCascade
#define DDGI_HIT_ALPHA_MASK_TRANSPORT_ENABLED ((pc.Flags & SIMPLE_DDGI_TRACE_FLAG_ALPHA_MASK_TRANSPORT_ENABLED) != 0u)
#define DDGI_HIT_THIN_SURFACE_TRANSMISSION_ENABLED ((pc.Flags & SIMPLE_DDGI_TRACE_FLAG_THIN_SURFACE_TRANSMISSION_ENABLED) != 0u)
#define DDGI_HIT_SHADOW_DIAGNOSTICS_ENABLED simpleDdgiCurrentDetailedDiagnostics
#define DDGI_HIT_VOLUME_DIAGNOSTICS_ENABLED 1
#define DDGI_HIT_VOLUME_ENERGY_COUNTER_BASE SIMPLE_DDGI_VOLUME_ENERGY_COUNTER_BASE
#define DDGI_HIT_VOLUME_ENERGY_COUNTER_STRIDE SIMPLE_DDGI_VOLUME_ENERGY_COUNTER_STRIDE
#define DDGI_HIT_VOLUME_INDEX simpleDdgiCurrentVolumeIndex
#define DDGI_HIT_RECEIVER_INSTANCE_INDEX simpleDdgiCurrentReceiverInstanceIndex
#define DDGI_HIT_RECEIVER_PRIMITIVE_INDEX simpleDdgiCurrentReceiverPrimitiveIndex
#include "ddgi_hit_shading.glsl"

void WriteSimpleRayResult(
    uint rayResultIndex,
    vec3 radiance,
    float surfaceDistance,
    float visibilityDistance,
    vec3 direction,
    float hitKind)
{
    uint baseWord = rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS;
    WriteStorageVec4Uniform(pc.RayResultScratchBufferIndex, baseWord + 0u, vec4(clamp(radiance, vec3(0.0), vec3(65504.0)), surfaceDistance));
    WriteStorageFloatUniform(pc.RayResultScratchBufferIndex, baseWord + 4u, direction.x);
    WriteStorageFloatUniform(pc.RayResultScratchBufferIndex, baseWord + 5u, direction.y);
    WriteStorageFloatUniform(pc.RayResultScratchBufferIndex, baseWord + 6u, direction.z);
    WriteStorageWordUniform(
        pc.RayResultScratchBufferIndex,
        baseWord + 7u,
        PackSimpleDdgiRayVisibilityHit(visibilityDistance, hitKind));
}

bool TraceSimpleDdgiBackfaceVisibilityDistance(
    vec3 origin,
    vec3 direction,
    float maxDistance,
    out float hitDistance)
{
    hitDistance = max(maxDistance, 0.0);
    if (maxDistance <= DDGI_PROBE_TRACE_EPSILON)
        return false;

    // This query never shades or enters the V2 transport source cache. Its
    // covered distance makes thin architectural shells two-sided occluders for
    // receiver visibility. If that backface is the nearest hit, the packed
    // visibility kind also lets relocation evacuate a probe immediately behind
    // a one-sided floor or wall instead of leaving a bright probe there.
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query,
        SceneTlas,
        gl_RayFlagsCullFrontFacingTrianglesEXT,
        0xff,
        origin,
        DDGI_PROBE_TRACE_EPSILON,
        direction,
        maxDistance);

    uint alphaCandidateCount = 0u;
    while (rayQueryProceedEXT(query))
    {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT)
            continue;

        alphaCandidateCount++;
        if (alphaCandidateCount > DDGI_HIT_ALPHA_CANDIDATE_LIMIT)
        {
            RecordDdgiAlphaCandidateLimitReached();
            rayQueryConfirmIntersectionEXT(query);
            rayQueryTerminateEXT(query);
            break;
        }

        uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, false);
        bool frontFacing = rayQueryGetIntersectionFrontFaceEXT(query, false);
        if (DdgiCandidatePassesTwoSidedOpacity(
                instanceIndex,
                primitiveIndex,
                barycentrics,
                frontFacing))
        {
            rayQueryConfirmIntersectionEXT(query);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT)
        return false;

    hitDistance = rayQueryGetIntersectionTEXT(query, true);
    return true;
}

// All calls below are in main(), where params is the authoritative uploaded
// simple-DDGI state. Remapping the counter helper here keeps disabled captures
// free of the otherwise high-contention per-ray atomic operations.
#define AddRendererDiagnostic(frameIndex, counterIndex, value) AddSimpleDdgiDiagnostic(params, frameIndex, counterIndex, value)

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    simpleDdgiCurrentDetailedDiagnostics = SimpleDdgiDetailedDiagnosticsEnabled(params);
    uint dispatchRay = gl_GlobalInvocationID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint schedulerQueueOffset = 0u;
    uint schedulerProbeCount = 0u;
    uint schedulerRaysPerProbe = 0u;
    if (gpuScheduler)
    {
        SimpleDdgiResolveSchedulerRayBucket(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerRayBucketMetadataOffsetWords,
            pc.SchedulerRayBucketIndex,
            schedulerQueueOffset,
            schedulerProbeCount,
            schedulerRaysPerProbe);
    }
    uint dispatchProbeCount;
    uint dispatchRaysPerProbe;
    if (gpuScheduler)
    {
        // Resident dispatch dimensions and queue addressing are an ABI owned by
        // the emitted metadata record. Push constants are intentionally ignored
        // here so a stale per-pass batch cannot select another queue slice.
        dispatchProbeCount = schedulerProbeCount;
        dispatchRaysPerProbe = schedulerRaysPerProbe;
    }
    else
    {
        dispatchProbeCount = pc.DispatchProbeCount > 0u
            ? pc.DispatchProbeCount
            : params.probesToUpdate;
        dispatchRaysPerProbe = pc.DispatchRaysPerProbe > 0u
            ? pc.DispatchRaysPerProbe
            : params.raysPerProbe;
    }
    uint dispatchRayCount = dispatchProbeCount * dispatchRaysPerProbe;
    if (dispatchRay >= dispatchRayCount || params.probeCount == 0u)
        return;

    uint updateProbeOffset = (gpuScheduler ? schedulerQueueOffset : pc.DispatchQueueOffset) +
        dispatchRay / dispatchRaysPerProbe;
    uint rayIndex = dispatchRay % dispatchRaysPerProbe;
    if (!gpuScheduler && updateProbeOffset >= params.probesToUpdate)
        return;
    // Scratch remains addressed by the canonical queue-wide ray stride so later
    // probe-oriented passes are independent of dispatch batching.
    uint globalRay = updateProbeOffset * params.raysPerProbe + rayIndex;
    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, updateProbeOffset);
    simpleDdgiCurrentVolumeIndex = update.volumeIndex;
    simpleDdgiCurrentReceiverInstanceIndex = 0xffffffffu;
    simpleDdgiCurrentReceiverPrimitiveIndex = 0xffffffffu;
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    if (rayIndex >= activeRayCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    SimpleDdgiProbeState probeState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGeneration(update, probeState))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    uint volumeCascade = SimpleDdgiVolumeQualityCascade(volume);
    simpleDdgiCurrentVolumeCascade = volumeCascade;
    int materialTextureMaxCascade = SimpleDdgiUpdateMaterialTextureMaxCascade(update);
    simpleDdgiCurrentMaterialTextureMaxCascade = materialTextureMaxCascade < 0
        ? DDGI_MATERIAL_TEXTURE_DISABLED_CASCADE
        : uint(materialTextureMaxCascade);
    simpleDdgiCurrentMaxShadedLights = SimpleDdgiUpdateMaxShadedLights(update, pc.MaxShadedLights);
    vec3 probePosition = SimpleDdgiProbeLogicalPosition(volume, localProbeIndex) + probeState.relocation;
    // Maintenance rays are a stratified subset of the full sequence. This keeps
    // the estimator's directional support stable when the scheduler changes tier.
    uint sourceRayCount = SimpleDdgiUpdateSourceRayCount(update, params);
    uint sourceRayOrdinal = min(
        rayIndex * sourceRayCount / max(activeRayCount, 1u),
        sourceRayCount - 1u);
    // Cache keys remain indices in the global Fibonacci sequence. Map through
    // the per-probe source sequence so a 24-ray far ring stays uniformly
    // distributed across the 64/128-ray shared sequence and maintenance picks
    // an exact subset of those cached directions.
    uint directionRayIndex = sourceRayOrdinal * params.raysPerProbe / sourceRayCount;
    vec4 rayRotation = SimpleDdgiPerProbeRayRotation(probeIndex, params.rayRotation);
    vec3 direction = SimpleDdgiFibonacciDirection(directionRayIndex, params.raysPerProbe, rayRotation);
    bool transportV2 = (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u;
    bool sourceRefresh = SimpleDdgiUpdateRequiresSourceRefresh(update);
    bool relocationRetryPending =
        (probeState.flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u;
    float maxDistance = max(volume.spacing * float(max(max(volume.gridCount.x, volume.gridCount.y), volume.gridCount.z)), volume.spacing);
    bool farFieldOnlyRing = volume.spacing >= 15.999;
    bool farFieldEnabled = (pc.Flags & SIMPLE_DDGI_FLAG_FAR_FIELD_ENABLED) != 0u;
    bool completeRayScene = (pc.Flags & SIMPLE_DDGI_TRACE_FLAG_COMPLETE_RAY_SCENE) != 0u;
    float nearTlasMaxDistance = farFieldEnabled && !completeRayScene
        ? min(maxDistance, max(params.farFieldStartDistance, volume.spacing))
        : maxDistance;

    // A full source refresh is the authoritative repair boundary. Clear any
    // older recovery request before tracing its complete sequence; transport
    // will set it again if the just-written cache still cannot be consumed.
    if (transportV2 && sourceRefresh && rayIndex == 0u && !gpuScheduler)
        ClearSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, probeIndex);

    // Cached V2 source data includes the original deterministic direction, hit
    // distance, normal, and albedo. A solver-only update therefore does no ray
    // query or shadow work yet still gets an exact source hit point for bounce.
    // Visibility moments are retained until the next source refresh, where the
    // frontface source and backface-only visibility queries run together.
    // A relocation-pending probe is the one exception: the GPU committed a new
    // origin after the prior rays were traced, while CPU readback can lag by a
    // frame. Force fresh source work from that authoritative new origin so a
    // stale cache can never be published at the relocated location.
    if (transportV2 && !sourceRefresh && !relocationRetryPending)
    {
        SimpleDdgiTransportRayCache cachedSource;
        if (ReadSimpleDdgiTransportRayCache(
                pc.TransportSourceCacheBufferIndex,
                probeIndex,
                directionRayIndex,
                params,
                SimpleDdgiProbeGeneration(probeState),
                cachedSource))
        {
            WriteSimpleRayResult(
                globalRay,
                cachedSource.sourceRadiance,
                cachedSource.distance,
                cachedSource.distance,
                cachedSource.direction,
                SimpleDdgiTransportRayCacheHitKind(cachedSource));
            SimpleDdgiSchedulerRayComplete(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                activeRayCount,
                1u << 0u);
            return;
        }

        // The CPU normally schedules solver-only work only after a complete
        // source refresh. If an individual entry is nevertheless absent (for
        // example after a live allocation transition), trace this ray now for
        // a safe frame and request a full source-cache repair through the
        // bounded probe-state readback path.
        if (gpuScheduler)
        {
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 1u);
        }
        else
            MarkSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, probeIndex);
    }

    // A valid probe owns its complete low-frequency field, including environment
    // misses. Forward composition evaluates diffuse IBL only for probe ownership
    // gaps, so sky energy is represented exactly once.
    vec3 radiance = SampleDdgiEnvironmentMissRadianceWithFallback(
        direction,
        params.environmentRadiance,
        params.environmentIntensity);
    vec3 traceDirectDiffuse = vec3(0.0);
    vec3 traceDirectNoShadowDiffuse = vec3(0.0);
    vec3 traceEmissiveDiffuse = vec3(0.0);
    vec3 traceBounceDiffuse = vec3(0.0);
    vec3 traceSkyDiffuse = radiance;
    vec3 cacheNormal = vec3(0.0, 1.0, 0.0);
    vec3 cacheAlbedo = vec3(0.0);
    vec3 cacheTransmission = vec3(0.0);
    uint traceSurfaceFlags = 0u;
    float cacheMaterialOcclusion = 1.0;
    float hitDistance = maxDistance;
    float hitKind = 0.0;
    // A detailed near segment is authoritative. The coarse far field begins only
    // after it, so a coarse voxel can never suppress closer TLAS geometry.
    if (nearTlasMaxDistance > DDGI_PROBE_TRACE_EPSILON)
    {
        rayQueryEXT query;
        // Do not cull back faces here. A culled one-sided shell turns an
        // embedded probe ray into a false sky miss. Commit the reverse face and
        // classify it explicitly below instead.
        rayQueryInitializeEXT(
            query,
            SceneTlas,
            gl_RayFlagsNoneEXT,
            0xff,
            probePosition,
            DDGI_PROBE_TRACE_EPSILON,
            direction,
            nearTlasMaxDistance);
        uint alphaCandidateCount = 0u;
        while (rayQueryProceedEXT(query))
        {
            if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
            {
                alphaCandidateCount++;
                if (alphaCandidateCount > DDGI_HIT_ALPHA_CANDIDATE_LIMIT)
                {
                    RecordDdgiAlphaCandidateLimitReached();
                    rayQueryConfirmIntersectionEXT(query);
                    rayQueryTerminateEXT(query);
                    break;
                }
                uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
                uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
                vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, false);
                bool candidateFrontFace = rayQueryGetIntersectionFrontFaceEXT(query, false);
                if (DdgiCandidatePassesOpacityPolicy(
                    instanceIndex,
                    primitiveIndex,
                    barycentrics,
                    candidateFrontFace,
                    false))
                    rayQueryConfirmIntersectionEXT(query);
            }
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT)
        {
            hitDistance = rayQueryGetIntersectionTEXT(query, true);
            bool frontFace = rayQueryGetIntersectionFrontFaceEXT(query, true);
            uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
            simpleDdgiCurrentReceiverInstanceIndex = instanceIndex;
            uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            simpleDdgiCurrentReceiverPrimitiveIndex = primitiveIndex;
            vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
            vec3 hitPosition = probePosition + direction * hitDistance;
            GPUDdgiRayQueryInstance hitInstance = ReadDdgiRayQueryInstance(instanceIndex);
            GPUMaterialData hitMaterial = ReadMaterial(hitInstance.MaterialIndex);
            bool hitDoubleSided = GiMaterialHasFlag(
                hitMaterial.TransportFlags,
                GI_MATERIAL_DOUBLE_SIDED);
            if (!frontFace && !hitDoubleSided)
            {
                hitKind = SIMPLE_DDGI_RAY_HIT_KIND_ONE_SIDED_BACK_FACE;
                radiance = vec3(0.0);
                traceSkyDiffuse = vec3(0.0);
                RecordSimpleDdgiOneSidedBackFaceDiagnostic(
                    params,
                    pc.CurrentFrameIndex,
                    update.volumeIndex);
                AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_TRACE_ONE_SIDED_BACKFACE_COUNT_COUNTER, 1u);
            }
            else
            {
            GiSurfaceSample surface;
            bool sampleMaterialTextures = ShouldSampleDdgiMaterialTextures(volumeCascade);
            if (ResolveCommittedHitSurface(
                instanceIndex,
                primitiveIndex,
                barycentrics,
                direction,
                frontFace,
                volumeCascade,
                sampleMaterialTextures,
                hitDistance,
                max(volume.spacing, 0.001),
                sqrt(4.0 / max(float(params.raysPerProbe), 1.0)),
                surface))
            {
                if ((params.flags & SIMPLE_DDGI_FLAG_THIN_SURFACE_TRANSMISSION) == 0u)
                {
                    surface.TransmittedDiffuseReflectance = vec3(0.0);
                    surface.Flags &= ~GI_MATERIAL_THIN_SURFACE_TRANSMISSION;
                }
                vec3 bounce = vec3(0.0);
                float bounceOwnership = 0.0;
                if (!transportV2)
                {
                    bounce = SampleSimpleDdgiUnifiedIrradiance(
                        params,
                        hitPosition + surface.GeometricNormal * max(0.03, volume.spacing * 0.02),
                        surface.ShadingNormal,
                        -direction,
                        true,
                        bounceOwnership);
                    bounce = ApplyGiMaterialOcclusion(
                        EvaluateGiDiffuseFromIrradiance(
                            bounce,
                            surface.DiffuseReflectance),
                        surface.MaterialOcclusion);
                }
                vec3 directNoShadowDiffuse;
                vec3 directDiffuse = EvaluateDirectDiffuseRadianceAtHit(
                    hitPosition,
                    surface,
                    -direction,
                    max(volume.spacing, 0.001),
                    directNoShadowDiffuse);
                vec3 emissiveProxyDiffuse = EvaluateSelectedDdgiEmissiveDiffuseRadianceAtHit(
                    hitPosition,
                    surface,
                    -direction,
                    max(volume.spacing, 0.001));
                // Direct emissive hits and next-event triangle sampling represent
                // different paths. Transport-atlas ownership only gates the
                // recursive irradiance term; applying it here biases the emitter
                // estimator and makes energy depend on cache residency.
                vec3 emissiveDiffuse = surface.EmissiveRadiance + emissiveProxyDiffuse;
                radiance = emissiveDiffuse + directDiffuse + bounce;
                traceDirectDiffuse = directDiffuse;
                traceDirectNoShadowDiffuse = directNoShadowDiffuse;
                traceEmissiveDiffuse = emissiveDiffuse;
                traceBounceDiffuse = bounce;
                traceSkyDiffuse = vec3(0.0);
                cacheNormal = surface.CanonicalGeometricNormal;
                cacheAlbedo = surface.DiffuseReflectance;
                cacheTransmission = surface.TransmittedDiffuseReflectance;
                traceSurfaceFlags = surface.Flags;
                float albedoLuminance = dot(
                    max(surface.DiffuseReflectance, vec3(0.0)),
                    vec3(0.2126, 0.7152, 0.0722));
                uint albedoCounter = DDGI_TRACE_OPAQUE_ALBEDO_LUMINANCE_COUNTER;
                uint albedoCountCounter = DDGI_TRACE_OPAQUE_COUNT_COUNTER;
                if (!GiMaterialHasFlag(surface.Flags, GI_MATERIAL_REFLECTS_INDIRECT_DIFFUSE))
                {
                    albedoCounter = DDGI_TRACE_REFLECT_DISABLED_ALBEDO_LUMINANCE_COUNTER;
                    albedoCountCounter = DDGI_TRACE_REFLECT_DISABLED_COUNT_COUNTER;
                }
                else if (GiMaterialHasFlag(surface.Flags, GI_MATERIAL_THIN_SURFACE_TRANSMISSION))
                {
                    albedoCounter = DDGI_TRACE_THIN_ALBEDO_LUMINANCE_COUNTER;
                    albedoCountCounter = DDGI_TRACE_THIN_COUNT_COUNTER;
                }
                else if (GiMaterialHasFlag(surface.Flags, GI_MATERIAL_TRANSMISSION_REMOVES_OPAQUE_DIFFUSE))
                {
                    albedoCounter = DDGI_TRACE_UNSUPPORTED_ALBEDO_LUMINANCE_COUNTER;
                    albedoCountCounter = DDGI_TRACE_UNSUPPORTED_COUNT_COUNTER;
                }
                AddRendererDiagnostic(
                    pc.CurrentFrameIndex,
                    albedoCounter,
                    uint(round(clamp(albedoLuminance, 0.0, 16.0) * 4096.0)));
                AddRendererDiagnostic(pc.CurrentFrameIndex, albedoCountCounter, 1u);
                cacheMaterialOcclusion = surface.MaterialOcclusion;
                if (dot(max(directDiffuse, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) > 0.0001)
                    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_DIRECT_LIGHT_HIT_COUNTER, 1u);
                if (dot(max(surface.EmissiveRadiance + emissiveProxyDiffuse, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) > 0.0001)
                    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_EMISSIVE_HIT_COUNTER, 1u);
                hitKind = frontFace
                    ? SIMPLE_DDGI_RAY_HIT_KIND_FRONT_FACE
                    : SIMPLE_DDGI_RAY_HIT_KIND_BACK_FACE;
            }
            }
        }
    }

    if (hitKind < 0.5 && farFieldEnabled && !completeRayScene &&
        (((pc.Flags & SIMPLE_DDGI_FLAG_FAR_FIELD_FORCE_ALL) != 0u) || farFieldOnlyRing || maxDistance > nearTlasMaxDistance))
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_RAY_COUNTER, 1u);
        vec3 farNormal;
        vec3 farAlbedo;
        vec3 farEmission;
        float farMaterialOcclusion;
        bool farStepExhausted;
        uint farVisitedSteps;
        if (TraceFarFieldClipmapDetailed(probePosition, direction, nearTlasMaxDistance, maxDistance,
                hitDistance,
                farNormal,
                farAlbedo,
                farEmission,
                farMaterialOcclusion,
                farStepExhausted,
                farVisitedSteps))
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_HIT_COUNTER, 1u);
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_FAR_FIELD_HIT_COUNTER, 1u);
            if ((globalRay & (DDGI_MATERIAL_PROVENANCE_DIAGNOSTIC_SAMPLE_WEIGHT - 1u)) == 0u)
            {
                AddRendererDiagnostic(
                    pc.CurrentFrameIndex,
                    MATERIAL_GI_FAR_FIELD_TRANSPORT_HIT_COUNTER,
                    DDGI_MATERIAL_PROVENANCE_DIAGNOSTIC_SAMPLE_WEIGHT);
            }
            vec3 hitPosition = probePosition + direction * hitDistance;
            vec3 directNoShadowDiffuse;
            vec3 safeFarNormal = normalize(farNormal);
            GiSurfaceSample farSurface = EmptyGiSurfaceSample(
                safeFarNormal,
                safeFarNormal,
                GI_MATERIAL_REFLECTS_INDIRECT_DIFFUSE);
            // Far-field V2 stores the canonical hemispherical response but not
            // a directional-F0 profile. Preserve its explicitly approximate
            // Lambertian fallback instead of leaving the directional fields
            // zero and silently dropping direct illumination.
            farSurface.DiffuseReflectance = clamp(farAlbedo, vec3(0.0), vec3(1.0));
            farSurface.DirectionalDiffuseBase = farSurface.DiffuseReflectance;
            farSurface.DielectricF0 = vec3(0.0);
            farSurface.EmissiveRadiance = clamp(farEmission, vec3(0.0), vec3(65504.0));
            farSurface.MaterialOcclusion = clamp(farMaterialOcclusion, 0.0, 1.0);
            vec3 bounce = vec3(0.0);
            float bounceOwnership = 0.0;
            if (!transportV2)
            {
                bounce = SampleSimpleDdgiUnifiedIrradiance(
                    params,
                    hitPosition + safeFarNormal * max(0.03, volume.spacing * 0.02),
                    safeFarNormal,
                    -direction,
                    true,
                    bounceOwnership);
                bounce = ApplyGiMaterialOcclusion(
                    EvaluateGiDiffuseFromIrradiance(
                        bounce,
                        farSurface.DiffuseReflectance),
                    farSurface.MaterialOcclusion);
            }
            vec3 directDiffuse = EvaluateDirectDiffuseRadianceAtHit(
                hitPosition,
                farSurface,
                -direction,
                max(volume.spacing, 0.001),
                directNoShadowDiffuse);
            vec3 emissiveProxyDiffuse = EvaluateSelectedDdgiEmissiveDiffuseRadianceAtHit(
                hitPosition,
                farSurface,
                -direction,
                max(volume.spacing, 0.001));
            vec3 farEmissiveDiffuse = farSurface.EmissiveRadiance + emissiveProxyDiffuse;
            radiance = directDiffuse + farEmissiveDiffuse + bounce;
            traceDirectDiffuse = directDiffuse;
            traceDirectNoShadowDiffuse = directNoShadowDiffuse;
            traceEmissiveDiffuse = farEmissiveDiffuse;
            traceBounceDiffuse = bounce;
            traceSkyDiffuse = vec3(0.0);
            cacheNormal = safeFarNormal;
            cacheAlbedo = farSurface.DiffuseReflectance;
            cacheMaterialOcclusion = farSurface.MaterialOcclusion;
            hitKind = dot(direction, safeFarNormal) > 0.0
                ? SIMPLE_DDGI_RAY_HIT_KIND_FAR_FIELD_BACK_FACE
                : SIMPLE_DDGI_RAY_HIT_KIND_FRONT_FACE;
        }
        else if (farStepExhausted)
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_STEP_EXHAUSTED_COUNTER, 1u);
        }

        if (hitKind < 0.5)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_FAR_FIELD_MISS_COUNTER, 1u);

        uint stepBucket = farVisitedSteps <= 4u
            ? FAR_FIELD_STEP_BUCKET_0_COUNTER
            : (farVisitedSteps <= 8u
                ? FAR_FIELD_STEP_BUCKET_1_COUNTER
                : (farVisitedSteps <= 16u
                    ? FAR_FIELD_STEP_BUCKET_2_COUNTER
                    : (farVisitedSteps <= 32u
                        ? FAR_FIELD_STEP_BUCKET_3_COUNTER
                        : FAR_FIELD_STEP_BUCKET_4_COUNTER)));
        AddRendererDiagnostic(pc.CurrentFrameIndex, stepBucket, 1u);
    }

    if (hitKind >= 0.5)
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_HIT_COUNTER, 1u);
        if (dot(max(radiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) <= 0.0001)
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_ZERO_RADIANCE_HIT_COUNTER, 1u);
            bool thinSurface = GiMaterialHasFlag(traceSurfaceFlags, GI_MATERIAL_THIN_SURFACE_TRANSMISSION);
            bool unsupportedTransmission = !thinSurface && GiMaterialHasFlag(
                traceSurfaceFlags,
                GI_MATERIAL_TRANSMISSION_REMOVES_OPAQUE_DIFFUSE);
            AddRendererDiagnostic(
                pc.CurrentFrameIndex,
                thinSurface
                    ? DDGI_THIN_ZERO_RADIANCE_THIN_COUNTER
                    : (unsupportedTransmission
                        ? DDGI_THIN_ZERO_RADIANCE_UNSUPPORTED_COUNTER
                        : DDGI_THIN_ZERO_RADIANCE_OPAQUE_COUNTER),
                1u);
        }
        if (!GiMaterialHasFlag(traceSurfaceFlags, GI_MATERIAL_THIN_SURFACE_TRANSMISSION) &&
            GiMaterialHasFlag(traceSurfaceFlags, GI_MATERIAL_TRANSMISSION_REMOVES_OPAQUE_DIFFUSE))
        {
            AddRendererDiagnostic(
                pc.CurrentFrameIndex,
                DDGI_THIN_UNSUPPORTED_TRANSMISSION_HIT_COUNTER,
                1u);
        }
    }
    else
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_MISS_COUNTER, 1u);
    }

    // In V2 these counters describe the traced source term, while transport
    // counters in the CPU diagnostic snapshot identify how much of the queue
    // reused that source for recursive solves. V1 retains the historical
    // source-plus-bounce trace accounting.
    RecordSimpleDdgiTraceEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        probeIndex,
        rayIndex,
        radiance,
        traceDirectDiffuse,
        traceDirectNoShadowDiffuse,
        traceEmissiveDiffuse,
        traceBounceDiffuse,
        traceSkyDiffuse,
        hitKind >= 0.5);

    if (transportV2)
    {
        WriteSimpleDdgiTransportRayCache(
            pc.TransportSourceCacheBufferIndex,
            probeIndex,
            directionRayIndex,
            params,
            radiance,
            hitDistance,
            direction,
            cacheNormal,
            cacheAlbedo,
            cacheTransmission,
            cacheMaterialOcclusion,
            hitKind,
            SimpleDdgiProbeGeneration(probeState));
    }
    float visibilityDistance = hitDistance;
    float visibilityHitKind = hitKind;
    float backfaceVisibilityDistance;
    if (TraceSimpleDdgiBackfaceVisibilityDistance(
            probePosition,
            direction,
            nearTlasMaxDistance,
            backfaceVisibilityDistance))
    {
        if (backfaceVisibilityDistance < visibilityDistance)
        {
            visibilityDistance = backfaceVisibilityDistance;
            visibilityHitKind = 2.0;
        }
    }
    WriteSimpleRayResult(
        globalRay,
        radiance,
        hitDistance,
        visibilityDistance,
        direction,
        visibilityHitKind);
    SimpleDdgiSchedulerRayComplete(
        pc.SchedulerArenaBufferIndex,
        pc.SchedulerOutcomesOffsetWords,
        update.outcomeIndex,
        activeRayCount,
        1u << 0u);
}

#undef AddRendererDiagnostic
