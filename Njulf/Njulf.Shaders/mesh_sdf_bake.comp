#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform PushConstants
{
    GPUMeshSdfBakeConstants Push;
} pc;

vec3 LoadPosition(uint vertexIndex)
{
    uint baseWord = (pc.Push.VertexOffset + vertexIndex) * 4u;
    uint storageIndex = pc.Push.VertexPositionBufferIndex;
    return vec3(
        uintBitsToFloat(BindlessStorageBuffers[storageIndex].Words[baseWord + 0u]),
        uintBitsToFloat(BindlessStorageBuffers[storageIndex].Words[baseWord + 1u]),
        uintBitsToFloat(BindlessStorageBuffers[storageIndex].Words[baseWord + 2u]));
}

uint LoadIndex(uint indexOffset)
{
    return BindlessStorageBuffers[pc.Push.IndexBufferIndex].Words[indexOffset];
}

vec3 ClosestPointOnTriangle(vec3 p, vec3 a, vec3 b, vec3 c, out vec3 barycentric)
{
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 ap = p - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0)
    {
        barycentric = vec3(1.0, 0.0, 0.0);
        return a;
    }

    vec3 bp = p - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3)
    {
        barycentric = vec3(0.0, 1.0, 0.0);
        return b;
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0)
    {
        float v = d1 / (d1 - d3);
        barycentric = vec3(1.0 - v, v, 0.0);
        return a + v * ab;
    }

    vec3 cp = p - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6)
    {
        barycentric = vec3(0.0, 0.0, 1.0);
        return c;
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0)
    {
        float w = d2 / (d2 - d6);
        barycentric = vec3(1.0 - w, 0.0, w);
        return a + w * ac;
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0)
    {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        barycentric = vec3(0.0, 1.0 - w, w);
        return b + w * (c - b);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    barycentric = vec3(1.0 - v - w, v, w);
    return a + ab * v + ac * w;
}

vec3 TriangleUnitNormal(vec3 a, vec3 b, vec3 c, out bool valid)
{
    vec3 unnormalizedNormal = cross(b - a, c - a);
    float normalLength2 = dot(unnormalizedNormal, unnormalizedNormal);
    valid = normalLength2 > 1.0e-12;
    return valid ? unnormalizedNormal * inversesqrt(normalLength2) : vec3(0.0);
}

float CornerAngle(vec3 center, vec3 first, vec3 second)
{
    vec3 u = first - center;
    vec3 v = second - center;
    float uLength2 = dot(u, u);
    float vLength2 = dot(v, v);
    if (uLength2 <= 1.0e-12 || vLength2 <= 1.0e-12)
        return 0.0;

    return acos(clamp(dot(u, v) * inversesqrt(uLength2 * vLength2), -1.0, 1.0));
}

vec3 AccumulateVertexPseudonormal(uint vertexIndex)
{
    vec3 pseudonormal = vec3(0.0);
    for (uint tri = 0u; tri < pc.Push.TriangleCount; tri++)
    {
        uint indexBase = tri * 3u;
        uint i0 = LoadIndex(pc.Push.IndexOffset + indexBase + 0u);
        uint i1 = LoadIndex(pc.Push.IndexOffset + indexBase + 1u);
        uint i2 = LoadIndex(pc.Push.IndexOffset + indexBase + 2u);
        if (i0 != vertexIndex && i1 != vertexIndex && i2 != vertexIndex)
            continue;

        vec3 a = LoadPosition(i0);
        vec3 b = LoadPosition(i1);
        vec3 c = LoadPosition(i2);
        bool normalValid;
        vec3 normal = TriangleUnitNormal(a, b, c, normalValid);
        if (!normalValid)
            continue;

        if (i0 == vertexIndex)
            pseudonormal += normal * CornerAngle(a, b, c);
        if (i1 == vertexIndex)
            pseudonormal += normal * CornerAngle(b, c, a);
        if (i2 == vertexIndex)
            pseudonormal += normal * CornerAngle(c, a, b);
    }

    return pseudonormal;
}

vec3 AccumulateEdgePseudonormal(uint edgeA, uint edgeB)
{
    vec3 pseudonormal = vec3(0.0);
    for (uint tri = 0u; tri < pc.Push.TriangleCount; tri++)
    {
        uint indexBase = tri * 3u;
        uint i0 = LoadIndex(pc.Push.IndexOffset + indexBase + 0u);
        uint i1 = LoadIndex(pc.Push.IndexOffset + indexBase + 1u);
        uint i2 = LoadIndex(pc.Push.IndexOffset + indexBase + 2u);
        bool hasA = i0 == edgeA || i1 == edgeA || i2 == edgeA;
        bool hasB = i0 == edgeB || i1 == edgeB || i2 == edgeB;
        if (!hasA || !hasB)
            continue;

        bool normalValid;
        vec3 normal = TriangleUnitNormal(LoadPosition(i0), LoadPosition(i1), LoadPosition(i2), normalValid);
        if (normalValid)
            pseudonormal += normal;
    }

    return pseudonormal;
}

vec3 ResolveClosestFeaturePseudonormal(uvec3 indices, vec3 barycentric, vec3 faceNormal, out bool valid)
{
    const float featureEpsilon = 1.0e-4;
    vec3 pseudonormal = faceNormal;
    if (barycentric.x <= featureEpsilon && barycentric.y <= featureEpsilon)
        pseudonormal = AccumulateVertexPseudonormal(indices.z);
    else if (barycentric.x <= featureEpsilon && barycentric.z <= featureEpsilon)
        pseudonormal = AccumulateVertexPseudonormal(indices.y);
    else if (barycentric.y <= featureEpsilon && barycentric.z <= featureEpsilon)
        pseudonormal = AccumulateVertexPseudonormal(indices.x);
    else if (barycentric.x <= featureEpsilon)
        pseudonormal = AccumulateEdgePseudonormal(indices.y, indices.z);
    else if (barycentric.y <= featureEpsilon)
        pseudonormal = AccumulateEdgePseudonormal(indices.x, indices.z);
    else if (barycentric.z <= featureEpsilon)
        pseudonormal = AccumulateEdgePseudonormal(indices.x, indices.y);

    float length2 = dot(pseudonormal, pseudonormal);
    valid = length2 > 1.0e-12;
    return valid ? pseudonormal * inversesqrt(length2) : vec3(0.0);
}

void main()
{
    uvec3 voxel = gl_GlobalInvocationID.xyz;
    ivec3 imageSize = imageSize(BindlessStorageImages[pc.Push.StorageImageIndex]);
    if (voxel.x >= uint(imageSize.x) || voxel.y >= uint(imageSize.y) || voxel.z >= uint(imageSize.z))
        return;

    vec3 uv = (vec3(voxel) + vec3(0.5)) / max(vec3(imageSize), vec3(1.0));
    vec3 p = pc.Push.LocalBoundsMinAndVoxelSize.xyz + uv * pc.Push.LocalBoundsExtentAndInvVoxelSize.xyz;

    float closestDistance2 = 3.402823466e+38;
    vec3 closestPoint = p;
    vec3 closestBarycentric = vec3(1.0, 0.0, 0.0);
    vec3 closestFaceNormal = vec3(0.0);
    uvec3 closestIndices = uvec3(0u);
    bool hasClosestTriangle = false;

    for (uint tri = 0u; tri < pc.Push.TriangleCount; tri++)
    {
        uint indexBase = tri * 3u;
        uint i0 = LoadIndex(pc.Push.IndexOffset + indexBase + 0u);
        uint i1 = LoadIndex(pc.Push.IndexOffset + indexBase + 1u);
        uint i2 = LoadIndex(pc.Push.IndexOffset + indexBase + 2u);

        vec3 a = LoadPosition(i0);
        vec3 b = LoadPosition(i1);
        vec3 c = LoadPosition(i2);
        vec3 barycentric;
        vec3 closest = ClosestPointOnTriangle(p, a, b, c, barycentric);
        vec3 delta = p - closest;
        float distance2 = dot(delta, delta);
        if (distance2 < closestDistance2)
        {
            bool normalValid;
            vec3 normal = TriangleUnitNormal(a, b, c, normalValid);
            if (!normalValid)
                continue;

            closestDistance2 = distance2;
            closestPoint = closest;
            closestBarycentric = barycentric;
            closestFaceNormal = normal;
            closestIndices = uvec3(i0, i1, i2);
            hasClosestTriangle = true;
        }
    }

    float unsignedDistance = sqrt(max(hasClosestTriangle ? closestDistance2 : 0.0, 0.0));
    bool unsignedFallback = (pc.Push.Flags & MESH_SDF_FLAG_UNSIGNED_FALLBACK) != 0u || !hasClosestTriangle;
    float signValue = 1.0;
    if (!unsignedFallback)
    {
        bool pseudonormalValid;
        vec3 pseudonormal = ResolveClosestFeaturePseudonormal(closestIndices, closestBarycentric, closestFaceNormal, pseudonormalValid);
        if (pseudonormalValid)
            signValue = dot(p - closestPoint, pseudonormal) < 0.0 ? -1.0 : 1.0;
        else
            unsignedFallback = true;
    }

    float signedDistance = unsignedFallback
        ? unsignedDistance - pc.Push.LocalBoundsMinAndVoxelSize.w * 0.5
        : signValue * unsignedDistance;
    float normalizedDistance = EncodeSdfDistance(signedDistance, pc.Push.LocalBoundsMinAndVoxelSize.w);
    imageStore(BindlessStorageImages[pc.Push.StorageImageIndex], ivec3(voxel), vec4(normalizedDistance, 0.0, 0.0, 0.0));
}
