#version 460
#extension GL_GOOGLE_include_directive : require

#include "ddgi_near_field_residual.glsl"

// Temporal C5 receives only its own signed candidate/history payload plus
// geometry identity.  It never reads a final colour target, DDGI field, C4
// cache, or another indirect-lighting result.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D rawCandidateInput;
layout(std430, set = 0, binding = 1) readonly buffer CurrentMetadataBuffer
{
    SimpleDdgiNearFieldResidualHitMetadata values[];
} currentMetadata;
layout(set = 0, binding = 2) uniform sampler2D historyRadianceInput;
layout(set = 0, binding = 3) uniform sampler2D historyMomentsInput;
layout(set = 0, binding = 4) uniform usampler2D historyValidityInput;
layout(std430, set = 0, binding = 5) readonly buffer HistoryMetadataBuffer
{
    SimpleDdgiNearFieldResidualHitMetadata values[];
} historyMetadata;
layout(rgba16f, set = 0, binding = 6) uniform writeonly image2D temporalRadianceOutput;
layout(rg16f, set = 0, binding = 7) uniform writeonly image2D temporalMomentsOutput;
layout(r16ui, set = 0, binding = 8) uniform writeonly uimage2D temporalValidityOutput;
layout(std430, set = 0, binding = 9) buffer TemporalMetadataOutputBuffer
{
    SimpleDdgiNearFieldResidualHitMetadata values[];
} temporalMetadataOutput;
layout(set = 0, binding = 10) uniform sampler2D motionVectors;
layout(set = 0, binding = 11) uniform usampler2D currentReceiverPayload;
layout(set = 0, binding = 12) uniform usampler2D historyReceiverNormals;
layout(r32ui, set = 0, binding = 13) uniform writeonly uimage2D temporalHistoryNormalOutput;
layout(std430, set = 0, binding = 14) buffer TemporalTileRecordsBuffer
{
    uint words[];
} temporalTileRecords;
layout(std430, set = 0, binding = 15) readonly buffer TemporalActiveTileBuffer
{
    uint words[];
} temporalActiveTiles;
layout(set = 0, binding = 16) uniform sampler2D currentSourceRadiance;
layout(set = 0, binding = 17) uniform sampler2D currentFullDepth;
layout(set = 0, binding = 18) uniform usampler2D currentFullPayload;
layout(std430, set = 0, binding = 19) readonly buffer TemporalFrameConstantsBuffer
{
    SimpleDdgiNearFieldResidualTraceFrameConstants frame;
} temporalFrameConstants;
layout(std430, set = 0, binding = 20) readonly buffer TemporalSurfaceTableBuffer
{
    SimpleDdgiNearFieldSurfaceEntry values[];
} temporalSurfaceTable;
layout(set = 0, binding = 21) uniform sampler2D currentPreparedDepthFootprint;
layout(std430, set = 0, binding = 22) buffer TemporalSchedulerHistoryBuffer
{
    SimpleDdgiNearFieldResidualSchedulerRecord values[];
} temporalSchedulerHistory;

layout(push_constant) uniform NearFieldTemporalPushBlock
{
    SimpleDdgiNearFieldResidualTemporalPushConstants pc;
};

const uint C5_HISTORY_REASON_INVALID_CURRENT = 1u << 0u;
const uint C5_HISTORY_REASON_EPOCH = 1u << 1u;
const uint C5_HISTORY_REASON_IDENTITY = 1u << 2u;
const uint C5_HISTORY_REASON_REPROJECTION = 1u << 3u;
const uint C5_HISTORY_REASON_DEPTH = 1u << 4u;
const uint C5_HISTORY_REASON_NORMAL = 1u << 5u;
const uint C5_HISTORY_REASON_SOURCE_REVISION = 1u << 6u;
const uint C5_HISTORY_REASON_VARIANCE_CLIPPED = 1u << 7u;
const uint C5_HISTORY_REASON_NONFINITE = 1u << 8u;
const uint C5_HISTORY_REASON_RECEIVER_REVISION = 1u << 9u;
const uint C5_HISTORY_REASON_HIT_IDENTITY = 1u << 10u;
const uint C5_HISTORY_REASON_HIT_REVISION = 1u << 11u;
const uint C5_HISTORY_REASON_SOURCE_REACTIVE = 1u << 12u;

uint C5DominantHistoryRejection(uint reasons)
{
    if ((reasons & C5_HISTORY_REASON_INVALID_CURRENT) != 0u) return 13u;
    if ((reasons & C5_HISTORY_REASON_NONFINITE) != 0u) return 11u;
    if ((reasons & C5_HISTORY_REASON_EPOCH) != 0u) return 1u;
    if ((reasons & C5_HISTORY_REASON_IDENTITY) != 0u) return 2u;
    if ((reasons & C5_HISTORY_REASON_RECEIVER_REVISION) != 0u) return 3u;
    if ((reasons & C5_HISTORY_REASON_HIT_IDENTITY) != 0u) return 4u;
    if ((reasons & C5_HISTORY_REASON_HIT_REVISION) != 0u) return 5u;
    if ((reasons & C5_HISTORY_REASON_REPROJECTION) != 0u) return 6u;
    if ((reasons & C5_HISTORY_REASON_DEPTH) != 0u) return 7u;
    if ((reasons & C5_HISTORY_REASON_NORMAL) != 0u) return 8u;
    if ((reasons & C5_HISTORY_REASON_SOURCE_REVISION) != 0u) return 9u;
    if ((reasons & C5_HISTORY_REASON_VARIANCE_CLIPPED) != 0u) return 10u;
    if ((reasons & C5_HISTORY_REASON_SOURCE_REACTIVE) != 0u) return 12u;
    return 0u;
}

shared uint c5HistoryCovered[64];
shared uint c5HistoryCandidate[64];
shared uint c5HistoryAccepted[64];
shared uint c5HistoryReasonFlags[64];
shared float c5HistoryVariance[64];
shared float c5HistorySignedEnergy[64];
shared float c5HistoryAbsoluteEnergy[64];
shared float c5HistorySquaredEnergy[64];
shared uint c5HistoryEnergyFinite[64];
shared float c5HistoryConfidence[64];

void WriteInvalid(ivec2 pixel, uint outputIndex)
{
    imageStore(temporalRadianceOutput, pixel, vec4(0.0));
    imageStore(temporalMomentsOutput, pixel, vec4(0.0));
    imageStore(temporalValidityOutput, pixel, uvec4(0u));
    imageStore(temporalHistoryNormalOutput, pixel, uvec4(0u));
    if (outputIndex < uint(temporalMetadataOutput.values.length()))
        temporalMetadataOutput.values[outputIndex] = SimpleDdgiNearFieldZeroMetadata();
}

bool IsReusableHistory(
    SimpleDdgiNearFieldResidualHitMetadata current,
    SimpleDdgiNearFieldResidualHitMetadata previous,
    vec4 currentPackedNormals,
    vec4 previousPackedNormals,
    uint previousValidity,
    out uint previousHistoryLength,
    out uint rejectionFlags)
{
    previousHistoryLength = 0u;
    rejectionFlags = 0u;
    if (!SimpleDdgiNearFieldUnpackHistoryValidity(
            previousValidity, pc.historyEpoch, previousHistoryLength) ||
        !SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_HISTORY_INPUT_VALID) ||
        !SimpleDdgiNearFieldHasFlag(
            SimpleDdgiNearFieldMetadataFlags(previous),
            SIMPLE_DDGI_NEAR_FIELD_FLAG_VALID_CANDIDATE))
    {
        rejectionFlags |= C5_HISTORY_REASON_EPOCH;
    }
    if (!SimpleDdgiNearFieldFinite(current.receiverLinearDepth) ||
        !SimpleDdgiNearFieldFinite(previous.receiverLinearDepth))
    {
        rejectionFlags |= C5_HISTORY_REASON_NONFINITE;
    }
    if (any(notEqual(
            current.receiverIdentity,
            previous.receiverIdentity)))
    {
        rejectionFlags |= C5_HISTORY_REASON_IDENTITY;
    }
    if (current.packedReceiverRevisions != previous.packedReceiverRevisions)
        rejectionFlags |= C5_HISTORY_REASON_RECEIVER_REVISION;
    // Receiver motion vectors establish the previous sample location. Do not
    // compare view-space depths across camera/object motion directly: the same
    // receiver may legitimately change depth. Identity, both normals and the
    // current candidate validate the receiver at the reprojected location.
    float currentFootprint = SimpleDdgiNearFieldReceiverFootprint(current);
    float previousFootprint = SimpleDdgiNearFieldReceiverFootprint(previous);
    float footprintScale = max(max(currentFootprint, previousFootprint), 1.0e-4);
    if (!SimpleDdgiNearFieldFinite(currentFootprint) ||
        !SimpleDdgiNearFieldFinite(previousFootprint) ||
        abs(currentFootprint - previousFootprint) > footprintScale * 0.25)
    {
        rejectionFlags |= C5_HISTORY_REASON_SOURCE_REVISION;
    }
    // Each frame launches a new stochastic ray. Its current hit need not equal
    // the previous sample's hit; that prior hit is reprojected and validated
    // against current depth, payload, normal, revisions and source below.

    vec3 currentGeometric = SimpleDdgiNearFieldDecodeOctNormal(
        currentPackedNormals.xy);
    vec3 currentShading = SimpleDdgiNearFieldDecodeOctNormal(
        currentPackedNormals.zw);
    vec3 previousGeometric = SimpleDdgiNearFieldDecodeOctNormal(
        previousPackedNormals.xy);
    vec3 previousShading = SimpleDdgiNearFieldDecodeOctNormal(
        previousPackedNormals.zw);
    if (dot(currentGeometric, currentGeometric) <= 0.0 ||
        dot(currentShading, currentShading) <= 0.0 ||
        dot(previousGeometric, previousGeometric) <= 0.0 ||
        dot(previousShading, previousShading) <= 0.0)
    {
        rejectionFlags |= C5_HISTORY_REASON_NORMAL;
    }
    else if (dot(currentGeometric, previousGeometric) < pc.minimumNormalDot ||
        dot(currentShading, previousShading) < pc.minimumNormalDot)
    {
        rejectionFlags |= C5_HISTORY_REASON_NORMAL;
    }
    return rejectionFlags == 0u;
}

vec4 C5TemporalMulRowMajor(vec4 value, mat4 matrix)
{
    return vec4(
        dot(value, vec4(matrix[0][0], matrix[1][0], matrix[2][0], matrix[3][0])),
        dot(value, vec4(matrix[0][1], matrix[1][1], matrix[2][1], matrix[3][1])),
        dot(value, vec4(matrix[0][2], matrix[1][2], matrix[2][2], matrix[3][2])),
        dot(value, vec4(matrix[0][3], matrix[1][3], matrix[2][3], matrix[3][3])));
}

bool C5TemporalFinite(vec4 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

float C5TemporalStoredDepthFromLinear(float linearDepth)
{
    float nearPlane = max(
        temporalFrameConstants.frame.clipAndSequence.x, 0.001);
    float farPlane = max(
        temporalFrameConstants.frame.clipAndSequence.y,
        nearPlane + 0.01);
    float reciprocalTerm = nearPlane * farPlane /
        max(linearDepth, nearPlane);
    bool reversedZ = SimpleDdgiNearFieldHasFlag(
        pc.flags, SIMPLE_DDGI_NEAR_FIELD_FLAG_REVERSED_Z);
    return reversedZ
        ? (reciprocalTerm - nearPlane) / (farPlane - nearPlane)
        : (farPlane - reciprocalTerm) / (farPlane - nearPlane);
}

float C5TemporalPositiveLinearDepth(float storedDepth)
{
    float nearPlane = max(
        temporalFrameConstants.frame.clipAndSequence.x, 0.001);
    float farPlane = max(
        temporalFrameConstants.frame.clipAndSequence.y,
        nearPlane + 0.01);
    bool reversedZ = SimpleDdgiNearFieldHasFlag(
        pc.flags, SIMPLE_DDGI_NEAR_FIELD_FLAG_REVERSED_Z);
    float denominator = reversedZ
        ? nearPlane + storedDepth * (farPlane - nearPlane)
        : farPlane - storedDepth * (farPlane - nearPlane);
    return nearPlane * farPlane / max(denominator, 1.0e-7);
}

bool C5ResolvePreviousUv(
    vec2 outputUv,
    out vec2 previousUv,
    out bool nonFinite)
{
    previousUv = vec2(-1.0);
    nonFinite = false;
    if (!SimpleDdgiNearFieldHasFlag(
            pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_CAMERA_ONLY_REPROJECTION))
    {
        vec2 motion = textureLod(motionVectors, outputUv, 0.0).xy;
        nonFinite = !SimpleDdgiNearFieldFinite(motion.x) ||
            !SimpleDdgiNearFieldFinite(motion.y);
        if (nonFinite)
            return false;
        previousUv = outputUv - motion;
        return all(greaterThanEqual(previousUv, vec2(0.0))) &&
            all(lessThan(previousUv, vec2(1.0)));
    }

    ivec2 fullExtent = textureSize(currentFullDepth, 0);
    if (fullExtent.x <= 0 || fullExtent.y <= 0)
        return false;
    ivec2 fullPixel = clamp(
        ivec2(outputUv * vec2(fullExtent)),
        ivec2(0),
        fullExtent - ivec2(1));
    float storedDepth = texelFetch(currentFullDepth, fullPixel, 0).r;
    if (!SimpleDdgiNearFieldFinite(storedDepth))
    {
        nonFinite = true;
        return false;
    }
    if (storedDepth < 0.0 || storedDepth > 1.0)
        return false;

    vec4 currentClip = vec4(
        outputUv * 2.0 - vec2(1.0), storedDepth, 1.0);
    vec4 world = C5TemporalMulRowMajor(
        currentClip,
        temporalFrameConstants.frame.inverseViewProjection);
    if (!C5TemporalFinite(world) || abs(world.w) <= 1.0e-7)
    {
        nonFinite = !C5TemporalFinite(world);
        return false;
    }
    world /= world.w;
    vec4 previousClip = C5TemporalMulRowMajor(
        vec4(world.xyz, 1.0),
        temporalFrameConstants.frame.previousViewProjection);
    if (!C5TemporalFinite(previousClip) || previousClip.w <= 1.0e-7)
    {
        nonFinite = !C5TemporalFinite(previousClip);
        return false;
    }
    vec3 previousNdc = previousClip.xyz / previousClip.w;
    previousUv = previousNdc.xy * 0.5 + vec2(0.5);
    if (!SimpleDdgiNearFieldFinite(previousUv.x) ||
        !SimpleDdgiNearFieldFinite(previousUv.y) ||
        !SimpleDdgiNearFieldFinite(previousNdc.z))
    {
        nonFinite = true;
        return false;
    }
    return previousNdc.z >= 0.0 && previousNdc.z <= 1.0 &&
        all(greaterThanEqual(previousUv, vec2(0.0))) &&
        all(lessThan(previousUv, vec2(1.0)));
}

bool C5TemporalReadSurface(
    uint token,
    out SimpleDdgiNearFieldSurfaceEntry surface)
{
    surface.stableObjectId = 0u;
    surface.stableMaterialId = 0u;
    surface.packedObjectMaterialRevisions = 0u;
    surface.coverageMotionFlags = 0u;
    if (token >= SIMPLE_DDGI_NEAR_FIELD_MAX_SURFACE_TABLE_ENTRIES ||
        token >= uint(temporalSurfaceTable.values.length()))
        return false;
    surface = temporalSurfaceTable.values[token];
    return surface.stableObjectId != 0u &&
        surface.stableMaterialId != 0u &&
        (surface.coverageMotionFlags & (1u << 4u)) != 0u &&
        (surface.coverageMotionFlags & (1u << 5u)) != 0u;
}

bool C5BuildCurrentReceiverMetadata(
    ivec2 pixel,
    vec2 outputUv,
    out SimpleDdgiNearFieldResidualHitMetadata metadata,
    out vec4 packedNormals)
{
    metadata = SimpleDdgiNearFieldZeroMetadata();
    packedNormals = vec4(0.0);
    ivec2 receiverExtent = textureSize(currentReceiverPayload, 0);
    ivec2 depthExtent = textureSize(currentPreparedDepthFootprint, 0);
    if (receiverExtent.x <= 0 || receiverExtent.y <= 0 ||
        any(notEqual(receiverExtent, depthExtent)))
        return false;
    ivec2 receiverPixel = clamp(ivec2(outputUv * vec2(receiverExtent)),
        ivec2(0), max(receiverExtent - ivec2(1), ivec2(0)));
    uint surfaceToken;
    vec3 diffuseBase;
    vec3 dielectricF0;
    SimpleDdgiNearFieldDecodeReceiverPayload(
        texelFetch(currentReceiverPayload, receiverPixel, 0),
        packedNormals,
        surfaceToken,
        diffuseBase,
        dielectricF0);
    vec2 depthFootprint = texelFetch(
        currentPreparedDepthFootprint, receiverPixel, 0).rg;
    SimpleDdgiNearFieldSurfaceEntry surface;
    vec3 geometric = SimpleDdgiNearFieldDecodeOctNormal(packedNormals.xy);
    vec3 shading = SimpleDdgiNearFieldDecodeOctNormal(packedNormals.zw);
    if (!SimpleDdgiNearFieldFinite(depthFootprint.x) ||
        !SimpleDdgiNearFieldFinite(depthFootprint.y) ||
        depthFootprint.x <= 0.0 || depthFootprint.y <= 0.0 ||
        dot(geometric, geometric) <= 0.0 || dot(shading, shading) <= 0.0 ||
        !C5TemporalReadSurface(surfaceToken, surface))
        return false;
    metadata.receiverLinearDepth = depthFootprint.x;
    metadata.hitLinearDepth = depthFootprint.x;
    SimpleDdgiNearFieldSetReceiverFootprint(metadata, depthFootprint.y);
    SimpleDdgiNearFieldSetMetadataFlags(metadata,
        SIMPLE_DDGI_NEAR_FIELD_FLAG_VALID_CANDIDATE |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_SOURCE_ATTACHMENT_VERIFIED |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_INVALID_AND_MISS_ZEROED);
    metadata.receiverIdentity = uvec2(
        surface.stableObjectId, surface.stableMaterialId);
    metadata.packedReceiverRevisions =
        surface.packedObjectMaterialRevisions;
    metadata.packedHitUv = packHalf2x16(outputUv);
    return true;
}

bool C5ValidatePreviousHitInCurrentFrame(
    SimpleDdgiNearFieldResidualHitMetadata previous,
    out float sourceReactiveWeight,
    out uint rejectionFlags)
{
    sourceReactiveWeight = 1.0;
    rejectionFlags = 0u;
    uint previousFlags = SimpleDdgiNearFieldMetadataFlags(previous);
    if (!SimpleDdgiNearFieldHasFlag(previousFlags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_SCREEN_SPACE_HIT))
    {
        if (all(equal(previous.hitIdentity, uvec2(0u))))
            return true;
        rejectionFlags |= C5_HISTORY_REASON_HIT_IDENTITY;
        return false;
    }

    vec2 previousHitUv = SimpleDdgiNearFieldHitUv(previous);
    if (!SimpleDdgiNearFieldFinite(previousHitUv.x) ||
        !SimpleDdgiNearFieldFinite(previousHitUv.y) ||
        !SimpleDdgiNearFieldFinite(previous.hitLinearDepth) ||
        previous.hitLinearDepth <= 0.0 ||
        any(lessThan(previousHitUv, vec2(0.0))) ||
        any(greaterThanEqual(previousHitUv, vec2(1.0))))
    {
        rejectionFlags |= C5_HISTORY_REASON_REPROJECTION |
            C5_HISTORY_REASON_NONFINITE;
        return false;
    }

    float previousStoredDepth = C5TemporalStoredDepthFromLinear(
        previous.hitLinearDepth);
    vec4 previousClip = vec4(
        previousHitUv * 2.0 - vec2(1.0), previousStoredDepth, 1.0);
    vec4 previousWorld = C5TemporalMulRowMajor(
        previousClip,
        temporalFrameConstants.frame.previousInverseViewProjection);
    if (!C5TemporalFinite(previousWorld) || abs(previousWorld.w) <= 1.0e-7)
    {
        rejectionFlags |= C5_HISTORY_REASON_REPROJECTION |
            C5_HISTORY_REASON_NONFINITE;
        return false;
    }
    previousWorld /= previousWorld.w;
    vec4 currentClip = C5TemporalMulRowMajor(
        vec4(previousWorld.xyz, 1.0),
        temporalFrameConstants.frame.viewProjection);
    if (!C5TemporalFinite(currentClip) || currentClip.w <= 1.0e-7)
    {
        rejectionFlags |= C5_HISTORY_REASON_REPROJECTION;
        return false;
    }
    vec3 currentNdc = currentClip.xyz / currentClip.w;
    vec2 currentUv = currentNdc.xy * 0.5 + vec2(0.5);
    if (!SimpleDdgiNearFieldFinite(currentUv.x) ||
        !SimpleDdgiNearFieldFinite(currentUv.y) ||
        any(lessThan(currentUv, vec2(0.0))) ||
        any(greaterThanEqual(currentUv, vec2(1.0))) ||
        currentNdc.z < 0.0 || currentNdc.z > 1.0)
    {
        rejectionFlags |= C5_HISTORY_REASON_REPROJECTION;
        return false;
    }

    ivec2 fullExtent = textureSize(currentFullDepth, 0);
    if (fullExtent.x <= 0 || fullExtent.y <= 0 ||
        any(notEqual(textureSize(currentFullPayload, 0), fullExtent)) ||
        any(notEqual(textureSize(currentSourceRadiance, 0), fullExtent)))
    {
        rejectionFlags |= C5_HISTORY_REASON_REPROJECTION;
        return false;
    }
    ivec2 hitPixel = clamp(
        ivec2(currentUv * vec2(fullExtent)),
        ivec2(0),
        fullExtent - ivec2(1));
    float expectedDepth = C5TemporalPositiveLinearDepth(currentNdc.z);
    float sceneDepth = C5TemporalPositiveLinearDepth(
        texelFetch(currentFullDepth, hitPixel, 0).r);
    float depthTolerance = max(
        max(pc.depthTolerance, 0.02), expectedDepth * 0.002);
    if (!SimpleDdgiNearFieldFinite(expectedDepth) ||
        !SimpleDdgiNearFieldFinite(sceneDepth) ||
        abs(expectedDepth - sceneDepth) > depthTolerance)
    {
        rejectionFlags |= C5_HISTORY_REASON_DEPTH;
        return false;
    }

    vec4 currentPackedNormals;
    uint currentToken;
    vec3 ignoredDiffuse;
    vec3 ignoredF0;
    SimpleDdgiNearFieldDecodeReceiverPayload(
        texelFetch(currentFullPayload, hitPixel, 0),
        currentPackedNormals,
        currentToken,
        ignoredDiffuse,
        ignoredF0);
    SimpleDdgiNearFieldSurfaceEntry currentSurface;
    if (!C5TemporalReadSurface(currentToken, currentSurface) ||
        any(notEqual(previous.hitIdentity, uvec2(
            currentSurface.stableObjectId,
            currentSurface.stableMaterialId))))
    {
        rejectionFlags |= C5_HISTORY_REASON_HIT_IDENTITY;
        return false;
    }
    if (previous.packedHitRevisions !=
        currentSurface.packedObjectMaterialRevisions)
    {
        rejectionFlags |= C5_HISTORY_REASON_HIT_REVISION;
        return false;
    }

    vec3 previousHitNormal = SimpleDdgiNearFieldDecodeOctNormal(
        unpackSnorm2x16(previous.packedHitNormal));
    vec3 currentHitNormal = SimpleDdgiNearFieldDecodeOctNormal(
        currentPackedNormals.xy);
    if (dot(previousHitNormal, previousHitNormal) <= 0.0 ||
        dot(currentHitNormal, currentHitNormal) <= 0.0 ||
        dot(previousHitNormal, currentHitNormal) < pc.minimumNormalDot)
    {
        rejectionFlags |= C5_HISTORY_REASON_NORMAL;
        return false;
    }

    // Source radiance is content-reactive rather than a global history
    // invalidator. Avoid treating ordinary quantization/noise as a lighting
    // edit when the source epoch still names the history bank's cohort.
    if (!SimpleDdgiNearFieldHasFlag(
            pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_SOURCE_LIGHTING_EPOCH_CHANGED))
    {
        return true;
    }

    vec4 currentSource = texelFetch(currentSourceRadiance, hitPixel, 0);
    vec3 previousSource = NjulfC5UnpackRgb9E5(
        previous.packedHitSourceRadiance);
    if (!C5TemporalFinite(currentSource) ||
        currentSource.a <= 0.0 ||
        !SimpleDdgiNearFieldFinite(previousSource))
    {
        rejectionFlags |= C5_HISTORY_REASON_SOURCE_REVISION |
            C5_HISTORY_REASON_NONFINITE;
        return false;
    }
    float relativeChange = length(
        max(currentSource.rgb, vec3(0.0)) - previousSource) /
        max(length(previousSource), 1.0e-4);
    if (!SimpleDdgiNearFieldFinite(relativeChange) || relativeChange > 0.25)
    {
        rejectionFlags |= C5_HISTORY_REASON_SOURCE_REACTIVE;
        return false;
    }
    sourceReactiveWeight = relativeChange <= 0.05
        ? 1.0
        : clamp((0.25 - relativeChange) / 0.20, 0.0, 1.0);
    return sourceReactiveWeight > 0.0;
}

bool TryGetCurrentNeighbourhoodBounds(
    ivec2 centrePixel,
    ivec2 extent,
    SimpleDdgiNearFieldResidualHitMetadata centre,
    out vec3 minimumResidual,
    out vec3 maximumResidual,
    out float neighbourhoodMean,
    out float neighbourhoodVariance)
{
    minimumResidual = vec3(3.402823466e+38);
    maximumResidual = vec3(-3.402823466e+38);
    float luminanceSum = 0.0;
    float luminanceSquaredSum = 0.0;
    uint sampleCount = 0u;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 neighbourPixel = centrePixel + ivec2(x, y);
            if (any(lessThan(neighbourPixel, ivec2(0))) ||
                any(greaterThanEqual(neighbourPixel, extent)))
            {
                continue;
            }
            uint neighbourIndex = uint(neighbourPixel.y) * uint(extent.x) +
                uint(neighbourPixel.x);
            if (neighbourIndex >= uint(currentMetadata.values.length()))
                continue;
            vec4 neighbour = texelFetch(rawCandidateInput, neighbourPixel, 0);
            SimpleDdgiNearFieldResidualHitMetadata neighbourMetadata =
                currentMetadata.values[neighbourIndex];
            if (!SimpleDdgiNearFieldIsValidCandidate(neighbour) ||
                !SimpleDdgiNearFieldHasFlag(
                    SimpleDdgiNearFieldMetadataFlags(neighbourMetadata),
                    SIMPLE_DDGI_NEAR_FIELD_FLAG_VALID_CANDIDATE) ||
                any(notEqual(
                    neighbourMetadata.receiverIdentity,
                    centre.receiverIdentity)))
            {
                continue;
            }

            minimumResidual = min(minimumResidual, neighbour.rgb);
            maximumResidual = max(maximumResidual, neighbour.rgb);
            float luminance = dot(neighbour.rgb,
                vec3(0.2126, 0.7152, 0.0722));
            luminanceSum += luminance;
            luminanceSquaredSum += luminance * luminance;
            sampleCount++;
        }
    }

    if (sampleCount == 0u)
    {
        neighbourhoodMean = 0.0;
        neighbourhoodVariance = 0.0;
        return false;
    }
    float reciprocalCount = 1.0 / float(sampleCount);
    neighbourhoodMean = luminanceSum * reciprocalCount;
    neighbourhoodVariance = max(
        luminanceSquaredSum * reciprocalCount -
            neighbourhoodMean * neighbourhoodMean,
        0.0);
    return SimpleDdgiNearFieldFinite(minimumResidual) &&
        SimpleDdgiNearFieldFinite(maximumResidual) &&
        SimpleDdgiNearFieldFinite(neighbourhoodMean) &&
        SimpleDdgiNearFieldFinite(neighbourhoodVariance);
}

bool EvaluateTemporalPixel(
    ivec2 pixel,
    ivec2 outputExtent,
    uint outputIndex,
    out vec4 outputResidual,
    out vec2 outputMoments,
    out uint outputValidity,
    out vec4 outputPackedNormals,
    out SimpleDdgiNearFieldResidualHitMetadata outputMetadata,
    out bool historyCandidate,
    out bool acceptedHistory,
    out uint historyReasonFlags,
    out float outputVariance)
{
    outputResidual = vec4(0.0);
    outputMoments = vec2(0.0);
    outputValidity = 0u;
    outputPackedNormals = vec4(0.0);
    outputMetadata = SimpleDdgiNearFieldZeroMetadata();
    historyCandidate = false;
    acceptedHistory = false;
    historyReasonFlags = C5_HISTORY_REASON_INVALID_CURRENT;
    outputVariance = 0.0;

    if (pc.abiVersion != SIMPLE_DDGI_NEAR_FIELD_RESIDUAL_ABI_VERSION ||
        pc.historyReadIndex > 1u || pc.historyWriteIndex > 1u ||
        pc.historyReadIndex == pc.historyWriteIndex || pc.historyEpoch == 0u ||
        pc.traceSourceAbiRevision == 0u || pc.viewportRevision == 0u ||
        pc.hizRevision == 0u || pc.effectiveModeRevision == 0u ||
        pc.exposureDomainRevision == 0u ||
        pc.structuralProjectionRevision == 0u ||
        pc.originRebaseRevision == 0u || pc.sceneGeneration == 0u ||
        pc.traceSourceContentRevision == 0u || pc.nearFieldLayoutRevision == 0u ||
        pc.b3OwnershipRevision == 0u || pc.traceSourceLayoutRevision == 0u ||
        pc.maximumHistoryLength == 0u ||
        pc.maximumHistoryLength > SIMPLE_DDGI_NEAR_FIELD_MAX_HISTORY_LENGTH ||
        !SimpleDdgiNearFieldFinite(pc.temporalBlend) ||
        !SimpleDdgiNearFieldFinite(pc.depthTolerance) ||
        !SimpleDdgiNearFieldFinite(pc.minimumNormalDot) ||
        !SimpleDdgiNearFieldFinite(pc.hitUvTolerance) ||
        pc.depthTolerance < 0.0 || pc.hitUvTolerance < 0.0 ||
        pc.minimumNormalDot < -1.0 || pc.minimumNormalDot > 1.0 ||
        outputIndex >= uint(currentMetadata.values.length()) ||
        outputIndex >= uint(temporalMetadataOutput.values.length()))
    {
        return false;
    }

    vec2 outputUv = (vec2(pixel) + vec2(0.5)) /
        max(vec2(outputExtent), vec2(1.0));
    vec4 candidate = texelFetch(rawCandidateInput, pixel, 0);
    SimpleDdgiNearFieldResidualHitMetadata current =
        currentMetadata.values[outputIndex];
    bool hasCurrentSample = SimpleDdgiNearFieldIsValidCandidate(candidate) &&
        SimpleDdgiNearFieldHasFlag(
            SimpleDdgiNearFieldMetadataFlags(current),
            SIMPLE_DDGI_NEAR_FIELD_FLAG_VALID_CANDIDATE) &&
        SimpleDdgiNearFieldFinite(candidate.a) && candidate.a > 0.0;
    bool adaptive = SimpleDdgiNearFieldHasFlag(pc.flags,
        SIMPLE_DDGI_NEAR_FIELD_FLAG_LOCAL_ADAPTIVE_SCHEDULING);
    SimpleDdgiNearFieldResidualHitMetadata reconstructedCurrent;
    if (!C5BuildCurrentReceiverMetadata(pixel, outputUv,
            reconstructedCurrent, outputPackedNormals))
        return false;
    if (!hasCurrentSample)
    {
        if (!adaptive)
            return false;
        current = reconstructedCurrent;
    }

    historyCandidate = true;
    historyReasonFlags = 0u;
    float candidateLuminance = 0.0;
    uint outputHistoryLength = hasCurrentSample ? 1u : 0u;
    if (hasCurrentSample)
    {
        outputResidual = candidate;
        candidateLuminance = dot(candidate.rgb,
            vec3(0.2126, 0.7152, 0.0722));
        if (!SimpleDdgiNearFieldFinite(candidateLuminance))
        {
            historyReasonFlags = C5_HISTORY_REASON_INVALID_CURRENT |
                C5_HISTORY_REASON_NONFINITE;
            return false;
        }
        outputMoments = vec2(candidateLuminance,
            candidateLuminance * candidateLuminance);
    }

    vec2 previousUv;
    bool nonFiniteReprojection;
    bool insidePrevious = C5ResolvePreviousUv(
        outputUv, previousUv, nonFiniteReprojection);
    if (!insidePrevious)
        historyReasonFlags |= C5_HISTORY_REASON_REPROJECTION;
    if (nonFiniteReprojection)
        historyReasonFlags |= C5_HISTORY_REASON_NONFINITE;
    if (!SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_HISTORY_INPUT_VALID))
    {
        historyReasonFlags |= C5_HISTORY_REASON_EPOCH;
    }

    if (insidePrevious &&
        SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_HISTORY_INPUT_VALID))
    {
        // History is packed with the active execution stride inside images
        // allocated for the maximum admitted scale. A layout-revision change
        // invalidates history before a different active extent is selected.
        ivec2 historyExtent = min(
            ivec2(pc.traceWidth, pc.traceHeight),
            textureSize(historyRadianceInput, 0));
        // Gather four bilinear taps. Each tap is validated independently and
        // only surviving weights are renormalized; a rejected edge tap cannot
        // poison an otherwise valid same-surface history sample.
        vec2 historyPosition = previousUv * vec2(historyExtent) - vec2(0.5);
        ivec2 historyBase = ivec2(floor(historyPosition));
        vec2 historyFraction = fract(historyPosition);
        vec4 accumulatedResidual = vec4(0.0);
        vec2 accumulatedMoments = vec2(0.0);
        float accumulatedHistoryLength = 0.0;
        float acceptedBilinearWeight = 0.0;
        float reactiveBilinearWeight = 0.0;
        float representativeHistoryWeight = -1.0;
        SimpleDdgiNearFieldResidualHitMetadata representativeHistory =
            SimpleDdgiNearFieldZeroMetadata();
        for (int tapY = 0; tapY < 2; ++tapY)
        {
            for (int tapX = 0; tapX < 2; ++tapX)
            {
                ivec2 previousPixel = historyBase + ivec2(tapX, tapY);
                float bilinearWeight =
                    (tapX == 0 ? 1.0 - historyFraction.x : historyFraction.x) *
                    (tapY == 0 ? 1.0 - historyFraction.y : historyFraction.y);
                if (bilinearWeight <= 0.0)
                    continue;
                if (any(lessThan(previousPixel, ivec2(0))) ||
                    any(greaterThanEqual(previousPixel, historyExtent)))
                {
                    historyReasonFlags |= C5_HISTORY_REASON_REPROJECTION;
                    continue;
                }
                uint previousIndex = uint(previousPixel.y) *
                    uint(historyExtent.x) + uint(previousPixel.x);
                if (previousIndex >= uint(historyMetadata.values.length()))
                {
                    historyReasonFlags |= C5_HISTORY_REASON_REPROJECTION;
                    continue;
                }

                vec4 previousResidual = texelFetch(
                    historyRadianceInput, previousPixel, 0);
                vec2 previousMoments = texelFetch(
                    historyMomentsInput, previousPixel, 0).rg;
                uint previousValidity = texelFetch(
                    historyValidityInput, previousPixel, 0).r;
                SimpleDdgiNearFieldResidualHitMetadata previous =
                    historyMetadata.values[previousIndex];
                vec4 previousPackedNormals = unpackSnorm4x8(texelFetch(
                    historyReceiverNormals, previousPixel, 0).r);
                bool previousPayloadValid =
                    SimpleDdgiNearFieldIsValidCandidate(previousResidual) &&
                    SimpleDdgiNearFieldFinite(previousMoments.x) &&
                    SimpleDdgiNearFieldFinite(previousMoments.y) &&
                    previousMoments.y >=
                        previousMoments.x * previousMoments.x;
                if (!previousPayloadValid)
                {
                    historyReasonFlags |= C5_HISTORY_REASON_EPOCH;
                    if (!SimpleDdgiNearFieldFinite(previousMoments.x) ||
                        !SimpleDdgiNearFieldFinite(previousMoments.y))
                    {
                        historyReasonFlags |= C5_HISTORY_REASON_NONFINITE;
                    }
                    continue;
                }

                uint previousHistoryLength;
                uint reuseRejections;
                if (!IsReusableHistory(
                        current,
                        previous,
                        outputPackedNormals,
                        previousPackedNormals,
                        previousValidity,
                        previousHistoryLength,
                        reuseRejections))
                {
                    historyReasonFlags |= reuseRejections;
                    continue;
                }
                float sourceReactiveWeight;
                uint hitRejections;
                if (!C5ValidatePreviousHitInCurrentFrame(
                        previous,
                        sourceReactiveWeight,
                        hitRejections))
                {
                    historyReasonFlags |= hitRejections != 0u
                        ? hitRejections
                        : C5_HISTORY_REASON_SOURCE_REVISION;
                    continue;
                }
                if (sourceReactiveWeight < 1.0)
                    historyReasonFlags |= C5_HISTORY_REASON_SOURCE_REACTIVE;

                float reactiveWeight = bilinearWeight *
                    sourceReactiveWeight;
                acceptedBilinearWeight += bilinearWeight;
                reactiveBilinearWeight += reactiveWeight;
                accumulatedResidual += previousResidual * reactiveWeight;
                accumulatedMoments += previousMoments * reactiveWeight;
                accumulatedHistoryLength +=
                    float(previousHistoryLength) * reactiveWeight;
                if (reactiveWeight > representativeHistoryWeight)
                {
                    representativeHistoryWeight = reactiveWeight;
                    representativeHistory = previous;
                }
            }
        }

        if (reactiveBilinearWeight > 1.0e-6)
        {
            vec4 previousResidual = accumulatedResidual /
                reactiveBilinearWeight;
            vec2 previousMoments = accumulatedMoments /
                reactiveBilinearWeight;
            uint previousHistoryLength = uint(clamp(round(
                accumulatedHistoryLength / reactiveBilinearWeight),
                1.0, float(SIMPLE_DDGI_NEAR_FIELD_MAX_HISTORY_LENGTH)));
            float sourceReactiveAuthority = clamp(
                reactiveBilinearWeight /
                    max(acceptedBilinearWeight, 1.0e-6),
                0.0, 1.0);
            vec3 neighbourhoodMinimum;
            vec3 neighbourhoodMaximum;
            float neighbourhoodMean;
            float neighbourhoodVariance;
            bool hasNeighbourhood = TryGetCurrentNeighbourhoodBounds(
                pixel,
                outputExtent,
                current,
                neighbourhoodMinimum,
                neighbourhoodMaximum,
                neighbourhoodMean,
                neighbourhoodVariance);
            float previousVariance = max(previousMoments.y -
                previousMoments.x * previousMoments.x, 0.0);
            vec3 clippedHistory = previousResidual.rgb;
            if (hasNeighbourhood)
            {
                float sigma = sqrt(max(previousVariance,
                    neighbourhoodVariance));
                vec3 clipExpansion = vec3(1.5 * sigma);
                clippedHistory = clamp(previousResidual.rgb,
                    neighbourhoodMinimum - clipExpansion,
                    neighbourhoodMaximum + clipExpansion);
                if (any(greaterThan(abs(clippedHistory -
                        previousResidual.rgb), vec3(1.0e-6))))
                {
                    historyReasonFlags |= C5_HISTORY_REASON_VARIANCE_CLIPPED;
                }
            }
            else if (hasCurrentSample)
            {
                historyReasonFlags |= C5_HISTORY_REASON_VARIANCE_CLIPPED;
            }

            outputHistoryLength = min(previousHistoryLength + 1u,
                min(pc.maximumHistoryLength,
                    SIMPLE_DDGI_NEAR_FIELD_MAX_HISTORY_LENGTH));
            if (hasCurrentSample)
            {
                if (hasNeighbourhood)
                {
                    float runningHistoryAuthority = float(
                        outputHistoryLength - 1u) /
                        float(outputHistoryLength);
                    float blend = min(clamp(pc.temporalBlend, 0.0, 1.0),
                        runningHistoryAuthority) * sourceReactiveAuthority;
                    outputResidual.rgb = mix(
                        candidate.rgb, clippedHistory, blend);
                    outputResidual.a = mix(
                        candidate.a, previousResidual.a, blend);
                    float sampleWeight = 1.0 /
                        float(outputHistoryLength);
                    outputMoments = mix(previousMoments,
                        vec2(candidateLuminance,
                            candidateLuminance * candidateLuminance),
                        sampleWeight);
                    acceptedHistory = true;
                }
            }
            else
            {
                uint tileCountX = (pc.traceWidth + 7u) / 8u;
                uint tileIndex = uint(pixel.y / 8) * tileCountX +
                    uint(pixel.x / 8);
                uint tileClass = tileIndex <
                        uint(temporalSchedulerHistory.values.length())
                    ? SimpleDdgiNearFieldSchedulerClass(
                        temporalSchedulerHistory.values[tileIndex].packedState)
                    : SIMPLE_DDGI_NEAR_FIELD_TILE_INACTIVE;
                float confidenceDecay = tileClass ==
                        SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY
                    ? 0.96
                    : 0.985;
                float energyDecay = tileClass ==
                        SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY
                    ? 0.985
                    : 0.995;
                outputResidual = vec4(
                    clippedHistory * energyDecay,
                    previousResidual.a * confidenceDecay);
                outputMoments = previousMoments;
                // Carry the exact prior hit identity while replacing receiver
                // fields with the current-frame reconstructed receiver.
                current.hitLinearDepth = representativeHistory.hitLinearDepth;
                current.packedHitNormal = representativeHistory.packedHitNormal;
                current.hitIdentity = representativeHistory.hitIdentity;
                current.packedHitRevisions =
                    representativeHistory.packedHitRevisions;
                current.packedHitUv = representativeHistory.packedHitUv;
                current.packedHitSourceRadiance =
                    representativeHistory.packedHitSourceRadiance;
                acceptedHistory = representativeHistoryWeight >= 0.0;
            }
            outputVariance = max(outputMoments.y -
                outputMoments.x * outputMoments.x, 0.0);
        }
    }

    if (!hasCurrentSample && !acceptedHistory)
        return false;

    if (!SimpleDdgiNearFieldFinite(outputResidual.rgb) ||
        !SimpleDdgiNearFieldFinite(outputResidual.a) || outputResidual.a <= 0.0 ||
        !SimpleDdgiNearFieldFinite(outputMoments.x) ||
        !SimpleDdgiNearFieldFinite(outputMoments.y) ||
        !SimpleDdgiNearFieldFinite(outputVariance))
    {
        historyReasonFlags |= C5_HISTORY_REASON_INVALID_CURRENT |
            C5_HISTORY_REASON_NONFINITE;
        return false;
    }

    if (!acceptedHistory && historyReasonFlags == 0u)
        historyReasonFlags = C5_HISTORY_REASON_EPOCH;
    uint outputFlags = SimpleDdgiNearFieldMetadataFlags(current);
    outputFlags &= ~SIMPLE_DDGI_NEAR_FIELD_REJECTION_REASON_MASK;
    if (acceptedHistory)
        outputFlags |= SIMPLE_DDGI_NEAR_FIELD_FLAG_HISTORY_ACCEPTED;
    else
    {
        outputFlags &= ~SIMPLE_DDGI_NEAR_FIELD_FLAG_HISTORY_ACCEPTED;
        outputFlags |= C5DominantHistoryRejection(historyReasonFlags) <<
            SIMPLE_DDGI_NEAR_FIELD_REJECTION_REASON_SHIFT;
    }
    SimpleDdgiNearFieldSetMetadataFlags(current, outputFlags);
    // First-frame contribution is 25% and reaches full trace confidence on
    // the eighth stable frame. HistoryAccepted is diagnostic, not a validity
    // prerequisite.
    float confidenceRamp = 0.25 + 0.75 * clamp(
        float(outputHistoryLength - 1u) / 7.0, 0.0, 1.0);
    outputResidual.a = clamp(outputResidual.a, 0.0, 1.0) * confidenceRamp;
    outputMetadata = current;
    outputValidity = SimpleDdgiNearFieldPackHistoryValidity(
        outputHistoryLength, pc.historyEpoch);
    return true;
}

void RecordTemporalTileSummary(uint tileIndex)
{
    uint candidateCount = 0u;
    uint acceptedCount = 0u;
    uint invalidCurrentCount = 0u;
    uint epochRejects = 0u;
    uint identityRejects = 0u;
    uint reprojectionRejects = 0u;
    uint depthRejects = 0u;
    uint normalRejects = 0u;
    uint sourceRevisionRejects = 0u;
    uint receiverIdentityRejects = 0u;
    uint receiverRevisionRejects = 0u;
    uint hitIdentityRejects = 0u;
    uint hitRevisionRejects = 0u;
    uint sourceReactiveRejects = 0u;
    uint varianceClipped = 0u;
    uint nonFiniteEnergy = 0u;
    float varianceSum = 0.0;
    float maximumVariance = 0.0;
    float signedEnergy = 0.0;
    float absoluteEnergy = 0.0;
    float squaredEnergy = 0.0;
    float maximumAbsoluteEnergy = 0.0;
    float confidenceSum = 0.0;
    uint validOutputCount = 0u;
    for (uint lane = 0u; lane < 64u; ++lane)
    {
        if (c5HistoryCovered[lane] == 0u)
            continue;
        candidateCount += c5HistoryCandidate[lane];
        acceptedCount += c5HistoryAccepted[lane];
        uint reasons = c5HistoryReasonFlags[lane];
        invalidCurrentCount += (reasons & C5_HISTORY_REASON_INVALID_CURRENT) != 0u ? 1u : 0u;
        epochRejects += (reasons & C5_HISTORY_REASON_EPOCH) != 0u ? 1u : 0u;
        receiverIdentityRejects +=
            (reasons & C5_HISTORY_REASON_IDENTITY) != 0u ? 1u : 0u;
        receiverRevisionRejects +=
            (reasons & C5_HISTORY_REASON_RECEIVER_REVISION) != 0u ? 1u : 0u;
        hitIdentityRejects +=
            (reasons & C5_HISTORY_REASON_HIT_IDENTITY) != 0u ? 1u : 0u;
        hitRevisionRejects +=
            (reasons & C5_HISTORY_REASON_HIT_REVISION) != 0u ? 1u : 0u;
        sourceReactiveRejects +=
            (reasons & C5_HISTORY_REASON_SOURCE_REACTIVE) != 0u ? 1u : 0u;
        identityRejects += (reasons & (
            C5_HISTORY_REASON_IDENTITY |
            C5_HISTORY_REASON_RECEIVER_REVISION |
            C5_HISTORY_REASON_HIT_IDENTITY |
            C5_HISTORY_REASON_HIT_REVISION)) != 0u ? 1u : 0u;
        reprojectionRejects += (reasons & C5_HISTORY_REASON_REPROJECTION) != 0u ? 1u : 0u;
        depthRejects += (reasons & C5_HISTORY_REASON_DEPTH) != 0u ? 1u : 0u;
        normalRejects += (reasons & C5_HISTORY_REASON_NORMAL) != 0u ? 1u : 0u;
        sourceRevisionRejects += (reasons & C5_HISTORY_REASON_SOURCE_REVISION) != 0u ? 1u : 0u;
        varianceClipped += (reasons & C5_HISTORY_REASON_VARIANCE_CLIPPED) != 0u ? 1u : 0u;
        varianceSum += c5HistoryVariance[lane];
        maximumVariance = max(maximumVariance, c5HistoryVariance[lane]);
        if (c5HistoryEnergyFinite[lane] != 0u)
        {
            validOutputCount++;
            confidenceSum += c5HistoryConfidence[lane];
            float energy = c5HistorySignedEnergy[lane];
            float absolute = c5HistoryAbsoluteEnergy[lane];
            signedEnergy += energy;
            absoluteEnergy += absolute;
            squaredEnergy += c5HistorySquaredEnergy[lane];
            maximumAbsoluteEnergy = max(maximumAbsoluteEnergy, absolute);
        }
        else if (c5HistoryCandidate[lane] != 0u)
        {
            nonFiniteEnergy++;
        }
    }

    uint recordBase = SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_HEADER_WORDS +
        tileIndex * SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS;
    if (recordBase > uint(temporalTileRecords.words.length()) ||
        SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS >
            uint(temporalTileRecords.words.length()) - recordBase)
    {
        if (uint(temporalTileRecords.words.length()) > 15u)
            atomicOr(temporalTileRecords.words[15u], 2u);
        return;
    }
    if (temporalTileRecords.words[recordBase] != tileIndex ||
        ((temporalTileRecords.words[recordBase + 15u] >> 16u) &
            SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TRACE_COMPLETE) == 0u)
    {
        atomicOr(temporalTileRecords.words[15u], 4u);
        return;
    }

    uint traceNonFinite = temporalTileRecords.words[recordBase + 4u] & 0xffu;
    temporalTileRecords.words[recordBase + 4u] = traceNonFinite |
        (candidateCount << 8u) | (acceptedCount << 16u) |
        (invalidCurrentCount << 24u);
    temporalTileRecords.words[recordBase + 5u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            epochRejects, identityRejects, reprojectionRejects, depthRejects));
    temporalTileRecords.words[recordBase + 6u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            normalRejects, sourceRevisionRejects, varianceClipped,
            nonFiniteEnergy));
    temporalTileRecords.words[recordBase + 9u] = floatBitsToUint(varianceSum);
    temporalTileRecords.words[recordBase + 10u] = floatBitsToUint(maximumVariance);
    temporalTileRecords.words[recordBase + 11u] = floatBitsToUint(signedEnergy);
    temporalTileRecords.words[recordBase + 12u] = floatBitsToUint(absoluteEnergy);
    temporalTileRecords.words[recordBase + 13u] = floatBitsToUint(squaredEnergy);
    temporalTileRecords.words[recordBase + 14u] =
        floatBitsToUint(maximumAbsoluteEnergy);
    temporalTileRecords.words[recordBase + 15u] |=
        SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TEMPORAL_COMPLETE << 16u;
    temporalTileRecords.words[recordBase + 16u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            receiverIdentityRejects,
            receiverRevisionRejects,
            hitIdentityRejects,
            hitRevisionRejects));
    temporalTileRecords.words[recordBase + 17u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            sourceReactiveRejects,
            reprojectionRejects,
            depthRejects,
            normalRejects));
    temporalTileRecords.words[recordBase + 18u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            varianceClipped,
            sourceRevisionRejects,
            epochRejects,
            invalidCurrentCount));

    if (SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_LOCAL_ADAPTIVE_SCHEDULING) &&
        tileIndex < uint(temporalSchedulerHistory.values.length()))
    {
        SimpleDdgiNearFieldResidualSchedulerRecord scheduler =
            temporalSchedulerHistory.values[tileIndex];
        uint tileClass = SimpleDdgiNearFieldSchedulerClass(
            scheduler.packedState);
        uint phase = SimpleDdgiNearFieldSchedulerPhase(scheduler.packedState);
        uint rays = SimpleDdgiNearFieldSchedulerRays(scheduler.packedState);
        uint age = tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY ||
                tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_INTERLEAVED
            ? SimpleDdgiNearFieldSchedulerAge(scheduler.packedState)
            : 0u;
        bool validSchedulerOutput = validOutputCount > 0u;
        float reciprocalValid = validSchedulerOutput
            ? 1.0 / float(validOutputCount)
            : 0.0;
        scheduler.packedState = SimpleDdgiNearFieldPackSchedulerState(
            tileClass,
            phase,
            rays,
            validSchedulerOutput,
            age,
            confidenceSum * reciprocalValid);
        scheduler.signedResidualEnergy = validSchedulerOutput
            ? signedEnergy * reciprocalValid
            : 0.0;
        scheduler.variance = validSchedulerOutput
            ? varianceSum * reciprocalValid
            : 0.0;
        temporalSchedulerHistory.values[tileIndex] = scheduler;
    }
}

void main()
{
    uint activeIndex = gl_WorkGroupID.x;
    uint activeCount = uint(temporalActiveTiles.words.length()) > 1u
        ? temporalActiveTiles.words[1]
        : 0u;
    uint tileCountX = (pc.traceWidth + 7u) / 8u;
    uint tileCountY = (pc.traceHeight + 7u) / 8u;
    uint resolveFirstWord = SimpleDdgiNearFieldResolveListFirstWord(
        tileCountX * tileCountY);
    bool activeTile = uint(temporalActiveTiles.words.length()) > 4u &&
        temporalActiveTiles.words[4u] == 0u && activeIndex < activeCount &&
        resolveFirstWord + activeIndex <
            uint(temporalActiveTiles.words.length());
    uint tileIndex = activeTile
        ? temporalActiveTiles.words[resolveFirstWord + activeIndex]
        : 0u;
    uvec2 tile = tileCountX > 0u
        ? uvec2(tileIndex % tileCountX, tileIndex / tileCountX)
        : uvec2(0u);
    ivec2 pixel = ivec2(tile * 8u + gl_LocalInvocationID.xy);
    ivec2 physicalOutputExtent = imageSize(temporalRadianceOutput);
    ivec2 outputExtent = min(
        ivec2(pc.traceWidth, pc.traceHeight),
        physicalOutputExtent);
    bool covered = activeTile &&
        pixel.x < outputExtent.x && pixel.y < outputExtent.y;
    uint outputIndex = covered
        ? uint(pixel.y) * pc.traceWidth + uint(pixel.x)
        : 0u;
    vec4 outputResidual;
    vec2 outputMoments;
    uint outputValidity;
    vec4 outputPackedNormals;
    SimpleDdgiNearFieldResidualHitMetadata outputMetadata;
    bool historyCandidate;
    bool acceptedHistory;
    uint historyReasonFlags;
    float outputVariance;
    bool validOutput = covered && EvaluateTemporalPixel(
        pixel,
        outputExtent,
        outputIndex,
        outputResidual,
        outputMoments,
        outputValidity,
        outputPackedNormals,
        outputMetadata,
        historyCandidate,
        acceptedHistory,
        historyReasonFlags,
        outputVariance);

    float signedEnergy = 0.0;
    float absoluteEnergy = 0.0;
    float squaredEnergy = 0.0;
    bool finiteEnergy = false;
    if (validOutput)
    {
        signedEnergy = dot(outputResidual.rgb * outputResidual.a,
            vec3(0.2126, 0.7152, 0.0722));
        absoluteEnergy = abs(signedEnergy);
        squaredEnergy = signedEnergy * signedEnergy;
        finiteEnergy = SimpleDdgiNearFieldFinite(signedEnergy) &&
            SimpleDdgiNearFieldFinite(squaredEnergy);
    }

    uint lane = gl_LocalInvocationIndex;
    c5HistoryCovered[lane] = covered ? 1u : 0u;
    c5HistoryCandidate[lane] = historyCandidate ? 1u : 0u;
    c5HistoryAccepted[lane] = acceptedHistory ? 1u : 0u;
    c5HistoryReasonFlags[lane] = historyReasonFlags;
    c5HistoryVariance[lane] = validOutput ? outputVariance : 0.0;
    c5HistorySignedEnergy[lane] = finiteEnergy ? signedEnergy : 0.0;
    c5HistoryAbsoluteEnergy[lane] = finiteEnergy ? absoluteEnergy : 0.0;
    c5HistorySquaredEnergy[lane] = finiteEnergy ? squaredEnergy : 0.0;
    c5HistoryEnergyFinite[lane] = finiteEnergy ? 1u : 0u;
    c5HistoryConfidence[lane] = validOutput
        ? clamp(outputResidual.a, 0.0, 1.0)
        : 0.0;
    barrier();
    if (lane == 0u)
    {
        RecordTemporalTileSummary(tileIndex);
    }
    barrier();

    if (!covered)
        return;
    if (!validOutput)
    {
        WriteInvalid(pixel, outputIndex);
        return;
    }
    imageStore(temporalRadianceOutput, pixel, outputResidual);
    imageStore(temporalMomentsOutput, pixel,
        vec4(outputMoments, 0.0, 0.0));
    imageStore(temporalValidityOutput, pixel,
        uvec4(outputValidity, 0u, 0u, 0u));
    imageStore(temporalHistoryNormalOutput, pixel,
        uvec4(packSnorm4x8(clamp(outputPackedNormals,
            vec4(-1.0), vec4(1.0))), 0u, 0u, 0u));
    temporalMetadataOutput.values[outputIndex] = outputMetadata;
}
