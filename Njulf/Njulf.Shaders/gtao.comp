#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D DepthTexture;
layout(set = 0, binding = 1) uniform sampler2D HiZTexture;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D GtaoRawOutput;

layout(push_constant) uniform GtaoPushBlock
{
    mat4 InverseProjectionMatrix;
    mat4 ProjectionMatrix;
    vec2 SourceDimensions;
    vec2 DestinationDimensions;
    float Radius;
    float Thickness;
    float Falloff;
    float PlaneBias;
    float Intensity;
    float Power;
    uint DirectionCount;
    uint StepCount;
    uint FrameIndex;
    uint HiZMipCount;
} pc;

const float GTAO_PI = 3.14159265359;
const float GTAO_HALF_PI = 1.57079632679;

bool Finite(float value)
{
    return !isnan(value) && !isinf(value);
}

bool Finite(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

float Hash(uvec3 value)
{
    uint state = value.x * 0x9e3779b9u ^ value.y * 0x85ebca6bu ^
        value.z * 0xc2b2ae35u;
    state ^= state >> 16u;
    state *= 0x7feb352du;
    state ^= state >> 15u;
    state *= 0x846ca68bu;
    state ^= state >> 16u;
    return float(state & 0x00ffffffu) / 16777216.0;
}

float FetchDepth(vec2 uv)
{
    ivec2 extent = textureSize(DepthTexture, 0);
    ivec2 pixel = ivec2(clamp(uv * vec2(extent), vec2(0.0),
        vec2(extent - ivec2(1))));
    return texelFetch(DepthTexture, pixel, 0).r;
}

vec3 ReconstructViewPosition(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    vec4 view = MulRowMajor(clip, pc.InverseProjectionMatrix);
    return view.xyz / max(abs(view.w), 1.0e-6);
}

vec3 ReconstructGeometricNormal(vec2 uv, float centerDepth, vec3 center)
{
    vec2 texel = 1.0 / max(pc.SourceDimensions, vec2(1.0));
    vec2 rightUv = min(uv + vec2(texel.x, 0.0), vec2(1.0));
    vec2 leftUv = max(uv - vec2(texel.x, 0.0), vec2(0.0));
    vec2 upUv = min(uv + vec2(0.0, texel.y), vec2(1.0));
    vec2 downUv = max(uv - vec2(0.0, texel.y), vec2(0.0));
    float rightDepth = FetchDepth(rightUv);
    float leftDepth = FetchDepth(leftUv);
    float upDepth = FetchDepth(upUv);
    float downDepth = FetchDepth(downUv);
    vec3 dx = rightDepth > 1.0e-6 &&
            (leftDepth <= 1.0e-6 ||
             abs(ReconstructViewPosition(rightUv, rightDepth).z - center.z) <=
             abs(center.z - ReconstructViewPosition(leftUv, leftDepth).z))
        ? ReconstructViewPosition(rightUv, rightDepth) - center
        : center - ReconstructViewPosition(leftUv, leftDepth);
    vec3 dy = upDepth > 1.0e-6 &&
            (downDepth <= 1.0e-6 ||
             abs(ReconstructViewPosition(upUv, upDepth).z - center.z) <=
             abs(center.z - ReconstructViewPosition(downUv, downDepth).z))
        ? ReconstructViewPosition(upUv, upDepth) - center
        : center - ReconstructViewPosition(downUv, downDepth);
    vec3 normal = cross(dy, dx);
    float lengthSquared = dot(normal, normal);
    if (lengthSquared <= max(dot(dx, dx) * dot(dy, dy), 1.0e-20) * 1.0e-6)
        return vec3(0.0, 0.0, 1.0);
    normal *= inversesqrt(lengthSquared);
    return dot(normal, -center) < 0.0 ? -normal : normal;
}

vec2 EncodeOctahedral(vec3 normal)
{
    normal /= max(abs(normal.x) + abs(normal.y) + abs(normal.z), 1.0e-6);
    vec2 encoded = normal.xy;
    if (normal.z < 0.0)
        encoded = (vec2(1.0) - abs(encoded.yx)) * sign(encoded);
    return clamp(encoded, vec2(-1.0), vec2(1.0));
}

float SearchHorizon(
    vec2 uv,
    vec3 center,
    vec3 viewDirection,
    vec3 sliceTangent,
    vec2 screenDirection,
    float projectedRadiusPixels)
{
    float horizon = -GTAO_HALF_PI;
    uint stepCount = clamp(pc.StepCount, 1u, 12u);
    vec2 invSource = 1.0 / max(pc.SourceDimensions, vec2(1.0));
    for (uint step = 0u; step < 12u; ++step)
    {
        if (step >= stepCount)
            break;
        float fraction = (float(step) + 1.0) / float(stepCount);
        float pixelDistance = max(1.0,
            projectedRadiusPixels * fraction * fraction);
        vec2 sampleUv = uv + screenDirection * pixelDistance * invSource;
        if (any(lessThanEqual(sampleUv, vec2(0.0))) ||
            any(greaterThanEqual(sampleUv, vec2(1.0))))
            continue;
        float footprint = max(1.0, projectedRadiusPixels /
            max(float(stepCount), 1.0));
        float mip = clamp(floor(log2(footprint)), 0.0,
            float(max(pc.HiZMipCount, 1u) - 1u));
        float sampleDepth = textureLod(HiZTexture, sampleUv, mip).r;
        if (sampleDepth <= 1.0e-6)
            continue;
        vec3 samplePosition = ReconstructViewPosition(sampleUv, sampleDepth);
        vec3 delta = samplePosition - center;
        float distanceToSample = length(delta);
        if (!Finite(samplePosition) || !Finite(distanceToSample) ||
            distanceToSample <= 1.0e-5 || distanceToSample > pc.Radius)
            continue;
        float tangentDistance = dot(delta, sliceTangent);
        if (tangentDistance <= 1.0e-5)
            continue;
        float depthDiscontinuity = abs(samplePosition.z - center.z);
        if (depthDiscontinuity > pc.Radius + pc.Thickness)
            continue;
        float angle = atan(dot(delta, viewDirection), tangentDistance);
        float rangeWeight = 1.0 - smoothstep(
            pc.Radius / max(pc.Falloff, 0.1),
            pc.Radius,
            distanceToSample);
        float thicknessWeight = 1.0 - smoothstep(
            pc.Thickness,
            max(pc.Thickness * 4.0, pc.Thickness + 1.0e-4),
            max(depthDiscontinuity - pc.PlaneBias, 0.0));
        horizon = max(horizon,
            mix(-GTAO_HALF_PI, angle, rangeWeight * thicknessWeight));
    }
    return clamp(horizon, -GTAO_HALF_PI, GTAO_HALF_PI);
}

// Closed-form cosine integral over one visible slice arc.
float IntegrateVisibleArc(float horizon, float normalAngle)
{
    float lower = clamp(horizon, -GTAO_HALF_PI, GTAO_HALF_PI);
    float upper = GTAO_HALF_PI;
    return max(0.0, 0.5 * (
        sin(upper - normalAngle) - sin(lower - normalAngle)));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(GtaoRawOutput);
    if (any(greaterThanEqual(pixel, extent)))
        return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) /
        max(pc.DestinationDimensions, vec2(1.0));
    float depth = FetchDepth(uv);
    if (depth <= 1.0e-6)
    {
        imageStore(GtaoRawOutput, pixel,
            vec4(0.0, 0.0, 1.0, 0.0));
        return;
    }
    vec3 center = ReconstructViewPosition(uv, depth);
    vec3 normal = ReconstructGeometricNormal(uv, depth, center);
    if (!Finite(center) || !Finite(normal))
    {
        imageStore(GtaoRawOutput, pixel,
            vec4(0.0, 0.0, 1.0, 0.0));
        return;
    }
    vec3 viewDirection = normalize(-center);
    float viewDepth = max(abs(center.z), 1.0e-3);
    float projectedRadiusPixels = pc.Radius *
        abs(pc.ProjectionMatrix[1][1]) * pc.DestinationDimensions.y *
        0.5 / viewDepth;
    if (projectedRadiusPixels < 1.5)
    {
        imageStore(GtaoRawOutput, pixel,
            vec4(EncodeOctahedral(normal), 1.0, 1.0));
        return;
    }

    uint directionCount = clamp(pc.DirectionCount, 1u, 8u);
    float rotation = (Hash(uvec3(pixel, pc.FrameIndex & 7u)) +
        float(pc.FrameIndex & 7u) * 0.61803398875) * GTAO_PI;
    float visibilitySum = 0.0;
    float projectedWeightSum = 0.0;
    vec3 unoccludedDirection = vec3(0.0);
    for (uint directionIndex = 0u; directionIndex < 8u;
         ++directionIndex)
    {
        if (directionIndex >= directionCount)
            break;
        float angle = rotation + GTAO_PI *
            (float(directionIndex) + 0.5) / float(directionCount);
        vec2 screenDirection = vec2(cos(angle), sin(angle));
        vec3 tangent = normalize(vec3(screenDirection, 0.0));
        vec3 sliceNormal = normalize(cross(tangent, viewDirection));
        vec3 projectedNormal = normal - sliceNormal * dot(normal, sliceNormal);
        float projectedLength = length(projectedNormal);
        if (projectedLength <= 1.0e-5)
            continue;
        projectedNormal /= projectedLength;
        float normalAngle = atan(dot(projectedNormal, tangent),
            dot(projectedNormal, viewDirection));
        float positiveHorizon = SearchHorizon(uv, center, viewDirection,
            tangent, screenDirection, projectedRadiusPixels);
        float negativeHorizon = SearchHorizon(uv, center, viewDirection,
            -tangent, -screenDirection, projectedRadiusPixels);
        float positiveVisibility = IntegrateVisibleArc(
            positiveHorizon, normalAngle);
        float negativeVisibility = IntegrateVisibleArc(
            negativeHorizon, -normalAngle);
        float sliceVisibility = clamp(
            (positiveVisibility + negativeVisibility) * projectedLength,
            0.0,
            1.0);
        visibilitySum += sliceVisibility;
        projectedWeightSum += projectedLength;
        float positiveOpen = clamp(
            (GTAO_HALF_PI - positiveHorizon) / GTAO_PI, 0.0, 1.0);
        float negativeOpen = clamp(
            (GTAO_HALF_PI - negativeHorizon) / GTAO_PI, 0.0, 1.0);
        unoccludedDirection += projectedNormal *
            (positiveOpen + negativeOpen) +
            tangent * (positiveOpen - negativeOpen);
    }
    float visibility = projectedWeightSum > 1.0e-5
        ? visibilitySum / projectedWeightSum
        : 1.0;
    visibility = pow(clamp(1.0 - (1.0 - visibility) * pc.Intensity,
        0.0, 1.0), max(pc.Power, 0.25));
    vec3 bentNormal = dot(unoccludedDirection, unoccludedDirection) > 1.0e-8
        ? normalize(unoccludedDirection)
        : normal;
    if (dot(bentNormal, normal) <= 0.0 || !Finite(bentNormal))
        bentNormal = normal;
    float confidence = clamp(projectedRadiusPixels / 6.0, 0.0, 1.0);
    imageStore(GtaoRawOutput, pixel, vec4(
        EncodeOctahedral(bentNormal),
        visibility,
        confidence));
}
