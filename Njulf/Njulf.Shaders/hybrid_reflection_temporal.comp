#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionTemporalPushBlock
{
    mat4 InverseViewProjectionMatrix;
    uint ScreenWidth;
    uint ScreenHeight;
    uint MaximumHistoryLength;
    uint ResetReasons;
    float MaximumHistoryWeight;
    float SourceTransitionWeightScale;
    float VarianceGamma;
    float Padding0;
    uint CurrentFrameIndex;
    uint CameraOnlyReprojection;
    uint SourceInvalidations;
    uint UseActiveTileList;
} pc;

bool HybridHistorySourceInvalidated(uint source)
{
    if (source == HYBRID_REFLECTION_SOURCE_RAY_QUERY)
        return (pc.SourceInvalidations & (1u << 0u)) != 0u;
    if (source == HYBRID_REFLECTION_SOURCE_DDGI)
        return (pc.SourceInvalidations & (1u << 1u)) != 0u;
    if (source == HYBRID_REFLECTION_SOURCE_LOCAL_PROBE)
        return (pc.SourceInvalidations & (1u << 3u)) != 0u;
    if (source == HYBRID_REFLECTION_SOURCE_ENVIRONMENT)
        return (pc.SourceInvalidations & (1u << 4u)) != 0u;
    if (source == HYBRID_REFLECTION_SOURCE_PLANAR)
        return (pc.SourceInvalidations & (1u << 5u)) != 0u;
    return false;
}

float HybridLuminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

bool HybridHistorySurfaceMatches(
    vec3 worldPosition,
    vec3 currentNormal,
    uvec2 previousMetadata)
{
    if (ReadMeshletTaskPreviousHiZFrameValid(pc.CurrentFrameIndex) == 0u)
        return false;
    vec4 previousClip = MulRowMajor(vec4(worldPosition, 1.0),
        ReadMeshletTaskPreviousHiZViewProjectionMatrix(
            pc.CurrentFrameIndex));
    if (any(isnan(previousClip)) || any(isinf(previousClip)) ||
        abs(previousClip.w) <= 1.0e-7)
    {
        return false;
    }
    float expectedDepth = previousClip.z / previousClip.w;
    float previousDepth = HybridHistoryMetadataDepth(previousMetadata);
    float depthTolerance = max(0.0005, abs(expectedDepth) * 0.002);
    if (!HybridFinite(expectedDepth) || !HybridFinite(previousDepth) ||
        expectedDepth < 0.0 || expectedDepth > 1.0 ||
        abs(previousDepth - expectedDepth) > depthTolerance)
    {
        return false;
    }
    vec3 previousNormal =
        HybridHistoryMetadataNormal(previousMetadata);
    return HybridFinite(previousNormal) &&
        dot(currentNormal, previousNormal) >= 0.9;
}

void main()
{
    uvec2 invocation = HybridReflectionTileInvocation(
        pc.UseActiveTileList != 0u);
    if (invocation.x >= pc.ScreenWidth || invocation.y >= pc.ScreenHeight)
        return;
    ivec2 pixel = ivec2(invocation);
    uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
    if (!HybridReflectionPayloadValid(payload))
    {
        imageStore(HybridHistoryCurrent, pixel, vec4(0.0));
        imageStore(HybridMomentsCurrent, pixel, vec4(0.0));
        imageStore(HybridMetadataCurrent, pixel, uvec4(0u));
        return;
    }

    vec3 currentWorldPosition;
    float currentDepth;
    if (!HybridReconstructWorldPosition(pixel,
            uvec2(pc.ScreenWidth, pc.ScreenHeight),
            pc.InverseViewProjectionMatrix,
            currentWorldPosition, currentDepth))
    {
        imageStore(HybridHistoryCurrent, pixel, vec4(0.0));
        imageStore(HybridMomentsCurrent, pixel, vec4(0.0));
        imageStore(HybridMetadataCurrent, pixel, uvec4(0u));
        return;
    }
    // Reprojection must validate the broad-lobe footprint used for DDGI
    // sampling and remain compatible with the spatial filter. Using the
    // high-frequency shading normal here rejects otherwise valid broad DDGI
    // history as normal-map texels move across the screen, exposing fresh
    // coarse samples as camera-relative crawl. HybridReflectionTraceNormal
    // retains the shading normal for sharp glass/mirrors and converges only
    // broad lobes toward geometry.
    vec3 currentNormal = HybridReflectionTraceNormal(payload);

    vec4 current = imageLoad(HybridRawRadiance, pixel);
    uvec2 currentMetadata = imageLoad(HybridRawMetadata, pixel).xy;
    uint currentIdentity = HybridReceiverIdentity(payload);
    vec2 dimensions = vec2(pc.ScreenWidth, pc.ScreenHeight);
    vec2 uv = (vec2(pixel) + vec2(0.5)) / dimensions;
    vec2 motion = vec2(0.0);
    if (pc.CameraOnlyReprojection != 0u)
    {
        vec4 previousClip = MulRowMajor(
            vec4(currentWorldPosition, 1.0),
            ReadMeshletTaskPreviousHiZViewProjectionMatrix(
                pc.CurrentFrameIndex));
        if (ReadMeshletTaskPreviousHiZFrameValid(pc.CurrentFrameIndex) == 0u ||
            any(isnan(previousClip)) || any(isinf(previousClip)) ||
            abs(previousClip.w) <= 1.0e-7)
        {
            // A two-screen displacement is finite but guaranteed to reject
            // history for every in-bounds current UV.
            motion = vec2(2.0);
        }
        else
        {
            vec2 previousUvFromCamera =
                previousClip.xy / previousClip.w * 0.5 + vec2(0.5);
            motion = uv - previousUvFromCamera;
        }
    }
    else
    {
        motion = texelFetch(HybridMotionVectors, pixel, 0).rg;
    }
    vec2 previousUv = uv - motion;
    bool previousInside = HybridFinite(motion) &&
        all(greaterThanEqual(previousUv, vec2(0.0))) &&
        all(lessThan(previousUv, vec2(1.0)));
    bool currentValid = HybridMetadataValid(currentMetadata.x) &&
        HybridFinite(current);
    if (!currentValid)
        current = vec4(0.0);
    uint currentReason = HybridMetadataReason(currentMetadata.x);
    bool sparseCurrent =
        currentReason == HYBRID_REFLECTION_REASON_RESOLUTION_SKIP ||
        currentReason == HYBRID_REFLECTION_REASON_RAY_BUDGET;

    // Gather four bilinear history taps. Each tap is validated independently;
    // rejected geometry edges cannot drag a point-sampled trail across motion.
    vec4 previous = vec4(0.0);
    float previousVariance = 0.0;
    uvec2 previousMetadata = uvec2(0u);
    float acceptedHistoryWeight = 0.0;
    float dominantHistoryWeight = -1.0;
    if (pc.ResetReasons == 0u && previousInside)
    {
        vec2 historyPosition = previousUv * dimensions - vec2(0.5);
        ivec2 historyBase = ivec2(floor(historyPosition));
        vec2 historyFraction = fract(historyPosition);
        for (int tapY = 0; tapY < 2; tapY++)
        {
            for (int tapX = 0; tapX < 2; tapX++)
            {
                ivec2 previousPixel = historyBase + ivec2(tapX, tapY);
                float tapWeight =
                    (tapX == 0 ? 1.0 - historyFraction.x : historyFraction.x) *
                    (tapY == 0 ? 1.0 - historyFraction.y : historyFraction.y);
                if (tapWeight <= 0.0 ||
                    any(lessThan(previousPixel, ivec2(0))) ||
                    any(greaterThanEqual(previousPixel,
                        ivec2(pc.ScreenWidth, pc.ScreenHeight))))
                {
                    continue;
                }
                uvec2 tapMetadata = imageLoad(
                    HybridMetadataPrevious, previousPixel).xy;
                vec4 tapHistory = imageLoad(
                    HybridHistoryPrevious, previousPixel);
                float tapVariance = imageLoad(
                    HybridMomentsPrevious, previousPixel).r;
                uint tapSource =
                    HybridHistoryMetadataSource(tapMetadata);
                bool tapGeometricSource =
                    tapSource == HYBRID_REFLECTION_SOURCE_SSR ||
                    tapSource == HYBRID_REFLECTION_SOURCE_RAY_QUERY;
                if (!HybridHistoryMetadataValid(tapMetadata) ||
                    HybridHistoryMetadataIdentity(tapMetadata) !=
                        currentIdentity ||
                    HybridHistorySourceInvalidated(tapSource) ||
                    (sparseCurrent && !tapGeometricSource) ||
                    !HybridFinite(tapHistory) ||
                    !HybridFinite(tapVariance) || tapVariance < 0.0 ||
                    !HybridHistorySurfaceMatches(
                        currentWorldPosition, currentNormal, tapMetadata))
                {
                    continue;
                }
                previous += tapHistory * tapWeight;
                previousVariance += tapVariance * tapWeight;
                acceptedHistoryWeight += tapWeight;
                if (tapWeight > dominantHistoryWeight)
                {
                    dominantHistoryWeight = tapWeight;
                    previousMetadata = tapMetadata;
                }
            }
        }
    }
    bool historyValid = acceptedHistoryWeight > 1.0e-6;
    if (historyValid)
    {
        previous /= acceptedHistoryWeight;
        previousVariance /= acceptedHistoryWeight;
    }
    if (!currentValid &&
        currentReason != HYBRID_REFLECTION_REASON_RESOLUTION_SKIP &&
        currentReason != HYBRID_REFLECTION_REASON_RAY_BUDGET)
    {
        historyValid = false;
    }
    uint currentSource = HybridMetadataSource(currentMetadata.x);
    uint previousSource =
        HybridHistoryMetadataSource(previousMetadata);
    uint previousSparseState =
        HybridHistoryMetadataSparseState(previousMetadata);
    uint previousAge = HybridHistoryMetadataAge(previousMetadata);
    bool previousGeometricSource =
        previousSource == HYBRID_REFLECTION_SOURCE_SSR ||
        previousSource == HYBRID_REFLECTION_SOURCE_RAY_QUERY;
    bool previousSparse = previousSparseState !=
        HYBRID_REFLECTION_HISTORY_SPARSE_NONE;
    uint previousSparseAge = previousSparse ? previousAge : 0u;
    float motionPixels = length(motion * dimensions);
    float sparseMotionWeight = 1.0 - smoothstep(
        0.25, 1.5, motionPixels);
    uint sparseHistoryAgeLimit = motionPixels <= 0.25
        ? pc.MaximumHistoryLength
        : min(pc.MaximumHistoryLength, 2u);
    bool reuseSparseHistory = historyValid && previousGeometricSource &&
        sparseCurrent && sparseMotionWeight > 1.0e-3 &&
        previousSparseAge < sparseHistoryAgeLimit;
    // A cadence or budget skip is not a measured reflection. Once geometric
    // history expires, use the current analytic fallback directly instead of
    // retaining a stale geometric source through the generic accumulator.
    if (sparseCurrent && !reuseSparseHistory)
        historyValid = false;

    bool currentBoundsHistory = currentValid && !sparseCurrent;
    vec3 neighborhoodMinimum = currentBoundsHistory
        ? current.rgb
        : vec3(3.402823e38);
    vec3 neighborhoodMaximum = currentBoundsHistory
        ? current.rgb
        : vec3(-3.402823e38);
    uint validNeighbors = currentBoundsHistory ? 1u : 0u;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            ivec2 neighbor = clamp(pixel + ivec2(x, y), ivec2(0),
                ivec2(pc.ScreenWidth, pc.ScreenHeight) - ivec2(1));
            uvec2 neighborMetadata = imageLoad(
                HybridRawMetadata, neighbor).xy;
            uvec4 neighborPayload = texelFetch(
                HybridReceiverPayload, neighbor, 0);
            uint neighborSource = HybridMetadataSource(neighborMetadata.x);
            bool neighborGeometricSource =
                neighborSource == HYBRID_REFLECTION_SOURCE_SSR ||
                neighborSource == HYBRID_REFLECTION_SOURCE_RAY_QUERY;
            if (!HybridMetadataValid(neighborMetadata.x) ||
                !HybridReflectionPayloadValid(neighborPayload) ||
                HybridReceiverIdentity(neighborPayload) != currentIdentity ||
                (sparseCurrent && !neighborGeometricSource))
                continue;
            vec3 sampleValue = imageLoad(HybridRawRadiance, neighbor).rgb;
            if (!HybridFinite(sampleValue))
                continue;
            neighborhoodMinimum = min(neighborhoodMinimum, sampleValue);
            neighborhoodMaximum = max(neighborhoodMaximum, sampleValue);
            validNeighbors++;
        }
    }
    if (validNeighbors == 0u)
    {
        neighborhoodMinimum = vec3(0.0);
        neighborhoodMaximum = vec3(65504.0);
    }

    float ageWeight = float(previousAge) / float(previousAge + 1u);
    float lengthWeight = pc.MaximumHistoryLength <= 1u
        ? 0.0
        : 1.0 - 1.0 / float(pc.MaximumHistoryLength);
    float historyWeight = historyValid
        ? min(pc.MaximumHistoryWeight, max(ageWeight, lengthWeight * 0.5))
        : 0.0;
    if (reuseSparseHistory)
    {
        // Sparse history is handled separately below. Keeping it out of the
        // generic accumulator avoids applying two independent history weights.
        historyWeight = 0.0;
    }
    else if (currentSource != previousSource && currentValid)
        historyWeight *= pc.SourceTransitionWeightScale;

    // Bound carried geometric history only against fresh reflection samples.
    // SceneColor already contains the previous frame's composite on some
    // execution paths, so using it as a bound forms a positive feedback loop.
    float sparseReferenceMaximum =
        HybridMaximumComponent(neighborhoodMaximum);
    vec3 sparseHistory = HybridLimitReflectionRadiance(
        previous.rgb, sparseReferenceMaximum);
    // The generic HDR guard deliberately permits a wide range. Sparse
    // reprojection needs the tighter, component-wise envelope supplied by
    // this frame's same-receiver observations; otherwise a saturated channel
    // can survive at the scalar guard and create coloured smears. Keep a
    // small floor for isolated thin geometry that has no refreshed neighbour.
    vec3 sparseUpper = max(
        neighborhoodMaximum * 1.5 + vec3(0.05), vec3(1.0));
    sparseHistory = min(sparseHistory, sparseUpper);
    vec3 clippedHistory = reuseSparseHistory
        ? sparseHistory
        : clamp(previous.rgb, neighborhoodMinimum, neighborhoodMaximum);
    previousVariance = max(previousVariance, 0.0);
    float standardDeviation = sqrt(previousVariance);
    float currentLuminance = HybridLuminance(current.rgb);
    float historyLuminance = HybridLuminance(clippedHistory);
    float luminanceLimit = pc.VarianceGamma * standardDeviation + 0.02;
    if (!reuseSparseHistory &&
        abs(historyLuminance - currentLuminance) > luminanceLimit)
        historyWeight *= 0.5;

    float sparseHistoryWeight = reuseSparseHistory
        ? sparseMotionWeight
        : 0.0;
    vec3 accumulated = reuseSparseHistory
        ? mix(current.rgb, clippedHistory, sparseHistoryWeight)
        : mix(current.rgb, clippedHistory, historyWeight);
    float currentConfidence =
        HybridMetadataConfidence(currentMetadata.x);
    float sparsePreviousConfidence =
        clamp(previous.a * 0.97, 0.0, 1.0);
    float confidence = reuseSparseHistory
        ? mix(currentConfidence, sparsePreviousConfidence,
            sparseHistoryWeight)
        : mix(currentConfidence,
            previous.a, historyWeight);
    float luminance = HybridLuminance(accumulated);
    float observationVariance = (luminance - historyLuminance) *
        (luminance - historyLuminance);
    float varianceHistoryWeight = reuseSparseHistory
        ? sparseHistoryWeight
        : historyWeight;
    float variance = mix(
        observationVariance,
        previousVariance,
        varianceHistoryWeight);
    bool sparseHistoryDominant =
        reuseSparseHistory && sparseHistoryWeight >= 0.5;
    uint age = reuseSparseHistory
        ? (sparseHistoryDominant
            ? min(previousSparseAge + 1u, sparseHistoryAgeLimit)
            : 0u)
        : (historyWeight > 0.0
            ? (previousSparse
                ? 1u
                : min(previousAge + 1u, pc.MaximumHistoryLength))
            : 0u);
    bool outputValid = currentValid || historyValid;
    uint outputSource = sparseHistoryDominant
        ? previousSource
        : currentSource;

    imageStore(HybridHistoryCurrent, pixel,
        vec4(clamp(accumulated, vec3(0.0), vec3(65504.0)), confidence));
    imageStore(HybridMomentsCurrent, pixel,
        vec4(clamp(variance, 0.0, 65504.0), 0.0, 0.0, 0.0));
    uint sparseState = currentReason ==
            HYBRID_REFLECTION_REASON_RESOLUTION_SKIP
        ? HYBRID_REFLECTION_HISTORY_SPARSE_RESOLUTION
        : currentReason == HYBRID_REFLECTION_REASON_RAY_BUDGET
            ? HYBRID_REFLECTION_HISTORY_SPARSE_RAY_BUDGET
            : HYBRID_REFLECTION_HISTORY_SPARSE_NONE;
    imageStore(HybridMetadataCurrent, pixel, uvec4(
        HybridPackHistoryMetadata(
            currentIdentity,
            currentDepth,
            currentNormal,
            outputSource,
            age,
            sparseState,
            outputValid),
        0u,
        0u));
}
