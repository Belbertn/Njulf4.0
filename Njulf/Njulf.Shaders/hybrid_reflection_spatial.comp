#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"
#include "hybrid_reflection_sparse.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionSpatialPushBlock
{
    uint ScreenWidth;
    uint ScreenHeight;
    uint Iteration;
    uint UseActiveTileList;
    float NormalPower;
    float DepthSigma;
    float RoughnessSigma;
    float Padding0;
} pc;

shared uint HybridTileMaximumVarianceBits;
shared uint HybridTileMaximumRoughnessBits;
shared uint HybridTileMissingObservation;

vec4 HybridReadSpatialInput(ivec2 pixel)
{
    if (pc.Iteration == 0u)
        return imageLoad(HybridHistoryCurrent, pixel);
    return (pc.Iteration & 1u) != 0u
        ? imageLoad(HybridPreviousHistoryScratch, pixel)
        : imageLoad(HybridRawRadiance, pixel);
}

uvec4 HybridReadSpatialPayload(ivec2 pixel)
{
    return texelFetch(HybridReceiverPayload, pixel, 0);
}

uvec2 HybridReadSpatialMetadata(ivec2 pixel)
{
    return imageLoad(HybridMetadataCurrent, pixel).xy;
}

float HybridReadSpatialDepth(ivec2 pixel)
{
    return texelFetch(HybridSceneDepth, pixel, 0).r;
}

bool HybridReadSpatialClassifiedReuse(ivec2 pixel)
{
    return HybridReflectionClassifiedReuse(imageLoad(HybridRawMetadata, pixel).x);
}

#include "hybrid_reflection_spatial_kernel.glsl"

void HybridWriteSpatialOutput(ivec2 pixel, vec4 value)
{
    // Temporal history is an immutable input to the spatial stage. Writing a
    // filtered result back into it applies the blur again after reprojection
    // on every subsequent frame, which turns camera motion into long trails.
    // Raw radiance is dead after temporal resolve and is safe as the second
    // spatial ping-pong target.
    if ((pc.Iteration & 1u) == 0u)
        imageStore(HybridPreviousHistoryScratch, pixel, value);
    else
        imageStore(HybridRawRadiance, pixel, value);
}

void main()
{
    uvec2 invocation = HybridReflectionTileInvocation(
        pc.UseActiveTileList != 0u);
    bool inBounds = invocation.x < pc.ScreenWidth &&
        invocation.y < pc.ScreenHeight;
    if (gl_LocalInvocationIndex == 0u)
    {
        HybridTileMaximumVarianceBits = 0u;
        HybridTileMaximumRoughnessBits = 0u;
        HybridTileMissingObservation = 0u;
    }
    barrier();
    ivec2 pixel = ivec2(invocation);
    uvec4 centerPayload = inBounds
        ? texelFetch(HybridReceiverPayload, pixel, 0)
        : uvec4(0u);
    if (inBounds && HybridReflectionPayloadValid(centerPayload))
    {
        if (HybridHistoryMetadataSparseState(HybridReadSpatialMetadata(pixel)) !=
            HYBRID_REFLECTION_HISTORY_SPARSE_NONE &&
            !HybridReadSpatialClassifiedReuse(pixel))
            atomicOr(HybridTileMissingObservation, 1u);
        float tileVariance = max(
            imageLoad(HybridMomentsCurrent, pixel).r, 0.0);
        float tileRoughness = clamp(
            HybridReflectionPayloadPhysicalRoughness(centerPayload),
            0.0,
            1.0);
        atomicMax(HybridTileMaximumVarianceBits,
            floatBitsToUint(tileVariance));
        atomicMax(HybridTileMaximumRoughnessBits,
            floatBitsToUint(tileRoughness));
    }
    barrier();
    if (!inBounds)
        return;
    if (!HybridReflectionPayloadValid(centerPayload))
    {
        HybridWriteSpatialOutput(pixel, vec4(0.0));
        return;
    }

    float tileMaximumVariance = uintBitsToFloat(
        HybridTileMaximumVarianceBits);
    float tileMaximumRoughness = uintBitsToFloat(
        HybridTileMaximumRoughnessBits);
    float secondPassThreshold = max(pc.Padding0, 1.0e-6);
    float iterationThreshold = pc.Iteration == 0u
        ? secondPassThreshold * 0.35
        : secondPassThreshold;
    bool filterTile = HybridReflectionFilterTile(tileMaximumRoughness,
        tileMaximumVariance, iterationThreshold, HybridTileMissingObservation != 0u);
    if (!filterTile)
    {
        vec4 unchanged = HybridReadSpatialInput(pixel);
        HybridWriteSpatialOutput(pixel,
            HybridFinite(unchanged) ? unchanged : vec4(0.0));
        return;
    }
    HybridWriteSpatialOutput(pixel, HybridFilterSpatialPixel(pixel, centerPayload));
}
