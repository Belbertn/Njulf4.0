#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D SourceDepth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D DestinationDepth;

layout(push_constant) uniform HiZBuildPushConstantBlock
{
    vec2 SourceDimensions;
    vec2 DestinationDimensions;
} pc;

void main()
{
    ivec2 dstPixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = ivec2(pc.DestinationDimensions);
    if (dstPixel.x >= dstSize.x || dstPixel.y >= dstSize.y)
        return;

    ivec2 srcSize = ivec2(pc.SourceDimensions);
    // Each destination texel must contain every source texel intersecting
    // its normalized UV footprint. Vulkan rounds mip extents down: a fixed
    // 2x2 footprint drops odd edges and shifts coverage (e.g. 225 -> 112),
    // allowing an occlusion query to read depth from a neighboring occluder.
    // The overlapping third row/column is intentional for odd extents.
    ivec2 srcBegin = dstPixel * srcSize / dstSize;
    ivec2 srcEnd = ((dstPixel + ivec2(1)) * srcSize + dstSize - ivec2(1)) / dstSize;

    float farthestDepth = 1.0;
    for (int y = srcBegin.y; y < srcEnd.y; y++)
    {
        for (int x = srcBegin.x; x < srcEnd.x; x++)
        {
            farthestDepth = min(farthestDepth, texelFetch(SourceDepth, ivec2(x, y), 0).r);
        }
    }

    imageStore(DestinationDepth, dstPixel, vec4(farthestDepth, 0.0, 0.0, 0.0));
}
