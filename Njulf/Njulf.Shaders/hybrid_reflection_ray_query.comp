#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_ray_query : require

#include "common.glsl"
#include "area_lighting.glsl"
#include "ddgi_light_tree.glsl"

#define SIMPLE_DDGI_DISABLE_SAMPLED_ATLAS 1
#define SIMPLE_DDGI_RECEIVER_DEMAND_SAMPLE false
#define SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE false
#include "ddgi_simple_shared.glsl"

layout(set = 2, binding = 0) uniform accelerationStructureEXT SceneTlas;

bool GiCausticFinite(float value)
{
    return !isnan(value) && !isinf(value);
}

bool GiCausticFinite(vec2 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool GiCausticFinite(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

#include "directional_ray_visibility.glsl"
#include "ray_query_surface.glsl"
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionRayPushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndMaximumDistance;
    uint ScreenWidth;
    uint ScreenHeight;
    uint TaskCapacity;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaximumShadedLights;
    uint DdgiEnabled;
    uint CurrentFrameIndex;
    uint TemporalSampleIndex;
} pc;

bool HybridReflectionCandidatePasses(rayQueryEXT query)
{
    bool sampledAlpha;
    return RaySceneCandidateBlocksDirectionalShadow(
        rayQueryGetIntersectionInstanceCustomIndexEXT(query, false),
        rayQueryGetIntersectionPrimitiveIndexEXT(query, false),
        rayQueryGetIntersectionBarycentricsEXT(query, false),
        rayQueryGetIntersectionFrontFaceEXT(query, false),
        rayQueryGetIntersectionObjectToWorldEXT(query, false),
        0.01,
        sampledAlpha);
}

bool HybridTraceNearest(
    vec3 origin,
    vec3 direction,
    float maximumDistance,
    out RayQuerySurfaceHit hit)
{
    rayQueryEXT query;
    rayQueryInitializeEXT(query, SceneTlas, gl_RayFlagsNoneEXT, 0xff,
        origin, 0.002, direction, maximumDistance);
    uint candidates = 0u;
    while (rayQueryProceedEXT(query))
    {
        if (rayQueryGetIntersectionTypeEXT(query, false) !=
            gl_RayQueryCandidateIntersectionTriangleEXT)
        {
            continue;
        }
        candidates++;
        if (candidates > 64u ||
            HybridReflectionCandidatePasses(query))
        {
            rayQueryConfirmIntersectionEXT(query);
            if (candidates > 64u)
                rayQueryTerminateEXT(query);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT)
    {
        return false;
    }
    return RayQuerySurfaceResolveCommittedHit(query, origin, direction, hit);
}

bool HybridVisible(vec3 origin, vec3 direction, float maximumDistance)
{
    rayQueryEXT query;
    rayQueryInitializeEXT(query, SceneTlas,
        gl_RayFlagsTerminateOnFirstHitEXT, 0xff,
        origin, 0.002, direction, maximumDistance);
    uint candidates = 0u;
    while (rayQueryProceedEXT(query))
    {
        if (rayQueryGetIntersectionTypeEXT(query, false) !=
            gl_RayQueryCandidateIntersectionTriangleEXT)
        {
            continue;
        }
        candidates++;
        if (candidates > 64u ||
            HybridReflectionCandidatePasses(query))
        {
            rayQueryConfirmIntersectionEXT(query);
            rayQueryTerminateEXT(query);
        }
    }
    return rayQueryGetIntersectionTypeEXT(query, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 HybridSampleEmissive(RayQuerySurfaceHit hit)
{
    vec3 sampleValue = vec3(1.0);
    if (GiMaterialHasFlag(hit.Material.TransportFlags,
            GI_MATERIAL_HAS_EMISSIVE_TEXTURE) &&
        hit.Material.EmissiveTextureIndex >= FIRST_TEXTURE_INDEX &&
        hit.Material.EmissiveTextureIndex < FIRST_TEXTURE_INDEX + MAX_TEXTURES)
    {
        sampleValue = textureLod(
            BindlessTextures[nonuniformEXT(hit.Material.EmissiveTextureIndex)],
            RayQuerySurfaceMaterialUv(hit,
                hit.Material.TextureTexCoordSets.w,
                hit.Material.EmissiveOffsetScale,
                hit.Material.TextureRotations.w),
            max(hit.Material.DdgiMaterialPolicy.y, 0.0)).rgb;
    }
    return max(hit.Material.Emissive.rgb * sampleValue, vec3(0.0));
}

vec3 HybridEvaluatePbrLight(
    vec3 albedo,
    float metallic,
    float roughness,
    vec3 normal,
    vec3 viewDirection,
    vec3 lightDirection,
    vec3 incidentRadiance)
{
    float nDotL = max(dot(normal, lightDirection), 0.0);
    float nDotV = max(dot(normal, viewDirection), 0.0);
    if (nDotL <= 0.0 || nDotV <= 0.0)
        return vec3(0.0);
    vec3 halfVector = normalize(viewDirection + lightDirection);
    float nDotH = max(dot(normal, halfVector), 0.0);
    float hDotV = max(dot(halfVector, viewDirection), 0.0);
    vec3 f0 = mix(vec3(0.04), albedo, metallic);
    vec3 fresnel = HybridFresnelSchlick(hDotV, f0);
    float distribution = HybridDistributionGgx(nDotH, roughness);
    float geometry = HybridGeometrySmith(nDotV, nDotL, roughness);
    vec3 specular = distribution * geometry * fresnel /
        max(4.0 * nDotV * nDotL, 1.0e-6);
    vec3 diffuse = (vec3(1.0) - fresnel) *
        (1.0 - metallic) * albedo / HYBRID_REFLECTION_PI;
    return (diffuse + specular) * incidentRadiance * nDotL;
}

vec3 HybridEvaluateSelectedHitLight(
    RayQuerySurfaceHit hit,
    vec3 albedo,
    float metallic,
    float roughness,
    vec3 normal,
    vec3 viewDirection,
    GPULight light,
    uint sampleOrdinal)
{
    if (NjulfIsAreaLight(light))
    {
        vec3 specularF0 = mix(vec3(0.04), albedo, metallic);
        NjulfAreaLightResult area = EvaluateNjulfAreaLightLtc(
            light,
            hit.Position,
            normal,
            viewDirection,
            roughness,
            albedo * (1.0 - metallic),
            specularF0);
        if (area.rangeAttenuation <= 0.0)
            return vec3(0.0);
        uint state = floatBitsToUint(hit.Position.x) ^
            floatBitsToUint(hit.Position.y) * 0x9e3779b9u ^
            floatBitsToUint(hit.Position.z) * 0x85ebca6bu ^
            light.StableIdentity ^ pc.TemporalSampleIndex * 0xc2b2ae35u ^
            sampleOrdinal * 0x27d4eb2fu;
        state ^= state >> 16u;
        vec3 random = vec3(
            float(state & 0x00ffffffu) * (1.0 / 16777216.0),
            float((state * 1664525u + 1013904223u) & 0x00ffffffu) *
                (1.0 / 16777216.0),
            float((state * 22695477u + 1u) & 0x00ffffffu) *
                (1.0 / 16777216.0));
        NjulfAreaSurfaceSample emitter = NjulfSampleAreaLightSurface(
            light, random);
        if (emitter.valid &&
            (uint(light.ShadowFlags) &
                GPU_LIGHT_SHADOW_FLAG_CASTS_SHADOWS) != 0u)
        {
            vec3 toEmitter = emitter.position - hit.Position;
            float emitterDistance = length(toEmitter);
            if (emitterDistance > 0.004 &&
                !HybridVisible(hit.Position + normal * 0.004,
                    toEmitter / emitterDistance,
                    max(emitterDistance - 0.004, 0.002)))
            {
                return vec3(0.0);
            }
        }
        return area.lighting;
    }

    vec3 lightDirection;
    float attenuation = 1.0;
    float maximumDistance = pc.CameraPositionAndMaximumDistance.w;
    bool local = NjulfIsLocalLight(light);
    if (local)
    {
        if (!NjulfIsPunctualLight(light))
            return vec3(0.0);
        vec3 toLight = light.Position - hit.Position;
        maximumDistance = length(toLight);
        if (!HybridFinite(maximumDistance) || maximumDistance <= 0.002 ||
            maximumDistance >= light.Range || light.Range <= 0.0)
        {
            return vec3(0.0);
        }
        lightDirection = toLight / maximumDistance;
        attenuation = EvaluateNjulfLightDistanceAttenuation(
            light, maximumDistance);
        attenuation *= EvaluateNjulfIesProfile(light, -lightDirection);
        if (light.Type == GPU_LIGHT_TYPE_SPOT)
            attenuation *= EvaluateNjulfSpotAttenuation(
                light, lightDirection);
    }
    else
    {
        lightDirection = normalize(-light.Direction);
    }
    if (dot(normal, lightDirection) <= 0.0 || attenuation <= 0.0 ||
        !HybridVisible(hit.Position + normal * 0.004,
            lightDirection, max(maximumDistance - 0.004, 0.002)))
    {
        return vec3(0.0);
    }
    vec3 incident = max(light.Color, vec3(0.0)) *
        max(light.Intensity, 0.0) * attenuation;
    return HybridEvaluatePbrLight(albedo, metallic, roughness,
        normal, viewDirection, lightDirection, incident);
}

vec3 HybridShadeHit(
    RayQuerySurfaceHit hit,
    vec3 incomingDirection,
    uint sampleSeed)
{
    vec3 normal = RayQuerySurfaceOrientedNormal(hit);
    vec3 viewDirection = normalize(-incomingDirection);
    vec4 baseColor = RayQuerySurfaceSampleBaseColor(hit);
    vec2 metallicRoughness = RayQuerySurfaceSampleMetallicRoughness(hit);
    vec3 albedo = max(baseColor.rgb, vec3(0.0));
    float metallic = metallicRoughness.x;
    float roughness = clamp(metallicRoughness.y, 0.04, 1.0);
    vec3 radiance = HybridSampleEmissive(hit);

    uint directionalCount = min(pc.DirectionalLightCount, pc.LightCount);
    for (uint lightIndex = 0u;
         lightIndex < directionalCount;
         lightIndex++)
    {
        GPULight light = ReadLight(lightIndex);
        if (light.Type == GPU_LIGHT_TYPE_DIRECTIONAL)
        {
            radiance += HybridEvaluateSelectedHitLight(
                hit, albedo, metallic, roughness, normal,
                viewDirection, light, lightIndex);
        }
    }

    uint localSamples = min(pc.MaximumShadedLights, 4u);
    bool sampledTree = localSamples == 0u || pc.LocalLightCount == 0u;
    DdgiLightTreeState treeState = DdgiReadLightTreeState();
    if (!sampledTree &&
        (treeState.flags & DDGI_LIGHT_TREE_STATE_VALID_BIT) != 0u &&
        treeState.paddedLeafCount != 0u &&
        DdgiLightTreeStateMatchesCurrentLightBuffer(
            treeState, pc.LightCount, pc.LocalLightCount))
    {
        sampledTree = true;
        uvec2 stableKey = uvec2(sampleSeed, HybridHash(sampleSeed));
        for (uint sampleOrdinal = 0u;
             sampleOrdinal < localSamples;
             sampleOrdinal++)
        {
            DdgiLightTreeSample selected = DdgiSampleLocalLightTree(
                hit.Position,
                stableKey,
                sampleSeed,
                pc.TemporalSampleIndex,
                pc.TemporalSampleIndex,
                sampleOrdinal,
                0.05);
            if (!selected.valid ||
                selected.packedLightIndex >= pc.LightCount ||
                !(selected.pdf > 0.0))
            {
                sampledTree = false;
                break;
            }
            GPULight light = ReadLight(selected.packedLightIndex);
            if (!NjulfIsLocalLight(light) ||
                light.StableIdentity != selected.stableLightIdentity)
            {
                sampledTree = false;
                break;
            }
            vec3 contribution = HybridEvaluateSelectedHitLight(
                hit, albedo, metallic, roughness, normal,
                viewDirection, light, sampleOrdinal);
            radiance += contribution /
                max(float(localSamples) * selected.pdf, 1.0e-6);
        }
    }

    if (!sampledTree)
    {
        // Stale or incomplete hierarchy: inspect only the same bounded number
        // of stable local entries, never the full local-light list.
        uint accepted = 0u;
        for (uint lightIndex = directionalCount;
             lightIndex < pc.LightCount && accepted < localSamples;
             lightIndex++)
        {
            GPULight light = ReadLight(lightIndex);
            if (!NjulfIsLocalLight(light))
                continue;
            radiance += HybridEvaluateSelectedHitLight(
                hit, albedo, metallic, roughness, normal,
                viewDirection, light, accepted);
            accepted++;
        }
    }

    if (pc.DdgiEnabled != 0u)
    {
        vec3 irradiance = SampleSimpleDdgiIrradiance(
            hit.Position, normal, viewDirection);
        radiance += max(irradiance, vec3(0.0)) *
            albedo * (1.0 - metallic) / HYBRID_REFLECTION_PI;
    }

    GPUEnvironmentData environment = ReadEnvironmentData();
    if (environment.Enabled != 0u)
    {
        vec3 reflected = reflect(-viewDirection, normal);
        float maximumLod = max(
            float(environment.PrefilteredMipCount) - 1.0, 0.0);
        vec3 environmentRadiance = SampleEnvironmentPrefilteredRadiance(
            environment, reflected, roughness * maximumLod) *
            max(environment.SpecularIntensity, 0.0);
        float nDotV = max(dot(normal, viewDirection), 0.0);
        vec3 f0 = mix(vec3(0.04), albedo, metallic);
        radiance += environmentRadiance *
            HybridFresnelSchlickRoughness(nDotV, f0, roughness);
    }
    return clamp(radiance, vec3(0.0), vec3(65504.0));
}

void main()
{
    uint taskIndex = gl_GlobalInvocationID.x;
    uint taskCount = min(HybridTaskCount,
        min(HybridTaskCapacity, pc.TaskCapacity));
    if (taskIndex >= taskCount)
        return;
    atomicAdd(HybridCounters[
        HYBRID_REFLECTION_COUNTER_RAY_QUERIES], 1u);

    uvec4 task = HybridTasks[taskIndex].Primary;
    uvec2 lobeExtension =
        HybridTasks[taskIndex].LobeExtension.xy;
    uvec2 pixel = task.xy;
    if (pixel.x >= pc.ScreenWidth || pixel.y >= pc.ScreenHeight)
    {
        atomicAdd(HybridCounters[
            HYBRID_REFLECTION_COUNTER_RAY_MISSES], 1u);
        return;
    }
    ivec2 coordinate = ivec2(pixel);
    uvec4 payload = texelFetch(HybridReceiverPayload, coordinate, 0);
    uint identity = task.w & NJULF_HYBRID_REFLECTION_IDENTITY_MASK;
    uint lobeId = (task.w >> 22u) & 0x1u;
    if (!HybridReflectionPayloadValid(payload) ||
        HybridReceiverIdentity(payload) != identity)
    {
        atomicAdd(HybridCounters[
            HYBRID_REFLECTION_COUNTER_RAY_MISSES], 1u);
        return;
    }

    vec3 worldPosition;
    float depth;
    if (!HybridReconstructWorldPosition(coordinate,
            uvec2(pc.ScreenWidth, pc.ScreenHeight),
            pc.InverseViewProjectionMatrix,
            worldPosition, depth))
    {
        atomicAdd(HybridCounters[
            HYBRID_REFLECTION_COUNTER_RAY_MISSES], 1u);
        return;
    }
    vec3 geometricNormal = HybridReflectionPayloadGeometricNormal(payload);
    vec3 baseNormal = HybridReflectionTraceNormal(payload);
    vec3 clearcoatNormal;
    float clearcoatFactor;
    float clearcoatRoughness;
    float anisotropyStrength;
    vec3 tangent;
    NjulfHybridReflectionDecodeLobeExtension(
        lobeExtension,
        HybridReflectionPayloadShadingNormal(payload),
        clearcoatNormal,
        clearcoatFactor,
        clearcoatRoughness,
        anisotropyStrength,
        tangent);
    vec3 traceNormal = lobeId == 0u ? baseNormal : clearcoatNormal;
    float traceRoughness = lobeId == 0u
        ? HybridReflectionPayloadPhysicalRoughness(payload)
        : max(clearcoatRoughness, 0.02);
    float traceAnisotropy = lobeId == 0u ? anisotropyStrength : 0.0;
    vec3 traceTangent = lobeId == 0u
        ? tangent
        : NjulfHybridReflectionCanonicalTangentBasisX(traceNormal);
    vec3 viewDirection = normalize(
        pc.CameraPositionAndMaximumDistance.xyz - worldPosition);
    vec3 reflectionDirection = HybridReflectionSampleDirection(
        viewDirection,
        traceNormal,
        traceTangent,
        traceRoughness,
        traceAnisotropy,
        identity,
        pixel,
        pc.TemporalSampleIndex,
        lobeId);
    if (!HybridFinite(reflectionDirection) ||
        dot(reflectionDirection, geometricNormal) <= 0.001)
    {
        atomicAdd(HybridCounters[
            HYBRID_REFLECTION_COUNTER_RAY_MISSES], 1u);
        return;
    }

    RayQuerySurfaceHit hit;
    if (HybridTraceNearest(
            NjulfOffsetRayOrigin(worldPosition, geometricNormal),
            reflectionDirection,
            pc.CameraPositionAndMaximumDistance.w,
            hit))
    {
        vec3 radiance = HybridShadeHit(
            hit,
            reflectionDirection,
            taskIndex ^ identity ^ (lobeId << 30u));
        float confidence = clamp(1.0 - hit.Distance /
            max(pc.CameraPositionAndMaximumDistance.w, 0.001), 0.65, 1.0);
        if (lobeId == 0u)
        {
            float auxiliary = imageLoad(
                HybridRawRadiance, coordinate).a;
            imageStore(HybridRawRadiance, coordinate,
                vec4(radiance, auxiliary));
        }
        else
        {
            float auxiliary = imageLoad(
                HybridDdgiCohorts, coordinate).a;
            imageStore(HybridDdgiCohorts, coordinate,
                vec4(radiance, auxiliary));
        }
        uvec4 metadata = imageLoad(HybridRawMetadata, coordinate);
        uint packedMetadata = HybridPackMetadata(
            HYBRID_REFLECTION_SOURCE_RAY_QUERY,
            confidence, HYBRID_REFLECTION_REASON_NONE, 0u, true);
        if (lobeId == 0u)
            metadata.x = packedMetadata;
        else
            metadata.y = packedMetadata;
        imageStore(HybridRawMetadata, coordinate, metadata);
        atomicAdd(HybridCounters[HYBRID_REFLECTION_COUNTER_RAY_HITS], 1u);
    }
    else
    {
        atomicAdd(HybridCounters[HYBRID_REFLECTION_COUNTER_RAY_MISSES], 1u);
    }
}
