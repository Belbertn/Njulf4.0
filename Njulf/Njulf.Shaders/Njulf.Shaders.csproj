        <NjulfShaderArtifact Include="forward_opaque_simple_gi_disabled.frag"><Source>$(MSBuildProjectDirectory)\forward.frag</Source><Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DFORWARD_GLOBAL_ILLUMINATION_DISABLED=1</Defines></NjulfShaderArtifact>
        <NjulfShaderArtifact Include="forward_opaque_simple_full_input_gi_disabled.frag"><Source>$(MSBuildProjectDirectory)\forward.frag</Source><Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_GLOBAL_ILLUMINATION_DISABLED=1</Defines></NjulfShaderArtifact>
        <NjulfShaderArtifact Include="forward_weighted_oit.frag"><Source>$(MSBuildProjectDirectory)\forward.frag</Source><Defines>-DFORWARD_WEIGHTED_OIT=1</Defines></NjulfShaderArtifact>
        <NjulfShaderArtifact Include="foliage_forward_ddgi.frag"><Source>$(MSBuildProjectDirectory)\foliage_forward.frag</Source></NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(MaterialTransportProvenanceShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(MaterialTransportProvenanceShaderVariant.Source)</Source>
          <Defines>%(MaterialTransportProvenanceShaderVariant.Defines)</Defines>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(NearFieldDirectSourceShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(NearFieldDirectSourceShaderVariant.Source)</Source>
          <Defines>%(NearFieldDirectSourceShaderVariant.Defines)</Defines>
          <AdditionalCompileOptions>%(NearFieldDirectSourceShaderVariant.AdditionalCompileOptions)</AdditionalCompileOptions>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(ReceiverFeedbackShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(ReceiverFeedbackShaderVariant.Source)</Source>
          <Defines>%(ReceiverFeedbackShaderVariant.Defines)</Defines>
          <AdditionalCompileOptions>%(ReceiverFeedbackShaderVariant.AdditionalCompileOptions)</AdditionalCompileOptions>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(ReceiverFeedbackGraphicsShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(ReceiverFeedbackGraphicsShaderVariant.Source)</Source>
          <Defines>%(ReceiverFeedbackGraphicsShaderVariant.Defines)</Defines>
          <CompileOptions>$(NjulfReceiverFeedbackGraphicsCompileOptions)</CompileOptions>
          <AdditionalCompileOptions>%(ReceiverFeedbackGraphicsShaderVariant.AdditionalCompileOptions)</AdditionalCompileOptions>
        </NjulfShaderArtifact>
      </ItemGroup>

      <CompileNjulfShaderArtifacts Artifacts="@(NjulfShaderArtifact)"
                                      ShaderRoot="$(MSBuildProjectDirectory)"
                                      IntermediateShaderDirectory="$(IntermediateOutputPath)Shaders"
                                      CacheDirectory="$(NjulfShaderCacheDirectory)"
                                      CompilerPath="$(NjulfGlslangValidator)"
                                      GlobalCompileOptions="$(NjulfShaderCompileOptions)"
                                      MaxParallelism="$(NjulfShaderMaxParallelism)"
                                      CacheMode="$(NjulfShaderCacheMode)"
                                      BuildMode="$(NjulfShaderBuildMode)">
        <Output TaskParameter="BundleManifestPath" PropertyName="NjulfShaderBundleManifest" />
        <Output TaskParameter="BundleHash" PropertyName="NjulfShaderBundleHash" />
      </CompileNjulfShaderArtifacts>

      <ItemGroup>
        <AssemblyMetadata Include="NjulfShaderBundleHash"
                          Value="$(NjulfShaderBundleHash)" />
        <EmbeddedResource Include="@(NjulfShaderArtifact -&gt; '$(IntermediateOutputPath)Shaders\%(Identity).spv')">
          <LogicalName>Njulf.Shaders.%(NjulfShaderArtifact.Identity)</LogicalName>
        </EmbeddedResource>
      </ItemGroup>
      <ItemGroup>
        <FileWrites Include="$(IntermediateOutputPath)Shaders\*.spv;$(IntermediateOutputPath)Shaders\.state\*.json;$(IntermediateOutputPath)Shaders\njulf-shaders.manifest.json;$(IntermediateOutputPath)Shaders\production-validation.stamp" />
      </ItemGroup>
    </Target>

    <Target Name="VerifyProductionDdgiDiagnosticAtomics"
            AfterTargets="CompileNjulfShaders"
            Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ShippingPerformance' or '$(Configuration)' == 'ProfileSymbols'"
            Inputs="$(NjulfShaderBundleManifest);$(MSBuildProjectDirectory)\VerifyProductionDiagnosticAtomics.ps1;$(MSBuildProjectDirectory)\VerifySimpleDdgiReceiverContract.ps1"
            Outputs="$(IntermediateOutputPath)Shaders\production-validation.stamp">
      <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\VerifyProductionDiagnosticAtomics.ps1&quot; -ShaderDirectory &quot;$(IntermediateOutputPath)Shaders&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />
      <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\VerifySimpleDdgiReceiverContract.ps1&quot; -ShaderDirectory &quot;$(IntermediateOutputPath)Shaders&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />
      <Touch Files="$(IntermediateOutputPath)Shaders\production-validation.stamp" AlwaysCreate="true" />
    </Target>

</Project>
