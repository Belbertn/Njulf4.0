<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
      <ShaderSource Include="*.task;*.mesh;*.vert;*.frag;*.comp" />
      <ShaderInclude Include="*.glsl" />
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_source.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>1</Role>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>2</Role>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_final.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>3</Role>
      </SimpleDdgiTraceShaderVariant>
      <!-- Validate retains the Legacy36/32-byte rollback ABI. Specialize its
           native-driver program to that single representation and opt only
           the detailed-build direction shadow comparison back in. -->
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_source.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>1</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>2</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_final.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>3</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_source.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>1</Role>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>2</Role>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_final.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>3</Role>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_legacy.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_validate.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_packed.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>2</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_legacy.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_validate.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_packed.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>2</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiAuditShaderVariant Include="ddgi_simple_transport_audit_legacy.comp">
        <Source>ddgi_simple_transport_audit.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>2</Role>
      </SimpleDdgiAuditShaderVariant>
      <SimpleDdgiAuditShaderVariant Include="ddgi_simple_transport_audit_validate.comp">
        <Source>ddgi_simple_transport_audit.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>2</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiAuditShaderVariant>
      <SimpleDdgiAuditShaderVariant Include="ddgi_simple_transport_audit_packed.comp">
        <Source>ddgi_simple_transport_audit.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>2</Role>
      </SimpleDdgiAuditShaderVariant>
      <SimpleDdgiAuditShaderVariant Include="ddgi_simple_transport_audit_reduce_legacy.comp">
        <Source>ddgi_simple_transport_audit.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>3</Role>
      </SimpleDdgiAuditShaderVariant>
      <SimpleDdgiAuditShaderVariant Include="ddgi_simple_transport_audit_reduce_validate.comp">
        <Source>ddgi_simple_transport_audit.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>3</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiAuditShaderVariant>
      <SimpleDdgiAuditShaderVariant Include="ddgi_simple_transport_audit_reduce_packed.comp">
        <Source>ddgi_simple_transport_audit.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>3</Role>
      </SimpleDdgiAuditShaderVariant>
      <!-- Admission's generic policy and mutually-exclusive tail source/solve
           policy share one source, but compile into separate native programs.
           This removes the generic private quota workspace from the
           latency-sensitive tail program without creating a second algorithm. -->
      <SimpleDdgiAdmissionShaderVariant Include="ddgi_simple_schedule_admit_tail.comp">
        <Source>ddgi_simple_schedule_admit.comp</Source>
        <Role>1</Role>
      </SimpleDdgiAdmissionShaderVariant>
      <GpuDiagnosticTaskShader Include="depth.task;forward.task;forward_compacted.task" />
      <ForwardSimpleFragmentShader Include="forward.frag" />
      <ForwardWeightedOitFragmentShader Include="forward.frag" />
      <FoliageForwardFragmentShader Include="foliage_forward.frag" />
      <MaterialTransportProvenanceShaderVariant Include="forward_opaque_ddgi_provenance.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_OPAQUE=1 -DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <MaterialTransportProvenanceShaderVariant Include="forward_opaque_simple_ddgi_provenance.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <MaterialTransportProvenanceShaderVariant Include="forward_opaque_simple_full_input_ddgi_provenance.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <MaterialTransportProvenanceShaderVariant Include="foliage_forward_ddgi_provenance.frag">
        <Source>foliage_forward.frag</Source>
        <Defines>-DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <None Update="common.glsl" TargetPath="Shaders\common.glsl">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="ShaderLibrary.cs">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Compile>
    </ItemGroup>

    <PropertyGroup>
      <NjulfShaderOptimizationOptions Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ShippingPerformance' or '$(Configuration)' == 'ProfileSymbols' or '$(Configuration)' == 'DetailedInvestigation'">-Os</NjulfShaderOptimizationOptions>
      <NjulfShaderDebugInformation Condition="'$(NJULF_SHADER_PROFILE)' == '1'">true</NjulfShaderDebugInformation>
      <NjulfShaderDebugOptions Condition="'$(NjulfShaderDebugInformation)' == 'true'">-gVS</NjulfShaderDebugOptions>
      <NjulfShaderDetailedDiagnosticsOptions>-DNJULF_DDGI_DETAILED_COUNTERS=0</NjulfShaderDetailedDiagnosticsOptions>
      <NjulfShaderDetailedDiagnosticsOptions Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'DetailedInvestigation'">-DNJULF_DDGI_DETAILED_COUNTERS=1</NjulfShaderDetailedDiagnosticsOptions>
      <NjulfShaderCompileOptions>$(NjulfShaderOptimizationOptions) $(NjulfShaderDebugOptions) $(NjulfShaderDetailedDiagnosticsOptions)</NjulfShaderCompileOptions>
    </PropertyGroup>

    <Target Name="RemoveObsoleteGiShaderArtifacts"
            BeforeTargets="CompileNjulfShaders">
      <ItemGroup>
        <!-- Clean every previously built configuration, not just the active
             output folder. This prevents removed SSGI or pre-specialization
             forward binaries from surviving in an old ProfileSymbols or
             DetailedInvestigation directory and being picked up by packaging. -->
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\*ssgi*.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\*ssgi*.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward_opaque.frag.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward_opaque.frag.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward_opaque_provenance.frag.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward_opaque_provenance.frag.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward_opaque_simple.frag.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward_opaque_simple.frag.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward_opaque_simple_provenance.frag.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward_opaque_simple_provenance.frag.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward_opaque_simple_full_input.frag.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward_opaque_simple_full_input.frag.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward_opaque_simple_full_input_provenance.frag.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward_opaque_simple_full_input_provenance.frag.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\ddgi_simple_trace_legacy.comp.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\ddgi_simple_trace_legacy.comp.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\ddgi_simple_trace_packed.comp.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\ddgi_simple_trace_packed.comp.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\ddgi_simple_transport_solve.comp.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\ddgi_simple_transport_solve.comp.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\ddgi_simple_transport_audit_prepare_*.comp.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\ddgi_simple_transport_audit_prepare_*.comp.spv" />
        <ObsoleteGiShaderArtifact Include="$(MSBuildProjectDirectory)\obj\**\Shaders\forward*_receiver_cache.mesh.spv;$(MSBuildProjectDirectory)\bin\**\Shaders\forward*_receiver_cache.mesh.spv" />
      </ItemGroup>
      <Delete Files="@(ObsoleteGiShaderArtifact)" />
    </Target>

    <Target Name="CompileNjulfShaders"
            BeforeTargets="AssignTargetPaths"
            Inputs="@(ShaderSource);@(ShaderInclude);$(MSBuildProjectFullPath)"
            Outputs="@(ShaderSource -> '$(IntermediateOutputPath)Shaders\%(Filename)%(Extension).spv');@(SimpleDdgiTraceShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiTransportShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiAuditShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiAdmissionShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(GpuDiagnosticTaskShader -> '$(IntermediateOutputPath)Shaders\%(Filename)_diagnostics%(Extension).spv');@(MaterialTransportProvenanceShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');$(IntermediateOutputPath)Shaders\forward_compacted.mesh.spv;$(IntermediateOutputPath)Shaders\forward_simple_compacted.mesh.spv;$(IntermediateOutputPath)Shaders\forward_opaque_ddgi.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_ddgi_cache_required.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi_cache_required.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi_cache_required.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_gi_disabled.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_gi_disabled.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_gi_disabled.frag.spv;$(IntermediateOutputPath)Shaders\forward_weighted_oit.frag.spv;$(IntermediateOutputPath)Shaders\foliage_forward_ddgi.frag.spv">
      <MakeDir Directories="$(IntermediateOutputPath)Shaders" />
      <MakeDir Directories="$(OutDir)Shaders" />

      <Exec Command="glslangValidator --version"
            StandardOutputImportance="Low"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(ShaderSource.Filename)%(ShaderSource.Extension).spv&quot; &quot;%(ShaderSource.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) %(SimpleDdgiTraceShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiTraceShaderVariant.StorageMode) -DSIMPLE_DDGI_TRACE_SHADER_ROLE=%(SimpleDdgiTraceShaderVariant.Role) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(SimpleDdgiTraceShaderVariant.Identity).spv&quot; &quot;$(MSBuildProjectDirectory)\%(SimpleDdgiTraceShaderVariant.Source)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) %(SimpleDdgiTransportShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiTransportShaderVariant.StorageMode) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(SimpleDdgiTransportShaderVariant.Identity).spv&quot; &quot;$(MSBuildProjectDirectory)\%(SimpleDdgiTransportShaderVariant.Source)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) %(SimpleDdgiAuditShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiAuditShaderVariant.StorageMode) -DSIMPLE_DDGI_AUDIT_SHADER_ROLE=%(SimpleDdgiAuditShaderVariant.Role) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(SimpleDdgiAuditShaderVariant.Identity).spv&quot; &quot;$(MSBuildProjectDirectory)\%(SimpleDdgiAuditShaderVariant.Source)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DSIMPLE_DDGI_SCHEDULER_ADMISSION_ROLE=%(SimpleDdgiAdmissionShaderVariant.Role) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(SimpleDdgiAdmissionShaderVariant.Identity).spv&quot; &quot;$(MSBuildProjectDirectory)\%(SimpleDdgiAdmissionShaderVariant.Source)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_COMPACTED_MESH=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_compacted.mesh.spv&quot; &quot;$(MSBuildProjectDirectory)\forward.mesh&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_COMPACTED_MESH=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_simple_compacted.mesh.spv&quot; &quot;$(MSBuildProjectDirectory)\forward_simple.mesh&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DNJULF_GPU_DIAGNOSTIC_COUNTERS=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(GpuDiagnosticTaskShader.Filename)_diagnostics%(GpuDiagnosticTaskShader.Extension).spv&quot; &quot;%(GpuDiagnosticTaskShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <!-- The base opaque artifacts are exact, cache-independent fallbacks.
           Cache-required artifacts are separate native programs so production
           raster cannot retain the large sparse-gather control-flow graph. -->
      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_OPAQUE=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_ddgi.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_SIMPLE_OPAQUE=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_OPAQUE=1 -DFORWARD_DDGI_RECEIVER_CACHE=1 -DFORWARD_DDGI_RECEIVER_CACHE_REQUIRED=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_ddgi_cache_required.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DFORWARD_DDGI_RECEIVER_CACHE=1 -DFORWARD_DDGI_RECEIVER_CACHE_REQUIRED=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi_cache_required.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_DDGI_RECEIVER_CACHE=1 -DFORWARD_DDGI_RECEIVER_CACHE_REQUIRED=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi_cache_required.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_OPAQUE=1 -DFORWARD_GLOBAL_ILLUMINATION_DISABLED=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_gi_disabled.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DFORWARD_GLOBAL_ILLUMINATION_DISABLED=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_simple_gi_disabled.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_GLOBAL_ILLUMINATION_DISABLED=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_gi_disabled.frag.spv&quot; &quot;%(ForwardSimpleFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -DFORWARD_WEIGHTED_OIT=1 -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\forward_weighted_oit.frag.spv&quot; &quot;%(ForwardWeightedOitFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\foliage_forward_ddgi.frag.spv&quot; &quot;%(FoliageForwardFragmentShader.FullPath)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Exec Command="glslangValidator -V --target-env vulkan1.3 $(NjulfShaderCompileOptions) %(MaterialTransportProvenanceShaderVariant.Defines) -I&quot;$(MSBuildProjectDirectory)&quot; -o &quot;$(IntermediateOutputPath)Shaders\%(MaterialTransportProvenanceShaderVariant.Identity).spv&quot; &quot;$(MSBuildProjectDirectory)\%(MaterialTransportProvenanceShaderVariant.Source)&quot;"
            StandardOutputImportance="High"
            StandardErrorImportance="High" />

      <Copy SourceFiles="@(ShaderSource -> '$(IntermediateOutputPath)Shaders\%(Filename)%(Extension).spv')"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="@(SimpleDdgiTraceShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv')"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="@(SimpleDdgiTransportShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv')"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="@(SimpleDdgiAuditShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv')"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="@(SimpleDdgiAdmissionShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv')"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="$(IntermediateOutputPath)Shaders\forward_compacted.mesh.spv;$(IntermediateOutputPath)Shaders\forward_simple_compacted.mesh.spv"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="@(GpuDiagnosticTaskShader -> '$(IntermediateOutputPath)Shaders\%(Filename)_diagnostics%(Extension).spv')"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="$(IntermediateOutputPath)Shaders\forward_opaque_ddgi.frag.spv"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi.frag.spv"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

      <Copy SourceFiles="$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi.frag.spv"
            DestinationFolder="$(OutDir)Shaders"
            SkipUnchangedFiles="true" />

