#version 460
#extension GL_GOOGLE_include_directive : require

#include "ddgi_near_field_residual.glsl"

// C5 trace only owns a direct-diffuse-plus-emissive source attachment and
// receiver/depth metadata.  It deliberately has no descriptor for final scene
// colour, DDGI, C4 photons/cache, IBL, reflections, fog, or prior history.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D directDiffuseEmissiveSource;
layout(set = 0, binding = 1) uniform sampler2D depthHierarchy;
layout(set = 0, binding = 2) uniform sampler2D preparedDepthFootprint;
// One integer payload replaces four full-resolution auxiliary MRTs. It owns
// octahedral normals, a 16-bit frame-local surface token, RGB9E5 diffuse base,
// and RGB565 dielectric F0.
layout(set = 0, binding = 3) uniform usampler2D preparedReceiverPayload;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D rawResidualOutput;
layout(std430, set = 0, binding = 5) buffer TraceHitMetadataBuffer
{
    SimpleDdgiNearFieldResidualHitMetadata values[];
} traceHitMetadata;
// Words 0..2 are reset/dispatch counters.  Each 8x8 workgroup owns one
// four-word tile record beginning at word 3, so this raw layout exactly matches
// the existing 3-word-header + 16-byte-per-tile C5 allocation formula without
// std430 struct-alignment padding.
layout(std430, set = 0, binding = 6) buffer TraceTileRecordsBuffer
{
    uint words[];
} traceTileRecords;
layout(std430, set = 0, binding = 7) readonly buffer TraceFrameConstantsBuffer
{
    SimpleDdgiNearFieldResidualTraceFrameConstants frame;
} traceFrameConstants;
layout(std430, set = 0, binding = 8) readonly buffer TraceSurfaceTableBuffer
{
    SimpleDdgiNearFieldSurfaceEntry values[];
} traceSurfaceTable;
layout(std430, set = 0, binding = 9) readonly buffer TraceActiveTileBuffer
{
    uint words[];
} traceActiveTiles;
layout(set = 0, binding = 10) uniform usampler2D fullReceiverPayload;
layout(set = 0, binding = 11) uniform sampler2D sourceLuminance;

layout(push_constant) uniform NearFieldTracePushBlock
{
    SimpleDdgiNearFieldResidualTracePushConstants pc;
};

shared float c5TileConfidence[64];
shared uint c5TileValid[64];
shared uint c5TileHit[64];
shared uint c5TileCovered[64];
shared uint c5TileReasonFlags[64];
shared uint c5TileRayLaunched[64];
shared uint c5TileTraceSteps[64];
shared uint c5TileMipVisits[64];
shared uint c5TileMaximumTraceSteps[64];
shared uint c5TileMaximumMipVisits[64];
shared uint c5TileRefinementVisits[64];
// Complete binary sum tree: node 1 is the tile total and leaves 64..127
// correspond to the active 8x8 tile. Multi-ray tiers build it once per tile.
shared float c5SourceLuminanceHierarchy[128];

const uint C5_TRACE_REASON_SCREEN_EXIT = 1u << 0u;
const uint C5_TRACE_REASON_INVALID_RECEIVER = 1u << 1u;
const uint C5_TRACE_REASON_INVALID_RAY = 1u << 2u;
const uint C5_TRACE_REASON_STEP_BUDGET = 1u << 3u;
const uint C5_TRACE_REASON_MIP_BUDGET = 1u << 4u;
const uint C5_TRACE_REASON_DEPTH = 1u << 5u;
const uint C5_TRACE_REASON_NORMAL = 1u << 6u;
const uint C5_TRACE_REASON_SOURCE = 1u << 7u;
const uint C5_TRACE_REASON_NONFINITE = 1u << 8u;
const uint C5_TRACE_REASON_MISS = 1u << 9u;

bool IsInsideUv(vec2 uv)
{
    return all(greaterThanEqual(uv, vec2(0.0))) &&
        all(lessThan(uv, vec2(1.0)));
}

bool CrossesDepth(float rayDepth, float sceneDepth, float thickness, bool reversedZ)
{
    return reversedZ
        ? rayDepth <= sceneDepth + thickness
        : rayDepth >= sceneDepth - thickness;
}

vec4 C5MulRowMajor(vec4 value, mat4 matrix)
{
    return vec4(
        dot(value, vec4(matrix[0][0], matrix[1][0], matrix[2][0], matrix[3][0])),
        dot(value, vec4(matrix[0][1], matrix[1][1], matrix[2][1], matrix[3][1])),
        dot(value, vec4(matrix[0][2], matrix[1][2], matrix[2][2], matrix[3][2])),
        dot(value, vec4(matrix[0][3], matrix[1][3], matrix[2][3], matrix[3][3])));
}

bool C5Finite(vec4 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool C5ReconstructWorldPosition(vec2 uv, float depth, out vec3 worldPosition)
{
    worldPosition = vec3(0.0);
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    vec4 world = C5MulRowMajor(
        clip, traceFrameConstants.frame.inverseViewProjection);
    if (!C5Finite(world) || abs(world.w) <= 1.0e-7)
        return false;
    worldPosition = world.xyz / world.w;
    return SimpleDdgiNearFieldFinite(worldPosition);
}

float C5PositiveLinearDepth(float storedDepth)
{
    float nearPlane = max(traceFrameConstants.frame.clipAndSequence.x, 0.001);
    float farPlane = max(traceFrameConstants.frame.clipAndSequence.y,
        nearPlane + 0.01);
    bool reversedZ = SimpleDdgiNearFieldHasFlag(
        pc.flags, SIMPLE_DDGI_NEAR_FIELD_FLAG_REVERSED_Z);
    float denominator = reversedZ
        ? nearPlane + storedDepth * (farPlane - nearPlane)
        : farPlane - storedDepth * (farPlane - nearPlane);
    return nearPlane * farPlane / max(denominator, 1.0e-7);
}

float C5StoredDepthFromPositiveLinear(float linearDepth)
{
    float nearPlane = max(traceFrameConstants.frame.clipAndSequence.x, 0.001);
    float farPlane = max(traceFrameConstants.frame.clipAndSequence.y,
        nearPlane + 0.01);
    float reciprocalTerm = nearPlane * farPlane / max(linearDepth, nearPlane);
    bool reversedZ = SimpleDdgiNearFieldHasFlag(
        pc.flags, SIMPLE_DDGI_NEAR_FIELD_FLAG_REVERSED_Z);
    return reversedZ
        ? (reciprocalTerm - nearPlane) / (farPlane - nearPlane)
        : (farPlane - reciprocalTerm) / (farPlane - nearPlane);
}

bool C5ReconstructWorldPositionFromLinear(
    vec2 uv,
    float linearDepth,
    out vec3 worldPosition)
{
    return C5ReconstructWorldPosition(
        uv, C5StoredDepthFromPositiveLinear(linearDepth), worldPosition);
}

float C5ReceiverPixelFootprintMeters(
    vec2 uv,
    float linearDepth,
    vec3 receiverWorldPosition)
{
    vec2 inverseExtent = traceFrameConstants.frame.fullExtentAndInverse.zw;
    vec2 xUv = vec2(
        uv.x + (uv.x + inverseExtent.x < 1.0
            ? inverseExtent.x : -inverseExtent.x),
        uv.y);
    vec2 yUv = vec2(
        uv.x,
        uv.y + (uv.y + inverseExtent.y < 1.0
            ? inverseExtent.y : -inverseExtent.y));
    vec3 xWorld;
    vec3 yWorld;
    if (!C5ReconstructWorldPositionFromLinear(xUv, linearDepth, xWorld) ||
        !C5ReconstructWorldPositionFromLinear(yUv, linearDepth, yWorld))
        return 0.0;
    float footprint = max(
        length(xWorld - receiverWorldPosition),
        length(yWorld - receiverWorldPosition));
    return SimpleDdgiNearFieldFinite(footprint)
        ? max(footprint, 0.0)
        : 0.0;
}

bool C5CreateProjectedRay(
    vec3 receiverWorldPosition,
    vec3 direction,
    float receiverPixelFootprintMeters,
    out vec4 startClip,
    out vec4 endClip)
{
    float startBiasMeters = max(0.001,
        receiverPixelFootprintMeters * max(pc.startBias, 0.0));
    vec3 startWorldPosition = receiverWorldPosition +
        direction * startBiasMeters;
    vec3 endWorldPosition = receiverWorldPosition +
        direction * pc.maximumTraceDistance;
    startClip = C5MulRowMajor(vec4(startWorldPosition, 1.0),
        traceFrameConstants.frame.viewProjection);
    endClip = C5MulRowMajor(vec4(endWorldPosition, 1.0),
        traceFrameConstants.frame.viewProjection);
    return C5Finite(startClip) && C5Finite(endClip);
}

float C5PerspectiveLineParameter(
    float screenParameter,
    float startW,
    float endW)
{
    float startWeight = (1.0 - screenParameter) / startW;
    float endWeight = screenParameter / endW;
    float weightSum = startWeight + endWeight;
    return abs(weightSum) > 1.0e-8
        ? clamp(endWeight / weightSum, 0.0, 1.0)
        : screenParameter;
}

float C5NextCellBoundaryParameter(
    vec2 startPixel,
    vec2 pixelDelta,
    float currentParameter,
    uint mip)
{
    float cellSize = exp2(float(mip));
    vec2 currentPixel = startPixel + pixelDelta * currentParameter;
    float nextParameter = 2.0;
    const float directionEpsilon = 1.0e-7;
    const float parameterEpsilon = 1.0e-7;

    if (abs(pixelDelta.x) > directionEpsilon)
    {
        float cell = floor(currentPixel.x / cellSize);
        float boundary = pixelDelta.x > 0.0
            ? (cell + 1.0) * cellSize
            : cell * cellSize;
        float candidate = currentParameter +
            (boundary - currentPixel.x) / pixelDelta.x;
        if (candidate <= currentParameter + parameterEpsilon)
        {
            boundary += sign(pixelDelta.x) * cellSize;
            candidate = currentParameter +
                (boundary - currentPixel.x) / pixelDelta.x;
        }
        if (candidate > currentParameter)
            nextParameter = min(nextParameter, candidate);
    }

    if (abs(pixelDelta.y) > directionEpsilon)
    {
        float cell = floor(currentPixel.y / cellSize);
        float boundary = pixelDelta.y > 0.0
            ? (cell + 1.0) * cellSize
            : cell * cellSize;
        float candidate = currentParameter +
            (boundary - currentPixel.y) / pixelDelta.y;
        if (candidate <= currentParameter + parameterEpsilon)
        {
            boundary += sign(pixelDelta.y) * cellSize;
            candidate = currentParameter +
                (boundary - currentPixel.y) / pixelDelta.y;
        }
        if (candidate > currentParameter)
            nextParameter = min(nextParameter, candidate);
    }

    // Step a sub-texel distance into the next cell. Without this nudge a ray
    // landing exactly on a negative-direction boundary can revisit the cell
    // it just left due to floating-point rounding.
    float traversalEpsilon = max(
        1.0e-6,
        1.0e-4 / max(max(abs(pixelDelta.x), abs(pixelDelta.y)), 1.0));
    return nextParameter + traversalEpsilon;
}

bool C5ReadSurface(uint token, out SimpleDdgiNearFieldSurfaceEntry surface)
{
    surface.stableObjectId = 0u;
    surface.stableMaterialId = 0u;
    surface.packedObjectMaterialRevisions = 0u;
    surface.coverageMotionFlags = 0u;
    if (token >= SIMPLE_DDGI_NEAR_FIELD_MAX_SURFACE_TABLE_ENTRIES ||
        token >= uint(traceSurfaceTable.values.length()))
    {
        return false;
    }
    surface = traceSurfaceTable.values[token];
    // coverage-valid and motion-valid are bits 4 and 5.
    return surface.stableObjectId != 0u &&
        surface.stableMaterialId != 0u &&
        (surface.coverageMotionFlags & (1u << 4u)) != 0u &&
        (surface.coverageMotionFlags & (1u << 5u)) != 0u;
}

float C5ReadGuideLuminance(ivec2 guidePixel)
{
    ivec2 extent = textureSize(sourceLuminance, 0);
    if (any(lessThan(guidePixel, ivec2(0))) ||
        any(greaterThanEqual(guidePixel, extent)))
        return 0.0;
    float luminance = texelFetch(sourceLuminance, guidePixel, 0).r;
    float depth = texelFetch(preparedDepthFootprint, guidePixel, 0).r;
    return SimpleDdgiNearFieldFinite(luminance) && luminance > 0.0 &&
        SimpleDdgiNearFieldFinite(depth) && depth > 0.0
        ? luminance
        : 0.0;
}

ivec2 C5GuideTileBase(ivec2 receiverPixel)
{
    return (receiverPixel / 8) * 8;
}

float C5GuideWeightSum()
{
    float total = c5SourceLuminanceHierarchy[1];
    return SimpleDdgiNearFieldFinite(total) ? max(total, 0.0) : 0.0;
}

float C5GuideHierarchyWeight(
    ivec2 receiverPixel,
    ivec2 guidePixel)
{
    ivec2 local = guidePixel - C5GuideTileBase(receiverPixel);
    if (any(lessThan(local, ivec2(0))) ||
        any(greaterThanEqual(local, ivec2(8))))
        return 0.0;
    uint leaf = uint(local.y * 8 + local.x);
    float weight = c5SourceLuminanceHierarchy[64u + leaf];
    return SimpleDdgiNearFieldFinite(weight) ? max(weight, 0.0) : 0.0;
}

uint C5SelectGuideHierarchyLeaf(float selector)
{
    uint node = 1u;
    for (uint level = 0u; level < 6u; ++level)
    {
        uint left = node * 2u;
        float leftWeight = max(c5SourceLuminanceHierarchy[left], 0.0);
        if (selector < leftWeight)
        {
            node = left;
        }
        else
        {
            selector -= leftWeight;
            node = left + 1u;
        }
    }
    return node - 64u;
}

bool C5ProjectedTexelWorldArea(
    vec2 uv,
    float linearDepth,
    vec2 texelInverseExtent,
    out float worldArea)
{
    worldArea = 0.0;
    vec3 centre;
    vec3 xPoint;
    vec3 yPoint;
    vec2 xUv = vec2(
        uv.x + (uv.x + texelInverseExtent.x < 1.0
            ? texelInverseExtent.x : -texelInverseExtent.x),
        uv.y);
    vec2 yUv = vec2(
        uv.x,
        uv.y + (uv.y + texelInverseExtent.y < 1.0
            ? texelInverseExtent.y : -texelInverseExtent.y));
    if (!C5ReconstructWorldPositionFromLinear(uv, linearDepth, centre) ||
        !C5ReconstructWorldPositionFromLinear(xUv, linearDepth, xPoint) ||
        !C5ReconstructWorldPositionFromLinear(yUv, linearDepth, yPoint))
        return false;
    worldArea = length(cross(xPoint - centre, yPoint - centre));
    return SimpleDdgiNearFieldFinite(worldArea) && worldArea > 1.0e-10;
}

bool C5CreateSourceGuidedDirection(
    ivec2 receiverPixel,
    uvec2 receiverIdentity,
    uint sequenceIndex,
    vec3 receiverWorldPosition,
    out vec3 direction,
    out float guidedPdf,
    out ivec2 targetPixel,
    out float targetDepth)
{
    direction = vec3(0.0);
    guidedPdf = 0.0;
    targetPixel = ivec2(-1);
    targetDepth = 0.0;
    ivec2 guideExtent = textureSize(sourceLuminance, 0);
    if (guideExtent.x <= 0 || guideExtent.y <= 0 ||
        textureSize(preparedDepthFootprint, 0) != guideExtent ||
        textureSize(preparedReceiverPayload, 0) != guideExtent)
        return false;
    float weightSum = C5GuideWeightSum();
    if (!SimpleDdgiNearFieldFinite(weightSum) || weightSum <= 0.0)
        return false;
    vec2 sampleValue;
    if (!NjulfC5CreateStableSample2D(
            uvec2(receiverPixel), receiverIdentity, sequenceIndex,
            sampleValue))
        return false;
    float selector = sampleValue.x * weightSum;
    uint selectedLeaf = C5SelectGuideHierarchyLeaf(selector);
    targetPixel = C5GuideTileBase(receiverPixel) + ivec2(
        int(selectedLeaf & 7u), int(selectedLeaf >> 3u));
    float selectedWeight = C5GuideHierarchyWeight(
        receiverPixel, targetPixel);
    if (selectedWeight <= 0.0 || all(equal(targetPixel, receiverPixel)) ||
        any(lessThan(targetPixel, ivec2(0))) ||
        any(greaterThanEqual(targetPixel, guideExtent)))
        return false;

    targetDepth = texelFetch(
        preparedDepthFootprint, targetPixel, 0).r;
    vec2 targetUv = (vec2(targetPixel) + vec2(0.5)) / vec2(guideExtent);
    vec3 targetWorldPosition;
    if (!C5ReconstructWorldPositionFromLinear(
            targetUv, targetDepth, targetWorldPosition))
        return false;
    uvec4 targetPayload = texelFetch(
        preparedReceiverPayload, targetPixel, 0);
    vec4 targetPackedNormals;
    uint ignoredToken;
    vec3 ignoredDiffuse;
    vec3 ignoredF0;
    SimpleDdgiNearFieldDecodeReceiverPayload(
        targetPayload, targetPackedNormals, ignoredToken,
        ignoredDiffuse, ignoredF0);
    vec3 targetNormal = SimpleDdgiNearFieldDecodeOctNormal(
        targetPackedNormals.xy);
    vec3 targetVector = targetWorldPosition - receiverWorldPosition;
    float distanceSquared = dot(targetVector, targetVector);
    if (dot(targetNormal, targetNormal) <= 0.0 ||
        !SimpleDdgiNearFieldFinite(distanceSquared) ||
        distanceSquared <= 1.0e-8 ||
        distanceSquared > pc.maximumTraceDistance * pc.maximumTraceDistance)
        return false;
    direction = targetVector * inversesqrt(distanceSquared);
    float targetCosine = dot(targetNormal, -direction);
    float worldArea;
    if (targetCosine <= 0.0 ||
        !C5ProjectedTexelWorldArea(
            targetUv,
            targetDepth,
            1.0 / vec2(guideExtent),
            worldArea))
        return false;
    float texelProbability = selectedWeight / weightSum;
    guidedPdf = texelProbability * distanceSquared /
        (targetCosine * worldArea);
    return SimpleDdgiNearFieldFinite(guidedPdf) && guidedPdf > 0.0 &&
        SimpleDdgiNearFieldFinite(direction);
}

float C5GuidedPdfForHit(
    ivec2 receiverPixel,
    vec3 receiverWorldPosition,
    vec2 hitUv,
    float hitLinearDepth,
    vec3 hitWorldPosition,
    vec3 hitNormal,
    vec3 direction)
{
    ivec2 guideExtent = textureSize(sourceLuminance, 0);
    ivec2 hitGuidePixel = clamp(
        ivec2(hitUv * vec2(guideExtent)),
        ivec2(0),
        max(guideExtent - ivec2(1), ivec2(0)));
    if (all(equal(hitGuidePixel, receiverPixel)))
        return 0.0;
    float weightSum = C5GuideWeightSum();
    float hitWeight = C5GuideHierarchyWeight(
        receiverPixel, hitGuidePixel);
    float distanceSquared = dot(
        hitWorldPosition - receiverWorldPosition,
        hitWorldPosition - receiverWorldPosition);
    float targetCosine = dot(hitNormal, -direction);
    float worldArea;
    if (weightSum <= 0.0 || hitWeight <= 0.0 ||
        distanceSquared <= 0.0 || targetCosine <= 0.0 ||
        !C5ProjectedTexelWorldArea(
            hitUv,
            hitLinearDepth,
            1.0 / vec2(guideExtent),
            worldArea))
        return 0.0;
    float pdf = (hitWeight / weightSum) * distanceSquared /
        (targetCosine * worldArea);
    return SimpleDdgiNearFieldFinite(pdf) ? max(pdf, 0.0) : 0.0;
}

bool C5ClipPositiveHalfSpace(
    float startValue,
    float endValue,
    inout float enter,
    inout float exit)
{
    if (startValue >= 0.0 && endValue >= 0.0)
        return true;
    if (startValue < 0.0 && endValue < 0.0)
        return false;
    float crossing = startValue / (startValue - endValue);
    if (startValue < 0.0)
        enter = max(enter, crossing);
    else
        exit = min(exit, crossing);
    return enter <= exit;
}

bool TraceShortDepthRay(
    vec4 unclippedStart,
    vec4 unclippedEnd,
    float receiverPixelFootprintMeters,
    out vec2 hitUv,
    out float hitRayDepth,
    out float hitSceneDepth,
    out uint failureFlags,
    out uint traceSteps,
    out uint mipVisits,
    out uint refinementVisits)
{
    hitUv = vec2(0.0);
    hitRayDepth = 0.0;
    hitSceneDepth = 0.0;
    failureFlags = 0u;
    traceSteps = 0u;
    mipVisits = 0u;
    refinementVisits = 0u;
    if (!C5Finite(unclippedStart) || !C5Finite(unclippedEnd))
    {
        failureFlags = C5_TRACE_REASON_INVALID_RAY |
            C5_TRACE_REASON_NONFINITE;
        return false;
    }

    uint depthTestBudget = min(pc.maximumTraceSteps,
        SIMPLE_DDGI_NEAR_FIELD_MAX_TRACE_STEPS);
    if (depthTestBudget == 0u)
    {
        failureFlags = C5_TRACE_REASON_STEP_BUDGET | C5_TRACE_REASON_MISS;
        return false;
    }

    // Clip in homogeneous space against w>0, the Vulkan near/far planes, and
    // exact screen bounds before any division. This keeps near-plane exits and
    // perspective interpolation well-defined for both forward and reversed Z.
    float enter = 0.0;
    float exit = 1.0;
    const float minimumW = 1.0e-5;
    if (!C5ClipPositiveHalfSpace(unclippedStart.w - minimumW,
            unclippedEnd.w - minimumW, enter, exit) ||
        !C5ClipPositiveHalfSpace(unclippedStart.z, unclippedEnd.z,
            enter, exit) ||
        !C5ClipPositiveHalfSpace(unclippedStart.w - unclippedStart.z,
            unclippedEnd.w - unclippedEnd.z, enter, exit) ||
        !C5ClipPositiveHalfSpace(unclippedStart.x + unclippedStart.w,
            unclippedEnd.x + unclippedEnd.w, enter, exit) ||
        !C5ClipPositiveHalfSpace(unclippedStart.w - unclippedStart.x,
            unclippedEnd.w - unclippedEnd.x, enter, exit) ||
        !C5ClipPositiveHalfSpace(unclippedStart.y + unclippedStart.w,
            unclippedEnd.y + unclippedEnd.w, enter, exit) ||
        !C5ClipPositiveHalfSpace(unclippedStart.w - unclippedStart.y,
            unclippedEnd.w - unclippedEnd.y, enter, exit))
    {
        failureFlags = C5_TRACE_REASON_SCREEN_EXIT | C5_TRACE_REASON_MISS;
        return false;
    }
    vec4 startClip = mix(unclippedStart, unclippedEnd, enter);
    vec4 endClip = mix(unclippedStart, unclippedEnd, exit);
    vec2 startUv = startClip.xy / startClip.w * 0.5 + vec2(0.5);
    vec2 endUv = endClip.xy / endClip.w * 0.5 + vec2(0.5);
    vec2 fullExtent = vec2(pc.fullWidth, pc.fullHeight);
    vec2 startPixel = startUv * fullExtent;
    vec2 pixelDelta = (endUv - startUv) * fullExtent;
    float screenSpan = max(abs(pixelDelta.x), abs(pixelDelta.y));
    if (!SimpleDdgiNearFieldFinite(screenSpan) || screenSpan <= 1.0e-5)
    {
        failureFlags = C5_TRACE_REASON_INVALID_RAY | C5_TRACE_REASON_MISS;
        return false;
    }

    int maximumAvailableMip = textureQueryLevels(depthHierarchy) - 1;
    uint mip = uint(clamp(floor(log2(max(
        screenSpan / float(depthTestBudget), 1.0))),
        0.0, float(max(maximumAvailableMip, 0))));
    float t = max(1.0 / screenSpan, 1.0e-5);
    float previousT = 0.0;
    float thicknessMeters = max(0.02,
        receiverPixelFootprintMeters * max(pc.thickness, 0.0));
    for (uint iteration = 0u;
         iteration < SIMPLE_DDGI_NEAR_FIELD_MAX_TRACE_STEPS;
         ++iteration)
    {
        if (traceSteps >= depthTestBudget || t > 1.0)
            break;
        float rayParameter = C5PerspectiveLineParameter(
            t, startClip.w, endClip.w);
        vec4 rayClip = mix(startClip, endClip, rayParameter);
        if (!C5Finite(rayClip) || rayClip.w <= minimumW)
        {
            failureFlags = C5_TRACE_REASON_NONFINITE | C5_TRACE_REASON_MISS;
            return false;
        }
        vec3 rayNdc = rayClip.xyz / rayClip.w;
        vec2 sampleUv = rayNdc.xy * 0.5 + vec2(0.5);
        if (!IsInsideUv(sampleUv))
        {
            failureFlags = C5_TRACE_REASON_SCREEN_EXIT |
                C5_TRACE_REASON_MISS;
            return false;
        }

        float storedSceneDepth = textureLod(
            depthHierarchy, sampleUv, float(mip)).r;
        traceSteps++;
        mipVisits++;
        float sceneDepth = C5PositiveLinearDepth(storedSceneDepth);
        float rayDepth = C5PositiveLinearDepth(rayNdc.z);
        if (!SimpleDdgiNearFieldFinite(sceneDepth) ||
            !SimpleDdgiNearFieldFinite(rayDepth))
        {
            failureFlags = C5_TRACE_REASON_NONFINITE |
                C5_TRACE_REASON_MISS;
            return false;
        }
        float separation = rayDepth - sceneDepth;
        if (separation < -thicknessMeters)
        {
            previousT = t;
            if (mip < uint(max(maximumAvailableMip, 0)))
                mip++;
            t = C5NextCellBoundaryParameter(
                startPixel, pixelDelta, t, mip);
            continue;
        }

        // A conservative coarse minimum behind the ray can come from a
        // foreground texel beside a thin gap or depth step. Resolve the exact
        // texel before enforcing the upper thickness/discontinuity bound.
        if (mip > 0u)
        {
            mip--;
            continue;
        }

        if (separation > thicknessMeters + max(pc.depthTolerance, 0.02))
        {
            previousT = t;
            t = C5NextCellBoundaryParameter(
                startPixel, pixelDelta, t, 0u);
            continue;
        }

        float lo = previousT;
        float hi = t;
        float refinedSceneDepth = sceneDepth;
        uint refinementCount = min(pc.binaryRefinementSteps,
            SIMPLE_DDGI_NEAR_FIELD_MAX_BINARY_REFINEMENTS);
        for (uint refinement = 0u;
             refinement < SIMPLE_DDGI_NEAR_FIELD_MAX_BINARY_REFINEMENTS;
             ++refinement)
        {
            if (refinement >= refinementCount)
                break;
            if (traceSteps >= depthTestBudget)
            {
                failureFlags = C5_TRACE_REASON_STEP_BUDGET |
                    C5_TRACE_REASON_MISS;
                return false;
            }
            float mid = 0.5 * (lo + hi);
            refinementVisits++;
            float midParameter = C5PerspectiveLineParameter(
                mid, startClip.w, endClip.w);
            vec4 midClip = mix(startClip, endClip, midParameter);
            vec3 midNdc = midClip.xyz / midClip.w;
            vec2 midUv = midNdc.xy * 0.5 + vec2(0.5);
            if (!IsInsideUv(midUv))
                break;
            float midDepth = C5PositiveLinearDepth(
                textureLod(depthHierarchy, midUv, 0.0).r);
            traceSteps++;
            mipVisits++;
            float midRayDepth = C5PositiveLinearDepth(midNdc.z);
            if (!SimpleDdgiNearFieldFinite(midDepth) ||
                !SimpleDdgiNearFieldFinite(midRayDepth))
            {
                failureFlags = C5_TRACE_REASON_NONFINITE |
                    C5_TRACE_REASON_MISS;
                return false;
            }
            float midSeparation = midRayDepth - midDepth;
            if (midSeparation >= -thicknessMeters)
            {
                hi = mid;
                refinedSceneDepth = midDepth;
            }
            else
            {
                lo = mid;
            }
        }

        float hitParameter = C5PerspectiveLineParameter(
            hi, startClip.w, endClip.w);
        vec4 hitClip = mix(startClip, endClip, hitParameter);
        vec3 hitNdc = hitClip.xyz / hitClip.w;
        hitUv = hitNdc.xy * 0.5 + vec2(0.5);
        hitRayDepth = C5PositiveLinearDepth(hitNdc.z);
        hitSceneDepth = refinedSceneDepth;
        return IsInsideUv(hitUv) && SimpleDdgiNearFieldFinite(hitRayDepth) &&
            SimpleDdgiNearFieldFinite(hitSceneDepth);
    }

    failureFlags = C5_TRACE_REASON_MISS;
    if (traceSteps >= depthTestBudget)
        failureFlags |= C5_TRACE_REASON_STEP_BUDGET;
    return false;
}

void WriteInvalid(ivec2 pixel, uint metadataIndex)
{
    imageStore(rawResidualOutput, pixel, vec4(0.0));
    if (metadataIndex < uint(traceHitMetadata.values.length()))
        traceHitMetadata.values[metadataIndex] = SimpleDdgiNearFieldZeroMetadata();
}

void RecordTileSummary(uint tileIndex)
{
    uint coveredCount = 0u;
    uint validCount = 0u;
    uint hitCount = 0u;
    uint invalidCount = 0u;
    uint raysLaunched = 0u;
    uint screenExits = 0u;
    uint invalidReceivers = 0u;
    uint invalidRays = 0u;
    uint stepBudgetRejects = 0u;
    uint mipBudgetRejects = 0u;
    uint depthRejects = 0u;
    uint normalRejects = 0u;
    uint sourceRejects = 0u;
    uint nonFiniteRejects = 0u;
    uint totalSteps = 0u;
    uint totalMipVisits = 0u;
    uint totalRefinementVisits = 0u;
    uint maximumSteps = 0u;
    uint maximumMipVisits = 0u;
    for (uint lane = 0u; lane < 64u; ++lane)
    {
        if (c5TileCovered[lane] == 0u)
            continue;
        coveredCount++;
        raysLaunched += c5TileRayLaunched[lane];
        totalSteps += c5TileTraceSteps[lane];
        totalMipVisits += c5TileMipVisits[lane];
        totalRefinementVisits += c5TileRefinementVisits[lane];
        maximumSteps = max(maximumSteps,
            c5TileMaximumTraceSteps[lane]);
        maximumMipVisits = max(maximumMipVisits,
            c5TileMaximumMipVisits[lane]);
        if (c5TileValid[lane] != 0u)
            validCount++;
        else
            invalidCount++;
        hitCount += c5TileHit[lane];
        uint reasons = c5TileReasonFlags[lane];
        screenExits += (reasons & C5_TRACE_REASON_SCREEN_EXIT) != 0u ? 1u : 0u;
        invalidReceivers += (reasons & C5_TRACE_REASON_INVALID_RECEIVER) != 0u ? 1u : 0u;
        invalidRays += (reasons & C5_TRACE_REASON_INVALID_RAY) != 0u ? 1u : 0u;
        stepBudgetRejects += (reasons & C5_TRACE_REASON_STEP_BUDGET) != 0u ? 1u : 0u;
        mipBudgetRejects += (reasons & C5_TRACE_REASON_MIP_BUDGET) != 0u ? 1u : 0u;
        depthRejects += (reasons & C5_TRACE_REASON_DEPTH) != 0u ? 1u : 0u;
        normalRejects += (reasons & C5_TRACE_REASON_NORMAL) != 0u ? 1u : 0u;
        sourceRejects += (reasons & C5_TRACE_REASON_SOURCE) != 0u ? 1u : 0u;
        nonFiniteRejects += (reasons & C5_TRACE_REASON_NONFINITE) != 0u ? 1u : 0u;
    }
    uint recordBase = SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_HEADER_WORDS +
        tileIndex * SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS;
    if (recordBase > uint(traceTileRecords.words.length()) ||
        SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS >
            uint(traceTileRecords.words.length()) - recordBase)
    {
        if (uint(traceTileRecords.words.length()) > 15u)
            atomicOr(traceTileRecords.words[15u], 1u);
        return;
    }
    traceTileRecords.words[recordBase + 0u] = tileIndex;
    traceTileRecords.words[recordBase + 1u] =
        SimpleDdgiNearFieldPackTraceCounts(
            coveredCount, validCount, invalidCount, raysLaunched);
    traceTileRecords.words[recordBase + 2u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            screenExits, invalidReceivers, invalidRays, stepBudgetRejects));
    traceTileRecords.words[recordBase + 3u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            mipBudgetRejects, depthRejects, normalRejects, sourceRejects));
    traceTileRecords.words[recordBase + 4u] =
        SimpleDdgiNearFieldPackFourTileCounts(uvec4(
            nonFiniteRejects, 0u, 0u, 0u));
    traceTileRecords.words[recordBase + 5u] = 0u;
    traceTileRecords.words[recordBase + 6u] = 0u;
    traceTileRecords.words[recordBase + 7u] =
        (totalSteps & 0xffffu) | ((totalMipVisits & 0xffffu) << 16u);
    traceTileRecords.words[recordBase + 8u] =
        (totalRefinementVisits & 0xffffu) |
        ((maximumSteps & 0x1ffu) << 16u) |
        ((maximumMipVisits & 0x3fu) << 25u);
    traceTileRecords.words[recordBase + 9u] = floatBitsToUint(0.0);
    traceTileRecords.words[recordBase + 10u] = floatBitsToUint(0.0);
    traceTileRecords.words[recordBase + 11u] = floatBitsToUint(0.0);
    traceTileRecords.words[recordBase + 12u] = floatBitsToUint(0.0);
    traceTileRecords.words[recordBase + 13u] = floatBitsToUint(0.0);
    traceTileRecords.words[recordBase + 14u] = floatBitsToUint(0.0);
    uint maximumDistanceHalf = packHalf2x16(
        vec2(pc.maximumTraceDistance, 0.0)) & 0xffffu;
    traceTileRecords.words[recordBase + 15u] = maximumDistanceHalf |
        (SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TRACE_COMPLETE << 16u);
    traceTileRecords.words[recordBase + 16u] = 0u;
    traceTileRecords.words[recordBase + 17u] = 0u;
    traceTileRecords.words[recordBase + 18u] = 0u;
    traceTileRecords.words[recordBase + 19u] = 0u;

    // Aggregate once per tile; no trace pixel performs a global atomic.
    atomicAdd(traceTileRecords.words[8u], coveredCount);
    atomicAdd(traceTileRecords.words[9u], raysLaunched);
    // Tile validity counts estimator candidates, including a legitimate
    // zero-valued miss. The aggregate hit/miss pair retains actual ray-query
    // semantics for diagnostics.
    atomicAdd(traceTileRecords.words[10u], hitCount);
    atomicAdd(traceTileRecords.words[11u], raysLaunched - hitCount);
    atomicAdd(traceTileRecords.words[12u], invalidReceivers);
    atomicAdd(traceTileRecords.words[13u], invalidRays);
    atomicAdd(traceTileRecords.words[14u], invalidCount);
    if (tileIndex == 0u)
    {
        traceTileRecords.words[4u] = pc.traceWidth;
        traceTileRecords.words[5u] = pc.traceHeight;
        atomicOr(traceTileRecords.words[7u],
            SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TRACE_COMPLETE);
    }
}

bool EvaluateSingleCandidate(
    ivec2 pixel,
    uint metadataIndex,
    uint rayOrdinal,
    out vec3 nearEstimate,
    out float confidence,
    out SimpleDdgiNearFieldResidualHitMetadata metadata,
    out uint failureFlags,
    out uint rayLaunched,
    out uint traceSteps,
    out uint mipVisits,
    out uint refinementVisits)
{
    nearEstimate = vec3(0.0);
    confidence = 0.0;
    metadata = SimpleDdgiNearFieldZeroMetadata();
    failureFlags = C5_TRACE_REASON_INVALID_RECEIVER;
    rayLaunched = 0u;
    traceSteps = 0u;
    mipVisits = 0u;
    refinementVisits = 0u;
    if (pc.abiVersion != SIMPLE_DDGI_NEAR_FIELD_RESIDUAL_ABI_VERSION ||
        !SimpleDdgiNearFieldTraceSourcesAllowed(pc.traceSourceTerms) ||
        !SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_SOURCE_ATTACHMENT_VERIFIED) ||
        !SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_INVALID_AND_MISS_ZEROED) ||
        pc.fullWidth == 0u || pc.fullHeight == 0u ||
        pc.traceSourceRevision == 0u || pc.historyEpoch == 0u ||
        !SimpleDdgiNearFieldFinite(pc.maximumTraceDistance) ||
        pc.maximumTraceDistance <= 0.0 ||
        pc.maximumTraceDistance >
            SIMPLE_DDGI_NEAR_FIELD_MAX_ENCODED_TRACE_DISTANCE ||
        !SimpleDdgiNearFieldFinite(pc.fullWeightTraceDistance) ||
        pc.fullWeightTraceDistance <= 0.0 ||
        pc.fullWeightTraceDistance >= pc.maximumTraceDistance ||
        !C5Finite(traceFrameConstants.frame.fullExtentAndInverse) ||
        traceFrameConstants.frame.fullExtentAndInverse.x != float(pc.fullWidth) ||
        traceFrameConstants.frame.fullExtentAndInverse.y != float(pc.fullHeight) ||
        abs(traceFrameConstants.frame.fullExtentAndInverse.z *
            float(pc.fullWidth) - 1.0) > 1.0e-5 ||
        abs(traceFrameConstants.frame.fullExtentAndInverse.w *
            float(pc.fullHeight) - 1.0) > 1.0e-5 ||
        floatBitsToUint(traceFrameConstants.frame.clipAndSequence.w) != 4u ||
        metadataIndex >= uint(traceHitMetadata.values.length()))
    {
        failureFlags |= C5_TRACE_REASON_SOURCE;
        return false;
    }

    vec2 traceUv = (vec2(pixel) + vec2(0.5)) /
        max(vec2(pc.traceWidth, pc.traceHeight), vec2(1.0));
    ivec2 receiverExtent = textureSize(preparedDepthFootprint, 0);
    ivec2 fullExtent = textureSize(directDiffuseEmissiveSource, 0);
    if (receiverExtent.x < int(pc.traceWidth) ||
        receiverExtent.y < int(pc.traceHeight) ||
        textureSize(preparedReceiverPayload, 0) != receiverExtent ||
        textureSize(fullReceiverPayload, 0) != fullExtent ||
        fullExtent != ivec2(pc.fullWidth, pc.fullHeight))
    {
        failureFlags |= C5_TRACE_REASON_SOURCE;
        return false;
    }
    ivec2 receiverPixel = pixel;
    vec2 receiverUv = traceUv;
    vec2 preparedDepth = texelFetch(
        preparedDepthFootprint, receiverPixel, 0).rg;
    float startDepth = preparedDepth.x;
    uvec4 receiverPayloadValue = texelFetch(
        preparedReceiverPayload, receiverPixel, 0);
    vec4 receiverPackedNormals;
    uint receiverSurfaceToken;
    vec3 receiverDiffuseBase;
    vec3 receiverDielectricF0;
    SimpleDdgiNearFieldDecodeReceiverPayload(
        receiverPayloadValue,
        receiverPackedNormals,
        receiverSurfaceToken,
        receiverDiffuseBase,
        receiverDielectricF0);
    SimpleDdgiNearFieldSurfaceEntry receiverSurface;
    vec3 receiverGeometric = SimpleDdgiNearFieldDecodeOctNormal(
        receiverPackedNormals.xy);
    vec3 receiverShading = SimpleDdgiNearFieldDecodeOctNormal(
        receiverPackedNormals.zw);
    vec4 receiverSource = vec4(0.0, 0.0, 0.0, preparedDepth.y);
    vec3 receiverWorldPosition;
    vec3 generationDirection;
    float generationPdf;
    bool guidedProposal = pc.raysPerPixel >= 2u && rayOrdinal > 0u &&
        (rayOrdinal & 1u) != 0u;
    ivec2 guidedTargetPixel = ivec2(-1);
    float guidedTargetDepth = 0.0;
    vec4 projectedStart;
    vec4 projectedEnd;
    if (!SimpleDdgiNearFieldFinite(startDepth) ||
        !SimpleDdgiNearFieldFinite(receiverDiffuseBase) ||
        !SimpleDdgiNearFieldFinite(receiverDielectricF0))
    {
        failureFlags |= C5_TRACE_REASON_NONFINITE;
        return false;
    }
    if (dot(receiverGeometric, receiverGeometric) <= 0.0 ||
        dot(receiverShading, receiverShading) <= 0.0 ||
        !SimpleDdgiNearFieldFinite(receiverSource.a) ||
        receiverSource.a <= 0.0 ||
        any(lessThan(receiverDiffuseBase, vec3(0.0))) ||
        !C5ReadSurface(receiverSurfaceToken, receiverSurface))
    {
        failureFlags |= C5_TRACE_REASON_SOURCE;
        return false;
    }
    uint sampleSequence =
        floatBitsToUint(traceFrameConstants.frame.clipAndSequence.z) * 4u +
        rayOrdinal;
    if (!C5ReconstructWorldPositionFromLinear(
            receiverUv, startDepth, receiverWorldPosition))
    {
        failureFlags = C5_TRACE_REASON_INVALID_RAY |
            C5_TRACE_REASON_NONFINITE;
        return false;
    }
    float receiverPixelFootprint = C5ReceiverPixelFootprintMeters(
        receiverUv, startDepth, receiverWorldPosition);
    bool directionCreated = guidedProposal
        ? C5CreateSourceGuidedDirection(
            receiverPixel,
            uvec2(receiverSurface.stableObjectId,
                receiverSurface.stableMaterialId),
            sampleSequence,
            receiverWorldPosition,
            generationDirection,
            generationPdf,
            guidedTargetPixel,
            guidedTargetDepth)
        : NjulfC5CreateStableCosineDirection(
            uvec2(receiverPixel),
            uvec2(receiverSurface.stableObjectId,
                receiverSurface.stableMaterialId),
            sampleSequence,
            receiverShading,
            generationDirection,
            generationPdf);
    if (!directionCreated ||
        !C5CreateProjectedRay(
            receiverWorldPosition,
            generationDirection,
            receiverPixelFootprint,
            projectedStart,
            projectedEnd))
    {
        failureFlags = C5_TRACE_REASON_INVALID_RAY |
            C5_TRACE_REASON_NONFINITE;
        return false;
    }
    rayLaunched = 1u;

    // Receiver identity owns temporal/spatial reuse. Populate it before the
    // stochastic trace so a bounded miss can still contribute a valid zero
    // Monte Carlo sample and preserve the receiver's accumulation.
    metadata.receiverLinearDepth = startDepth;
    metadata.hitLinearDepth = startDepth;
    SimpleDdgiNearFieldSetMetadataFlags(metadata,
        SIMPLE_DDGI_NEAR_FIELD_FLAG_VALID_CANDIDATE |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_SOURCE_ATTACHMENT_VERIFIED |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_INVALID_AND_MISS_ZEROED);
    SimpleDdgiNearFieldSetReceiverFootprint(metadata, receiverSource.a);
    metadata.receiverIdentity = uvec2(
        receiverSurface.stableObjectId, receiverSurface.stableMaterialId);
    metadata.hitIdentity = uvec2(0u);
    metadata.packedReceiverRevisions =
        receiverSurface.packedObjectMaterialRevisions;
    metadata.packedHitUv = packHalf2x16(receiverUv);

    vec2 hitUv;
    float hitRayDepth;
    float hitSceneDepth;
    if (!TraceShortDepthRay(projectedStart, projectedEnd,
            receiverPixelFootprint,
            hitUv, hitRayDepth, hitSceneDepth, failureFlags,
            traceSteps, mipVisits, refinementVisits))
    {
        // Screen exit and bounded step/mip exhaustion are the zero branch of
        // this screen-space estimator. Invalid or non-finite rays remain hard
        // failures and are not allowed to refresh history.
        bool validMiss = (failureFlags & C5_TRACE_REASON_MISS) != 0u &&
            (failureFlags & (C5_TRACE_REASON_INVALID_RAY |
                C5_TRACE_REASON_NONFINITE)) == 0u;
        if (validMiss)
        {
            confidence = 1.0;
            return true;
        }
        return false;
    }

    if (guidedProposal)
    {
        ivec2 guideExtent = textureSize(sourceLuminance, 0);
        ivec2 actualGuidePixel = clamp(
            ivec2(hitUv * vec2(guideExtent)),
            ivec2(0), max(guideExtent - ivec2(1), ivec2(0)));
        if (any(notEqual(actualGuidePixel, guidedTargetPixel)) ||
            abs(hitSceneDepth - guidedTargetDepth) >
                max(pc.depthTolerance, 0.02))
        {
            // A nearer surface occluded the sampled guide target. It is a
            // valid zero branch, never a contribution under the target PDF.
            failureFlags = C5_TRACE_REASON_DEPTH | C5_TRACE_REASON_MISS;
            confidence = 1.0;
            return true;
        }
    }

    ivec2 hitPixel = clamp(ivec2(hitUv * vec2(fullExtent)), ivec2(0),
        max(fullExtent - ivec2(1), ivec2(0)));
    uvec4 hitPayloadValue = texelFetch(fullReceiverPayload, hitPixel, 0);
    vec4 hitPackedNormals;
    uint hitSurfaceToken;
    vec3 ignoredHitDiffuseBase;
    vec3 ignoredHitF0;
    SimpleDdgiNearFieldDecodeReceiverPayload(
        hitPayloadValue,
        hitPackedNormals,
        hitSurfaceToken,
        ignoredHitDiffuseBase,
        ignoredHitF0);
    SimpleDdgiNearFieldSurfaceEntry hitSurface;
    vec3 hitGeometric = SimpleDdgiNearFieldDecodeOctNormal(
        hitPackedNormals.xy);
    vec3 hitShading = SimpleDdgiNearFieldDecodeOctNormal(
        hitPackedNormals.zw);
    if (dot(hitGeometric, hitGeometric) <= 0.0 ||
        dot(hitShading, hitShading) <= 0.0 ||
        !C5ReadSurface(hitSurfaceToken, hitSurface))
    {
        // The receiver and its stochastic ray are valid, but this screen hit
        // is outside the source domain. It is the zero branch of the bounded
        // screen-space estimator, not a reason to discard receiver history.
        failureFlags = C5_TRACE_REASON_NORMAL | C5_TRACE_REASON_MISS;
        confidence = 1.0;
        return true;
    }

    float receiverCosine = max(dot(receiverShading, generationDirection), 0.0);
    float cosinePdf = receiverCosine / 3.14159265359;
    float hitFrontFaceCosine = dot(hitGeometric, -generationDirection);
    if (!SimpleDdgiNearFieldFinite(generationPdf) ||
        generationPdf <= 0.0 || receiverCosine <= 0.0 ||
        dot(generationDirection, generationDirection) <= 0.0 ||
        (!guidedProposal && abs(generationPdf - cosinePdf) > 2.0e-4) ||
        !SimpleDdgiNearFieldFinite(hitFrontFaceCosine))
    {
        failureFlags = C5_TRACE_REASON_INVALID_RAY |
            C5_TRACE_REASON_NONFINITE;
        return false;
    }
    if (hitFrontFaceCosine <= 0.01)
    {
        failureFlags = C5_TRACE_REASON_NORMAL | C5_TRACE_REASON_MISS;
        confidence = 1.0;
        return true;
    }

    vec4 directAtHitPayload = texelFetch(
        directDiffuseEmissiveSource, hitPixel, 0);
    vec3 directAtHit = max(directAtHitPayload.rgb, vec3(0.0));
    vec3 hitWorldPosition;
    if (!SimpleDdgiNearFieldFinite(directAtHit) ||
        !SimpleDdgiNearFieldFinite(directAtHitPayload.a) ||
        directAtHitPayload.a <= 0.0 ||
        !C5ReconstructWorldPositionFromLinear(
            hitUv, hitSceneDepth, hitWorldPosition))
    {
        // Missing source/B3 ownership or an unusable reconstruction means C5
        // owns no contribution for this launched sample. Preserve a valid
        // zero so isolated source hits cannot become persistent impulses.
        failureFlags = C5_TRACE_REASON_SOURCE | C5_TRACE_REASON_MISS;
        confidence = 1.0;
        return true;
    }

    float depthConfidence = pc.depthTolerance <= 0.0
        ? 1.0
        : clamp(1.0 - abs(hitRayDepth - hitSceneDepth) /
            pc.depthTolerance, 0.0, 1.0);
    float normalConfidence = clamp(hitFrontFaceCosine, 0.0, 1.0);
    float hitDistance = length(hitWorldPosition - receiverWorldPosition);
    float distanceWeight = 1.0 - smoothstep(
        pc.fullWeightTraceDistance,
        pc.maximumTraceDistance,
        hitDistance);
    confidence = depthConfidence * normalConfidence;
    float guidedPdf = C5GuidedPdfForHit(
        receiverPixel,
        receiverWorldPosition,
        hitUv,
        hitSceneDepth,
        hitWorldPosition,
        hitGeometric,
        generationDirection);
    float guidedWeight = float(pc.raysPerPixel / 2u) /
        float(pc.raysPerPixel);
    float mixturePdf = (1.0 - guidedWeight) * cosinePdf +
        guidedWeight * guidedPdf;
    float monteCarloWeight = mixturePdf > 0.0
        ? receiverCosine / (3.14159265359 * mixturePdf)
        : 0.0;
    vec3 receiverThroughput = receiverDiffuseBase *
        (vec3(1.0) - clamp(receiverDielectricF0, vec3(0.0), vec3(1.0)));
    nearEstimate = directAtHit * receiverThroughput * distanceWeight *
        monteCarloWeight;
    if (!SimpleDdgiNearFieldFinite(confidence) || confidence <= 0.0 ||
        !SimpleDdgiNearFieldFinite(hitDistance) ||
        !SimpleDdgiNearFieldFinite(distanceWeight) ||
        !SimpleDdgiNearFieldFinite(mixturePdf) || mixturePdf <= 0.0 ||
        !SimpleDdgiNearFieldFinite(monteCarloWeight) ||
        monteCarloWeight <= 0.0 ||
        !SimpleDdgiNearFieldFinite(nearEstimate))
    {
        return false;
    }

    metadata.hitLinearDepth = hitSceneDepth;
    SimpleDdgiNearFieldSetMetadataFlags(metadata,
        SIMPLE_DDGI_NEAR_FIELD_FLAG_VALID_CANDIDATE |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_SCREEN_SPACE_HIT |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_SOURCE_ATTACHMENT_VERIFIED |
        SIMPLE_DDGI_NEAR_FIELD_FLAG_INVALID_AND_MISS_ZEROED);
    metadata.packedHitNormal = packSnorm2x16(
        SimpleDdgiNearFieldEncodeOctNormal(hitGeometric));
    metadata.hitIdentity = uvec2(
        hitSurface.stableObjectId, hitSurface.stableMaterialId);
    metadata.packedHitRevisions = hitSurface.packedObjectMaterialRevisions;
    metadata.packedHitUv = packHalf2x16(hitUv);
    metadata.packedHitSourceRadiance = NjulfC5PackRgb9E5(directAtHit);
    failureFlags = 0u;
    return true;
}

bool EvaluateCandidate(
    ivec2 pixel,
    uint metadataIndex,
    out vec3 nearEstimate,
    out float confidence,
    out SimpleDdgiNearFieldResidualHitMetadata metadata,
    out uint failureFlags,
    out uint rayLaunched,
    out uint rayHitCount,
    out uint traceSteps,
    out uint mipVisits,
    out uint maximumTraceSteps,
    out uint maximumMipVisits,
    out uint refinementVisits)
{
    nearEstimate = vec3(0.0);
    confidence = 0.0;
    metadata = SimpleDdgiNearFieldZeroMetadata();
    failureFlags = 0u;
    rayLaunched = 0u;
    rayHitCount = 0u;
    traceSteps = 0u;
    mipVisits = 0u;
    maximumTraceSteps = 0u;
    maximumMipVisits = 0u;
    refinementVisits = 0u;
    if (pc.raysPerPixel == 0u || pc.raysPerPixel > 4u)
    {
        failureFlags = C5_TRACE_REASON_INVALID_RAY;
        return false;
    }

    uint validSampleCount = 0u;
    float confidenceSum = 0.0;
    float representativeScore = -1.0;
    bool hasRepresentative = false;
    for (uint rayOrdinal = 0u; rayOrdinal < 4u; ++rayOrdinal)
    {
        if (rayOrdinal >= pc.raysPerPixel)
            break;
        vec3 singleNear;
        float singleConfidence;
        SimpleDdgiNearFieldResidualHitMetadata singleMetadata;
        uint singleFailureFlags;
        uint singleRayLaunched;
        uint singleTraceSteps;
        uint singleMipVisits;
        uint singleRefinementVisits;
        bool singleValid = EvaluateSingleCandidate(
            pixel,
            metadataIndex,
            rayOrdinal,
            singleNear,
            singleConfidence,
            singleMetadata,
            singleFailureFlags,
            singleRayLaunched,
            singleTraceSteps,
            singleMipVisits,
            singleRefinementVisits);
        rayLaunched += singleRayLaunched;
        traceSteps += singleTraceSteps;
        mipVisits += singleMipVisits;
        maximumTraceSteps = max(maximumTraceSteps, singleTraceSteps);
        maximumMipVisits = max(maximumMipVisits, singleMipVisits);
        refinementVisits += singleRefinementVisits;
        failureFlags |= singleFailureFlags;
        if (!singleValid)
            continue;

        bool screenHit = SimpleDdgiNearFieldHasFlag(
            SimpleDdgiNearFieldMetadataFlags(singleMetadata),
            SIMPLE_DDGI_NEAR_FIELD_FLAG_SCREEN_SPACE_HIT);
        validSampleCount++;
        rayHitCount += screenHit ? 1u : 0u;
        nearEstimate += singleNear;
        // A miss remains a zero Monte Carlo sample while retaining a small
        // confidence floor so stable all-miss receivers accumulate instead
        // of flashing between invalid and newly valid states.
        confidenceSum += singleConfidence * (screenHit ? 1.0 : 0.25);
        float score = screenHit
            ? dot(abs(singleNear), vec3(0.2126, 0.7152, 0.0722)) *
                max(singleConfidence, 0.0)
            : 0.0;
        if (!hasRepresentative || score > representativeScore)
        {
            metadata = singleMetadata;
            representativeScore = score;
            hasRepresentative = true;
        }
    }

    if (rayLaunched == 0u || validSampleCount == 0u || !hasRepresentative)
    {
        failureFlags |= C5_TRACE_REASON_INVALID_RAY;
        return false;
    }
    float reciprocalLaunched = 1.0 / float(rayLaunched);
    nearEstimate *= reciprocalLaunched;
    float validRayCoverage = float(validSampleCount) * reciprocalLaunched;
    confidence = clamp(confidenceSum * reciprocalLaunched *
        validRayCoverage, 0.0, 1.0);
    return SimpleDdgiNearFieldFinite(nearEstimate) &&
        SimpleDdgiNearFieldFinite(confidence) && confidence > 0.0;
}

void main()
{
    uint activeIndex = gl_WorkGroupID.x;
    uint activeCount = uint(traceActiveTiles.words.length()) > 1u
        ? traceActiveTiles.words[1]
        : 0u;
    bool activeTile = uint(traceActiveTiles.words.length()) > 4u &&
        traceActiveTiles.words[4u] == 0u && activeIndex < activeCount &&
        SIMPLE_DDGI_NEAR_FIELD_ACTIVE_TILE_HEADER_WORDS + activeIndex <
            uint(traceActiveTiles.words.length());
    uint tileIndex = activeTile
        ? traceActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_ACTIVE_TILE_HEADER_WORDS + activeIndex]
        : 0u;
    uint tileCountX = (pc.traceWidth + 7u) / 8u;
    uvec2 tile = tileCountX > 0u
        ? uvec2(tileIndex % tileCountX, tileIndex / tileCountX)
        : uvec2(0u);
    ivec2 pixel = ivec2(tile * 8u + gl_LocalInvocationID.xy);
    ivec2 outputExtent = imageSize(rawResidualOutput);
    bool covered = activeTile &&
        pixel.x < outputExtent.x && pixel.y < outputExtent.y &&
        pixel.x < int(pc.traceWidth) && pixel.y < int(pc.traceHeight);
    uint metadataIndex = covered
        ? uint(pixel.y) * pc.traceWidth + uint(pixel.x)
        : 0u;
    uint localIndex = gl_LocalInvocationIndex;

    // Build the optional source-luminance hierarchy once for this compacted
    // tile. One-ray tiers keep the tree at zero and never enter the guided
    // proposal path. Partial edge tiles contribute exact-zero leaves.
    float guideWeight = 0.0;
    if (activeTile && pc.raysPerPixel >= 2u)
        guideWeight = C5ReadGuideLuminance(pixel);
    c5SourceLuminanceHierarchy[64u + localIndex] = guideWeight;
    if (localIndex == 0u)
        c5SourceLuminanceHierarchy[0] = 0.0;
    barrier();
    for (uint nodeBase = 32u; nodeBase > 0u; nodeBase >>= 1u)
    {
        if (localIndex < nodeBase)
        {
            uint node = nodeBase + localIndex;
            c5SourceLuminanceHierarchy[node] =
                c5SourceLuminanceHierarchy[node * 2u] +
                c5SourceLuminanceHierarchy[node * 2u + 1u];
        }
        barrier();
    }

    vec3 nearEstimate = vec3(0.0);
    float confidence = 0.0;
    SimpleDdgiNearFieldResidualHitMetadata metadata =
        SimpleDdgiNearFieldZeroMetadata();
    uint failureFlags = covered ? C5_TRACE_REASON_INVALID_RECEIVER : 0u;
    uint rayLaunched = 0u;
    uint rayHitCount = 0u;
    uint traceSteps = 0u;
    uint mipVisits = 0u;
    uint maximumTraceSteps = 0u;
    uint maximumMipVisits = 0u;
    uint refinementVisits = 0u;
    bool valid = covered && EvaluateCandidate(
        pixel, metadataIndex, nearEstimate, confidence, metadata,
        failureFlags, rayLaunched, rayHitCount, traceSteps, mipVisits,
        maximumTraceSteps, maximumMipVisits, refinementVisits);

    c5TileCovered[localIndex] = covered ? 1u : 0u;
    c5TileValid[localIndex] = valid ? 1u : 0u;
    c5TileHit[localIndex] = valid ? rayHitCount : 0u;
    c5TileConfidence[localIndex] = valid ? confidence : 0.0;
    c5TileReasonFlags[localIndex] = failureFlags;
    c5TileRayLaunched[localIndex] = rayLaunched;
    c5TileTraceSteps[localIndex] = traceSteps;
    c5TileMipVisits[localIndex] = mipVisits;
    c5TileMaximumTraceSteps[localIndex] = maximumTraceSteps;
    // The diagnostics ABI carries this peak in six bits. Saturation is
    // diagnostic-only; traversal is governed solely by maximumTraceSteps.
    c5TileMaximumMipVisits[localIndex] = min(maximumMipVisits, 0x3fu);
    c5TileRefinementVisits[localIndex] = refinementVisits;
    barrier();

    if (localIndex == 0u)
    {
        RecordTileSummary(tileIndex);
        if (activeIndex == 0u)
        {
            traceTileRecords.words[4u] = pc.traceWidth;
            traceTileRecords.words[5u] = pc.traceHeight;
            atomicOr(traceTileRecords.words[7u],
                SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TRACE_COMPLETE);
        }
    }
    barrier();

    if (!covered)
        return;
    if (!valid)
    {
        WriteInvalid(pixel, metadataIndex);
        return;
    }

    // The B3 footprint is already the low-frequency control variate. A second
    // independently estimated 8x8 tile mean creates discontinuities at every
    // workgroup boundary and spreads one bright stochastic hit across the
    // other valid pixels as a dark residual. Preserve the per-receiver control
    // variate and let temporal/spatial filtering reduce its variance.
    if (!SimpleDdgiNearFieldFinite(nearEstimate))
    {
        WriteInvalid(pixel, metadataIndex);
        return;
    }
    imageStore(rawResidualOutput, pixel,
        vec4(nearEstimate, confidence));
    traceHitMetadata.values[metadataIndex] = metadata;
}
