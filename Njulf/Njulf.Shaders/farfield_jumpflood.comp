#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "farfield_clipmap.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform FarFieldJumpFloodPushBlock
{
    uint ParamsBufferIndex;
    uint VoxelBufferIndex;
    uint SourceSeedBufferIndex;
    uint DestSeedBufferIndex;
    uint Mode;
    uint Stride;
    uint DistanceBufferIndex;
    uint CurrentFrameIndex;
    uint PageVoxelOffset;
    uint PageDistanceWordOffset;
    uint PageTableBufferIndex;
    uint PageTableEntryIndex;
    uint PageGeneration;
    uint DiagnosticFlags;
    uint PageSourceRevisionLow;
    uint PageSourceRevisionHigh;
} pc;

const uint FARFIELD_JUMP_FLOOD_MODE_SEED = 0u;
const uint FARFIELD_JUMP_FLOOD_MODE_PROPAGATE = 1u;
const uint FARFIELD_JUMP_FLOOD_MODE_PUBLISH = 2u;
const uint FARFIELD_JUMP_FLOOD_VALID_BIT = 0x80000000u;

uint PackFarFieldSeed(uvec3 voxel)
{
    return FARFIELD_JUMP_FLOOD_VALID_BIT |
        ((voxel.x & 0xffu) << 0u) |
        ((voxel.y & 0xffu) << 8u) |
        ((voxel.z & 0xffu) << 16u);
}

bool FarFieldSeedValid(uint seed)
{
    return (seed & FARFIELD_JUMP_FLOOD_VALID_BIT) != 0u;
}

uvec3 UnpackFarFieldSeed(uint seed)
{
    return uvec3(
        (seed >> 0u) & 0xffu,
        (seed >> 8u) & 0xffu,
        (seed >> 16u) & 0xffu);
}

uvec3 FarFieldVoxelFromLinear(uint index, FarFieldClipmapParams p)
{
    uint xy = p.resolution.x * p.resolution.y;
    uint z = index / xy;
    uint rem = index - z * xy;
    uint y = rem / p.resolution.x;
    uint x = rem - y * p.resolution.x;
    return uvec3(x, y, z);
}

uint FarFieldLinearFromVoxel(uvec3 voxel, FarFieldClipmapParams p)
{
    return voxel.x + voxel.y * p.resolution.x + voxel.z * p.resolution.x * p.resolution.y;
}

float FarFieldSeedDistance2(uvec3 voxel, uint seed)
{
    if (!FarFieldSeedValid(seed))
        return 3.402823466e38;

    vec3 delta = vec3(ivec3(voxel) - ivec3(UnpackFarFieldSeed(seed)));
    return dot(delta, delta);
}

float FarFieldSeedBoxDistanceVoxels(uvec3 voxel, uint seed)
{
    if (!FarFieldSeedValid(seed))
        return 65535.0;

    vec3 delta = abs(vec3(ivec3(voxel) - ivec3(UnpackFarFieldSeed(seed)))) - vec3(0.5);
    return length(max(delta, vec3(0.0)));
}

void WritePackedDistance(uint packedWordIndex, uint lowDistance, uint highDistance)
{
    uint packed = (lowDistance & 0xffffu) | ((highDistance & 0xffffu) << 16u);
    WriteStorageWord(pc.DistanceBufferIndex, pc.PageDistanceWordOffset + packedWordIndex, packed);
}

FarFieldClipmapParams ResolveFarFieldJumpFloodParams(FarFieldClipmapParams params)
{
    if (!params.pagedEnabled)
        return params;

    uint tableBase = pc.PageTableEntryIndex * FAR_FIELD_PAGE_TABLE_ENTRY_WORDS;
    uint flags = ReadStorageWord(pc.PageTableBufferIndex, tableBase + 3u);
    uint cascade = flags & FAR_FIELD_PAGE_CASCADE_MASK;
    ivec3 worldPage = ivec3(
        int(ReadStorageWord(pc.PageTableBufferIndex, tableBase + 0u)),
        int(ReadStorageWord(pc.PageTableBufferIndex, tableBase + 1u)),
        int(ReadStorageWord(pc.PageTableBufferIndex, tableBase + 2u)));
    params.origin = FarFieldPageOrigin(params, cascade, worldPage);
    params.voxelSize = FarFieldCascadeVoxelSize(params, cascade);
    params.extent = FarFieldPageExtent(params, cascade);
    return params;
}

void main()
{
    FarFieldClipmapParams params = ResolveFarFieldJumpFloodParams(ReadFarFieldClipmapParams(pc.ParamsBufferIndex));
    uint dispatchIndex = gl_GlobalInvocationID.x;
    uint voxelCount = params.resolution.x * params.resolution.y * params.resolution.z;

    if (pc.Mode == FARFIELD_JUMP_FLOOD_MODE_SEED)
    {
        if (dispatchIndex >= voxelCount)
            return;

        bool occupied = FarFieldVoxelOccupied(
            pc.VoxelBufferIndex,
            pc.PageVoxelOffset + dispatchIndex,
            params);
        uint seed = occupied
            ? PackFarFieldSeed(FarFieldVoxelFromLinear(dispatchIndex, params))
            : 0u;
        WriteStorageWord(pc.SourceSeedBufferIndex, dispatchIndex, seed);
        WriteStorageWord(pc.DestSeedBufferIndex, dispatchIndex, seed);
        return;
    }

    if (pc.Mode == FARFIELD_JUMP_FLOOD_MODE_PROPAGATE)
    {
        if (dispatchIndex >= voxelCount)
            return;

        uvec3 voxel = FarFieldVoxelFromLinear(dispatchIndex, params);
        uint bestSeed = ReadStorageWord(pc.SourceSeedBufferIndex, dispatchIndex);
        float bestDistance2 = FarFieldSeedDistance2(voxel, bestSeed);
        int stride = int(max(pc.Stride, 1u));

        for (int dz = -1; dz <= 1; dz++)
        for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++)
        {
            ivec3 neighbor = ivec3(voxel) + ivec3(dx, dy, dz) * stride;
            if (!FarFieldInside(neighbor, params))
                continue;

            uint candidate = ReadStorageWord(pc.SourceSeedBufferIndex, FarFieldLinearFromVoxel(uvec3(neighbor), params));
            float candidateDistance2 = FarFieldSeedDistance2(voxel, candidate);
            if (candidateDistance2 < bestDistance2)
            {
                bestDistance2 = candidateDistance2;
                bestSeed = candidate;
            }
        }

        WriteStorageWord(pc.DestSeedBufferIndex, dispatchIndex, bestSeed);
        return;
    }

    if (pc.Mode == FARFIELD_JUMP_FLOOD_MODE_PUBLISH)
    {
        uint voxelIndex0 = dispatchIndex * 2u;
        if (voxelIndex0 >= voxelCount)
            return;

        uint seed0 = ReadStorageWord(pc.SourceSeedBufferIndex, voxelIndex0);
        uint distance0 = FarFieldSeedValid(seed0)
            ? uint(clamp(round(FarFieldSeedBoxDistanceVoxels(FarFieldVoxelFromLinear(voxelIndex0, params), seed0) * 256.0), 0.0, 65535.0))
            : 65535u;

        uint distance1 = 65535u;
        uint voxelIndex1 = voxelIndex0 + 1u;
        if (voxelIndex1 < voxelCount)
        {
            uint seed1 = ReadStorageWord(pc.SourceSeedBufferIndex, voxelIndex1);
            distance1 = FarFieldSeedValid(seed1)
                ? uint(clamp(round(FarFieldSeedBoxDistanceVoxels(FarFieldVoxelFromLinear(voxelIndex1, params), seed1) * 256.0), 0.0, 65535.0))
                : 65535u;
        }

        WritePackedDistance(dispatchIndex, distance0, distance1);
        if (dispatchIndex == 0u && !params.pagedEnabled)
        {
            WriteStorageFloat(pc.ParamsBufferIndex, 20u, float(pc.DistanceBufferIndex));
            WriteStorageFloat(pc.ParamsBufferIndex, 23u, 1.0);
        }
    }
}
