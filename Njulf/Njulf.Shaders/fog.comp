layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0, rgba16f) uniform writeonly image2D FoggedSceneColor;

layout(push_constant) uniform FogPushConstantBlock
{
    GPUFogPushConstants Push;
} pc;

#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
shared uint SimpleDdgiFogRepresentativeLane;
#endif

const uint FOG_MODE_DISABLED = 0u;
const uint FOG_MODE_DISTANCE = 1u;
const uint FOG_MODE_HEIGHT = 2u;
const uint FOG_MODE_DISTANCE_AND_HEIGHT = 3u;

const uint FOG_COLOR_CONSTANT = 0u;
const uint FOG_COLOR_SKY = 1u;
const uint FOG_COLOR_SKY_AND_CONSTANT_BLEND = 2u;

const uint FOG_DEBUG_NONE = 0u;
const uint FOG_DEBUG_FOG_FACTOR = 1u;
const uint FOG_DEBUG_TRANSMITTANCE = 2u;
const uint FOG_DEBUG_DISTANCE_FOG = 3u;
const uint FOG_DEBUG_HEIGHT_FOG = 4u;
const uint FOG_DEBUG_INSCATTERING = 5u;
const uint FOG_DEBUG_LINEAR_DEPTH = 6u;
const uint FOG_DEBUG_WORLD_HEIGHT = 7u;
const uint FOG_DEBUG_FOGGED_SCENE = 8u;

vec3 ReconstructWorldPosition(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    vec4 world = MulRowMajor(clip, pc.Push.InverseViewProjectionMatrix);
    return world.xyz / max(abs(world.w), 0.00001);
}

vec3 ResolveSkyFogColor(vec3 viewDirection)
{
    vec3 fallback = max(pc.Push.SkyColorAndBlend.rgb, vec3(0.0));

    if (pc.Push.ColorMode == FOG_COLOR_SKY)
    {
        GPUEnvironmentData environment = ReadEnvironmentData();
        vec3 sky = EvaluateEnvironmentRadiance(
            environment,
            viewDirection,
            false,
            false,
            false);
        sky = max(sky, fallback);
        return sky;
    }

    vec3 constantColor = max(pc.Push.FogColorAndDensity.rgb, vec3(0.0));
    if (pc.Push.ColorMode == FOG_COLOR_SKY_AND_CONSTANT_BLEND)
        return mix(fallback, constantColor, clamp(pc.Push.SkyColorAndBlend.w, 0.0, 1.0));

    return constantColor;
}

float DistanceTransmittance(float viewDistance)
{
    float startDistance = pc.Push.FogDistanceParams.x;
    float endDistance = max(pc.Push.FogDistanceParams.y, startDistance + 0.01);
    float distancePastStart = max(viewDistance - startDistance, 0.0);
    float opticalDepth = distancePastStart * max(pc.Push.FogColorAndDensity.w, 0.0);
    float transmittance = exp(-opticalDepth);
    float rangeFactor = smoothstep(startDistance, endDistance, viewDistance);
    return mix(1.0, transmittance, rangeFactor);
}

float HeightTransmittance(vec3 worldPosition, float viewDistance)
{
    float fogHeight = pc.Push.FogHeightParams.x;
    float heightFalloff = max(pc.Push.FogHeightParams.y, 0.001);
    float heightDensity = max(pc.Push.FogHeightParams.z, 0.0);
    float cameraHeight = pc.Push.CameraPositionAndTime.y - fogHeight;
    float pointHeight = worldPosition.y - fogHeight;
    float lowerHeight = max(min(cameraHeight, pointHeight), 0.0);
    float averageDensity = exp(-heightFalloff * lowerHeight);
    float opticalDepth = viewDistance * heightDensity * averageDensity;
    return exp(-opticalDepth);
}

vec3 DirectionalInscattering(vec3 viewDirection, float fogFactor)
{
    if (pc.Push.DirectionalInscatteringEnabled == 0u)
        return vec3(0.0);

    vec3 sunDirection = normalize(pc.Push.DirectionalInscatteringDirectionAndExponent.xyz);
    float exponent = max(pc.Push.DirectionalInscatteringDirectionAndExponent.w, 1.0);
    float sunAmount = pow(max(dot(viewDirection, -sunDirection), 0.0), exponent);
    return max(pc.Push.DirectionalInscatteringColorAndIntensity.rgb, vec3(0.0)) *
        max(pc.Push.DirectionalInscatteringColorAndIntensity.w, 0.0) *
        sunAmount *
        fogFactor;
}

vec3 ResolveDdgiFogAmbient(
    vec3 cameraPosition,
    vec3 worldPosition,
    vec3 viewDirection,
    float fogFactor,
    out SimpleDdgiGatherResult gather,
    out float effectiveOwnership,
    out float indirectIntensity)
{
    gather = EmptySimpleDdgiGatherResult();
    effectiveOwnership = 0.0;
    indirectIntensity = 0.0;
    if (fogFactor <= 0.0001)
        return vec3(0.0);

    vec3 samplePosition = mix(cameraPosition, worldPosition, 0.5);
    vec3 ambientNormal = abs(viewDirection.y) < 0.95
        ? normalize(vec3(-viewDirection.x, 0.35, -viewDirection.z))
        : vec3(0.0, 1.0, 0.0);
    SimpleDdgiParams simpleParams = ReadSimpleDdgiParams(uint(SIMPLE_DDGI_PARAMS_BUFFER_INDEX));
    if ((simpleParams.flags & (SIMPLE_DDGI_FLAG_ENABLED | SIMPLE_DDGI_FLAG_FOG_ENABLED)) ==
        (SIMPLE_DDGI_FLAG_ENABLED | SIMPLE_DDGI_FLAG_FOG_ENABLED) &&
        simpleParams.probeCount > 0u)
    {
        gather = SampleSimpleDdgiGather(
            simpleParams,
            samplePosition,
            ambientNormal,
            -viewDirection);
        float radiometricOwnership =
            SimpleDdgiRadiometricOwnership(gather);
        float leakAttenuation =
            SimpleDdgiLeakAttenuation(gather, simpleParams);
        effectiveOwnership = radiometricOwnership * leakAttenuation;
        indirectIntensity = max(simpleParams.indirectIntensity, 0.0);
        vec3 irradiance = gather.irradiance * effectiveOwnership;
        float fallbackWeight = (1.0 - radiometricOwnership) *
            simpleParams.environmentFallbackIntensity;
        if (fallbackWeight >
            SIMPLE_DDGI_ENVIRONMENT_FALLBACK_MIN_WEIGHT)
        {
            vec3 fallback = SimpleDdgiEnvironmentIrradianceFallback(
                ambientNormal,
                simpleParams);
            if ((simpleParams.flags &
                    SIMPLE_DDGI_FLAG_SKY_VISIBILITY_ENABLED) != 0u)
            {
                fallback *= EstimateFarFieldSkyVisibility(
                    samplePosition,
                    ambientNormal,
                    simpleParams,
                    1u);
            }
            irradiance += fallback * fallbackWeight;
        }
        return clamp(irradiance, vec3(0.0), vec3(64.0)) *
            indirectIntensity * fogFactor * 0.18;
    }

    return vec3(0.0);
}

#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
const uint SIMPLE_DDGI_FOG_FEEDBACK_PRODUCER = 4u;

float SimpleDdgiFogTriangleSolidAngle(vec3 a, vec3 b, vec3 c)
{
    float numerator = abs(dot(a, cross(b, c)));
    float denominator = max(
        1.0 + dot(a, b) + dot(b, c) + dot(c, a),
        0.0000001);
    return 2.0 * atan(numerator, denominator);
}

vec3 SimpleDdgiFogViewRay(vec2 uv)
{
    vec3 cameraPosition = pc.Push.CameraPositionAndTime.xyz;
    vec3 nearPoint = ReconstructWorldPosition(
        clamp(uv, vec2(0.0), vec2(1.0)),
        1.0);
    vec3 ray = nearPoint - cameraPosition;
    float lengthSquared = dot(ray, ray);
    return lengthSquared > 0.0000001 &&
            !isnan(lengthSquared) && !isinf(lengthSquared)
        ? ray * inversesqrt(lengthSquared)
        : vec3(0.0, 0.0, -1.0);
}

float SimpleDdgiFogWorkgroupSolidAngle(ivec2 extent)
{
    vec2 safeExtent = vec2(max(extent, ivec2(1)));
    vec2 minimumPixel = vec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy);
    vec2 maximumPixel = min(
        minimumPixel + vec2(gl_WorkGroupSize.xy),
        safeExtent);
    vec2 uv00 = minimumPixel / safeExtent;
    vec2 uv10 = vec2(maximumPixel.x, minimumPixel.y) / safeExtent;
    vec2 uv01 = vec2(minimumPixel.x, maximumPixel.y) / safeExtent;
    vec2 uv11 = maximumPixel / safeExtent;
    vec3 r00 = SimpleDdgiFogViewRay(uv00);
    vec3 r10 = SimpleDdgiFogViewRay(uv10);
    vec3 r01 = SimpleDdgiFogViewRay(uv01);
    vec3 r11 = SimpleDdgiFogViewRay(uv11);
    float solidAngle =
        SimpleDdgiFogTriangleSolidAngle(r00, r10, r11) +
        SimpleDdgiFogTriangleSolidAngle(r00, r11, r01);
    if (!(solidAngle > 0.0) || isnan(solidAngle) || isinf(solidAngle))
    {
        vec2 covered = max(maximumPixel - minimumPixel, vec2(0.0));
        solidAngle = 4.0 * 3.14159265359 *
            (covered.x * covered.y) /
            max(safeExtent.x * safeExtent.y, 1.0);
    }
    return solidAngle;
}

void EmitSimpleDdgiFogReceiverFeedback(
    SimpleDdgiGatherResult gather,
    float effectiveOwnership,
    float indirectIntensity,
    float fogFactor,
    ivec2 extent)
{
    if (gl_LocalInvocationIndex != SimpleDdgiFogRepresentativeLane ||
        (pc.Push.DebugView != FOG_DEBUG_NONE &&
         pc.Push.DebugView != FOG_DEBUG_FOGGED_SCENE))
    {
        return;
    }

    uint controlOffsetWords;
    uint effectiveProducer =
        gather.exactFeedbackRefinementOrBaseFallback != 0u
            ? 6u
            : SIMPLE_DDGI_FOG_FEEDBACK_PRODUCER;
    if (!SimpleDdgiReceiverFeedbackTryResolveFrameControlOffset(
            pc.Push.CurrentFrameIndex,
            controlOffsetWords) ||
        !SimpleDdgiReceiverFeedbackProducerControlIsValid(
            controlOffsetWords,
            effectiveProducer))
    {
        return;
    }
    uint samplingPeriod = SimpleDdgiReceiverFeedbackProducerControlWord(
        controlOffsetWords,
        SIMPLE_DDGI_RECEIVER_FEEDBACK_CAPTURE_CONTROL_SAMPLE_PERIOD);
    uint samplingPhase = SimpleDdgiReceiverFeedbackProducerControlWord(
        controlOffsetWords,
        SIMPLE_DDGI_RECEIVER_FEEDBACK_CAPTURE_CONTROL_SAMPLE_PHASE);
    uint maximumOwners = SimpleDdgiReceiverFeedbackProducerControlWord(
        controlOffsetWords,
        SIMPLE_DDGI_RECEIVER_FEEDBACK_CAPTURE_CONTROL_MAXIMUM_OWNERS);
    uint groupCountX = (uint(max(extent.x, 1)) + gl_WorkGroupSize.x - 1u) /
        gl_WorkGroupSize.x;
    uint workgroupId = gl_WorkGroupID.y * groupCountX + gl_WorkGroupID.x;
    bool policyValid = samplingPeriod != 0u &&
        samplingPhase < samplingPeriod && maximumOwners != 0u &&
        maximumOwners <= SIMPLE_DDGI_EXACT_FEEDBACK_MAX_OWNERS;
    if (!policyValid)
    {
        SimpleDdgiReceiverFeedbackMarkProducerFailure(
            controlOffsetWords,
            effectiveProducer,
            1u);
        return;
    }
    // Contiguous workgroup strata give the CPU quota compiler an exact upper
    // bound while the rotating phase visits every froxel tile over time.
    if (workgroupId % samplingPeriod != samplingPhase)
        return;
    if (gather.exactFeedbackOverflow != 0u ||
        gather.exactFeedbackOwnerCount > maximumOwners)
    {
        SimpleDdgiReceiverFeedbackMarkProducerFailure(
            controlOffsetWords,
            effectiveProducer,
            max(gather.exactFeedbackOwnerCount, 1u));
        return;
    }

    float physicalContribution =
        SimpleDdgiFogWorkgroupSolidAngle(extent) *
        clamp(effectiveOwnership, 0.0, 1.0) *
        max(indirectIntensity, 0.0) * 0.18 *
        clamp(fogFactor, 0.0, 1.0) * clamp(fogFactor, 0.0, 1.0);
    if (!(physicalContribution > 0.0) ||
        isnan(physicalContribution) || isinf(physicalContribution))
    {
        return;
    }

    SimpleDdgiReceiverFeedbackProducerReservation reservation =
        SimpleDdgiReceiverFeedbackReserveProducerRecords(
            controlOffsetWords,
            effectiveProducer,
            gather.exactFeedbackOwnerCount);
    uvec2 stableReceiverIdentity = uvec2(
        workgroupId,
        uint(extent.x) ^ (uint(extent.y) << 16u));
    for (uint ownerIndex = 0u;
         ownerIndex < gather.exactFeedbackOwnerCount;
         ++ownerIndex)
    {
        uint recordIndex;
        if (!SimpleDdgiReceiverFeedbackTryGetReservationRecord(
                reservation,
                ownerIndex,
                recordIndex))
        {
            continue;
        }
        SimpleDdgiExactFeedbackOwner owner =
            gather.exactFeedbackOwners[ownerIndex];
        SimpleDdgiReceiverFeedbackWriteCandidate(
            controlOffsetWords,
            recordIndex,
            effectiveProducer,
            owner.fallbackRole,
            owner.requestedProbe,
            owner.resolvedProbe,
            owner.resolvedPage,
            owner.requestedPage,
            workgroupId,
            owner.normalizedWeight,
            float(samplingPeriod),
            physicalContribution,
            owner.pageGeneration,
            stableReceiverIdentity);
    }
}
#endif

vec3 DebugColor(
    float distanceFog,
    float heightFog,
    float transmittance,
    float fogFactor,
    vec3 inscattering,
    float viewDistance,
    float worldHeight,
    vec3 fogged)
{
    if (pc.Push.DebugView == FOG_DEBUG_FOG_FACTOR)
        return vec3(fogFactor);
    if (pc.Push.DebugView == FOG_DEBUG_TRANSMITTANCE)
        return vec3(transmittance);
    if (pc.Push.DebugView == FOG_DEBUG_DISTANCE_FOG)
        return vec3(distanceFog);
    if (pc.Push.DebugView == FOG_DEBUG_HEIGHT_FOG)
        return vec3(heightFog);
    if (pc.Push.DebugView == FOG_DEBUG_INSCATTERING)
        return clamp(inscattering, vec3(0.0), vec3(8.0)) / vec3(8.0);
    if (pc.Push.DebugView == FOG_DEBUG_LINEAR_DEPTH)
    {
        float endDistance = max(pc.Push.FogDistanceParams.y, pc.Push.FogDistanceParams.x + 0.01);
        return vec3(clamp(viewDistance / endDistance, 0.0, 1.0));
    }
    if (pc.Push.DebugView == FOG_DEBUG_WORLD_HEIGHT)
    {
        float relativeHeight = (worldHeight - pc.Push.FogHeightParams.x) * 0.05 + 0.5;
        return vec3(clamp(relativeHeight, 0.0, 1.0));
    }
    if (pc.Push.DebugView == FOG_DEBUG_FOGGED_SCENE)
        return fogged;

    return fogged;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(FoggedSceneColor);
    bool inBounds = pixel.x < extent.x && pixel.y < extent.y;
    float depth = inBounds
        ? texelFetch(
            BindlessTextures[nonuniformEXT(int(pc.Push.DepthTextureIndex))],
            pixel,
            0).r
        : 0.0;
#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
    if (gl_LocalInvocationIndex == 0u)
        SimpleDdgiFogRepresentativeLane = 0xffffffffu;
    barrier();
    if (inBounds && pc.Push.Mode != FOG_MODE_DISABLED && depth > 0.000001)
        atomicMin(SimpleDdgiFogRepresentativeLane, gl_LocalInvocationIndex);
    barrier();
#endif
    if (!inBounds)
        return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / max(pc.Push.ScreenDimensions.xy, vec2(1.0));
    vec3 sceneColor = max(texture(BindlessTextures[nonuniformEXT(int(pc.Push.SceneColorTextureIndex))], uv).rgb, vec3(0.0));

    if (pc.Push.Mode == FOG_MODE_DISABLED || depth <= 0.000001)
    {
        vec3 result = pc.Push.DebugView == FOG_DEBUG_NONE || pc.Push.DebugView == FOG_DEBUG_FOGGED_SCENE
            ? sceneColor
            : vec3(0.0);
        imageStore(FoggedSceneColor, pixel, vec4(result, 1.0));
        return;
    }

    vec3 worldPosition = ReconstructWorldPosition(uv, depth);
    vec3 cameraPosition = pc.Push.CameraPositionAndTime.xyz;
    vec3 cameraToPixel = worldPosition - cameraPosition;
    float viewDistance = length(cameraToPixel);
    vec3 viewDirection = viewDistance > 0.00001 ? cameraToPixel / viewDistance : vec3(0.0, 0.0, -1.0);

    bool distanceEnabled = pc.Push.Mode == FOG_MODE_DISTANCE || pc.Push.Mode == FOG_MODE_DISTANCE_AND_HEIGHT;
    bool heightEnabled = pc.Push.Mode == FOG_MODE_HEIGHT || pc.Push.Mode == FOG_MODE_DISTANCE_AND_HEIGHT;
    float distanceTransmittance = distanceEnabled ? DistanceTransmittance(viewDistance) : 1.0;
    float heightTransmittance = heightEnabled ? HeightTransmittance(worldPosition, viewDistance) : 1.0;
    float transmittance = clamp(distanceTransmittance * heightTransmittance, 0.0, 1.0);
    float maxOpacity = clamp(pc.Push.FogHeightParams.w, 0.0, 1.0);
    float fogFactor = min(1.0 - transmittance, maxOpacity);

    vec3 fogColor = ResolveSkyFogColor(viewDirection);
    vec3 inscattering = DirectionalInscattering(viewDirection, fogFactor);
    SimpleDdgiGatherResult fogGather;
    float fogDdgiOwnership;
    float fogDdgiIndirectIntensity;
    vec3 ddgiFogAmbient = ResolveDdgiFogAmbient(
        cameraPosition,
        worldPosition,
        viewDirection,
        fogFactor,
        fogGather,
        fogDdgiOwnership,
        fogDdgiIndirectIntensity);
    vec3 fogRadiance = fogColor + inscattering + ddgiFogAmbient;
    vec3 fogged = mix(sceneColor, fogRadiance, fogFactor);

    vec3 result = pc.Push.DebugView == FOG_DEBUG_NONE
        ? fogged
        : DebugColor(
            1.0 - distanceTransmittance,
            1.0 - heightTransmittance,
            transmittance,
            fogFactor,
            inscattering,
            viewDistance,
            worldPosition.y,
            fogged);

#if NJULF_SIMPLE_DDGI_EXACT_FEEDBACK_ATTRIBUTION
    EmitSimpleDdgiFogReceiverFeedback(
        fogGather,
        fogDdgiOwnership,
        fogDdgiIndirectIntensity,
        fogFactor,
        extent);
#endif

    imageStore(FoggedSceneColor, pixel, vec4(result, 1.0));
}
