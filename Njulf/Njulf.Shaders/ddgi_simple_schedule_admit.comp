#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

#ifndef SIMPLE_DDGI_SCHEDULER_ADMISSION_ROLE
#define SIMPLE_DDGI_SCHEDULER_ADMISSION_ROLE 0
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Admission is intentionally serialized in lane order.  Classification and
// compaction are massively parallel; this small bounded pass is the single
// deterministic authority for reservations, cursors, and queue indices.  It
// avoids making atomic arrival order a hidden priority rule.
void main()
{
    if (SchedulerCertifiedQuiesced())
        return;

    if (gl_GlobalInvocationID.x != 0u)
        return;

    if (SchedulerArenaRead(
            pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW) != 0u)
        return;

    // Lane-base has already reduced the exact eligible population. Certified
    // stationary frames normally have no compacted candidates; returning here
    // avoids a serialized scan of all 896 lanes plus the large deterministic
    // quota scratch arrays. Reset already cleared every work counter and emit
    // command, so the no-work transaction remains fully specified.
    if (SchedulerArenaRead(
            pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_COMPACTED) == 0u)
    {
        SchedulerWriteIndirect(
            SIMPLE_DDGI_SCHEDULER_DISPATCH_EMIT,
            1u,
            1u,
            1u);
        return;
    }

    uint requestCapacity = SchedulerRequestCapacity();
    uint requestBudget = min(SchedulerRequestBudget(), requestCapacity);
    if (requestBudget == 0u)
    {
        // A current tail certificate quiesces nonparticipant maintenance on
        // most frames. Preserve the explicit empty transaction without paying
        // for deterministic quota construction or lane scans.
        SchedulerWriteIndirect(
            SIMPLE_DDGI_SCHEDULER_DISPATCH_EMIT,
            1u,
            1u,
            1u);
        return;
    }
    uint activeVolumes = min(SchedulerActiveVolumeCount(), SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES);
    uint primaryBudget = SchedulerPrimaryRayBudget();
    uint sourceBudget = SchedulerSourceTargetRays();
    bool sourceBudgetLimited = sourceBudget != 0u;
    uint pendingTailSourceCount = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_PENDING_TAIL_SOURCE);
    // Source validity always precedes cached solving, including probe-local
    // repair inside an already-open solve epoch. Compatible toroidal scrolling
    // and a lighting boundary can both expose source-stale participants after
    // solveEpoch became nonzero. Drain that bounded cohort first, then resume
    // the retained epoch and its overlapping visit stamps.
    bool tailSourceOnly = SchedulerTailCertification() &&
        pendingTailSourceCount != 0u;
    bool tailSolveOnly = SchedulerTailCertification() &&
        !tailSourceOnly &&
        SchedulerSolveEpoch() != 0u;
    bool transactionSpecializedTailPhase = tailSourceOnly || tailSolveOnly;
#if SIMPLE_DDGI_SCHEDULER_ADMISSION_ROLE == 1
    if (!transactionSpecializedTailPhase)
        return;
    const bool specializedTailPhase = true;
#else
    if (transactionSpecializedTailPhase)
        return;
    const bool specializedTailPhase = false;
#endif

    uint quotas[16];
    uint volumeUsage[16];
    uint sourceVolumeBudgets[16];
    uint sourceVolumeUsage[16];
    uint specializedPendingByVolume[16];
    uint visiblePagePendingByVolume[16];
    uint visiblePageQuotas[16];
    uint visiblePageUsage[16];
    // Only lanes that accept work need a persistent-cursor update. Tracking
    // them in a compact private bitset avoids a serialized pair of global
    // reads across all 896 lanes at the end of every active transaction.
    uint admittedLaneMask[28];
    uint pendingByClass[16 * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint classReservations[16 * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint classUsage[16 * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint acceptedByClass[SIMPLE_DDGI_SCHEDULER_WORK_CLASSES];
    uint minimumTotal = 0u;
    uint quotaTotal = 0u;
    for (uint maskWord = 0u; maskWord < 28u; maskWord++)
        admittedLaneMask[maskWord] = 0u;
    for (uint workClass = 0u;
         workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
         workClass++)
    {
        acceptedByClass[workClass] = 0u;
    }
    // Distribute each volume's fractional source cadence independently. Over
    // one complete interval every volume receives exactly its probe count,
    // preventing a high-ray near ring from consuming the shared target before
    // a lower-ray offscreen ring can be admitted.
    // Word 29 is the safe start-to-start refresh cadence and includes the
    // solve/audit reserve. Source work must instead honor the independently
    // authored probe target in word 7; otherwise expanding the outer cadence
    // also slows the source sweep and recreates the starvation loop.
    uint sourceProbeTarget = max(SchedulerSourceTargetProbes(), 1u);
    uint sourceInterval = clamp(
        (SchedulerActiveProbeCount() + sourceProbeTarget - 1u) /
            sourceProbeTarget,
        1u,
        65535u);
    uint sourcePhase = SchedulerFrameIndex() % sourceInterval;
    for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
    {
        quotas[volume] = 0u;
        volumeUsage[volume] = 0u;
        sourceVolumeBudgets[volume] = 0u;
        sourceVolumeUsage[volume] = 0u;
        specializedPendingByVolume[volume] = 0u;
        visiblePagePendingByVolume[volume] = 0u;
        visiblePageQuotas[volume] = 0u;
        visiblePageUsage[volume] = 0u;
        if (!specializedTailPhase)
        {
            for (uint workClass = 0u;
                 workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
                 workClass++)
            {
                pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] = 0u;
                classReservations[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] = 0u;
                classUsage[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] = 0u;
            }
        }
        // Specialized source/solve phases replace the ordinary weighted quota
        // in full below. Building the generic policy quota first only to throw
        // it away performs dozens of dependent policy-buffer reads on the one
        // serialized admission lane.
        if (volume >= activeVolumes || specializedTailPhase)
            continue;
        uint capacity = SchedulerVolumeProbeCount(volume);
        uint baseSourceTarget = capacity / sourceInterval;
        uint sourceRemainder = capacity % sourceInterval;
        uint sourceBefore = sourcePhase * sourceRemainder / sourceInterval;
        uint sourceAfter = (sourcePhase + 1u) * sourceRemainder / sourceInterval;
        uint volumeSourceProbeTarget = baseSourceTarget + sourceAfter - sourceBefore;
        sourceVolumeBudgets[volume] = volumeSourceProbeTarget *
            clamp(
                SchedulerVolumeFullRays(volume),
                1u,
                SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
        uint mandatoryRepair = SchedulerVolumeHasMandatoryScrollRepair(volume)
            ? min(SchedulerVolumeScrollExpectedRepairCount(volume), capacity)
            : 0u;
        uint minimum = max(
            min(SchedulerVolumeWord(volume, 26u), capacity),
            mandatoryRepair);
        uint maximum = min(max(
            SchedulerVolumeWord(volume, 27u),
            minimum), capacity);
        quotas[volume] = minimum;
        minimumTotal += minimum;
        quotaTotal += maximum;
    }

    if (!specializedTailPhase)
    {
        if (minimumTotal > requestBudget)
        {
            uint excess = minimumTotal - requestBudget;
            for (uint reverse = 0u; reverse < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; reverse++)
            {
                uint volume = SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES - 1u - reverse;
                if (volume >= activeVolumes || excess == 0u)
                    continue;
                uint mandatoryRepair = SchedulerVolumeHasMandatoryScrollRepair(volume)
                    ? min(
                        SchedulerVolumeScrollExpectedRepairCount(volume),
                        SchedulerVolumeProbeCount(volume))
                    : 0u;
                uint reduction = min(
                    quotas[volume] - min(quotas[volume], mandatoryRepair),
                    excess);
                quotas[volume] -= reduction;
                excess -= reduction;
            }
        }
        else
        {
            uint remaining = requestBudget - minimumTotal;
            // Match the CPU oracle's two weighted quota passes: preferred maxima
            // are filled first, then unused budget is returned to volumes up to
            // their physical capacities. Stable volume order is the remainder
            // tie-break in both passes.
            for (uint quotaPass = 0u; quotaPass < 2u && remaining > 0u; quotaPass++)
            {
                while (remaining > 0u)
                {
                    uint weightTotal = 0u;
                    for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
                    {
                        if (volume >= activeVolumes)
                            continue;
                        uint preferred = min(max(SchedulerVolumeWord(volume, 27u),
                            SchedulerVolumeWord(volume, 26u)), SchedulerVolumeProbeCount(volume));
                        uint maximum = quotaPass == 0u
                            ? preferred
                            : SchedulerVolumeProbeCount(volume);
                        if (quotas[volume] < maximum)
                            weightTotal += max(SchedulerVolumeWord(volume, 28u), 1u);
                    }
                    if (weightTotal == 0u)
                        break;

                    uint distributed = 0u;
                    uint bestVolume = SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES;
                    uint bestRemainder = 0u;
                    for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
                    {
                        if (volume >= activeVolumes)
                            continue;
                        uint preferred = min(max(SchedulerVolumeWord(volume, 27u),
                            SchedulerVolumeWord(volume, 26u)), SchedulerVolumeProbeCount(volume));
                        uint maximum = quotaPass == 0u
                            ? preferred
                            : SchedulerVolumeProbeCount(volume);
                        if (quotas[volume] >= maximum)
                            continue;
                        uint weight = max(SchedulerVolumeWord(volume, 28u), 1u);
                        uint share = min(maximum - quotas[volume],
                            (remaining * weight) / weightTotal);
                        if (share > 0u)
                        {
                            quotas[volume] += share;
                            distributed += share;
                        }
                        uint remainder = (remaining * weight) % weightTotal;
                        if (bestVolume == SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES ||
                            remainder > bestRemainder)
                        {
                            bestVolume = volume;
                            bestRemainder = remainder;
                        }
                    }
                    if (distributed > remaining)
                        distributed = remaining;
                    remaining -= distributed;
                    if (distributed == 0u)
                    {
                        if (bestVolume == SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES)
                            break;
                        quotas[bestVolume]++;
                        remaining--;
                    }
                }
            }
        }
    }

    if (specializedTailPhase)
    {
        // The ordinary weighted quota is policy-based and may legally assign
        // the whole small V2 envelope to a near volume that has no current
        // candidates. That strands dense outer-ring source participants (and
        // later solve participants) forever. During a certificate phase the
        // frozen candidate lanes are the authority: distribute the bounded
        // request envelope over volumes that actually contain phase work.
        uint specializedPendingTotal = 0u;
        uint visiblePagePendingTotal = 0u;
        for (uint activeIndex = 0u;
             activeIndex < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             activeIndex++)
        {
            uint lane = SchedulerArenaRead(
                pc.LaneTotalsOffsetWords + activeIndex);
            if (lane == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                break;
            uint volume;
            uint workClass;
            uint transport;
            uint rayTier;
            SchedulerDecodeLane(
                lane,
                volume,
                workClass,
                transport,
                rayTier);
            bool specializedTransport = tailSourceOnly
                ? transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
                    transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE
                : transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER;
            if (volume >= activeVolumes || !specializedTransport)
                continue;
            uint pending = SchedulerArenaRead(
                pc.LaneCandidateCountsOffsetWords + lane);
            specializedPendingByVolume[volume] += pending;
            specializedPendingTotal += pending;
        }
        uint assigned = 0u;
        for (uint volume = 0u;
             volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES;
             volume++)
        {
            quotas[volume] = 0u;
            if (volume >= activeVolumes)
                continue;
            uint pending = specializedPendingByVolume[volume];
            specializedPendingByVolume[volume] = pending;
            uint visiblePagePending = min(
                SchedulerArenaRead(
                    pc.CountersOffsetWords +
                        SIMPLE_DDGI_SCHEDULER_COUNTER_VISIBLE_PAGE_COHORT_BASE +
                        volume),
                pending);
            visiblePagePendingByVolume[volume] = visiblePagePending;
            visiblePagePendingTotal += visiblePagePending;

            // Specialized source/solve quota distribution must preserve the
            // exact phase-11 reservation established by the scroll planner.
            // These candidates are disjoint from visible-page publication and
            // execute first, so reserve them before sharing the residual tail
            // envelope among any other source participants.
            uint mandatoryRepair = tailSourceOnly &&
                    SchedulerVolumeHasMandatoryScrollRepair(volume)
                ? min(
                    SchedulerVolumeScrollExpectedRepairCount(volume),
                    pending)
                : 0u;
            uint mandatoryRoom = requestBudget - min(assigned, requestBudget);
            mandatoryRepair = min(mandatoryRepair, mandatoryRoom);
            quotas[volume] = mandatoryRepair;
            assigned += mandatoryRepair;
        }

        // Reserve the global source envelope for newly admitted visible pages
        // before proportional whole-field repair. Exact classification counters
        // avoid treating all fresh/zero-support work as page publication. The
        // allocator already bounds this cohort to the two-frame probe capacity,
        // so draining it first is both coherent and frame-budget neutral.
        uint visiblePageBudget = min(
            requestBudget - min(assigned, requestBudget),
            visiblePagePendingTotal);
        uint visibleAssigned = 0u;
        if (visiblePageBudget != 0u)
        {
            for (uint volume = 0u;
                 volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES;
                 volume++)
            {
                uint pending = visiblePagePendingByVolume[volume];
                if (pending == 0u || visibleAssigned >= visiblePageBudget)
                    continue;
                uint share = min(
                    pending,
                    (visiblePageBudget * pending) /
                        visiblePagePendingTotal);
                share = min(share, visiblePageBudget - visibleAssigned);
                quotas[volume] += share;
                visiblePageQuotas[volume] = share;
                visibleAssigned += share;
            }

            uint visibleRemainder = visiblePageBudget - visibleAssigned;
            while (visibleRemainder != 0u)
            {
                bool progressed = false;
                for (uint volume = 0u;
                     volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES &&
                         visibleRemainder != 0u;
                     volume++)
                {
                    if (visiblePageQuotas[volume] >=
                        visiblePagePendingByVolume[volume])
                        continue;
                    quotas[volume]++;
                    visiblePageQuotas[volume]++;
                    visibleRemainder--;
                    progressed = true;
                }
                if (!progressed)
                    break;
            }
            visibleAssigned = visiblePageBudget - visibleRemainder;
            assigned += visibleAssigned;
        }

        // Return every unreserved request to the ordinary frozen source
        // cohort. One proportional pass handles the bulk; the at-most-fifteen
        // floor remainders use stable volume order as the deterministic tie.
        uint remaining = requestBudget - min(assigned, requestBudget);
        // Proportional floors alone can permanently assign zero to a small
        // final volume (for example two missing probes beside an 800-probe
        // source cohort). Stable remainder order then repeats that zero every
        // frame. Reserve one slot per nonempty residual volume before the
        // proportional pass. Rotate the first volume so configurations whose
        // request budget is smaller than their active-volume count still make
        // bounded progress instead of favoring low volume indices forever.
        uint livenessVolumeStart = SchedulerFrameIndex() %
            max(activeVolumes, 1u);
        for (uint offset = 0u;
             offset < activeVolumes && remaining != 0u;
             offset++)
        {
            uint volume = (livenessVolumeStart + offset) % activeVolumes;
            uint available = specializedPendingByVolume[volume] - min(
                specializedPendingByVolume[volume],
                quotas[volume]);
            if (available == 0u)
                continue;
            quotas[volume]++;
            remaining--;
        }
        uint residualPendingTotal = 0u;
        for (uint volume = 0u;
             volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES;
             volume++)
        {
            residualPendingTotal += specializedPendingByVolume[volume] - min(
                specializedPendingByVolume[volume],
                quotas[volume]);
        }
        uint distributed = 0u;
        if (remaining != 0u && residualPendingTotal != 0u)
        {
            for (uint volume = 0u;
                 volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES;
                 volume++)
            {
                uint available = specializedPendingByVolume[volume] - min(
                    specializedPendingByVolume[volume],
                    quotas[volume]);
                uint share = min(
                    available,
                    (remaining * available) / residualPendingTotal);
                quotas[volume] += share;
                distributed += share;
            }
            remaining -= min(distributed, remaining);
        }
        while (remaining != 0u)
        {
            bool progressed = false;
            for (uint volume = 0u;
                 volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES &&
                     remaining != 0u;
                 volume++)
            {
                if (quotas[volume] >= specializedPendingByVolume[volume])
                    continue;
                quotas[volume]++;
                remaining--;
                progressed = true;
            }
            if (!progressed)
                break;
        }
    }

    // Mirror the CPU oracle's per-volume class reservations. A single global
    // maintenance reservation is insufficient: it lets a busy near volume
    // consume the reservation belonging to an outer volume. The reservation
    // is applied to every priority phase below; phase 10 returns unused
    // reservations in deterministic policy order.
    if (!specializedTailPhase)
    {
        for (uint activeIndex = 0u;
             activeIndex < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             activeIndex++)
        {
            uint lane = SchedulerArenaRead(
                pc.LaneTotalsOffsetWords + activeIndex);
            if (lane == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                break;
            uint volume;
            uint workClass;
            uint transport;
            uint rayTier;
            SchedulerDecodeLane(
                lane,
                volume,
                workClass,
                transport,
                rayTier);
            if (volume >= activeVolumes || quotas[volume] == 0u)
                continue;
            pendingByClass[
                volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] +=
                SchedulerArenaRead(
                    pc.LaneCandidateCountsOffsetWords + lane);
        }
        for (uint volume = 0u; volume < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES; volume++)
        {
            if (volume >= activeVolumes || quotas[volume] == 0u)
                continue;

            uint zeroSupport = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
                SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT];
            uint fresh = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
                SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE];
            uint dirty = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
                SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY];
            uint retry = pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
                SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY];
            uint maintenanceClass = SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
            for (uint workClass = SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE;
                 workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
                 workClass++)
            {
                if (pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + workClass] != 0u)
                {
                    maintenanceClass = workClass;
                    break;
                }
            }
            uint maintenance = maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES
                ? pendingByClass[volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES + maintenanceClass]
                : 0u;
            uint maintenanceReservation = maintenance != 0u && quotas[volume] >= 4u
                ? min(maintenance, max(1u, quotas[volume] / 16u))
                : 0u;
            uint retryReservation = retry != 0u && quotas[volume] >= 3u
                ? min(retry, max(1u, quotas[volume] / 8u))
                : 0u;
            uint dirtyReservation = dirty != 0u && quotas[volume] >= 2u
                ? min(dirty, max(1u, quotas[volume] / 4u))
                : 0u;
            uint lowerReservations = maintenanceReservation + retryReservation + dirtyReservation;
            if (lowerReservations >= quotas[volume] &&
                (zeroSupport != 0u || fresh != 0u || dirty != 0u || retry != 0u))
            {
                if (maintenanceReservation != 0u)
                    maintenanceReservation--;
                else if (retryReservation != 0u)
                    retryReservation--;
                else if (dirtyReservation != 0u)
                    dirtyReservation--;
                lowerReservations--;
            }

            uint primaryClass = zeroSupport != 0u
                ? SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT
                : (fresh != 0u
                    ? SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE
                    : (dirty != 0u
                        ? SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY
                        : (retry != 0u
                            ? SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY
                            : maintenanceClass)));
            if (primaryClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
            {
                uint primaryBase = volume * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
                if (primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT ||
                    primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE)
                {
                    classReservations[primaryBase + primaryClass] =
                        max(0u, quotas[volume] - lowerReservations);
                    classReservations[primaryBase + SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY] = dirtyReservation;
                    classReservations[primaryBase + SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY] = retryReservation;
                    if (maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
                        classReservations[primaryBase + maintenanceClass] = maintenanceReservation;
                }
                else if (primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_DIRTY)
                {
                    classReservations[primaryBase + primaryClass] =
                        max(0u, quotas[volume] - maintenanceReservation - retryReservation);
                    classReservations[primaryBase + SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY] = retryReservation;
                    if (maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
                        classReservations[primaryBase + maintenanceClass] = maintenanceReservation;
                }
                else if (primaryClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_RETRY)
                {
                    classReservations[primaryBase + primaryClass] =
                        max(0u, quotas[volume] - maintenanceReservation);
                    if (maintenanceClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES)
                        classReservations[primaryBase + maintenanceClass] = maintenanceReservation;
                }
                else
                {
                    classReservations[primaryBase + primaryClass] = min(maintenance, quotas[volume]);
                }
            }
            if (SchedulerVolumeHasMandatoryScrollRepair(volume))
            {
                uint mandatoryRepair = min(
                    SchedulerVolumeScrollExpectedRepairCount(volume),
                    quotas[volume]);
                uint freshIndex = volume *
                    SIMPLE_DDGI_SCHEDULER_WORK_CLASSES +
                    SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE;
                classReservations[freshIndex] = max(
                    classReservations[freshIndex],
                    mandatoryRepair);
            }
        }
    }

    uint accepted = 0u;
    uint primaryUsed = 0u;
    uint sourceUsed = 0u;
    uint transportUsed = 0u;
    uint sourceProbeUsed = 0u;
    uint hardSourceProbeUsed = 0u;
    uint routineSourceProbeUsed = 0u;
    uint cachedSolverProbeUsed = 0u;
    // Tail mode gives phase zero to the incomplete source cohort. It may use
    // the volume quota directly because a complete current cache is a
    // certificate prerequisite. Hard repair uses the global request and
    // primary-ray limits instead of the periodic source cadence; otherwise a
    // cohort paced across the entire refresh interval leaves no solve/audit
    // opportunity before its oldest entry expires. Phases 1..4 then retain
    // visible-class priority. Non-tail mode preserves the legacy 0..3 class
    // ordering and phase-four hard-source fallback used by the CPU oracle.
    uint firstPhase = tailSourceOnly ? 0u : (tailSolveOnly ? 6u : 0u);
    uint lastPhase = tailSourceOnly ? 0u : (tailSolveOnly ? 6u : 10u);
    uint ordinaryPhaseCount = lastPhase - firstPhase + 1u;
    // Phase 11 is deliberately executed first. A committed scroll cohort has
    // reserved its complete request/ray cost; admitting any unrelated primary
    // work before it would silently spend that reservation and recreate the
    // moving-camera refresh artifact this transaction exists to prevent.
    for (uint phaseOrdinal = 0u;
         phaseOrdinal <= ordinaryPhaseCount;
         phaseOrdinal++)
    {
        uint phase = phaseOrdinal == 0u
            ? 11u
            : firstPhase + phaseOrdinal - 1u;
        for (uint activeIndex = 0u;
             activeIndex < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             activeIndex++)
        {
            uint lane = SchedulerArenaRead(
                pc.LaneTotalsOffsetWords + activeIndex);
            if (lane == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                break;
            uint volumeIndex;
            uint workClass;
            uint transport;
            uint rayTier;
            SchedulerDecodeLane(
                lane,
                volumeIndex,
                workClass,
                transport,
                rayTier);
            // A scrolling volume is frozen to its exact exposed cohort for
            // this transaction. Admitting overlap maintenance after the
            // reservation succeeds would make preserved atlas/state payloads
            // change during an otherwise ordinary toroidal remap.
            if (phase != 11u &&
                SchedulerVolumeHasMandatoryScrollRepair(volumeIndex))
            {
                continue;
            }
            bool tailSourceCohortPhase =
                SchedulerTailCertification() && phase == 0u;
            bool phaseMatches = false;
            if (phase == 11u)
            {
                phaseMatches =
                    SchedulerVolumeHasMandatoryScrollRepair(volumeIndex) &&
                    workClass ==
                        SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE &&
                    transport ==
                        SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
            }
            else if (phase == 10u)
                phaseMatches = true;
            else if (SchedulerTailCertification() && phase <= 4u)
            {
                phaseMatches = phase == 0u
                    ? transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
                        transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE
                    : workClass == phase - 1u &&
                        transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
            }
            else if (!SchedulerTailCertification() && phase <= 3u)
                phaseMatches = workClass == phase &&
                    transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
            else if (!SchedulerTailCertification() && phase == 4u)
                phaseMatches = transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE;
            else if (phase == 5u)
                phaseMatches = transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
            else if (phase == 6u)
                phaseMatches = transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER;
            else if (phase >= 7u && phase <= 9u)
                phaseMatches = workClass ==
                    SIMPLE_DDGI_SCHEDULER_WORK_NEAR_MAINTENANCE + phase - 7u;
            if (!phaseMatches)
                continue;
                        uint mandatoryRepairCount =
                            SchedulerVolumeHasMandatoryScrollRepair(volumeIndex)
                                ? min(
                                    SchedulerVolumeScrollExpectedRepairCount(volumeIndex),
                                    quotas[volumeIndex])
                                : 0u;
                        bool mandatoryScrollPending =
                            volumeIndex < activeVolumes &&
                            volumeUsage[volumeIndex] < mandatoryRepairCount;
                        if (mandatoryScrollPending &&
                            (workClass !=
                                SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE ||
                             transport !=
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE))
                        {
                            continue;
                        }
                        // Quotas and class reservations are lane-invariant.
                        // Test them before walking compacted candidates and
                        // stop as soon as this lane has exhausted its only
                        // admission authority. The old loop continued reading
                        // every remaining candidate even after no later item
                        // could be accepted; during a source cohort this turned
                        // one admitted probe into a full-field serial scan.
                        if (accepted >= requestBudget ||
                            volumeIndex >= activeVolumes ||
                            volumeUsage[volumeIndex] >= quotas[volumeIndex])
                        {
                            continue;
                        }
                        uint classBase =
                            volumeIndex * SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
                        uint classLimit = specializedTailPhase || phase == 10u || tailSourceCohortPhase
                            ? quotas[volumeIndex]
                            : classReservations[classBase + workClass];
                        if (mandatoryScrollPending)
                            classLimit = quotas[volumeIndex];
                        if (!specializedTailPhase &&
                            classUsage[classBase + workClass] >= classLimit)
                            continue;

                        // Ray cardinality and the source-cadence allowance are
                        // lane-invariant. Rejecting them inside the candidate
                        // loop made a frame with one affordable source update
                        // serially reread thousands of otherwise identical
                        // records after the budget was already exhausted.
                        bool laneSourceWork =
                            transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
                            transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
                        bool laneRoutineSourceWork =
                            transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
                        bool laneSpatialRecoveryClass =
                            transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE &&
                            (workClass == SIMPLE_DDGI_SCHEDULER_WORK_FRESH_EXPOSED_VISIBLE ||
                                workClass == SIMPLE_DDGI_SCHEDULER_WORK_VISIBLE_ZERO_SUPPORT);
                        bool laneCadenceLimitedSourceWork =
                            laneRoutineSourceWork ||
                            (transport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE &&
                                !laneSpatialRecoveryClass);
                        bool laneCanContainZeroPrimaryRelight =
                            SchedulerSourceModeUsesRadiometricRelight(
                                SchedulerSourceRefreshMode());
                        uint laneRequiredSourceRayCount = clamp(
                            SchedulerVolumeMaintenanceRays(volumeIndex),
                            1u,
                            SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
                        if (mandatoryScrollPending)
                        {
                            laneRequiredSourceRayCount = clamp(
                                SchedulerVolumeScrollBootstrapRays(volumeIndex),
                                1u,
                                SchedulerVolumeFullRays(volumeIndex));
                        }
                        if (laneSourceWork && !laneCanContainZeroPrimaryRelight &&
                            (primaryBudget == 0u ||
                                laneRequiredSourceRayCount >
                                    primaryBudget - min(primaryUsed, primaryBudget)))
                        {
                            continue;
                        }
                        uint laneSourceVolumeBudget = sourceVolumeBudgets[volumeIndex];
                        // The authored source cadence is a maintenance and
                        // radiometric-transition target, not a spatial recovery
                        // throttle. Lanes that can contain fresh/scroll-exposed
                        // probes defer the exact decision to the candidate reason
                        // flags below; every other source lane is paced here.
                        if (laneCadenceLimitedSourceWork && !tailSourceCohortPhase &&
                            sourceBudgetLimited &&
                            laneRequiredSourceRayCount >
                                laneSourceVolumeBudget - min(
                                    sourceVolumeUsage[volumeIndex],
                                    laneSourceVolumeBudget))
                        {
                            continue;
                        }
                        uint laneCount = SchedulerArenaRead(pc.LaneCandidateCountsOffsetWords + lane);
                        if (laneCount == 0u)
                            continue;

                        // LaneCursors is the persistent rotating start. The
                        // compacted LanePrefixes base is never stored in it,
                        // and admission does not advance it speculatively.
                        uint laneStart = SchedulerArenaRead(
                            pc.LaneCursorsOffsetWords + lane) % laneCount;
                        uint laneBase = SchedulerArenaRead(pc.LanePrefixesOffsetWords + lane);
                        uint acceptedBeforeLane = accepted;
                        for (uint local = 0u; local < laneCount; local++)
                        {
                            uint candidateIndex = laneBase + ((laneStart + local) % laneCount);
                            if (candidateIndex >= SchedulerCandidateCapacity())
                                continue;
                            uint compactBase = pc.CandidateOutputOffsetWords +
                                candidateIndex * SIMPLE_DDGI_SCHEDULER_COMPACT_OUTPUT_WORDS;
                            uint inputIndex = SchedulerArenaRead(compactBase);
                            if (inputIndex >= SchedulerCandidateCapacity())
                            {
                                SchedulerArenaAtomicAdd(
                                    pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW,
                                    1u);
                                continue;
                            }
                            uint candidateBase = pc.CandidateInputOffsetWords +
                                inputIndex * SIMPLE_DDGI_SCHEDULER_CANDIDATE_WORDS;
                            uint probeIndex;
                            uint candidateVolumeIndex;
                            uint workClassAndTransport;
                            uint rayTierAndReason;
                            SchedulerReadCandidate(candidateBase, probeIndex, candidateVolumeIndex,
                                workClassAndTransport, rayTierAndReason);
                            if (probeIndex == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                                continue;

                            uint consumed = SchedulerCandidateWord(candidateBase, 0u);
                            if (consumed == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                                continue;
                            uint candidateWorkClass = workClassAndTransport & 7u;
                            uint candidateTransport = (workClassAndTransport >> 3u) & 3u;
                            uint candidateRayTier = rayTierAndReason & 0xffu;
                            uint candidateReasons = rayTierAndReason >> 8u;
                            if (candidateWorkClass != workClass ||
                                candidateTransport != transport ||
                                candidateRayTier != rayTier ||
                                candidateVolumeIndex != volumeIndex)
                                continue;
                            if (mandatoryScrollPending &&
                                (!SchedulerProbeIsCurrentScrollExposed(
                                    probeIndex,
                                    volumeIndex) ||
                                 (candidateReasons &
                                    SIMPLE_DDGI_SCHEDULER_REASON_SCROLL) == 0u))
                            {
                                continue;
                            }
                            uint sequenceOrdinal = inputIndex;
                            uint expectedGeneration =
                                (ReadStorageWordUniform(
                                    pc.ProbeStateBufferIndex,
                                    probeIndex * SIMPLE_DDGI_PROBE_STATE_WORDS + 4u) &
                                    SIMPLE_DDGI_PROBE_FLAG_GENERATION_MASK) >>
                                    SIMPLE_DDGI_PROBE_FLAG_GENERATION_SHIFT;
                            if (expectedGeneration == 0u)
                            {
                                SchedulerWriteInvalidCandidate(candidateBase);
                                SchedulerArenaAtomicAdd(
                                    pc.CountersOffsetWords +
                                        SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION,
                                    1u);
                                continue;
                            }
                            uint tailSourceReasonMask =
                                SIMPLE_DDGI_SCHEDULER_REASON_FRESH |
                                SIMPLE_DDGI_SCHEDULER_REASON_SCROLL |
                                SIMPLE_DDGI_SCHEDULER_REASON_REGIONAL_DIRTY |
                                SIMPLE_DDGI_SCHEDULER_REASON_GLOBAL_DIRTY |
                                SIMPLE_DDGI_SCHEDULER_REASON_SOURCE_INVALID |
                                SIMPLE_DDGI_SCHEDULER_REASON_RELOCATION_RETRY |
                                SIMPLE_DDGI_SCHEDULER_REASON_ROUTINE_DUE |
                                SIMPLE_DDGI_SCHEDULER_REASON_VISIBLE_PAGE_COHORT;
                            if (tailSourceCohortPhase &&
                                (candidateReasons & tailSourceReasonMask) == 0u)
                                continue;
                            bool visiblePageCandidate =
                                (candidateReasons &
                                    SIMPLE_DDGI_SCHEDULER_REASON_VISIBLE_PAGE_COHORT) != 0u;
                            bool visiblePageReservationPending =
                                tailSourceCohortPhase &&
                                visiblePageUsage[volumeIndex] <
                                    visiblePageQuotas[volumeIndex];
                            if (visiblePageReservationPending &&
                                !visiblePageCandidate)
                            {
                                continue;
                            }
                            if (accepted >= requestBudget || volumeIndex >= activeVolumes ||
                                volumeUsage[volumeIndex] >= quotas[volumeIndex])
                                continue;

                            if (!specializedTailPhase &&
                                classUsage[classBase + workClass] >= classLimit)
                                continue;

                            bool sourceWork = candidateTransport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE ||
                                candidateTransport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
                            bool routineSourceWork = candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE;
                            bool spatialSourceRecovery =
                                candidateTransport == SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE &&
                                (candidateReasons & (
                                    SIMPLE_DDGI_SCHEDULER_REASON_FRESH |
                                    SIMPLE_DDGI_SCHEDULER_REASON_SCROLL)) != 0u;
                            bool cadenceLimitedSourceWork = routineSourceWork ||
                                (candidateTransport ==
                                    SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE &&
                                    !spatialSourceRecovery);
                            bool sourceUsesPrimaryRays = sourceWork &&
                                !SchedulerCandidateUsesRadiometricRelight(
                                    candidateReasons);
                            uint requiredSourceRayCount = clamp(
                                SchedulerVolumeFullRays(volumeIndex),
                                1u,
                                SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
                            uint activeRayCount = candidateRayTier ==
                                    SIMPLE_DDGI_SCHEDULER_RAY_FULL
                                ? requiredSourceRayCount
                                : clamp(
                                    SchedulerVolumeMaintenanceRays(volumeIndex),
                                    1u,
                                    SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
                            // A V2 cached update must evaluate the same complete
                            // directional sequence that the certificate audits.
                            // SourceRayCount describes the immutable cache
                            // cardinality and activeRayCount describes cached
                            // transport work. Cached work never consumes the
                            // primary/source-ray budgets below.
                            uint sourceRayCount = SchedulerTransportV2()
                                ? SchedulerResolveAdaptiveSourceRayCount(
                                    probeIndex,
                                    volumeIndex,
                                    candidateReasons,
                                    sourceWork)
                                : (sourceWork ? requiredSourceRayCount : 0u);
                            sourceRayCount =
                                SchedulerResolveScrollBootstrapSourceRayCount(
                                    probeIndex,
                                    volumeIndex,
                                    candidateReasons,
                                    sourceWork,
                                    sourceRayCount);
                            // V2 evaluates the complete committed source
                            // prefix. Source refresh may atomically replace it
                            // with a promoted/demoted prefix; cached work keeps
                            // the frozen count and consumes no primary rays.
                            if (SchedulerTransportV2() || sourceWork)
                                activeRayCount = sourceRayCount;
                            if (sourceUsesPrimaryRays && (primaryBudget == 0u ||
                                activeRayCount > primaryBudget - min(primaryUsed, primaryBudget)))
                            {
                                // Source ray cost is invariant within this lane.
                                // Once the remaining frame budget cannot fund one
                                // candidate, no later candidate in the lane can be
                                // accepted. Leave them intact for the next frame
                                // instead of serially rejecting the entire cohort.
                                break;
                            }
                            uint volumeSourceBudget = sourceVolumeBudgets[volumeIndex];
                            if (cadenceLimitedSourceWork && !tailSourceCohortPhase &&
                                sourceBudgetLimited &&
                                (sourceRayCount > volumeSourceBudget - min(
                                    sourceVolumeUsage[volumeIndex],
                                    volumeSourceBudget)))
                            {
                                // The per-volume source allowance and source ray
                                // cardinality are also lane-invariant. Preserve
                                // deferred candidates for the next transaction.
                                break;
                            }

                            SchedulerWriteUpdateSelection(
                                accepted,
                                probeIndex,
                                volumeIndex,
                                workClassAndTransport,
                                rayTierAndReason,
                                expectedGeneration);
                            SchedulerArenaWrite(candidateBase, SIMPLE_DDGI_SCHEDULER_INVALID_PROBE);
                            accepted++;
                            volumeUsage[volumeIndex]++;
                            if (visiblePageCandidate)
                                visiblePageUsage[volumeIndex]++;
                            if (!specializedTailPhase)
                                classUsage[classBase + workClass]++;
                            acceptedByClass[candidateWorkClass]++;
                            transportUsed += activeRayCount;
                            if (sourceWork)
                            {
                                if (sourceUsesPrimaryRays)
                                    primaryUsed += activeRayCount;
                                sourceUsed += sourceRayCount;
                                sourceVolumeUsage[volumeIndex] += sourceRayCount;
                                sourceProbeUsed++;
                            }
                            if (candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_HARD_SOURCE)
                            {
                                hardSourceProbeUsed++;
                            }
                            else if (candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_ROUTINE_SOURCE)
                            {
                                routineSourceProbeUsed++;
                            }
                            else if (candidateTransport ==
                                SIMPLE_DDGI_SCHEDULER_TRANSPORT_CACHED_SOLVER)
                            {
                                cachedSolverProbeUsed++;
                            }
                            if (accepted >= requestBudget ||
                                volumeUsage[volumeIndex] >= quotas[volumeIndex] ||
                                (!specializedTailPhase &&
                                    classUsage[classBase + workClass] >= classLimit))
                            {
                                break;
                            }
                        }
                        uint laneAccepted = accepted - acceptedBeforeLane;
                        if (laneAccepted != 0u)
                        {
                            SchedulerArenaWrite(
                                pc.LaneAdmissionOffsetWords + lane,
                                SchedulerArenaRead(
                                    pc.LaneAdmissionOffsetWords + lane) +
                                    laneAccepted);
                            admittedLaneMask[lane >> 5u] |=
                                1u << (lane & 31u);
                        }
        }
    }

    // Admission is a single deterministic invocation. Publish transaction
    // totals once after the selection walk instead of serializing ten SSBO
    // read/write chains for every accepted probe. Emit and feedback observe
    // the same values after the stage barrier.
    SchedulerArenaWrite(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ACCEPTED,
        accepted);
    SchedulerArenaWrite(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_PRIMARY_USED,
        primaryUsed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_USED,
        sourceUsed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_TRANSPORT_USED,
        transportUsed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_PROBE_USED,
        sourceProbeUsed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_HARD_SOURCE_PROBE_USED,
        hardSourceProbeUsed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_ROUTINE_SOURCE_PROBE_USED,
        routineSourceProbeUsed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_CACHED_SOLVER_PROBE_USED,
        cachedSolverProbeUsed);
    for (uint volume = 0u; volume < activeVolumes; volume++)
    {
        SchedulerArenaWrite(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_VOLUME_USAGE_BASE + volume,
            volumeUsage[volume]);
    }
    for (uint workClass = 0u;
         workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES;
         workClass++)
    {
        SchedulerArenaWrite(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_CLASS_USAGE_BASE + workClass,
            acceptedByClass[workClass]);
    }

    // Advance persistent cursors only by candidates that were actually
    // admitted. Empty lanes retain their previous cursor exactly.
    for (uint maskWord = 0u; maskWord < 28u; maskWord++)
    {
        uint lanes = admittedLaneMask[maskWord];
        while (lanes != 0u)
        {
            uint laneBit = uint(findLSB(lanes));
            uint lane = maskWord * 32u + laneBit;
            uint laneCount = SchedulerArenaRead(
                pc.LaneCandidateCountsOffsetWords + lane);
            uint laneAccepted = SchedulerArenaRead(
                pc.LaneAdmissionOffsetWords + lane);
            if (laneCount != 0u && laneAccepted != 0u)
            {
                uint oldCursor = SchedulerArenaRead(
                    pc.LaneCursorsOffsetWords + lane) % laneCount;
                SchedulerArenaWrite(
                    pc.LaneCursorsOffsetWords + lane,
                    (oldCursor + laneAccepted) % laneCount);
            }
            lanes &= lanes - 1u;
        }
    }

    SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_EMIT, 1u, 1u, 1u);
}
