#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_ray_query : require

#include "common.glsl"

layout(set = 2, binding = 0) uniform accelerationStructureEXT SceneTlas;

#include "directional_ray_visibility.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform DirectionalRayShadowPushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndReceiverDistance;
    vec4 RayDirectionAndMaximumDistance;
    uint ScreenWidth;
    uint ScreenHeight;
    uint OutputBufferIndex;
    uint InstanceMask;
    uint OutputMode;
    uint FrameIndex;
    uint TraceSampleCount;
    uint DebugFlags;
} pc;

const uint PIXELS_PER_WORD = 4u;
const uint COUNTER_COUNT = 16u;
const uint COUNTER_RAYS_ISSUED = 0u;
const uint COUNTER_RAYS_SKIPPED = 1u;
const uint COUNTER_HITS = 2u;
const uint COUNTER_MISSES = 3u;
const uint COUNTER_CANDIDATES = 4u;
const uint COUNTER_ALPHA_SAMPLES = 5u;
const uint COUNTER_CAP_HITS = 6u;
const uint COUNTER_INVALID_RECEIVERS = 7u;
const uint COUNTER_BOUNDS_REJECTIONS = 8u;

#if NJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS
shared uint WorkgroupCounters[COUNTER_COUNT];
#endif

void AddCounter(uint counter, uint value)
{
#if NJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS
    if ((pc.DebugFlags & 2u) != 0u &&
        counter < COUNTER_COUNT && value != 0u)
        atomicAdd(WorkgroupCounters[counter], value);
#endif
}

bool ReconstructReceiver(ivec2 pixel, out vec3 worldPosition, out float depth)
{
    worldPosition = vec3(0.0);
    depth = 0.0;
    if (any(lessThan(pixel, ivec2(0))) ||
        any(greaterThanEqual(pixel, ivec2(pc.ScreenWidth, pc.ScreenHeight))))
        return false;

    depth = texelFetch(
        BindlessTextures[nonuniformEXT(DEPTH_TEXTURE_INDEX)],
        pixel,
        0).r;
    if (!DirectionalRayFinite(depth) || depth <= 0.0 || depth > 1.0)
        return false;

    vec2 uv = (vec2(pixel) + vec2(0.5)) /
        max(vec2(pc.ScreenWidth, pc.ScreenHeight), vec2(1.0));
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    vec4 world = MulRowMajor(clip, pc.InverseViewProjectionMatrix);
    if (any(isnan(world)) || any(isinf(world)) || abs(world.w) <= 1.0e-7)
        return false;
    worldPosition = world.xyz / world.w;
    return DirectionalRayFinite(worldPosition);
}

vec3 SelectClosestDerivative(
    vec3 center,
    vec3 negativePosition,
    bool negativeValid,
    vec3 positivePosition,
    bool positiveValid)
{
    vec3 positiveDerivative = positivePosition - center;
    vec3 negativeDerivative = center - negativePosition;
    if (positiveValid && negativeValid)
    {
        return dot(positiveDerivative, positiveDerivative) <=
                dot(negativeDerivative, negativeDerivative)
            ? positiveDerivative
            : negativeDerivative;
    }
    if (positiveValid)
        return positiveDerivative;
    if (negativeValid)
        return negativeDerivative;
    return vec3(0.0);
}

bool ReconstructNormalAndFootprint(
    ivec2 pixel,
    vec3 center,
    out vec3 normal,
    out float footprint)
{
    vec3 leftPosition;
    vec3 rightPosition;
    vec3 upperPosition;
    vec3 lowerPosition;
    float ignoredDepth;
    bool leftValid = ReconstructReceiver(pixel + ivec2(-1, 0), leftPosition, ignoredDepth);
    bool rightValid = ReconstructReceiver(pixel + ivec2(1, 0), rightPosition, ignoredDepth);
    bool upperValid = ReconstructReceiver(pixel + ivec2(0, -1), upperPosition, ignoredDepth);
    bool lowerValid = ReconstructReceiver(pixel + ivec2(0, 1), lowerPosition, ignoredDepth);
    vec3 derivativeX = SelectClosestDerivative(
        center, leftPosition, leftValid, rightPosition, rightValid);
    vec3 derivativeY = SelectClosestDerivative(
        center, upperPosition, upperValid, lowerPosition, lowerValid);
    footprint = max(length(derivativeX), length(derivativeY));
    normal = cross(derivativeX, derivativeY);
    float normalLengthSquared = dot(normal, normal);
    if (!DirectionalRayFinite(normal) || normalLengthSquared <= 1.0e-12 ||
        !DirectionalRayFinite(footprint) || footprint <= 1.0e-7)
    {
        normal = vec3(0.0);
        footprint = 0.0;
        return false;
    }
    normal *= inversesqrt(normalLengthSquared);
    if (dot(normal, pc.CameraPositionAndReceiverDistance.xyz - center) < 0.0)
        normal = -normal;
    return true;
}

void WritePackedVisibility(uint pixelIndex, float visibility)
{
    uint wordIndex = pixelIndex / PIXELS_PER_WORD;
    uint byteShift = (pixelIndex % PIXELS_PER_WORD) * 8u;
    uint packed = uint(round(clamp(visibility, 0.0, 1.0) * 255.0)) << byteShift;
    if (packed != 0u)
    {
        atomicOr(
            BindlessStorageBuffers[nonuniformEXT(pc.OutputBufferIndex)].Words[wordIndex],
            packed);
    }
}

void WriteResult(
    uint pixelIndex,
    float visibility,
    float hitDistance,
    uint candidates,
    uint flags)
{
    if (pc.OutputMode == 3u)
    {
        WriteStorageWord(
            pc.OutputBufferIndex,
            pixelIndex,
            packHalf2x16(vec2(clamp(visibility, 0.0, 1.0),
                clamp(hitDistance, 0.0, 65504.0))));
    }
    else
    {
        WritePackedVisibility(pixelIndex, visibility);
    }

    if ((pc.DebugFlags & 1u) != 0u)
    {
        uint diagnosticIndex = uint(DIRECTIONAL_SHADOW_DIAGNOSTIC_BUFFER_BASE_INDEX) +
            min(pc.FrameIndex, uint(FRAMES_IN_FLIGHT - 1));
        uint normalizedHit = uint(round(clamp(
            hitDistance / max(pc.RayDirectionAndMaximumDistance.w, 0.0001),
            0.0,
            1.0) * 65535.0));
        WriteStorageWord(
            diagnosticIndex,
            pixelIndex,
            min(candidates, 255u) | (normalizedHit << 8u) | ((flags & 0xffu) << 24u));
    }
}

void main()
{
    uint localIndex = gl_LocalInvocationIndex;
#if NJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS
    if (localIndex < COUNTER_COUNT)
        WorkgroupCounters[localIndex] = 0u;
    barrier();
#endif

    uvec2 pixel = gl_GlobalInvocationID.xy;
    bool invocationInBounds = pixel.x < pc.ScreenWidth && pixel.y < pc.ScreenHeight;
    if (invocationInBounds)
    {
        uint pixelIndex = pixel.y * pc.ScreenWidth + pixel.x;
        vec3 worldPosition;
        float receiverDepth;
        vec3 centerDirection = pc.RayDirectionAndMaximumDistance.xyz;
        float directionLengthSquared = dot(centerDirection, centerDirection);
        float configuredMaximum = pc.RayDirectionAndMaximumDistance.w;
        bool receiverValid = ReconstructReceiver(
            ivec2(pixel),
            worldPosition,
            receiverDepth);
        if (!receiverValid || !DirectionalRayFinite(centerDirection) ||
            directionLengthSquared <= 1.0e-8 ||
            !DirectionalRayFinite(configuredMaximum) ||
            configuredMaximum <= 0.0)
        {
            AddCounter(receiverDepth <= 0.0
                ? COUNTER_RAYS_SKIPPED
                : COUNTER_INVALID_RECEIVERS, 1u);
            WriteResult(pixelIndex, 1.0, max(configuredMaximum, 0.0), 0u, 1u);
        }
        else
        {
            centerDirection *= inversesqrt(directionLengthSquared);
            float receiverDistance = length(
                worldPosition - pc.CameraPositionAndReceiverDistance.xyz);
            vec3 geometricNormal;
            float primaryFootprint;
            bool normalValid = ReconstructNormalAndFootprint(
                ivec2(pixel),
                worldPosition,
                geometricNormal,
                primaryFootprint);
            if (!DirectionalRayFinite(receiverDistance) ||
                receiverDistance > pc.CameraPositionAndReceiverDistance.w)
            {
                AddCounter(COUNTER_RAYS_SKIPPED, 1u);
                WriteResult(pixelIndex, 1.0, configuredMaximum, 0u, 2u);
            }
            else if (normalValid && dot(geometricNormal, centerDirection) < -0.25)
            {
                AddCounter(COUNTER_RAYS_SKIPPED, 1u);
                WriteResult(pixelIndex, 1.0, configuredMaximum, 0u, 4u);
            }
            else
            {
                if (!normalValid)
                {
                    geometricNormal = centerDirection;
                    primaryFootprint = max(receiverDistance /
                        float(max(max(pc.ScreenWidth, pc.ScreenHeight), 1u)), 0.0001);
                }
                else if (dot(geometricNormal, centerDirection) < 0.0)
                {
                    geometricNormal = -geometricNormal;
                }

                float coordinateScale = max(
                    max(abs(worldPosition.x), max(abs(worldPosition.y), abs(worldPosition.z))),
                    1.0);
                float normalEpsilon = clamp(coordinateScale * 1.0e-7, 0.0005, 0.02);
                float rayEpsilon = clamp(max(0.0005, configuredMaximum * 1.0e-6),
                    0.0005, 0.01);
                vec3 origin = worldPosition + geometricNormal * normalEpsilon +
                    centerDirection * rayEpsilon;
                float boundedMaximum;
                if (!DirectionalIntersectQualifiedBounds(
                        origin,
                        centerDirection,
                        configuredMaximum,
                        boundedMaximum))
                {
                    AddCounter(COUNTER_BOUNDS_REJECTIONS, 1u);
                    WriteResult(pixelIndex, 1.0, configuredMaximum, 0u, 8u);
                }
                else
                {
                    uint sampleCount = pc.OutputMode == 3u
                        ? clamp(pc.TraceSampleCount, 1u, 4u)
                        : 1u;
                    float visibilitySum = 0.0;
                    float nearestHit = boundedMaximum;
                    uint totalCandidates = 0u;
                    uint totalAlphaSamples = 0u;
                    bool anyCapHit = false;
                    for (uint sampleIndex = 0u; sampleIndex < sampleCount; sampleIndex++)
                    {
                        vec3 sampleDirection = DirectionalSampleSunDirection(
                            centerDirection,
                            pixel,
                            pc.FrameIndex,
                            sampleIndex,
                            max(ReadDirectionalShadowModeAndRayDistance().w, 0.0),
                            pc.OutputMode == 3u);

                        float sampleMaximum;
                        if (!DirectionalIntersectQualifiedBounds(
                                origin,
                                sampleDirection,
                                configuredMaximum,
                                sampleMaximum))
                        {
                            visibilitySum += 1.0;
                            AddCounter(COUNTER_BOUNDS_REJECTIONS, 1u);
                            continue;
                        }
                        float hitDistance;
                        uint candidates;
                        uint alphaSamples;
                        bool capHit;
                        bool blocked = DirectionalTraceVisibility(
                            SceneTlas,
                            origin,
                            sampleDirection,
                            sampleMaximum,
                            primaryFootprint,
                            pc.InstanceMask,
                            hitDistance,
                            candidates,
                            alphaSamples,
                            capHit);
                        AddCounter(COUNTER_RAYS_ISSUED, 1u);
                        AddCounter(blocked ? COUNTER_HITS : COUNTER_MISSES, 1u);
                        totalCandidates += candidates;
                        totalAlphaSamples += alphaSamples;
                        anyCapHit = anyCapHit || capHit;
                        nearestHit = min(nearestHit, hitDistance);
                        float sampleVisibility = blocked ? 0.0 : 1.0;
                        if (blocked && pc.OutputMode == 1u)
                        {
                            sampleVisibility = smoothstep(
                                sampleMaximum * 0.8,
                                sampleMaximum,
                                clamp(hitDistance, 0.0, sampleMaximum));
                        }
                        visibilitySum += sampleVisibility;
                    }
                    AddCounter(COUNTER_CANDIDATES, totalCandidates);
                    AddCounter(COUNTER_ALPHA_SAMPLES, totalAlphaSamples);
                    AddCounter(COUNTER_CAP_HITS, anyCapHit ? 1u : 0u);
                    WriteResult(
                        pixelIndex,
                        visibilitySum / float(sampleCount),
                        nearestHit,
                        totalCandidates,
                        anyCapHit ? 16u : 0u);
                }
            }
        }
    }

#if NJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS
    barrier();
    if ((pc.DebugFlags & 2u) != 0u &&
        localIndex < COUNTER_COUNT && WorkgroupCounters[localIndex] != 0u)
    {
        uint counterBuffer = uint(DIRECTIONAL_SHADOW_COUNTER_BUFFER_BASE_INDEX) +
            min(pc.FrameIndex, uint(FRAMES_IN_FLIGHT - 1));
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(counterBuffer)].Words[localIndex],
            WorkgroupCounters[localIndex]);
    }
#endif
}
