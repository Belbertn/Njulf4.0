#version 460
#extension GL_GOOGLE_include_directive : require

#include "ddgi_near_field_residual.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D preparedDepthFootprint;
layout(set = 0, binding = 1) uniform usampler2D preparedReceiverPayload;
layout(set = 0, binding = 2) uniform sampler2D preparedMotion;
layout(std430, set = 0, binding = 3) readonly buffer SchedulerHistoryReadBuffer
{
    SimpleDdgiNearFieldResidualSchedulerRecord values[];
} schedulerHistoryRead;
layout(std430, set = 0, binding = 4) buffer SchedulerHistoryWriteBuffer
{
    SimpleDdgiNearFieldResidualSchedulerRecord values[];
} schedulerHistoryWrite;
layout(std430, set = 0, binding = 5) buffer ClassifyActiveTileBuffer
{
    uint words[];
} classifyActiveTiles;
layout(std430, set = 0, binding = 6) buffer ClassifyTileRecordsBuffer
{
    uint words[];
} classifyTileRecords;

layout(push_constant) uniform NearFieldClassifyPushBlock
{
    SimpleDdgiNearFieldResidualClassifyPushConstants pc;
};

shared uint c5ReceiverCount;
shared uint c5MaximumMotionBits;
shared uint c5ReceiverSignature;

uint C5SchedulerHash(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

bool C5SchedulerValidReceiver(ivec2 pixel, out uint signature,
    out float motionMagnitude)
{
    signature = 0u;
    motionMagnitude = 0.0;
    vec2 depthFootprint = texelFetch(preparedDepthFootprint, pixel, 0).rg;
    uvec4 payload = texelFetch(preparedReceiverPayload, pixel, 0);
    vec2 motion = texelFetch(preparedMotion, pixel, 0).xy;
    vec4 packedNormals;
    uint surfaceToken;
    vec3 diffuseBase;
    vec3 dielectricF0;
    SimpleDdgiNearFieldDecodeReceiverPayload(payload, packedNormals,
        surfaceToken, diffuseBase, dielectricF0);
    vec3 geometric = SimpleDdgiNearFieldDecodeOctNormal(packedNormals.xy);
    vec3 shading = SimpleDdgiNearFieldDecodeOctNormal(packedNormals.zw);
    bool finiteMotion = SimpleDdgiNearFieldFinite(motion.x) &&
        SimpleDdgiNearFieldFinite(motion.y);
    motionMagnitude = finiteMotion ? length(motion) : 3.402823466e+38;
    signature = C5SchedulerHash(payload.x ^ C5SchedulerHash(payload.y) ^
        C5SchedulerHash(payload.z) ^ C5SchedulerHash(payload.w));
    return SimpleDdgiNearFieldFinite(depthFootprint.x) &&
        SimpleDdgiNearFieldFinite(depthFootprint.y) &&
        depthFootprint.x > 0.0 && depthFootprint.y > 0.0 &&
        surfaceToken < SIMPLE_DDGI_NEAR_FIELD_MAX_SURFACE_TABLE_ENTRIES &&
        dot(geometric, geometric) > 0.0 && dot(shading, shading) > 0.0 &&
        finiteMotion;
}

void C5WriteIndirect(uint stage, uint groupCount)
{
    uint base = 8u + stage * 3u;
    atomicMax(classifyActiveTiles.words[base], groupCount);
    classifyActiveTiles.words[base + 1u] = 1u;
    classifyActiveTiles.words[base + 2u] = 1u;
}

void C5InitializeHistoryOnlyTraceRecord(uint tileIndex)
{
    uint recordBase = SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_HEADER_WORDS +
        tileIndex * SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS;
    if (recordBase > uint(classifyTileRecords.words.length()) ||
        SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS >
            uint(classifyTileRecords.words.length()) - recordBase)
    {
        if (uint(classifyTileRecords.words.length()) > 15u)
            atomicOr(classifyTileRecords.words[15u], 1u);
        return;
    }
    for (uint word = 0u;
         word < SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TILE_WORDS;
         ++word)
    {
        classifyTileRecords.words[recordBase + word] = 0u;
    }
    classifyTileRecords.words[recordBase] = tileIndex;
    classifyTileRecords.words[recordBase + 15u] =
        SIMPLE_DDGI_NEAR_FIELD_TELEMETRY_TRACE_COMPLETE << 16u;
}

void main()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        c5ReceiverCount = 0u;
        c5MaximumMotionBits = 0u;
        c5ReceiverSignature = 0u;
    }
    barrier();

    uint tileCountX = (pc.traceWidth + 7u) / 8u;
    uint tileCountY = (pc.traceHeight + 7u) / 8u;
    bool tileInRange = gl_WorkGroupID.x < tileCountX &&
        gl_WorkGroupID.y < tileCountY;
    uint tileIndex = tileInRange
        ? gl_WorkGroupID.y * tileCountX + gl_WorkGroupID.x
        : 0u;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool pixelInRange = tileInRange && pixel.x < int(pc.traceWidth) &&
        pixel.y < int(pc.traceHeight);
    if (pixelInRange)
    {
        uint signature;
        float motionMagnitude;
        if (C5SchedulerValidReceiver(pixel, signature, motionMagnitude))
        {
            atomicAdd(c5ReceiverCount, 1u);
            atomicMax(c5MaximumMotionBits, floatBitsToUint(
                max(motionMagnitude, 0.0)));
            atomicAdd(c5ReceiverSignature, signature);
        }
    }
    barrier();

    if (gl_LocalInvocationIndex != 0u || !tileInRange)
        return;
    bool contractValid = pc.abiVersion ==
            SIMPLE_DDGI_NEAR_FIELD_RESIDUAL_ABI_VERSION &&
        SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_LOCAL_ADAPTIVE_SCHEDULING) &&
        pc.tileCapacity == tileCountX * tileCountY &&
        pc.fullWidth > 0u && pc.fullHeight > 0u &&
        tileIndex < pc.tileCapacity &&
        tileIndex < uint(schedulerHistoryRead.values.length()) &&
        tileIndex < uint(schedulerHistoryWrite.values.length()) &&
        pc.maximumRaysPerPixel >= 1u && pc.maximumRaysPerPixel <= 4u &&
        pc.normalRaysPerPixel >= 1u &&
        pc.normalRaysPerPixel <= pc.maximumRaysPerPixel &&
        pc.maximumHistoryOnlyAge > 0u && pc.forcedRefreshPeriod > 0u &&
        SimpleDdgiNearFieldFinite(pc.highMotion) && pc.highMotion >= 0.0 &&
        SimpleDdgiNearFieldFinite(pc.highVariance) && pc.highVariance >= 0.0 &&
        SimpleDdgiNearFieldFinite(pc.activeEnergy) && pc.activeEnergy >= 0.0 &&
        SimpleDdgiNearFieldFinite(pc.perceptualEnergyFloor) &&
        pc.perceptualEnergyFloor >= 0.0 &&
        pc.perceptualEnergyFloor <= pc.activeEnergy &&
        SimpleDdgiNearFieldFinite(pc.lowConfidence) &&
        pc.lowConfidence >= 0.0 && pc.lowConfidence <= 1.0;
    if (!contractValid)
    {
        atomicAdd(classifyActiveTiles.words[4u], 1u);
        return;
    }

    SimpleDdgiNearFieldResidualSchedulerRecord previous =
        schedulerHistoryRead.values[tileIndex];
    uint previousClass = SimpleDdgiNearFieldSchedulerClass(
        previous.packedState);
    uint previousAge = SimpleDdgiNearFieldSchedulerAge(previous.packedState);
    float previousConfidence = SimpleDdgiNearFieldSchedulerConfidence(
        previous.packedState);
    uint currentReceiverFingerprint = c5ReceiverSignature & 0xffffu;
    uint currentEpochFingerprint = pc.schedulerEpoch & 0xffffu;
    uint packedIdentity = currentEpochFingerprint |
        (currentReceiverFingerprint << 16u);
    bool occupied = c5ReceiverCount > 0u;
    bool previousFinite = SimpleDdgiNearFieldFinite(
            previous.signedResidualEnergy) &&
        SimpleDdgiNearFieldFinite(previous.variance) &&
        previous.variance >= 0.0;
    bool previousValid = (previous.packedState &
            SIMPLE_DDGI_NEAR_FIELD_SCHEDULER_VALID_BIT) != 0u &&
        previousClass <= SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY &&
        previous.packedEpochAndReceiver == packedIdentity && previousFinite;
    bool historyValid = SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_HISTORY_INPUT_VALID) &&
        previousValid;
    float maximumMotion = uintBitsToFloat(c5MaximumMotionBits);
    bool changed = !historyValid ||
        SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_CAMERA_CUT) ||
        SimpleDdgiNearFieldHasFlag(pc.flags,
            SIMPLE_DDGI_NEAR_FIELD_FLAG_SOURCE_LIGHTING_EPOCH_CHANGED) ||
        !SimpleDdgiNearFieldFinite(maximumMotion) ||
        maximumMotion > pc.highMotion;

    uint phaseHash = C5SchedulerHash(tileIndex ^ pc.frameSerialLow ^
        C5SchedulerHash(pc.frameSerialHigh));
    uint phase = phaseHash & 1u;
    uint tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_INACTIVE;
    uint rays = 0u;
    bool forcedRefresh = false;
    if (occupied)
    {
        uint cadenceHash = C5SchedulerHash(tileIndex) + pc.frameSerialLow;
        forcedRefresh = historyValid &&
            (previousAge >= pc.maximumHistoryOnlyAge ||
             cadenceHash % pc.forcedRefreshPeriod == 0u);
        float absoluteEnergy = abs(previous.signedResidualEnergy);
        if (changed)
        {
            tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_HIGH;
            rays = pc.maximumRaysPerPixel;
        }
        else if (forcedRefresh)
        {
            tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_NORMAL;
            rays = pc.normalRaysPerPixel;
        }
        else if (previous.variance >= pc.highVariance ||
            previousConfidence < pc.lowConfidence)
        {
            tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_HIGH;
            rays = pc.maximumRaysPerPixel;
        }
        else if (absoluteEnergy >= pc.activeEnergy)
        {
            tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_NORMAL;
            rays = pc.normalRaysPerPixel;
        }
        else if (absoluteEnergy >= pc.perceptualEnergyFloor ||
            sqrt(max(previous.variance, 0.0)) >= pc.perceptualEnergyFloor)
        {
            tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_INTERLEAVED;
            rays = 1u;
        }
        else
        {
            tileClass = SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY;
        }
    }

    uint nextAge = tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY
        ? min(previousAge + 1u, 255u)
        : tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_INTERLEAVED
            ? min(previousAge + 1u, 255u)
            : 0u;
    schedulerHistoryWrite.values[tileIndex].packedState =
        SimpleDdgiNearFieldPackSchedulerState(tileClass, phase, rays,
            historyValid, nextAge, previousConfidence);
    schedulerHistoryWrite.values[tileIndex].signedResidualEnergy =
        historyValid ? previous.signedResidualEnergy : 0.0;
    schedulerHistoryWrite.values[tileIndex].variance =
        historyValid ? previous.variance : 0.0;
    schedulerHistoryWrite.values[tileIndex].packedEpochAndReceiver =
        packedIdentity;

    if (!occupied)
    {
        atomicAdd(classifyActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_INACTIVE_COUNT_WORD], 1u);
        return;
    }

    uint resolveIndex = atomicAdd(classifyActiveTiles.words[1u], 1u);
    uint resolveWord = SimpleDdgiNearFieldResolveListFirstWord(
        pc.tileCapacity) + resolveIndex;
    if (resolveIndex >= pc.tileCapacity ||
        resolveWord >= uint(classifyActiveTiles.words.length()))
    {
        atomicAdd(classifyActiveTiles.words[4u], 1u);
        atomicAdd(classifyTileRecords.words[20u], 1u);
        atomicOr(classifyTileRecords.words[15u], 1u);
        return;
    }
    classifyActiveTiles.words[resolveWord] = tileIndex;
    atomicAdd(classifyTileRecords.words[17u], 1u);
    atomicAdd(classifyTileRecords.words[18u], 1u);

    uint tracePixels = 0u;
    uint traceRays = 0u;
    if (tileClass != SIMPLE_DDGI_NEAR_FIELD_TILE_HISTORY_ONLY)
    {
        uint traceIndex = atomicAdd(classifyActiveTiles.words[2u], 1u);
        uint traceWord = SimpleDdgiNearFieldTraceListFirstWord() + traceIndex;
        if (traceIndex >= pc.tileCapacity ||
            traceWord >= uint(classifyActiveTiles.words.length()))
        {
            atomicAdd(classifyActiveTiles.words[4u], 1u);
            atomicAdd(classifyTileRecords.words[20u], 1u);
            atomicOr(classifyTileRecords.words[15u], 1u);
            return;
        }
        classifyActiveTiles.words[traceWord] = tileIndex;
        uint tileWidth = min(8u, pc.traceWidth - gl_WorkGroupID.x * 8u);
        uint tileHeight = min(8u, pc.traceHeight - gl_WorkGroupID.y * 8u);
        uint tilePixels = tileWidth * tileHeight;
        tracePixels = tileClass ==
            SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_INTERLEAVED
            ? (tilePixels + 1u) / 2u
            : tilePixels;
        traceRays = tracePixels * rays;
        C5WriteIndirect(0u, traceIndex + 1u);
    }
    else
    {
        C5InitializeHistoryOnlyTraceRecord(tileIndex);
    }

    if (tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_HIGH)
        atomicAdd(classifyActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_TRACE_HIGH_COUNT_WORD], 1u);
    else if (tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_NORMAL)
        atomicAdd(classifyActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_TRACE_NORMAL_COUNT_WORD], 1u);
    else if (tileClass == SIMPLE_DDGI_NEAR_FIELD_TILE_TRACE_INTERLEAVED)
        atomicAdd(classifyActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_INTERLEAVED_COUNT_WORD], 1u);
    else
        atomicAdd(classifyActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_HISTORY_ONLY_COUNT_WORD], 1u);
    if (forcedRefresh)
        atomicAdd(classifyActiveTiles.words[
            SIMPLE_DDGI_NEAR_FIELD_FORCED_REFRESH_COUNT_WORD], 1u);
    atomicAdd(classifyActiveTiles.words[
        SIMPLE_DDGI_NEAR_FIELD_REQUESTED_PIXEL_COUNT_WORD], tracePixels);
    atomicAdd(classifyActiveTiles.words[
        SIMPLE_DDGI_NEAR_FIELD_REQUESTED_RAY_COUNT_WORD], traceRays);
    uint fullPixels = min(8u, pc.traceWidth - gl_WorkGroupID.x * 8u) *
        min(8u, pc.traceHeight - gl_WorkGroupID.y * 8u);
    atomicAdd(classifyActiveTiles.words[
        SIMPLE_DDGI_NEAR_FIELD_SAVED_PIXEL_COUNT_WORD],
        fullPixels - min(fullPixels, tracePixels));
    atomicAdd(classifyActiveTiles.words[
        SIMPLE_DDGI_NEAR_FIELD_SAVED_RAY_COUNT_WORD],
        fullPixels * pc.maximumRaysPerPixel -
            min(fullPixels * pc.maximumRaysPerPixel, traceRays));
    atomicMax(classifyActiveTiles.words[
        SIMPLE_DDGI_NEAR_FIELD_MAXIMUM_AGE_WORD], nextAge);

    // Resolve, filter, frequency and composite all consume the resolve list.
    for (uint stage = 1u; stage < 8u; ++stage)
    {
        uint multiplier = 1u;
        if (stage == 7u)
        {
            uint maximumFullTileWidth =
                (8u * pc.fullWidth + pc.traceWidth - 1u) / pc.traceWidth;
            uint maximumFullTileHeight =
                (8u * pc.fullHeight + pc.traceHeight - 1u) / pc.traceHeight;
            multiplier = max(1u,
                ((maximumFullTileWidth + 7u) / 8u) *
                ((maximumFullTileHeight + 7u) / 8u));
        }
        C5WriteIndirect(stage, (resolveIndex + 1u) * multiplier);
    }
}
