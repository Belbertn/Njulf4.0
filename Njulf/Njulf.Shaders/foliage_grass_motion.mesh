#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require

#include "common.glsl"

// The procedural motion path consumes the exact same compacted command as
// depth and forward. One workgroup expands one command and therefore emits the
// same deterministic roots, LOD, density subset, and width compensation.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 32) out;

layout(location = 0) noperspective out vec2 meshCurrentUv[];
layout(location = 1) noperspective out vec2 meshPreviousUv[];
layout(location = 2) out vec2 meshTexCoord[];
layout(location = 3) flat out uint meshMaterialIndex[];
layout(location = 4) flat out uint meshReceiverSignature[];
layout(location = 5) flat out uint meshHistoryFrameAndFlags[];
layout(location = 6) flat out uint meshClusterIndex[];
layout(location = 7) flat out uint meshLodBand[];
layout(location = 8) flat out uint meshGeometryMode[];
layout(location = 9) flat out uint meshImpostorMetadataIndex[];
layout(location = 10) out vec3 meshCurrentWorldPosition[];
layout(location = 11) out vec2 meshViewDepths[];

layout(push_constant) uniform MotionVectorPushConstantBlock
{
    GPUMotionVectorPushConstants Push;
} pc;

uint HashUint(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float Hash01(uint value)
{
    return float(HashUint(value) & 0x00ffffffu) /
        float(0x01000000u);
}

vec3 SafeNormalize(vec3 value, vec3 fallback)
{
    float lengthSquared = dot(value, value);
    if (lengthSquared <= 0.000001)
        return fallback;
    return value * inversesqrt(lengthSquared);
}

vec2 ClipToUv(vec4 clip)
{
    vec2 ndc = clip.xy / max(abs(clip.w), 0.000001);
    return ndc * 0.5 + vec2(0.5);
}

void EmitMotionVertex(
    uint vertexIndex,
    vec3 currentPosition,
    vec3 previousPosition,
    vec2 uv,
    uint materialIndex,
    uint clusterIndex,
    uint lodBand,
    uint geometryMode,
    uint impostorMetadataIndex)
{
    vec4 currentClip = MulRowMajor(
        vec4(currentPosition, 1.0),
        pc.Push.ViewProjectionMatrix);
    vec4 previousClip = MulRowMajor(
        vec4(previousPosition, 1.0),
        pc.Push.PreviousViewProjectionMatrix);
    gl_MeshVerticesEXT[vertexIndex].gl_Position = currentClip;
    meshCurrentUv[vertexIndex] = ClipToUv(currentClip);
    meshPreviousUv[vertexIndex] =
        (pc.Push.PreviousFrameValid & 1u) != 0u
            ? ClipToUv(previousClip)
            : meshCurrentUv[vertexIndex];
    meshTexCoord[vertexIndex] = uv;
    meshMaterialIndex[vertexIndex] = materialIndex;
    meshReceiverSignature[vertexIndex] =
        (clusterIndex * 0x9e3779b9u) ^
        (materialIndex * 0x85ebca6bu) ^ 0x67f4a7c1u;
    meshHistoryFrameAndFlags[vertexIndex] =
        (pc.Push.CurrentFrameIndex & 0xffu) |
        ((pc.Push.PreviousFrameValid & 6u) << 7u);
    meshClusterIndex[vertexIndex] = clusterIndex;
    meshLodBand[vertexIndex] = lodBand;
    meshGeometryMode[vertexIndex] = geometryMode;
    meshImpostorMetadataIndex[vertexIndex] = impostorMetadataIndex;
    meshCurrentWorldPosition[vertexIndex] = currentPosition;
    meshViewDepths[vertexIndex] = vec2(
        abs(currentClip.w),
        abs(previousClip.w));
}

void EmitMotionVertex(
    uint vertexIndex,
    vec3 currentPosition,
    vec3 previousPosition,
    vec2 uv,
    uint materialIndex,
    uint clusterIndex,
    uint lodBand,
    uint geometryMode)
{
    EmitMotionVertex(
        vertexIndex,
        currentPosition,
        previousPosition,
        uv,
        materialIndex,
        clusterIndex,
        lodBand,
        geometryMode,
        0xffffffffu);
}

void WriteQuadIndices(uint primitiveCount)
{
    for (uint primitive = gl_LocalInvocationIndex;
         primitive < primitiveCount;
         primitive += gl_WorkGroupSize.x)
    {
        uint quad = primitive / 2u;
        uint vertexBase = quad * 4u;
        gl_PrimitiveTriangleIndicesEXT[primitive] =
            (primitive & 1u) == 0u
                ? uvec3(vertexBase + 0u, vertexBase + 1u, vertexBase + 2u)
                : uvec3(vertexBase + 2u, vertexBase + 1u, vertexBase + 3u);
    }
}

void main()
{
    uint drawIndex = gl_WorkGroupID.x + pc.Push.FirstDraw;
    if (gl_WorkGroupID.x >= pc.Push.MeshletDrawCount)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }

    GPUFoliageProceduralDrawCommand drawCommand =
        ReadFoliageProceduralDrawCommand(
            pc.Push.MeshletDrawBufferBaseIndex,
            pc.Push.CurrentFrameIndex,
            drawIndex);
    uint clusterIndex = drawCommand.ClusterIndex;
    if (clusterIndex == 0xffffffffu || drawCommand.ActiveCount == 0u)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }

    GPUFoliageCluster cluster = ReadFoliageCluster(clusterIndex);
    GPUFoliagePatch foliagePatch = ReadFoliagePatch(cluster.PatchIndex);
    GPUFoliagePrototype prototype =
        ReadFoliagePrototype(foliagePatch.PrototypeIndex);
    uint lodBand = drawCommand.LodBand;
    bool drawAuthoredFarImpostor = prototype.GeometryMode == 1u &&
        lodBand == 2u &&
        (prototype.Flags & FOLIAGE_PROTOTYPE_FLAG_FAR_IMPOSTOR) != 0u;
    if (prototype.GeometryMode != 0u &&
        prototype.GeometryMode != 2u &&
        !drawAuthoredFarImpostor)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }

    uint bladeCount = drawAuthoredFarImpostor
        ? 1u
        : min(drawCommand.ActiveCount, 16u);
    uint vertexCount = bladeCount * 4u;
    uint primitiveCount = bladeCount * 2u;
    if (gl_LocalInvocationIndex == 0u)
        SetMeshOutputsEXT(vertexCount, primitiveCount);
    barrier();

    vec3 boundsMin = cluster.BoundsMinDensity.xyz;
    vec3 boundsMax = cluster.BoundsMaxLod.xyz;
    vec3 extent = max(boundsMax - boundsMin, vec3(0.001));
    float baseHeight = max(0.05, prototype.BladeHeight);
    float baseWidth = max(0.01, prototype.BladeWidth) *
        drawCommand.WidthCompensation;

    if (prototype.GeometryMode == 2u || drawAuthoredFarImpostor)
    {
        vec3 wallUp = vec3(0.0, 1.0, 0.0);
        vec3 currentCardAnchor = cluster.WorldCenterRadius.xyz;
        vec3 previousCardAnchor = currentCardAnchor;
        uint impostorMetadataIndex = 0xffffffffu;
        uint impostorViewIndex = 0u;
        GPUFoliageImpostor impostor;
        GPUFoliageInstance currentImpostorInstance;
        GPUFoliageInstance previousImpostorInstance;
        if (drawAuthoredFarImpostor)
        {
            impostorMetadataIndex = prototype.ImpostorMetadataIndex;
            impostor = ReadFoliageImpostor(impostorMetadataIndex);
            uint previousFrameIndex =
                (pc.Push.CurrentFrameIndex + 1u) % uint(FRAMES_IN_FLIGHT);
            currentImpostorInstance = ReadFoliageInstance(
                pc.Push.CurrentFrameIndex,
                cluster.FirstInstance);
            previousImpostorInstance = ReadFoliageInstance(
                previousFrameIndex,
                cluster.FirstInstance);
            float currentScale = max(
                currentImpostorInstance.PositionScale.w,
                0.0001);
            vec3 sourceSize = max(
                impostor.SourceBoundsMax.xyz -
                    impostor.SourceBoundsMinScale.xyz,
                vec3(0.001));
            sourceSize *= impostor.SourceBoundsMinScale.w * currentScale;
            vec3 sourceCenter =
                (impostor.SourceBoundsMinScale.xyz +
                    impostor.SourceBoundsMax.xyz) * 0.5 -
                impostor.Pivot;
            currentCardAnchor = currentImpostorInstance.PositionScale.xyz +
                vec3(0.0, sourceCenter.y *
                    impostor.SourceBoundsMinScale.w * currentScale, 0.0);
            float previousScale = max(
                previousImpostorInstance.PositionScale.w,
                0.0001);
            previousCardAnchor = previousImpostorInstance.PositionScale.xyz +
                vec3(0.0, sourceCenter.y *
                    impostor.SourceBoundsMinScale.w * previousScale, 0.0);
            baseHeight = max(0.05, sourceSize.y);
            baseWidth = max(0.05, max(sourceSize.x, sourceSize.z));
        }
        vec3 currentViewNormal = SafeNormalize(
            pc.Push.CameraPosition.xyz - currentCardAnchor,
            vec3(0.0, 0.0, 1.0));
        vec3 previousViewNormal = SafeNormalize(
            pc.Push.PreviousCameraPosition.xyz - previousCardAnchor,
            currentViewNormal);
        if (drawAuthoredFarImpostor)
        {
            float viewAngle = atan(
                currentViewNormal.x,
                currentViewNormal.z) -
                currentImpostorInstance.RotationWind.x;
            impostorViewIndex = SelectFoliageImpostorView(
                impostor,
                vec3(
                    sin(viewAngle),
                    currentViewNormal.y,
                    cos(viewAngle)));
        }
        vec3 currentWallSide = drawAuthoredFarImpostor
            ? SafeNormalize(cross(wallUp, currentViewNormal), vec3(1.0, 0.0, 0.0))
            : vec3(1.0, 0.0, 0.0);
        vec3 previousWallSide = drawAuthoredFarImpostor
            ? SafeNormalize(cross(wallUp, previousViewNormal), currentWallSide)
            : vec3(1.0, 0.0, 0.0);
        vec3 currentWallNormal = drawAuthoredFarImpostor
            ? SafeNormalize(cross(currentWallSide, wallUp), vec3(0.0, 0.0, 1.0))
            : vec3(0.0, 0.0, 1.0);
        vec3 previousWallNormal = drawAuthoredFarImpostor
            ? SafeNormalize(cross(previousWallSide, wallUp), currentWallNormal)
            : vec3(0.0, 0.0, 1.0);
        vec3 currentCrossSide = SafeNormalize(
            currentWallNormal,
            vec3(0.0, 0.0, 1.0));
        vec3 previousCrossSide = SafeNormalize(
            previousWallNormal,
            currentCrossSide);

        for (uint card = gl_LocalInvocationIndex;
             card < bladeCount;
             card += gl_WorkGroupSize.x)
        {
            uint seed = cluster.RandomSeed ^
                (card * 747796405u) ^ foliagePatch.Seed;
            float rx = Hash01(seed + 1u);
            float ry = Hash01(seed + 2u);
            float rz = Hash01(seed + 3u);
            float rs = Hash01(seed + 4u);
            float rw = Hash01(seed + 5u);
            float angle = drawAuthoredFarImpostor
                ? float(card & 1u) * 1.57079632679
                : Hash01(seed + 6u) * 6.28318530718;
            vec3 currentCenter = drawAuthoredFarImpostor
                ? currentCardAnchor
                : vec3(
                    boundsMin.x + rx * extent.x,
                    boundsMin.y + ry * extent.y,
                    boundsMax.z - 0.02 - rz * 0.03);
            vec3 previousCenter = drawAuthoredFarImpostor
                ? previousCardAnchor
                : currentCenter;
            vec3 currentSideAxis = currentWallSide;
            vec3 previousSideAxis = previousWallSide;
            vec3 currentSide = drawAuthoredFarImpostor
                ? currentSideAxis
                : normalize(currentWallSide * cos(angle) + wallUp * sin(angle));
            vec3 previousSide = drawAuthoredFarImpostor
                ? previousSideAxis
                : normalize(previousWallSide * cos(angle) + wallUp * sin(angle));
            vec3 currentUp = drawAuthoredFarImpostor
                ? wallUp
                : normalize(-currentWallSide * sin(angle) + wallUp * cos(angle));
            vec3 previousUp = drawAuthoredFarImpostor
                ? wallUp
                : normalize(-previousWallSide * sin(angle) + wallUp * cos(angle));
            float height = drawAuthoredFarImpostor
                ? baseHeight
                : baseHeight * mix(0.75, 1.25, rs);
            float width = drawAuthoredFarImpostor
                ? baseWidth
                : baseWidth * mix(0.75, 1.25, rw);
            float currentWind = sin(
                pc.Push.Time * prototype.WindParams.y +
                float(seed & 1023u) * 0.013) * prototype.WindParams.x;
            float previousWind = sin(
                pc.Push.PreviousTime * prototype.WindParams.y +
                float(seed & 1023u) * 0.013) * prototype.WindParams.x;
            vec3 currentHalfSide = currentSide * (width * 0.5);
            vec3 previousHalfSide = previousSide * (width * 0.5);
            vec3 currentHalfUp = currentUp * (height * 0.5);
            vec3 previousHalfUp = previousUp * (height * 0.5);
            vec3 currentWindOffset = currentWallNormal *
                currentWind * height * 0.08;
            vec3 previousWindOffset = previousWallNormal *
                previousWind * height * 0.08;
            uint vertexBase = card * 4u;
            uint materialIndex = prototype.MaterialIndex;
            vec4 atlasRectangle = drawAuthoredFarImpostor
                ? ReadFoliageImpostorView(
                    impostor.ViewDataOffset + impostorViewIndex)
                    .AtlasRectangle
                : vec4(0.0, 0.0, 1.0, 1.0);
            vec2 uv00 = atlasRectangle.xy;
            vec2 uv10 = atlasRectangle.xy + vec2(atlasRectangle.z, 0.0);
            vec2 uv01 = atlasRectangle.xy + vec2(0.0, atlasRectangle.w);
            vec2 uv11 = atlasRectangle.xy + atlasRectangle.zw;

            EmitMotionVertex(vertexBase + 0u,
                currentCenter - currentHalfSide - currentHalfUp,
                previousCenter - previousHalfSide - previousHalfUp,
                uv00, materialIndex, clusterIndex, lodBand, 2u,
                impostorMetadataIndex);
            EmitMotionVertex(vertexBase + 1u,
                currentCenter + currentHalfSide - currentHalfUp,
                previousCenter + previousHalfSide - previousHalfUp,
                uv10, materialIndex, clusterIndex, lodBand, 2u,
                impostorMetadataIndex);
            EmitMotionVertex(vertexBase + 2u,
                currentCenter - currentHalfSide + currentHalfUp + currentWindOffset,
                previousCenter - previousHalfSide + previousHalfUp + previousWindOffset,
                uv01, materialIndex, clusterIndex, lodBand, 2u,
                impostorMetadataIndex);
            EmitMotionVertex(vertexBase + 3u,
                currentCenter + currentHalfSide + currentHalfUp + currentWindOffset,
                previousCenter + previousHalfSide + previousHalfUp + previousWindOffset,
                uv11, materialIndex, clusterIndex, lodBand, 2u,
                impostorMetadataIndex);
        }

        WriteQuadIndices(primitiveCount);
        return;
    }

    for (uint blade = gl_LocalInvocationIndex;
         blade < bladeCount;
         blade += gl_WorkGroupSize.x)
    {
        // Keep these seed offsets and equations byte-for-byte equivalent to
        // foliage_grass.mesh; no frame value participates in placement.
        uint seed = cluster.RandomSeed ^
            (blade * 747796405u) ^ foliagePatch.Seed;
        float rx = Hash01(seed + 1u);
        float rz = Hash01(seed + 2u);
        float rs = Hash01(seed + 3u);
        float ry = Hash01(seed + 4u);
        float angle = Hash01(seed + 5u) * 6.28318530718;
        vec3 root = vec3(
            boundsMin.x + rx * extent.x,
            boundsMin.y,
            boundsMin.z + rz * extent.z);
        float height = baseHeight * mix(0.75, 1.25, rs);
        float width = baseWidth * mix(0.70, 1.35, ry);
        vec3 side = normalize(vec3(cos(angle), 0.0, sin(angle))) * width;
        float currentWind = sin(
            pc.Push.Time * prototype.WindParams.y +
            float(seed & 1023u) * 0.013) * prototype.WindParams.x;
        float previousWind = sin(
            pc.Push.PreviousTime * prototype.WindParams.y +
            float(seed & 1023u) * 0.013) * prototype.WindParams.x;
        vec3 bendAxis = vec3(side.z, 0.0, -side.x) * height;
        vec3 currentTop = root + vec3(0.0, height, 0.0) +
            bendAxis * currentWind;
        vec3 previousTop = root + vec3(0.0, height, 0.0) +
            bendAxis * previousWind;
        uint vertexBase = blade * 4u;
        uint materialIndex = prototype.MaterialIndex;

        EmitMotionVertex(vertexBase + 0u,
            root - side, root - side, vec2(0.0, 0.0),
            materialIndex, clusterIndex, lodBand, 0u);
        EmitMotionVertex(vertexBase + 1u,
            root + side, root + side, vec2(1.0, 0.0),
            materialIndex, clusterIndex, lodBand, 0u);
        EmitMotionVertex(vertexBase + 2u,
            currentTop - side * 0.18, previousTop - side * 0.18,
            vec2(0.15, 1.0), materialIndex, clusterIndex, lodBand, 0u);
        EmitMotionVertex(vertexBase + 3u,
            currentTop + side * 0.18, previousTop + side * 0.18,
            vec2(0.85, 1.0), materialIndex, clusterIndex, lodBand, 0u);
    }

    WriteQuadIndices(primitiveCount);
}
