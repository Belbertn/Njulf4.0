#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionSpatialPushBlock
{
    uint ScreenWidth;
    uint ScreenHeight;
    uint Iteration;
    uint ReadScratch;
    float NormalPower;
    float DepthSigma;
    float RoughnessSigma;
    float Padding0;
} pc;

vec4 HybridReadSpatialInput(ivec2 pixel)
{
    if (pc.Iteration == 0u)
        return imageLoad(HybridHistoryCurrent, pixel);
    return (pc.Iteration & 1u) != 0u
        ? imageLoad(HybridFilterScratch, pixel)
        : imageLoad(HybridRawRadiance, pixel);
}

vec3 HybridSpatialFilterNormal(uvec4 payload, float roughness)
{
    vec3 shadingNormal = HybridReflectionPayloadShadingNormal(payload);
    vec3 geometricNormal = HybridReflectionPayloadGeometricNormal(payload);
    // Normal-map detail must steer a sharp reflection, but it is below the
    // support of a broad specular lobe. Relaxing toward the geometric normal
    // for rough receivers denoises sparse SSR/ray-query samples without
    // bleeding across silhouettes (depth and receiver identity remain hard
    // edge stops).
    float geometricWeight = smoothstep(0.15, 0.55,
        clamp(roughness, 0.0, 1.0));
    return normalize(mix(shadingNormal, geometricNormal, geometricWeight));
}

void HybridWriteSpatialOutput(ivec2 pixel, vec4 value)
{
    // Temporal history is an immutable input to the spatial stage. Writing a
    // filtered result back into it applies the blur again after reprojection
    // on every subsequent frame, which turns camera motion into long trails.
    // Raw radiance is dead after temporal resolve and is safe as the second
    // spatial ping-pong target.
    if ((pc.Iteration & 1u) == 0u)
        imageStore(HybridFilterScratch, pixel, value);
    else
        imageStore(HybridRawRadiance, pixel, value);
}

void main()
{
    uvec2 invocation = gl_GlobalInvocationID.xy;
    if (invocation.x >= pc.ScreenWidth || invocation.y >= pc.ScreenHeight)
        return;
    ivec2 pixel = ivec2(invocation);
    uvec4 centerPayload = texelFetch(HybridReceiverPayload, pixel, 0);
    if (!HybridReflectionPayloadValid(centerPayload))
    {
        HybridWriteSpatialOutput(pixel, vec4(0.0));
        return;
    }

    float centerRoughness = HybridReflectionPayloadRoughness(centerPayload);
    vec3 centerNormal = HybridSpatialFilterNormal(
        centerPayload, centerRoughness);
    uint centerIdentity = HybridReceiverIdentity(centerPayload);
    float centerDepth = texelFetch(HybridSceneDepth, pixel, 0).r;
    int radius = 1 + int(min(pc.Iteration, 2u));
    float broadLobeWeight = smoothstep(
        0.20, 0.85, centerRoughness);
    float normalPower = mix(
        max(pc.NormalPower, 1.0), 2.0, broadLobeWeight);
    float roughnessSigma = mix(
        max(pc.RoughnessSigma, 1.0e-4), 0.35,
        broadLobeWeight);
    vec4 accumulated = vec4(0.0);
    float totalWeight = 0.0;
    for (int y = -radius; y <= radius; y++)
    {
        for (int x = -radius; x <= radius; x++)
        {
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0),
                ivec2(pc.ScreenWidth, pc.ScreenHeight) - ivec2(1));
            uvec4 samplePayload = texelFetch(
                HybridReceiverPayload, samplePixel, 0);
            if (!HybridReflectionPayloadValid(samplePayload))
                continue;
            vec4 sampleValue = HybridReadSpatialInput(samplePixel);
            uvec2 sampleMetadata = imageLoad(
                HybridMetadataCurrent, samplePixel).xy;
            if (!HybridMetadataValid(sampleMetadata.x) ||
                sampleMetadata.y != centerIdentity ||
                !HybridFinite(sampleValue))
                continue;
            float sampleRoughness =
                HybridReflectionPayloadRoughness(samplePayload);
            vec3 sampleNormal = HybridSpatialFilterNormal(
                samplePayload, sampleRoughness);
            float sampleDepth = texelFetch(
                HybridSceneDepth, samplePixel, 0).r;
            float normalWeight = pow(
                max(dot(centerNormal, sampleNormal), 0.0), normalPower);
            float depthWeight = exp(-abs(centerDepth - sampleDepth) /
                max(pc.DepthSigma, 1.0e-6));
            float roughnessWeight = exp(-abs(
                centerRoughness - sampleRoughness) / roughnessSigma);
            float spatialWeight = 1.0 /
                (1.0 + float(x * x + y * y));
            float weight = normalWeight * depthWeight *
                roughnessWeight * spatialWeight;
            accumulated += sampleValue * weight;
            totalWeight += weight;
        }
    }
    vec4 center = HybridReadSpatialInput(pixel);
    HybridWriteSpatialOutput(pixel, totalWeight > 1.0e-6
        ? accumulated / totalWeight
        : HybridFinite(center) ? center : vec4(0.0));
}
