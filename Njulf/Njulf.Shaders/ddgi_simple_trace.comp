// Kept deliberately small: these are invocation-local records and therefore
// consume registers. Overflow retains the nearest deterministic set and is a
// qualification failure through DDGI_DECAL_CANDIDATE_LIMIT_COUNTER.
const uint SIMPLE_DDGI_DECAL_CANDIDATE_LIMIT = 8u;
struct SimpleDdgiDecalCandidate
{
    uint InstanceIndex;
    uint PrimitiveIndex;
    vec2 Barycentrics;
    float Distance;
    bool FrontFacing;
};

int SimpleDdgiDecalLayer(GPUDdgiRayQueryInstance instance)
{
    return int(instance.PackedDecalLayerAndOrder << 16u) >> 16;
}

uint SimpleDdgiDecalStableOrder(GPUDdgiRayQueryInstance instance)
{
    return instance.PackedDecalLayerAndOrder >> 16u;
}

bool SimpleDdgiDecalComesBefore(
    SimpleDdgiDecalCandidate left,
    SimpleDdgiDecalCandidate right)
{
    GPUDdgiRayQueryInstance leftInstance =
        ReadDdgiRayQueryInstance(left.InstanceIndex);
    GPUDdgiRayQueryInstance rightInstance =
        ReadDdgiRayQueryInstance(right.InstanceIndex);
    int leftLayer = SimpleDdgiDecalLayer(leftInstance);
    int rightLayer = SimpleDdgiDecalLayer(rightInstance);
    if (leftLayer != rightLayer)
        return leftLayer < rightLayer;
    uint leftOrder = SimpleDdgiDecalStableOrder(leftInstance);
    uint rightOrder = SimpleDdgiDecalStableOrder(rightInstance);
    if (leftOrder != rightOrder)
        return leftOrder < rightOrder;
    if (leftInstance.StableInstanceIdentity !=
        rightInstance.StableInstanceIdentity)
    {
        return leftInstance.StableInstanceIdentity <
            rightInstance.StableInstanceIdentity;
    }
    if (left.PrimitiveIndex != right.PrimitiveIndex)
        return left.PrimitiveIndex < right.PrimitiveIndex;
    return left.Distance < right.Distance;
}

bool SimpleDdgiDecalIsFarther(
    SimpleDdgiDecalCandidate left,
    SimpleDdgiDecalCandidate right)
{
    if (left.Distance != right.Distance)
        return left.Distance > right.Distance;
    GPUDdgiRayQueryInstance leftInstance =
        ReadDdgiRayQueryInstance(left.InstanceIndex);
    GPUDdgiRayQueryInstance rightInstance =
        ReadDdgiRayQueryInstance(right.InstanceIndex);
    if (leftInstance.StableInstanceIdentity !=
        rightInstance.StableInstanceIdentity)
    {
        return leftInstance.StableInstanceIdentity >
            rightInstance.StableInstanceIdentity;
    }
    return left.PrimitiveIndex > right.PrimitiveIndex;
}
