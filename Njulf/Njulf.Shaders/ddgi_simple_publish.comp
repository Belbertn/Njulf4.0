#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#define SIMPLE_DDGI_DISABLE_SAMPLED_ATLAS 1
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform SimpleDdgiPublishPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint ProbeStateBufferIndex;
    uint ReceiverProbeBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint TransportIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint SampledAtlasGroupCount;
    uint SampledAtlasLayersPerTexture;
    uint SchedulerArenaBufferIndex;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerFrameOffsetWords;
} pc;

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint queueOffset = gl_WorkGroupID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint requestCount = gpuScheduler
        ? SimpleDdgiSchedulerAcceptedCount(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerCountersOffsetWords)
        : params.probesToUpdate;
    bool residentTransaction = gpuScheduler &&
        (ReadStorageWordUniform(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerFrameOffsetWords + 27u) & 1u) != 0u;
    if (queueOffset >= requestCount || params.probeCount == 0u)
        return;

    SimpleDdgiProbeUpdate update =
        ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, queueOffset);
    if (!SimpleDdgiSchedulerOutcomeAllowsPublication(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            false,
            pc.SchedulerFrameOffsetWords))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            SIMPLE_DDGI_SCHEDULER_FAILURE_PUBLICATION_GUARD);
        return;
    }
    if (update.probeIndex >= params.probeCount ||
        update.volumeIndex >= params.volumeCount ||
        !SimpleDdgiUpdateMatchesLiveAddress(params, update))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    SimpleDdgiProbeState state =
        ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, update.probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
            params,
            update,
            state))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    SimpleDdgiVolume volume =
        ReadSimpleDdgiVolume(pc.ParamsBufferIndex, update.volumeIndex);

    // Resident mode keeps receiver-visible atlases immutable during the
    // producer phase. CommitLocal performs the final copy after all producer
    // completion and generation checks have passed.
    if (residentTransaction)
    {
        barrier();
        memoryBarrierBuffer();
        barrier();
        if (gl_LocalInvocationID.x == 0u)
            SimpleDdgiSchedulerCompleteSingle(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 5u);
        return;
    }

    if ((params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u)
    {
        uint texelCount = params.irradianceTexels * params.irradianceTexels;
        for (uint texel = gl_LocalInvocationID.x;
             texel < texelCount;
             texel += gl_WorkGroupSize.x)
        {
            vec4 value = ReadSimpleDdgiIrradianceTexel(
                pc.TransportIrradianceAtlasBufferIndex,
                update.physicalProbeIndex,
                texel,
                params.irradianceTexels);
            WriteSimpleDdgiIrradianceTexel(
                pc.IrradianceAtlasBufferIndex,
                update.physicalProbeIndex,
                texel,
                params.irradianceTexels,
                value);
        }
    }

    barrier();
    memoryBarrierBuffer();
    barrier();
    if (gl_LocalInvocationID.x == 0u)
    {
        uint receiverFlags = 0u;
        if ((state.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u)
            receiverFlags |= SIMPLE_DDGI_RECEIVER_FLAG_FRESH;
        // Compact receiver records do not carry the compute-state visibility
        // bit. Alias an invalid visibility payload to their existing FRESH
        // rejection gate so a delayed CPU publication cannot expose zeroed or
        // partially refreshed moments.
        if ((state.flags & SIMPLE_DDGI_PROBE_FLAG_VISIBILITY_VALID) == 0u)
            receiverFlags |= SIMPLE_DDGI_RECEIVER_FLAG_FRESH;
        if ((state.flags & SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED) != 0u)
            receiverFlags |= SIMPLE_DDGI_RECEIVER_FLAG_SCROLL_EXPOSED;
        if ((state.flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u)
            receiverFlags |= SIMPLE_DDGI_RECEIVER_FLAG_RELOCATION_PENDING;
        if ((state.flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u)
            receiverFlags |= SIMPLE_DDGI_RECEIVER_FLAG_INACTIVE;
        if (state.classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE)
            receiverFlags |= SIMPLE_DDGI_RECEIVER_FLAG_INACTIVE_CLASSIFICATION;

        bool published = PublishSimpleDdgiReceiverProbe(
            pc.ReceiverProbeBufferIndex,
            update.probeIndex,
            state.relocation,
            volume.spacing,
            state.activeWeight,
            receiverFlags,
            update.physicalProbeIndex);
        if (published)
        {
            SimpleDdgiSchedulerCompleteSingle(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 5u);
        }
        else
        {
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 3u);
        }
    }
}
