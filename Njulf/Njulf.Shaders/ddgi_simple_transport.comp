#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "gi_material_transport.glsl"
// Transport reads the canonical field published by the preceding completed
// update. The sampled atlas is an incrementally synchronized mirror of that
// exact field and remains in shader-read layout between publications, including
// on a distinct compute queue. Use hardware bilinear filtering for interior
// octahedral samples; ddgi_simple_shared.glsl retains the canonical SSBO path at
// seams and whenever the optional mirror is unavailable.
#include "ddgi_simple_shared.glsl"
#include "ddgi_simple_transport_operator.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint TransportGeneration;
    uint PrimaryDirectionalLightIndex;
    uint DispatchQueueOffset;
    uint DispatchProbeCount;
    uint DispatchRaysPerProbe;
    uint SchedulerArenaBufferIndex;
    uint SchedulerRayBucketIndex;
    uint SchedulerRayBucketCommandsOffsetWords;
    uint SchedulerRayBucketMetadataOffsetWords;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerUpdateRecordsOffsetWords;
} pc;

void WriteSimpleTransportRayResult(
    uint rayResultIndex,
    vec3 radiance,
    float surfaceDistance,
    float visibilityDistance,
    vec3 direction,
    float hitKind)
{
    uint baseWord = rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS;
    WriteStorageVec4Uniform(pc.RayResultScratchBufferIndex, baseWord, vec4(clamp(radiance, vec3(0.0), vec3(65504.0)), max(surfaceDistance, 0.0)));
    WriteStorageFloatUniform(pc.RayResultScratchBufferIndex, baseWord + 4u, direction.x);
    WriteStorageFloatUniform(pc.RayResultScratchBufferIndex, baseWord + 5u, direction.y);
    WriteStorageFloatUniform(pc.RayResultScratchBufferIndex, baseWord + 6u, direction.z);
    WriteStorageWordUniform(
        pc.RayResultScratchBufferIndex,
        baseWord + 7u,
        PackSimpleDdgiRayVisibilityHit(visibilityDistance, hitKind));
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint dispatchRay = gl_GlobalInvocationID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint schedulerQueueOffset = 0u;
    uint schedulerProbeCount = 0u;
    uint schedulerRaysPerProbe = 0u;
    if (gpuScheduler)
    {
        SimpleDdgiResolveSchedulerRayBucket(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerRayBucketMetadataOffsetWords,
            pc.SchedulerRayBucketIndex,
            schedulerQueueOffset,
            schedulerProbeCount,
            schedulerRaysPerProbe);
    }
    uint dispatchProbeCount;
    uint dispatchRaysPerProbe;
    if (gpuScheduler)
    {
        // Resident dispatch dimensions and queue addressing are an ABI owned by
        // the emitted metadata record. Push constants are intentionally ignored
        // here so a stale per-pass batch cannot select another queue slice.
        dispatchProbeCount = schedulerProbeCount;
        dispatchRaysPerProbe = schedulerRaysPerProbe;
    }
    else
    {
        dispatchProbeCount = pc.DispatchProbeCount > 0u
            ? pc.DispatchProbeCount
            : params.probesToUpdate;
        dispatchRaysPerProbe = pc.DispatchRaysPerProbe > 0u
            ? pc.DispatchRaysPerProbe
            : params.raysPerProbe;
    }
    uint dispatchRayCount = dispatchProbeCount * dispatchRaysPerProbe;
    if (dispatchRay >= dispatchRayCount || params.probeCount == 0u ||
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) == 0u)
    {
        return;
    }

    uint queueOffset = (gpuScheduler ? schedulerQueueOffset : pc.DispatchQueueOffset) +
        dispatchRay / dispatchRaysPerProbe;
    uint rayIndex = dispatchRay % dispatchRaysPerProbe;
    if (!gpuScheduler && queueOffset >= params.probesToUpdate)
        return;
    uint globalRay = queueOffset * params.raysPerProbe + rayIndex;
    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, queueOffset);
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    if (rayIndex >= activeRayCount || update.probeIndex >= params.probeCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(update.probeIndex, params, volume, localProbeIndex))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    if (!SimpleDdgiSolveVolumeMatches(
            pc.Flags,
            update.volumeIndex,
            pc.PrimaryDirectionalLightIndex))
        return;
    SimpleDdgiProbeState probeState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, update.probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGeneration(update, probeState))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }
    if (!SimpleDdgiSolveColorMatches(pc.Flags, volume, localProbeIndex))
        return;

    uint sourceRayCount = SimpleDdgiUpdateSourceRayCount(update, params);
    uint sourceRayOrdinal = min(
        rayIndex * sourceRayCount / max(activeRayCount, 1u),
        sourceRayCount - 1u);
    uint directionRayIndex = sourceRayOrdinal * params.raysPerProbe / sourceRayCount;
    SimpleDdgiTransportRayCache source;
    if (!ReadSimpleDdgiTransportRayCache(
            pc.TransportSourceCacheBufferIndex,
            update.probeIndex,
            directionRayIndex,
            params,
            SimpleDdgiProbeGeneration(probeState),
            source))
    {
        // A stale/corrupt cache cannot inject old energy. Preserve the source
        // scratch result (or zero if trace was skipped), then atomically request
        // a full source refresh through the next probe-state readback.
        if (gpuScheduler)
        {
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 1u);
        }
        else
            MarkSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, update.probeIndex);
        uint scratchBase = globalRay * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS;
        vec4 sourceRadianceDistance = ReadStorageAlignedVec4Uniform(pc.RayResultScratchBufferIndex, scratchBase);
        vec4 sourceDirectionHit = ReadStorageAlignedVec4Uniform(pc.RayResultScratchBufferIndex, scratchBase + 4u);
        vec2 sourceVisibilityHit =
            UnpackSimpleDdgiRayVisibilityHit(
                ReadStorageWordUniform(
                    pc.RayResultScratchBufferIndex,
                    scratchBase + 7u));
        RecordSimpleDdgiTransportEnergyDiagnostics(
            params,
            pc.CurrentFrameIndex,
            update.volumeIndex,
            update.probeIndex,
            directionRayIndex,
            false,
            sourceRadianceDistance.rgb,
            vec3(0.0),
            sourceRadianceDistance.rgb,
            0u,
            0.0,
            0.0);
        WriteSimpleTransportRayResult(
            globalRay,
            sourceRadianceDistance.rgb,
            sourceRadianceDistance.w,
            sourceVisibilityHit.x,
            sourceDirectionHit.xyz,
            sourceVisibilityHit.y);
        if (SimpleDdgiSolveIsFinalColor(pc.Flags))
            SimpleDdgiSchedulerRayComplete(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                activeRayCount,
                1u << 2u);
        return;
    }

    vec3 reflectedBounceRadiance;
    vec3 transmittedBounceRadiance;
    uint solverGatherCount;
    float solverOwnershipSum;
    float solverFallbackWeightSum;
    bool malformedOperatorInput;
    float enforcedThroughput;
    vec3 bounceRadiance = EvaluateSimpleDdgiCachedRecursiveBounce(
        params,
        volume,
        localProbeIndex,
        probeState,
        source,
        reflectedBounceRadiance,
        transmittedBounceRadiance,
        solverGatherCount,
        solverOwnershipSum,
        solverFallbackWeightSum,
        malformedOperatorInput,
        enforcedThroughput);
    vec3 totalRadiance = source.sourceRadiance;
    totalRadiance += bounceRadiance;
    if (malformedOperatorInput)
    {
        // A malformed operator input is a source-cache repair condition.  Do
        // not let a zeroed recursive term become a seemingly valid certificate
        // while the cache metadata still claims that this probe is current.
        MarkSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, update.probeIndex);
        bounceRadiance = vec3(0.0);
        totalRadiance = source.sourceRadiance;
    }

    if ((params.flags & SIMPLE_DDGI_FLAG_DETAILED_DIAGNOSTICS_ENABLED) != 0u &&
        max(source.transmittedDiffuseReflectance.r,
            max(source.transmittedDiffuseReflectance.g, source.transmittedDiffuseReflectance.b)) > 0.0)
    {
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            DDGI_THIN_REFLECTED_RECURSIVE_LUMINANCE_COUNTER,
            uint(round(clamp(
                dot(max(reflectedBounceRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * DDGI_THIN_LUMINANCE_SCALE,
                0.0,
                4294967295.0))));
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            DDGI_THIN_TRANSMITTED_RECURSIVE_LUMINANCE_COUNTER,
            uint(round(clamp(
                dot(max(transmittedBounceRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * DDGI_THIN_LUMINANCE_SCALE,
                0.0,
                4294967295.0))));
    }

    RecordSimpleDdgiTransportEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        update.volumeIndex,
        update.probeIndex,
        directionRayIndex,
        true,
        source.sourceRadiance,
        bounceRadiance,
        totalRadiance,
        solverGatherCount,
        solverOwnershipSum,
        solverFallbackWeightSum);

    vec2 visibilityHit = UnpackSimpleDdgiRayVisibilityHit(
        ReadStorageWordUniform(
            pc.RayResultScratchBufferIndex,
            globalRay * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 7u));
    WriteSimpleTransportRayResult(
        globalRay,
        totalRadiance,
        source.distance,
        visibilityHit.x,
        source.direction,
        visibilityHit.y);
    if (SimpleDdgiSolveIsFinalColor(pc.Flags))
        SimpleDdgiSchedulerRayComplete(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            activeRayCount,
            1u << 2u);
}
