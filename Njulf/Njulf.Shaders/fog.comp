#define SIMPLE_DDGI_RECEIVER_COVERAGE_HASH ((gl_WorkGroupID.x * 73856093u) ^ (gl_WorkGroupID.y * 19349663u))
#define SIMPLE_DDGI_RECEIVER_CONSUMER_FLAGS SIMPLE_DDGI_RECEIVER_CONSUMER_FOG
#define SIMPLE_DDGI_RECEIVER_TOUCHES_RESIDENT 1
#define SIMPLE_DDGI_RECEIVER_DEMAND_FRAME_OFFSET 1u
