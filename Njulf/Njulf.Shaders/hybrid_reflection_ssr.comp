#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionSsrPushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndMaximumDistance;
    uint ScreenWidth;
    uint ScreenHeight;
    uint MaximumSteps;
    uint HiZMipCount;
    float FullResolutionRoughness;
    float HalfResolutionRoughness;
    float QuarterResolutionRoughness;
    float ConfidenceThreshold;
    uint TemporalSampleIndex;
    uint HistoryValidAndCurrentFrameIndex;
    uint RayQueriesEnabled;
    uint RayAdmissionThreshold;
} pc;

uint ResolveTier(float roughness)
{
    float fullResolutionRoughness = pc.FullResolutionRoughness;
    float halfResolutionRoughness = max(
        fullResolutionRoughness, pc.HalfResolutionRoughness);
    float quarterResolutionRoughness = max(
        halfResolutionRoughness, pc.QuarterResolutionRoughness);
    if (roughness <= fullResolutionRoughness)
        return 1u;
    if (roughness <= halfResolutionRoughness)
        return 2u;
    if (roughness <= quarterResolutionRoughness)
        return 4u;
    return 0u;
}

bool IsDisoccluded(
    ivec2 pixel,
    uint identity,
    vec3 worldPosition,
    vec3 currentNormal)
{
    if ((pc.HistoryValidAndCurrentFrameIndex & 1u) == 0u)
        return false;
    vec2 dimensions = vec2(pc.ScreenWidth, pc.ScreenHeight);
    vec2 uv = (vec2(pixel) + vec2(0.5)) / dimensions;
    vec2 motion = texelFetch(HybridMotionVectors, pixel, 0).rg;
    vec2 previousUv = uv - motion;
    if (!HybridFinite(motion) || any(lessThan(previousUv, vec2(0.0))) ||
        any(greaterThanEqual(previousUv, vec2(1.0))))
    {
        return true;
    }
    uint frameIndex = pc.HistoryValidAndCurrentFrameIndex >> 1u;
    if (ReadMeshletTaskPreviousHiZFrameValid(frameIndex) == 0u)
        return true;
    vec4 previousClip = MulRowMajor(vec4(worldPosition, 1.0),
        ReadMeshletTaskPreviousHiZViewProjectionMatrix(frameIndex));
    if (any(isnan(previousClip)) || any(isinf(previousClip)) ||
        abs(previousClip.w) <= 1.0e-7)
    {
        return true;
    }
    float expectedDepth = previousClip.z / previousClip.w;
    float depthTolerance = max(0.0005, abs(expectedDepth) * 0.002);
    if (!HybridFinite(expectedDepth))
        return true;

    // Validate all four reprojection taps. Sub-pixel camera motion must not
    // turn a same-surface history sample into a false disocclusion.
    vec2 historyPosition = previousUv * dimensions - vec2(0.5);
    ivec2 historyBase = ivec2(floor(historyPosition));
    for (int tapY = 0; tapY < 2; tapY++)
    {
        for (int tapX = 0; tapX < 2; tapX++)
        {
            ivec2 previousPixel = historyBase + ivec2(tapX, tapY);
            if (any(lessThan(previousPixel, ivec2(0))) ||
                any(greaterThanEqual(previousPixel,
                    ivec2(pc.ScreenWidth, pc.ScreenHeight))))
            {
                continue;
            }
            uvec4 previousMetadata = imageLoad(
                HybridMetadataPrevious, previousPixel);
            if (!HybridMetadataValid(previousMetadata.x) ||
                previousMetadata.y != identity)
            {
                continue;
            }
            float previousDepth = uintBitsToFloat(previousMetadata.z);
            vec3 previousNormal = NjulfHybridReflectionOctDecode(
                previousMetadata.w);
            if (HybridFinite(previousDepth) &&
                abs(previousDepth - expectedDepth) <= depthTolerance &&
                HybridFinite(previousNormal) &&
                dot(currentNormal, previousNormal) >= 0.9)
            {
                return false;
            }
        }
    }
    return true;
}

void RejectToRecovery(
    ivec2 pixel,
    uint reason,
    uint identity,
    uint tier)
{
    imageStore(HybridRawRadiance, pixel, vec4(0.0));
    imageStore(HybridRawMetadata, pixel, uvec4(
        HybridPackMetadata(HYBRID_REFLECTION_SOURCE_NONE, 0.0,
            reason, 0u, false), identity, 0u, 0u));
    // Tier zero is the analytic roughness fallback. Half/quarter tiers already
    // reduce ray demand through their rotating sparse refresh footprint.
    if (tier != 0u && pc.RayQueriesEnabled != 0u &&
        pc.RayAdmissionThreshold != 0u &&
        !HybridAppendRayTask(uvec2(pixel), reason, identity, tier,
            pc.TemporalSampleIndex, pc.RayAdmissionThreshold))
    {
        // A spatially distributed budget rejection is not a confirmed ray
        // miss. Temporal reconstruction may retain validated geometric
        // history until this pixel's rotated admission phase is selected.
        imageStore(HybridRawMetadata, pixel, uvec4(
            HybridPackMetadata(HYBRID_REFLECTION_SOURCE_NONE, 0.0,
                HYBRID_REFLECTION_REASON_RAY_BUDGET, 0u, false),
            identity, 0u, 0u));
    }
}

void main()
{
    uvec2 invocation = gl_GlobalInvocationID.xy;
    if (invocation.x >= pc.ScreenWidth || invocation.y >= pc.ScreenHeight)
        return;

    ivec2 pixel = ivec2(invocation);
    uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
    if (!HybridReflectionPayloadValid(payload))
    {
        imageStore(HybridRawRadiance, pixel, vec4(0.0));
        imageStore(HybridRawMetadata, pixel, uvec4(0u));
        return;
    }

    float roughness = HybridReflectionPayloadRoughness(payload);
    uint tier = ResolveTier(roughness);
    uint identity = HybridReceiverIdentity(payload);
    if (tier == 0u)
    {
        RejectToRecovery(pixel,
            HYBRID_REFLECTION_REASON_ROUGHNESS_FALLBACK,
            identity, tier);
        return;
    }

    vec3 worldPosition;
    float receiverDepth;
    if (!HybridReconstructWorldPosition(pixel,
            uvec2(pc.ScreenWidth, pc.ScreenHeight),
            pc.InverseViewProjectionMatrix,
            worldPosition, receiverDepth))
    {
        RejectToRecovery(pixel,
            HYBRID_REFLECTION_REASON_INVALID_OR_OFFSCREEN,
            identity, tier);
        return;
    }
    vec3 normal = HybridReflectionPayloadShadingNormal(payload);
    bool disoccluded = IsDisoccluded(
        pixel, identity, worldPosition, normal);

    // Lower-resolution bands rotate one representative through each 2x2 or
    // 4x4 footprint. A camera cut forces every pixel through once so history
    // never starts with sparse holes.
    uint phase = HybridHash(pc.TemporalSampleIndex) % (tier * tier);
    uint lane = (invocation.y % tier) * tier + (invocation.x % tier);
    if ((pc.HistoryValidAndCurrentFrameIndex & 1u) != 0u &&
        lane != phase && !disoccluded)
    {
        imageStore(HybridRawRadiance, pixel, vec4(0.0));
        imageStore(HybridRawMetadata, pixel, uvec4(
            HybridPackMetadata(HYBRID_REFLECTION_SOURCE_NONE, 0.0,
                HYBRID_REFLECTION_REASON_RESOLUTION_SKIP, 0u, false),
            identity, 0u, 0u));
        return;
    }

    vec3 viewToReceiver = normalize(
        worldPosition - pc.CameraPositionAndMaximumDistance.xyz);
    vec3 reflectionDirection = normalize(reflect(viewToReceiver, normal));
    if (!HybridFinite(reflectionDirection) ||
        dot(reflectionDirection, HybridReflectionPayloadGeometricNormal(payload)) <= 0.001)
    {
        RejectToRecovery(pixel,
            HYBRID_REFLECTION_REASON_INVALID_OR_OFFSCREEN,
            identity, tier);
        return;
    }

    uint currentFrameIndex =
        pc.HistoryValidAndCurrentFrameIndex >> 1u;
    mat4 viewProjection =
        ReadMeshletTaskViewProjectionMatrix(currentFrameIndex);
    float maximumDistance = pc.CameraPositionAndMaximumDistance.w;
    uint tierSteps = max(8u, pc.MaximumSteps / max(tier, 1u));
    float jitter = float(HybridHash(
        invocation.x ^ (invocation.y * 0x9e3779b9u)) & 0xffffu) /
        65535.0;
    bool leftScreen = false;
    vec2 hitUv = vec2(0.0);
    float hitConfidence = 0.0;
    uint hitStep = tierSteps;

    for (uint stepIndex = 0u; stepIndex < tierSteps; stepIndex++)
    {
        float normalizedStep = (float(stepIndex) + 0.75 + jitter * 0.5) /
            float(tierSteps);
        float distanceAlongRay = max(0.02,
            normalizedStep * normalizedStep * maximumDistance);
        vec3 samplePosition = worldPosition + reflectionDirection *
            distanceAlongRay;
        vec4 clip = MulRowMajor(vec4(samplePosition, 1.0), viewProjection);
        if (!HybridFinite(clip.xyz) || clip.w <= 1.0e-6)
            continue;
        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = ndc.xy * 0.5 + vec2(0.5);
        if (any(lessThan(uv, vec2(0.0))) ||
            any(greaterThanEqual(uv, vec2(1.0))))
        {
            leftScreen = true;
            break;
        }

        float footprint = max(1.0, float(tier) *
            (1.0 + normalizedStep * 8.0));
        float mip = clamp(log2(footprint), 0.0,
            float(max(int(pc.HiZMipCount) - 1, 0)));
        float sceneDepth = textureLod(
            BindlessTextures[nonuniformEXT(HIZ_DEPTH_TEXTURE_INDEX)],
            uv, mip).r;
        float rayDepth = ndc.z;
        float depthError = sceneDepth - rayDepth;
        float thickness = 0.0015 + normalizedStep * 0.006 +
            roughness * 0.003;
        if (sceneDepth > 0.0 && depthError >= 0.0 &&
            depthError <= thickness)
        {
            float fineDepth = textureLod(
                BindlessTextures[nonuniformEXT(HIZ_DEPTH_TEXTURE_INDEX)],
                uv, 0.0).r;
            float fineError = abs(fineDepth - rayDepth);
            float edge = min(min(uv.x, uv.y),
                min(1.0 - uv.x, 1.0 - uv.y));
            float edgeConfidence = smoothstep(0.0, 0.08, edge);
            float depthConfidence = 1.0 - clamp(
                fineError / max(thickness, 1.0e-5), 0.0, 1.0);
            float marchConfidence = 1.0 -
                float(stepIndex) / float(max(tierSteps, 1u));
            hitConfidence = clamp(edgeConfidence * depthConfidence *
                mix(0.5, 1.0, marchConfidence), 0.0, 1.0);
            hitUv = uv;
            hitStep = stepIndex;
            break;
        }
    }

    if (hitStep < tierSteps && !disoccluded &&
        hitConfidence >= pc.ConfidenceThreshold)
    {
        // HDR Scene Color currently has one mip. Roughness is reconstructed by
        // the tiered trace cadence and edge-aware spatial pass, so requesting a
        // nonexistent mip here is undefined and produced black SSR samples.
        vec3 radiance = textureLod(
            BindlessTextures[nonuniformEXT(HDR_SCENE_COLOR_TEXTURE_INDEX)],
            hitUv, 0.0).rgb;
        if (!HybridFinite(radiance))
        {
            RejectToRecovery(pixel,
                HYBRID_REFLECTION_REASON_LOW_CONFIDENCE,
                identity, tier);
            return;
        }
        imageStore(HybridRawRadiance, pixel,
            vec4(max(radiance, vec3(0.0)), hitConfidence));
        imageStore(HybridRawMetadata, pixel, uvec4(
            HybridPackMetadata(HYBRID_REFLECTION_SOURCE_SSR,
                hitConfidence, HYBRID_REFLECTION_REASON_NONE, 0u, true),
            identity, 0u, 0u));
        atomicAdd(HybridCounters[HYBRID_REFLECTION_COUNTER_SSR_HITS], 1u);
        return;
    }

    uint reason = disoccluded
        ? HYBRID_REFLECTION_REASON_DISOCCLUDED
        : hitStep < tierSteps
            ? HYBRID_REFLECTION_REASON_LOW_CONFIDENCE
            : HYBRID_REFLECTION_REASON_INVALID_OR_OFFSCREEN;
    RejectToRecovery(pixel, reason, identity, tier);
}
