#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "global_sdf.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

const uint GLOBAL_SDF_MAX_BRICK_MESH_CANDIDATES = 512u;
const uint GLOBAL_SDF_CANDIDATE_OVERFLOW_COUNTER = 105u;
const uint GLOBAL_SDF_EMPTY_PREVIOUS_CANDIDATES_COUNTER = 118u;
const uint GLOBAL_SDF_BRICKS_WRITTEN_EMPTY_COUNTER = 124u;
const uint GLOBAL_SDF_BRICKS_WRITTEN_WITH_CANDIDATES_COUNTER = 125u;
const uint GLOBAL_SDF_THIN_FEATURE_FIRST_CASCADE = 2u;
const float GLOBAL_SDF_THIN_FEATURE_CENTER_BAND_VOXELS = 0.5;
const float GLOBAL_SDF_THIN_FEATURE_NEGATIVE_CORE_VOXELS = 0.35;
shared uint SharedCandidateCount;
shared uint SharedMeshSdfCandidates[GLOBAL_SDF_MAX_BRICK_MESH_CANDIDATES];
shared vec4 SharedMeshSdfBoundsCenterRadius[GLOBAL_SDF_MAX_BRICK_MESH_CANDIDATES];

layout(push_constant) uniform PushConstants
{
    GPUGlobalSdfConstants Push;
} pc;

uint HashGlobalSdfCandidateHistoryBrick(ivec3 logicalBrick, uint cascadeIndex)
{
    uint hash = 2166136261u;
    hash = (hash ^ uint(logicalBrick.x)) * 16777619u;
    hash = (hash ^ uint(logicalBrick.y)) * 16777619u;
    hash = (hash ^ uint(logicalBrick.z)) * 16777619u;
    hash = (hash ^ cascadeIndex) * 16777619u;
    return hash;
}

GPUMeshSdf ReadMeshSdf(uint meshSdfIndex)
{
    uint baseWord = meshSdfIndex * (uint(SIZEOF_GPU_MESH_SDF) / 4u);
    GPUMeshSdf result;
    result.LocalBoundsMinAndVoxelSize = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 0u);
    result.LocalBoundsExtentAndInvVoxelSize = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 4u);
    result.WorldBoundsMinAndLocalScaleX = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 8u);
    result.WorldBoundsMaxAndLocalScaleY = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 12u);
    result.WorldToLocalRow0 = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 16u);
    result.WorldToLocalRow1 = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 20u);
    result.WorldToLocalRow2 = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 24u);
    result.LocalToWorldAxisScale = ReadStorageVec4(pc.Push.MeshSdfBufferIndex, baseWord + 28u);
    result.TextureIndex = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 32u);
    result.ResolutionX = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 33u);
    result.ResolutionY = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 34u);
    result.ResolutionZ = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 35u);
    result.VertexOffset = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 36u);
    result.VertexCount = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 37u);
    result.IndexOffset = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 38u);
    result.IndexCount = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 39u);
    result.MeshIndex = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 40u);
    result.Flags = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 41u);
    result.Padding0 = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 42u);
    result.Padding1 = ReadStorageUint(pc.Push.MeshSdfBufferIndex, baseWord + 43u);
    return result;
}

vec3 TransformWorldToMeshSdfLocal(GPUMeshSdf meshSdf, vec3 worldPosition)
{
    return vec3(
        dot(worldPosition, vec3(meshSdf.WorldToLocalRow0.x, meshSdf.WorldToLocalRow1.x, meshSdf.WorldToLocalRow2.x)) + meshSdf.WorldToLocalRow0.w,
        dot(worldPosition, vec3(meshSdf.WorldToLocalRow0.y, meshSdf.WorldToLocalRow1.y, meshSdf.WorldToLocalRow2.y)) + meshSdf.WorldToLocalRow1.w,
        dot(worldPosition, vec3(meshSdf.WorldToLocalRow0.z, meshSdf.WorldToLocalRow1.z, meshSdf.WorldToLocalRow2.z)) + meshSdf.WorldToLocalRow2.w);
}

float DistanceToAabb(vec3 point, vec3 boundsMin, vec3 boundsMax)
{
    vec3 outside = max(max(boundsMin - point, point - boundsMax), vec3(0.0));
    return length(outside);
}

float ScaleLocalDistanceToWorld(vec3 localDistanceDirection, vec3 localToWorldScale)
{
    float directionLength2 = dot(localDistanceDirection, localDistanceDirection);
    if (directionLength2 <= 1.0e-10)
        return min(localToWorldScale.x, min(localToWorldScale.y, localToWorldScale.z));

    return length(localDistanceDirection * localToWorldScale) * inversesqrt(directionLength2);
}

float SampleMeshSdfNormalizedDistance(GPUMeshSdf meshSdf, vec3 uvw)
{
    return textureLod(BindlessVolumeTextures[nonuniformEXT(meshSdf.TextureIndex)], uvw, 0.0).r;
}

vec3 EstimateMeshSdfLocalGradient(GPUMeshSdf meshSdf, vec3 uvw, vec3 localExtent)
{
    vec3 resolution = max(vec3(meshSdf.ResolutionX, meshSdf.ResolutionY, meshSdf.ResolutionZ), vec3(1.0));
    vec3 duv = 1.0 / resolution;
    float dx = SampleMeshSdfNormalizedDistance(meshSdf, clamp(uvw + vec3(duv.x, 0.0, 0.0), vec3(0.0), vec3(1.0))) -
        SampleMeshSdfNormalizedDistance(meshSdf, clamp(uvw - vec3(duv.x, 0.0, 0.0), vec3(0.0), vec3(1.0)));
    float dy = SampleMeshSdfNormalizedDistance(meshSdf, clamp(uvw + vec3(0.0, duv.y, 0.0), vec3(0.0), vec3(1.0))) -
        SampleMeshSdfNormalizedDistance(meshSdf, clamp(uvw - vec3(0.0, duv.y, 0.0), vec3(0.0), vec3(1.0)));
    float dz = SampleMeshSdfNormalizedDistance(meshSdf, clamp(uvw + vec3(0.0, 0.0, duv.z), vec3(0.0), vec3(1.0))) -
        SampleMeshSdfNormalizedDistance(meshSdf, clamp(uvw - vec3(0.0, 0.0, duv.z), vec3(0.0), vec3(1.0)));
    return vec3(
        dx / max(2.0 * duv.x * localExtent.x, 0.0001),
        dy / max(2.0 * duv.y * localExtent.y, 0.0001),
        dz / max(2.0 * duv.z * localExtent.z, 0.0001));
}

bool AabbIntersects(vec3 aMin, vec3 aMax, vec3 bMin, vec3 bMax)
{
    return all(greaterThanEqual(aMax, bMin)) && all(greaterThanEqual(bMax, aMin));
}

float DistanceToBoundingSphere(vec3 point, vec4 centerRadius)
{
    return max(length(point - centerRadius.xyz) - centerRadius.w, 0.0);
}

float SampleMeshSdf(GPUMeshSdf meshSdf, vec3 worldPosition)
{
    vec3 localPosition = TransformWorldToMeshSdfLocal(meshSdf, worldPosition);
    vec3 localMin = meshSdf.LocalBoundsMinAndVoxelSize.xyz;
    vec3 localExtent = max(meshSdf.LocalBoundsExtentAndInvVoxelSize.xyz, vec3(0.0001));
    vec3 localMax = localMin + localExtent;
    vec3 localToWorldScale = max(meshSdf.LocalToWorldAxisScale.xyz, vec3(0.0001));
    vec3 uvw = (localPosition - localMin) / localExtent;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
    {
        vec3 outside = max(max(localMin - localPosition, localPosition - localMax), vec3(0.0));
        return length(outside * localToWorldScale);
    }

    float normalizedDistance = SampleMeshSdfNormalizedDistance(meshSdf, uvw);
    vec3 localGradient = EstimateMeshSdfLocalGradient(meshSdf, uvw, localExtent);
    float directionalScale = ScaleLocalDistanceToWorld(localGradient, localToWorldScale);
    return DecodeSdfDistance(normalizedDistance, meshSdf.LocalBoundsMinAndVoxelSize.w) * directionalScale;
}

float ComposeGlobalSdfDistance(vec3 worldPosition, uint candidateCount)
{
    float distanceMeters = 1.0e20;
    uint nearestCandidateIndex = candidateCount;
    float nearestCandidateBoundsDistance = 1.0e20;
    for (uint candidateIndex = 0u; candidateIndex < candidateCount; candidateIndex++)
    {
        float boundsDistance = DistanceToBoundingSphere(worldPosition, SharedMeshSdfBoundsCenterRadius[candidateIndex]);
        if (boundsDistance < nearestCandidateBoundsDistance)
        {
            nearestCandidateBoundsDistance = boundsDistance;
            nearestCandidateIndex = candidateIndex;
        }
    }

    if (nearestCandidateIndex < candidateCount)
    {
        distanceMeters = min(
            distanceMeters,
            SampleMeshSdf(ReadMeshSdf(SharedMeshSdfCandidates[nearestCandidateIndex]), worldPosition));
    }

    for (uint candidateIndex = 0u; candidateIndex < candidateCount; candidateIndex++)
    {
        if (candidateIndex == nearestCandidateIndex)
            continue;

        float boundsDistance = DistanceToBoundingSphere(worldPosition, SharedMeshSdfBoundsCenterRadius[candidateIndex]);
        if (boundsDistance >= distanceMeters)
            continue;

        distanceMeters = min(
            distanceMeters,
            SampleMeshSdf(ReadMeshSdf(SharedMeshSdfCandidates[candidateIndex]), worldPosition));
    }

    return distanceMeters;
}

bool AllFullVoxelNeighborsPositive(vec3 worldPosition, uint candidateCount, float voxelSize)
{
    vec3 dx = vec3(voxelSize, 0.0, 0.0);
    vec3 dy = vec3(0.0, voxelSize, 0.0);
    vec3 dz = vec3(0.0, 0.0, voxelSize);
    return
        ComposeGlobalSdfDistance(worldPosition + dx, candidateCount) > 0.0 &&
        ComposeGlobalSdfDistance(worldPosition - dx, candidateCount) > 0.0 &&
        ComposeGlobalSdfDistance(worldPosition + dy, candidateCount) > 0.0 &&
        ComposeGlobalSdfDistance(worldPosition - dy, candidateCount) > 0.0 &&
        ComposeGlobalSdfDistance(worldPosition + dz, candidateCount) > 0.0 &&
        ComposeGlobalSdfDistance(worldPosition - dz, candidateCount) > 0.0;
}

bool HasSurfaceCrossingWithinVoxel(vec3 worldPosition, uint candidateCount, float voxelSize)
{
    float halfVoxel = voxelSize * 0.5;
    vec3 dx = vec3(halfVoxel, 0.0, 0.0);
    vec3 dy = vec3(0.0, halfVoxel, 0.0);
    vec3 dz = vec3(0.0, 0.0, halfVoxel);
    return
        ComposeGlobalSdfDistance(worldPosition + dx, candidateCount) < 0.0 ||
        ComposeGlobalSdfDistance(worldPosition - dx, candidateCount) < 0.0 ||
        ComposeGlobalSdfDistance(worldPosition + dy, candidateCount) < 0.0 ||
        ComposeGlobalSdfDistance(worldPosition - dy, candidateCount) < 0.0 ||
        ComposeGlobalSdfDistance(worldPosition + dz, candidateCount) < 0.0 ||
        ComposeGlobalSdfDistance(worldPosition - dz, candidateCount) < 0.0;
}

float PreserveThinFeatureNegativeCore(vec3 worldPosition, float centerDistance, uint candidateCount)
{
    // Keep a sub-voxel crossing alive in coarse cascades without inflating thick surfaces.
    if (pc.Push.CascadeIndex < GLOBAL_SDF_THIN_FEATURE_FIRST_CASCADE || candidateCount == 0u)
        return centerDistance;

    float voxelSize = pc.Push.WorldMinAndVoxelSize.w;
    if (centerDistance <= 0.0 || centerDistance >= voxelSize * GLOBAL_SDF_THIN_FEATURE_CENTER_BAND_VOXELS)
        return centerDistance;

    if (!AllFullVoxelNeighborsPositive(worldPosition, candidateCount, voxelSize))
        return centerDistance;

    if (!HasSurfaceCrossingWithinVoxel(worldPosition, candidateCount, voxelSize))
        return centerDistance;

    return min(centerDistance, -voxelSize * GLOBAL_SDF_THIN_FEATURE_NEGATIVE_CORE_VOXELS);
}

int PositiveModulo(int value, int divisor)
{
    int result = value % divisor;
    return result < 0 ? result + divisor : result;
}

void main()
{
    uint brickLinear = pc.Push.BrickStartIndex + gl_WorkGroupID.x;
    if (gl_WorkGroupID.x >= pc.Push.BrickCount)
        return;

    uint bricksPerAxis = max(pc.Push.BricksPerAxis, 1u);
    uvec3 brick;
    brick.x = brickLinear % bricksPerAxis;
    brick.y = (brickLinear / bricksPerAxis) % bricksPerAxis;
    brick.z = brickLinear / (bricksPerAxis * bricksPerAxis);

    uvec3 voxel = brick * 8u + gl_LocalInvocationID.xyz;
    if (any(greaterThanEqual(voxel, uvec3(pc.Push.Resolution))))
        return;

    ivec3 physicalBrick = ivec3(brick);
    ivec3 ringOffset = ivec3(pc.Push.RingOffsetX, pc.Push.RingOffsetY, pc.Push.RingOffsetZ);
    int safeBricksPerAxis = int(max(bricksPerAxis, 1u));
    ivec3 logicalBrick = ivec3(
        PositiveModulo(physicalBrick.x - ringOffset.x, safeBricksPerAxis),
        PositiveModulo(physicalBrick.y - ringOffset.y, safeBricksPerAxis),
        PositiveModulo(physicalBrick.z - ringOffset.z, safeBricksPerAxis));
    vec3 brickWorldMin = pc.Push.WorldMinAndVoxelSize.xyz + vec3(logicalBrick * 8) * pc.Push.WorldMinAndVoxelSize.w;
    vec3 brickWorldMax = brickWorldMin + vec3(8.0) * pc.Push.WorldMinAndVoxelSize.w;
    float paddingMeters = pc.Push.WorldMinAndVoxelSize.w * 4.0;
    vec3 brickPadding = vec3(paddingMeters);

    if (gl_LocalInvocationIndex == 0u)
        SharedCandidateCount = 0u;
    barrier();

    for (uint meshSdfIndex = gl_LocalInvocationIndex; meshSdfIndex < pc.Push.MeshSdfCount; meshSdfIndex += 512u)
    {
        GPUMeshSdf meshSdf = ReadMeshSdf(meshSdfIndex);
        vec3 meshCullMin = meshSdf.WorldBoundsMinAndLocalScaleX.xyz - vec3(pc.Push.WorldMinAndVoxelSize.w);
        vec3 meshCullMax = meshSdf.WorldBoundsMaxAndLocalScaleY.xyz + vec3(pc.Push.WorldMinAndVoxelSize.w);
        if (!AabbIntersects(
            brickWorldMin - brickPadding,
            brickWorldMax + brickPadding,
            meshCullMin,
            meshCullMax))
        {
            continue;
        }

        uint candidateOffset = atomicAdd(SharedCandidateCount, 1u);
        if (candidateOffset < GLOBAL_SDF_MAX_BRICK_MESH_CANDIDATES)
        {
            SharedMeshSdfCandidates[candidateOffset] = meshSdfIndex;
            vec3 boundsMin = meshCullMin;
            vec3 boundsMax = meshCullMax;
            vec3 boundsCenter = (boundsMin + boundsMax) * 0.5;
            float boundsRadius = length(boundsMax - boundsMin) * 0.5;
            SharedMeshSdfBoundsCenterRadius[candidateOffset] = vec4(boundsCenter, boundsRadius);
        }
        else
        {
            AddRendererDiagnostic(pc.Push.FrameIndex, GLOBAL_SDF_CANDIDATE_OVERFLOW_COUNTER, 1u);
        }
    }
    barrier();

    uint candidateCount = min(SharedCandidateCount, GLOBAL_SDF_MAX_BRICK_MESH_CANDIDATES);
    if (gl_LocalInvocationIndex == 0u)
    {
        AddRendererDiagnostic(
            pc.Push.FrameIndex,
            candidateCount == 0u ? GLOBAL_SDF_BRICKS_WRITTEN_EMPTY_COUNTER : GLOBAL_SDF_BRICKS_WRITTEN_WITH_CANDIDATES_COUNTER,
            1u);
        uint bricksPerCascade = bricksPerAxis * bricksPerAxis * bricksPerAxis;
        uint candidateHistoryWord = (pc.Push.CascadeIndex * bricksPerCascade + brickLinear) * 2u;
        uint previousCandidateCount = ReadStorageWord(pc.Push.CandidateHistoryBufferIndex, candidateHistoryWord);
        uint previousLogicalBrickSignature = ReadStorageWord(pc.Push.CandidateHistoryBufferIndex, candidateHistoryWord + 1u);
        ivec3 absoluteLogicalBrick = ivec3(pc.Push.LogicalGridMinX, pc.Push.LogicalGridMinY, pc.Push.LogicalGridMinZ) + logicalBrick;
        uint logicalBrickSignature = HashGlobalSdfCandidateHistoryBrick(absoluteLogicalBrick, pc.Push.CascadeIndex);
        if (candidateCount == 0u &&
            previousCandidateCount > 0u &&
            previousLogicalBrickSignature == logicalBrickSignature)
        {
            AddRendererDiagnostic(pc.Push.FrameIndex, GLOBAL_SDF_EMPTY_PREVIOUS_CANDIDATES_COUNTER, 1u);
        }
        WriteStorageWord(pc.Push.CandidateHistoryBufferIndex, candidateHistoryWord, candidateCount);
        WriteStorageWord(pc.Push.CandidateHistoryBufferIndex, candidateHistoryWord + 1u, logicalBrickSignature);
    }
    barrier();

    uvec3 logicalVoxel = uvec3(logicalBrick) * 8u + gl_LocalInvocationID.xyz;
    vec3 worldPosition = pc.Push.WorldMinAndVoxelSize.xyz + (vec3(logicalVoxel) + vec3(0.5)) * pc.Push.WorldMinAndVoxelSize.w;
    float distanceMeters = 1.0e20;
    vec3 distanceToBrickSurface = min(worldPosition - brickWorldMin, brickWorldMax - worldPosition);
    float safeBound = max(0.0, min(distanceToBrickSurface.x, min(distanceToBrickSurface.y, distanceToBrickSurface.z))) + paddingMeters;

    distanceMeters = ComposeGlobalSdfDistance(worldPosition, candidateCount);
    distanceMeters = PreserveThinFeatureNegativeCore(worldPosition, distanceMeters, candidateCount);

    if (candidateCount == 0u || distanceMeters > 1.0e10)
        distanceMeters = safeBound;
    else
        distanceMeters = min(distanceMeters, safeBound);

    float normalizedDistance = EncodeSdfDistance(distanceMeters, pc.Push.WorldMinAndVoxelSize.w);
    imageStore(BindlessStorageImages[pc.Push.OutputTextureIndex], ivec3(voxel), vec4(normalizedDistance, 0.0, 0.0, 0.0));
}
