#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "area_lighting.glsl"

// One workgroup owns an entire 16x16 screen tile and emits all logarithmic
// depth slices. A light is tested against the screen frustum once, then
// appended only to the slices overlapped by its bounding sphere.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform LightCullPushConstantBlock
{
    GPULightCullPushConstants Push;
} pc;

const uint CLUSTER_SLICE_COUNT = FORWARD_CLUSTER_DEPTH_SLICE_COUNT;
const uint CLUSTER_LIGHT_CAPACITY = FORWARD_CLUSTER_MAX_LIGHTS;
const uint CLUSTER_ENTRY_COUNT =
    CLUSTER_SLICE_COUNT * CLUSTER_LIGHT_CAPACITY;

shared uint SharedCandidateCounts[CLUSTER_SLICE_COUNT];
shared uint SharedSelectedCounts[CLUSTER_SLICE_COUNT];
shared uint SharedSelectedLightIndices[CLUSTER_ENTRY_COUNT];
shared float SharedSelectedInfluences[CLUSTER_ENTRY_COUNT];
shared vec4 SharedTilePlanes[4];
shared vec3 SharedClusterCenters[CLUSTER_SLICE_COUNT];

vec3 UnprojectPixel(float pixelX, float pixelY, float depth)
{
    vec2 safeScreen = max(pc.Push.ScreenDimensions, vec2(1.0));
    vec2 ndc = vec2(pixelX, pixelY) / safeScreen * 2.0 - 1.0;
    vec4 world = MulRowMajor(
        vec4(ndc, depth, 1.0),
        pc.Push.InverseViewProjectionMatrix);
    return world.xyz / max(abs(world.w), 0.000001);
}

vec4 BuildPlane(vec3 a, vec3 b, vec3 c, vec3 interiorPoint)
{
    vec3 normal = normalize(cross(b - a, c - a));
    float d = -dot(normal, a);
    if (dot(normal, interiorPoint) + d < 0.0)
    {
        normal = -normal;
        d = -d;
    }

    return vec4(normal, d);
}

float ClusterBoundaryDepth(uint boundaryIndex)
{
    float nearPlane = max(pc.Push.NearPlane, 0.0001);
    float farPlane = max(pc.Push.FarPlane, nearPlane + 0.0001);
    float t = float(boundaryIndex) /
        float(max(pc.Push.ClusterCountZ, 1u));
    return nearPlane * pow(farPlane / nearPlane, t);
}

uint ClusterSliceForDepth(float viewDepth)
{
    float nearPlane = max(pc.Push.NearPlane, 0.0001);
    float farPlane = max(pc.Push.FarPlane, nearPlane + 0.0001);
    float normalized = log(max(viewDepth, nearPlane) / nearPlane) /
        log(farPlane / nearPlane);
    return min(
        uint(clamp(
            floor(normalized * float(pc.Push.ClusterCountZ)),
            0.0,
            float(pc.Push.ClusterCountZ - 1u))),
        pc.Push.ClusterCountZ - 1u);
}

void BuildTileFrustumAndClusterCenters(uvec2 tile)
{
    vec2 screen = max(pc.Push.ScreenDimensions, vec2(1.0));
    vec2 tileMin = vec2(tile * uvec2(
        FORWARD_CLUSTER_TILE_SIZE,
        FORWARD_CLUSTER_TILE_SIZE));
    vec2 tileMax = min(
        tileMin + vec2(FORWARD_CLUSTER_TILE_SIZE),
        screen);
    vec3 camera = pc.Push.CameraPosition;
    vec3 topLeft = UnprojectPixel(tileMin.x, tileMin.y, 0.5);
    vec3 topRight = UnprojectPixel(tileMax.x, tileMin.y, 0.5);
    vec3 bottomRight = UnprojectPixel(tileMax.x, tileMax.y, 0.5);
    vec3 bottomLeft = UnprojectPixel(tileMin.x, tileMax.y, 0.5);
    vec2 tileCenter = (tileMin + tileMax) * 0.5;
    vec3 interior = UnprojectPixel(tileCenter.x, tileCenter.y, 0.5);

    SharedTilePlanes[0] = BuildPlane(camera, bottomLeft, topLeft, interior);
    SharedTilePlanes[1] = BuildPlane(camera, topLeft, topRight, interior);
    SharedTilePlanes[2] = BuildPlane(camera, topRight, bottomRight, interior);
    SharedTilePlanes[3] = BuildPlane(camera, bottomRight, bottomLeft, interior);

    vec3 centerRay = normalize(interior - camera);
    float forwardProjection = max(
        dot(centerRay, normalize(pc.Push.CameraForward)),
        0.0001);
    for (uint slice = 0u; slice < pc.Push.ClusterCountZ; slice++)
    {
        float nearDepth = ClusterBoundaryDepth(slice);
        float farDepth = ClusterBoundaryDepth(slice + 1u);
        float centerDepth = sqrt(nearDepth * farDepth);
        SharedClusterCenters[slice] = camera +
            centerRay * (centerDepth / forwardProjection);
    }
}

bool SphereOverlapsTileFrustum(vec3 center, float radius)
{
    for (int planeIndex = 0; planeIndex < 4; planeIndex++)
    {
        if (dot(
                SharedTilePlanes[planeIndex].xyz,
                center) + SharedTilePlanes[planeIndex].w < -radius)
        {
            return false;
        }
    }
    return true;
}

bool LightCanAffectTile(
    GPULight light,
    out uint minimumSlice,
    out uint maximumSlice)
{
    minimumSlice = 0u;
    maximumSlice = 0u;
    if (light.Type == GPU_LIGHT_TYPE_DIRECTIONAL ||
        light.Range <= 0.0 || light.Intensity <= 0.0)
    {
        return false;
    }

    float radius = light.Range + NjulfAreaBoundingRadius(light);
    if (!SphereOverlapsTileFrustum(light.Position, radius))
        return false;

    float lightDepth = dot(
        light.Position - pc.Push.CameraPosition,
        normalize(pc.Push.CameraForward));
    float nearDepth = lightDepth - radius;
    float farDepth = lightDepth + radius;
    if (farDepth < pc.Push.NearPlane || nearDepth > pc.Push.FarPlane)
        return false;

    minimumSlice = ClusterSliceForDepth(max(nearDepth, pc.Push.NearPlane));
    maximumSlice = ClusterSliceForDepth(min(farDepth, pc.Push.FarPlane));
    return minimumSlice <= maximumSlice;
}

float ComputeLightInfluence(GPULight light, uint slice)
{
    vec3 toLight = light.Position - SharedClusterCenters[slice];
    float centerDistance = length(toLight);
    float distanceToEmitter = max(
        centerDistance - NjulfAreaBoundingRadius(light),
        0.0);
    float distanceSquared = distanceToEmitter * distanceToEmitter;
    float rangeSquared = max(light.Range * light.Range, 0.0001);
    float attenuation = clamp(
        1.0 - distanceSquared / rangeSquared,
        0.0,
        1.0);
    float sourceWeight = NjulfIsAreaLight(light)
        ? NJULF_LTC_PI * NjulfAreaSurfaceArea(light)
        : 1.0;
    float influence = max(light.Intensity, 0.0) * sourceWeight *
        (attenuation * attenuation + 0.000001) /
        max(distanceSquared, 1.0);
    return (isnan(influence) || isinf(influence)) ? 0.0 : influence;
}

bool IsBetterLightCandidate(
    float influence,
    uint lightIndex,
    float otherInfluence,
    uint otherLightIndex)
{
    return influence > otherInfluence ||
        (influence == otherInfluence && lightIndex < otherLightIndex);
}

void InsertDeterministicLightCandidate(
    uint slice,
    uint lightIndex,
    float influence)
{
    uint capacity = min(pc.Push.MaxLightsPerTile, CLUSTER_LIGHT_CAPACITY);
    uint baseEntry = slice * CLUSTER_LIGHT_CAPACITY;
    if (SharedSelectedCounts[slice] < capacity)
    {
        uint slot = SharedSelectedCounts[slice]++;
        SharedSelectedLightIndices[baseEntry + slot] = lightIndex;
        SharedSelectedInfluences[baseEntry + slot] = influence;
    }
    else if (capacity > 0u)
    {
        uint worstSlot = 0u;
        for (uint slot = 1u; slot < capacity; slot++)
        {
            if (IsBetterLightCandidate(
                    SharedSelectedInfluences[baseEntry + worstSlot],
                    SharedSelectedLightIndices[baseEntry + worstSlot],
                    SharedSelectedInfluences[baseEntry + slot],
                    SharedSelectedLightIndices[baseEntry + slot]))
            {
                worstSlot = slot;
            }
        }

        if (IsBetterLightCandidate(
                influence,
                lightIndex,
                SharedSelectedInfluences[baseEntry + worstSlot],
                SharedSelectedLightIndices[baseEntry + worstSlot]))
        {
            SharedSelectedLightIndices[baseEntry + worstSlot] = lightIndex;
            SharedSelectedInfluences[baseEntry + worstSlot] = influence;
        }
    }
}

void FinalizeCluster(uvec2 tile, uint slice)
{
    uint capacity = min(pc.Push.MaxLightsPerTile, CLUSTER_LIGHT_CAPACITY);
    uint candidateCount = SharedCandidateCounts[slice];
    uint selectedCount = min(candidateCount, capacity);
    uint baseEntry = slice * CLUSTER_LIGHT_CAPACITY;

    if (candidateCount > capacity)
    {
        // Saturated clusters pay for deterministic top-K reconciliation. The
        // ordinary path remains one screen-frustum test per light and tile.
        SharedSelectedCounts[slice] = 0u;
        for (uint lightIndex = 0u;
             lightIndex < pc.Push.LightCount;
             lightIndex++)
        {
            GPULight light = ReadLight(lightIndex);
            uint minimumSlice;
            uint maximumSlice;
            if (LightCanAffectTile(light, minimumSlice, maximumSlice) &&
                slice >= minimumSlice && slice <= maximumSlice)
            {
                InsertDeterministicLightCandidate(
                    slice,
                    lightIndex,
                    ComputeLightInfluence(light, slice));
            }
        }
        selectedCount = SharedSelectedCounts[slice];
    }

    for (uint index = 1u; index < selectedCount; index++)
    {
        uint lightIndex = SharedSelectedLightIndices[baseEntry + index];
        float influence = SharedSelectedInfluences[baseEntry + index];
        uint slot = index;
        while (slot > 0u && IsBetterLightCandidate(
                   influence,
                   lightIndex,
                   SharedSelectedInfluences[baseEntry + slot - 1u],
                   SharedSelectedLightIndices[baseEntry + slot - 1u]))
        {
            SharedSelectedLightIndices[baseEntry + slot] =
                SharedSelectedLightIndices[baseEntry + slot - 1u];
            SharedSelectedInfluences[baseEntry + slot] =
                SharedSelectedInfluences[baseEntry + slot - 1u];
            slot--;
        }
        SharedSelectedLightIndices[baseEntry + slot] = lightIndex;
        SharedSelectedInfluences[baseEntry + slot] = influence;
    }

    uint clusterIndex =
        (slice * pc.Push.TileCountY + tile.y) * pc.Push.TileCountX + tile.x;
    uint clusterLightOffset = clusterIndex * pc.Push.MaxLightsPerTile;
    for (uint slot = 0u; slot < selectedCount; slot++)
    {
        WriteTiledLightIndex(
            clusterLightOffset + slot,
            SharedSelectedLightIndices[baseEntry + slot]);
    }
    uint overflowCount = candidateCount > selectedCount
        ? candidateCount - selectedCount
        : 0u;
    WriteTiledLightHeader(
        clusterIndex,
        selectedCount,
        clusterLightOffset,
        overflowCount);
}

void main()
{
    uvec2 tile = gl_WorkGroupID.xy;
    if (tile.x >= pc.Push.TileCountX ||
        tile.y >= pc.Push.TileCountY ||
        pc.Push.ClusterCountZ == 0u ||
        pc.Push.ClusterCountZ > CLUSTER_SLICE_COUNT)
    {
        return;
    }

    uint localIndex = gl_LocalInvocationIndex;
    if (localIndex < pc.Push.ClusterCountZ)
    {
        SharedCandidateCounts[localIndex] = 0u;
        SharedSelectedCounts[localIndex] = 0u;
    }
    if (localIndex == 0u)
        BuildTileFrustumAndClusterCenters(tile);
    barrier();

    for (uint lightIndex = localIndex;
         lightIndex < pc.Push.LightCount;
         lightIndex += gl_WorkGroupSize.x * gl_WorkGroupSize.y)
    {
        GPULight light = ReadLight(lightIndex);
        uint minimumSlice;
        uint maximumSlice;
        if (!LightCanAffectTile(light, minimumSlice, maximumSlice))
            continue;

        for (uint slice = minimumSlice; slice <= maximumSlice; slice++)
        {
            uint slot = atomicAdd(SharedCandidateCounts[slice], 1u);
            if (slot < min(pc.Push.MaxLightsPerTile, CLUSTER_LIGHT_CAPACITY))
            {
                uint entry = slice * CLUSTER_LIGHT_CAPACITY + slot;
                SharedSelectedLightIndices[entry] = lightIndex;
                SharedSelectedInfluences[entry] =
                    ComputeLightInfluence(light, slice);
            }
        }
    }

    barrier();
    if (localIndex < pc.Push.ClusterCountZ)
        FinalizeCluster(tile, localIndex);
}
