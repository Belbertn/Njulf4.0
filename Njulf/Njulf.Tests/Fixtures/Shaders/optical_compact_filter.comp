#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
layout(set=0,binding=0) readonly buffer Input { uint Words[]; } inputData;
layout(set=0,binding=1) buffer Output { uint Words[]; } outputData;
layout(push_constant) uniform Dispatch { uint count; } dispatch;
#define OPTICAL_STORAGE_DEFINED
uint TestOffset(uint b) { return b==0u?0u:inputData.Words[b==1u?10u:11u]; }
uint OpticalWord(uint b,uint w) { return inputData.Words[TestOffset(b)+w]; }
void OpticalStore(uint b,uint w,uint v) { outputData.Words[TestOffset(b)+w]=v; }
void OpticalAddHistoryReuse(uint b) { atomicAdd(outputData.Words[7u],1u); }
struct CompactTestPush { uint Current;uint Previous;uint Step;uint Reset;uint Weighted;uint Bypass;uint Padding0;uint Padding1; };
CompactTestPush pc;
#include "../../../Njulf.Shaders/optical_compact.glsl"
#include "../../../Njulf.Shaders/optical_compact_prepare_kernel.glsl"
#include "../../../Njulf.Shaders/optical_compact_temporal_kernel.glsl"
#include "../../../Njulf.Shaders/optical_compact_spatial_kernel.glsl"
void main() {
 uint index=gl_GlobalInvocationID.x;if(index>=dispatch.count)return;
 pc=CompactTestPush(1u,2u,inputData.Words[9u],inputData.Words[12u],0u,0u,0u,0u);
 ivec2 p=ivec2(index%OcWidth(),index/OcWidth());
 for(uint layer=0u;layer<2u;layer++){uint r=OcRecord(p,layer);for(uint f=0u;f<32u;f++)OpticalStore(1u,r+f,OpticalWord(1u,r+f));}
 if(inputData.Words[8u]==0u)OpticalCompactPreparePixel(p);
 else if(inputData.Words[8u]==1u)OpticalCompactTemporalPixel(p);
 else OpticalCompactSpatialPixel(p);
}
