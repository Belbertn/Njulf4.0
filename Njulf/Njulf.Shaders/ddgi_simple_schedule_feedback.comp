#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Keep the feedback participant definition identical to the transport audit.
// schedule_shared intentionally does not include the larger DDGI shared ABI,
// so mirror the stable public classification value locally.
const uint SIMPLE_DDGI_CLASSIFICATION_INACTIVE = 1u;

#include "ddgi_simple_transport_participant.glsl"

// The fixed feedback dispatch is one 64-lane workgroup. Accumulate one local
// subtotal per lane and merge only those subtotals in shared memory; this
// keeps the exact full-field reduction while avoiding a serial scan of every
// resident probe on lane zero.
const uint SIMPLE_DDGI_FEEDBACK_PENDING_FRESH = 0u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED = 1u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION = 2u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE = 3u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID = 4u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR = 5u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY = 6u;
const uint SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION = 7u;
const uint SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER = 8u;
const uint SIMPLE_DDGI_FEEDBACK_CONVERGED = 9u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE = 10u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE = 11u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE = 12u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE = 13u;
const uint SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE = 14u;
const uint SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS = 15u;
const uint SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY = 16u;
const uint SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED = 17u;
const uint SIMPLE_DDGI_FEEDBACK_PARTICIPANTS = 18u;
const uint SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED = 19u;
const uint SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION = 20u;
const uint SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION = 21u;
const uint SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS = 22u;

shared uint feedbackReduction[SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS];

void main()
{
    uint localIndex = gl_LocalInvocationID.x;
    if (localIndex < SIMPLE_DDGI_FEEDBACK_REDUCTION_WORDS)
        feedbackReduction[localIndex] = 0u;
    barrier();

    // Reduce resident lifecycle state on the GPU. Only this bounded summary is
    // copied to the host; no shipping probe-state readback is required.
    uint pendingFresh = 0u;
    uint pendingExposed = 0u;
    uint pendingRelocation = 0u;
    uint pendingSource = 0u;
    uint pendingSourceInvalidFlag = 0u;
    uint pendingSourcePrivateRepair = 0u;
    uint pendingSourceCardinality = 0u;
    uint pendingSourceGeneration = 0u;
    uint pendingSolver = 0u;
    uint converged = 0u;
    uint maximumFreshAge = 0u;
    uint maximumExposedAge = 0u;
    uint maximumRelocationAge = 0u;
    uint maximumUnpublishedAge = 0u;
    uint maximumVisibleUnsupportedAge = 0u;
    uint visibleParticipants = 0u;
    uint visibleSourceReady = 0u;
    uint visiblePublished = 0u;
    uint participatingCount = 0u;
    uint solveEpochVisitedCount = 0u;
    uint activeSourceMutationCount = 0u;
    uint activeCanonicalMutationCount = 0u;
    uint activeProbeCount = min(SchedulerActiveProbeCount(), 32768u);
    for (uint probeIndex = localIndex;
         probeIndex < activeProbeCount;
         probeIndex += gl_WorkGroupSize.x)
    {
        uint sourceVolumeIndex = 0u;
        bool sourceVolumeValid = SchedulerFindVolume(
            probeIndex,
            sourceVolumeIndex);
        uint physicalProbeIndex;
        uint pageMappingGeneration;
        bool addressPublished;
        // Convergence/cohort denominators are resident-only. This explicit
        // mapping predicate is the authoritative retirement event observed by
        // the fence-complete summary; virtual near-ring capacity is never
        // mistaken for live solver work.
        if (!sourceVolumeValid ||
            !SchedulerResolvePayloadAddressDetailed(
                probeIndex,
                sourceVolumeIndex,
                physicalProbeIndex,
                pageMappingGeneration,
                addressPublished))
        {
            continue;
        }
        uint publicBase = probeIndex * SIMPLE_DDGI_PROBE_STATE_WORDS;
        uint flags = ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 4u);
        uint age = ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 5u);
        uint classification = ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 6u);
        uint privateBase = pc.SchedulerProbeStateOffsetWords +
            probeIndex * SIMPLE_DDGI_SCHEDULER_PROBE_STATE_WORDS;
        uint lastCommittedUpdateFrame = SchedulerArenaRead(privateBase + 0u);
        uint lastCommittedSourceRefreshFrame = SchedulerArenaRead(privateBase + 1u);
        uint metadata = SchedulerArenaRead(privateBase + 5u);
        uint packedLifecycle = SchedulerArenaRead(privateBase + 7u);
        uint sourceRays = packedLifecycle & SIMPLE_DDGI_SCHEDULER_SOURCE_RAY_MASK;
        uint completedTransportGeneration =
            (packedLifecycle & SIMPLE_DDGI_SCHEDULER_TRANSPORT_GENERATION_MASK) >>
            SIMPLE_DDGI_SCHEDULER_TRANSPORT_GENERATION_SHIFT;
        uint stableUpdates =
            (packedLifecycle & SIMPLE_DDGI_SCHEDULER_STABLE_UPDATE_MASK) >>
            SIMPLE_DDGI_SCHEDULER_STABLE_UPDATE_SHIFT;
        uint sourceGeneration = SchedulerArenaRead(privateBase + 2u);
        uint sourceEpoch = SchedulerArenaRead(privateBase + 3u);
        uint volumeGeneration = SchedulerArenaRead(privateBase + 4u);
        uint cacheProbeBaseWordPlusOne = SchedulerArenaRead(privateBase + 10u);
        uint requiredSourceRays = sourceVolumeValid
            ? clamp(
                SchedulerVolumeFullRays(sourceVolumeIndex),
                1u,
                SIMPLE_DDGI_SCHEDULER_MAX_RAYS)
            : 0u;
        bool visible = (metadata & SIMPLE_DDGI_SCHEDULER_PROBE_META_VISIBLE) != 0u;
        bool published = addressPublished;
        bool inactive = classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE ||
            (flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ||
            uintBitsToFloat(ReadStorageWordUniform(pc.ProbeStateBufferIndex, publicBase + 3u)) <= 0.001;
        bool sourceReady = SchedulerTransportV2() && sourceVolumeValid &&
            SimpleDdgiTransportSourceReady(
                flags,
                sourceRays,
                requiredSourceRays,
                sourceGeneration,
                SchedulerSourceGeneration(),
                sourceEpoch,
                volumeGeneration,
                SchedulerVolumeGeneration(),
                metadata,
                cacheProbeBaseWordPlusOne);
        bool hasFresh = (flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u;
        bool hasExposed = (flags & SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED) != 0u;
        bool hasRelocation = (flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u;
        // The certificate covers the complete active transport field. Camera
        // visibility remains a priority/telemetry signal and never changes the
        // participant denominator.
        bool participating = SimpleDdgiTransportParticipantEligible(
            SchedulerTransportV2(),
            true,
            addressPublished,
            classification,
            flags,
            uintBitsToFloat(ReadStorageWordUniform(
                pc.ProbeStateBufferIndex,
                publicBase + 3u)),
            sourceRays,
            requiredSourceRays,
            sourceGeneration,
            SchedulerSourceGeneration(),
            sourceEpoch,
            volumeGeneration,
            SchedulerVolumeGeneration(),
            metadata,
            cacheProbeBaseWordPlusOne);
        participatingCount += participating ? 1u : 0u;
        activeSourceMutationCount += participating &&
            lastCommittedSourceRefreshFrame == SchedulerFrameIndex()
                ? 1u
                : 0u;
        activeCanonicalMutationCount += participating &&
            lastCommittedUpdateFrame == SchedulerFrameIndex()
                ? 1u
                : 0u;
        uint lastSolveEpoch = SchedulerArenaRead(privateBase + 9u);
        bool solveEpochVisited = participating &&
            SchedulerTailCertification() &&
            SchedulerSolveEpoch() != 0u &&
            lastSolveEpoch == SchedulerSolveEpoch();
        solveEpochVisitedCount += solveEpochVisited ? 1u : 0u;
        bool solverReady = SchedulerTailCertification()
            ? sourceReady &&
                lastSolveEpoch == SchedulerSolveEpoch() &&
                SchedulerSolveEpoch() != 0u
            : sourceReady &&
                completedTransportGeneration == (SchedulerTransportGeneration() & 0xffu) &&
                stableUpdates >= max(SchedulerFrame(30u), 1u);
        bool hasUnpublished = visible && participating && !published;

        // These fixed feedback words are control-plane blockers, not broad
        // lifecycle diagnostics. Match classify's pending-tail-source rule:
        // transient bits on an inactive/excluded probe cannot keep the frozen
        // active participant transaction in SourceRepair forever.
        pendingFresh += !inactive && hasFresh ? 1u : 0u;
        pendingExposed += !inactive && hasExposed ? 1u : 0u;
        pendingRelocation += !inactive && hasRelocation ? 1u : 0u;
        // Source repair is counted over every active slot, independently of
        // whether it is eligible for the frozen audit denominator.
        pendingSource += SchedulerTransportV2() && !inactive && !sourceReady ? 1u : 0u;
        pendingSourceInvalidFlag += !inactive &&
            (flags & SIMPLE_DDGI_PROBE_FLAG_SOURCE_CACHE_INVALID) != 0u
                ? 1u
                : 0u;
        pendingSourcePrivateRepair += !inactive &&
            (metadata & SIMPLE_DDGI_SCHEDULER_PROBE_META_REPAIR) != 0u
                ? 1u
                : 0u;
        pendingSourceCardinality += !inactive &&
            (!sourceVolumeValid || sourceRays != requiredSourceRays)
                ? 1u
                : 0u;
        pendingSourceGeneration += !inactive &&
            sourceGeneration != SchedulerSourceGeneration()
                ? 1u
                : 0u;
        pendingSolver += SchedulerTransportV2() && participating && sourceReady && !solverReady ? 1u : 0u;
        maximumFreshAge = max(
            maximumFreshAge,
            !inactive && hasFresh ? age : 0u);
        maximumExposedAge = max(
            maximumExposedAge,
            !inactive && hasExposed ? age : 0u);
        maximumRelocationAge = max(
            maximumRelocationAge,
            !inactive && hasRelocation ? age : 0u);
        maximumUnpublishedAge = max(maximumUnpublishedAge, hasUnpublished ? age : 0u);
        maximumVisibleUnsupportedAge = max(
            maximumVisibleUnsupportedAge,
            visible && (flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ? age : 0u);
        if (visible && participating)
        {
            visibleParticipants++;
            visibleSourceReady += sourceReady ? 1u : 0u;
            visiblePublished += published && !hasFresh && !hasExposed &&
                !hasRelocation ? 1u : 0u;
        }
        if (solverReady && !hasFresh && !hasExposed && !hasRelocation)
            converged++;
    }

    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_FRESH], pendingFresh);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED], pendingExposed);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION], pendingRelocation);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE], pendingSource);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID], pendingSourceInvalidFlag);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR], pendingSourcePrivateRepair);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY], pendingSourceCardinality);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION], pendingSourceGeneration);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER], pendingSolver);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_CONVERGED], converged);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE], maximumFreshAge);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE], maximumExposedAge);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE], maximumRelocationAge);
    atomicMax(feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE], maximumUnpublishedAge);
    atomicMax(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE],
        maximumVisibleUnsupportedAge);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS],
        visibleParticipants);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY],
        visibleSourceReady);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED],
        visiblePublished);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_PARTICIPANTS], participatingCount);
    atomicAdd(feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED], solveEpochVisitedCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION],
        activeSourceMutationCount);
    atomicAdd(
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION],
        activeCanonicalMutationCount);
    barrier();

    if (localIndex != 0u)
        return;

    pendingFresh = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_FRESH];
    pendingExposed = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_EXPOSED];
    pendingRelocation = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_RELOCATION];
    pendingSource = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOURCE];
    pendingSourceInvalidFlag = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_INVALID];
    pendingSourcePrivateRepair = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_REPAIR];
    pendingSourceCardinality = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_CARDINALITY];
    pendingSourceGeneration = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOURCE_GENERATION];
    pendingSolver = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PENDING_SOLVER];
    converged = feedbackReduction[SIMPLE_DDGI_FEEDBACK_CONVERGED];
    maximumFreshAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_FRESH_AGE];
    maximumExposedAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_EXPOSED_AGE];
    maximumRelocationAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_RELOCATION_AGE];
    maximumUnpublishedAge = feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_UNPUBLISHED_AGE];
    maximumVisibleUnsupportedAge =
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_MAX_VISIBLE_UNSUPPORTED_AGE];
    visibleParticipants = feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PARTICIPANTS];
    visibleSourceReady = feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_SOURCE_READY];
    visiblePublished = feedbackReduction[SIMPLE_DDGI_FEEDBACK_VISIBLE_PUBLISHED];
    participatingCount = feedbackReduction[SIMPLE_DDGI_FEEDBACK_PARTICIPANTS];
    solveEpochVisitedCount = feedbackReduction[SIMPLE_DDGI_FEEDBACK_SOLVE_VISITED];
    activeSourceMutationCount =
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_SOURCE_MUTATION];
    activeCanonicalMutationCount =
        feedbackReduction[SIMPLE_DDGI_FEEDBACK_ACTIVE_CANONICAL_MUTATION];

    uint considered = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_CONSIDERED);
    uint eligible = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ELIGIBLE);
    uint accepted = min(
        SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ACCEPTED),
        SchedulerRequestCapacity());
    uint committed = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_COMMITTED);
    uint published = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_PUBLISHED);
    uint rejected = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_REJECTED);
    uint primaryUsed = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_PRIMARY_USED);
    uint sourceUsed = SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_USED);
    uint transportUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_TRANSPORT_USED);
    uint sourceProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_SOURCE_PROBE_USED);
    uint hardSourceProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_HARD_SOURCE_PROBE_USED);
    uint routineSourceProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_ROUTINE_SOURCE_PROBE_USED);
    uint cachedSolverProbeUsed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_CACHED_SOLVER_PROBE_USED);
    uint targetSource = SchedulerSourceTargetRays();

    pendingSource = max(
        pendingSource,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_PENDING_TAIL_SOURCE));
    bool sourceCohortIncomplete = SchedulerTransportV2() && pendingSource != 0u;
    uint staticConvergedGeneration =
        !sourceCohortIncomplete && pendingSolver == 0u
            ? SchedulerSourceGeneration()
            : 0u;

    uint base = pc.FeedbackOffsetWords;
    SchedulerArenaWrite(base + 0u, SchedulerFrame(12u));
    SchedulerArenaWrite(base + 1u, SchedulerFrame(13u));
    SchedulerArenaWrite(base + 2u, SchedulerVolumeGeneration());
    SchedulerArenaWrite(base + 3u, SchedulerResourceGeneration());
    SchedulerArenaWrite(base + 4u, SchedulerQueueGeneration());
    SchedulerArenaWrite(base + 5u, SchedulerSourceGeneration());
    SchedulerArenaWrite(base + 6u, SchedulerTransportGeneration());
    uint status = 0u;
    if (SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW) != 0u)
        status |= 1u;
    if (SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION) != 0u)
        status |= 2u;
    SchedulerArenaWrite(base + 7u, status);
    SchedulerArenaWrite(base + 8u, considered);
    SchedulerArenaWrite(base + 9u, eligible);
    SchedulerArenaWrite(base + 10u, accepted);
    SchedulerArenaWrite(base + 11u, committed);
    SchedulerArenaWrite(base + 12u, rejected);
    SchedulerArenaWrite(base + 13u, SchedulerRequestBudget());
    SchedulerArenaWrite(base + 14u, accepted);
    SchedulerArenaWrite(base + 15u, SchedulerPrimaryRayBudget());
    SchedulerArenaWrite(base + 16u, primaryUsed);
    SchedulerArenaWrite(base + 17u, targetSource);
    SchedulerArenaWrite(base + 18u, sourceUsed);
    SchedulerArenaWrite(base + 19u, targetSource > sourceUsed ? targetSource - sourceUsed : 0u);
    SchedulerArenaWrite(base + 20u,
        SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_INVALID_GENERATION));
    SchedulerArenaWrite(base + 21u, transportUsed);
    SchedulerArenaWrite(base + 22u,
        SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW));
    SchedulerArenaWrite(base + 23u,
        SchedulerArenaRead(pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_COMMIT_REJECTED));
    SchedulerArenaWrite(base + 24u, pendingFresh);
    SchedulerArenaWrite(base + 25u, pendingExposed);
    SchedulerArenaWrite(base + 26u, pendingRelocation);
    SchedulerArenaWrite(base + 27u, pendingSource);
    SchedulerArenaWrite(base + 28u, pendingSolver);
    SchedulerArenaWrite(base + 29u, converged);
    SchedulerArenaWrite(base + 30u, maximumFreshAge);
    SchedulerArenaWrite(base + 31u, maximumExposedAge);
    SchedulerArenaWrite(base + 32u, maximumRelocationAge);
    SchedulerArenaWrite(base + 33u, maximumUnpublishedAge);
    SchedulerArenaWrite(base + 34u, maximumVisibleUnsupportedAge);
    SchedulerArenaWrite(base + 35u, sourceCohortIncomplete ? SchedulerFrameIndex() : 0u);
    SchedulerArenaWrite(base + 36u, sourceCohortIncomplete ? 0u : SchedulerFrameIndex());
    SchedulerArenaWrite(base + 37u, sourceCohortIncomplete ? targetSource : 0u);
    SchedulerArenaWrite(base + 38u, sourceCohortIncomplete ? 0u : sourceUsed);
    SchedulerArenaWrite(base + 39u, SchedulerTransportGeneration());
    SchedulerArenaWrite(base + 40u,
        pendingSolver == 0u ? SchedulerTransportGeneration() : 0u);
    SchedulerArenaWrite(base + 41u, staticConvergedGeneration);
    SchedulerArenaWrite(base + 42u, sourceCohortIncomplete || pendingSolver != 0u ? 1u : 0u);
    SchedulerArenaWrite(base + 43u, hardSourceProbeUsed);
    SchedulerArenaWrite(base + 44u, routineSourceProbeUsed);
    SchedulerArenaWrite(base + 45u, cachedSolverProbeUsed);
    // Exact source-repair attribution replaces two retired dirty-latency
    // placeholders in the fixed feedback ABI. These counts distinguish a
    // public cache marker from a transaction-private resident repair without
    // any per-ray diagnostics or additional readback memory.
    SchedulerArenaWrite(
        base + 46u,
        min(pendingSourceInvalidFlag, 0xffffu) |
            (min(pendingSourceCardinality, 0xffffu) << 16u));
    SchedulerArenaWrite(
        base + 47u,
        min(pendingSourcePrivateRepair, 0xffffu) |
            (min(pendingSourceGeneration, 0xffffu) << 16u));
    for (uint bucket = 0u; bucket < 6u; bucket++)
        SchedulerArenaWrite(base + 48u + bucket,
            SchedulerArenaRead(pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_BUCKET_BASE + bucket));
    uint dispatchedLanes = 0u;
    uint noOpLanes = 0u;
    if (!SchedulerCertifiedQuiesced())
    {
        // Lane-base publishes non-empty lane ids in LaneTotals. Walking that
        // compact list preserves the exact dispatched/no-op definitions while
        // avoiding a second full 896-lane diagnostic scan.
        for (uint activeIndex = 0u;
             activeIndex < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             activeIndex++)
        {
            uint lane = SchedulerArenaRead(
                pc.LaneTotalsOffsetWords + activeIndex);
            if (lane == SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
                break;
            uint admission = SchedulerArenaRead(pc.LaneAdmissionOffsetWords + lane);
            dispatchedLanes++;
            noOpLanes += admission == 0u ? 1u : 0u;
        }
    }
    SchedulerArenaWrite(base + 54u, dispatchedLanes);
    SchedulerArenaWrite(base + 55u, noOpLanes);
    SchedulerArenaWrite(base + 56u, visibleParticipants);
    SchedulerArenaWrite(base + 57u, visibleSourceReady);
    SchedulerArenaWrite(base + 58u, visiblePublished);
    SchedulerArenaWrite(base + 59u, participatingCount);
    SchedulerArenaWrite(base + 60u, solveEpochVisitedCount);
    SchedulerArenaWrite(base + 61u, SchedulerSolveEpoch());
    SchedulerArenaWrite(base + 62u, sourceProbeUsed);
    SchedulerArenaWrite(base + 63u, published);
    // Feedback reserves the words after the fixed 64-word summary for the
    // persistent rotating lane cursors. They are copied only after the
    // summary generation/serial has been validated by the host.
    if (!SchedulerCertifiedQuiesced())
    {
        for (uint lane = 0u;
             lane < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             lane++)
        {
            SchedulerArenaWrite(
                base + 64u + lane,
                SchedulerArenaRead(pc.LaneCursorsOffsetWords + lane));
        }
    }
    for (uint category = 0u;
         category < SIMPLE_DDGI_SCHEDULER_COMMIT_FAILURE_CATEGORY_COUNT;
         category++)
    {
        SchedulerArenaWrite(
            base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_COMMIT_FAILURE_OFFSET +
                category,
            SchedulerArenaRead(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_COMMIT_FAILURE_BASE +
                    category));
    }
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_TRANSACTION_PREDICATE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_TRANSACTION_PREDICATE_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_MISSING_COMPLETION_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_MISSING_COMPLETION_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_PRODUCER_FAILURE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_PRODUCER_FAILURE_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_CACHE_READ_FAILURE_OFFSET,
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_CACHE_READ_FAILURE_MASK));
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ACTIVE_SOURCE_MUTATION_OFFSET,
        activeSourceMutationCount);
    SchedulerArenaWrite(
        base + SIMPLE_DDGI_SCHEDULER_FEEDBACK_ACTIVE_CANONICAL_MUTATION_OFFSET,
        activeCanonicalMutationCount);
}
