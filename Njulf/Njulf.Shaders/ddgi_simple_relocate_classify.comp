#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint TransportGeneration;
    uint PrimaryDirectionalLightIndex;
    uint DispatchQueueOffset;
    uint DispatchProbeCount;
    uint DispatchRaysPerProbe;
    uint SchedulerArenaBufferIndex;
    uint SchedulerRayBucketIndex;
    uint SchedulerRayBucketCommandsOffsetWords;
    uint SchedulerRayBucketMetadataOffsetWords;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerUpdateRecordsOffsetWords;
} pc;

const float SIMPLE_DDGI_RELOCATION_TARGET_DISTANCE = 0.10;
const float SIMPLE_DDGI_RELOCATION_MAX_DISTANCE =
    SIMPLE_DDGI_RELOCATION_UPDATE_MAX_SPACINGS;
const float SIMPLE_DDGI_RELOCATION_MIN_BACKFACE_RATIO = 0.10;

void WriteRelocationClassification(
    uint probeIndex,
    vec3 relocation,
    float relocationDistance,
    float activeWeight,
    float softInvalidScore,
    float hardInvalidScore,
    float closeRatio,
    float backfaceRatio,
    float nearestHitDistance,
    float missRatio,
    float hitRatio)
{
    uint baseWord = probeIndex * SIMPLE_DDGI_RELOCATION_CLASSIFICATION_STRIDE_WORDS;
    WriteStorageVec4Uniform(pc.RelocationClassificationBufferIndex, baseWord, vec4(relocation, relocationDistance));
    WriteStorageVec4Uniform(pc.RelocationClassificationBufferIndex, baseWord + 4u, vec4(activeWeight, softInvalidScore, closeRatio, backfaceRatio));
    // Statistics.z was previously unused. Keeping the hard score alongside the
    // raw ratios makes the production classifier observable without changing
    // the 48-byte ABI consumed by debug tooling and readback.
    WriteStorageVec4Uniform(pc.RelocationClassificationBufferIndex, baseWord + 8u, vec4(nearestHitDistance, missRatio, hardInvalidScore, hitRatio));
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint queueOffset = gl_GlobalInvocationID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint requestCount = gpuScheduler
        ? SimpleDdgiSchedulerAcceptedCount(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerCountersOffsetWords)
        : params.probesToUpdate;
    if (queueOffset >= requestCount || params.probeCount == 0u)
        return;

    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, queueOffset);
    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    if (!SimpleDdgiUpdateMatchesLiveAddress(params, update))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    SimpleDdgiProbeState previous = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
            params,
            update,
            previous))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    uint missCount = 0u;
    uint hitCount = 0u;
    uint backfaceCount = 0u;
    uint closeCount = 0u;
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    uint sourceRayCount = SimpleDdgiUpdateSourceRayCount(update, params);
    float nearestHitDistance = 3.402823466e+38;
    float nearestBackfaceDistance = 3.402823466e+38;
    vec3 nearestBackfaceDirection = vec3(0.0);
    float closeDistance = max(volume.spacing * 0.25, 0.001);

    for (uint ray = 0u; ray < activeRayCount; ray++)
    {
        uint rayResultIndex = queueOffset * params.raysPerProbe + ray;
        uint directionRayIndex = SimpleDdgiUpdateDirectionRayIndex(
            ray,
            activeRayCount,
            sourceRayCount,
            params);
        vec4 radianceDistance;
        vec3 direction;
        vec2 visibilityHit;
        uint directionEpoch;
        if (!ReadSimpleDdgiRayResultStorage(
                pc.RayResultScratchBufferIndex,
                rayResultIndex,
                volume,
                params,
                probeIndex,
                directionRayIndex,
                update.sourceEpoch,
                radianceDistance,
                direction,
                visibilityHit,
                directionEpoch))
        {
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 1u);
            return;
        }
        float hitKind = visibilityHit.y;
        // Use the same nearest two-sided distance that receiver visibility saw.
        // Source radiance remains frontface-only, but a close covered backface
        // is valid geometric evidence that this probe needs relocation.
        float distance = max(visibilityHit.x, 0.0);
        direction = normalize(direction);

        if (hitKind < 0.5)
        {
            missCount++;
            continue;
        }

        hitCount++;
        nearestHitDistance = min(nearestHitDistance, distance);
        if (distance <= closeDistance)
            closeCount++;

        // Only an authored one-sided reverse face is evidence that the probe is
        // embedded. Far-field voxels are closed, coarse occupancy and their
        // reconstructed normal is not reliable enough to classify a probe.
        bool solidBackface =
            abs(hitKind - SIMPLE_DDGI_RAY_HIT_KIND_ONE_SIDED_BACK_FACE) < 0.25;
        if (solidBackface)
        {
            backfaceCount++;
            if (distance < nearestBackfaceDistance)
            {
                nearestBackfaceDistance = distance;
                nearestBackfaceDirection = direction;
            }
        }
    }

    float rayCount = max(float(activeRayCount), 1.0);
    float missRatio = float(missCount) / rayCount;
    float hitRatio = float(hitCount) / rayCount;
    float backfaceRatio = float(backfaceCount) / rayCount;
    float closeRatio = float(closeCount) / rayCount;
    // Backface orientation is only reliable evidence that a probe is embedded
    // when the surface is locally reachable. Architectural assets commonly use
    // one-sided shells, so distant backfaces must not accumulate a max-distance
    // relocation or classify an otherwise open probe as inactive.
    float backfaceProximity = nearestBackfaceDistance < 3.0e+38
        ? 1.0 - smoothstep(volume.spacing * 0.25, volume.spacing * SIMPLE_DDGI_RELOCATION_MAX_DISTANCE, nearestBackfaceDistance)
        : 0.0;
    float localBackfaceRatio = backfaceRatio * backfaceProximity;
    float softInvalidProbeScore = max(
        smoothstep(0.25, 0.45, closeRatio),
        smoothstep(0.40, 0.60, localBackfaceRatio));
    float hardInvalidProbeScore = max(
        smoothstep(0.70, 0.90, closeRatio),
        smoothstep(0.55, 0.75, localBackfaceRatio));
    // Distance is useful for relocation, but not for recognizing a probe that
    // is deeply enclosed by one-sided geometry. Such probes see almost all
    // reverse faces and no escape directions. An open probe behind a distant
    // shell still resolves front faces or sky misses and therefore fails this
    // enclosure test.
    float enclosureScore =
        smoothstep(0.60, 0.85, backfaceRatio) *
        (1.0 - smoothstep(0.0, 0.05, missRatio));
    hardInvalidProbeScore = max(hardInvalidProbeScore, enclosureScore);
    bool maintenanceUpdate = SimpleDdgiUpdateIsMaintenance(update);

    float previousActive = clamp(previous.activeWeight, 0.0, 1.0);
    float hardInvalid = smoothstep(0.75, 0.95, hardInvalidProbeScore);
    float activeFloor = (volume.kind == SIMPLE_DDGI_VOLUME_KIND_AUTHORED || hardInvalidProbeScore >= 0.95) ? 0.0 : 0.35;
    float targetActive = max(1.0 - hardInvalid, activeFloor);
    float stateBlendAlpha = (update.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u ? 1.0 : 0.12;
    if (targetActive > previousActive)
        stateBlendAlpha = max(stateBlendAlpha, 0.35);
    float activeWeight = maintenanceUpdate
        ? previousActive
        : mix(previousActive, targetActive, stateBlendAlpha);

    // Relocation is persistent state. Absence of new backface evidence means
    // "keep the committed free-space position", not "return to the logical
    // position"; invalidation/scroll explicitly resets stale relocation.
    vec3 targetRelocation = previous.relocation;
    float maximumActionableBackfaceDistance = volume.spacing *
        (SIMPLE_DDGI_RELOCATION_MAX_DISTANCE - SIMPLE_DDGI_RELOCATION_TARGET_DISTANCE);
    if (!maintenanceUpdate &&
        backfaceRatio >= SIMPLE_DDGI_RELOCATION_MIN_BACKFACE_RATIO &&
        nearestBackfaceDistance <= maximumActionableBackfaceDistance)
    {
        float targetSurfaceDistance = volume.spacing * SIMPLE_DDGI_RELOCATION_TARGET_DISTANCE;
        // The hit distance reaches the exit surface from the already-relocated
        // trace origin. Move past that surface by a spacing-relative margin;
        // subtracting the hit distance can never escape embedded geometry.
        float targetDistance = clamp(
            nearestBackfaceDistance + targetSurfaceDistance,
            0.0,
            volume.spacing * SIMPLE_DDGI_RELOCATION_MAX_DISTANCE);
        targetRelocation = previous.relocation + nearestBackfaceDirection * targetDistance;
    }

    float targetRelocationLength = length(targetRelocation);
    float previousRelocationLength = length(previous.relocation);
    float relocationAlpha = (update.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u
        ? 1.0
        : (targetRelocationLength > previousRelocationLength ? 0.15 : 0.05);
    vec3 blendedRelocation = maintenanceUpdate
        ? previous.relocation
        : mix(previous.relocation, targetRelocation, relocationAlpha);
    float maxRelocation = volume.spacing * SIMPLE_DDGI_RELOCATION_MAX_DISTANCE;
    float relocationLength = length(blendedRelocation);
    if (relocationLength > maxRelocation)
        blendedRelocation *= maxRelocation / max(relocationLength, 0.00001);

    // Trace consumed previous.relocation, while forward gathering will consume
    // blendedRelocation. Publishing this frame's rays after a material move would
    // therefore attach transport sampled at the old origin to the new origin.
    // Stage the committed position behind a pending flag and require a later
    // full-ray update to validate it. Maintenance work is deliberately unable to
    // retire the pending state even if it happens to run before CPU readback.
    float relocationDelta = length(blendedRelocation - previous.relocation);
    // Per-frame ray rotation introduces small target jitter. Only re-arm the
    // trace transaction for a material origin change, not estimator noise.
    bool relocationChanged = relocationDelta > max(volume.spacing * 0.02, 0.005);
    bool relocationWasPending =
        (previous.flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u;
    bool relocationTimedOut = relocationWasPending &&
        SimpleDdgiUpdateAge(update) >= SIMPLE_DDGI_RELOCATION_PENDING_MAX_RETRY_AGE;

    SimpleDdgiProbeState state;
    state.relocation = blendedRelocation;
    state.activeWeight = activeWeight;
    state.flags = previous.flags & ~(
        SIMPLE_DDGI_PROBE_FLAG_FRESH |
        SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED |
        SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING);
    if (!relocationTimedOut &&
        (relocationChanged || (relocationWasPending && maintenanceUpdate)))
    {
        state.flags |= SIMPLE_DDGI_PROBE_FLAG_FRESH |
            SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING;
    }
    else if (relocationWasPending && !relocationTimedOut)
    {
        // The full retry was traced from the committed relocation. Keep FRESH
        // through relocation so blend resets history, then let blend publish and
        // clear it only after all atlas writes have completed.
        state.flags |= SIMPLE_DDGI_PROBE_FLAG_FRESH;
    }
    // A probe that cannot retire relocation in a bounded interval becomes a
    // normal inactive retry candidate. It no longer blocks publication forever;
    // the CPU's periodic inactive retry can reactivate it when geometry evidence
    // becomes usable.
    // Classification must be reachable independently of the clipmap support
    // floor above. Otherwise scores in [0.75, 0.95) can never become inactive:
    // their active weight is clamped to at least 0.35 before this test.
    bool inactiveProbe = relocationTimedOut || (maintenanceUpdate
        ? previous.classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE
        : hardInvalidProbeScore >= 0.75);
    if (inactiveProbe)
        state.activeWeight = 0.0;
    if (inactiveProbe)
        state.flags |= SIMPLE_DDGI_PROBE_FLAG_INACTIVE;
    else
        state.flags &= ~SIMPLE_DDGI_PROBE_FLAG_INACTIVE;
    // Relocation changes the world-space meaning of every visibility moment,
    // and inactive probes must never retain receiver-valid payload authority.
    if (relocationChanged || relocationWasPending || inactiveProbe)
        state.flags &= ~SIMPLE_DDGI_PROBE_FLAG_VISIBILITY_VALID;
    state.age = 0u;
    state.classification = inactiveProbe ? SIMPLE_DDGI_CLASSIFICATION_INACTIVE : SIMPLE_DDGI_CLASSIFICATION_ACTIVE;
    state.luminanceChangeEma = previous.luminanceChangeEma;
    if (gpuScheduler)
    {
        // Relocation/classification is a transaction-private proposal. Commit
        // is the first stage allowed to touch the public probe record.
        // Emit has already copied this accepted record to the public queue.
        // Reuse its scheduler-arena words as transaction-private proposal
        // storage; the public relocation-classification buffer remains a V1
        // diagnostic output only.
        uint proposalBase = pc.SchedulerUpdateRecordsOffsetWords +
            update.outcomeIndex * SIMPLE_DDGI_SCHEDULER_UPDATE_RECORD_WORDS;
        WriteStorageFloatUniform(pc.SchedulerArenaBufferIndex, proposalBase + 0u,
            state.relocation.x);
        WriteStorageFloatUniform(pc.SchedulerArenaBufferIndex, proposalBase + 1u,
            state.relocation.y);
        WriteStorageFloatUniform(pc.SchedulerArenaBufferIndex, proposalBase + 2u,
            state.relocation.z);
        WriteStorageFloatUniform(pc.SchedulerArenaBufferIndex, proposalBase + 3u,
            state.activeWeight);
        WriteStorageWordUniform(pc.SchedulerArenaBufferIndex, proposalBase + 4u,
            state.flags);
        WriteStorageWordUniform(pc.SchedulerArenaBufferIndex, proposalBase + 5u,
            state.classification);
        WriteStorageWordUniform(pc.SchedulerArenaBufferIndex, proposalBase + 6u,
            floatBitsToUint(max(state.luminanceChangeEma, 0.0)));
    }
    else
        WriteSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex, state);

    float nearestDistance = nearestHitDistance < 3.0e+38 ? nearestHitDistance : 0.0;
    if (!gpuScheduler)
    {
        WriteRelocationClassification(
            probeIndex,
            blendedRelocation,
            length(blendedRelocation),
            state.activeWeight,
            softInvalidProbeScore,
            hardInvalidProbeScore,
            closeRatio,
            backfaceRatio,
            nearestDistance,
            missRatio,
            hitRatio);
    }
    else
        SimpleDdgiSchedulerCompleteSingle(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 1u);
}
