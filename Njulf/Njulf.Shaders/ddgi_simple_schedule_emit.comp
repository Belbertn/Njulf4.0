#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint EmitBucketCount = 6u;

uint EmitBucketScratchWord(uint groupIndex, uint bucket)
{
    return pc.CandidateGroupLaneCountsOffsetWords +
        groupIndex * EmitBucketCount + bucket;
}

void main()
{
    if (gl_GlobalInvocationID.x != 0u)
        return;

    // Reset leaves every consumer command at x=0. An overflow is a failed
    // transaction, not a partial schedule: do not publish indirect work.
    if (SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW) != 0u)
    {
        return;
    }

    uint accepted = min(
        SchedulerArenaRead(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_ACCEPTED),
        SchedulerRequestCapacity());
    uint groupCount = SchedulerGroupsFor(accepted);
    uint bucketOffset = 0u;

    // Convert the fixed six counters per workgroup into stable exclusive
    // prefixes. This scans O(6 * workgroups), rather than rereading every
    // accepted update once for every bucket.
    for (uint bucket = 0u; bucket < EmitBucketCount; bucket++)
    {
        uint bucketCount = 0u;
        for (uint group = 0u; group < groupCount; group++)
        {
            uint scratchWord = EmitBucketScratchWord(group, bucket);
            uint groupBucketCount = SchedulerArenaRead(scratchWord);
            SchedulerArenaWrite(scratchWord, bucketCount);
            bucketCount += groupBucketCount;
        }

        SchedulerArenaWrite(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_BUCKET_BASE + bucket,
            bucketCount);

        uint rayCount = SchedulerFrame(32u + bucket);
        uint metadataBase = pc.RayBucketMetadataOffsetWords +
            bucket * SIMPLE_DDGI_SCHEDULER_RAY_BUCKET_METADATA_WORDS;
        SchedulerArenaWrite(metadataBase + 0u, bucketOffset);
        SchedulerArenaWrite(metadataBase + 1u, bucketCount);
        SchedulerArenaWrite(metadataBase + 2u, rayCount);
        SchedulerArenaWrite(metadataBase + 3u, 0u);
        bucketOffset += bucketCount;
    }

    uint classifiedUnbucketed = SchedulerArenaRead(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_UNBUCKETED);
    uint derivedUnbucketed = accepted > bucketOffset
        ? accepted - bucketOffset
        : 0u;
    uint unbucketed = max(classifiedUnbucketed, derivedUnbucketed);
    SchedulerArenaWrite(
        pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_UNBUCKETED,
        unbucketed);
    if (unbucketed != 0u || bucketOffset != accepted)
    {
        // Reset left every producer/consumer command inert. Export feedback so
        // the host can name this exact fallback, but publish no queue consumer
        // that could observe a stale tail record.
        SchedulerArenaWrite(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_EMISSION_FAILURE,
            1u);
        SchedulerWriteIndirect(
            SIMPLE_DDGI_SCHEDULER_DISPATCH_FEEDBACK,
            1u,
            1u,
            1u);
        return;
    }

    for (uint bucket = 0u; bucket < EmitBucketCount; bucket++)
    {
        uint metadataBase = pc.RayBucketMetadataOffsetWords +
            bucket * SIMPLE_DDGI_SCHEDULER_RAY_BUCKET_METADATA_WORDS;
        uint bucketCount = SchedulerArenaRead(metadataBase + 1u);
        uint rayCount = SchedulerArenaRead(metadataBase + 2u);
        uint commandBase = pc.RayBucketCommandsOffsetWords +
            bucket * SIMPLE_DDGI_SCHEDULER_RAY_BUCKET_COMMAND_WORDS;
        SchedulerArenaWrite(
            commandBase + 0u,
            rayCount == 0u
                ? 0u
                : SchedulerGroupsFor(bucketCount * rayCount));
        SchedulerArenaWrite(commandBase + 1u, 1u);
        SchedulerArenaWrite(commandBase + 2u, 1u);
        SchedulerArenaWrite(commandBase + 3u, 0u);
    }

    // Trace and transport consume the six per-ray-count bucket commands.
    // Their legacy aggregate slots stay inert to avoid a divergent formula.
    SchedulerWriteIndirect(
        SIMPLE_DDGI_SCHEDULER_DISPATCH_TRACE,
        0u,
        1u,
        1u);
    SchedulerWriteIndirect(
        SIMPLE_DDGI_SCHEDULER_DISPATCH_RELOCATE,
        SchedulerGroupsFor(accepted),
        1u,
        1u);
    SchedulerWriteIndirect(
        SIMPLE_DDGI_SCHEDULER_DISPATCH_TRANSPORT,
        0u,
        1u,
        1u);
    SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_BLEND,
        accepted, 1u, 1u);
    SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_PUBLISH,
        accepted, 1u, 1u);
    SchedulerWriteIndirect(
        SIMPLE_DDGI_SCHEDULER_DISPATCH_COMMIT,
        min(
            SchedulerActiveVolumeCount(),
            SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES),
        1u,
        1u);
    SchedulerWriteIndirect(
        SIMPLE_DDGI_SCHEDULER_DISPATCH_FEEDBACK,
        1u,
        1u,
        1u);
}
