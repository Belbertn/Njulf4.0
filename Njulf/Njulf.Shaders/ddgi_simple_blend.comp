#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint SIMPLE_DDGI_BLEND_FLAG_SHARED_RAY_CACHE = 1u << 3;
const uint SIMPLE_DDGI_BLEND_FLAG_REDUCED_COMPLEXITY = 1u << 5;
const uint SIMPLE_DDGI_BLEND_SOLVE_COMPACT_READ = 1u << 21u;
const uint SIMPLE_DDGI_BLEND_SOLVE_COMPACT_WRITE = 1u << 22u;
const uint SIMPLE_DDGI_BLEND_SWEEP_INDEX_SHIFT = 28u;
const float SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_MEAN_SPACING = 1.0;
const float SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_STDDEV_SPACING = 0.5;
// A broad lobe keeps each hit/miss distance field smooth at production ray
// counts. A narrower cos^32 vote chooses which field owns a direction at a
// silhouette, so long misses cannot inflate covered-wall moments. Applying a
// cos^64 lobe to the moments themselves leaves roughly two effective rays per
// texel at 128 rays/probe and stamps their cells into planar surfaces.
const float SIMPLE_DDGI_VISIBILITY_BROAD_MOMENT_EXPONENT = 16.0;
const float SIMPLE_DDGI_VISIBILITY_HIT_CLASS_THRESHOLD = 0.35;
// Small absolute fixed-point tolerance used only close to black. Unlike the
// legacy 0.02 subtraction, it does not erase visible low-energy bounce.
const float SIMPLE_DDGI_TRANSPORT_ABSOLUTE_RESIDUAL_TOLERANCE = 0.0001;
const float SIMPLE_DDGI_TRANSPORT_RESIDUAL_ENVELOPE_DECAY = 0.25;

shared vec4 SharedSimpleRayRadianceDistance[256];
shared vec4 SharedSimpleRayDirectionHit[256];
shared uint SharedSimpleRayVisibilityHit[256];
shared uint SharedSimpleRayInvalid;
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
shared float SharedSimpleRayGuidingPdf[256];
shared uint SharedSimpleRayGuidingTechnique[256];
shared uint SharedSimpleRayGuidingValid[256];
shared uint SharedSimpleGuidingBacked;
shared uint SharedSimpleGuidingValidCount;
shared uint SharedSimpleGuidingMaintenanceCount;
shared uint SharedSimpleGuidingMixtureCount;
#endif
shared float SharedSimpleIrradianceDelta[64];
shared vec4 SharedSimpleQuadratureFull[64];
shared vec4 SharedSimpleQuadraturePrefix[64];
// The reduced path projects only low-frequency irradiance. Visibility remains
// the exact directional ray-by-texel estimator because sparse octahedral splats
// create zero-moment holes and probe-aligned shadow bands.
shared vec3 SharedSimpleShCoefficients[9];

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint TransportGeneration;
    uint PrimaryDirectionalLightIndex;
    uint DispatchQueueOffset;
    uint DispatchProbeCount;
    uint DispatchRaysPerProbe;
    uint SchedulerArenaBufferIndex;
    uint SchedulerRayBucketIndex;
    uint SchedulerRayBucketCommandsOffsetWords;
    uint SchedulerRayBucketMetadataOffsetWords;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerUpdateRecordsOffsetWords;
} pc;

#include "ddgi_simple_transport_stage_evidence.glsl"

// Atlas diagnostics can execute once per texel.  Preserve them for explicit
// investigations, but eliminate the atomic traffic from normal production work.
#define AddRendererDiagnostic(frameIndex, counterIndex, value) AddSimpleDdgiDiagnostic(params, frameIndex, counterIndex, value)

float SimpleDdgiLuminance(vec3 value)
{
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

float SimpleDdgiStableRelativeDelta(float current, float previous, float absoluteNoiseFloor)
{
    float absoluteDelta = abs(current - previous);
    // Do not interpret the Monte-Carlo noise floor as lighting motion.  A purely
    // relative metric is ill-conditioned around black and was forcing dark texels
    // to accept almost every fresh estimate.
    float meaningfulDelta = max(absoluteDelta - absoluteNoiseFloor, 0.0);
    return meaningfulDelta / max(max(abs(current), abs(previous)), absoluteNoiseFloor);
}

float SimpleDdgiTransportConvergenceResidual(
    SimpleDdgiParams params,
    vec3 current,
    vec3 previous)
{
    // This is a fixed-point defect, evaluated before Jacobi relaxation. The
    // mixed scale accepts a tiny absolute error near black or the authored
    // relative error at normal signal levels without subtracting either one
    // from real low-energy bounce.
    float relativeThreshold = max(params.transportTailRelativeTolerance, 0.0);
    float absoluteScale =
        SIMPLE_DDGI_TRANSPORT_ABSOLUTE_RESIDUAL_TOLERANCE / relativeThreshold;
    vec3 difference = abs(current - previous);
    vec3 magnitude = max(abs(current), abs(previous));
    vec3 residual = difference / max(magnitude, vec3(absoluteScale));
    if (any(isnan(residual)) || any(isinf(residual)))
        return 1.0;
    return clamp(max(residual.x, max(residual.y, residual.z)), 0.0, 1.0);
}

float SimpleDdgiAdaptiveIrradianceHysteresis(SimpleDdgiParams params, vec4 previous, vec3 irradiance, float probeHysteresis, bool maintenanceUpdate)
{
    if ((params.flags & (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE)) !=
            (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE) ||
        probeHysteresis <= 0.0001 || previous.w <= 0.0001)
        return probeHysteresis;

    // Maintenance estimates have materially higher variance.  Keep their fixed
    // temporal filter instead of making the scheduler react to its own noise.
    if (maintenanceUpdate)
        return probeHysteresis;

    float previousLuma = SimpleDdgiLuminance(previous.rgb);
    float currentLuma = SimpleDdgiLuminance(irradiance);
    float relativeDelta = SimpleDdgiStableRelativeDelta(currentLuma, previousLuma, 0.02);
    float changeT = smoothstep(params.hysteresisChangeThreshold, params.hysteresisStepThreshold, relativeDelta);
    float softHysteresis = probeHysteresis * 0.5;
    float stepHysteresis = min(probeHysteresis, 0.60);
    return mix(probeHysteresis, mix(softHysteresis, stepHysteresis, changeT), smoothstep(params.hysteresisChangeThreshold * 0.75, params.hysteresisChangeThreshold, relativeDelta));
}

float SimpleDdgiAdaptiveVisibilityHysteresis(SimpleDdgiParams params, vec2 previous, vec2 moments, float probeHysteresis, bool maintenanceUpdate, bool historyValid, float spacing)
{
    if ((params.flags & (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE)) !=
            (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE) ||
        probeHysteresis <= 0.0001 || !historyValid)
        return probeHysteresis;
    if (maintenanceUpdate)
        return probeHysteresis;

    float relativeDelta = SimpleDdgiStableRelativeDelta(moments.x, previous.x, max(spacing * 0.02, 0.01));
    float changeT = smoothstep(params.hysteresisChangeThreshold, params.hysteresisStepThreshold, relativeDelta);
    float softHysteresis = probeHysteresis * 0.75;
    float stepHysteresis = max(min(probeHysteresis, 0.55), 0.0);
    return mix(probeHysteresis, mix(softHysteresis, stepHysteresis, changeT), smoothstep(params.hysteresisChangeThreshold * 0.75, params.hysteresisChangeThreshold, relativeDelta));
}

uint SimpleDdgiIrradianceReadBuffer(SimpleDdgiParams params)
{
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? pc.TransportReadIrradianceAtlasBufferIndex
        : pc.IrradianceAtlasBufferIndex;
}

uint SimpleDdgiIrradianceWriteBuffer(SimpleDdgiParams params)
{
    return SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex) ||
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? pc.TransportWriteIrradianceAtlasBufferIndex
        : pc.IrradianceAtlasBufferIndex;
}

uint SimpleDdgiBlendOutcomeIndex = 0u;

vec4 ReadSimpleDdgiBlendIrradianceTexel(
    uint bufferIndex,
    uint physicalProbeIndex,
    uint texelIndex,
    uint texelsPerProbe)
{
    if ((pc.Flags & SIMPLE_DDGI_BLEND_SOLVE_COMPACT_READ) != 0u)
    {
        return ReadSimpleDdgiIrradianceTexelAtOffset(
            pc.SchedulerArenaBufferIndex,
            pc.DispatchQueueOffset,
            SimpleDdgiBlendOutcomeIndex,
            texelIndex,
            texelsPerProbe);
    }
    return ReadSimpleDdgiIrradianceTexel(
        bufferIndex,
        physicalProbeIndex,
        texelIndex,
        texelsPerProbe);
}

void WriteSimpleDdgiBlendIrradianceTexel(
    uint bufferIndex,
    uint physicalProbeIndex,
    uint texelIndex,
    uint texelsPerProbe,
    vec4 value)
{
    if ((pc.Flags & SIMPLE_DDGI_BLEND_SOLVE_COMPACT_WRITE) != 0u)
    {
        WriteSimpleDdgiIrradianceTexelAtOffset(
            pc.SchedulerArenaBufferIndex,
            pc.DispatchQueueOffset,
            SimpleDdgiBlendOutcomeIndex,
            texelIndex,
            texelsPerProbe,
            value);
        return;
    }
    WriteSimpleDdgiIrradianceTexel(
        bufferIndex,
        physicalProbeIndex,
        texelIndex,
        texelsPerProbe,
        value);
}

void PublishSimpleDdgiQuadratureWitness(
    SimpleDdgiProbeUpdate update,
    uint rayCount)
{
    uint local = gl_LocalInvocationID.x;
    uint boundedRayCount = min(rayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    uint prefixRayCount = max(boundedRayCount / 2u, 1u);
    vec4 fullMoment = vec4(0.0);
    vec4 prefixMoment = vec4(0.0);
    for (uint ray = local; ray < boundedRayCount; ray += gl_WorkGroupSize.x)
    {
        float luminance = SimpleDdgiLuminance(
            SharedSimpleRayRadianceDistance[ray].rgb);
        vec3 direction = normalize(
            SharedSimpleRayDirectionHit[ray].xyz);
        vec4 directionalMoment = vec4(luminance * direction, luminance);
        fullMoment += directionalMoment;
        if (ray < prefixRayCount)
            prefixMoment += directionalMoment;
    }
    SharedSimpleQuadratureFull[local] = fullMoment;
    SharedSimpleQuadraturePrefix[local] = prefixMoment;
    barrier();

    if (local == 0u)
    {
        vec4 full = vec4(0.0);
        vec4 prefix = vec4(0.0);
        for (uint lane = 0u; lane < gl_WorkGroupSize.x; lane++)
        {
            full += SharedSimpleQuadratureFull[lane];
            prefix += SharedSimpleQuadraturePrefix[lane];
        }
        full /= float(max(boundedRayCount, 1u));
        prefix /= float(prefixRayCount);
        float energyFloor = max(max(full.w, prefix.w) * 0.05, 1.0e-4);
        vec4 scale = max(max(abs(full), abs(prefix)), vec4(energyFloor));
        vec4 relativeError = abs(full - prefix) / scale;
        float error = clamp(max(
            max(relativeError.x, relativeError.y),
            max(relativeError.z, relativeError.w)), 0.0, 1.0);
        // Outcome word 11 reserves its low half for the bounded ray count.
        // Mandatory scroll records reserve the high half for their transaction
        // serial, so only ordinary updates append the quadrature witness here.
        uint quantized = (!isnan(error) && !isinf(error) &&
                boundedRayCount >= 2u)
            ? min(uint(round(error * 65534.0)) + 1u, 65535u)
            : 0u;
        uint countAndWitness = ReadStorageWordUniform(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords +
                update.outcomeIndex *
                    SIMPLE_DDGI_SCHEDULER_OUTCOME_WORDS + 11u);
        if ((update.flags & SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED) == 0u)
        {
            WriteStorageWordUniform(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords +
                    update.outcomeIndex *
                        SIMPLE_DDGI_SCHEDULER_OUTCOME_WORDS + 11u,
                (countAndWitness & 0xffffu) | (quantized << 16u));
        }
    }
    barrier();
}

void LoadSimpleRayCache(
    SimpleDdgiParams params,
    SimpleDdgiVolume volume,
    SimpleDdgiProbeUpdate update,
    uint probeIndex,
    uint localProbeOffset,
    uint activeRayCount)
{
    uint local = gl_LocalInvocationID.x;
    if (local == 0u)
    {
        SharedSimpleRayInvalid = 0u;
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        SharedSimpleGuidingBacked = 0u;
        SharedSimpleGuidingValidCount = 0u;
        SharedSimpleGuidingMaintenanceCount = 0u;
        SharedSimpleGuidingMixtureCount = 0u;
#endif
    }
    barrier();
    uint rayCount = min(
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
            ? SimpleDdgiUpdateSourceRayCount(update, params)
            : activeRayCount,
        SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = local; ray < rayCount; ray += gl_WorkGroupSize.x)
    {
        uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
        uint directionRayIndex = SimpleDdgiUpdateDirectionRayIndex(
            ray,
            activeRayCount,
            SimpleDdgiUpdateSourceRayCount(update, params),
            params);
        vec4 radianceDistance;
        vec3 direction;
        vec2 visibilityHit;
        uint directionEpoch;
        bool valid = ReadSimpleDdgiRayResultStorage(
            pc.RayResultScratchBufferIndex,
            rayResultIndex,
            volume,
            params,
            probeIndex,
            directionRayIndex,
            update.sourceEpoch,
            radianceDistance,
            direction,
            visibilityHit,
            directionEpoch);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        bool guidingRecordPresent = false;
        SimpleDdgiGuidingTransportPayload guidingPayload;
        bool guidingValid = TryReadSimpleDdgiGuidingTransportPayload(
            update.physicalProbeIndex,
            update.probeIndex,
            update.pageMappingGeneration,
            update.sourceEpoch,
            update.sourceLightingGeneration,
            uvec2(
                update.probeIndex,
                update.expectedGeneration &
                    SIMPLE_DDGI_UPDATE_GENERATION_MASK),
            directionRayIndex,
            params.raysPerProbe,
            params.guidingPhysicalProbeCapacity,
            guidingRecordPresent,
            guidingPayload);
        if (guidingRecordPresent)
            atomicOr(SharedSimpleGuidingBacked, 1u);
        if (guidingValid)
            direction = guidingPayload.direction;
        SharedSimpleRayGuidingPdf[ray] = guidingValid
            ? guidingPayload.generationTimeMixturePdf
            : 0.0;
        SharedSimpleRayGuidingTechnique[ray] = guidingValid
            ? guidingPayload.technique
            : 0xffffffffu;
        SharedSimpleRayGuidingValid[ray] = guidingValid ? 1u : 0u;
#endif
        SharedSimpleRayDirectionHit[ray] = vec4(
            valid ? direction : vec3(0.0, 1.0, 0.0),
            valid ? visibilityHit.y :
                SIMPLE_DDGI_RAY_HIT_KIND_ONE_SIDED_BACK_FACE);
        SharedSimpleRayVisibilityHit[ray] = PackSimpleDdgiRayVisibilityHit(
            valid ? visibilityHit.x : 0.0,
            valid ? visibilityHit.y :
                SIMPLE_DDGI_RAY_HIT_KIND_ONE_SIDED_BACK_FACE);
        SharedSimpleRayRadianceDistance[ray] = valid
            ? radianceDistance
            : vec4(0.0);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        if (!valid || (guidingRecordPresent && !guidingValid))
#else
        if (!valid)
#endif
            atomicOr(SharedSimpleRayInvalid, 1u);
    }

    barrier();
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
    if (local == 0u && SharedSimpleGuidingBacked != 0u)
    {
        for (uint ray = 0u; ray < rayCount; ray++)
        {
            if (SharedSimpleRayGuidingValid[ray] == 0u)
            {
                SharedSimpleRayInvalid = 1u;
                continue;
            }
            SharedSimpleGuidingValidCount++;
            if (SharedSimpleRayGuidingTechnique[ray] ==
                SIMPLE_DDGI_GUIDING_TECHNIQUE_UNIFORM_MAINTENANCE)
            {
                SharedSimpleGuidingMaintenanceCount++;
            }
            else if (SharedSimpleRayGuidingTechnique[ray] ==
                SIMPLE_DDGI_GUIDING_TECHNIQUE_MIXTURE)
            {
                SharedSimpleGuidingMixtureCount++;
            }
            else
            {
                SharedSimpleRayInvalid = 1u;
            }
        }
        if (SharedSimpleGuidingValidCount != rayCount ||
            SharedSimpleGuidingMaintenanceCount == 0u ||
            SharedSimpleGuidingMixtureCount == 0u)
        {
            SharedSimpleRayInvalid = 1u;
        }
    }
#endif
    barrier();
}

#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
bool SimpleDdgiGuidingTransportActive(uint rayCount)
{
    return SharedSimpleGuidingBacked != 0u &&
        SharedSimpleGuidingValidCount == rayCount &&
        SharedSimpleRayInvalid == 0u;
}
#endif

vec4 ReadCachedSimpleRayRadianceDistance(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    return SharedSimpleRayRadianceDistance[ray];
}

vec4 ReadCachedSimpleRayDirectionHit(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    return SharedSimpleRayDirectionHit[ray];
}

vec2 ReadCachedSimpleRayVisibilityHit(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    return UnpackSimpleDdgiRayVisibilityHit(
        SharedSimpleRayVisibilityHit[ray]);
}

vec2 ReadSimpleDdgiDiagnosticVisibilityMoments(
    SimpleDdgiParams params,
    uint physicalProbeIndex,
    vec3 direction)
{
    vec2 uv = clamp(SimpleDdgiOctEncode(normalize(direction)), vec2(0.0), vec2(0.999999));
    uvec2 coordinate = min(
        uvec2(uv * float(params.visibilityTexels)),
        uvec2(params.visibilityTexels - 1u));
    uint visibilityTexel = coordinate.y * params.visibilityTexels + coordinate.x;
    return ReadSimpleDdgiVisibilityMoments(
        pc.VisibilityAtlasBufferIndex,
        physicalProbeIndex,
        visibilityTexel,
        params.visibilityTexels);
}

float BlendIrradianceTexel(
    SimpleDdgiParams params,
    uint volumeIndex,
    uint virtualProbeIndex,
    uint virtualPageIndex,
    uint physicalProbeIndex,
    uint physicalPageIndex,
    uint sourceLightingGeneration,
    uint localProbeOffset,
    uint texel,
    float probeHysteresis,
    bool sharedRayCacheEnabled,
    uint activeRayCount,
    bool maintenanceUpdate,
    bool freshUpdate)
{
    uint x = texel % params.irradianceTexels;
    uint y = texel / params.irradianceTexels;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(params.irradianceTexels);
    vec3 texelDirection = SimpleDdgiOctDecode(uv);
    vec3 accumulated = vec3(0.0);
    float weightSum = 0.0;

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
    bool guidingActive = SimpleDdgiGuidingTransportActive(rayCount);
#endif
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, sharedRayCacheEnabled);
        vec4 radianceDistance = ReadCachedSimpleRayRadianceDistance(params, localProbeOffset, ray, sharedRayCacheEnabled);
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            sharedRayCacheEnabled);
        if (SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y))
            continue;
        float cosine = max(dot(
            normalize(texelDirection),
            normalize(directionHit.xyz)), 0.0);
        float weight = cosine;
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        if (guidingActive)
        {
            float denominator = SimpleDdgiGuidingBalanceDenominator(
                SharedSimpleGuidingMaintenanceCount,
                SharedSimpleGuidingMixtureCount,
                SharedSimpleRayGuidingPdf[ray]);
            if (denominator <= 0.0 || isnan(denominator) ||
                isinf(denominator))
            {
                weight = 0.0;
            }
            else
            {
                weight /= denominator;
            }
        }
        else
#endif
        {
            weight = SimpleDdgiPositiveCosineWeight(
                texelDirection,
                directionHit.xyz);
        }
        accumulated += SimpleDdgiClampTransportRadiance(radianceDistance.rgb) * weight;
        weightSum += weight;
    }

    uint irradianceReadBuffer = SimpleDdgiIrradianceReadBuffer(params);
    uint irradianceWriteBuffer = SimpleDdgiIrradianceWriteBuffer(params);
    vec4 previous = ReadSimpleDdgiBlendIrradianceTexel(irradianceReadBuffer, physicalProbeIndex, texel, params.irradianceTexels);
    if (weightSum <= 0.000001)
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_ZERO_RAY_WEIGHT_PROBE_COUNTER, 1u);
        bool certifiedTransport =
            (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u;
        if (previous.w > 0.0001 && !freshUpdate && !certifiedTransport)
        {
            // V1 retains its temporal-history fallback for undersampled texels.
            // Certified V2 must instead publish the positive operator's zero
            // result below: preserving an arbitrary prior value is an identity
            // branch that is neither contractive nor equal to the frozen audit.
            WriteSimpleDdgiBlendIrradianceTexel(irradianceWriteBuffer, physicalProbeIndex, texel, params.irradianceTexels, previous);
            return 0.0;
        }
        if (freshUpdate)
        {
            WriteSimpleDdgiBlendIrradianceTexel(irradianceWriteBuffer, physicalProbeIndex, texel, params.irradianceTexels, vec4(0.0));
            return 1.0;
        }
    }

    // Both the uniform and guided kernels use the same positive normalized
    // projection. In the guided case the balance denominator changes each
    // sample's relative weight, while normalization preserves constants and
    // bounds the finite-sample row gain required by tail certification.
    vec3 irradiance = SimpleDdgiEvaluatePositiveIrradiance(
        accumulated,
        weightSum);
    vec2 diagnosticVisibilityMoments = vec2(0.0);
#if NJULF_DDGI_DETAILED_COUNTERS
    if (SimpleDdgiBlendEnergyDiagnosticTexel(
            params,
            virtualProbeIndex,
            texel))
    {
        diagnosticVisibilityMoments = ReadSimpleDdgiDiagnosticVisibilityMoments(
            params,
            physicalProbeIndex,
            texelDirection);
    }
#endif
    RecordSimpleDdgiBlendEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        volumeIndex,
        virtualProbeIndex,
        virtualPageIndex,
        physicalProbeIndex,
        physicalPageIndex,
        sourceLightingGeneration,
        texel,
        irradiance,
        diagnosticVisibilityMoments,
        weightSum > 0.000001 ? 1.0 : 0.0);
    float texelHysteresis = SimpleDdgiAdaptiveIrradianceHysteresis(params, previous, irradiance, probeHysteresis, maintenanceUpdate);
    vec4 blended = mix(vec4(irradiance, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    if (SimpleDdgiLuminance(irradiance) > 0.00001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_NONZERO_IRRADIANCE_PROBE_COUNTER, 1u);
    if (probeHysteresis > 0.0001 && previous.w > 0.0001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_PREVIOUS_ATLAS_USED_COUNTER, 1u);
    WriteSimpleDdgiBlendIrradianceTexel(irradianceWriteBuffer, physicalProbeIndex, texel, params.irradianceTexels, blended);
    if (SimpleDdgiTransportStageMatchesWitness(
            virtualProbeIndex,
            texel) &&
        SimpleDdgiSolveIsFinalSweep(
            pc.Flags,
            params.transportAcceleratedSweepCount))
    {
        SimpleDdgiTransportStageBegin(
            virtualProbeIndex,
            physicalProbeIndex,
            texel);
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_PREVIOUS_R_WORD,
            previous.rgb);
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_CANDIDATE_R_WORD,
            irradiance);
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_BLENDED_R_WORD,
            blended.rgb);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_WEIGHT_WORD,
            floatBitsToUint(weightSum));
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_ACCUMULATED_R_WORD,
            accumulated);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_RAY_COUNT_WORD,
            rayCount);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_BACKED_WORD,
            SharedSimpleGuidingBacked);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_VALID_WORD,
            SharedSimpleGuidingValidCount);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_MAINTENANCE_WORD,
            SharedSimpleGuidingMaintenanceCount);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_MIXTURE_WORD,
            SharedSimpleGuidingMixtureCount);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_FIRST_PDF_WORD,
            floatBitsToUint(SharedSimpleRayGuidingPdf[0]));
#else
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_BACKED_WORD,
            0u);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_VALID_WORD,
            0u);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_MAINTENANCE_WORD,
            0u);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_GUIDING_MIXTURE_WORD,
            0u);
        SimpleDdgiTransportStageWrite(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_FIRST_PDF_WORD,
            0u);
#endif
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_FIRST_RAY_R_WORD,
            SharedSimpleRayRadianceDistance[0].rgb);
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_SOLVER_FIRST_DIRECTION_X_WORD,
            SharedSimpleRayDirectionHit[0].xyz);
        memoryBarrierBuffer();
        vec3 privateReadback = ReadSimpleDdgiIrradianceTexel(
            irradianceWriteBuffer,
            physicalProbeIndex,
            texel,
            params.irradianceTexels).rgb;
        SimpleDdgiTransportStageWriteRgb(
            SIMPLE_DDGI_TRANSPORT_STAGE_PRIVATE_R_WORD,
            privateReadback);
        SimpleDdgiTransportStagePublish(
            SIMPLE_DDGI_TRANSPORT_STAGE_BLEND |
            SIMPLE_DDGI_TRANSPORT_STAGE_PRIVATE_READBACK);
    }
    if (previous.w <= 0.0001)
        return 1.0;
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? SimpleDdgiTransportConvergenceResidual(params, irradiance, previous.rgb)
        : SimpleDdgiStableRelativeDelta(
            SimpleDdgiLuminance(irradiance),
            SimpleDdgiLuminance(previous.rgb),
            0.02);
}

vec2 SimpleDdgiBlendNearVisibilityLayer(
    vec2 current,
    vec2 previous,
    float hysteresis,
    float coherentDepthBand)
{
    if (current.y < 0.65 || previous.y < 0.65 ||
        abs(current.x - previous.x) > coherentDepthBand)
    {
        hysteresis = 0.0;
    }
    return vec2(
        mix(current.x, previous.x, hysteresis),
        clamp(mix(current.y, previous.y, hysteresis), 0.0, 1.0));
}

vec4 SimpleDdgiBlendNearVisibilityLayers(
    vec4 current,
    vec4 previous,
    float hysteresis,
    float coherentDepthBand)
{
    vec2 currentPrimary = current.xy;
    vec2 currentSecondary = current.zw;
    if (currentSecondary.y > 0.0 &&
        (currentPrimary.y <= 0.0 ||
            currentSecondary.x < currentPrimary.x))
    {
        vec2 swapLayer = currentPrimary;
        currentPrimary = currentSecondary;
        currentSecondary = swapLayer;
    }

    vec2 previousPrimary = previous.xy;
    vec2 previousSecondary = previous.zw;
    if (previousSecondary.y > 0.0 &&
        (previousPrimary.y <= 0.0 ||
            previousSecondary.x < previousPrimary.x))
    {
        vec2 swapLayer = previousPrimary;
        previousPrimary = previousSecondary;
        previousSecondary = swapLayer;
    }

    bool previousPrimaryUsed = false;
    bool previousSecondaryUsed = false;
    int primaryMatch = -1;
    if (currentPrimary.y >= 0.65)
    {
        float primaryDistance = previousPrimary.y >= 0.65
            ? abs(currentPrimary.x - previousPrimary.x)
            : 65504.0;
        float secondaryDistance = previousSecondary.y >= 0.65
            ? abs(currentPrimary.x - previousSecondary.x)
            : 65504.0;
        float nearestDistance = min(primaryDistance, secondaryDistance);
        if (nearestDistance <= coherentDepthBand)
            primaryMatch = primaryDistance <= secondaryDistance ? 0 : 1;
    }
    previousPrimaryUsed = primaryMatch == 0;
    previousSecondaryUsed = primaryMatch == 1;
    vec2 blendedPrimary = SimpleDdgiBlendNearVisibilityLayer(
        currentPrimary,
        primaryMatch == 0
            ? previousPrimary
            : primaryMatch == 1
                ? previousSecondary
                : vec2(0.0),
        primaryMatch >= 0 ? hysteresis : 0.0,
        coherentDepthBand);

    int secondaryMatch = -1;
    if (currentSecondary.y >= 0.65)
    {
        float primaryDistance = !previousPrimaryUsed &&
                previousPrimary.y >= 0.65
            ? abs(currentSecondary.x - previousPrimary.x)
            : 65504.0;
        float secondaryDistance = !previousSecondaryUsed &&
                previousSecondary.y >= 0.65
            ? abs(currentSecondary.x - previousSecondary.x)
            : 65504.0;
        float nearestDistance = min(primaryDistance, secondaryDistance);
        if (nearestDistance <= coherentDepthBand)
            secondaryMatch = primaryDistance <= secondaryDistance ? 0 : 1;
    }
    vec2 blendedSecondary = SimpleDdgiBlendNearVisibilityLayer(
        currentSecondary,
        secondaryMatch == 0
            ? previousPrimary
            : secondaryMatch == 1
                ? previousSecondary
                : vec2(0.0),
        secondaryMatch >= 0 ? hysteresis : 0.0,
        coherentDepthBand);

    if (blendedSecondary.y > 0.0 &&
        (blendedPrimary.y <= 0.0 ||
            blendedSecondary.x < blendedPrimary.x))
    {
        vec2 swapLayer = blendedPrimary;
        blendedPrimary = blendedSecondary;
        blendedSecondary = swapLayer;
    }
    return vec4(blendedPrimary, blendedSecondary);
}

void BlendVisibilityTexel(SimpleDdgiParams params, SimpleDdgiVolume volume, uint physicalProbeIndex, uint localProbeOffset, uint texel, float probeHysteresis, bool sharedRayCacheEnabled, uint activeRayCount, bool maintenanceUpdate, bool freshUpdate, bool visibilityHistoryValid)
{
    uint x = texel % params.visibilityTexels;
    uint y = texel / params.visibilityTexels;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(params.visibilityTexels);
    vec3 texelDirection = SimpleDdgiOctDecode(uv);
    float broadHitMean = 0.0;
    float broadHitMean2 = 0.0;
    float broadHitWeightSum = 0.0;
    float broadMissMean = 0.0;
    float broadMissMean2 = 0.0;
    float broadMissWeightSum = 0.0;
    float narrowHitWeightSum = 0.0;
    float narrowWeightSum = 0.0;
    float nearestQualifyingHitDistance = 65504.0;
    float secondaryQualifyingHitDistance = 65504.0;
    float coherentDepthWeightedSum = 0.0;
    float coherentDepthWeightSum = 0.0;
    float secondaryDepthWeightedSum = 0.0;
    float secondaryDepthWeightSum = 0.0;
    float coherentDepthBand = max(
        0.02,
        min(volume.spacing * 0.10, params.architecturalThickness * 0.50));
    bool nearVisibilitySidecarActive =
        (params.flags & SIMPLE_DDGI_FLAG_NEAR_VISIBILITY_SIDECAR) != 0u &&
        SimpleDdgiVolumeUsesNearVisibilitySidecar(volume);

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
    bool guidingActive = SimpleDdgiGuidingTransportActive(rayCount);
#endif
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        // Visibility, relocation, and classification retain a fixed uniform
        // estimator. Guided mixture samples are radiometric-only and cannot
        // imprint their adaptive proposal on leak suppression.
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        if (guidingActive &&
            SharedSimpleRayGuidingTechnique[ray] !=
                SIMPLE_DDGI_GUIDING_TECHNIQUE_UNIFORM_MAINTENANCE)
        {
            continue;
        }
#endif
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, sharedRayCacheEnabled);
        float cosine = max(dot(texelDirection, normalize(directionHit.xyz)), 0.0);
        float broadWeight = pow(
            cosine,
            SIMPLE_DDGI_VISIBILITY_BROAD_MOMENT_EXPONENT);
        // cos^32 derived from the broad cos^16 weight avoids a second pow().
        float narrowWeight = broadWeight * broadWeight;
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            sharedRayCacheEnabled);
        float d = max(visibilityHit.x, 0.0);
        if (visibilityHit.y >= 0.5)
        {
            // An authored reverse face is not free-space support. Give it zero
            // distance in the visibility moments so probes behind floors or
            // walls cannot illuminate receivers just beyond that shell. Keep
            // the physical distance for relocation and coherent depth layers.
            float momentDistance = SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y)
                ? 0.0
                : d;
            broadHitMean += momentDistance * broadWeight;
            broadHitMean2 += momentDistance * momentDistance * broadWeight;
            broadHitWeightSum += broadWeight;
            narrowHitWeightSum += narrowWeight;
            // The nearest depth only seeds a cluster. Confidence is computed in
            // a second pass from rays belonging to that same depth layer.
            if (nearVisibilitySidecarActive && narrowWeight >= 0.04)
            {
                nearestQualifyingHitDistance = min(
                    nearestQualifyingHitDistance,
                    d);
            }
        }
        else
        {
            broadMissMean += d * broadWeight;
            broadMissMean2 += d * d * broadWeight;
            broadMissWeightSum += broadWeight;
        }
        narrowWeightSum += narrowWeight;
    }

    if (nearVisibilitySidecarActive &&
        nearestQualifyingHitDistance < 65503.0)
    {
        for (uint ray = 0u; ray < rayCount; ray++)
        {
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
            if (guidingActive &&
                SharedSimpleRayGuidingTechnique[ray] !=
                    SIMPLE_DDGI_GUIDING_TECHNIQUE_UNIFORM_MAINTENANCE)
            {
                continue;
            }
#endif
            vec4 directionHit = ReadCachedSimpleRayDirectionHit(
                params,
                localProbeOffset,
                ray,
                sharedRayCacheEnabled);
            float cosine = max(
                dot(texelDirection, normalize(directionHit.xyz)),
                0.0);
            float broadWeight = pow(
                cosine,
                SIMPLE_DDGI_VISIBILITY_BROAD_MOMENT_EXPONENT);
            float narrowWeight = broadWeight * broadWeight;
            if (narrowWeight <= 0.000001)
                continue;

            vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
                params,
                localProbeOffset,
                ray,
                sharedRayCacheEnabled);
            float d = max(visibilityHit.x, 0.0);
            if (visibilityHit.y >= 0.5 &&
                abs(d - nearestQualifyingHitDistance) <= coherentDepthBand)
            {
                coherentDepthWeightedSum += d * narrowWeight;
                coherentDepthWeightSum += narrowWeight;
            }
            else if (visibilityHit.y >= 0.5 &&
                d > nearestQualifyingHitDistance + coherentDepthBand &&
                narrowWeight >= 0.04)
            {
                secondaryQualifyingHitDistance = min(
                    secondaryQualifyingHitDistance,
                    d);
            }
        }
    }

    if (nearVisibilitySidecarActive &&
        secondaryQualifyingHitDistance < 65503.0)
    {
        for (uint ray = 0u; ray < rayCount; ray++)
        {
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
            if (guidingActive &&
                SharedSimpleRayGuidingTechnique[ray] !=
                    SIMPLE_DDGI_GUIDING_TECHNIQUE_UNIFORM_MAINTENANCE)
            {
                continue;
            }
#endif
            vec4 directionHit = ReadCachedSimpleRayDirectionHit(
                params,
                localProbeOffset,
                ray,
                sharedRayCacheEnabled);
            float cosine = max(
                dot(texelDirection, normalize(directionHit.xyz)),
                0.0);
            float broadWeight = pow(
                cosine,
                SIMPLE_DDGI_VISIBILITY_BROAD_MOMENT_EXPONENT);
            float narrowWeight = broadWeight * broadWeight;
            if (narrowWeight <= 0.000001)
                continue;

            vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
                params,
                localProbeOffset,
                ray,
                sharedRayCacheEnabled);
            float d = max(visibilityHit.x, 0.0);
            if (visibilityHit.y >= 0.5 &&
                abs(d - nearestQualifyingHitDistance) > coherentDepthBand &&
                abs(d - secondaryQualifyingHitDistance) <= coherentDepthBand)
            {
                secondaryDepthWeightedSum += d * narrowWeight;
                secondaryDepthWeightSum += narrowWeight;
            }
        }
    }

    vec2 previous = ReadSimpleDdgiVisibilityMoments(pc.VisibilityAtlasBufferIndex, physicalProbeIndex, texel, params.visibilityTexels);
    uint publicNearVisibilityOffsetWords =
        SimpleDdgiVisibilityAtlasWordCount(params);
    vec4 previousNearVisibility = nearVisibilitySidecarActive
        ? ReadSimpleDdgiNearVisibilityAtOffset(
            pc.VisibilityAtlasBufferIndex,
            publicNearVisibilityOffsetWords,
            physicalProbeIndex,
            texel,
            params)
        : vec4(65504.0, 0.0, 65504.0, 0.0);
    vec2 moments;
    if (broadHitWeightSum > 0.000001 || broadMissWeightSum > 0.000001)
    {
        bool hasHitMoments = broadHitWeightSum > 0.000001;
        bool hasMissMoments = broadMissWeightSum > 0.000001;
        vec2 hitMoments = hasHitMoments
            ? vec2(broadHitMean, broadHitMean2) / broadHitWeightSum
            : vec2(0.0);
        vec2 missMoments = hasMissMoments
            ? vec2(broadMissMean, broadMissMean2) / broadMissWeightSum
            : vec2(0.0);
        if (hasHitMoments && hasMissMoments && narrowWeightSum > 0.000001)
        {
            float narrowHitFraction = clamp(
                narrowHitWeightSum / narrowWeightSum,
                0.0,
                1.0);
            moments = narrowHitFraction >= SIMPLE_DDGI_VISIBILITY_HIT_CLASS_THRESHOLD
                ? hitMoments
                : missMoments;
        }
        else
            moments = hasHitMoments ? hitMoments : missMoments;
    }
    else if (visibilityHistoryValid && !freshUpdate)
    {
        // Resident publication copies the complete private visibility target
        // at commit. Preserve an unchanged texel there as well; returning
        // without a write would allow an aborted transaction's stale private
        // value to leak into the next successful publication.
        if (SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex))
        {
            WriteSimpleDdgiVisibilityMomentsAtOffset(
                pc.TransportWriteIrradianceAtlasBufferIndex,
                pc.PrivateVisibilityAtlasOffsetWords,
                physicalProbeIndex,
                texel,
                params.visibilityTexels,
                previous);
            if (nearVisibilitySidecarActive)
            {
                WriteSimpleDdgiNearVisibilityAtOffset(
                    pc.TransportWriteIrradianceAtlasBufferIndex,
                    pc.PrivateVisibilityAtlasOffsetWords +
                        publicNearVisibilityOffsetWords,
                    physicalProbeIndex,
                    texel,
                    params,
                    previousNearVisibility);
            }
        }
        return;
    }
    else
    {
        float mean = volume.spacing * SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_MEAN_SPACING;
        float standardDeviation = volume.spacing * SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_STDDEV_SPACING;
        moments = vec2(mean, mean * mean + standardDeviation * standardDeviation);
    }
    float texelHysteresis = SimpleDdgiAdaptiveVisibilityHysteresis(params, previous, moments, probeHysteresis, maintenanceUpdate, visibilityHistoryValid, volume.spacing);
    vec2 blended = mix(moments, previous, texelHysteresis);
    vec4 blendedNearVisibility =
        vec4(65504.0, 0.0, 65504.0, 0.0);
    if (nearVisibilitySidecarActive)
    {
        float primaryConfidence = narrowWeightSum > 0.000001 &&
                coherentDepthWeightSum > 0.000001
            ? clamp(coherentDepthWeightSum / narrowWeightSum, 0.0, 1.0)
            : 0.0;
        float secondaryConfidence = narrowWeightSum > 0.000001 &&
                secondaryDepthWeightSum > 0.000001
            ? clamp(secondaryDepthWeightSum / narrowWeightSum, 0.0, 1.0)
            : 0.0;
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            primaryConfidence >= 0.65 || secondaryConfidence >= 0.65
                ? SIMPLE_DDGI_NEAR_VISIBILITY_COHERENT_CLUSTER_COUNTER
                : SIMPLE_DDGI_NEAR_VISIBILITY_REJECTED_CLUSTER_COUNTER,
            1u);
        // Preserve a finite depth while confidence is released. Confidence is
        // authoritative, so a miss update disables stale occlusion in one
        // refresh without blending toward half-float infinity.
        float primaryDepth = coherentDepthWeightSum > 0.000001
            ? coherentDepthWeightedSum / coherentDepthWeightSum
            : (previousNearVisibility.y > 0.0
                ? previousNearVisibility.x
                : 65504.0);
        float secondaryDepth = secondaryDepthWeightSum > 0.000001
            ? secondaryDepthWeightedSum / secondaryDepthWeightSum
            : (previousNearVisibility.w > 0.0
                ? previousNearVisibility.z
                : 65504.0);
        vec4 currentNearVisibility = vec4(
            primaryDepth,
            primaryConfidence,
            secondaryDepth,
            secondaryConfidence);
        float nearHysteresis = visibilityHistoryValid && !freshUpdate
            ? min(texelHysteresis, 0.85)
            : 0.0;
        // Each layer independently matches the nearest unused history layer.
        // A miss releases confidence in one refresh, while distinct layers are
        // replacements rather than averaged phantom blockers.
        blendedNearVisibility = SimpleDdgiBlendNearVisibilityLayers(
            currentNearVisibility,
            previousNearVisibility,
            nearHysteresis,
            coherentDepthBand);
    }
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    if (SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex))
    {
        WriteSimpleDdgiVisibilityMomentsAtOffset(
            pc.TransportWriteIrradianceAtlasBufferIndex,
            pc.PrivateVisibilityAtlasOffsetWords,
            physicalProbeIndex,
            texel,
            params.visibilityTexels,
            blended);
        if (nearVisibilitySidecarActive)
        {
            WriteSimpleDdgiNearVisibilityAtOffset(
                pc.TransportWriteIrradianceAtlasBufferIndex,
                pc.PrivateVisibilityAtlasOffsetWords +
                    publicNearVisibilityOffsetWords,
                physicalProbeIndex,
                texel,
                params,
                blendedNearVisibility);
        }
    }
    else
    {
        WriteSimpleDdgiVisibilityMoments(
            pc.VisibilityAtlasBufferIndex,
            physicalProbeIndex,
            texel,
            params.visibilityTexels,
            blended);
        if (nearVisibilitySidecarActive)
        {
            WriteSimpleDdgiNearVisibilityAtOffset(
                pc.VisibilityAtlasBufferIndex,
                publicNearVisibilityOffsetWords,
                physicalProbeIndex,
                texel,
                params,
                blendedNearVisibility);
        }
    }
}

void AccumulateSimpleShBasis(vec3 direction, vec3 radiance, float normalization)
{
    float x = direction.x;
    float y = direction.y;
    float z = direction.z;
    float basis[9] = float[](
        0.2820947918,
        -0.4886025119 * y,
        0.4886025119 * z,
        -0.4886025119 * x,
        1.0925484306 * x * y,
        -1.0925484306 * y * z,
        0.3153915653 * (3.0 * z * z - 1.0),
        -1.0925484306 * x * z,
        0.5462742153 * (x * x - y * y));
    for (uint coefficient = 0u; coefficient < 9u; coefficient++)
        SharedSimpleShCoefficients[coefficient] += radiance * (basis[coefficient] * normalization);
}

void BuildReducedSimpleDdgiIrradiance(SimpleDdgiParams params, uint localProbeOffset, uint activeRayCount)
{
    // A single invocation builds the compact SH projection deterministically.
    // Exact visibility is evaluated below from the shared ray cache.
    for (uint coefficient = 0u; coefficient < 9u; coefficient++)
        SharedSimpleShCoefficients[coefficient] = vec3(0.0);

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    uint validRayCount = 0u;
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            true);
        if (!SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y))
            validRayCount++;
    }
    float shNormalization = (4.0 * SIMPLE_DDGI_PI) / max(float(validRayCount), 1.0);
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            true);
        if (SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y))
            continue;
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, true);
        vec4 radianceDistance = ReadCachedSimpleRayRadianceDistance(params, localProbeOffset, ray, true);
        vec3 direction = normalize(directionHit.xyz);
        AccumulateSimpleShBasis(
            direction,
            SimpleDdgiClampTransportRadiance(radianceDistance.rgb),
            shNormalization);
    }
}

vec3 EvaluateReducedSimpleDdgiIrradiance(vec3 direction)
{
    float x = direction.x;
    float y = direction.y;
    float z = direction.z;
    float basis[9] = float[](
        0.2820947918,
        -0.4886025119 * y,
        0.4886025119 * z,
        -0.4886025119 * x,
        1.0925484306 * x * y,
        -1.0925484306 * y * z,
        0.3153915653 * (3.0 * z * z - 1.0),
        -1.0925484306 * x * z,
        0.5462742153 * (x * x - y * y));
    float convolution[3] = float[](SIMPLE_DDGI_PI, 2.0 * SIMPLE_DDGI_PI / 3.0, SIMPLE_DDGI_PI / 4.0);
    vec3 irradiance = vec3(0.0);
    for (uint coefficient = 0u; coefficient < 9u; coefficient++)
    {
        uint band = coefficient == 0u ? 0u : (coefficient < 4u ? 1u : 2u);
        irradiance += SharedSimpleShCoefficients[coefficient] * (basis[coefficient] * convolution[band]);
    }
    return max(irradiance, vec3(0.0));
}

float BlendReducedIrradianceTexel(
    SimpleDdgiParams params,
    uint volumeIndex,
    uint virtualProbeIndex,
    uint virtualPageIndex,
    uint physicalProbeIndex,
    uint physicalPageIndex,
    uint sourceLightingGeneration,
    uint texel,
    float probeHysteresis,
    bool maintenanceUpdate,
    bool freshUpdate)
{
    uint x = texel % params.irradianceTexels;
    uint y = texel / params.irradianceTexels;
    vec3 texelDirection = SimpleDdgiOctDecode((vec2(x, y) + vec2(0.5)) / vec2(params.irradianceTexels));
    vec3 irradiance = EvaluateReducedSimpleDdgiIrradiance(texelDirection);
    vec2 diagnosticVisibilityMoments = vec2(0.0);
#if NJULF_DDGI_DETAILED_COUNTERS
    if (SimpleDdgiBlendEnergyDiagnosticTexel(
            params,
            virtualProbeIndex,
            texel))
    {
        diagnosticVisibilityMoments = ReadSimpleDdgiDiagnosticVisibilityMoments(
            params,
            physicalProbeIndex,
            texelDirection);
    }
#endif
    RecordSimpleDdgiBlendEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        volumeIndex,
        virtualProbeIndex,
        virtualPageIndex,
        physicalProbeIndex,
        physicalPageIndex,
        sourceLightingGeneration,
        texel,
        irradiance,
        diagnosticVisibilityMoments,
        1.0);
    uint irradianceReadBuffer = SimpleDdgiIrradianceReadBuffer(params);
    uint irradianceWriteBuffer = SimpleDdgiIrradianceWriteBuffer(params);
    vec4 previous = ReadSimpleDdgiBlendIrradianceTexel(irradianceReadBuffer, physicalProbeIndex, texel, params.irradianceTexels);
    if (freshUpdate && SimpleDdgiLuminance(irradiance) <= 0.000001)
    {
        WriteSimpleDdgiBlendIrradianceTexel(irradianceWriteBuffer, physicalProbeIndex, texel, params.irradianceTexels, vec4(0.0));
        return 1.0;
    }
    float texelHysteresis = SimpleDdgiAdaptiveIrradianceHysteresis(params, previous, irradiance, probeHysteresis, maintenanceUpdate);
    vec4 blended = mix(vec4(irradiance, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    if (SimpleDdgiLuminance(irradiance) > 0.00001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_NONZERO_IRRADIANCE_PROBE_COUNTER, 1u);
    if (probeHysteresis > 0.0001 && previous.w > 0.0001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_PREVIOUS_ATLAS_USED_COUNTER, 1u);
    WriteSimpleDdgiBlendIrradianceTexel(irradianceWriteBuffer, physicalProbeIndex, texel, params.irradianceTexels, blended);
    if (previous.w <= 0.0001)
        return 1.0;
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? SimpleDdgiTransportConvergenceResidual(params, irradiance, previous.rgb)
        : SimpleDdgiStableRelativeDelta(
            SimpleDdgiLuminance(irradiance),
            SimpleDdgiLuminance(previous.rgb),
            0.02);
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint localProbeOffset = gl_WorkGroupID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint requestCount = gpuScheduler
        ? SimpleDdgiSchedulerAcceptedCount(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerCountersOffsetWords)
        : params.probesToUpdate;
    if (localProbeOffset >= requestCount || params.probeCount == 0u)
        return;

    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, localProbeOffset);
    SimpleDdgiBlendOutcomeIndex = update.outcomeIndex;
    bool compactSolverBank = (pc.Flags &
        (SIMPLE_DDGI_BLEND_SOLVE_COMPACT_READ |
            SIMPLE_DDGI_BLEND_SOLVE_COMPACT_WRITE)) != 0u;
    if (compactSolverBank &&
        (pc.DispatchProbeCount == 0u ||
            update.outcomeIndex >= pc.DispatchProbeCount))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    if (!SimpleDdgiUpdateMatchesLiveAddress(params, update))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    uint physicalProbeIndex = update.physicalProbeIndex;
#if NJULF_DDGI_DETAILED_COUNTERS
    SimpleDdgiVolumePaging diagnosticPaging = ReadSimpleDdgiVolumePaging(
        pc.ParamsBufferIndex,
        update.volumeIndex);
    uint diagnosticVirtualPageIndex = diagnosticPaging.pageTableFirst +
        localProbeIndex / SIMPLE_DDGI_PROBES_PER_PAGE;
    uint diagnosticPhysicalPageIndex = physicalProbeIndex /
        SIMPLE_DDGI_PROBES_PER_PAGE;
#else
    // These identities are consumed only by detailed energy-witness telemetry.
    // Keep the production blend path free of the additional paging-table read.
    const uint diagnosticVirtualPageIndex = 0u;
    const uint diagnosticPhysicalPageIndex = 0u;
#endif
    if (!SimpleDdgiSolveVolumeMatches(
            pc.Flags,
            update.volumeIndex,
            pc.PrimaryDirectionalLightIndex))
        return;
    SimpleDdgiProbeState initialState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
            params,
            update,
            initialState))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }
    uint local = gl_LocalInvocationID.x;
    uint sweepIndex =
        pc.Flags >> SIMPLE_DDGI_BLEND_SWEEP_INDEX_SHIFT;
    bool firstSweepFirstColor =
        sweepIndex == 0u &&
        SimpleDdgiSolveIsFirstColor(pc.Flags);
    bool transportV2Active =
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u;
    bool solveColorMatches =
        SimpleDdgiSolveColorMatches(pc.Flags, volume, localProbeIndex);
    // Classification is a publication decision, not merely a gather hint.
    // Clear the private V2 target (or canonical V1 atlas) so a later publish can
    // never resurrect stale irradiance from an embedded probe. Forward gather
    // rejects the state immediately; the zeroed payload makes that invariant
    // survive readback latency, atlas mirroring, and a future reactivation.
    bool inactiveProbe =
        (initialState.flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ||
        initialState.classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE ||
        initialState.activeWeight <= 0.001;
    if (inactiveProbe)
    {
        if (!firstSweepFirstColor && !compactSolverBank)
            return;

        uint irradianceWriteBuffer = SimpleDdgiIrradianceWriteBuffer(params);
        uint irradianceTexelCount = params.irradianceTexels * params.irradianceTexels;
        for (uint texel = local; texel < irradianceTexelCount; texel += gl_WorkGroupSize.x)
        {
            WriteSimpleDdgiBlendIrradianceTexel(
                irradianceWriteBuffer,
                physicalProbeIndex,
                texel,
                params.irradianceTexels,
                vec4(0.0));
        }
        uint visibilityTexelCount = params.visibilityTexels * params.visibilityTexels;
        bool nearVisibilitySidecarActive =
            (params.flags & SIMPLE_DDGI_FLAG_NEAR_VISIBILITY_SIDECAR) != 0u &&
            SimpleDdgiVolumeUsesNearVisibilitySidecar(volume);
        uint publicNearVisibilityOffsetWords =
            SimpleDdgiVisibilityAtlasWordCount(params);
        for (uint texel = local; texel < visibilityTexelCount; texel += gl_WorkGroupSize.x)
        {
            if (gpuScheduler)
            {
                WriteSimpleDdgiVisibilityMomentsAtOffset(
                    pc.TransportWriteIrradianceAtlasBufferIndex,
                    pc.PrivateVisibilityAtlasOffsetWords,
                    physicalProbeIndex,
                    texel,
                    params.visibilityTexels,
                    vec2(0.0));
                if (nearVisibilitySidecarActive)
                {
                    WriteSimpleDdgiNearVisibilityAtOffset(
                        pc.TransportWriteIrradianceAtlasBufferIndex,
                        pc.PrivateVisibilityAtlasOffsetWords +
                            publicNearVisibilityOffsetWords,
                        physicalProbeIndex,
                        texel,
                        params,
                        vec4(65504.0, 0.0, 65504.0, 0.0));
                }
            }
            else
            {
                WriteSimpleDdgiVisibilityMoments(
                    pc.VisibilityAtlasBufferIndex,
                    physicalProbeIndex,
                    texel,
                    params.visibilityTexels,
                    vec2(0.0));
                if (nearVisibilitySidecarActive)
                {
                    WriteSimpleDdgiNearVisibilityAtOffset(
                        pc.VisibilityAtlasBufferIndex,
                        publicNearVisibilityOffsetWords,
                        physicalProbeIndex,
                        texel,
                        params,
                        vec4(65504.0, 0.0, 65504.0, 0.0));
                }
            }
        }
        barrier();
        memoryBarrierBuffer();
        barrier();
        if (local == 0u && firstSweepFirstColor)
            SimpleDdgiSchedulerCompleteSingle(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 4u);
        return;
    }
    // Relocation committed a position different from the origin used by this
    // update's rays. Do not publish a spatially mismatched atlas. The pending
    // state also keeps forward gather on its environment/coarser fallback until
    // a full retry traces from the committed position.
    if ((initialState.flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u)
    {
        if (!firstSweepFirstColor && !compactSolverBank)
            return;

        // The V2 target is intentionally private until the entire update is
        // complete. A relocation retry must therefore copy the current
        // canonical texels into that target before the CPU publishes this
        // probe range; otherwise an old target allocation could overwrite a
        // valid receiver-visible probe with unrelated data.
        if (gpuScheduler || (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u)
        {
            uint readBuffer = SimpleDdgiIrradianceReadBuffer(params);
            uint writeBuffer = SimpleDdgiIrradianceWriteBuffer(params);
            uint texelCount = params.irradianceTexels * params.irradianceTexels;
            for (uint texel = local; texel < texelCount; texel += gl_WorkGroupSize.x)
            {
                vec4 canonical = ReadSimpleDdgiBlendIrradianceTexel(readBuffer, physicalProbeIndex, texel, params.irradianceTexels);
                WriteSimpleDdgiBlendIrradianceTexel(writeBuffer, physicalProbeIndex, texel, params.irradianceTexels, canonical);
            }
            uint visibilityTexelCount = params.visibilityTexels * params.visibilityTexels;
            for (uint texel = local; texel < visibilityTexelCount; texel += gl_WorkGroupSize.x)
            {
                vec2 canonical = ReadSimpleDdgiVisibilityMoments(
                    pc.VisibilityAtlasBufferIndex,
                    physicalProbeIndex,
                    texel,
                    params.visibilityTexels);
                WriteSimpleDdgiVisibilityMomentsAtOffset(
                    writeBuffer,
                    pc.PrivateVisibilityAtlasOffsetWords,
                    physicalProbeIndex,
                    texel,
                    params.visibilityTexels,
                    canonical);
                if (gpuScheduler &&
                    (params.flags &
                        SIMPLE_DDGI_FLAG_NEAR_VISIBILITY_SIDECAR) != 0u &&
                    SimpleDdgiVolumeUsesNearVisibilitySidecar(volume))
                {
                    uint publicNearVisibilityOffsetWords =
                        SimpleDdgiVisibilityAtlasWordCount(params);
                    vec4 canonicalNearVisibility =
                        ReadSimpleDdgiNearVisibilityAtOffset(
                            pc.VisibilityAtlasBufferIndex,
                            publicNearVisibilityOffsetWords,
                            physicalProbeIndex,
                            texel,
                            params);
                    WriteSimpleDdgiNearVisibilityAtOffset(
                        writeBuffer,
                        pc.PrivateVisibilityAtlasOffsetWords +
                            publicNearVisibilityOffsetWords,
                        physicalProbeIndex,
                        texel,
                        params,
                        canonicalNearVisibility);
                }
            }
        }
        barrier();
        memoryBarrierBuffer();
        barrier();
        if (local == 0u && firstSweepFirstColor)
            SimpleDdgiSchedulerCompleteSingle(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 4u);
        return;
    }
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    bool maintenanceUpdate = SimpleDdgiUpdateIsMaintenance(update);
    bool freshUpdate = firstSweepFirstColor &&
        ((update.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u ||
         (initialState.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u);
    float probeHysteresis = freshUpdate
        ? 0.0
        : SimpleDdgiCadenceAdjustedHysteresis(params, update);
    // The reduced SH projection is intentionally a V1-only estimator.  Its
    // signed reconstruction is useful as a bandwidth fallback, but it is not
    // the positive operator that the V2 tail audit certifies.  Keep the
    // quality-tier flag for V1 and force every certified V2 update through the
    // exact cosine-weighted estimator below.
    bool reducedComplexityEnabled =
        (pc.Flags & SIMPLE_DDGI_BLEND_FLAG_REDUCED_COMPLEXITY) != 0u &&
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) == 0u;
    // Packed scratch no longer stores direction. Reconstruct each ray exactly
    // once into workgroup shared memory for both atlas estimators.
    bool sharedRayCacheEnabled = true;
    // V2 solver-only updates reuse the same geometric source rays. Preserve
    // their published visibility moments; rebuilding them from cached
    // frontface distances would erase the two-sided shell occlusion recorded
    // by the most recent source refresh. The first color evaluates visibility
    // for the entire queue, including probes whose irradiance parity is the
    // opposite color, so every source-refresh participant is covered once.
    bool refreshVisibility =
        !transportV2Active ||
        (firstSweepFirstColor &&
            (SimpleDdgiUpdateRequiresSourceRefresh(update) ||
             freshUpdate));
    bool visibilityHistoryValid =
        (initialState.flags & SIMPLE_DDGI_PROBE_FLAG_VISIBILITY_VALID) != 0u &&
        !freshUpdate;
    if (!solveColorMatches && !refreshVisibility)
    {
        // Scheduler lifecycle completion is a sweep-zero/color-zero event for
        // the whole accepted queue, including probes whose irradiance parity
        // is color one. Their transport and irradiance commands execute later
        // in this sweep, before CommitLocal; recording this bit here avoids
        // repeating lifecycle work while still requiring every producer bit.
        if (gpuScheduler && firstSweepFirstColor && local == 0u)
            SimpleDdgiSchedulerCompleteSingle(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 4u);
        return;
    }

    LoadSimpleRayCache(
        params,
        volume,
        update,
        probeIndex,
        localProbeOffset,
        activeRayCount);
    uint projectionRayCount = min(
        transportV2Active
            ? SimpleDdgiUpdateSourceRayCount(update, params)
            : activeRayCount,
        SIMPLE_DDGI_MAX_RAYS_PER_PROBE);

    bool rayCacheValid = SharedSimpleRayInvalid == 0u;
    if (!rayCacheValid)
    {
        if (local == 0u)
        {
            if (gpuScheduler)
            {
                SimpleDdgiSchedulerFailOutcome(
                    pc.SchedulerArenaBufferIndex,
                    pc.SchedulerOutcomesOffsetWords,
                    update.outcomeIndex,
                    1u << 1u);
            }
            else
            {
                // CPU scheduling has no private commit gate. Keep this probe
                // fresh and invalidate precisely the payload that failed so
                // malformed ray scratch can never be published as a valid
                // zero-light update.
                SimpleDdgiProbeState state = ReadSimpleDdgiProbeState(
                    pc.ProbeStateBufferIndex,
                    probeIndex);
                if (SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
                        params,
                        update,
                        state))
                {
                    state.flags |= SIMPLE_DDGI_PROBE_FLAG_FRESH;
                    if (!rayCacheValid)
                    {
                        state.flags &=
                            ~SIMPLE_DDGI_PROBE_FLAG_VISIBILITY_VALID;
                    }
                    if (transportV2Active)
                    {
                        state.flags |=
                            SIMPLE_DDGI_PROBE_FLAG_SOURCE_CACHE_INVALID;
                    }
                    WriteSimpleDdgiProbeState(
                        pc.ProbeStateBufferIndex,
                        probeIndex,
                        state);
                }
            }
        }
        return;
    }

    if (gpuScheduler && firstSweepFirstColor &&
        SimpleDdgiUpdateRequiresSourceRefresh(update))
    {
        PublishSimpleDdgiQuadratureWitness(update, projectionRayCount);
    }

    if (local == 0u && (!transportV2Active || firstSweepFirstColor))
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_PROBE_COUNTER, 1u);
        if (probeHysteresis <= 0.0001)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_HYSTERESIS_ZERO_FRAME_COUNTER, 1u);
    }

    float localIrradianceDelta = 0.0;
    if (reducedComplexityEnabled)
    {
        if (solveColorMatches && local == 0u)
            BuildReducedSimpleDdgiIrradiance(
                params,
                localProbeOffset,
                projectionRayCount);
        barrier();

        if (solveColorMatches)
        {
            for (uint texel = local; texel < params.irradianceTexels * params.irradianceTexels; texel += gl_WorkGroupSize.x)
            {
                float texelDelta = BlendReducedIrradianceTexel(
                    params,
                    update.volumeIndex,
                    probeIndex,
                    diagnosticVirtualPageIndex,
                    physicalProbeIndex,
                    diagnosticPhysicalPageIndex,
                    update.sourceLightingGeneration,
                    texel,
                    probeHysteresis,
                    maintenanceUpdate,
                    freshUpdate);
                localIrradianceDelta = max(localIrradianceDelta, texelDelta);
            }
        }

        if (refreshVisibility)
        {
            for (uint texel = local; texel < params.visibilityTexels * params.visibilityTexels; texel += gl_WorkGroupSize.x)
                BlendVisibilityTexel(
                    params,
                    volume,
                    physicalProbeIndex,
                    localProbeOffset,
                    texel,
                    probeHysteresis,
                    true,
                    projectionRayCount,
                    maintenanceUpdate,
                    freshUpdate,
                    visibilityHistoryValid);
        }
    }
    else
    {
        if (solveColorMatches)
        {
            for (uint texel = local; texel < params.irradianceTexels * params.irradianceTexels; texel += gl_WorkGroupSize.x)
            {
                float texelDelta = BlendIrradianceTexel(
                    params,
                    update.volumeIndex,
                    probeIndex,
                    diagnosticVirtualPageIndex,
                    physicalProbeIndex,
                    diagnosticPhysicalPageIndex,
                    update.sourceLightingGeneration,
                    localProbeOffset,
                    texel,
                    probeHysteresis,
                    sharedRayCacheEnabled,
                    projectionRayCount,
                    maintenanceUpdate,
                    freshUpdate);
                localIrradianceDelta = max(localIrradianceDelta, texelDelta);
            }
        }

        if (refreshVisibility)
        {
            for (uint texel = local; texel < params.visibilityTexels * params.visibilityTexels; texel += gl_WorkGroupSize.x)
                BlendVisibilityTexel(params, volume, physicalProbeIndex, localProbeOffset, texel, probeHysteresis, sharedRayCacheEnabled, projectionRayCount, maintenanceUpdate, freshUpdate, visibilityHistoryValid);
        }
    }

    SharedSimpleIrradianceDelta[local] = localIrradianceDelta;
    barrier();

    // Publishing the probe state is the commit point for gather. Ensure every
    // invocation's irradiance and visibility SSBO writes are available before
    // the FRESH gate can be cleared by invocation zero.
    memoryBarrierBuffer();
    barrier();

    if (!solveColorMatches)
    {
        if (local == 0u)
        {
            SimpleDdgiProbeState state =
                ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
            if (SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
                    params,
                    update,
                    state))
            {
                if (gpuScheduler && firstSweepFirstColor)
                {
                    SimpleDdgiSchedulerCompleteSingle(
                        pc.SchedulerArenaBufferIndex,
                        pc.SchedulerOutcomesOffsetWords,
                        update.outcomeIndex,
                        1u << 4u);
                }
                else if (!gpuScheduler && freshUpdate)
                {
                    if (refreshVisibility)
                        state.flags |= SIMPLE_DDGI_PROBE_FLAG_VISIBILITY_VALID;
                    state.flags &= ~SIMPLE_DDGI_PROBE_FLAG_FRESH;
                    WriteSimpleDdgiProbeState(
                        pc.ProbeStateBufferIndex,
                        probeIndex,
                        state);
                }
            }
            else if (gpuScheduler)
            {
                SimpleDdgiSchedulerFailOutcome(
                    pc.SchedulerArenaBufferIndex,
                    pc.SchedulerOutcomesOffsetWords,
                    update.outcomeIndex,
                    1u << 0u);
            }
        }
        return;
    }

    if (local == 0u)
    {
        float aggregateIrradianceDelta = 0.0;
        uint irradianceTexelCount = min(params.irradianceTexels * params.irradianceTexels, 64u);
        for (uint texel = 0u; texel < irradianceTexelCount; texel++)
        {
            if (transportV2Active)
            {
                aggregateIrradianceDelta = max(
                    aggregateIrradianceDelta,
                    SharedSimpleIrradianceDelta[texel]);
            }
            else
            {
                aggregateIrradianceDelta +=
                    SharedSimpleIrradianceDelta[texel];
            }
        }
        if (!transportV2Active)
        {
            aggregateIrradianceDelta /=
                max(float(irradianceTexelCount), 1.0);
        }
        SimpleDdgiProbeState state = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
        if (SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
                params,
                update,
                state))
        {
            // Fast attack prevents a newly arrived bounce from hiding below the
            // three-sample stability window. The decaying peak retains bounded
            // noise rejection while never understating the current defect.
            if (transportV2Active)
            {
                float previousResidualEnvelope =
                    isnan(state.luminanceChangeEma) ||
                    isinf(state.luminanceChangeEma) ||
                    state.luminanceChangeEma < 0.0
                        ? 1.0
                        : clamp(state.luminanceChangeEma, 0.0, 1.0);
                state.luminanceChangeEma = mix(
                    0.0,
                    previousResidualEnvelope,
                    SIMPLE_DDGI_TRANSPORT_RESIDUAL_ENVELOPE_DECAY);
                state.luminanceChangeEma = max(
                    clamp(aggregateIrradianceDelta, 0.0, 1.0),
                    state.luminanceChangeEma);
            }
            else
            {
                state.luminanceChangeEma = mix(
                    max(state.luminanceChangeEma, 0.0),
                    clamp(aggregateIrradianceDelta, 0.0, 8.0),
                    0.20);
            }
            if (gpuScheduler)
            {
                WriteStorageFloatUniform(
                    pc.SchedulerArenaBufferIndex,
                    pc.SchedulerOutcomesOffsetWords + update.outcomeIndex * SIMPLE_DDGI_SCHEDULER_OUTCOME_WORDS + 14u,
                    aggregateIrradianceDelta);
            }
            else
            {
                if (refreshVisibility)
                    state.flags |= SIMPLE_DDGI_PROBE_FLAG_VISIBILITY_VALID;
                if (freshUpdate)
                    state.flags &= ~SIMPLE_DDGI_PROBE_FLAG_FRESH;
                WriteSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex, state);
            }
        }
        else if (gpuScheduler)
        {
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 0u);
        }
        if (gpuScheduler &&
            firstSweepFirstColor &&
            SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
                params,
                update,
                state))
            SimpleDdgiSchedulerCompleteSingle(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 4u);
    }
}

#undef AddRendererDiagnostic
