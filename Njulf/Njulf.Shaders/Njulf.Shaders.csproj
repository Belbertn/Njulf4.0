        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_general_complete_final.comp">
