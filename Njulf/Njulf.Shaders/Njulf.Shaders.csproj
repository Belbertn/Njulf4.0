        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_guided_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>1</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1 -DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_guided_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>1</StorageMode><Role>2</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1 -DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_guided_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>1</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1 -DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_guided_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_guided_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>2</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_guided_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <!-- Release trace fast paths. Reuse is content-independent and keeps the
           canonical packed_reuse program; only source/final ray work is
           specialized. Every artifact is prewarmed before frame execution. -->
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_general_complete_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_general_complete_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_general_split_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_general_split_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_complete_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_complete_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_split_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_split_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_sun_complete_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1 -DSIMPLE_DDGI_TRACE_NO_LOCAL_LIGHTS=1 -DSIMPLE_DDGI_TRACE_NO_EMISSIVE_SOURCES=1 -DSIMPLE_DDGI_TRACE_ONE_DIRECTIONAL_LIGHT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_sun_complete_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1 -DSIMPLE_DDGI_TRACE_NO_LOCAL_LIGHTS=1 -DSIMPLE_DDGI_TRACE_NO_EMISSIVE_SOURCES=1 -DSIMPLE_DDGI_TRACE_ONE_DIRECTIONAL_LIGHT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_sun_split_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1 -DSIMPLE_DDGI_TRACE_NO_LOCAL_LIGHTS=1 -DSIMPLE_DDGI_TRACE_NO_EMISSIVE_SOURCES=1 -DSIMPLE_DDGI_TRACE_ONE_DIRECTIONAL_LIGHT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_opaque_sun_split_final.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>2</StorageMode><Role>3</Role>
        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=2 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1 -DSIMPLE_DDGI_TRACE_NO_LOCAL_LIGHTS=1 -DSIMPLE_DDGI_TRACE_NO_EMISSIVE_SOURCES=1 -DSIMPLE_DDGI_TRACE_ONE_DIRECTIONAL_LIGHT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_legacy.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_validate.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_packed.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>2</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_legacy.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_validate.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_packed.comp">
        <Source>ddgi_simple_transport.comp</Source>
        <StorageMode>2</StorageMode>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_guided_legacy.comp">
        <Source>ddgi_simple_transport.comp</Source><StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_guided_validate.comp">
        <Source>ddgi_simple_transport.comp</Source><StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1 -DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_guided_packed.comp">
        <Source>ddgi_simple_transport.comp</Source><StorageMode>2</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_guided_legacy.comp">
        <Source>ddgi_simple_transport.comp</Source><StorageMode>1</StorageMode>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_guided_validate.comp">
