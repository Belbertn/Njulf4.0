#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_ray_query : require

#include "common.glsl"
#include "ddgi_simple_shared.glsl"
#include "farfield_clipmap.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform accelerationStructureEXT SceneTlas;

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint Padding0;
} pc;

const float PI = SIMPLE_DDGI_PI;
const uint DDGI_AUTHORED_VOLUME_CASCADE = 0xffffffffu;
const uint DDGI_MATERIAL_TEXTURE_DISABLED_CASCADE = 4u;
const float DDGI_PROBE_TRACE_EPSILON = 0.02;
const float DDGI_DIRECTIONAL_SHADOW_RAY_DISTANCE = 256.0;

#define DDGI_HIT_USE_SELECTED_LIGHTS 0
#define DDGI_HIT_ENABLE_ENVIRONMENT_WRAPPER 0
#define DDGI_HIT_DIRECT_LIGHT_CAP pc.MaxShadedLights
#include "ddgi_hit_shading.glsl"

void WriteSimpleRayResult(uint rayResultIndex, vec3 radiance, float distance, vec3 direction, float hitKind)
{
    uint baseWord = rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS;
    WriteStorageVec4(pc.RayResultScratchBufferIndex, baseWord + 0u, vec4(clamp(radiance, vec3(0.0), vec3(65504.0)), distance));
    WriteStorageVec4(pc.RayResultScratchBufferIndex, baseWord + 4u, vec4(direction, hitKind));
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint globalRay = gl_GlobalInvocationID.x;
    uint totalRays = params.probesToUpdate * params.raysPerProbe;
    if (globalRay >= totalRays || params.probeCount == 0u)
        return;

    uint updateProbeOffset = globalRay / params.raysPerProbe;
    uint rayIndex = globalRay - updateProbeOffset * params.raysPerProbe;
    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, updateProbeOffset);
    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
        return;

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
        return;
    vec3 probePosition = SimpleDdgiProbeRelocatedPosition(probeIndex, volume, localProbeIndex);
    vec3 direction = SimpleDdgiFibonacciDirection(rayIndex, params.raysPerProbe, params.rayRotation);
    float maxDistance = max(volume.spacing * float(max(max(volume.gridCount.x, volume.gridCount.y), volume.gridCount.z)), volume.spacing);
    vec3 radiance = SampleDdgiEnvironmentMissRadianceWithFallback(direction, params.environmentRadiance);
    float hitDistance = maxDistance;
    float hitKind = 0.0;

    if (((pc.Flags & SIMPLE_DDGI_FLAG_FAR_FIELD_ENABLED) != 0u) &&
        (((pc.Flags & SIMPLE_DDGI_FLAG_FAR_FIELD_FORCE_ALL) != 0u) || maxDistance > params.farFieldStartDistance))
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_RAY_COUNTER, 1u);
        vec3 farNormal;
        vec3 farAlbedo;
        bool farStepExhausted;
        uint farVisitedSteps;
        if (TraceFarFieldClipmapDetailed(probePosition, direction, params.farFieldStartDistance, maxDistance, hitDistance, farNormal, farAlbedo, farStepExhausted, farVisitedSteps))
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_HIT_COUNTER, 1u);
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_FAR_FIELD_HIT_COUNTER, 1u);
            vec3 hitPosition = probePosition + direction * hitDistance;
            vec3 directNoShadowDiffuse;
            vec3 safeFarNormal = normalize(farNormal);
            radiance = EvaluateDirectDiffuseRadianceAtHit(hitPosition, safeFarNormal, farAlbedo, directNoShadowDiffuse);
            hitKind = dot(direction, safeFarNormal) > 0.0 ? 2.0 : 1.0;
        }
        else if (farStepExhausted)
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_STEP_EXHAUSTED_COUNTER, 1u);
        }

        if (hitKind < 0.5)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_FAR_FIELD_MISS_COUNTER, 1u);
    }

    if (hitKind < 0.5)
    {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, SceneTlas, gl_RayFlagsOpaqueEXT, 0xff, probePosition, 0.02, direction, maxDistance);
        while (rayQueryProceedEXT(query))
        {
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT)
        {
            hitDistance = rayQueryGetIntersectionTEXT(query, true);
            uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
            uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
            vec3 hitPosition = probePosition + direction * hitDistance;
            vec3 surfaceNormal;
            vec3 surfaceAlbedo;
            vec3 surfaceEmissive;
            bool sampleMaterialTextures = ShouldSampleDdgiMaterialTextures(0u);
            if (ResolveCommittedHitSurface(
                instanceIndex,
                primitiveIndex,
                barycentrics,
                direction,
                0u,
                sampleMaterialTextures,
                0.0,
                surfaceNormal,
                surfaceAlbedo,
                surfaceEmissive))
            {
                vec3 bounce = SampleSimpleDdgiIrradiance(hitPosition + surfaceNormal * 0.03, surfaceNormal, -direction) * surfaceAlbedo / SIMPLE_DDGI_PI;
                vec3 directNoShadowDiffuse;
                vec3 directDiffuse = EvaluateDirectDiffuseRadianceAtHit(hitPosition, surfaceNormal, surfaceAlbedo, directNoShadowDiffuse);
                vec3 emissiveProxyDiffuse = EvaluateSelectedDdgiEmissiveDiffuseRadianceAtHit(hitPosition, surfaceNormal, surfaceAlbedo);
                radiance = surfaceEmissive + emissiveProxyDiffuse + directDiffuse + bounce;
                if (dot(max(directDiffuse, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) > 0.0001)
                    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_DIRECT_LIGHT_HIT_COUNTER, 1u);
                if (dot(max(surfaceEmissive + emissiveProxyDiffuse, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) > 0.0001)
                    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_EMISSIVE_HIT_COUNTER, 1u);
                hitKind = dot(direction, surfaceNormal) > 0.0 ? 2.0 : 1.0;
            }
        }
    }

    if (hitKind >= 0.5)
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_HIT_COUNTER, 1u);
        if (dot(max(radiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) <= 0.0001)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_ZERO_RADIANCE_HIT_COUNTER, 1u);
    }
    else
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_MISS_COUNTER, 1u);
    }

    WriteSimpleRayResult(globalRay, radiance, hitDistance, direction, hitKind);
}
