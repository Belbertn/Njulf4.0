<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
      <ShaderSource Include="*.task;*.mesh;*.vert;*.frag;*.comp" />
      <!-- NVIDIA's native compiler rejects the fully unoptimized Debug IR for
           the directional prepare/project/publish sequence even though SPIR-V
           validation succeeds. Optimize only these isolated modules in Debug
           while retaining detailed DDGI counters and validation behavior. -->
      <ShaderSource Update="ddgi_simple_directional_prepare.comp;ddgi_simple_directional_project.comp;ddgi_simple_directional_publish.comp">
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </ShaderSource>
      <ShaderInclude Include="*.glsl" />
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_source.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>1</Role>
      </SimpleDdgiTraceShaderVariant>
      <!-- Reuse contains no ray-query program but shares the large transport
           include graph. Debug glslang otherwise retains unreachable helper IR
           that the NVIDIA native compiler rejects during pipeline creation.
           Size optimization removes only unreachable/redundant SPIR-V while
           preserving the Debug detailed-counter contract. Source/final roles
           keep their separately specialized control flow. -->
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>2</Role>
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_final.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>3</Role>
      </SimpleDdgiTraceShaderVariant>
      <!-- Validate retains the Legacy36/32-byte rollback ABI. Specialize its
           native-driver program to that single representation and opt only
           the detailed-build direction shadow comparison back in. -->
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_source.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>1</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>2</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_validate_final.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>1</StorageMode>
        <Role>3</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_source.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>1</Role>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>2</Role>
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_packed_final.comp">
        <Source>ddgi_simple_trace.comp</Source>
        <StorageMode>2</StorageMode>
        <Role>3</Role>
      </SimpleDdgiTraceShaderVariant>
      <!-- C3 trace consumers are distinct native programs. Ordinary DDGI
           never probes the slot-203 fallback and admitted C3 can be tied to an
           exact shader hash/ABI without changing the baseline binaries. -->
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_guided_source.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>1</StorageMode><Role>1</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_guided_reuse.comp">
        <Source>ddgi_simple_trace.comp</Source><StorageMode>1</StorageMode><Role>2</Role>
        <Defines>-DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
        <AdditionalCompileOptions Condition="'$(Configuration)' == 'Debug'">-Os</AdditionalCompileOptions>
      </SimpleDdgiTraceShaderVariant>
      <SimpleDdgiTraceShaderVariant Include="ddgi_simple_trace_legacy_guided_final.comp">
