#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require

#include "common.glsl"

#ifdef FOLIAGE_MOTION_COMPACTED_MESH
#define FOLIAGE_MOTION_LOCAL_SIZE 64
#define FOLIAGE_MOTION_MAX_VERTICES 48
#define FOLIAGE_MOTION_MAX_PRIMITIVES 64
#else
#define FOLIAGE_MOTION_LOCAL_SIZE 128
#define FOLIAGE_MOTION_MAX_VERTICES 64
#define FOLIAGE_MOTION_MAX_PRIMITIVES 126
#endif
layout(local_size_x = FOLIAGE_MOTION_LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = FOLIAGE_MOTION_MAX_VERTICES, max_primitives = FOLIAGE_MOTION_MAX_PRIMITIVES) out;

#ifndef FOLIAGE_MOTION_COMPACTED_MESH
struct FoliageMotionPayload
{
    uint DrawCommandIndex;
    uint Visible;
};

taskPayloadSharedEXT FoliageMotionPayload foliageMotionPayload;
#endif

layout(location = 0) noperspective out vec2 meshCurrentUv[];
layout(location = 1) noperspective out vec2 meshPreviousUv[];
layout(location = 2) out vec2 meshTexCoord[];
layout(location = 3) flat out uint meshMaterialIndex[];
layout(location = 4) flat out uint meshReceiverSignature[];
layout(location = 5) flat out uint meshHistoryFrameAndFlags[];
layout(location = 6) flat out uint meshClusterIndex[];
layout(location = 7) flat out uint meshLodBand[];
layout(location = 8) flat out uint meshGeometryMode[];
layout(location = 9) flat out uint meshImpostorMetadataIndex[];

layout(push_constant) uniform MotionVectorPushConstantBlock
{
    GPUMotionVectorPushConstants Push;
} pc;

vec2 ClipToUv(vec4 clip)
{
    vec2 ndc = clip.xy / max(abs(clip.w), 0.000001);
    return ndc * 0.5 + vec2(0.5);
}

vec3 ApplyAuthoredFoliageWindAtTime(
    vec3 worldPosition,
    GPUFoliageInstance instance,
    GPUFoliagePrototype prototype,
    float time)
{
    float strength = prototype.WindParams.x;
    if (strength <= 0.0)
        return worldPosition;

    float frequency = max(0.01, prototype.WindParams.y);
    float flutter = prototype.WindParams.z;
    float phase = dot(worldPosition.xz, vec2(0.137, 0.173)) +
        instance.RotationWind.y * 6.28318530718 +
        time * frequency;
    float sway = sin(phase) * strength;
    float leafFlutter = sin(phase * 3.1 + instance.RotationWind.y * 17.0) * flutter * strength;
    return worldPosition + vec3(sway + leafFlutter, leafFlutter * 0.15, sway * 0.45) * 0.05;
}

vec3 TransformFoliagePointAtTime(vec3 localPosition, GPUFoliageInstance instance, GPUFoliagePrototype prototype, float time)
{
    float yawSin = sin(instance.RotationWind.x);
    float yawCos = cos(instance.RotationWind.x);
    vec3 scaled = localPosition * max(instance.PositionScale.w, 0.0001);
    scaled.xz = vec2(
        scaled.x * yawCos - scaled.z * yawSin,
        scaled.x * yawSin + scaled.z * yawCos);
    vec3 up = vec3(0.0, 1.0, 0.0);
    if ((instance.Flags & 1u) != 0u)
    {
        float normalY = sqrt(max(
            0.0,
            1.0 - instance.RotationWind.z * instance.RotationWind.z -
                instance.RotationWind.w * instance.RotationWind.w));
        up = normalize(vec3(
            instance.RotationWind.z,
            normalY,
            instance.RotationWind.w));
    }
    vec3 right = cross(up, vec3(0.0, 0.0, 1.0));
    right = dot(right, right) > 0.000001
        ? normalize(right)
        : vec3(1.0, 0.0, 0.0);
    vec3 forward = normalize(cross(right, up));
    vec3 worldPosition = instance.PositionScale.xyz +
        right * scaled.x + up * scaled.y + forward * scaled.z;
    return ApplyAuthoredFoliageWindAtTime(worldPosition, instance, prototype, time);
}

void main()
{
#ifdef FOLIAGE_MOTION_COMPACTED_MESH
    uint drawCommandIndex = gl_WorkGroupID.x + pc.Push.FirstDraw;
    if (gl_WorkGroupID.x >= pc.Push.MeshletDrawCount)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
#else
    if (foliageMotionPayload.Visible == 0u)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint drawCommandIndex = foliageMotionPayload.DrawCommandIndex;
#endif

    GPUFoliageMeshletDrawCommand command = ReadFoliageMeshletDrawCommand(
        pc.Push.CurrentFrameIndex,
        drawCommandIndex);
    if (command.MeshletIndex == 0xffffffffu)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }

    GPUMeshlet meshlet = ReadMeshlet(
        command.MeshletIndex,
        pc.Push.CurrentFrameIndex);
    GPUFoliagePrototype prototype = ReadFoliagePrototype(command.PrototypeIndex);
    uint previousFrameIndex = (pc.Push.CurrentFrameIndex + 1u) % uint(FRAMES_IN_FLIGHT);
    GPUFoliageInstance currentInstance = ReadFoliageInstance(pc.Push.CurrentFrameIndex, command.InstanceIndex);
    GPUFoliageInstance previousInstance = ReadFoliageInstance(previousFrameIndex, command.InstanceIndex);

    if (gl_LocalInvocationIndex == 0u)
        SetMeshOutputsEXT(meshlet.LocalVertexCount, meshlet.LocalTriangleCount);

    barrier();

    for (uint vertexSlot = gl_LocalInvocationIndex;
         vertexSlot < meshlet.LocalVertexCount;
         vertexSlot += gl_WorkGroupSize.x)
    {
        uint localVertexIndex = ReadMeshletLocalVertexIndex(
            meshlet,
            vertexSlot);
        GPUVertex vertex = ReadSplitVertex(meshlet.VertexOffset + localVertexIndex);
        vec3 currentWorldPosition = TransformFoliagePointAtTime(vertex.Position, currentInstance, prototype, pc.Push.Time);
        vec3 previousWorldPosition = TransformFoliagePointAtTime(vertex.Position, previousInstance, prototype, pc.Push.PreviousTime);
        vec4 currentClip = MulRowMajor(vec4(currentWorldPosition, 1.0), pc.Push.ViewProjectionMatrix);
        vec4 previousClip = MulRowMajor(vec4(previousWorldPosition, 1.0), pc.Push.PreviousViewProjectionMatrix);

        gl_MeshVerticesEXT[vertexSlot].gl_Position = currentClip;
        meshCurrentUv[vertexSlot] = ClipToUv(currentClip);
        meshPreviousUv[vertexSlot] = (pc.Push.PreviousFrameValid & 1u) != 0u
            ? ClipToUv(previousClip)
            : meshCurrentUv[vertexSlot];
        meshTexCoord[vertexSlot] = vertex.TexCoord;
        meshMaterialIndex[vertexSlot] = command.MaterialIndex;
        meshReceiverSignature[vertexSlot] =
            (command.InstanceIndex * 0x9e3779b9u) ^
            (command.MaterialIndex * 0x85ebca6bu) ^ 0xa511e9b3u;
        meshHistoryFrameAndFlags[vertexSlot] =
            (pc.Push.CurrentFrameIndex & 0xffu) |
            ((pc.Push.PreviousFrameValid & 2u) << 7u);
        meshClusterIndex[vertexSlot] = command.ClusterIndex;
        meshLodBand[vertexSlot] =
            PackFoliageCoverageStateFromCommand(
                command.LodLevel,
                command.Flags);
        meshGeometryMode[vertexSlot] = 1u;
        meshImpostorMetadataIndex[vertexSlot] = 0xffffffffu;
    }

    for (uint triangleSlot = gl_LocalInvocationIndex;
         triangleSlot < meshlet.LocalTriangleCount;
         triangleSlot += gl_WorkGroupSize.x)
    {
        uint triangleOffset = triangleSlot * 3u;
        uint i0 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 0u);
        uint i1 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 1u);
        uint i2 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 2u);
        gl_PrimitiveTriangleIndicesEXT[triangleSlot] = uvec3(i0, i1, i2);
    }
}
