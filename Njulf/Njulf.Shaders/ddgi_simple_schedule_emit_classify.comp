#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint EmitBucketCount = 6u;
shared uint WorkgroupBucketCounts[6];

uint EmitBucketScratchWord(uint groupIndex, uint bucket)
{
    return pc.CandidateGroupLaneCountsOffsetWords +
        groupIndex * EmitBucketCount + bucket;
}

uint ResolveEmitBucket(uint rayCount)
{
    for (uint bucket = 0u; bucket < EmitBucketCount; bucket++)
    {
        if (rayCount == SchedulerFrame(32u + bucket))
            return bucket;
    }
    return EmitBucketCount;
}

void main()
{
    uint localIndex = gl_LocalInvocationID.x;
    uint updateIndex = gl_GlobalInvocationID.x;
    uint groupIndex = gl_WorkGroupID.x;

    if (localIndex < EmitBucketCount)
        WorkgroupBucketCounts[localIndex] = 0u;
    barrier();

    bool transactionValid = SchedulerArenaRead(
        pc.CountersOffsetWords +
            SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW) == 0u;
    uint accepted = transactionValid
        ? min(
            SchedulerArenaRead(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_ACCEPTED),
            SchedulerRequestCapacity())
        : 0u;

    if (transactionValid && updateIndex == 0u && SchedulerUrgentRelight())
    {
        // Low byte is incremented only by successful CommitLocal invocations.
        // The cap is 255, so that atomic cannot carry into the accepted byte.
        uint telemetry = ((SchedulerFrame(12u) & 0xffffu) << 16u) |
            (min(accepted, 255u) << 8u);
        SchedulerArenaWrite(
            pc.CountersOffsetWords +
                SIMPLE_DDGI_SCHEDULER_COUNTER_URGENT_TELEMETRY,
            telemetry);
    }

    if (updateIndex < accepted)
    {
        uint probeIndex;
        uint volumeIndex;
        uint flags;
        uint metadata;
        uint sourceRayCount;
        uint sourceLightingGeneration;
        SchedulerReadUpdate(
            updateIndex,
            probeIndex,
            volumeIndex,
            flags,
            metadata,
            sourceRayCount,
            sourceLightingGeneration);
        uint rayCount = clamp(
            (flags & SIMPLE_DDGI_SCHEDULER_UPDATE_RAY_MASK) >>
                SIMPLE_DDGI_SCHEDULER_UPDATE_RAY_SHIFT,
            1u,
            SIMPLE_DDGI_SCHEDULER_MAX_RAYS);
        uint bucket = ResolveEmitBucket(rayCount);

        // CandidateOutput is dead after admission. Reuse its one-word records
        // for the immutable bucket classification consumed by stable scatter.
        SchedulerArenaWrite(
            pc.CandidateOutputOffsetWords + updateIndex,
            bucket);
        if (bucket < EmitBucketCount)
            atomicAdd(WorkgroupBucketCounts[bucket], 1u);
        else
            SchedulerArenaAtomicAdd(
                pc.CountersOffsetWords +
                    SIMPLE_DDGI_SCHEDULER_COUNTER_UNBUCKETED,
                1u);

        SchedulerWriteOutcome(
            updateIndex,
            probeIndex,
            volumeIndex,
            metadata & 0x00ffffffu,
            sourceRayCount,
            rayCount,
            flags);
        if (!SchedulerTransportV2())
        {
            SchedulerMarkOutcomeComplete(
                updateIndex,
                SIMPLE_DDGI_SCHEDULER_TRANSPORT_NOT_REQUIRED);
        }
        if (!SchedulerSampledPublicationRequired() ||
            SchedulerUrgentRelight())
        {
            SchedulerMarkOutcomeComplete(
                updateIndex,
                SIMPLE_DDGI_SCHEDULER_SAMPLED_PUBLISH_NOT_REQUIRED);
        }
    }

    barrier();
    if (localIndex < EmitBucketCount)
    {
        SchedulerArenaWrite(
            EmitBucketScratchWord(groupIndex, localIndex),
            transactionValid
                ? WorkgroupBucketCounts[localIndex]
                : 0u);
    }
}
