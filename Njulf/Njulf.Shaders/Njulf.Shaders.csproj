        <Defines>-DSIMPLE_DDGI_TRACE_FAR_FIELD_MODE=1 -DSIMPLE_DDGI_TRACE_NO_DETAILED_DIAGNOSTICS=1 -DSIMPLE_DDGI_TRACE_OPAQUE_ONLY=1</Defines>
