#if SIMPLE_DDGI_TRACE_SHADER_ROLE != SIMPLE_DDGI_TRACE_SHADER_ROLE_REUSE
vec3 EvaluateSimpleDdgiOneBounceGlossyRadiance(
    SimpleDdgiParams params,
    vec3 worldPosition,
    GiSurfaceSample surface,
    vec3 viewDirection,
    float probeSpacing)
{
    if (SimpleDdgiGlossyTransportMode(params.residencyFlags) !=
            SIMPLE_DDGI_GLOSSY_TRANSPORT_MODE_ONE_BOUNCE ||
        SimpleDdgiDirectionalRadianceMode(params.residencyFlags) ==
            SIMPLE_DDGI_DIRECTIONAL_RADIANCE_MODE_OFF)
    {
        return vec3(0.0);
    }

    float roughnessWeight = SimpleDdgiRoughSpecularWeight(
        params.residencyFlags,
        surface.Roughness);
    float nDotV = max(dot(
        surface.ShadingNormal,
        GiSafeNormal(viewDirection, surface.ShadingNormal)), 0.0);
    if (roughnessWeight <= 0.0 || nDotV <= 0.0 ||
        max(max(surface.SpecularF0.r, surface.SpecularF0.g),
            surface.SpecularF0.b) <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 reflectionDirection = reflect(
        -GiSafeNormal(viewDirection, surface.ShadingNormal),
        surface.ShadingNormal);
    SetSimpleDdgiDirectionalRadianceQuery(
        reflectionDirection,
        surface.Roughness);
    // Trace executes before this frame's blend. The separately charged parity
    // buffer is therefore the immutable previous-generation Jacobi input.
    SetSimpleDdgiDirectionalRadianceQueryBuffer(
        uint(SIMPLE_DDGI_DIRECTIONAL_RADIANCE_PARITY_BUFFER_INDEX));
    SimpleDdgiGatherResult gather = SampleSimpleDdgiGather(
        params,
        worldPosition + surface.GeometricNormal * max(
            0.03,
            probeSpacing * 0.02),
        surface.ShadingNormal,
        viewDirection,
        false);
    float confidence = clamp(
        gather.directionalRadianceSupport *
        SimpleDdgiRadiometricOwnership(gather) *
        SimpleDdgiLeakAttenuation(gather, params),
        0.0,
        1.0);
    if (confidence <= 0.0)
        return vec3(0.0);

    GPUEnvironmentData environment = ReadGiEnvironmentData();
    if (environment.BrdfLutTextureIndex < 0)
        return vec3(0.0);
    vec2 brdf = texture(
        BindlessTextures[nonuniformEXT(environment.BrdfLutTextureIndex)],
        vec2(nDotV, surface.Roughness)).rg;
    vec3 f0 = clamp(surface.SpecularF0, vec3(0.0), vec3(1.0));
    vec3 fresnel = f0 +
        (max(vec3(1.0 - surface.Roughness), f0) - f0) *
        pow(clamp(1.0 - nDotV, 0.0, 1.0), 5.0);
    vec3 glossy = gather.directionalRadiance *
        (fresnel * brdf.x + brdf.y) *
        max(environment.SpecularIntensity, 0.0) *
        confidence;
    return ApplyGiMaterialOcclusion(
        max(glossy, vec3(0.0)),
        surface.MaterialOcclusion);
}
#endif

