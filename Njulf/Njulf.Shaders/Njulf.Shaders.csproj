            Outputs="@(ShaderSource -> '$(IntermediateOutputPath)Shaders\%(Filename)%(Extension).spv');@(SimpleDdgiTraceShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiTransportShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiGuidedShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiGuidingExtractShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiAuditShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(SimpleDdgiAdmissionShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(GpuDiagnosticTaskShader -> '$(IntermediateOutputPath)Shaders\%(Filename)_diagnostics%(Extension).spv');@(GpuDiagnosticMeshShader -> '$(IntermediateOutputPath)Shaders\%(Filename)_diagnostics%(Extension).spv');@(GpuDiagnosticComputeShader -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(MaterialTransportProvenanceShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(NearFieldDirectSourceShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(ReceiverFeedbackShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');@(ReceiverFeedbackGraphicsShaderVariant -> '$(IntermediateOutputPath)Shaders\%(Identity).spv');$(IntermediateOutputPath)Shaders\forward_compacted.mesh.spv;$(IntermediateOutputPath)Shaders\forward_simple_compacted.mesh.spv;$(IntermediateOutputPath)Shaders\forward_opaque_ddgi.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_ddgi_cache_required.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_ddgi_cache_required.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_ddgi_cache_required.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_gi_disabled.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_gi_disabled.frag.spv;$(IntermediateOutputPath)Shaders\forward_opaque_simple_full_input_gi_disabled.frag.spv;$(IntermediateOutputPath)Shaders\forward_weighted_oit.frag.spv;$(IntermediateOutputPath)Shaders\foliage_forward_ddgi.frag.spv">
