      </SimpleDdgiGuidedShaderVariant>
      <SimpleDdgiGuidedShaderVariant Include="ddgi_simple_directional_project_guided.comp">
        <Source>ddgi_simple_directional_project.comp</Source>
      </SimpleDdgiGuidedShaderVariant>
      <SimpleDdgiGuidingExtractShaderVariant Include="ddgi_guiding_extract_legacy.comp">
        <Source>ddgi_guiding_extract.comp</Source>
        <StorageMode>1</StorageMode>
      </SimpleDdgiGuidingExtractShaderVariant>
      <SimpleDdgiGuidingExtractShaderVariant Include="ddgi_guiding_extract_validate.comp">
