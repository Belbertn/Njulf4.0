#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "hybrid_reflection_compute.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform HybridReflectionCompositePushBlock
{
    uint ScreenWidth;
    uint ScreenHeight;
    uint SpatialPassCount;
    uint DebugView;
    float FullResolutionRoughness;
    float HalfResolutionRoughness;
    float QuarterResolutionRoughness;
    float Padding0;
} pc;

void main()
{
    uvec2 invocation = gl_GlobalInvocationID.xy;
    if (invocation.x >= pc.ScreenWidth || invocation.y >= pc.ScreenHeight)
        return;
    ivec2 pixel = ivec2(invocation);
    uvec2 metadata = imageLoad(HybridMetadataCurrent, pixel).xy;
    bool valid = HybridMetadataValid(metadata.x);
    vec4 reflection = pc.SpatialPassCount == 0u
        ? imageLoad(HybridHistoryCurrent, pixel)
        : (pc.SpatialPassCount & 1u) != 0u
            ? imageLoad(HybridFilterScratch, pixel)
            : imageLoad(HybridRawRadiance, pixel);
    vec4 scene = imageLoad(HybridSceneColor, pixel);

    if (pc.DebugView == 17u)
    {
        uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
        vec3 roughnessInputs = vec3(0.0);
        if (HybridReflectionPayloadValid(payload))
        {
            float physical =
                HybridReflectionPayloadPhysicalRoughness(payload);
            float scheduling =
                HybridReflectionPayloadSchedulingRoughness(payload);
            roughnessInputs = vec3(
                physical,
                scheduling,
                abs(scheduling - physical));
        }
        imageStore(HybridSceneColor, pixel,
            vec4(roughnessInputs, scene.a));
        return;
    }

    if (pc.DebugView == 16u)
    {
        uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
        vec3 material = HybridReflectionPayloadValid(payload)
            ? vec3(
                HybridReflectionPayloadPhysicalRoughness(payload),
                HybridMaximumComponent(HybridReflectionPayloadF0(payload)),
                HybridReflectionPayloadSpecularOcclusion(payload))
            : vec3(0.0);
        imageStore(HybridSceneColor, pixel, vec4(material, scene.a));
        return;
    }

    if (pc.DebugView == 11u)
    {
        imageStore(HybridSceneColor, pixel,
            vec4(valid && HybridFinite(reflection)
                ? max(reflection.rgb, vec3(0.0))
                : vec3(0.0), scene.a));
        return;
    }

    if (pc.DebugView == 15u)
    {
        uvec4 payload = texelFetch(HybridReceiverPayload, pixel, 0);
        if (!HybridReflectionPayloadValid(payload))
        {
            imageStore(HybridSceneColor, pixel, vec4(vec3(0.0), scene.a));
            return;
        }
        uint lobeFlags = HybridReflectionPayloadLobeFlags(payload);
        uint tier = HybridResolveAdaptiveReflectionTier(
            HybridReflectionPayloadSchedulingRoughness(payload),
            HybridReflectionPayloadF0(payload),
            HybridReflectionPayloadSpecularOcclusion(payload),
            lobeFlags,
            pc.FullResolutionRoughness,
            pc.HalfResolutionRoughness,
            pc.QuarterResolutionRoughness);
        float updateCost = tier == 1u
            ? 1.0
            : tier == 2u
                ? 0.25
                : tier == 4u
                    ? 0.0625
                    : 0.0;
        float transmission = (lobeFlags &
            NJULF_HYBRID_REFLECTION_LOBE_TRANSMISSIVE) != 0u ? 1.0 : 0.0;
        float broadAnisotropy = (lobeFlags &
            NJULF_HYBRID_REFLECTION_LOBE_BROAD_ANISOTROPIC) != 0u ? 1.0 : 0.0;
        imageStore(HybridSceneColor, pixel,
            vec4(updateCost, transmission, broadAnisotropy, scene.a));
        return;
    }

    if (pc.DebugView == 13u)
    {
        float confidence = valid
            ? HybridMetadataConfidence(metadata.x)
            : 0.0;
        imageStore(HybridSceneColor, pixel,
            vec4(vec3(confidence), scene.a));
        return;
    }
    if (pc.DebugView == 14u)
    {
        imageStore(HybridSceneColor, pixel, vec4(
            valid ? HybridSourceDebugColor(
                HybridMetadataSource(metadata.x)) : vec3(0.0),
            scene.a));
        return;
    }
    if (pc.DebugView == 7u)
    {
        bool ssr = valid && HybridMetadataSource(metadata.x) ==
            HYBRID_REFLECTION_SOURCE_SSR;
        imageStore(HybridSceneColor, pixel,
            vec4(ssr ? vec3(0.0, 1.0, 1.0) : vec3(0.0), scene.a));
        return;
    }

    if (valid && HybridFinite(reflection))
        scene.rgb += max(reflection.rgb, vec3(0.0));
    imageStore(HybridSceneColor, pixel, scene);
}
