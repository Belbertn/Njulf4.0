const uint SIMPLE_DDGI_AUDIT_FIELD_MAGNITUDE_WORD = 1u;
const uint SIMPLE_DDGI_AUDIT_EXPECTED_PARTICIPANT_WORD = 2u;
const uint SIMPLE_DDGI_AUDIT_AUDITED_PARTICIPANT_WORD = 3u;
const uint SIMPLE_DDGI_AUDIT_EXPECTED_TEXEL_WORD = 4u;
const uint SIMPLE_DDGI_AUDIT_AUDITED_TEXEL_WORD = 5u;
const uint SIMPLE_DDGI_AUDIT_NONFINITE_WORD = 6u;
const uint SIMPLE_DDGI_AUDIT_INVALID_CACHE_WORD = 7u;
const uint SIMPLE_DDGI_AUDIT_CHUNK_WORD = 8u;
const uint SIMPLE_DDGI_AUDIT_OBSERVED_CONTRACTION_WORD = 9u;
const uint SIMPLE_DDGI_AUDIT_QUANTIZATION_FLOOR_WORD = 10u;
const uint SIMPLE_DDGI_AUDIT_EXCLUDED_INACTIVE_WORD = 11u;
const uint SIMPLE_DDGI_AUDIT_EXCLUDED_NOT_VISIBLE_WORD = 12u;
const uint SIMPLE_DDGI_AUDIT_EXCLUDED_STALE_SOURCE_WORD = 13u;
const uint SIMPLE_DDGI_AUDIT_COUNTER_OVERFLOW_WORD = 14u;
const uint SIMPLE_DDGI_AUDIT_CACHE_IDENTITY_FAILURE_WORD = 15u;
const uint SIMPLE_DDGI_AUDIT_CACHE_CARDINALITY_FAILURE_WORD = 16u;
const uint SIMPLE_DDGI_AUDIT_CACHE_SOURCE_GENERATION_FAILURE_WORD = 17u;
const uint SIMPLE_DDGI_AUDIT_CACHE_SOURCE_EPOCH_FAILURE_WORD = 18u;
const uint SIMPLE_DDGI_AUDIT_CACHE_PHYSICAL_GENERATION_FAILURE_WORD = 19u;
// A compact, race-free witness for the highest defect bucket. The upper
// twelve bits retain the monotonic high bits of the non-negative FP32 defect;
// the lower twenty bits identify one of 16,384 probes and its 8x8 texel. This
// is intentionally diagnostic rather than certificate evidence: word zero
// remains the exact maximum. Packing both values into one atomicMax prevents
// an address from a losing invocation being paired with the winning defect.
const uint SIMPLE_DDGI_AUDIT_MAXIMUM_DEFECT_WITNESS_WORD = 20u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_VALID_WORD = 21u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PROBE_WORD = 22u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_TEXEL_WORD = 23u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_WEIGHT_WORD = 24u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANDIDATE_R_WORD = 25u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANDIDATE_G_WORD = 26u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANDIDATE_B_WORD = 27u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANONICAL_R_WORD = 28u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANONICAL_G_WORD = 29u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANONICAL_B_WORD = 30u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_RESIDUAL_WORD = 31u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_SOURCE_RAYS_WORD = 32u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PRIVATE_R_WORD = 33u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PRIVATE_G_WORD = 34u;
const uint SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PRIVATE_B_WORD = 35u;
const uint SIMPLE_DDGI_AUDIT_FIRST_NOT_RESIDENT_IDENTITY_WORD = 36u;
const uint SIMPLE_DDGI_AUDIT_FIRST_STALE_SOURCE_IDENTITY_WORD = 37u;
const uint SIMPLE_DDGI_AUDIT_FIRST_INVALID_CACHE_IDENTITY_WORD = 38u;
const uint SIMPLE_DDGI_AUDIT_FIRST_NONFINITE_IDENTITY_WORD = 39u;
const uint SIMPLE_DDGI_AUDIT_WITNESS_ADDRESS_BITS = 20u;
const uint SIMPLE_DDGI_AUDIT_WITNESS_ADDRESS_MASK =
    (1u << SIMPLE_DDGI_AUDIT_WITNESS_ADDRESS_BITS) - 1u;
const uint SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY = 1u << 0u;
const uint SIMPLE_DDGI_AUDIT_CACHE_FAILURE_CARDINALITY = 1u << 1u;
const uint SIMPLE_DDGI_AUDIT_CACHE_FAILURE_SOURCE_GENERATION = 1u << 2u;
const uint SIMPLE_DDGI_AUDIT_CACHE_FAILURE_SOURCE_EPOCH = 1u << 3u;
const uint SIMPLE_DDGI_AUDIT_CACHE_FAILURE_PHYSICAL_GENERATION = 1u << 4u;
const uint SIMPLE_DDGI_AUDIT_STATUS_VALID = 1u;
const uint SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE = 2u;
const uint SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE = 3u;
const uint SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE = 4u;
const uint SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE = 5u;
const uint SIMPLE_DDGI_AUDIT_STATUS_NONFINITE = 6u;
const uint SIMPLE_DDGI_AUDIT_STATUS_MASK = 0xffu;
const uint SIMPLE_DDGI_AUDIT_STATUS_FAILURE_SHIFT = 8u;
const uint SIMPLE_DDGI_AUDIT_STATUS_FAILURE_MASK = 0x1fu;
const uint SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE_FLAG = 1u << 16u;
const uint SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE_FLAG = 1u << 17u;
const uint SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE_FLAG = 1u << 18u;
const uint SIMPLE_DDGI_AUDIT_STATUS_CONTEXT_NONFINITE_FLAG = 1u << 19u;
const uint SIMPLE_DDGI_AUDIT_STATUS_RAY_NONFINITE = 1u << 31u;
const uint SIMPLE_DDGI_AUDIT_WORKSPACE_WORDS_PER_PROBE = 1u;
const uint SIMPLE_DDGI_AUDIT_WORKSPACE_PROBE_CAPACITY = 256u;
const uint SIMPLE_DDGI_AUDIT_TRANSIENT_FLAGS =
    SIMPLE_DDGI_PROBE_FLAG_FRESH |
    SIMPLE_DDGI_PROBE_FLAG_SCROLL_EXPOSED |
    SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING |
    SIMPLE_DDGI_PROBE_FLAG_SOURCE_CACHE_INVALID;

