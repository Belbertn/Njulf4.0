#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "gi_material_transport.glsl"
#define SIMPLE_DDGI_DISABLE_SAMPLED_ATLAS 1
#define SIMPLE_DDGI_GATHER_USES_COMPUTE_STATE 1
#define SIMPLE_DDGI_DIRECTIONAL_RADIANCE_RECEIVER 1
#define SIMPLE_DDGI_PRIVATE_SOLVER_GATHER 1
// Recursive transport reads the canonical field published by the preceding
// completed update. The sampled atlas is a receiver-only accelerator and is
// intentionally not synchronized between the inner red/black solve colors.
#include "ddgi_simple_shared.glsl"
#include "ddgi_simple_transport_operator.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint SIMPLE_DDGI_TRANSPORT_SOLVE_COMPACT_READ = 1u << 21u;

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint PrivateVisibilityAtlasOffsetWords;
    uint TransportGeneration;
    uint PrimaryDirectionalLightIndex;
    uint DispatchQueueOffset;
    uint DispatchProbeCount;
    uint DispatchRaysPerProbe;
    uint SchedulerArenaBufferIndex;
    uint SchedulerRayBucketIndex;
    uint SchedulerRayBucketCommandsOffsetWords;
    uint SchedulerRayBucketMetadataOffsetWords;
    uint SchedulerOutcomesOffsetWords;
    uint SchedulerCountersOffsetWords;
    uint SchedulerUpdateRecordsOffsetWords;
} pc;

void WriteSimpleTransportRayResult(
    uint rayResultIndex,
    SimpleDdgiParams params,
    SimpleDdgiVolume volume,
    uint probeIndex,
    uint directionRayIndex,
    uint sourceEpoch,
    vec3 radiance,
    float surfaceDistance,
    float visibilityDistance,
    vec3 direction,
    float hitKind)
{
    WriteSimpleDdgiRayResultStorage(
        pc.RayResultScratchBufferIndex,
        rayResultIndex,
        volume,
        params,
        probeIndex,
        directionRayIndex,
        sourceEpoch,
        radiance,
        surfaceDistance,
        visibilityDistance,
        direction,
        hitKind);
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint dispatchRay = gl_GlobalInvocationID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint schedulerQueueOffset = 0u;
    uint schedulerProbeCount = 0u;
    uint schedulerRaysPerProbe = 0u;
    if (gpuScheduler)
    {
        SimpleDdgiResolveSchedulerRayBucket(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerRayBucketMetadataOffsetWords,
            pc.SchedulerRayBucketIndex,
            schedulerQueueOffset,
            schedulerProbeCount,
            schedulerRaysPerProbe);
    }
    uint dispatchProbeCount;
    uint dispatchRaysPerProbe;
    if (gpuScheduler)
    {
        // Resident dispatch dimensions and queue addressing are an ABI owned by
        // the emitted metadata record. Push constants are intentionally ignored
        // here so a stale per-pass batch cannot select another queue slice.
        dispatchProbeCount = schedulerProbeCount;
        dispatchRaysPerProbe = schedulerRaysPerProbe;
    }
    else
    {
        dispatchProbeCount = pc.DispatchProbeCount > 0u
            ? pc.DispatchProbeCount
            : params.probesToUpdate;
        dispatchRaysPerProbe = pc.DispatchRaysPerProbe > 0u
            ? pc.DispatchRaysPerProbe
            : params.raysPerProbe;
    }
    uint privateSolverProbeCount = gpuScheduler
        ? min(
            SimpleDdgiSchedulerAcceptedCount(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerCountersOffsetWords),
            pc.DispatchProbeCount)
        : 0u;
    ConfigureSimpleDdgiPrivateSolverGather(
        gpuScheduler &&
            (pc.Flags & SIMPLE_DDGI_TRANSPORT_SOLVE_COMPACT_READ) != 0u,
        pc.SchedulerArenaBufferIndex,
        pc.ProbeUpdateQueueBufferIndex,
        pc.DispatchQueueOffset,
        privateSolverProbeCount);
    uint dispatchRayCount = dispatchProbeCount * dispatchRaysPerProbe;
    if (dispatchRay >= dispatchRayCount || params.probeCount == 0u ||
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) == 0u)
    {
        return;
    }

    uint queueOffset = (gpuScheduler ? schedulerQueueOffset : pc.DispatchQueueOffset) +
        dispatchRay / dispatchRaysPerProbe;
    uint rayIndex = dispatchRay % dispatchRaysPerProbe;
    if (!gpuScheduler && queueOffset >= params.probesToUpdate)
        return;
    uint globalRay = queueOffset * params.raysPerProbe + rayIndex;
    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, queueOffset);
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    if (rayIndex >= activeRayCount || update.probeIndex >= params.probeCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    if (!SimpleDdgiUpdateMatchesLiveAddress(params, update))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(update.probeIndex, params, volume, localProbeIndex))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    if (!SimpleDdgiSolveVolumeMatches(
            pc.Flags,
            update.volumeIndex,
            pc.PrimaryDirectionalLightIndex))
        return;
    SimpleDdgiProbeState probeState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, update.probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
            params,
            update,
            probeState))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }
    if (!SimpleDdgiSolveColorMatches(pc.Flags, volume, localProbeIndex))
        return;

    uint sourceRayCount = SimpleDdgiUpdateSourceRayCount(update, params);
    uint directionRayIndex = SimpleDdgiUpdateDirectionRayIndex(
        rayIndex,
        activeRayCount,
        sourceRayCount,
        params);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
    bool guidingRecordPresent = false;
    SimpleDdgiGuidingTransportPayload guidingPayload;
    bool guidingPayloadValid = TryReadSimpleDdgiGuidingTransportPayload(
        update.physicalProbeIndex,
        update.probeIndex,
        update.pageMappingGeneration,
        update.sourceEpoch,
        update.sourceLightingGeneration,
        uvec2(update.probeIndex, SimpleDdgiProbeGeneration(probeState)),
        directionRayIndex,
        params.raysPerProbe,
        params.guidingPhysicalProbeCapacity,
        guidingRecordPresent,
        guidingPayload);
    if (guidingRecordPresent && !guidingPayloadValid)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 1u);
        return;
    }
#endif
    uint sourceCacheProbeGeneration = SimpleDdgiProbeGeneration(probeState);
    if (SimpleDdgiUpdateRequiresSourceRefresh(update) &&
        (update.flags & SIMPLE_DDGI_UPDATE_INVALIDATE) != 0u)
    {
        // Trace has populated the cache for the generation this transaction
        // will publish. Consume that transaction-local generation here; later
        // cached sweeps and the audit use the now-published probe generation.
        sourceCacheProbeGeneration =
            NextSimpleDdgiPhysicalGeneration(sourceCacheProbeGeneration);
    }
    SimpleDdgiTransportRayCache source;
#if SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_PACKED
    bool sourceCacheValid = ReadSimpleDdgiPackedTransportRayCacheForSolve(
            pc.TransportSourceCacheBufferIndex,
            update.cacheProbeBaseWordPlusOne & 0x7fffffffu,
            update.probeIndex,
            directionRayIndex,
            volume,
            params,
            sourceCacheProbeGeneration,
            update.sourceLightingGeneration,
            update.sourceEpoch,
            sourceRayCount,
            source);
#elif SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_LEGACY
    bool sourceCacheValid = ReadSimpleDdgiLegacyTransportRayCacheForSolve(
            pc.TransportSourceCacheBufferIndex,
            update.cacheProbeBaseWordPlusOne & 0x7fffffffu,
            update.probeIndex,
            directionRayIndex,
            volume,
            params,
            sourceCacheProbeGeneration,
            update.sourceLightingGeneration,
            update.sourceEpoch,
            sourceRayCount,
            source);
#else
    bool sourceCacheValid = ReadSimpleDdgiTransportRayCache(
            pc.ParamsBufferIndex,
            pc.TransportSourceCacheBufferIndex,
            update.volumeIndex,
            update.physicalProbeIndex,
            update.probeIndex,
            directionRayIndex,
            params,
            pc.CurrentFrameIndex,
            sourceCacheProbeGeneration,
            update.sourceLightingGeneration,
            update.sourceEpoch,
            sourceRayCount,
            source);
#endif
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
    if (sourceCacheValid && guidingPayloadValid)
        source.direction = guidingPayload.direction;
#endif
    if (!sourceCacheValid)
    {
        // A stale/corrupt cache cannot inject old energy. Preserve the source
        // scratch result (or zero if trace was skipped), then atomically request
        // a full source refresh through the next probe-state readback.
        if (gpuScheduler)
        {
#if SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_PACKED
            uint cacheReadFailureMask =
                DiagnoseSimpleDdgiPackedTransportRayCacheForSolve(
                    pc.TransportSourceCacheBufferIndex,
                    update.cacheProbeBaseWordPlusOne & 0x7fffffffu,
                    directionRayIndex,
                    volume,
                    params,
                    sourceCacheProbeGeneration,
                    update.sourceLightingGeneration,
                    update.sourceEpoch,
                    sourceRayCount);
            atomicOr(
                BindlessStorageBuffers[nonuniformEXT(
                    pc.SchedulerArenaBufferIndex)].Words[
                        pc.SchedulerCountersOffsetWords + 63u],
                cacheReadFailureMask);
#endif
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 1u);
        }
        else
            MarkSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, update.probeIndex);
        vec4 sourceRadianceDistance;
        vec3 sourceDirection;
        vec2 sourceVisibilityHit;
        uint scratchDirectionEpoch;
        bool scratchValid = ReadSimpleDdgiRayResultStorage(
            pc.RayResultScratchBufferIndex,
            globalRay,
            volume,
            params,
            update.probeIndex,
            directionRayIndex,
            update.sourceEpoch,
            sourceRadianceDistance,
            sourceDirection,
            sourceVisibilityHit,
            scratchDirectionEpoch);
        if (!scratchValid)
        {
            sourceRadianceDistance = vec4(0.0);
            sourceDirection = SimpleDdgiReconstructRayDirection(
                update.probeIndex,
                directionRayIndex,
                update.sourceEpoch,
                params);
            sourceVisibilityHit = vec2(0.0);
        }
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        if (guidingPayloadValid)
            sourceDirection = guidingPayload.direction;
#endif
        RecordSimpleDdgiTransportEnergyDiagnostics(
            params,
            pc.CurrentFrameIndex,
            update.volumeIndex,
            update.probeIndex,
            directionRayIndex,
            false,
            sourceRadianceDistance.rgb,
            vec3(0.0),
            sourceRadianceDistance.rgb,
            0u,
            0.0,
            0.0);
        WriteSimpleTransportRayResult(
            globalRay,
            params,
            volume,
            update.probeIndex,
            directionRayIndex,
            update.sourceEpoch,
            sourceRadianceDistance.rgb,
            sourceRadianceDistance.w,
            sourceVisibilityHit.x,
            sourceDirection,
            sourceVisibilityHit.y);
        if (SimpleDdgiSolveIsFinalSweep(
                pc.Flags,
                params.transportAcceleratedSweepCount))
            SimpleDdgiSchedulerRayComplete(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                activeRayCount,
                1u << 2u);
        return;
    }

#if SIMPLE_DDGI_DIRECTION_VALIDATION
    // Validate owns a Legacy36 cache and compares its stored direction at the
    // successful consumer boundary. Keeping diagnostic atomics out of the
    // defensive decoder gives native drivers the same bounded cache-read
    // control flow as Legacy while placing telemetry beside the already-proven
    // transport energy counters.
    RecordSimpleDdgiDirectionComparison(
        params,
        pc.CurrentFrameIndex,
        update.probeIndex,
        directionRayIndex,
        source.direction,
        SimpleDdgiReconstructRayDirection(
            update.probeIndex,
            directionRayIndex,
            source.sourceEpoch,
            params));
#endif

    vec3 reflectedBounceRadiance;
    vec3 transmittedBounceRadiance;
    uint solverGatherCount;
    float solverOwnershipSum;
    float solverFallbackWeightSum;
    bool malformedOperatorInput;
    vec3 enforcedThroughput;
    vec3 bounceRadiance = EvaluateSimpleDdgiCachedRecursiveBounce(
        params,
        volume,
        localProbeIndex,
        probeState,
        source,
        reflectedBounceRadiance,
        transmittedBounceRadiance,
        solverGatherCount,
        solverOwnershipSum,
        solverFallbackWeightSum,
        malformedOperatorInput,
        enforcedThroughput);
    vec3 totalRadiance = source.sourceRadiance;
    totalRadiance += bounceRadiance;
    if (malformedOperatorInput)
    {
        // A malformed operator input is a source-cache repair condition. In
        // resident mode it is transaction-private until CommitLocal rejects
        // the outcome and publishes the scheduler repair marker; mutating the
        // public cache-invalid bit here would let one ray tear the frozen
        // participant field underneath the rest of the solve epoch.
        if (gpuScheduler)
        {
            SimpleDdgiSchedulerFailOutcome(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                1u << 3u);
        }
        else
            MarkSimpleDdgiProbeSourceCacheInvalid(
                pc.ProbeStateBufferIndex,
                update.probeIndex);
        bounceRadiance = vec3(0.0);
        totalRadiance = source.sourceRadiance;
    }

    if ((params.flags & SIMPLE_DDGI_FLAG_DETAILED_DIAGNOSTICS_ENABLED) != 0u &&
        max(source.transmittedDiffuseReflectance.r,
            max(source.transmittedDiffuseReflectance.g, source.transmittedDiffuseReflectance.b)) > 0.0)
    {
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            DDGI_THIN_REFLECTED_RECURSIVE_LUMINANCE_COUNTER,
            uint(round(clamp(
                dot(max(reflectedBounceRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * DDGI_THIN_LUMINANCE_SCALE,
                0.0,
                4294967295.0))));
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            DDGI_THIN_TRANSMITTED_RECURSIVE_LUMINANCE_COUNTER,
            uint(round(clamp(
                dot(max(transmittedBounceRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * DDGI_THIN_LUMINANCE_SCALE,
                0.0,
                4294967295.0))));
    }

    RecordSimpleDdgiTransportEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        update.volumeIndex,
        update.probeIndex,
        directionRayIndex,
        true,
        source.sourceRadiance,
        bounceRadiance,
        totalRadiance,
        solverGatherCount,
        solverOwnershipSum,
        solverFallbackWeightSum);

    vec4 priorRadianceDistance;
    vec3 priorDirection;
    vec2 priorVisibilityHit;
    uint priorDirectionEpoch;
    bool priorScratchValid = ReadSimpleDdgiRayResultStorage(
        pc.RayResultScratchBufferIndex,
        globalRay,
        volume,
        params,
        update.probeIndex,
        directionRayIndex,
        update.sourceEpoch,
        priorRadianceDistance,
        priorDirection,
        priorVisibilityHit,
        priorDirectionEpoch);
    // The frozen source cache owns the exact projection classification. Keep
    // the independently traced visibility distance when available, but never
    // inherit an older/collapsed scratch hit kind into a cached solve. Audit
    // consumes this same cache classification.
    vec2 visibilityHit = vec2(
        priorScratchValid ? priorVisibilityHit.x : source.distance,
        SimpleDdgiTransportRayCacheHitKind(source));
    WriteSimpleTransportRayResult(
        globalRay,
        params,
        volume,
        update.probeIndex,
        directionRayIndex,
        update.sourceEpoch,
        totalRadiance,
        source.distance,
        visibilityHit.x,
        source.direction,
        visibilityHit.y);
    if (SimpleDdgiSolveIsFinalSweep(
            pc.Flags,
            params.transportAcceleratedSweepCount))
        SimpleDdgiSchedulerRayComplete(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            activeRayCount,
            1u << 2u);
}
