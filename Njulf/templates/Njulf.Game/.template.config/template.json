{
  "$schema": "http://json.schemastore.org/template",
  "author": "Njulf",
  "identity": "Njulf.Game",
  "name": "Njulf game (local engine checkout)",
  "shortName": "njulf-game",
  "sourceName": "NjulfGame",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "physics": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include fixed-step physics and a falling object"
    },
    "audio": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include scoped audio and a Space-triggered sound"
    },
    "engine-root": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "Absolute path to the Njulf engine checkout",
      "replaces": "NJULF_ENGINE_ROOT"
    }
  },
  "sources": [{ "modifiers": [{ "condition": "(!audio)", "exclude": ["Assets/impact.wav"] }] }]
}
