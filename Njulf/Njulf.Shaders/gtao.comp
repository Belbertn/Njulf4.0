#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D DepthTexture;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D GtaoRawOutput;
layout(rg32ui, set = 0, binding = 2) uniform writeonly uimage2D GtaoCurrentGeometryOutput;

layout(push_constant) uniform GtaoPushBlock
{
    mat4 InverseProjectionMatrix;
    mat4 ProjectionMatrix;
    vec2 SourceDimensions;
    vec2 DestinationDimensions;
    float Radius;
    float Thickness;
    float Falloff;
    float PlaneBias;
    float Intensity;
    float Power;
    uint DirectionCount;
    uint StepCount;
    uint FrameIndex;
} pc;

const float GTAO_PI = 3.14159265359;
const float GTAO_HALF_PI = 1.57079632679;

// Range-reduced minimax approximation for atan(y, x) when x is positive.
// The polynomial is evaluated only over [0, 1] and is used outside the
// horizon-search loop to recover the two bounded arc angles.
float ApproximateHorizonAngle(float y, float x)
{
    float absoluteY = abs(y);
    float maximumComponent = max(x, absoluteY);
    float minimumComponent = min(x, absoluteY);
    float ratio = minimumComponent / max(maximumComponent, 1.0e-20);
    float ratioSquared = ratio * ratio;
    float polynomial = -0.013480470;
    polynomial = polynomial * ratioSquared + 0.057477314;
    polynomial = polynomial * ratioSquared - 0.121239071;
    polynomial = polynomial * ratioSquared + 0.195635925;
    polynomial = polynomial * ratioSquared - 0.332994597;
    polynomial = polynomial * ratioSquared + 0.999995630;
    float angle = polynomial * ratio;
    if (absoluteY > x)
        angle = GTAO_HALF_PI - angle;
    return y < 0.0 ? -angle : angle;
}

float ApproximateAcos(float sineMagnitude, float cosine)
{
    float boundedCosine = clamp(cosine, -1.0, 1.0);
    float absoluteCosine = abs(boundedCosine);
    float acuteAngle = ApproximateHorizonAngle(
        sineMagnitude, max(absoluteCosine, 1.0e-20));
    return boundedCosine < 0.0 ? GTAO_PI - acuteAngle : acuteAngle;
}

bool Finite(float value)
{
    return !isnan(value) && !isinf(value);
}

bool Finite(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

float Hash(uvec3 value)
{
    uint state = value.x * 0x9e3779b9u ^ value.y * 0x85ebca6bu ^
        value.z * 0xc2b2ae35u;
    state ^= state >> 16u;
    state *= 0x7feb352du;
    state ^= state >> 15u;
    state *= 0x846ca68bu;
    state ^= state >> 16u;
    return float(state & 0x00ffffffu) / 16777216.0;
}

ivec2 ResolveDepthPixel(vec2 uv, ivec2 extent)
{
    return clamp(ivec2(floor(uv * vec2(extent))), ivec2(0),
        extent - ivec2(1));
}

vec2 DepthPixelUv(ivec2 pixel, ivec2 extent)
{
    return (vec2(pixel) + vec2(0.5)) / vec2(extent);
}

float FetchDepth(ivec2 pixel)
{
    return texelFetch(DepthTexture, pixel, 0).r;
}

vec3 ReconstructViewPosition(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    vec4 view = MulRowMajor(clip, pc.InverseProjectionMatrix);
    return view.xyz / max(abs(view.w), 1.0e-6);
}

vec2 ReconstructViewZw(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    mat4 inverseProjection = pc.InverseProjectionMatrix;
    return vec2(
        dot(clip, vec4(inverseProjection[0][2], inverseProjection[1][2],
            inverseProjection[2][2], inverseProjection[3][2])),
        dot(clip, vec4(inverseProjection[0][3], inverseProjection[1][3],
            inverseProjection[2][3], inverseProjection[3][3])));
}

float ResolveViewZ(vec2 viewZw)
{
    return viewZw.x / max(abs(viewZw.y), 1.0e-6);
}

vec3 CompleteViewPosition(
    vec2 uv,
    float depth,
    vec2 viewZw,
    float viewZ)
{
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    mat4 inverseProjection = pc.InverseProjectionMatrix;
    vec2 viewXy = vec2(
        dot(clip, vec4(inverseProjection[0][0], inverseProjection[1][0],
            inverseProjection[2][0], inverseProjection[3][0])),
        dot(clip, vec4(inverseProjection[0][1], inverseProjection[1][1],
            inverseProjection[2][1], inverseProjection[3][1])));
    return vec3(viewXy / max(abs(viewZw.y), 1.0e-6), viewZ);
}

vec3 ReconstructGeometricNormal(
    ivec2 centerPixel,
    vec3 center,
    ivec2 sourceExtent)
{
    ivec2 maximumPixel = sourceExtent - ivec2(1);
    ivec2 rightPixel = min(centerPixel + ivec2(1, 0), maximumPixel);
    ivec2 leftPixel = max(centerPixel - ivec2(1, 0), ivec2(0));
    ivec2 upPixel = min(centerPixel + ivec2(0, 1), maximumPixel);
    ivec2 downPixel = max(centerPixel - ivec2(0, 1), ivec2(0));
    vec2 rightUv = DepthPixelUv(rightPixel, sourceExtent);
    vec2 leftUv = DepthPixelUv(leftPixel, sourceExtent);
    vec2 upUv = DepthPixelUv(upPixel, sourceExtent);
    vec2 downUv = DepthPixelUv(downPixel, sourceExtent);
    float rightDepth = rightPixel.x != centerPixel.x
        ? FetchDepth(rightPixel)
        : 0.0;
    float leftDepth = leftPixel.x != centerPixel.x
        ? FetchDepth(leftPixel)
        : 0.0;
    float upDepth = upPixel.y != centerPixel.y
        ? FetchDepth(upPixel)
        : 0.0;
    float downDepth = downPixel.y != centerPixel.y
        ? FetchDepth(downPixel)
        : 0.0;
    vec2 rightZw = ReconstructViewZw(rightUv, rightDepth);
    vec2 leftZw = ReconstructViewZw(leftUv, leftDepth);
    vec2 upZw = ReconstructViewZw(upUv, upDepth);
    vec2 downZw = ReconstructViewZw(downUv, downDepth);
    float rightViewZ = ResolveViewZ(rightZw);
    float leftViewZ = ResolveViewZ(leftZw);
    float upViewZ = ResolveViewZ(upZw);
    float downViewZ = ResolveViewZ(downZw);
    bool useRight = rightDepth > 1.0e-6 &&
        (leftDepth <= 1.0e-6 ||
         abs(rightViewZ - center.z) <= abs(center.z - leftViewZ));
    bool useUp = upDepth > 1.0e-6 &&
        (downDepth <= 1.0e-6 ||
         abs(upViewZ - center.z) <= abs(center.z - downViewZ));
    vec3 dx;
    if (useRight)
        dx = CompleteViewPosition(rightUv, rightDepth, rightZw,
            rightViewZ) - center;
    else
        dx = center - CompleteViewPosition(leftUv, leftDepth, leftZw,
            leftViewZ);
    vec3 dy;
    if (useUp)
        dy = CompleteViewPosition(upUv, upDepth, upZw, upViewZ) - center;
    else
        dy = center - CompleteViewPosition(downUv, downDepth, downZw,
            downViewZ);
    vec3 normal = cross(dy, dx);
    float lengthSquared = dot(normal, normal);
    if (lengthSquared <= max(dot(dx, dx) * dot(dy, dy), 1.0e-20) * 1.0e-6)
        return vec3(0.0, 0.0, 1.0);
    normal *= inversesqrt(lengthSquared);
    return dot(normal, -center) < 0.0 ? -normal : normal;
}

vec2 EncodeOctahedral(vec3 normal)
{
    normal /= max(abs(normal.x) + abs(normal.y) + abs(normal.z), 1.0e-6);
    vec2 encoded = normal.xy;
    if (normal.z < 0.0)
        encoded = (vec2(1.0) - abs(encoded.yx)) * sign(encoded);
    return clamp(encoded, vec2(-1.0), vec2(1.0));
}

uvec2 PackCurrentGeometry(vec3 normal, float viewDepth)
{
    uint packedNormal = packSnorm2x16(EncodeOctahedral(normal));
    uint packedDepth = packHalf2x16(vec2(
        log2(1.0 + max(viewDepth, 0.0)), 0.0)) & 0xffffu;
    return uvec2(packedNormal, packedDepth | 0x80000000u);
}

float SearchHorizonCos(
    vec2 uv,
    vec3 center,
    vec3 viewDirection,
    vec3 surfaceNormal,
    vec3 sliceTangent,
    vec2 screenDirection,
    float projectedRadiusPixels,
    uint stepCount,
    float inverseStepCount,
    vec2 invDestination,
    ivec2 sourceExtent,
    float lowHorizonCos)
{
    float horizonCos = lowHorizonCos;
    for (uint step = 0u; step < 12u; ++step)
    {
        if (step >= stepCount)
            break;
        float fraction = (float(step) + 1.0) * inverseStepCount;
        float pixelDistance = max(1.0,
            projectedRadiusPixels * fraction * fraction);
        vec2 sampleUv = uv + screenDirection * pixelDistance *
            invDestination;
        if (any(lessThanEqual(sampleUv, vec2(0.0))) ||
            any(greaterThanEqual(sampleUv, vec2(1.0))))
            continue;
        // Hi-Z mip zero is already half resolution in Njulf. Reconstructing
        // this full-resolution sample position from its conservative 2x2
        // depth produces false, axis-aligned horizons on planar surfaces.
        ivec2 samplePixel = ResolveDepthPixel(sampleUv, sourceExtent);
        vec2 resolvedSampleUv = DepthPixelUv(samplePixel, sourceExtent);
        float sampleDepth = FetchDepth(samplePixel);
        if (sampleDepth <= 1.0e-6)
            continue;
        vec3 samplePosition = ReconstructViewPosition(
            resolvedSampleUv, sampleDepth);
        vec3 delta = samplePosition - center;
        float distanceToSample = length(delta);
        if (!Finite(samplePosition) || !Finite(distanceToSample) ||
            distanceToSample <= 1.0e-5 || distanceToSample > pc.Radius)
            continue;
        // Only geometry above the receiver's tangent plane can occlude its
        // visible hemisphere. This also prevents residual depth quantization
        // on a flat surface from being promoted into a false horizon.
        float planeDistance = dot(delta, surfaceNormal);
        if (planeDistance <= pc.PlaneBias)
            continue;
        float tangentDistance = dot(delta, sliceTangent);
        if (tangentDistance <= 1.0e-5)
            continue;
        float falloffStart = pc.Radius / max(pc.Falloff, 1.0);
        float falloffEnd = max(pc.Radius, falloffStart + 1.0e-4);
        float rangeWeight = 1.0 - smoothstep(
            falloffStart, falloffEnd, distanceToSample);
        // Thin-surface compensation applies only to geometry behind the
        // receiver. Attenuating samples in front erases real occluders.
        float behindDistance = max(
            center.z - samplePosition.z - pc.PlaneBias, 0.0);
        float thicknessWeight = 1.0 - smoothstep(
            pc.Thickness,
            max(pc.Thickness * 4.0, pc.Thickness + 1.0e-4),
            behindDistance);
        float sampleHorizonCos = clamp(
            dot(delta, viewDirection) / distanceToSample, -1.0, 1.0);
        horizonCos = max(horizonCos, mix(lowHorizonCos,
            sampleHorizonCos, rangeWeight * thicknessWeight));
    }
    return clamp(horizonCos, -1.0, 1.0);
}

// Published GTAO cosine-weighted integral for one signed horizon boundary.
// Keeping the horizon's sine/cosine from the acos input avoids two more
// transcendental evaluations per slice.
float IntegrateGtaoArc(
    float horizon,
    vec2 horizonSinCos,
    vec2 normalSinCos)
{
    float cosineDoubleHorizon = horizonSinCos.y * horizonSinCos.y -
        horizonSinCos.x * horizonSinCos.x;
    float sineDoubleHorizon = 2.0 * horizonSinCos.x * horizonSinCos.y;
    float cosineDoubleHorizonMinusNormal =
        cosineDoubleHorizon * normalSinCos.y +
        sineDoubleHorizon * normalSinCos.x;
    return 0.25 * (normalSinCos.y +
        2.0 * horizon * normalSinCos.x -
        cosineDoubleHorizonMinusNormal);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(GtaoRawOutput);
    if (any(greaterThanEqual(pixel, extent)))
        return;
    ivec2 sourceExtent = textureSize(DepthTexture, 0);
    vec2 invDestination = 1.0 /
        max(pc.DestinationDimensions, vec2(1.0));
    vec2 uv = (vec2(pixel) + vec2(0.5)) /
        max(pc.DestinationDimensions, vec2(1.0));
    ivec2 centerPixel = ResolveDepthPixel(uv, sourceExtent);
    vec2 centerUv = DepthPixelUv(centerPixel, sourceExtent);
    float depth = FetchDepth(centerPixel);
    if (depth <= 1.0e-6)
    {
        imageStore(GtaoRawOutput, pixel,
            vec4(0.0, 0.0, 1.0, 0.0));
        imageStore(GtaoCurrentGeometryOutput, pixel, uvec4(0u));
        return;
    }
    vec3 center = ReconstructViewPosition(centerUv, depth);
    vec3 normal = ReconstructGeometricNormal(
        centerPixel, center, sourceExtent);
    if (!Finite(center) || !Finite(normal))
    {
        imageStore(GtaoRawOutput, pixel,
            vec4(0.0, 0.0, 1.0, 0.0));
        imageStore(GtaoCurrentGeometryOutput, pixel, uvec4(0u));
        return;
    }
    vec3 viewDirection = normalize(-center);
    float viewDepth = max(abs(center.z), 1.0e-3);
    imageStore(GtaoCurrentGeometryOutput, pixel, uvec4(
        PackCurrentGeometry(normal, viewDepth), 0u, 0u));
    float projectedRadiusPixels = pc.Radius *
        abs(pc.ProjectionMatrix[1][1]) * pc.DestinationDimensions.y *
        0.5 / viewDepth;
    if (projectedRadiusPixels < 1.5)
    {
        imageStore(GtaoRawOutput, pixel,
            vec4(EncodeOctahedral(normal), 1.0, 1.0));
        return;
    }

    uint stepCount = clamp(pc.StepCount, 1u, 12u);
    float inverseStepCount = 1.0 / float(stepCount);
    uint directionCount = clamp(pc.DirectionCount, 1u, 8u);
    float rotation = (Hash(uvec3(pixel, pc.FrameIndex & 7u)) +
        float(pc.FrameIndex & 7u) * 0.61803398875) * GTAO_PI;
    float visibilitySum = 0.0;
    vec3 unoccludedDirection = vec3(0.0);
    vec2 inverseProjectionScale = vec2(
        pc.InverseProjectionMatrix[0][0],
        pc.InverseProjectionMatrix[1][1]);
    for (uint directionIndex = 0u; directionIndex < 8u;
         ++directionIndex)
    {
        if (directionIndex >= directionCount)
            break;
        float angle = rotation + GTAO_PI *
            (float(directionIndex) + 0.5) / float(directionCount);
        vec2 screenDirection = vec2(cos(angle), sin(angle));
        // A positive framebuffer Y offset reconstructs toward negative view
        // Y with Njulf's projection. Preserve that signed projection scale,
        // then make the search direction orthogonal to the view ray.
        vec3 screenPlaneDirection = vec3(
            screenDirection * inverseProjectionScale, 0.0);
        vec3 tangent = screenPlaneDirection - viewDirection *
            dot(screenPlaneDirection, viewDirection);
        float tangentLengthSquared = dot(tangent, tangent);
        if (tangentLengthSquared <= 1.0e-12)
            continue;
        tangent *= inversesqrt(tangentLengthSquared);
        vec3 sliceNormal = normalize(cross(tangent, viewDirection));
        vec3 projectedNormal = normal - sliceNormal * dot(normal, sliceNormal);
        float projectedLength = length(projectedNormal);
        if (projectedLength <= 1.0e-5)
            continue;
        projectedNormal /= projectedLength;
        vec2 normalSinCos = vec2(
            dot(projectedNormal, tangent),
            dot(projectedNormal, viewDirection));
        float normalCoordinateLengthSquared = dot(normalSinCos, normalSinCos);
        normalSinCos = normalCoordinateLengthSquared > 1.0e-12
            ? normalSinCos * inversesqrt(normalCoordinateLengthSquared)
            : vec2(0.0, 1.0);
        float positiveLowHorizonCos = -normalSinCos.x;
        float negativeLowHorizonCos = normalSinCos.x;
        float positiveHorizonCos = SearchHorizonCos(
            centerUv, center, viewDirection, normal,
            tangent, screenDirection, projectedRadiusPixels, stepCount,
            inverseStepCount, invDestination, sourceExtent,
            positiveLowHorizonCos);
        float negativeHorizonCos = SearchHorizonCos(
            centerUv, center, viewDirection, normal,
            -tangent, -screenDirection, projectedRadiusPixels, stepCount,
            inverseStepCount, invDestination, sourceExtent,
            negativeLowHorizonCos);
        float positiveHorizonSine = sqrt(max(
            1.0 - positiveHorizonCos * positiveHorizonCos, 0.0));
        float negativeHorizonSine = -sqrt(max(
            1.0 - negativeHorizonCos * negativeHorizonCos, 0.0));
        float h0 = -ApproximateAcos(
            -negativeHorizonSine, negativeHorizonCos);
        float h1 = ApproximateAcos(
            positiveHorizonSine, positiveHorizonCos);
        float sliceVisibility = projectedLength * (
            IntegrateGtaoArc(h0,
                vec2(negativeHorizonSine, negativeHorizonCos),
                normalSinCos) +
            IntegrateGtaoArc(h1,
                vec2(positiveHorizonSine, positiveHorizonCos),
                normalSinCos));
        visibilitySum += max(sliceVisibility, 0.0);
        float positiveOpen = clamp(h1 / GTAO_PI, 0.0, 1.0);
        float negativeOpen = clamp(-h0 / GTAO_PI, 0.0, 1.0);
        unoccludedDirection += projectedNormal *
            (positiveOpen + negativeOpen) +
            tangent * (positiveOpen - negativeOpen);
    }
    float visibility = visibilitySum / float(directionCount);
    visibility = pow(clamp(1.0 - (1.0 - visibility) * pc.Intensity,
        0.0, 1.0), max(pc.Power, 0.25));
    vec3 bentNormal = dot(unoccludedDirection, unoccludedDirection) > 1.0e-8
        ? normalize(unoccludedDirection)
        : normal;
    if (dot(bentNormal, normal) <= 0.0 || !Finite(bentNormal))
        bentNormal = normal;
    float confidence = clamp(projectedRadiusPixels / 6.0, 0.0, 1.0);
    imageStore(GtaoRawOutput, pixel, vec4(
        EncodeOctahedral(bentNormal),
        visibility,
        confidence));
}
