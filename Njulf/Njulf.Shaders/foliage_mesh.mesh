#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require

#include "common.glsl"
#include "directional_shadow_caster_diagnostics.glsl"
#define SIMPLE_DDGI_RECEIVER_DEMAND_SAMPLE (gl_LocalInvocationIndex == 0u)
#define SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE (gl_LocalInvocationIndex == 0u)
#define SIMPLE_DDGI_RECEIVER_COVERAGE_HASH ((gl_WorkGroupID.x * 73856093u) ^ (gl_WorkGroupID.y * 19349663u) ^ (gl_WorkGroupID.z * 83492791u))
#define SIMPLE_DDGI_RECEIVER_CONSUMER_FLAGS SIMPLE_DDGI_RECEIVER_CONSUMER_OPAQUE
#define SIMPLE_DDGI_RECEIVER_TOUCHES_RESIDENT 1
#define SIMPLE_DDGI_RECEIVER_DEMAND_FRAME_OFFSET 0u
#define SIMPLE_DDGI_OPAQUE_GATHER_ORACLE 1
#include "ddgi_simple_shared.glsl"
#undef SIMPLE_DDGI_OPAQUE_GATHER_ORACLE
#undef SIMPLE_DDGI_RECEIVER_DEMAND_FRAME_OFFSET
#undef SIMPLE_DDGI_RECEIVER_TOUCHES_RESIDENT
#undef SIMPLE_DDGI_RECEIVER_CONSUMER_FLAGS
#undef SIMPLE_DDGI_RECEIVER_COVERAGE_HASH
#undef SIMPLE_DDGI_RECEIVER_CONTRIBUTION_SAMPLE
#undef SIMPLE_DDGI_RECEIVER_DEMAND_SAMPLE

#ifndef NJULF_FOLIAGE_MESH_LOCAL_SIZE
#ifdef FOLIAGE_MESH_COMPACTED_MESH
#define NJULF_FOLIAGE_MESH_LOCAL_SIZE 64
#else
#define NJULF_FOLIAGE_MESH_LOCAL_SIZE 128
#endif
#endif
#ifndef NJULF_FOLIAGE_MESH_MAX_VERTICES
#ifdef FOLIAGE_MESH_COMPACTED_MESH
#define NJULF_FOLIAGE_MESH_MAX_VERTICES 48
#else
#define NJULF_FOLIAGE_MESH_MAX_VERTICES 64
#endif
#endif
#ifndef NJULF_FOLIAGE_MESH_MAX_PRIMITIVES
#ifdef FOLIAGE_MESH_COMPACTED_MESH
#define NJULF_FOLIAGE_MESH_MAX_PRIMITIVES 64
#else
#define NJULF_FOLIAGE_MESH_MAX_PRIMITIVES 126
#endif
#endif
layout(local_size_x = NJULF_FOLIAGE_MESH_LOCAL_SIZE,
    local_size_y = 1, local_size_z = 1) in;
layout(triangles,
    max_vertices = NJULF_FOLIAGE_MESH_MAX_VERTICES,
    max_primitives = NJULF_FOLIAGE_MESH_MAX_PRIMITIVES) out;

#ifndef FOLIAGE_MESH_COMPACTED_MESH
struct FoliageMeshPayload
{
    uint DrawCommandIndex;
    uint Visible;
};

taskPayloadSharedEXT FoliageMeshPayload foliagePayload;
#endif

layout(location = 0) out vec2 meshTexCoord[];
layout(location = 1) flat out uint meshMaterialIndex[];
layout(location = 2) out vec3 meshWorldPosition[];
layout(location = 3) out vec3 meshNormal[];
layout(location = 4) flat out uint meshClusterIndex[];
layout(location = 5) flat out uint meshLodBand[];
layout(location = 6) flat out uint meshGeometryMode[];
layout(location = 7) flat out uint meshDebugMeshletIndex[];
layout(location = 8) flat out vec4 meshColorVariation[];
layout(location = 9) flat out vec4 meshDdgiIrradianceCoverage[];
layout(location = 10) flat out uint meshImpostorMetadataIndex[];

layout(push_constant) uniform FoliageDrawPushConstantBlock
{
    GPUFoliageDrawPushConstants Push;
} pc;

vec3 ApplyAuthoredFoliageWind(vec3 worldPosition, GPUFoliageInstance instance, GPUFoliagePrototype prototype)
{
    float strength = prototype.WindParams.x;
    if (strength <= 0.0)
        return worldPosition;

    float frequency = max(0.01, prototype.WindParams.y);
    float flutter = prototype.WindParams.z;
    float phase = dot(worldPosition.xz, vec2(0.137, 0.173)) +
        instance.RotationWind.y * 6.28318530718 +
        pc.Push.CameraPositionTime.w * frequency;
    float sway = sin(phase) * strength;
    float leafFlutter = sin(phase * 3.1 + instance.RotationWind.y * 17.0) * flutter * strength;
    return worldPosition + vec3(sway + leafFlutter, leafFlutter * 0.15, sway * 0.45) * 0.05;
}

vec3 SafeNormalize(vec3 value, vec3 fallback)
{
    float lengthSquared = dot(value, value);
    if (lengthSquared <= 0.000001)
        return fallback;
    return value * inversesqrt(lengthSquared);
}

vec3 TransformFoliagePoint(vec3 localPosition, GPUFoliageInstance instance, GPUFoliagePrototype prototype)
{
    float yawSin = sin(instance.RotationWind.x);
    float yawCos = cos(instance.RotationWind.x);
    vec3 scaled = localPosition * max(instance.PositionScale.w, 0.0001);
    scaled.xz = vec2(
        scaled.x * yawCos - scaled.z * yawSin,
        scaled.x * yawSin + scaled.z * yawCos);
    vec3 up = vec3(0.0, 1.0, 0.0);
    if ((instance.Flags & 1u) != 0u)
    {
        float normalY = sqrt(max(
            0.0,
            1.0 - instance.RotationWind.z * instance.RotationWind.z -
                instance.RotationWind.w * instance.RotationWind.w));
        up = SafeNormalize(vec3(
            instance.RotationWind.z,
            normalY,
            instance.RotationWind.w), up);
    }
    vec3 right = SafeNormalize(
        cross(up, vec3(0.0, 0.0, 1.0)),
        vec3(1.0, 0.0, 0.0));
    vec3 forward = SafeNormalize(
        cross(right, up),
        vec3(0.0, 0.0, 1.0));
    vec3 worldPosition = instance.PositionScale.xyz +
        right * scaled.x + up * scaled.y + forward * scaled.z;
    return ApplyAuthoredFoliageWind(worldPosition, instance, prototype);
}

vec3 TransformFoliageNormal(vec3 localNormal, GPUFoliageInstance instance)
{
    float yawSin = sin(instance.RotationWind.x);
    float yawCos = cos(instance.RotationWind.x);
    vec3 result = localNormal;
    result.xz = vec2(
        result.x * yawCos - result.z * yawSin,
        result.x * yawSin + result.z * yawCos);
    vec3 up = vec3(0.0, 1.0, 0.0);
    if ((instance.Flags & 1u) != 0u)
    {
        float normalY = sqrt(max(
            0.0,
            1.0 - instance.RotationWind.z * instance.RotationWind.z -
                instance.RotationWind.w * instance.RotationWind.w));
        up = SafeNormalize(vec3(
            instance.RotationWind.z,
            normalY,
            instance.RotationWind.w), up);
    }
    vec3 right = SafeNormalize(
        cross(up, vec3(0.0, 0.0, 1.0)),
        vec3(1.0, 0.0, 0.0));
    vec3 forward = SafeNormalize(
        cross(right, up),
        vec3(0.0, 0.0, 1.0));
    return normalize(
        right * result.x + up * result.y + forward * result.z);
}

void main()
{
#ifdef FOLIAGE_MESH_COMPACTED_MESH
    uint drawCommandIndex = gl_WorkGroupID.x + pc.Push.FirstDraw;
    if (gl_WorkGroupID.x >= pc.Push.ClusterDrawCount)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
#else
    if (foliagePayload.Visible == 0u)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint drawCommandIndex = foliagePayload.DrawCommandIndex;
#endif

    GPUFoliageMeshletDrawCommand command = ReadFoliageMeshletDrawCommand(
        pc.Push.CurrentFrameIndex,
        drawCommandIndex);
    if (command.MeshletIndex == 0xffffffffu)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    if (!SphereIntersectsRowMajorFrustum(
            command.WorldCenterRadius.xyz,
            command.WorldCenterRadius.w,
            pc.Push.ViewProjectionMatrix))
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }

    GPUMeshlet meshlet = ReadMeshlet(
        command.MeshletIndex,
        pc.Push.CurrentFrameIndex);
    GPUFoliageInstance instance = ReadFoliageInstance(pc.Push.CurrentFrameIndex, command.InstanceIndex);
    GPUFoliagePrototype prototype = ReadFoliagePrototype(command.PrototypeIndex);
#if NJULF_GPU_DIAGNOSTIC_COUNTERS
    if (gl_LocalInvocationIndex == 0u &&
        (pc.Push.Flags & (1u << 1u)) != 0u)
    {
        // ApplyAuthoredFoliageWind can displace a vertex by the sum of its
        // sway and flutter terms. Expand the source meshlet sphere by their
        // analytic maximum before diagnosing shadow clip containment.
        float windStrength = abs(prototype.WindParams.x);
        float flutter = abs(prototype.WindParams.z);
        float windExpansion = windStrength * length(vec3(
            0.05 * (1.0 + flutter),
            0.0075 * flutter,
            0.0225));
        vec4 diagnosticSphere = command.WorldCenterRadius;
        diagnosticSphere.w += windExpansion;
        bool accepted = SphereIntersectsRowMajorFrustum(
            diagnosticSphere.xyz,
            diagnosticSphere.w,
            pc.Push.ViewProjectionMatrix);
        RecordDirectionalShadowCasterAttribution(
            pc.Push.CurrentFrameIndex,
            command.PrototypeIndex,
            command.InstanceIndex,
            command.MeshletIndex,
            command.LodLevel,
            DIRECTIONAL_SHADOW_CASTER_CLASS_FOLIAGE,
            pc.Push.Padding1,
            command.ClusterIndex,
            DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_INPUT |
                DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_FOLIAGE |
                DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_CONSERVATIVE_LOD,
            diagnosticSphere,
            pc.Push.ViewProjectionMatrix,
            accepted);
    }
#endif
    vec3 clumpNormal = SafeNormalize(vec3(
        command.WorldCenterRadius.x - pc.Push.CameraPositionTime.x,
        max(command.WorldCenterRadius.w * 0.35, 0.1),
        command.WorldCenterRadius.z - pc.Push.CameraPositionTime.z),
        vec3(0.0, 1.0, 0.0));
    vec3 meshletViewDirection = SafeNormalize(
        pc.Push.CameraPositionTime.xyz - command.WorldCenterRadius.xyz,
        vec3(0.0, 0.0, 1.0));
#if NJULF_SIMPLE_DDGI_FOLIAGE_FRAGMENT_FEEDBACK
    // Exact B1 ownership is evaluated at the covered fragment; avoid retaining
    // the ordinary cluster-centre gather in this specialized mesh program.
    vec4 meshletDdgiIrradianceCoverage = vec4(0.0);
#else
    vec4 meshletDdgiIrradianceCoverage = (pc.Push.Flags & (1u << 5u)) != 0u ? vec4(0.0) : SampleSimpleDdgiIrradianceCoverage(
        command.WorldCenterRadius.xyz,
        clumpNormal,
        meshletViewDirection);
#endif

    if (gl_LocalInvocationIndex == 0u)
        SetMeshOutputsEXT(meshlet.LocalVertexCount, meshlet.LocalTriangleCount);

    barrier();

    for (uint vertexSlot = gl_LocalInvocationIndex;
         vertexSlot < meshlet.LocalVertexCount;
         vertexSlot += gl_WorkGroupSize.x)
    {
        uint localVertexIndex = ReadMeshletLocalVertexIndex(
            meshlet,
            vertexSlot);
        GPUVertex vertex = ReadSplitVertex(meshlet.VertexOffset + localVertexIndex);
        vec3 worldPosition = TransformFoliagePoint(vertex.Position, instance, prototype);

        gl_MeshVerticesEXT[vertexSlot].gl_Position = MulRowMajor(vec4(worldPosition, 1.0), pc.Push.ViewProjectionMatrix);
        meshTexCoord[vertexSlot] = vertex.TexCoord;
        meshMaterialIndex[vertexSlot] = command.MaterialIndex;
        meshWorldPosition[vertexSlot] = worldPosition;
        meshNormal[vertexSlot] = TransformFoliageNormal(
            vertex.Normal,
            instance);
        meshClusterIndex[vertexSlot] = command.ClusterIndex;
        meshLodBand[vertexSlot] =
            PackFoliageCoverageStateFromCommand(
                command.LodLevel,
                command.Flags);
        meshGeometryMode[vertexSlot] = 1u;
        meshDebugMeshletIndex[vertexSlot] = command.MeshletIndex;
        meshColorVariation[vertexSlot] = instance.ColorVariation;
        meshDdgiIrradianceCoverage[vertexSlot] = meshletDdgiIrradianceCoverage;
        meshImpostorMetadataIndex[vertexSlot] = 0xffffffffu;
    }

    for (uint triangleSlot = gl_LocalInvocationIndex;
         triangleSlot < meshlet.LocalTriangleCount;
         triangleSlot += gl_WorkGroupSize.x)
    {
        uint triangleOffset = triangleSlot * 3u;
        uint i0 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 0u);
        uint i1 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 1u);
        uint i2 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 2u);
        gl_PrimitiveTriangleIndicesEXT[triangleSlot] = uvec3(i0, i1, i2);
    }
}
