        <Defines>-DSIMPLE_DDGI_DIRECTION_VALIDATION=1 -DSIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT=1</Defines>
      </SimpleDdgiTransportShaderVariant>
      <SimpleDdgiTransportShaderVariant Include="ddgi_simple_transport_solve_guided_packed.comp">
