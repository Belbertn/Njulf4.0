#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint localIndex = gl_LocalInvocationID.x;
    bool certifiedQuiesced = SchedulerCertifiedQuiesced();
    bool resetLaneCursors = SchedulerResetLaneCursors();
    // Classification deterministically overwrites every active candidate
    // record, including the invalid sentinel on every rejection path. Compact
    // likewise overwrites exactly the [0, eligibleCount) output interval that
    // admission is allowed to read. Clearing either full-capacity pool here
    // only duplicates those writes and makes a sparse one-probe frame pay for
    // the complete 15k-probe arena.
    if (!certifiedQuiesced || resetLaneCursors)
    {
        for (uint i = localIndex;
             i < SchedulerCandidateGroupLaneWordCount();
             i += 64u)
        {
            SchedulerArenaWrite(
                pc.CandidateGroupLaneCountsOffsetWords + i,
                0u);
        }
    }
    // Emit consumes only [0, acceptedCount), and every admitted record is
    // written in full. The same bound applies to outcome records initialized
    // by emit, so neither private range needs a frame-wide clear.
    if (!certifiedQuiesced)
    {
        for (uint i = localIndex;
             i < SIMPLE_DDGI_SCHEDULER_MAX_LANES;
             i += 64u)
        {
            SchedulerArenaWrite(pc.LaneCandidateCountsOffsetWords + i, 0u);
            SchedulerArenaWrite(pc.LanePrefixesOffsetWords + i, 0u);
            SchedulerArenaWrite(pc.LaneTotalsOffsetWords + i, 0u);
            // LaneCursors is persistent rotating state on ordinary frames.
            // A new field-wide source generation deliberately restarts it so
            // the first relight cohort cannot depend on unrelated warmup or
            // maintenance work from the prior lighting state.
            if (resetLaneCursors)
                SchedulerArenaWrite(pc.LaneCursorsOffsetWords + i, 0u);
            SchedulerArenaWrite(pc.LaneAdmissionOffsetWords + i, 0u);
        }
    }
    // Preserve the frame-stamped urgent summary and the host-controlled urgent
    // budget. The pre-forward pass owns both words and clears the control word
    // before the ordinary post-forward schedule begins.
    for (uint i = localIndex;
         i < SIMPLE_DDGI_SCHEDULER_TRANSIENT_COUNTER_WORDS;
         i += 64u)
        SchedulerArenaWrite(pc.CountersOffsetWords + i, 0u);
    for (uint i = 96u + localIndex;
         i < SIMPLE_DDGI_SCHEDULER_COUNTER_WORDS;
         i += 64u)
        SchedulerArenaWrite(pc.CountersOffsetWords + i, 0u);
    uint feedbackClearEnd = certifiedQuiesced
        ? 64u
        : SIMPLE_DDGI_SCHEDULER_FEEDBACK_WORDS;
    for (uint i = localIndex; i < feedbackClearEnd; i += 64u)
        SchedulerArenaWrite(pc.FeedbackOffsetWords + i, 0u);
    if (certifiedQuiesced)
    {
        // Cursor words 64..959 are persistent and unchanged while admission
        // is quiesced. Clear only the exceptional tail copied after them.
        for (uint i = 960u + localIndex; i < 976u; i += 64u)
            SchedulerArenaWrite(pc.FeedbackOffsetWords + i, 0u);
    }
    for (uint command = localIndex; command < 6u; command += 64u)
    {
        uint commandBase = pc.RayBucketCommandsOffsetWords +
            command * SIMPLE_DDGI_SCHEDULER_RAY_BUCKET_COMMAND_WORDS;
        uint metadataBase = pc.RayBucketMetadataOffsetWords +
            command * SIMPLE_DDGI_SCHEDULER_RAY_BUCKET_METADATA_WORDS;
        SchedulerArenaWrite(commandBase + 0u, 0u);
        SchedulerArenaWrite(commandBase + 1u, 1u);
        SchedulerArenaWrite(commandBase + 2u, 1u);
        SchedulerArenaWrite(commandBase + 3u, 0u);
        SchedulerArenaWrite(metadataBase + 0u, 0u);
        SchedulerArenaWrite(metadataBase + 1u, 0u);
        SchedulerArenaWrite(metadataBase + 2u, 0u);
        SchedulerArenaWrite(metadataBase + 3u, 0u);
    }
    for (uint command = localIndex; command < 15u; command += 64u)
    {
        uint base = pc.IndirectCommandsOffsetWords +
            command * SIMPLE_DDGI_SCHEDULER_INDIRECT_WORDS;
        SchedulerArenaWrite(base + 0u, 0u);
        SchedulerArenaWrite(base + 1u, 1u);
        SchedulerArenaWrite(base + 2u, 1u);
        SchedulerArenaWrite(base + 3u, 0u);
    }

    if (localIndex == 0u)
    {
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_RESET, 1u, 1u, 1u);
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_CLASSIFY, 0u, 1u, 1u);
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_PREFIX, 0u, 1u, 1u);
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_LANE_BASE, 0u, 1u, 1u);
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_COMPACT, 0u, 1u, 1u);
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_ADMIT, 0u, 1u, 1u);
        SchedulerWriteIndirect(SIMPLE_DDGI_SCHEDULER_DISPATCH_EMIT, 1u, 1u, 1u);
    }
}
