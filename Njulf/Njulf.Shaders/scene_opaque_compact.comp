        MESHLET_COMMAND_FLAG_NORMAL_CONE_CULL_ELIGIBLE) != 0u;
}

bool ProjectToUvDepth(vec3 worldPosition, mat4 viewProjection, out vec3 uvDepth)
{
    vec4 clip = MulRowMajor(vec4(worldPosition, 1.0), viewProjection);
    if (clip.w <= 0.000001)
        return false;

    vec3 ndc = clip.xyz / clip.w;
    uvDepth = vec3(ndc.xy * 0.5 + vec2(0.5), ndc.z);
    return uvDepth.z >= 0.0 && uvDepth.z <= 1.0;
}

bool MeshletOccludedByHiZBounds4Tap(vec3 worldCenter, float worldRadius)
{
    if (pc.Push.OcclusionCullingEnabled == HIZ_TEST_MODE_OFF ||
        pc.Push.HiZMipCount == 0u ||
        pc.Push.PreviousHiZFrameValid == 0u ||
        ReadMeshletTaskPreviousHiZFrameValid(pc.Push.CurrentFrameIndex) == 0u)
    {
        return false;
    }

    mat4 viewProjection = ReadMeshletTaskPreviousHiZViewProjectionMatrix(pc.Push.CurrentFrameIndex);
    mat4 inverseView = ReadMeshletTaskPreviousHiZInverseViewMatrix(pc.Push.CurrentFrameIndex);
    vec2 screenDimensions = max(pc.Push.ScreenDimensions, vec2(1.0));

    vec3 cameraRight = normalize(vec3(inverseView[0][0], inverseView[0][1], inverseView[0][2]));
    vec3 cameraUp = normalize(vec3(inverseView[1][0], inverseView[1][1], inverseView[1][2]));
    vec3 cameraForward = -normalize(vec3(inverseView[2][0], inverseView[2][1], inverseView[2][2]));

    vec3 projected[6];
    if (!ProjectToUvDepth(worldCenter, viewProjection, projected[0]) ||
        !ProjectToUvDepth(worldCenter + cameraRight * worldRadius, viewProjection, projected[1]) ||
        !ProjectToUvDepth(worldCenter - cameraRight * worldRadius, viewProjection, projected[2]) ||
        !ProjectToUvDepth(worldCenter + cameraUp * worldRadius, viewProjection, projected[3]) ||
        !ProjectToUvDepth(worldCenter - cameraUp * worldRadius, viewProjection, projected[4]) ||
        !ProjectToUvDepth(worldCenter - cameraForward * worldRadius, viewProjection, projected[5]))
    {
        return false;
    }

    vec2 minUv = projected[0].xy;
    vec2 maxUv = projected[0].xy;
    for (int i = 1; i < 6; i++)
    {
        minUv = min(minUv, projected[i].xy);
        maxUv = max(maxUv, projected[i].xy);
    }

    minUv = clamp(minUv, vec2(0.0), vec2(1.0));
    maxUv = clamp(maxUv, vec2(0.0), vec2(1.0));
    vec2 uvPadding = float(pc.Push.PreviousFrameUvPaddingPixels) / screenDimensions;
    minUv = clamp(minUv - uvPadding, vec2(0.0), vec2(1.0));
    maxUv = clamp(maxUv + uvPadding, vec2(0.0), vec2(1.0));
    vec2 extentPixels = max((maxUv - minUv) * screenDimensions, vec2(1.0));
    float mipFloat = ceil(log2(max(extentPixels.x, extentPixels.y)));
    float mipLevel = clamp(mipFloat, 0.0, float(pc.Push.HiZMipCount - 1u));

    float farthestOccluder = 1.0;
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(minUv.x, minUv.y), mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(maxUv.x, minUv.y), mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(minUv.x, maxUv.y), mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(maxUv.x, maxUv.y), mipLevel).r);

    if (farthestOccluder <= 0.0)
        return false;

    return projected[5].z <= max(farthestOccluder - pc.Push.OcclusionBias, 0.0);
}

bool MeshletOccludedByHiZFull6Point5Tap(vec3 worldCenter, float worldRadius)
{
    if (pc.Push.OcclusionCullingEnabled == HIZ_TEST_MODE_OFF ||
        pc.Push.HiZMipCount == 0u ||
        pc.Push.PreviousHiZFrameValid == 0u ||
        ReadMeshletTaskPreviousHiZFrameValid(pc.Push.CurrentFrameIndex) == 0u)
    {
        return false;
    }

    mat4 viewProjection = ReadMeshletTaskPreviousHiZViewProjectionMatrix(pc.Push.CurrentFrameIndex);
    mat4 inverseView = ReadMeshletTaskPreviousHiZInverseViewMatrix(pc.Push.CurrentFrameIndex);
    vec2 screenDimensions = max(pc.Push.ScreenDimensions, vec2(1.0));

    vec3 cameraRight = normalize(vec3(inverseView[0][0], inverseView[0][1], inverseView[0][2]));
    vec3 cameraUp = normalize(vec3(inverseView[1][0], inverseView[1][1], inverseView[1][2]));
    vec3 cameraForward = -normalize(vec3(inverseView[2][0], inverseView[2][1], inverseView[2][2]));

    vec3 projected[7];
    if (!ProjectToUvDepth(worldCenter, viewProjection, projected[0]) ||
        !ProjectToUvDepth(worldCenter + cameraRight * worldRadius, viewProjection, projected[1]) ||
        !ProjectToUvDepth(worldCenter - cameraRight * worldRadius, viewProjection, projected[2]) ||
        !ProjectToUvDepth(worldCenter + cameraUp * worldRadius, viewProjection, projected[3]) ||
        !ProjectToUvDepth(worldCenter - cameraUp * worldRadius, viewProjection, projected[4]) ||
        !ProjectToUvDepth(worldCenter - cameraForward * worldRadius, viewProjection, projected[5]) ||
        !ProjectToUvDepth(worldCenter + cameraForward * worldRadius, viewProjection, projected[6]))
    {
        return false;
    }

    vec2 minUv = projected[0].xy;
    vec2 maxUv = projected[0].xy;
    float nearestDepth = projected[5].z;
    for (int i = 1; i < 7; i++)
    {
        minUv = min(minUv, projected[i].xy);
        maxUv = max(maxUv, projected[i].xy);
    }

    minUv = clamp(minUv, vec2(0.0), vec2(1.0));
    maxUv = clamp(maxUv, vec2(0.0), vec2(1.0));
    vec2 uvPadding = float(pc.Push.PreviousFrameUvPaddingPixels) / screenDimensions;
    minUv = clamp(minUv - uvPadding, vec2(0.0), vec2(1.0));
    maxUv = clamp(maxUv + uvPadding, vec2(0.0), vec2(1.0));
    vec2 extentPixels = max((maxUv - minUv) * screenDimensions, vec2(1.0));
    float mipFloat = ceil(log2(max(extentPixels.x, extentPixels.y)));
    float mipLevel = clamp(mipFloat, 0.0, float(pc.Push.HiZMipCount - 1u));

    vec2 uvCenter = (minUv + maxUv) * 0.5;
    float farthestOccluder = 1.0;
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], uvCenter, mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(minUv.x, minUv.y), mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(maxUv.x, minUv.y), mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(minUv.x, maxUv.y), mipLevel).r);
    farthestOccluder = min(farthestOccluder, textureLod(BindlessTextures[nonuniformEXT(pc.Push.HiZTextureIndex)], vec2(maxUv.x, maxUv.y), mipLevel).r);

    if (farthestOccluder <= 0.0)
        return false;

    return nearestDepth <= max(farthestOccluder - pc.Push.OcclusionBias, 0.0);
}

bool MeshletOccludedByHiZ(vec3 worldCenter, float worldRadius)
{
    if (pc.Push.OcclusionCullingEnabled == HIZ_TEST_MODE_FULL_6_POINT_5_TAP)
        return MeshletOccludedByHiZFull6Point5Tap(worldCenter, worldRadius);
    if (pc.Push.OcclusionCullingEnabled == HIZ_TEST_MODE_BOUNDS_4_TAP)
        return MeshletOccludedByHiZBounds4Tap(worldCenter, worldRadius);
    return false;
}

bool CanHiZTestMeshletDrawCommand(GPUMeshletDrawCommand command)
{
    uint materialBaseWord = command.MaterialIndex *
        uint(SIZEOF_GPU_FORWARD_MATERIAL_DATA / 4);
    float alphaMode = ReadStorageFloatUniform(
        uint(FORWARD_MATERIAL_DATA_BUFFER_INDEX),
        materialBaseWord + 9u);
    return alphaMode < 1.5;
}

uint SelectLegacyDistanceLodLevel(
    vec3 cameraPosition,
    vec3 worldCenter,
    float worldRadius)
{
    float effectiveRadius = max(worldRadius, 1.0);
    float distanceFromSurface = max(0.0, length(cameraPosition - worldCenter) - effectiveRadius);
    float distanceRatio = distanceFromSurface / effectiveRadius;
    float lod1DistanceRatio = max(pc.Push.GpuLod1DistanceRatio, 1.0);
    float lod2DistanceRatio = max(pc.Push.GpuLod2DistanceRatio, lod1DistanceRatio);
    if (distanceRatio >= lod2DistanceRatio)
        return 2u;
    if (distanceRatio >= lod1DistanceRatio)
        return 1u;
    return 0u;
}

float ProjectedLodErrorPixels(
    float absoluteObjectError,
    vec3 cameraPosition,
    vec3 worldCenter,
    float worldRadius,
    float worldScale)
{
    float surfaceDistance = max(
        length(cameraPosition - worldCenter) - max(worldRadius, 0.0),
        1e-4);
    float worldError = max(absoluteObjectError, 0.0) *
        max(worldScale, 0.0);
    return worldError * max(pc.Push.GpuLodProjectionScale, 1.0) /
        surfaceDistance;
}

uint SelectLodForPixelThreshold(
    GPUMeshInfo meshInfo,
    float lod1ErrorPixels,
    float lod2ErrorPixels,
    float threshold)
{
    bool lod2ErrorValid = uintBitsToFloat(
        meshInfo.MeshletLod2ErrorBits) >= 0.0;
    bool lod1ErrorValid = uintBitsToFloat(
        meshInfo.MeshletLod1ErrorBits) >= 0.0;
    if (meshInfo.MeshletLod2Count > 0u && lod2ErrorValid &&
        lod2ErrorPixels <= threshold)
    {
        return 2u;
    }
    if (meshInfo.MeshletLod1Count > 0u && lod1ErrorValid &&
        lod1ErrorPixels <= threshold)
    {
        return 1u;
    }
    return 0u;
}

uint SelectScreenSpaceErrorLodLevel(
    GPUMeshInfo meshInfo,
    uint instanceId,
    vec3 cameraPosition,
    vec3 worldCenter,
    float worldRadius,
    float worldScale)
{
    float lod1Error = uintBitsToFloat(meshInfo.MeshletLod1ErrorBits);
    float lod2Error = uintBitsToFloat(meshInfo.MeshletLod2ErrorBits);
    if (lod1Error < 0.0 && lod2Error < 0.0)
    {
        return SelectLegacyDistanceLodLevel(
            cameraPosition,
            worldCenter,
            worldRadius);
    }

    float lod1ErrorPixels = ProjectedLodErrorPixels(
        lod1Error,
        cameraPosition,
        worldCenter,
        worldRadius,
        worldScale);
    float lod2ErrorPixels = ProjectedLodErrorPixels(
        lod2Error,
        cameraPosition,
        worldCenter,
        worldRadius,
        worldScale);
    float target = max(pc.Push.GpuLodTargetPixelError, 0.125);
    uint selected = SelectLodForPixelThreshold(
        meshInfo,
        lod1ErrorPixels,
        lod2ErrorPixels,
        target);

    if (instanceId < pc.Push.GpuLodHistoryCapacity)
    {
        uint previousFrame =
            (pc.Push.CurrentFrameIndex + GPU_LOD_HISTORY_FRAME_COUNT - 1u) %
            GPU_LOD_HISTORY_FRAME_COUNT;
        uint previous = ReadStorageWord(
            pc.Push.GpuLodHistoryBufferBaseIndex + previousFrame,
            instanceId * GPU_LOD_TRANSITION_STATE_WORD_STRIDE +
                GPU_LOD_TRANSITION_TARGET_WORD);
        if (previous <= 2u && selected != previous)
        {
            float hysteresis = clamp(
                pc.Push.GpuLodHysteresisFraction,
                0.0,
                0.5);
            float stableThreshold = selected > previous
                ? target * (1.0 - hysteresis)
                : target * (1.0 + hysteresis);
            selected = SelectLodForPixelThreshold(
                meshInfo,
                lod1ErrorPixels,
                lod2ErrorPixels,
                stableThreshold);
        }

        uint outputBuffer = pc.Push.GpuLodHistoryBufferBaseIndex +
            pc.Push.CurrentFrameIndex;
        atomicExchange(
            BindlessStorageBuffers[nonuniformEXT(outputBuffer)].Words[
                instanceId * GPU_LOD_TRANSITION_STATE_WORD_STRIDE +
                    GPU_LOD_TRANSITION_TARGET_WORD],
            selected);
    }
    return selected;
}

uint SelectLodLevel(
    GPUMeshInfo meshInfo,
    uint instanceId,
    vec3 cameraPosition,
    vec3 worldCenter,
    float worldRadius,
    float worldScale)
{
    if (pc.Push.GpuLodSelectionMode ==
        GPU_LOD_SELECTION_MODE_SCREEN_SPACE_ERROR)
    {
        return SelectScreenSpaceErrorLodLevel(
            meshInfo,
            instanceId,
            cameraPosition,
            worldCenter,
            worldRadius,
            worldScale);
    }
    return SelectLegacyDistanceLodLevel(
        cameraPosition,
        worldCenter,
        worldRadius);
}

void SelectMeshletRange(GPUMeshInfo meshInfo, uint requestedLod, out uint firstMeshlet, out uint meshletCount, out uint effectiveLod)
{
    uint selectedLod = min(requestedLod, 2u);
    uint selectedCount = selectedLod == 0u
        ? meshInfo.MeshletCount
        : (selectedLod == 1u
            ? meshInfo.MeshletLod1Count
            : meshInfo.MeshletLod2Count);
    if (selectedCount == 0u)
    {
        selectedLod = meshInfo.MeshletCount > 0u
            ? 0u
            : (meshInfo.MeshletLod1Count > 0u ? 1u : 2u);
    }

    if ((meshInfo.ResidencyFlags &
         MESH_RESIDENCY_MANAGED_PHYSICAL_FLAG) != 0u)
    {
        uint rangeIndex = meshInfo.StreamingRangeIndex + selectedLod;
        GPUMeshletStreamingRangeData range =
            ReadMeshletStreamingRange(rangeIndex);
        if (range.PageCount != 0u && range.MeshletCount != 0u &&
            MeshletStreamingRangeReady(
                rangeIndex,
                pc.Push.CurrentFrameIndex))
        {
            firstMeshlet = MESHLET_VIRTUAL_ADDRESS_BIT |
                range.FirstVirtualMeshlet;
            meshletCount = range.MeshletCount;
            effectiveLod = selectedLod;
            return;
        }

        RequestMeshletStreamingRange(
            rangeIndex,
            pc.Push.CurrentFrameIndex);
        uint fallbackRangeIndex = range.FallbackRangeIndex;
        if (fallbackRangeIndex != 0xffffffffu &&
            MeshletStreamingRangeReady(
                fallbackRangeIndex,
                pc.Push.CurrentFrameIndex))
        {
            GPUMeshletStreamingRangeData fallback =
                ReadMeshletStreamingRange(fallbackRangeIndex);
            firstMeshlet = MESHLET_VIRTUAL_ADDRESS_BIT |
                fallback.FirstVirtualMeshlet;
            meshletCount = fallback.MeshletCount;
            uint fallbackLod = fallbackRangeIndex >=
                meshInfo.StreamingRangeIndex
                ? fallbackRangeIndex - meshInfo.StreamingRangeIndex
                : 0u;
            effectiveLod = min(fallbackLod, 2u);
            return;
        }

        // Publication waits for the pinned fallback to be present in both
        // frame tables. If that invariant is ever violated, emit no partial
        // geometry instead of reading an invalid page.
        firstMeshlet = meshInfo.MeshletOffset;
        meshletCount = 0u;
        effectiveLod = selectedLod;
        return;
    }

    effectiveLod = selectedLod;
    if (selectedLod == 0u)
    {
        firstMeshlet = meshInfo.MeshletOffset;
        meshletCount = meshInfo.MeshletCount;
    }
    else if (selectedLod == 1u)
    {
        firstMeshlet = meshInfo.MeshletLod1Offset;
        meshletCount = meshInfo.MeshletLod1Count;
    }
    else
    {
        firstMeshlet = meshInfo.MeshletLod2Offset;
        meshletCount = meshInfo.MeshletLod2Count;
    }
}

bool ApplyGpuLodSelection(inout GPUMeshletDrawCommand command, out uint effectiveLod, uint lodBias)
{
    effectiveLod = 0u;
    bool lodSelectionEnabled = (pc.Push.Flags &
        SCENE_OPAQUE_COMPACTION_FLAG_GPU_LOD_SELECTION) != 0u;

    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) + pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId * uint(SIZEOF_GPU_OBJECT_DATA / 4);
    GPUObjectData objectData = ReadInstanceData(pc.Push.CurrentFrameIndex, command.InstanceId);
    GPUMeshInfo meshInfo = ReadMeshInfo(uint(max(objectData.MeshIndex, 0)));

    uint lod0LocalIndex = command.MeshletIndex >= meshInfo.MeshletOffset
        ? command.MeshletIndex - meshInfo.MeshletOffset
        : 0xffffffffu;
    if (lod0LocalIndex >= meshInfo.MeshletCount)
        return true;

    if (!lodSelectionEnabled)
    {
        if ((meshInfo.ResidencyFlags &
             MESH_RESIDENCY_MANAGED_PHYSICAL_FLAG) == 0u)
        {
            return true;
        }
        uint residentFirst = 0u;
        uint residentCount = 0u;
        SelectMeshletRange(
            meshInfo,
            0u,
            residentFirst,
            residentCount,
            effectiveLod);
        if (residentCount == 0u || lod0LocalIndex >= residentCount)
            return false;
        command.MeshletIndex = residentFirst + lod0LocalIndex;
        return true;
    }

    // Mesh metadata with no alternate ranges intentionally represents a base-only
    // mesh. Do not calculate a requested LOD or report a missing-LOD fallback for
    // that normal, non-degraded case.
    if (meshInfo.MeshletLod1Count == 0u && meshInfo.MeshletLod2Count == 0u)
    {
        effectiveLod = 0u;
        return true;
    }

    vec4 worldCenter = TransformRowMajorPoint(meshInfo.BoundingSphere.xyz, instanceBufferIndex, objectWordOffset);
    float worldScale = ReadInstanceMaxScale(instanceBufferIndex, objectWordOffset);
    float worldRadius = meshInfo.BoundingSphere.w * worldScale;
    uint requestedLod = min(
        SelectLodLevel(
            meshInfo,
            command.InstanceId,
            pc.Push.CameraPosition.xyz,
            worldCenter.xyz,
            worldRadius,
            worldScale) + lodBias,
        2u);

    uint firstMeshlet = 0u;
    uint meshletCount = 0u;
    SelectMeshletRange(meshInfo, requestedLod, firstMeshlet, meshletCount, effectiveLod);
    if (meshletCount == 0u)
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_MISSING_LOD_FALLBACK], 1u);
        return false;
    }

    if (effectiveLod != requestedLod)
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_MISSING_LOD_FALLBACK], 1u);

    if (lod0LocalIndex >= meshletCount)
    {
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                SCENE_SUBMISSION_COUNTER_OPAQUE_LOD_DECIMATED],
            1u);
        return false;
    }

    command.MeshletIndex = firstMeshlet + lod0LocalIndex;
    return true;
}

bool ApplyConservativeDirectionalShadowLodSelection(
    inout GPUMeshletDrawCommand command,
    out uint effectiveLod,
    uint lodBias)
{
    // The directional-shadow candidate stream is generated from LOD0 meshlet
    // commands. A one-to-one remap into a lower-LOD range was previously used
    // here, but lower LODs normally have fewer and differently grouped meshlets.
    // That mapping silently discarded every source meshlet beyond the lower-LOD
    // count, creating incomplete caster coverage and distance-dependent holes.
    // Preserve the source LOD0 command until the renderer has a mesh-level
    // remapping/deduplication path that can prove coverage equivalence.
    effectiveLod = 0u;
    bool lodSelectionEnabled = (pc.Push.Flags &
        SCENE_OPAQUE_COMPACTION_FLAG_GPU_LOD_SELECTION) != 0u;

    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) + pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId * uint(SIZEOF_GPU_OBJECT_DATA / 4);
    GPUObjectData objectData = ReadInstanceData(pc.Push.CurrentFrameIndex, command.InstanceId);
    GPUMeshInfo meshInfo = ReadMeshInfo(uint(max(objectData.MeshIndex, 0)));
    uint lod0LocalIndex = command.MeshletIndex >= meshInfo.MeshletOffset
        ? command.MeshletIndex - meshInfo.MeshletOffset
        : 0xffffffffu;
    if (lod0LocalIndex >= meshInfo.MeshletCount ||
        (meshInfo.MeshletLod1Count == 0u && meshInfo.MeshletLod2Count == 0u))
    {
        return true;
    }

    if (!lodSelectionEnabled)
    {
        if ((meshInfo.ResidencyFlags &
             MESH_RESIDENCY_MANAGED_PHYSICAL_FLAG) == 0u)
        {
            return true;
        }
        uint residentFirst = 0u;
        uint residentCount = 0u;
        SelectMeshletRange(
            meshInfo,
            0u,
            residentFirst,
            residentCount,
            effectiveLod);
        if (residentCount == 0u || lod0LocalIndex >= residentCount)
            return false;
        command.MeshletIndex = residentFirst + lod0LocalIndex;
        return true;
    }

    vec4 worldCenter = TransformRowMajorPoint(meshInfo.BoundingSphere.xyz, instanceBufferIndex, objectWordOffset);
    float worldScale = ReadInstanceMaxScale(instanceBufferIndex, objectWordOffset);
    float worldRadius = meshInfo.BoundingSphere.w * worldScale;
    uint requestedLod = min(
        SelectLodLevel(
            meshInfo,
            command.InstanceId,
            pc.Push.CameraPosition.xyz,
            worldCenter.xyz,
            worldRadius,
            worldScale) + lodBias,
        2u);
    if (requestedLod > 0u)
    {
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_LOD_FALLBACK],
            1u);
    }

    if ((meshInfo.ResidencyFlags &
         MESH_RESIDENCY_MANAGED_PHYSICAL_FLAG) != 0u)
    {
        uint firstMeshlet = 0u;
        uint meshletCount = 0u;
        SelectMeshletRange(
            meshInfo,
            requestedLod,
            firstMeshlet,
            meshletCount,
            effectiveLod);
        if (meshletCount == 0u || lod0LocalIndex >= meshletCount)
            return false;
        command.MeshletIndex = firstMeshlet + lod0LocalIndex;
    }

    return true;
}

GPUSceneInstanceCandidate ReadSceneInstanceCandidate(uint candidateIndex)
{
    uint bufferIndex = pc.Push.InstanceCandidateBufferBaseIndex +
        pc.Push.CurrentFrameIndex;
    uint baseWord = candidateIndex *
        uint(SIZEOF_GPU_SCENE_INSTANCE_CANDIDATE / 4);
    GPUSceneInstanceCandidate candidate;
    candidate.InstanceId = ReadStorageWord(bufferIndex, baseWord + 0u);
    candidate.MaterialIndex = ReadStorageWord(bufferIndex, baseWord + 1u);
    candidate.CommandFlags = ReadStorageWord(bufferIndex, baseWord + 2u);
    candidate.Classification = ReadStorageWord(bufferIndex, baseWord + 3u);
    return candidate;
}

void ResolveLodTransition(
    uint instanceId,
    uint targetLod,
    out uint sourceLod,
    out uint ditherThreshold,
    out bool transitionActive)
{
    sourceLod = targetLod;
    ditherThreshold = 15u;
    transitionActive = false;
    if ((pc.Push.Flags &
         SCENE_OPAQUE_COMPACTION_FLAG_LOD_DITHER_TRANSITION) == 0u ||
        pc.Push.LodTransitionFrameCount == 0u ||
        instanceId >= pc.Push.GpuLodHistoryCapacity)
    {
        return;
    }

    uint previousFrame =
        (pc.Push.CurrentFrameIndex + GPU_LOD_HISTORY_FRAME_COUNT - 1u) %
        GPU_LOD_HISTORY_FRAME_COUNT;
    uint previousBuffer = pc.Push.GpuLodHistoryBufferBaseIndex +
        previousFrame;
    uint currentBuffer = pc.Push.GpuLodHistoryBufferBaseIndex +
        pc.Push.CurrentFrameIndex;
    uint baseWord = instanceId * GPU_LOD_TRANSITION_STATE_WORD_STRIDE;
    uint previousSource = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_SOURCE_WORD);
    uint previousTarget = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_TARGET_WORD);
    uint transitionStart = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_START_FRAME_WORD);
    uint lastUpdated = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_LAST_UPDATED_WORD);
    bool previousValid = previousSource <= 2u &&
        previousTarget <= 2u &&
        transitionStart != 0xffffffffu &&
        lastUpdated != 0xffffffffu &&
        pc.Push.TemporalFrameIndex - lastUpdated <= 1u;

    if (previousValid)
    {
        sourceLod = previousSource;
        if (targetLod != previousTarget)
        {
            uint previousElapsed = pc.Push.TemporalFrameIndex -
                transitionStart;
            sourceLod = previousElapsed * 2u <
                    pc.Push.LodTransitionFrameCount
                ? previousSource
                : previousTarget;
            transitionStart = pc.Push.TemporalFrameIndex;
        }

        uint elapsed = pc.Push.TemporalFrameIndex - transitionStart;
        if (sourceLod != targetLod &&
            elapsed < pc.Push.LodTransitionFrameCount)
        {
            transitionActive = true;
            uint numerator = (elapsed + 1u) * 16u +
                pc.Push.LodTransitionFrameCount - 1u;
            ditherThreshold = min(
                15u,
                numerator / pc.Push.LodTransitionFrameCount - 1u);
        }
        else
        {
            sourceLod = targetLod;
            transitionStart = pc.Push.TemporalFrameIndex;
        }
    }
    else
    {
        transitionStart = pc.Push.TemporalFrameIndex;
    }

    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_SOURCE_WORD],
        sourceLod);
    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_TARGET_WORD],
        targetLod);
    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_START_FRAME_WORD],
        transitionStart);
    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_LAST_UPDATED_WORD],
        pc.Push.TemporalFrameIndex);
}

uint EncodeHierarchyProjectionFactor(float projectionFactor)
{
    float finiteFactor =
        (isnan(projectionFactor) || isinf(projectionFactor))
            ? 0.0
            : clamp(projectionFactor, 0.0, 1e20);
    return floatBitsToUint(finiteFactor) |
        MESHLET_HIERARCHY_STATE_MARKER;
}

float DecodeHierarchyProjectionFactor(uint encoded)
{
    return uintBitsToFloat(
        encoded & ~MESHLET_HIERARCHY_STATE_MARKER);
}

void ResolveHierarchyProjectionTransition(
    uint instanceId,
    float currentProjectionFactor,
    out float sourceProjectionFactor,
    out float targetProjectionFactor,
    out uint ditherThreshold,
    out bool transitionActive)
{
    currentProjectionFactor =
        (isnan(currentProjectionFactor) ||
         isinf(currentProjectionFactor))
            ? 0.0
            : clamp(currentProjectionFactor, 0.0, 1e20);
    sourceProjectionFactor = currentProjectionFactor;
    targetProjectionFactor = currentProjectionFactor;
    ditherThreshold = 15u;
    transitionActive = false;
    if ((pc.Push.Flags &
         SCENE_OPAQUE_COMPACTION_FLAG_LOD_DITHER_TRANSITION) == 0u ||
        pc.Push.LodTransitionFrameCount == 0u ||
        instanceId >= pc.Push.GpuLodHistoryCapacity)
    {
        return;
    }

    uint previousFrame =
        (pc.Push.CurrentFrameIndex + GPU_LOD_HISTORY_FRAME_COUNT - 1u) %
        GPU_LOD_HISTORY_FRAME_COUNT;
    uint previousBuffer = pc.Push.GpuLodHistoryBufferBaseIndex +
        previousFrame;
    uint currentBuffer = pc.Push.GpuLodHistoryBufferBaseIndex +
        pc.Push.CurrentFrameIndex;
    uint baseWord = instanceId *
        GPU_LOD_TRANSITION_STATE_WORD_STRIDE;
    uint encodedSource = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_SOURCE_WORD);
    uint encodedTarget = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_TARGET_WORD);
    uint transitionStart = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_START_FRAME_WORD);
    uint lastUpdated = ReadStorageWord(
        previousBuffer,
        baseWord + GPU_LOD_TRANSITION_LAST_UPDATED_WORD);
    bool previousValid =
        (encodedSource & MESHLET_HIERARCHY_STATE_MARKER) != 0u &&
        (encodedTarget & MESHLET_HIERARCHY_STATE_MARKER) != 0u &&
        transitionStart != 0xffffffffu &&
        lastUpdated != 0xffffffffu &&
        pc.Push.TemporalFrameIndex - lastUpdated <= 1u;

    if (previousValid)
    {
        float previousSource =
            DecodeHierarchyProjectionFactor(encodedSource);
        float previousTarget =
            DecodeHierarchyProjectionFactor(encodedTarget);
        uint previousElapsed = pc.Push.TemporalFrameIndex -
            transitionStart;
        float relativeChange = abs(
            currentProjectionFactor - previousTarget) /
            max(previousTarget, 1e-6);
        bool targetChanged = relativeChange > clamp(
            pc.Push.GpuLodHysteresisFraction,
            0.0,
            0.5);
        if (targetChanged)
        {
            sourceProjectionFactor =
                previousElapsed * 2u <
                    pc.Push.LodTransitionFrameCount
                    ? previousSource
                    : previousTarget;
            targetProjectionFactor = currentProjectionFactor;
            transitionStart = pc.Push.TemporalFrameIndex;
        }
        else
        {
            sourceProjectionFactor = previousSource;
            targetProjectionFactor = previousTarget;
        }

        uint elapsed = pc.Push.TemporalFrameIndex - transitionStart;
        float transitionDelta = abs(
            sourceProjectionFactor - targetProjectionFactor);
        if (transitionDelta >
                max(targetProjectionFactor, 1e-6) * 1e-5 &&
            elapsed < pc.Push.LodTransitionFrameCount)
        {
            transitionActive = true;
            uint numerator = (elapsed + 1u) * 16u +
                pc.Push.LodTransitionFrameCount - 1u;
            ditherThreshold = min(
                15u,
                numerator / pc.Push.LodTransitionFrameCount - 1u);
        }
        else
        {
            sourceProjectionFactor = targetProjectionFactor;
            transitionStart = pc.Push.TemporalFrameIndex;
        }
    }
    else
    {
        transitionStart = pc.Push.TemporalFrameIndex;
    }

    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_SOURCE_WORD],
        EncodeHierarchyProjectionFactor(sourceProjectionFactor));
    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_TARGET_WORD],
        EncodeHierarchyProjectionFactor(targetProjectionFactor));
    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_START_FRAME_WORD],
        transitionStart);
    atomicExchange(
        BindlessStorageBuffers[nonuniformEXT(currentBuffer)].Words[
            baseWord + GPU_LOD_TRANSITION_LAST_UPDATED_WORD],
        pc.Push.TemporalFrameIndex);
}

void ReserveSubgroupRange(
    bool accepted,
    uint bufferIndex,
    uint counterWord,
    out uint outputIndex,
    out uint activeCount)
{
    uvec4 activeMask = subgroupBallot(accepted);
    activeCount = subgroupBallotBitCount(activeMask);
    uint baseIndex = 0u;
    if (subgroupElect() && activeCount != 0u)
    {
        baseIndex = atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(bufferIndex)].Words[
                counterWord],
            activeCount);
    }
    baseIndex = subgroupBroadcastFirst(baseIndex);
    outputIndex = baseIndex +
        subgroupBallotExclusiveBitCount(activeMask);
}

void AddSubgroupCount(
    bool accepted,
    uint bufferIndex,
    uint counterWord)
{
    uvec4 activeMask = subgroupBallot(accepted);
    uint activeCount = subgroupBallotBitCount(activeMask);
    if (subgroupElect() && activeCount != 0u)
    {
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(bufferIndex)].Words[
                counterWord],
            activeCount);
    }
}

void EmitExpandedOpaqueCommand(
    GPUMeshletDrawCommand command,
    uint bucket,
    uint effectiveLod,
    bool visible)
{
    uint counterBufferIndex = CounterBufferIndex();
    bool doubleSided = IsDoubleSided(command);

    uint aggregateIndex = 0u;
    uint aggregateCount = 0u;
    ReserveSubgroupRange(
        visible,
        counterBufferIndex,
        SCENE_SUBMISSION_COUNTER_OPAQUE_APPEND,
        aggregateIndex,
        aggregateCount);

    uint bucketIndex = 0u;
    uint bucketCount = 0u;
    ReserveSubgroupRange(
        visible,
        counterBufferIndex,
        OpaqueBucketAppendCounterWord(bucket, doubleSided),
        bucketIndex,
        bucketCount);

    uint bucketCapacity = OpaqueBucketOutputCapacity(bucket);
    bool aggregateOverflow = visible &&
        aggregateIndex >= pc.Push.OutputCapacity;
    bool bucketOverflow = visible && bucketIndex >= bucketCapacity;
    bool emitted = visible && !aggregateOverflow && !bucketOverflow;

    if (emitted)
    {
        WriteMeshletDrawCommand(aggregateIndex, command);
        WriteOpaqueBucketMeshletDrawCommand(
            bucket,
            bucketIndex + (doubleSided ? bucketCapacity : 0u),
            command);
    }

    AddSubgroupCount(
        aggregateOverflow || bucketOverflow,
        counterBufferIndex,
        SCENE_SUBMISSION_COUNTER_OPAQUE_OVERFLOW);
    AddSubgroupCount(
        bucketOverflow,
        counterBufferIndex,
        OpaqueBucketOverflowCounterWord(bucket));
    AddSubgroupCount(
        emitted,
        counterBufferIndex,
        SCENE_SUBMISSION_COUNTER_OPAQUE_EMITTED);
    AddSubgroupCount(
        emitted,
        counterBufferIndex,
        OpaqueBucketEmittedCounterWord(bucket));
    AddSubgroupCount(
        emitted,
        IndirectDispatchBufferIndex(),
        IndirectDispatchCountWord(SCENE_INDIRECT_DISPATCH_OPAQUE_SLOT));
    AddSubgroupCount(
        emitted,
        IndirectDispatchBufferIndex(),
        IndirectDispatchCountWord(
            OpaqueBucketIndirectDispatchSlot(bucket, doubleSided)));
    AddSubgroupCount(
        emitted,
        counterBufferIndex,
        SCENE_SUBMISSION_COUNTER_LOD0_EMITTED + min(effectiveLod, 2u));
}

void EmitExpandedDepthCommand(
    GPUMeshletDrawCommand command,
    bool masked,
    bool visible)
{
    bool doubleSided = IsDoubleSided(command);
    uint counterBufferIndex = CounterBufferIndex();
    uint appendCounterWord = masked
        ? (doubleSided
            ? SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_DOUBLE_SIDED_APPEND
            : SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_APPEND)
        : (doubleSided
            ? SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_DOUBLE_SIDED_APPEND
            : SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_APPEND);
    uint outputCapacity = masked
        ? pc.Push.MaskedDepthOutputCapacity
        : pc.Push.SolidDepthOutputCapacity;
    uint outputIndex = 0u;
    uint activeCount = 0u;
    ReserveSubgroupRange(
        visible,
        counterBufferIndex,
        appendCounterWord,
        outputIndex,
        activeCount);

    bool overflow = visible && outputIndex >= outputCapacity;
    bool emitted = visible && !overflow;
    if (emitted)
    {
        WriteMeshletDrawCommandToBase(
            masked
                ? MaskedDepthOutputBufferIndex()
                : SolidDepthOutputBufferIndex(),
            outputIndex + (doubleSided ? outputCapacity : 0u),
            command);
    }

    AddSubgroupCount(
        overflow,
        counterBufferIndex,
        masked
            ? SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_OVERFLOW
            : SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_OVERFLOW);
    AddSubgroupCount(
        emitted,
        counterBufferIndex,
        masked
            ? SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_EMITTED
            : SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_EMITTED);
    AddSubgroupCount(
        emitted,
        IndirectDispatchBufferIndex(),
        IndirectDispatchCountWord(masked
            ? (doubleSided
                ? SCENE_INDIRECT_DISPATCH_MASKED_DEPTH_DOUBLE_SIDED_SLOT
                : SCENE_INDIRECT_DISPATCH_MASKED_DEPTH_SLOT)
            : (doubleSided
                ? SCENE_INDIRECT_DISPATCH_SOLID_DEPTH_DOUBLE_SIDED_SLOT
                : SCENE_INDIRECT_DISPATCH_SOLID_DEPTH_SLOT)));
}

uint BuildExpandedCommandFlags(
    bool transitionActive,
    bool ditherTarget,
    uint ditherThreshold)
{
    uint flags = InstanceCandidateCommandFlags &
        ~(MESHLET_COMMAND_FLAG_LOD_DITHER_TRANSITION |
          MESHLET_COMMAND_FLAG_LOD_DITHER_TARGET |
          MESHLET_COMMAND_FLAG_LOD_DITHER_THRESHOLD_MASK);
    if (transitionActive)
    {
        flags |= MESHLET_COMMAND_FLAG_LOD_DITHER_TRANSITION |
            ((ditherThreshold <<
                MESHLET_COMMAND_FLAG_LOD_DITHER_THRESHOLD_SHIFT) &
             MESHLET_COMMAND_FLAG_LOD_DITHER_THRESHOLD_MASK);
        if (ditherTarget)
            flags |= MESHLET_COMMAND_FLAG_LOD_DITHER_TARGET;
    }
    return flags;
}

void ProcessExpandedDirectionalShadowRange(
    uint candidateIndex,
    uint firstMeshlet,
    uint meshletCount,
    uint effectiveLod,
    bool dynamicShadow,
    bool transitionActive,
    bool ditherTarget,
    uint ditherThreshold)
{
    if ((pc.Push.Flags &
         SCENE_OPAQUE_COMPACTION_FLAG_DIRECTIONAL_SHADOW_COMPACTION) == 0u ||
        meshletCount == 0u)
    {
        return;
    }

    uint counterBufferIndex = CounterBufferIndex();
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) +
        pc.Push.CurrentFrameIndex;
    uint objectWordOffset = InstanceCandidateInstanceId *
        uint(SIZEOF_GPU_OBJECT_DATA / 4);
    uint cascadeCount = min(
        pc.Push.DirectionalShadowCascadeCount,
        SCENE_DIRECTIONAL_SHADOW_CASCADE_COUNT);
    uint iterationCount = (meshletCount + gl_WorkGroupSize.x - 1u) /
        gl_WorkGroupSize.x;
    for (uint iteration = 0u; iteration < iterationCount; iteration++)
    {
        uint localMeshletIndex = iteration * gl_WorkGroupSize.x +
            gl_LocalInvocationID.x;
        bool valid = localMeshletIndex < meshletCount;
        GPUMeshletDrawCommand command;
        command.MeshletIndex = valid
            ? firstMeshlet + localMeshletIndex
            : 0u;
        command.InstanceId = InstanceCandidateInstanceId;
        command.MaterialIndex = InstanceCandidateMaterialIndex;
        command.Flags = BuildExpandedCommandFlags(
            transitionActive,
            ditherTarget,
            ditherThreshold);

        vec4 worldSphere = vec4(0.0);
        if (valid)
        {
            GPUMeshlet meshlet;
            valid = ReadCompactionMeshlet(command, meshlet);
            if (valid)
            {
                worldSphere = ResolveMeshletWorldCenterRadius(
                    command,
                    meshlet);
            }
        }
        bool doubleSided = IsDoubleSided(command);

        for (uint cascade = 0u; cascade < cascadeCount; cascade++)
        {
            if (!dynamicShadow &&
                (pc.Push.DirectionalStaticShadowCascadeMask &
                 (1u << cascade)) == 0u)
            {
                continue;
            }

            uint counterBaseWord = dynamicShadow
                ? SCENE_SUBMISSION_COUNTER_DIRECTIONAL_DYNAMIC_SHADOW_BASE
                : SCENE_SUBMISSION_COUNTER_DIRECTIONAL_STATIC_SHADOW_BASE;
            uint cascadeCounterBase = counterBaseWord + cascade *
                SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_STRIDE;
            AddSubgroupCount(
                valid,
                counterBufferIndex,
                cascadeCounterBase +
                    SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_CANDIDATE_OFFSET);

            mat4 shadowMatrix = ReadShadowMatrix(cascade);
            bool visible = valid && SphereIntersectsRowMajorFrustum(
                worldSphere.xyz,
                worldSphere.w,
                shadowMatrix);
#if NJULF_GPU_DIAGNOSTIC_COUNTERS
            if (valid)
            {
                RecordDirectionalShadowCasterAttribution(
                    pc.Push.CurrentFrameIndex,
                    command.InstanceId,
                    command.InstanceId,
                    command.MeshletIndex,
                    effectiveLod,
                    dynamicShadow
                        ? DIRECTIONAL_SHADOW_CASTER_CLASS_DYNAMIC
                        : DIRECTIONAL_SHADOW_CASTER_CLASS_STATIC,
                    cascade,
                    candidateIndex,
                    DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_INPUT |
                        DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_COMPACTION |
                        DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_CONSERVATIVE_LOD |
                        (dynamicShadow
                            ? DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_DYNAMIC
                            : DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_STATIC),
                    worldSphere,
                    shadowMatrix,
                    visible);
            }
#endif
            AddSubgroupCount(
                valid && !visible,
                counterBufferIndex,
                cascadeCounterBase +
                    SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_REJECTED_OFFSET);

            uint appendCounterWord = doubleSided
                ? (dynamicShadow
                    ? SCENE_SUBMISSION_COUNTER_DIRECTIONAL_DYNAMIC_SHADOW_DOUBLE_SIDED_BASE
                    : SCENE_SUBMISSION_COUNTER_DIRECTIONAL_STATIC_SHADOW_DOUBLE_SIDED_BASE) +
                    cascade
                : cascadeCounterBase +
                    SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_APPEND_OFFSET;
            uint outputIndex = 0u;
            uint activeCount = 0u;
            ReserveSubgroupRange(
                visible,
                counterBufferIndex,
                appendCounterWord,
                outputIndex,
                activeCount);
            uint outputCapacity = dynamicShadow
                ? pc.Push.DirectionalDynamicShadowOutputCapacity
                : pc.Push.DirectionalStaticShadowOutputCapacity;
            bool overflow = visible && outputIndex >= outputCapacity;
            bool emitted = visible && !overflow;
            if (emitted)
            {
                uint outputBufferIndex = dynamicShadow
                    ? DirectionalDynamicShadowOutputBufferIndex(cascade)
                    : DirectionalStaticShadowOutputBufferIndex(cascade);
                WriteMeshletDrawCommandToBase(
                    outputBufferIndex,
                    outputIndex + (doubleSided ? outputCapacity : 0u),
                    command);
            }
            AddSubgroupCount(
                overflow,
                counterBufferIndex,
                cascadeCounterBase +
                    SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_OVERFLOW_OFFSET);
            AddSubgroupCount(
                emitted,
                counterBufferIndex,
                cascadeCounterBase +
                    SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_EMITTED_OFFSET);
            uint indirectDispatchSlot = doubleSided
                ? (dynamicShadow
                    ? SCENE_INDIRECT_DISPATCH_DIRECTIONAL_DYNAMIC_SHADOW_DOUBLE_SIDED_SLOT_BASE
                    : SCENE_INDIRECT_DISPATCH_DIRECTIONAL_STATIC_SHADOW_DOUBLE_SIDED_SLOT_BASE) +
                    cascade
                : (dynamicShadow
                    ? SCENE_INDIRECT_DISPATCH_DIRECTIONAL_DYNAMIC_SHADOW_SLOT_BASE
                    : SCENE_INDIRECT_DISPATCH_DIRECTIONAL_STATIC_SHADOW_SLOT_BASE) +
                    cascade;
            AddSubgroupCount(
                emitted,
                IndirectDispatchBufferIndex(),
                IndirectDispatchCountWord(indirectDispatchSlot));
        }
    }
}

void ProcessExpandedMeshletRange(
    uint firstMeshlet,
    uint meshletCount,
    uint effectiveLod,
    uint bucket,
    bool masked,
    bool transitionActive,
    bool ditherTarget,
    uint ditherThreshold,
    vec4 frustumPlanes[6])
{
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) +
        pc.Push.CurrentFrameIndex;
    uint objectWordOffset = InstanceCandidateInstanceId *
        uint(SIZEOF_GPU_OBJECT_DATA / 4);
    uint iterationCount = (meshletCount + gl_WorkGroupSize.x - 1u) /
        gl_WorkGroupSize.x;
    for (uint iteration = 0u; iteration < iterationCount; iteration++)
    {
        uint localMeshletIndex = iteration * gl_WorkGroupSize.x +
            gl_LocalInvocationID.x;
        bool valid = localMeshletIndex < meshletCount;
        GPUMeshletDrawCommand command;
        command.MeshletIndex = valid
            ? firstMeshlet + localMeshletIndex
            : firstMeshlet;
        command.InstanceId = InstanceCandidateInstanceId;
        command.MaterialIndex = InstanceCandidateMaterialIndex;
        command.Flags = BuildExpandedCommandFlags(
            transitionActive,
            ditherTarget,
            ditherThreshold);

        GPUMeshlet meshlet = EmptyMeshlet();
        if (valid)
            valid = ReadCompactionMeshlet(command, meshlet);
        vec4 worldCenterRadius = ResolveMeshletWorldCenterRadius(
            command,
            meshlet);
        bool visible = valid &&
            (pc.Push.Flags &
                SCENE_OPAQUE_COMPACTION_FLAG_FRUSTUM_TEST) == 0u ||
            (valid && SphereIntersectsFrustumPlanes(
                 worldCenterRadius.xyz,
                 worldCenterRadius.w,
                 frustumPlanes));

        if (visible && IsNormalConeCullEligible(command))
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                    SCENE_SUBMISSION_COUNTER_NORMAL_CONE_CANDIDATE],
                1u);
            if (!MeshletNormalConeValid(meshlet))
            {
                atomicAdd(
                    BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                        SCENE_SUBMISSION_COUNTER_NORMAL_CONE_INVALID],
                    1u);
            }
            else
            {
                atomicAdd(
                    BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                        SCENE_SUBMISSION_COUNTER_NORMAL_CONE_TESTED],
                    1u);
                if (MeshletBackfaceConeCulled(
                        meshlet,
                        instanceBufferIndex,
                        objectWordOffset,
                        worldCenterRadius.xyz,
                        worldCenterRadius.w,
                        pc.Push.CameraPosition.xyz))
                {
                    atomicAdd(
                        BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                            SCENE_SUBMISSION_COUNTER_NORMAL_CONE_REJECTED],
                        1u);
                    visible = false;
                }
            }
        }

        // Depth and forward share the geometric visibility result. Previous
        // Hi-Z remains a forward-only rejection so this frame's depth producer
        // stays conservative.
        bool depthEnabled = masked
            ? pc.Push.MaskedDepthCandidateCount != 0u
            : pc.Push.SolidDepthCandidateCount != 0u;
        if (depthEnabled)
            EmitExpandedDepthCommand(command, masked, visible);

        bool forwardVisible = visible;
        if (forwardVisible && CanHiZTestMeshletDrawCommand(command) &&
            pc.Push.OcclusionCullingEnabled != HIZ_TEST_MODE_OFF &&
            pc.Push.HiZMipCount != 0u &&
            pc.Push.PreviousHiZFrameValid != 0u &&
            ReadMeshletTaskPreviousHiZFrameValid(
                pc.Push.CurrentFrameIndex) != 0u)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                    SCENE_SUBMISSION_COUNTER_OPAQUE_HIZ_TESTED],
                1u);
            if (MeshletOccludedByHiZ(
                    worldCenterRadius.xyz,
                    worldCenterRadius.w))
            {
                atomicAdd(
                    BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                        SCENE_SUBMISSION_COUNTER_OPAQUE_HIZ_REJECTED],
                    1u);
                forwardVisible = false;
            }
        }

        EmitExpandedOpaqueCommand(
            command,
            bucket,
            effectiveLod,
            forwardVisible);
    }
}

void ProcessHierarchicalInstance(
    GPUMeshInfo meshInfo,
    float projectionFactor,
    bool transitionActive,
    bool transitionTarget,
    uint ditherThreshold,
    uint bucket,
    bool masked,
    vec4 frustumPlanes[6])
{
    if (gl_LocalInvocationID.x == 0u)
    {
        HierarchyTraversalStackCount = 0u;
        HierarchyTraversalVisitedCount = 0u;
        HierarchyTraversalSelectedFirst = 0u;
        HierarchyTraversalSelectedCount = 0u;
        HierarchyTraversalSelectedDepth = 0u;
        HierarchyTraversalDone = 0u;
        HierarchyTraversalFailure = 0u;
        HierarchyTraversalEmittedAny = 0u;
        bool validRoot = meshInfo.HierarchyNodeCount != 0u &&
            meshInfo.HierarchyRootNode >=
                meshInfo.HierarchyNodeOffset &&
            meshInfo.HierarchyRootNode -
                meshInfo.HierarchyNodeOffset <
                meshInfo.HierarchyNodeCount;
        if (validRoot)
        {
            HierarchyTraversalStack[0] =
                meshInfo.HierarchyRootNode;
            HierarchyTraversalStackCount = 1u;
        }
        else
        {
            HierarchyTraversalFailure = 1u;
            HierarchyTraversalDone = 1u;
        }
    }
    barrier();

    for (;;)
    {
        if (gl_LocalInvocationID.x == 0u)
        {
            HierarchyTraversalSelectedCount = 0u;
            while (HierarchyTraversalStackCount != 0u &&
                   HierarchyTraversalSelectedCount == 0u &&
                   HierarchyTraversalFailure == 0u)
            {
                uint nodeRecord = HierarchyTraversalStack[
                    --HierarchyTraversalStackCount];
                HierarchyTraversalVisitedCount++;
                if (HierarchyTraversalVisitedCount >
                    meshInfo.HierarchyNodeCount)
                {
                    HierarchyTraversalFailure = 1u;
                    break;
                }

                GPUMeshletHierarchyNode node =
                    ReadMeshletHierarchyNode(nodeRecord);
                bool finiteNode =
                    !any(isnan(node.BoundingSphereCenter)) &&
                    !any(isinf(node.BoundingSphereCenter)) &&
                    !isnan(node.BoundingSphereRadius) &&
                    !isinf(node.BoundingSphereRadius) &&
                    node.BoundingSphereRadius >= 0.0 &&
                    !isnan(node.GeometricError) &&
                    !isinf(node.GeometricError) &&
                    node.GeometricError >= 0.0;
                bool leaf = (node.Flags &
                    MESHLET_HIERARCHY_NODE_FLAG_LEAF) != 0u;
                bool forceRefine = (node.Flags &
                    MESHLET_HIERARCHY_NODE_FLAG_FORCE_REFINE) != 0u;
                bool childRangeValid = node.ChildCount == 0u ||
                    (node.FirstChild >= meshInfo.HierarchyNodeOffset &&
                     node.FirstChild - meshInfo.HierarchyNodeOffset <=
                         meshInfo.HierarchyNodeCount &&
                     node.ChildCount <=
                         meshInfo.HierarchyNodeCount -
                         (node.FirstChild -
                          meshInfo.HierarchyNodeOffset));
                bool meshletRangeValid = node.MeshletCount == 0u ||
                    (node.MeshletOffset >= meshInfo.MeshletOffset &&
                     node.MeshletOffset - meshInfo.MeshletOffset <=
                         meshInfo.MeshletLodGeneratedCount &&
                     node.MeshletCount <=
                         meshInfo.MeshletLodGeneratedCount -
                         (node.MeshletOffset -
                          meshInfo.MeshletOffset));
                bool nodeValid = node.Valid != 0u && finiteNode &&
                    node.ChildCount <= 8u &&
                    node.Depth <= 12u &&
                    childRangeValid && meshletRangeValid &&
                    leaf == (node.ChildCount == 0u) &&
                    !(leaf && forceRefine) &&
                    !(forceRefine && node.MeshletCount != 0u) &&
                    (leaf || forceRefine ||
                     node.MeshletCount != 0u);
                if (!nodeValid)
                {
                    HierarchyTraversalFailure = 1u;
                    break;
                }

                bool refine = node.ChildCount != 0u &&
                    (forceRefine ||
                     node.GeometricError *
                        max(projectionFactor, 0.0) >
                        max(pc.Push.GpuLodTargetPixelError, 0.125));
                if (refine)
                {
                    if (HierarchyTraversalStackCount +
                        node.ChildCount >
                        MESHLET_HIERARCHY_STACK_CAPACITY)
                    {
                        HierarchyTraversalFailure = 1u;
                        break;
                    }
                    for (uint child = 0u;
                         child < node.ChildCount;
                         child++)
                    {
                        HierarchyTraversalStack[
                            HierarchyTraversalStackCount++] =
                            node.FirstChild +
                            (node.ChildCount - 1u - child);
                    }
                    continue;
                }

                HierarchyTraversalSelectedFirst =
                    node.MeshletOffset;
                HierarchyTraversalSelectedCount =
                    node.MeshletCount;
                HierarchyTraversalSelectedDepth = node.Depth;
            }

            if (HierarchyTraversalFailure != 0u ||
                (HierarchyTraversalStackCount == 0u &&
                 HierarchyTraversalSelectedCount == 0u))
            {
                HierarchyTraversalDone = 1u;
            }
        }
        barrier();

        if (HierarchyTraversalSelectedCount != 0u)
        {
            if (gl_LocalInvocationID.x == 0u)
            {
                atomicAdd(
                    BindlessStorageBuffers[
                        nonuniformEXT(CounterBufferIndex())].Words[
                        SCENE_SUBMISSION_COUNTER_HIERARCHY_SELECTED_NODE],
                    1u);
            }
            ProcessExpandedMeshletRange(
                HierarchyTraversalSelectedFirst,
                HierarchyTraversalSelectedCount,
                min(HierarchyTraversalSelectedDepth, 2u),
                bucket,
                masked,
                transitionActive,
                transitionTarget,
                ditherThreshold,
                frustumPlanes);
            if (gl_LocalInvocationID.x == 0u)
                HierarchyTraversalEmittedAny = 1u;
        }
        barrier();
        if (HierarchyTraversalDone != 0u)
            break;
    }

    if (HierarchyTraversalFailure != 0u &&
        HierarchyTraversalEmittedAny == 0u)
    {
        if (gl_LocalInvocationID.x == 0u)
        {
            atomicAdd(
                BindlessStorageBuffers[
                    nonuniformEXT(CounterBufferIndex())].Words[
                SCENE_SUBMISSION_COUNTER_MISSING_LOD_FALLBACK],
                1u);
            atomicAdd(
                BindlessStorageBuffers[
                    nonuniformEXT(CounterBufferIndex())].Words[
                    SCENE_SUBMISSION_COUNTER_HIERARCHY_TRAVERSAL_FALLBACK],
                1u);
        }
        ProcessExpandedMeshletRange(
            meshInfo.MeshletOffset,
            meshInfo.MeshletCount,
            0u,
            bucket,
            masked,
            transitionActive,
            transitionTarget,
            ditherThreshold,
            frustumPlanes);
    }
}

void ProcessInstanceCandidate(
    uint candidateIndex,
    vec4 frustumPlanes[6])
{
    if (candidateIndex >= pc.Push.InstanceCandidateCount)
        return;

    if (gl_LocalInvocationID.x == 0u)
    {
        GPUSceneInstanceCandidate candidate =
            ReadSceneInstanceCandidate(candidateIndex);
        GPUObjectData objectData = ReadInstanceData(
            pc.Push.CurrentFrameIndex,
            candidate.InstanceId);
        uint meshIndex = uint(max(objectData.MeshIndex, 0));
        GPUMeshInfo meshInfo = ReadMeshInfo(meshIndex);
        uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) +
            pc.Push.CurrentFrameIndex;
        uint objectWordOffset = candidate.InstanceId *
            uint(SIZEOF_GPU_OBJECT_DATA / 4);
        vec4 worldCenter = TransformRowMajorPoint(
            meshInfo.BoundingSphere.xyz,
            instanceBufferIndex,
            objectWordOffset);
        float worldScale = ReadInstanceMaxScale(
            instanceBufferIndex,
            objectWordOffset);
        float worldRadius = meshInfo.BoundingSphere.w * worldScale;
        bool objectVisible =
            (pc.Push.Flags &
                SCENE_OPAQUE_COMPACTION_FLAG_FRUSTUM_TEST) == 0u ||
            SphereIntersectsFrustumPlanes(
                worldCenter.xyz,
                worldRadius,
                frustumPlanes);

        uint requestedLod = 0u;
        if ((pc.Push.Flags &
             SCENE_OPAQUE_COMPACTION_FLAG_GPU_LOD_SELECTION) != 0u &&
            (meshInfo.MeshletLod1Count != 0u ||
             meshInfo.MeshletLod2Count != 0u))
        {
            requestedLod = SelectLodLevel(
                meshInfo,
                candidate.InstanceId,
                pc.Push.CameraPosition.xyz,
                worldCenter.xyz,
                worldRadius,
                worldScale);
        }

        uint firstMeshlet = 0u;
        uint meshletCount = 0u;
        uint effectiveLod = 0u;
        SelectMeshletRange(
            meshInfo,
            requestedLod,
            firstMeshlet,
            meshletCount,
            effectiveLod);
        uint sourceLod = effectiveLod;
        uint ditherThreshold = 15u;
        bool transitionActive = false;
        ResolveLodTransition(
            candidate.InstanceId,
            effectiveLod,
            sourceLod,
            ditherThreshold,
            transitionActive);
        uint sourceFirstMeshlet = firstMeshlet;
        uint sourceMeshletCount = 0u;
        uint sourceEffectiveLod = sourceLod;
        if (transitionActive)
        {
            SelectMeshletRange(
                meshInfo,
                sourceLod,
                sourceFirstMeshlet,
                sourceMeshletCount,
                sourceEffectiveLod);
            if (sourceEffectiveLod == effectiveLod)
            {
                transitionActive = false;
                sourceMeshletCount = 0u;
            }
        }

        uint shadowFirstMeshlet = firstMeshlet;
        uint shadowMeshletCount = 0u;
        uint shadowEffectiveLod = effectiveLod;
        uint shadowSourceFirstMeshlet = sourceFirstMeshlet;
        uint shadowSourceMeshletCount = 0u;
        uint shadowSourceEffectiveLod = sourceEffectiveLod;
        bool shadowTransitionActive = false;
        bool castsDirectionalShadow =
            (candidate.Classification &
             SCENE_INSTANCE_CLASSIFICATION_CASTS_DIRECTIONAL_SHADOW) != 0u &&
            (pc.Push.Flags &
             SCENE_OPAQUE_COMPACTION_FLAG_DIRECTIONAL_SHADOW_COMPACTION) != 0u;
        if (castsDirectionalShadow)
        {
            uint shadowLodBias =
                (pc.Push.Flags &
                 SCENE_OPAQUE_COMPACTION_FLAG_GPU_LOD_SELECTION) != 0u
                ? pc.Push.GpuShadowLodBias
                : 0u;
            uint requestedShadowLod = min(
                effectiveLod + shadowLodBias,
                2u);
            SelectMeshletRange(
                meshInfo,
                requestedShadowLod,
                shadowFirstMeshlet,
                shadowMeshletCount,
                shadowEffectiveLod);
            if (shadowEffectiveLod != requestedShadowLod)
            {
                atomicAdd(
                    BindlessStorageBuffers[
                        nonuniformEXT(CounterBufferIndex())].Words[
                        SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_LOD_FALLBACK],
                    1u);
            }

            if (transitionActive)
            {
                uint requestedShadowSourceLod = min(
                    sourceEffectiveLod + shadowLodBias,
                    2u);
                SelectMeshletRange(
                    meshInfo,
                    requestedShadowSourceLod,
                    shadowSourceFirstMeshlet,
                    shadowSourceMeshletCount,
                    shadowSourceEffectiveLod);
                shadowTransitionActive =
                    shadowSourceEffectiveLod != shadowEffectiveLod;
                if (!shadowTransitionActive)
                    shadowSourceMeshletCount = 0u;
            }
        }

        bool hierarchyActive =
            (pc.Push.Flags &
             SCENE_OPAQUE_COMPACTION_FLAG_HIERARCHICAL_LOD) != 0u &&
            meshInfo.HierarchyNodeCount != 0u &&
            meshInfo.HierarchyRootNode != 0xffffffffu;
        float hierarchySourceFactor = 0.0;
        float hierarchyTargetFactor = 0.0;
        bool hierarchyTransitionActive = false;
        uint hierarchyDitherThreshold = 15u;
        if (hierarchyActive)
        {
            atomicAdd(
                BindlessStorageBuffers[
                    nonuniformEXT(CounterBufferIndex())].Words[
                    SCENE_SUBMISSION_COUNTER_HIERARCHICAL_INSTANCE],
                1u);
            float surfaceDistance = max(
                length(pc.Push.CameraPosition.xyz -
                       worldCenter.xyz) - worldRadius,
                1e-4);
            float currentProjectionFactor =
                max(pc.Push.GpuLodProjectionScale, 1.0) *
                max(worldScale, 0.0) / surfaceDistance;
            ResolveHierarchyProjectionTransition(
                candidate.InstanceId,
                currentProjectionFactor,
                hierarchySourceFactor,
                hierarchyTargetFactor,
                hierarchyDitherThreshold,
                hierarchyTransitionActive);

            // Directional shadows retain the flat cooked ranges, but derive
            // source and target LODs from the hierarchy's projection-factor
            // transition. This preserves the same eight-frame fade without
            // requiring a second per-instance history allocation.
            if (castsDirectionalShadow)
            {
                float lod1Error = uintBitsToFloat(
                    meshInfo.MeshletLod1ErrorBits);
                float lod2Error = uintBitsToFloat(
                    meshInfo.MeshletLod2ErrorBits);
                float targetError = max(
                    pc.Push.GpuLodTargetPixelError,
                    0.125);
                uint shadowLodBias = pc.Push.GpuShadowLodBias;
                uint hierarchyTargetLod = min(
                    SelectLodForPixelThreshold(
                        meshInfo,
                        lod1Error * hierarchyTargetFactor,
                        lod2Error * hierarchyTargetFactor,
                        targetError) + shadowLodBias,
                    2u);
                SelectMeshletRange(
                    meshInfo,
                    hierarchyTargetLod,
                    shadowFirstMeshlet,
                    shadowMeshletCount,
                    shadowEffectiveLod);

                uint hierarchySourceLod = min(
                    SelectLodForPixelThreshold(
                        meshInfo,
                        lod1Error * hierarchySourceFactor,
                        lod2Error * hierarchySourceFactor,
                        targetError) + shadowLodBias,
                    2u);
                SelectMeshletRange(
                    meshInfo,
                    hierarchySourceLod,
                    shadowSourceFirstMeshlet,
                    shadowSourceMeshletCount,
                    shadowSourceEffectiveLod);
                shadowTransitionActive =
                    hierarchyTransitionActive &&
                    shadowSourceEffectiveLod !=
                        shadowEffectiveLod;
                if (!shadowTransitionActive)
                    shadowSourceMeshletCount = 0u;
            }
            ditherThreshold = hierarchyDitherThreshold;
        }

        uint counterBufferIndex = CounterBufferIndex();
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(counterBufferIndex)].Words[
                SCENE_SUBMISSION_COUNTER_OPAQUE_CANDIDATE],
            meshInfo.MeshletCount);
        bool masked = (candidate.Classification &
            SCENE_INSTANCE_CLASSIFICATION_MASKED) != 0u;
        bool depthEnabled = masked
            ? pc.Push.MaskedDepthCandidateCount != 0u
            : pc.Push.SolidDepthCandidateCount != 0u;
        if (depthEnabled)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(counterBufferIndex)].Words[
                    masked
                        ? SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_CANDIDATE
                        : SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_CANDIDATE],
                meshInfo.MeshletCount);
        }

        if (!objectVisible)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(counterBufferIndex)].Words[
                    SCENE_SUBMISSION_COUNTER_OPAQUE_FRUSTUM_REJECTED],
                meshInfo.MeshletCount);
        }
        if (effectiveLod != requestedLod)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(counterBufferIndex)].Words[
                    SCENE_SUBMISSION_COUNTER_MISSING_LOD_FALLBACK],
                1u);
        }
        if (!hierarchyActive &&
            meshInfo.MeshletCount > meshletCount)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(counterBufferIndex)].Words[
                    SCENE_SUBMISSION_COUNTER_OPAQUE_LOD_DECIMATED],
                meshInfo.MeshletCount - meshletCount);
        }

        InstanceCandidateInstanceId = candidate.InstanceId;
        InstanceCandidateMaterialIndex = candidate.MaterialIndex;
        InstanceCandidateCommandFlags = candidate.CommandFlags;
        InstanceCandidateClassification = candidate.Classification;
        InstanceCandidateFirstMeshlet = firstMeshlet;
        InstanceCandidateMeshletCount = meshletCount;
        InstanceCandidateEffectiveLod = effectiveLod;
        InstanceCandidateObjectVisible = objectVisible ? 1u : 0u;
        InstanceCandidateSourceFirstMeshlet = sourceFirstMeshlet;
        InstanceCandidateSourceMeshletCount = sourceMeshletCount;
        InstanceCandidateSourceEffectiveLod = sourceEffectiveLod;
        InstanceCandidateDitherThreshold = ditherThreshold;
        InstanceCandidateTransitionActive = transitionActive ? 1u : 0u;
        InstanceCandidateShadowFirstMeshlet = shadowFirstMeshlet;
        InstanceCandidateShadowMeshletCount = shadowMeshletCount;
        InstanceCandidateShadowEffectiveLod = shadowEffectiveLod;
        InstanceCandidateShadowSourceFirstMeshlet =
            shadowSourceFirstMeshlet;
        InstanceCandidateShadowSourceMeshletCount =
            shadowSourceMeshletCount;
        InstanceCandidateShadowSourceEffectiveLod =
            shadowSourceEffectiveLod;
        InstanceCandidateShadowTransitionActive =
            shadowTransitionActive ? 1u : 0u;
        InstanceCandidateMeshIndex = meshIndex;
        InstanceCandidateHierarchyActive =
            hierarchyActive ? 1u : 0u;
        InstanceCandidateHierarchySourceFactorBits =
            floatBitsToUint(hierarchySourceFactor);
        InstanceCandidateHierarchyTargetFactorBits =
            floatBitsToUint(hierarchyTargetFactor);
        InstanceCandidateHierarchyTransitionActive =
            hierarchyTransitionActive ? 1u : 0u;
    }

    barrier();
    bool castsDirectionalShadow =
        (InstanceCandidateClassification &
         SCENE_INSTANCE_CLASSIFICATION_CASTS_DIRECTIONAL_SHADOW) != 0u;
    if (castsDirectionalShadow)
    {
        bool dynamicShadow =
            (InstanceCandidateClassification &
             SCENE_INSTANCE_CLASSIFICATION_DYNAMIC_DIRECTIONAL_SHADOW) != 0u;
        bool shadowTransitionActive =
            InstanceCandidateShadowTransitionActive != 0u;
        if (shadowTransitionActive)
        {
            ProcessExpandedDirectionalShadowRange(
                candidateIndex,
                InstanceCandidateShadowSourceFirstMeshlet,
                InstanceCandidateShadowSourceMeshletCount,
                InstanceCandidateShadowSourceEffectiveLod,
                dynamicShadow,
                true,
                false,
                InstanceCandidateDitherThreshold);
        }
        ProcessExpandedDirectionalShadowRange(
            candidateIndex,
            InstanceCandidateShadowFirstMeshlet,
            InstanceCandidateShadowMeshletCount,
            InstanceCandidateShadowEffectiveLod,
            dynamicShadow,
            shadowTransitionActive,
            true,
            InstanceCandidateDitherThreshold);
    }

    if (InstanceCandidateObjectVisible == 0u)
        return;

    uint bucket = min(
        InstanceCandidateClassification &
            SCENE_INSTANCE_CLASSIFICATION_BUCKET_MASK,
        SCENE_OPAQUE_BUCKET_FULL);
    bool masked = (InstanceCandidateClassification &
        SCENE_INSTANCE_CLASSIFICATION_MASKED) != 0u;
    if (InstanceCandidateHierarchyActive != 0u)
    {
        GPUMeshInfo hierarchyMeshInfo = ReadMeshInfo(
            InstanceCandidateMeshIndex);
        bool hierarchyTransition =
            InstanceCandidateHierarchyTransitionActive != 0u;
        if (hierarchyTransition)
        {
            ProcessHierarchicalInstance(
                hierarchyMeshInfo,
                uintBitsToFloat(
                    InstanceCandidateHierarchySourceFactorBits),
                true,
                false,
                InstanceCandidateDitherThreshold,
                bucket,
                masked,
                frustumPlanes);
        }
        ProcessHierarchicalInstance(
            hierarchyMeshInfo,
            uintBitsToFloat(
                InstanceCandidateHierarchyTargetFactorBits),
            hierarchyTransition,
            true,
            InstanceCandidateDitherThreshold,
            bucket,
            masked,
            frustumPlanes);
        return;
    }
    bool transitionActive = InstanceCandidateTransitionActive != 0u;
    if (transitionActive)
    {
        ProcessExpandedMeshletRange(
            InstanceCandidateSourceFirstMeshlet,
            InstanceCandidateSourceMeshletCount,
            InstanceCandidateSourceEffectiveLod,
            bucket,
            masked,
            true,
            false,
            InstanceCandidateDitherThreshold,
            frustumPlanes);
    }
    ProcessExpandedMeshletRange(
        InstanceCandidateFirstMeshlet,
        InstanceCandidateMeshletCount,
        InstanceCandidateEffectiveLod,
        bucket,
        masked,
        transitionActive,
        true,
        InstanceCandidateDitherThreshold,
        frustumPlanes);
}

void ProcessOpaqueCandidate(uint candidateIndex, vec4 frustumPlanes[6])
{
    uint candidateCount = pc.Push.SimpleCandidateCount +
        pc.Push.SimpleNormalCandidateCount +
        pc.Push.FullCandidateCount;
    if (candidateIndex >= candidateCount)
        return;

    atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_CANDIDATE], 1u);

    uint localDrawIndex = 0u;
    uint bucket = SCENE_OPAQUE_BUCKET_FULL;
    uint candidateBufferBaseIndex = CandidateBufferBaseIndex(candidateIndex, localDrawIndex, bucket);
    GPUMeshletDrawCommand command = ReadMeshletDrawCommandFromBase(
        candidateBufferBaseIndex,
        pc.Push.CurrentFrameIndex,
        localDrawIndex);

    uint effectiveLod = 0u;
    if (!ApplyGpuLodSelection(command, effectiveLod, 0u))
        return;

    GPUMeshlet meshlet;
    if (!ReadCompactionMeshlet(command, meshlet))
        return;
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) +
        pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId *
        uint(SIZEOF_GPU_OBJECT_DATA / 4);
    vec4 worldCenterRadius = ResolveMeshletWorldCenterRadius(command, meshlet);
    if ((pc.Push.Flags & SCENE_OPAQUE_COMPACTION_FLAG_FRUSTUM_TEST) != 0u &&
        !SphereIntersectsFrustumPlanes(
            worldCenterRadius.xyz,
            worldCenterRadius.w,
            frustumPlanes))
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_FRUSTUM_REJECTED], 1u);
        return;
    }

    if (IsNormalConeCullEligible(command))
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
            SCENE_SUBMISSION_COUNTER_NORMAL_CONE_CANDIDATE], 1u);
        if (!MeshletNormalConeValid(meshlet))
        {
            atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                SCENE_SUBMISSION_COUNTER_NORMAL_CONE_INVALID], 1u);
        }
        else
        {
            atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                SCENE_SUBMISSION_COUNTER_NORMAL_CONE_TESTED], 1u);
            if (MeshletBackfaceConeCulled(
                    meshlet,
                    instanceBufferIndex,
                    objectWordOffset,
                    worldCenterRadius.xyz,
                    worldCenterRadius.w,
                    pc.Push.CameraPosition.xyz))
            {
                atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                    SCENE_SUBMISSION_COUNTER_NORMAL_CONE_REJECTED], 1u);
                return;
            }
        }
    }

    bool canHiZTest = CanHiZTestMeshletDrawCommand(command);
    if (canHiZTest &&
        pc.Push.OcclusionCullingEnabled != HIZ_TEST_MODE_OFF &&
        pc.Push.HiZMipCount != 0u &&
        pc.Push.PreviousHiZFrameValid != 0u &&
        ReadMeshletTaskPreviousHiZFrameValid(pc.Push.CurrentFrameIndex) != 0u)
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_HIZ_TESTED], 1u);
        if (MeshletOccludedByHiZ(worldCenterRadius.xyz, worldCenterRadius.w))
        {
            atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_HIZ_REJECTED], 1u);
            return;
        }
    }

    uint aggregateOutputIndex = atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_APPEND], 1u);
    if (aggregateOutputIndex >= pc.Push.OutputCapacity)
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_OVERFLOW], 1u);
        return;
    }

    bool doubleSided = IsDoubleSided(command);
    uint bucketCapacity = OpaqueBucketOutputCapacity(bucket);
    uint bucketOutputIndex = atomicAdd(
        BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
            OpaqueBucketAppendCounterWord(bucket, doubleSided)],
        1u);
    if (bucketOutputIndex >= bucketCapacity)
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_OVERFLOW], 1u);
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[OpaqueBucketOverflowCounterWord(bucket)], 1u);
        return;
    }

    WriteMeshletDrawCommand(aggregateOutputIndex, command);
    WriteOpaqueBucketMeshletDrawCommand(
        bucket,
        bucketOutputIndex + (doubleSided ? bucketCapacity : 0u),
        command);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_OPAQUE_EMITTED], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[OpaqueBucketEmittedCounterWord(bucket)], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(IndirectDispatchBufferIndex())].Words[
        IndirectDispatchCountWord(SCENE_INDIRECT_DISPATCH_OPAQUE_SLOT)], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(IndirectDispatchBufferIndex())].Words[
        IndirectDispatchCountWord(
            OpaqueBucketIndirectDispatchSlot(bucket, doubleSided))], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[SCENE_SUBMISSION_COUNTER_LOD0_EMITTED + min(effectiveLod, 2u)], 1u);
}

void ProcessDepthCandidate(
    uint candidateIndex,
    uint candidateCount,
    uint inputBufferBaseIndex,
    uint outputBufferIndex,
    uint outputCapacity,
    uint candidateCounterWord,
    uint appendCounterWord,
    uint doubleSidedAppendCounterWord,
    uint emittedCounterWord,
    uint overflowCounterWord,
    uint indirectDispatchSlot,
    uint doubleSidedIndirectDispatchSlot,
    vec4 frustumPlanes[6])
{
    if (candidateIndex >= candidateCount)
        return;

    atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[candidateCounterWord], 1u);

    GPUMeshletDrawCommand command = ReadMeshletDrawCommandFromBase(
        inputBufferBaseIndex,
        pc.Push.CurrentFrameIndex,
        candidateIndex);

    uint effectiveLod = 0u;
    if (!ApplyGpuLodSelection(command, effectiveLod, 0u))
        return;

    GPUMeshlet meshlet;
    if (!ReadCompactionMeshlet(command, meshlet))
        return;
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) +
        pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId *
        uint(SIZEOF_GPU_OBJECT_DATA / 4);
    vec4 worldCenterRadius = ResolveMeshletWorldCenterRadius(command, meshlet);
    if ((pc.Push.Flags & SCENE_OPAQUE_COMPACTION_FLAG_FRUSTUM_TEST) != 0u &&
        !SphereIntersectsFrustumPlanes(
            worldCenterRadius.xyz,
            worldCenterRadius.w,
            frustumPlanes))
        return;

    if (IsNormalConeCullEligible(command) &&
        MeshletBackfaceConeCulled(
            meshlet,
            instanceBufferIndex,
            objectWordOffset,
            worldCenterRadius.xyz,
            worldCenterRadius.w,
            pc.Push.CameraPosition.xyz))
        return;

    bool doubleSided = IsDoubleSided(command);
    uint selectedAppendCounterWord = doubleSided
        ? doubleSidedAppendCounterWord
        : appendCounterWord;
    uint outputIndex = atomicAdd(
        BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
            selectedAppendCounterWord],
        1u);
    if (outputIndex >= outputCapacity)
    {
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[overflowCounterWord], 1u);
        return;
    }

    WriteMeshletDrawCommandToBase(
        outputBufferIndex,
        outputIndex + (doubleSided ? outputCapacity : 0u),
        command);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[emittedCounterWord], 1u);
    atomicAdd(BindlessStorageBuffers[nonuniformEXT(IndirectDispatchBufferIndex())].Words[
        IndirectDispatchCountWord(doubleSided
            ? doubleSidedIndirectDispatchSlot
            : indirectDispatchSlot)], 1u);
}

void ProcessDirectionalShadowCandidate(
    uint candidateIndex,
    uint candidateCount,
    uint inputBufferBaseIndex,
    uint outputCapacity,
    uint counterBaseWord,
    bool dynamicShadow)
{
    if ((pc.Push.Flags & SCENE_OPAQUE_COMPACTION_FLAG_DIRECTIONAL_SHADOW_COMPACTION) == 0u ||
        candidateIndex >= candidateCount)
        return;

    GPUMeshletDrawCommand command = ReadMeshletDrawCommandFromBase(
        inputBufferBaseIndex,
        pc.Push.CurrentFrameIndex,
        candidateIndex);

    uint effectiveLod = 0u;
    if (!ApplyConservativeDirectionalShadowLodSelection(command, effectiveLod, pc.Push.GpuShadowLodBias))
        return;

    GPUMeshlet meshlet;
    if (!ReadCompactionMeshlet(command, meshlet))
        return;
    vec4 worldSphere = ResolveMeshletWorldCenterRadius(command, meshlet);
    uint cascadeCount = min(pc.Push.DirectionalShadowCascadeCount, SCENE_DIRECTIONAL_SHADOW_CASCADE_COUNT);
    for (uint cascade = 0u; cascade < cascadeCount; cascade++)
    {
        if (!dynamicShadow &&
            (pc.Push.DirectionalStaticShadowCascadeMask & (1u << cascade)) == 0u)
            continue;

        uint cascadeCounterBase = counterBaseWord + cascade * SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_STRIDE;
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                cascadeCounterBase + SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_CANDIDATE_OFFSET],
            1u);

        mat4 shadowMatrix = ReadShadowMatrix(cascade);
        bool visible = SphereIntersectsRowMajorFrustum(
            worldSphere.xyz,
            worldSphere.w,
            shadowMatrix);
#if NJULF_GPU_DIAGNOSTIC_COUNTERS
        RecordDirectionalShadowCasterAttribution(
            pc.Push.CurrentFrameIndex,
            command.InstanceId,
            command.InstanceId,
            command.MeshletIndex,
            effectiveLod,
            dynamicShadow
                ? DIRECTIONAL_SHADOW_CASTER_CLASS_DYNAMIC
                : DIRECTIONAL_SHADOW_CASTER_CLASS_STATIC,
            cascade,
            candidateIndex,
            DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_INPUT |
                DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_COMPACTION |
                DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_CONSERVATIVE_LOD |
                (dynamicShadow
                    ? DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_DYNAMIC
                    : DIRECTIONAL_SHADOW_CASTER_ELIGIBILITY_STATIC),
            worldSphere,
            shadowMatrix,
            visible);
#endif
        if (!visible)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                    cascadeCounterBase + SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_REJECTED_OFFSET],
                1u);
            continue;
        }

        bool doubleSided = IsDoubleSided(command);
        uint appendCounterWord = doubleSided
            ? (dynamicShadow
                ? SCENE_SUBMISSION_COUNTER_DIRECTIONAL_DYNAMIC_SHADOW_DOUBLE_SIDED_BASE
                : SCENE_SUBMISSION_COUNTER_DIRECTIONAL_STATIC_SHADOW_DOUBLE_SIDED_BASE) + cascade
            : cascadeCounterBase +
                SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_APPEND_OFFSET;
        uint outputIndex = atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                appendCounterWord],
            1u);
        if (outputIndex >= outputCapacity)
        {
            atomicAdd(
                BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                    cascadeCounterBase + SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_OVERFLOW_OFFSET],
                1u);
            continue;
        }

        uint outputBufferIndex = dynamicShadow
            ? DirectionalDynamicShadowOutputBufferIndex(cascade)
            : DirectionalStaticShadowOutputBufferIndex(cascade);
        WriteMeshletDrawCommandToBase(
            outputBufferIndex,
            outputIndex + (doubleSided ? outputCapacity : 0u),
            command);
        atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(CounterBufferIndex())].Words[
                cascadeCounterBase + SCENE_SUBMISSION_COUNTER_DIRECTIONAL_SHADOW_EMITTED_OFFSET],
            1u);
        uint indirectDispatchSlot = doubleSided
            ? (dynamicShadow
                ? SCENE_INDIRECT_DISPATCH_DIRECTIONAL_DYNAMIC_SHADOW_DOUBLE_SIDED_SLOT_BASE
                : SCENE_INDIRECT_DISPATCH_DIRECTIONAL_STATIC_SHADOW_DOUBLE_SIDED_SLOT_BASE) + cascade
            : (dynamicShadow
                ? SCENE_INDIRECT_DISPATCH_DIRECTIONAL_DYNAMIC_SHADOW_SLOT_BASE
                : SCENE_INDIRECT_DISPATCH_DIRECTIONAL_STATIC_SHADOW_SLOT_BASE) + cascade;
        atomicAdd(BindlessStorageBuffers[nonuniformEXT(IndirectDispatchBufferIndex())].Words[
            IndirectDispatchCountWord(indirectDispatchSlot)], 1u);
    }
}

void main()
{
    uint candidateIndex = gl_GlobalInvocationID.x;
    vec4 frustumPlanes[6];
    ReadMeshletTaskFrustumPlanes(pc.Push.CurrentFrameIndex, frustumPlanes);

    if ((pc.Push.Flags &
         SCENE_OPAQUE_COMPACTION_FLAG_INSTANCE_EXPANSION) != 0u)
    {
        ProcessInstanceCandidate(gl_WorkGroupID.x, frustumPlanes);
    }
    else
    {
        ProcessOpaqueCandidate(candidateIndex, frustumPlanes);
        ProcessDepthCandidate(
            candidateIndex,
            pc.Push.SolidDepthCandidateCount,
            uint(SOLID_DEPTH_MESHLET_DRAW_BUFFER_BASE_INDEX),
            SolidDepthOutputBufferIndex(),
            pc.Push.SolidDepthOutputCapacity,
            SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_CANDIDATE,
            SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_APPEND,
            SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_DOUBLE_SIDED_APPEND,
            SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_EMITTED,
            SCENE_SUBMISSION_COUNTER_SOLID_DEPTH_OVERFLOW,
            SCENE_INDIRECT_DISPATCH_SOLID_DEPTH_SLOT,
            SCENE_INDIRECT_DISPATCH_SOLID_DEPTH_DOUBLE_SIDED_SLOT,
            frustumPlanes);
        ProcessDepthCandidate(
            candidateIndex,
            pc.Push.MaskedDepthCandidateCount,
            uint(MASKED_DEPTH_MESHLET_DRAW_BUFFER_BASE_INDEX),
            MaskedDepthOutputBufferIndex(),
            pc.Push.MaskedDepthOutputCapacity,
            SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_CANDIDATE,
            SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_APPEND,
            SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_DOUBLE_SIDED_APPEND,
            SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_EMITTED,
            SCENE_SUBMISSION_COUNTER_MASKED_DEPTH_OVERFLOW,
            SCENE_INDIRECT_DISPATCH_MASKED_DEPTH_SLOT,
            SCENE_INDIRECT_DISPATCH_MASKED_DEPTH_DOUBLE_SIDED_SLOT,
            frustumPlanes);
    }
    if ((pc.Push.Flags &
         SCENE_OPAQUE_COMPACTION_FLAG_INSTANCE_EXPANSION) == 0u)
    {
        ProcessDirectionalShadowCandidate(
            candidateIndex,
            pc.Push.DirectionalStaticShadowCandidateCount,
            uint(DIRECTIONAL_STATIC_SHADOW_MESHLET_DRAW_BUFFER_BASE_INDEX),
            pc.Push.DirectionalStaticShadowOutputCapacity,
            SCENE_SUBMISSION_COUNTER_DIRECTIONAL_STATIC_SHADOW_BASE,
            false);
        ProcessDirectionalShadowCandidate(
            candidateIndex,
            pc.Push.DirectionalDynamicShadowCandidateCount,
            uint(DIRECTIONAL_DYNAMIC_SHADOW_MESHLET_DRAW_BUFFER_BASE_INDEX),
            pc.Push.DirectionalDynamicShadowOutputCapacity,
            SCENE_SUBMISSION_COUNTER_DIRECTIONAL_DYNAMIC_SHADOW_BASE,
            true);
    }
}
