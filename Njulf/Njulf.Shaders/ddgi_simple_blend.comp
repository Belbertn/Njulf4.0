#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint SIMPLE_DDGI_BLEND_FLAG_SHARED_RAY_CACHE = 1u << 3;
const uint SIMPLE_DDGI_BLEND_FLAG_REDUCED_COMPLEXITY = 1u << 5;
const float SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_MEAN_SPACING = 1.0;
const float SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_STDDEV_SPACING = 0.5;
// A broad lobe keeps each hit/miss distance field smooth at production ray
// counts. A narrower cos^32 vote chooses which field owns a direction at a
// silhouette, so long misses cannot inflate covered-wall moments. Applying a
// cos^64 lobe to the moments themselves leaves roughly two effective rays per
// texel at 128 rays/probe and stamps their cells into planar surfaces.
const float SIMPLE_DDGI_VISIBILITY_BROAD_MOMENT_EXPONENT = 16.0;
const float SIMPLE_DDGI_VISIBILITY_HIT_CLASS_THRESHOLD = 0.35;
// Small absolute fixed-point tolerance used only close to black. Unlike the
// legacy 0.02 subtraction, it does not erase visible low-energy bounce.
const float SIMPLE_DDGI_TRANSPORT_ABSOLUTE_RESIDUAL_TOLERANCE = 0.0001;
const float SIMPLE_DDGI_TRANSPORT_RESIDUAL_ENVELOPE_DECAY = 0.25;

shared vec4 SharedSimpleRayRadianceDistance[256];
shared vec4 SharedSimpleRayDirectionHit[256];
shared uint SharedSimpleRayVisibilityHit[256];
shared float SharedSimpleIrradianceDelta[64];
// The reduced path projects only low-frequency irradiance. Visibility remains
// the exact directional ray-by-texel estimator because sparse octahedral splats
// create zero-moment holes and probe-aligned shadow bands.
shared vec3 SharedSimpleShCoefficients[9];

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint TransportGeneration;
    uint Padding0;
} pc;

// Atlas diagnostics can execute once per texel.  Preserve them for explicit
// investigations, but eliminate the atomic traffic from normal production work.
#define AddRendererDiagnostic(frameIndex, counterIndex, value) AddSimpleDdgiDiagnostic(params, frameIndex, counterIndex, value)

vec4 ReadSimpleRayRadianceDistance(uint rayResultIndex)
{
    return ReadStorageVec4(pc.RayResultScratchBufferIndex, rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 0u);
}

vec4 ReadSimpleRayDirectionHit(uint rayResultIndex)
{
    return ReadStorageVec4(pc.RayResultScratchBufferIndex, rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 4u);
}

vec2 ReadSimpleRayVisibilityHit(uint rayResultIndex)
{
    return UnpackSimpleDdgiRayVisibilityHit(
        ReadStorageWord(
            pc.RayResultScratchBufferIndex,
            rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 7u));
}

float SimpleDdgiLuminance(vec3 value)
{
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

float SimpleDdgiStableRelativeDelta(float current, float previous, float absoluteNoiseFloor)
{
    float absoluteDelta = abs(current - previous);
    // Do not interpret the Monte-Carlo noise floor as lighting motion.  A purely
    // relative metric is ill-conditioned around black and was forcing dark texels
    // to accept almost every fresh estimate.
    float meaningfulDelta = max(absoluteDelta - absoluteNoiseFloor, 0.0);
    return meaningfulDelta / max(max(abs(current), abs(previous)), absoluteNoiseFloor);
}

float SimpleDdgiTransportConvergenceResidual(
    SimpleDdgiParams params,
    vec3 current,
    vec3 previous)
{
    // This is a fixed-point defect, evaluated before Jacobi relaxation. The
    // mixed scale accepts a tiny absolute error near black or the authored
    // relative error at normal signal levels without subtracting either one
    // from real low-energy bounce.
    float relativeThreshold = max(params.transportResidualThreshold, 0.001);
    float absoluteScale =
        SIMPLE_DDGI_TRANSPORT_ABSOLUTE_RESIDUAL_TOLERANCE / relativeThreshold;
    vec3 difference = abs(current - previous);
    vec3 magnitude = max(abs(current), abs(previous));
    vec3 residual = difference / max(magnitude, vec3(absoluteScale));
    if (any(isnan(residual)) || any(isinf(residual)))
        return 1.0;
    return clamp(max(residual.x, max(residual.y, residual.z)), 0.0, 1.0);
}

float SimpleDdgiAdaptiveIrradianceHysteresis(SimpleDdgiParams params, vec4 previous, vec3 irradiance, float probeHysteresis, bool maintenanceUpdate)
{
    if ((params.flags & (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE)) !=
            (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE) ||
        probeHysteresis <= 0.0001 || previous.w <= 0.0001)
        return probeHysteresis;

    // Maintenance estimates have materially higher variance.  Keep their fixed
    // temporal filter instead of making the scheduler react to its own noise.
    if (maintenanceUpdate)
        return probeHysteresis;

    float previousLuma = SimpleDdgiLuminance(previous.rgb);
    float currentLuma = SimpleDdgiLuminance(irradiance);
    float relativeDelta = SimpleDdgiStableRelativeDelta(currentLuma, previousLuma, 0.02);
    float changeT = smoothstep(params.hysteresisChangeThreshold, params.hysteresisStepThreshold, relativeDelta);
    float softHysteresis = probeHysteresis * 0.5;
    float stepHysteresis = min(probeHysteresis, 0.60);
    return mix(probeHysteresis, mix(softHysteresis, stepHysteresis, changeT), smoothstep(params.hysteresisChangeThreshold * 0.75, params.hysteresisChangeThreshold, relativeDelta));
}

float SimpleDdgiAdaptiveVisibilityHysteresis(SimpleDdgiParams params, vec4 previous, vec2 moments, float probeHysteresis, bool maintenanceUpdate, float spacing)
{
    if ((params.flags & (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE)) !=
            (SIMPLE_DDGI_FLAG_ADAPTIVE_HYSTERESIS | SIMPLE_DDGI_FLAG_LIGHTING_CHANGE_ACTIVE) ||
        probeHysteresis <= 0.0001 || previous.z <= 0.5)
        return probeHysteresis;
    if (maintenanceUpdate)
        return probeHysteresis;

    float relativeDelta = SimpleDdgiStableRelativeDelta(moments.x, previous.x, max(spacing * 0.02, 0.01));
    float changeT = smoothstep(params.hysteresisChangeThreshold, params.hysteresisStepThreshold, relativeDelta);
    float softHysteresis = probeHysteresis * 0.75;
    float stepHysteresis = max(min(probeHysteresis, 0.55), 0.0);
    return mix(probeHysteresis, mix(softHysteresis, stepHysteresis, changeT), smoothstep(params.hysteresisChangeThreshold * 0.75, params.hysteresisChangeThreshold, relativeDelta));
}

float SimpleDdgiCadenceAdjustedHysteresis(SimpleDdgiParams params, SimpleDdgiProbeUpdate update)
{
    if ((update.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u)
        return 0.0;

    // V2 is an explicit Jacobi solve. Its old/new interpolation is the solver
    // relaxation, not a frame-cadence-dependent history filter; the latter was
    // the main reason recursive energy took hundreds of sparse updates to move.
    if ((params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u)
        return 1.0 - params.transportSolverRelaxation;

    float baseHysteresis = clamp(params.hysteresis, 0.0, 1.0);
    // The near-ring full-update cadence (roughly eight frames at production
    // budgets) is the reference response. Sparse updates retain comparable
    // wall-clock convergence instead of applying one 0.97 retention step every
    // 70-110 frames. Maintenance estimates use fewer rays, so give them a
    // deliberately slower sixteen-frame reference rather than disabling cadence
    // compensation entirely; the latter trapped recursive bounce near its first
    // dark estimate for thousands of frames.
    float elapsedFrames = float(SimpleDdgiUpdateAge(update));
    float referenceCadence = SimpleDdgiUpdateIsMaintenance(update) ? 16.0 : 8.0;
    float cadenceExponent = clamp(elapsedFrames / referenceCadence, 1.0, 8.0);
    return pow(baseHysteresis, cadenceExponent);
}

uint SimpleDdgiIrradianceReadBuffer(SimpleDdgiParams params)
{
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? pc.TransportReadIrradianceAtlasBufferIndex
        : pc.IrradianceAtlasBufferIndex;
}

uint SimpleDdgiIrradianceWriteBuffer(SimpleDdgiParams params)
{
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? pc.TransportWriteIrradianceAtlasBufferIndex
        : pc.IrradianceAtlasBufferIndex;
}

void LoadSimpleRayCache(SimpleDdgiParams params, uint localProbeOffset, uint activeRayCount)
{
    uint local = gl_LocalInvocationID.x;
    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = local; ray < rayCount; ray += gl_WorkGroupSize.x)
    {
        uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
        SharedSimpleRayDirectionHit[ray] = ReadSimpleRayDirectionHit(rayResultIndex);
        SharedSimpleRayVisibilityHit[ray] = ReadStorageWord(
            pc.RayResultScratchBufferIndex,
            rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 7u);
        SharedSimpleRayRadianceDistance[ray] = ReadSimpleRayRadianceDistance(rayResultIndex);
    }

    barrier();
}

vec4 ReadCachedSimpleRayRadianceDistance(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    if (sharedRayCacheEnabled)
        return SharedSimpleRayRadianceDistance[ray];

    uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
    return ReadSimpleRayRadianceDistance(rayResultIndex);
}

vec4 ReadCachedSimpleRayDirectionHit(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    if (sharedRayCacheEnabled)
        return SharedSimpleRayDirectionHit[ray];

    uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
    return ReadSimpleRayDirectionHit(rayResultIndex);
}

vec2 ReadCachedSimpleRayVisibilityHit(SimpleDdgiParams params, uint localProbeOffset, uint ray, bool sharedRayCacheEnabled)
{
    if (sharedRayCacheEnabled)
        return UnpackSimpleDdgiRayVisibilityHit(
            SharedSimpleRayVisibilityHit[ray]);

    uint rayResultIndex = localProbeOffset * params.raysPerProbe + ray;
    return ReadSimpleRayVisibilityHit(rayResultIndex);
}

vec3 ClampSimpleRadiance(vec3 v)
{
    if (any(isnan(v)) || any(isinf(v)))
        return vec3(0.0);
    float luma = dot(max(v, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
    float clampScale = luma > 64.0 ? 64.0 / luma : 1.0;
    return clamp(v * clampScale, vec3(0.0), vec3(65504.0));
}

float BlendIrradianceTexel(SimpleDdgiParams params, uint volumeIndex, uint probeIndex, uint localProbeOffset, uint texel, float probeHysteresis, bool sharedRayCacheEnabled, uint activeRayCount, bool maintenanceUpdate, bool freshUpdate)
{
    uint x = texel % params.irradianceTexels;
    uint y = texel / params.irradianceTexels;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(params.irradianceTexels);
    vec3 texelDirection = SimpleDdgiOctDecode(uv);
    vec3 accumulated = vec3(0.0);
    float weightSum = 0.0;

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, sharedRayCacheEnabled);
        vec4 radianceDistance = ReadCachedSimpleRayRadianceDistance(params, localProbeOffset, ray, sharedRayCacheEnabled);
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            sharedRayCacheEnabled);
        if (SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y))
            continue;
        float weight = max(dot(texelDirection, normalize(directionHit.xyz)), 0.0);
        accumulated += ClampSimpleRadiance(radianceDistance.rgb) * weight;
        weightSum += weight;
    }

    uint irradianceReadBuffer = SimpleDdgiIrradianceReadBuffer(params);
    uint irradianceWriteBuffer = SimpleDdgiIrradianceWriteBuffer(params);
    vec4 previous = ReadSimpleDdgiAtlasTexel(irradianceReadBuffer, probeIndex, texel, params.irradianceTexels);
    if (weightSum <= 0.000001)
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_ZERO_RAY_WEIGHT_PROBE_COUNTER, 1u);
        if (previous.w > 0.0001 && !freshUpdate)
        {
            // A V2 target is private and may not contain the canonical texel yet.
            // Preserve the published value explicitly instead of leaving a hole
            // that would be copied into the next receiver-visible generation.
            WriteSimpleDdgiAtlasTexel(irradianceWriteBuffer, probeIndex, texel, params.irradianceTexels, previous);
            return 0.0;
        }
        if (freshUpdate)
        {
            WriteSimpleDdgiAtlasTexel(irradianceWriteBuffer, probeIndex, texel, params.irradianceTexels, vec4(0.0));
            return 1.0;
        }
    }

    vec3 irradiance = weightSum > 0.000001
        ? accumulated * (SIMPLE_DDGI_PI / weightSum)
        : vec3(0.0);
    RecordSimpleDdgiBlendEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        volumeIndex,
        probeIndex,
        texel,
        irradiance,
        weightSum > 0.000001 ? 1.0 : 0.0);
    float texelHysteresis = SimpleDdgiAdaptiveIrradianceHysteresis(params, previous, irradiance, probeHysteresis, maintenanceUpdate);
    vec4 blended = mix(vec4(irradiance, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    if (SimpleDdgiLuminance(irradiance) > 0.00001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_NONZERO_IRRADIANCE_PROBE_COUNTER, 1u);
    if (probeHysteresis > 0.0001 && previous.w > 0.0001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_PREVIOUS_ATLAS_USED_COUNTER, 1u);
    WriteSimpleDdgiAtlasTexel(irradianceWriteBuffer, probeIndex, texel, params.irradianceTexels, blended);
    if (previous.w <= 0.0001)
        return 1.0;
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? SimpleDdgiTransportConvergenceResidual(params, irradiance, previous.rgb)
        : SimpleDdgiStableRelativeDelta(
            SimpleDdgiLuminance(irradiance),
            SimpleDdgiLuminance(previous.rgb),
            0.02);
}

void BlendVisibilityTexel(SimpleDdgiParams params, SimpleDdgiVolume volume, uint probeIndex, uint localProbeOffset, uint texel, float probeHysteresis, bool sharedRayCacheEnabled, uint activeRayCount, bool maintenanceUpdate, bool freshUpdate)
{
    uint x = texel % params.visibilityTexels;
    uint y = texel / params.visibilityTexels;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(params.visibilityTexels);
    vec3 texelDirection = SimpleDdgiOctDecode(uv);
    float broadHitMean = 0.0;
    float broadHitMean2 = 0.0;
    float broadHitWeightSum = 0.0;
    float broadMissMean = 0.0;
    float broadMissMean2 = 0.0;
    float broadMissWeightSum = 0.0;
    float narrowHitWeightSum = 0.0;
    float narrowWeightSum = 0.0;

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, sharedRayCacheEnabled);
        float cosine = max(dot(texelDirection, normalize(directionHit.xyz)), 0.0);
        float broadWeight = pow(
            cosine,
            SIMPLE_DDGI_VISIBILITY_BROAD_MOMENT_EXPONENT);
        // cos^32 derived from the broad cos^16 weight avoids a second pow().
        float narrowWeight = broadWeight * broadWeight;
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            sharedRayCacheEnabled);
        float d = max(visibilityHit.x, 0.0);
        if (visibilityHit.y >= 0.5)
        {
            broadHitMean += d * broadWeight;
            broadHitMean2 += d * d * broadWeight;
            broadHitWeightSum += broadWeight;
            narrowHitWeightSum += narrowWeight;
        }
        else
        {
            broadMissMean += d * broadWeight;
            broadMissMean2 += d * d * broadWeight;
            broadMissWeightSum += broadWeight;
        }
        narrowWeightSum += narrowWeight;
    }

    vec4 previous = ReadSimpleDdgiAtlasTexel(pc.VisibilityAtlasBufferIndex, probeIndex, texel, params.visibilityTexels);
    vec2 moments;
    if (broadHitWeightSum > 0.000001 || broadMissWeightSum > 0.000001)
    {
        bool hasHitMoments = broadHitWeightSum > 0.000001;
        bool hasMissMoments = broadMissWeightSum > 0.000001;
        vec2 hitMoments = hasHitMoments
            ? vec2(broadHitMean, broadHitMean2) / broadHitWeightSum
            : vec2(0.0);
        vec2 missMoments = hasMissMoments
            ? vec2(broadMissMean, broadMissMean2) / broadMissWeightSum
            : vec2(0.0);
        if (hasHitMoments && hasMissMoments && narrowWeightSum > 0.000001)
        {
            float narrowHitFraction = clamp(
                narrowHitWeightSum / narrowWeightSum,
                0.0,
                1.0);
            moments = narrowHitFraction >= SIMPLE_DDGI_VISIBILITY_HIT_CLASS_THRESHOLD
                ? hitMoments
                : missMoments;
        }
        else
            moments = hasHitMoments ? hitMoments : missMoments;
    }
    else if (previous.z > 0.5 && !freshUpdate)
    {
            return;
    }
    else
    {
        float mean = volume.spacing * SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_MEAN_SPACING;
        float standardDeviation = volume.spacing * SIMPLE_DDGI_BOOTSTRAP_VISIBILITY_STDDEV_SPACING;
        moments = vec2(mean, mean * mean + standardDeviation * standardDeviation);
    }
    float texelHysteresis = SimpleDdgiAdaptiveVisibilityHysteresis(params, previous, moments, probeHysteresis, maintenanceUpdate, volume.spacing);
    vec4 blended = mix(vec4(moments, 1.0, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    WriteSimpleDdgiAtlasTexel(pc.VisibilityAtlasBufferIndex, probeIndex, texel, params.visibilityTexels, blended);
}

void AccumulateSimpleShBasis(vec3 direction, vec3 radiance, float normalization)
{
    float x = direction.x;
    float y = direction.y;
    float z = direction.z;
    float basis[9] = float[](
        0.2820947918,
        -0.4886025119 * y,
        0.4886025119 * z,
        -0.4886025119 * x,
        1.0925484306 * x * y,
        -1.0925484306 * y * z,
        0.3153915653 * (3.0 * z * z - 1.0),
        -1.0925484306 * x * z,
        0.5462742153 * (x * x - y * y));
    for (uint coefficient = 0u; coefficient < 9u; coefficient++)
        SharedSimpleShCoefficients[coefficient] += radiance * (basis[coefficient] * normalization);
}

void BuildReducedSimpleDdgiIrradiance(SimpleDdgiParams params, uint localProbeOffset, uint activeRayCount)
{
    // A single invocation builds the compact SH projection deterministically.
    // Exact visibility is evaluated below from the shared ray cache.
    for (uint coefficient = 0u; coefficient < 9u; coefficient++)
        SharedSimpleShCoefficients[coefficient] = vec3(0.0);

    uint rayCount = min(activeRayCount, SIMPLE_DDGI_MAX_RAYS_PER_PROBE);
    uint validRayCount = 0u;
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            true);
        if (!SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y))
            validRayCount++;
    }
    float shNormalization = (4.0 * SIMPLE_DDGI_PI) / max(float(validRayCount), 1.0);
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        vec2 visibilityHit = ReadCachedSimpleRayVisibilityHit(
            params,
            localProbeOffset,
            ray,
            true);
        if (SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y))
            continue;
        vec4 directionHit = ReadCachedSimpleRayDirectionHit(params, localProbeOffset, ray, true);
        vec4 radianceDistance = ReadCachedSimpleRayRadianceDistance(params, localProbeOffset, ray, true);
        vec3 direction = normalize(directionHit.xyz);
        AccumulateSimpleShBasis(direction, ClampSimpleRadiance(radianceDistance.rgb), shNormalization);
    }
}

vec3 EvaluateReducedSimpleDdgiIrradiance(vec3 direction)
{
    float x = direction.x;
    float y = direction.y;
    float z = direction.z;
    float basis[9] = float[](
        0.2820947918,
        -0.4886025119 * y,
        0.4886025119 * z,
        -0.4886025119 * x,
        1.0925484306 * x * y,
        -1.0925484306 * y * z,
        0.3153915653 * (3.0 * z * z - 1.0),
        -1.0925484306 * x * z,
        0.5462742153 * (x * x - y * y));
    float convolution[3] = float[](SIMPLE_DDGI_PI, 2.0 * SIMPLE_DDGI_PI / 3.0, SIMPLE_DDGI_PI / 4.0);
    vec3 irradiance = vec3(0.0);
    for (uint coefficient = 0u; coefficient < 9u; coefficient++)
    {
        uint band = coefficient == 0u ? 0u : (coefficient < 4u ? 1u : 2u);
        irradiance += SharedSimpleShCoefficients[coefficient] * (basis[coefficient] * convolution[band]);
    }
    return max(irradiance, vec3(0.0));
}

float BlendReducedIrradianceTexel(SimpleDdgiParams params, uint volumeIndex, uint probeIndex, uint texel, float probeHysteresis, bool maintenanceUpdate, bool freshUpdate)
{
    uint x = texel % params.irradianceTexels;
    uint y = texel / params.irradianceTexels;
    vec3 texelDirection = SimpleDdgiOctDecode((vec2(x, y) + vec2(0.5)) / vec2(params.irradianceTexels));
    vec3 irradiance = EvaluateReducedSimpleDdgiIrradiance(texelDirection);
    RecordSimpleDdgiBlendEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        volumeIndex,
        probeIndex,
        texel,
        irradiance,
        1.0);
    uint irradianceReadBuffer = SimpleDdgiIrradianceReadBuffer(params);
    uint irradianceWriteBuffer = SimpleDdgiIrradianceWriteBuffer(params);
    vec4 previous = ReadSimpleDdgiAtlasTexel(irradianceReadBuffer, probeIndex, texel, params.irradianceTexels);
    if (freshUpdate && SimpleDdgiLuminance(irradiance) <= 0.000001)
    {
        WriteSimpleDdgiAtlasTexel(irradianceWriteBuffer, probeIndex, texel, params.irradianceTexels, vec4(0.0));
        return 1.0;
    }
    float texelHysteresis = SimpleDdgiAdaptiveIrradianceHysteresis(params, previous, irradiance, probeHysteresis, maintenanceUpdate);
    vec4 blended = mix(vec4(irradiance, 1.0), previous, texelHysteresis);
    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_TEXEL_COUNTER, 1u);
    if (SimpleDdgiLuminance(irradiance) > 0.00001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_NONZERO_IRRADIANCE_PROBE_COUNTER, 1u);
    if (probeHysteresis > 0.0001 && previous.w > 0.0001)
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_PREVIOUS_ATLAS_USED_COUNTER, 1u);
    WriteSimpleDdgiAtlasTexel(irradianceWriteBuffer, probeIndex, texel, params.irradianceTexels, blended);
    if (previous.w <= 0.0001)
        return 1.0;
    return (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u
        ? SimpleDdgiTransportConvergenceResidual(params, irradiance, previous.rgb)
        : SimpleDdgiStableRelativeDelta(
            SimpleDdgiLuminance(irradiance),
            SimpleDdgiLuminance(previous.rgb),
            0.02);
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint localProbeOffset = gl_WorkGroupID.x;
    if (localProbeOffset >= params.probesToUpdate || params.probeCount == 0u)
        return;

    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, localProbeOffset);
    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
        return;

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
        return;
    SimpleDdgiProbeState initialState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGeneration(update, initialState))
        return;
    uint local = gl_LocalInvocationID.x;
    // Relocation committed a position different from the origin used by this
    // update's rays. Do not publish a spatially mismatched atlas. The pending
    // state also keeps forward gather on its environment/coarser fallback until
    // a full retry traces from the committed position.
    if ((initialState.flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u)
    {
        // The V2 target is intentionally private until the entire update is
        // complete. A relocation retry must therefore copy the current
        // canonical texels into that target before the CPU publishes this
        // probe range; otherwise an old target allocation could overwrite a
        // valid receiver-visible probe with unrelated data.
        if ((params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u)
        {
            uint readBuffer = SimpleDdgiIrradianceReadBuffer(params);
            uint writeBuffer = SimpleDdgiIrradianceWriteBuffer(params);
            uint texelCount = params.irradianceTexels * params.irradianceTexels;
            for (uint texel = local; texel < texelCount; texel += gl_WorkGroupSize.x)
            {
                vec4 canonical = ReadSimpleDdgiAtlasTexel(readBuffer, probeIndex, texel, params.irradianceTexels);
                WriteSimpleDdgiAtlasTexel(writeBuffer, probeIndex, texel, params.irradianceTexels, canonical);
            }
        }
        return;
    }
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    bool maintenanceUpdate = SimpleDdgiUpdateIsMaintenance(update);
    bool freshUpdate = (update.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u ||
        (initialState.flags & SIMPLE_DDGI_PROBE_FLAG_FRESH) != 0u;
    float probeHysteresis = freshUpdate
        ? 0.0
        : SimpleDdgiCadenceAdjustedHysteresis(params, update);
    bool reducedComplexityEnabled = (pc.Flags & SIMPLE_DDGI_BLEND_FLAG_REDUCED_COMPLEXITY) != 0u;
    bool sharedRayCacheEnabled = (pc.Flags & SIMPLE_DDGI_BLEND_FLAG_SHARED_RAY_CACHE) != 0u || reducedComplexityEnabled;
    if (sharedRayCacheEnabled)
        LoadSimpleRayCache(params, localProbeOffset, activeRayCount);

    if (local == 0u)
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_ATLAS_WRITE_PROBE_COUNTER, 1u);
        if (probeHysteresis <= 0.0001)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_BLEND_HYSTERESIS_ZERO_FRAME_COUNTER, 1u);
    }

    float localIrradianceDelta = 0.0;
    bool transportV2Active =
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u;
    // V2 solver-only updates reuse the same geometric source rays. Preserve
    // their published visibility moments; rebuilding them from cached
    // frontface distances would erase the two-sided shell occlusion recorded
    // by the most recent source refresh.
    bool refreshVisibility = !transportV2Active ||
        SimpleDdgiUpdateRequiresSourceRefresh(update) ||
        freshUpdate;
    if (reducedComplexityEnabled)
    {
        if (local == 0u)
            BuildReducedSimpleDdgiIrradiance(params, localProbeOffset, activeRayCount);
        barrier();

        for (uint texel = local; texel < params.irradianceTexels * params.irradianceTexels; texel += gl_WorkGroupSize.x)
        {
            float texelDelta = BlendReducedIrradianceTexel(params, update.volumeIndex, probeIndex, texel, probeHysteresis, maintenanceUpdate, freshUpdate);
            localIrradianceDelta = max(localIrradianceDelta, texelDelta);
        }

        if (refreshVisibility)
        {
            for (uint texel = local; texel < params.visibilityTexels * params.visibilityTexels; texel += gl_WorkGroupSize.x)
                BlendVisibilityTexel(
                    params,
                    volume,
                    probeIndex,
                    localProbeOffset,
                    texel,
                    probeHysteresis,
                    true,
                    activeRayCount,
                    maintenanceUpdate,
                    freshUpdate);
        }
    }
    else
    {
        for (uint texel = local; texel < params.irradianceTexels * params.irradianceTexels; texel += gl_WorkGroupSize.x)
        {
            float texelDelta = BlendIrradianceTexel(params, update.volumeIndex, probeIndex, localProbeOffset, texel, probeHysteresis, sharedRayCacheEnabled, activeRayCount, maintenanceUpdate, freshUpdate);
            localIrradianceDelta = max(localIrradianceDelta, texelDelta);
        }

        if (refreshVisibility)
        {
            for (uint texel = local; texel < params.visibilityTexels * params.visibilityTexels; texel += gl_WorkGroupSize.x)
                BlendVisibilityTexel(params, volume, probeIndex, localProbeOffset, texel, probeHysteresis, sharedRayCacheEnabled, activeRayCount, maintenanceUpdate, freshUpdate);
        }
    }

    SharedSimpleIrradianceDelta[local] = localIrradianceDelta;
    barrier();

    // Publishing the probe state is the commit point for gather. Ensure every
    // invocation's irradiance and visibility SSBO writes are available before
    // the FRESH gate can be cleared by invocation zero.
    memoryBarrierBuffer();
    barrier();

    if (local == 0u)
    {
        float aggregateIrradianceDelta = 0.0;
        uint irradianceTexelCount = min(params.irradianceTexels * params.irradianceTexels, 64u);
        for (uint texel = 0u; texel < irradianceTexelCount; texel++)
        {
            if (transportV2Active)
            {
                aggregateIrradianceDelta = max(
                    aggregateIrradianceDelta,
                    SharedSimpleIrradianceDelta[texel]);
            }
            else
            {
                aggregateIrradianceDelta +=
                    SharedSimpleIrradianceDelta[texel];
            }
        }
        if (!transportV2Active)
        {
            aggregateIrradianceDelta /=
                max(float(irradianceTexelCount), 1.0);
        }
        SimpleDdgiProbeState state = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
        if (SimpleDdgiUpdateMatchesProbeGeneration(update, state))
        {
            // Fast attack prevents a newly arrived bounce from hiding below the
            // three-sample stability window. The decaying peak retains bounded
            // noise rejection while never understating the current defect.
            if (transportV2Active)
            {
                float previousResidualEnvelope =
                    isnan(state.luminanceChangeEma) ||
                    isinf(state.luminanceChangeEma) ||
                    state.luminanceChangeEma < 0.0
                        ? 1.0
                        : clamp(state.luminanceChangeEma, 0.0, 1.0);
                state.luminanceChangeEma = mix(
                    0.0,
                    previousResidualEnvelope,
                    SIMPLE_DDGI_TRANSPORT_RESIDUAL_ENVELOPE_DECAY);
                state.luminanceChangeEma = max(
                    clamp(aggregateIrradianceDelta, 0.0, 1.0),
                    state.luminanceChangeEma);
            }
            else
            {
                state.luminanceChangeEma = mix(
                    max(state.luminanceChangeEma, 0.0),
                    clamp(aggregateIrradianceDelta, 0.0, 8.0),
                    0.20);
            }
            if (freshUpdate)
                state.flags &= ~SIMPLE_DDGI_PROBE_FLAG_FRESH;
            WriteSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex, state);
        }
    }
}

#undef AddRendererDiagnostic
