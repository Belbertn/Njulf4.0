#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D GtaoRawInput;
layout(set = 0, binding = 1) uniform sampler2D DepthTexture;
layout(set = 0, binding = 2) uniform sampler2D MotionTexture;
layout(set = 0, binding = 3) uniform sampler2D PreviousHistory;
layout(set = 0, binding = 4) uniform usampler2D PreviousGeometryHistory;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D CurrentHistory;
layout(rg32ui, set = 0, binding = 6) uniform writeonly uimage2D CurrentGeometryHistory;

layout(push_constant) uniform GtaoTemporalPushBlock
{
    mat4 InverseProjectionMatrix;
    vec2 Dimensions;
    vec2 SceneDimensions;
    uint HistoryValid;
    uint MaximumHistoryAge;
    uint FrameIndex;
    uint Padding0;
    float DepthThresholdScale;
    float NormalThreshold;
    float StableHistoryWeight;
    float MotionRejectionScale;
} pc;

const uint GTAO_REJECTION_NONE = 0u;
const uint GTAO_REJECTION_INVALID_EPOCH = 1u;
const uint GTAO_REJECTION_REPROJECTION = 2u;
const uint GTAO_REJECTION_EMPTY_MISMATCH = 3u;
const uint GTAO_REJECTION_DEPTH = 4u;
const uint GTAO_REJECTION_NORMAL = 5u;
const uint GTAO_REJECTION_NONFINITE = 6u;
const uint GTAO_REJECTION_AGE = 7u;

bool Finite(float value)
{
    return !isnan(value) && !isinf(value);
}

bool Finite(vec2 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool Finite(vec4 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

float FetchDepth(vec2 uv)
{
    ivec2 extent = textureSize(DepthTexture, 0);
    ivec2 pixel = ivec2(clamp(uv * vec2(extent), vec2(0.0),
        vec2(extent - ivec2(1))));
    return texelFetch(DepthTexture, pixel, 0).r;
}

vec3 ReconstructViewPosition(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - vec2(1.0), depth, 1.0);
    vec4 view = MulRowMajor(clip, pc.InverseProjectionMatrix);
    return view.xyz / max(abs(view.w), 1.0e-6);
}

vec3 ReconstructGeometricNormal(vec2 uv, float centerDepth, vec3 center)
{
    vec2 texel = 1.0 / max(pc.SceneDimensions, vec2(1.0));
    vec2 rightUv = min(uv + vec2(texel.x, 0.0), vec2(1.0));
    vec2 leftUv = max(uv - vec2(texel.x, 0.0), vec2(0.0));
    vec2 upUv = min(uv + vec2(0.0, texel.y), vec2(1.0));
    vec2 downUv = max(uv - vec2(0.0, texel.y), vec2(0.0));
    float rightDepth = FetchDepth(rightUv);
    float leftDepth = FetchDepth(leftUv);
    float upDepth = FetchDepth(upUv);
    float downDepth = FetchDepth(downUv);
    vec3 right = ReconstructViewPosition(rightUv, rightDepth);
    vec3 left = ReconstructViewPosition(leftUv, leftDepth);
    vec3 up = ReconstructViewPosition(upUv, upDepth);
    vec3 down = ReconstructViewPosition(downUv, downDepth);
    vec3 dx = rightDepth > 1.0e-6 &&
            (leftDepth <= 1.0e-6 || abs(right.z - center.z) <=
             abs(center.z - left.z))
        ? right - center
        : center - left;
    vec3 dy = upDepth > 1.0e-6 &&
            (downDepth <= 1.0e-6 || abs(up.z - center.z) <=
             abs(center.z - down.z))
        ? up - center
        : center - down;
    vec3 normal = cross(dy, dx);
    float lengthSquared = dot(normal, normal);
    if (lengthSquared <= max(dot(dx, dx) * dot(dy, dy), 1.0e-20) * 1.0e-6)
        return vec3(0.0, 0.0, 1.0);
    normal *= inversesqrt(lengthSquared);
    return dot(normal, -center) < 0.0 ? -normal : normal;
}

vec2 EncodeOctahedral(vec3 normal)
{
    normal /= max(abs(normal.x) + abs(normal.y) + abs(normal.z), 1.0e-6);
    vec2 encoded = normal.xy;
    if (normal.z < 0.0)
        encoded = (vec2(1.0) - abs(encoded.yx)) * sign(encoded);
    return clamp(encoded, vec2(-1.0), vec2(1.0));
}

vec3 DecodeOctahedral(vec2 encoded)
{
    vec3 normal = vec3(encoded,
        1.0 - abs(encoded.x) - abs(encoded.y));
    if (normal.z < 0.0)
        normal.xy = (vec2(1.0) - abs(normal.yx)) * sign(normal.xy);
    float lengthSquared = dot(normal, normal);
    return lengthSquared > 1.0e-8
        ? normal * inversesqrt(lengthSquared)
        : vec3(0.0, 0.0, 1.0);
}

uvec2 PackGeometry(vec3 normal, float viewDepth, uint age, uint rejection)
{
    uint packedNormal = packSnorm2x16(EncodeOctahedral(normal));
    uint packedDepth = packHalf2x16(vec2(log2(1.0 + max(viewDepth, 0.0)),
        0.0)) & 0xffffu;
    uint packedState = packedDepth | ((age & 0xffu) << 16u) |
        ((rejection & 0x7fu) << 24u) | 0x80000000u;
    return uvec2(packedNormal, packedState);
}

bool UnpackGeometry(
    uvec2 packed,
    out vec3 normal,
    out float viewDepth,
    out uint age)
{
    if ((packed.y & 0x80000000u) == 0u)
    {
        normal = vec3(0.0, 0.0, 1.0);
        viewDepth = 0.0;
        age = 0u;
        return false;
    }
    normal = DecodeOctahedral(unpackSnorm2x16(packed.x));
    float logarithmicDepth = unpackHalf2x16(packed.y & 0xffffu).x;
    viewDepth = max(exp2(logarithmicDepth) - 1.0, 0.0);
    age = (packed.y >> 16u) & 0xffu;
    return Finite(viewDepth);
}

void NeighborhoodEnvelope(
    ivec2 centerPixel,
    float centerDepth,
    vec3 centerNormal,
    out float minimumVisibility,
    out float maximumVisibility)
{
    ivec2 extent = textureSize(GtaoRawInput, 0);
    minimumVisibility = 1.0;
    maximumVisibility = 0.0;
    bool found = false;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 pixel = clamp(centerPixel + ivec2(x, y),
                ivec2(0), extent - ivec2(1));
            vec2 uv = (vec2(pixel) + vec2(0.5)) / pc.Dimensions;
            float depth = FetchDepth(uv);
            if (depth <= 1.0e-6)
                continue;
            vec3 position = ReconstructViewPosition(uv, depth);
            vec3 normal = ReconstructGeometricNormal(uv, depth, position);
            if (abs(abs(position.z) - centerDepth) >
                    max(0.02, centerDepth * pc.DepthThresholdScale) ||
                dot(normal, centerNormal) < pc.NormalThreshold)
                continue;
            float visibility = texelFetch(GtaoRawInput, pixel, 0).z;
            if (!Finite(visibility))
                continue;
            minimumVisibility = min(minimumVisibility, visibility);
            maximumVisibility = max(maximumVisibility, visibility);
            found = true;
        }
    }
    if (!found)
    {
        float centerVisibility = texelFetch(
            GtaoRawInput, centerPixel, 0).z;
        minimumVisibility = centerVisibility;
        maximumVisibility = centerVisibility;
    }
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(CurrentHistory);
    if (any(greaterThanEqual(pixel, extent)))
        return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) /
        max(pc.Dimensions, vec2(1.0));
    float depth = FetchDepth(uv);
    vec4 current = texelFetch(GtaoRawInput, pixel, 0);
    if (depth <= 1.0e-6)
    {
        imageStore(CurrentHistory, pixel, vec4(0.0, 0.0, 1.0, 0.0));
        imageStore(CurrentGeometryHistory, pixel, uvec4(0u));
        return;
    }
    vec3 position = ReconstructViewPosition(uv, depth);
    float viewDepth = abs(position.z);
    vec3 normal = ReconstructGeometricNormal(uv, depth, position);
    uint rejection = GTAO_REJECTION_NONE;
    bool acceptHistory = pc.HistoryValid != 0u;
    if (!acceptHistory)
        rejection = GTAO_REJECTION_INVALID_EPOCH;
    vec2 motion = textureLod(MotionTexture, uv, 0.0).xy;
    if (!Finite(motion))
    {
        acceptHistory = false;
        rejection = GTAO_REJECTION_NONFINITE;
    }
    vec2 previousUv = uv - motion;
    if (acceptHistory &&
        (any(lessThan(previousUv, vec2(0.0))) ||
         any(greaterThanEqual(previousUv, vec2(1.0)))))
    {
        acceptHistory = false;
        rejection = GTAO_REJECTION_REPROJECTION;
    }
    vec4 previous = vec4(0.0);
    uint previousAge = 0u;
    vec3 previousNormal = vec3(0.0, 0.0, 1.0);
    float previousDepth = 0.0;
    if (acceptHistory)
    {
        previous = textureLod(PreviousHistory, previousUv, 0.0);
        ivec2 previousPixel = clamp(ivec2(floor(previousUv *
            pc.Dimensions)), ivec2(0), extent - ivec2(1));
        uvec2 packedPrevious = texelFetch(
            PreviousGeometryHistory, previousPixel, 0).xy;
        if (!UnpackGeometry(packedPrevious, previousNormal,
                previousDepth, previousAge))
        {
            acceptHistory = false;
            rejection = GTAO_REJECTION_EMPTY_MISMATCH;
        }
        else if (abs(previousDepth - viewDepth) >
            max(0.02, viewDepth * pc.DepthThresholdScale))
        {
            acceptHistory = false;
            rejection = GTAO_REJECTION_DEPTH;
        }
        else if (dot(previousNormal, normal) < pc.NormalThreshold)
        {
            acceptHistory = false;
            rejection = GTAO_REJECTION_NORMAL;
        }
        else if (!Finite(previous) || !Finite(current))
        {
            acceptHistory = false;
            rejection = GTAO_REJECTION_NONFINITE;
        }
        else if (previousAge >= pc.MaximumHistoryAge)
        {
            acceptHistory = false;
            rejection = GTAO_REJECTION_AGE;
        }
    }

    float minimumVisibility;
    float maximumVisibility;
    NeighborhoodEnvelope(pixel, viewDepth, normal,
        minimumVisibility, maximumVisibility);
    previous.z = clamp(previous.z, minimumVisibility, maximumVisibility);
    vec3 currentBent = DecodeOctahedral(current.xy);
    vec3 previousBent = DecodeOctahedral(previous.xy);
    if (dot(previousBent, normal) <= 0.0 ||
        dot(previousBent, currentBent) < 0.20)
        previousBent = currentBent;
    float motionPixels = length(motion * pc.SceneDimensions);
    float historyWeight = acceptHistory
        ? clamp(pc.StableHistoryWeight * previous.w *
            exp2(-motionPixels * pc.MotionRejectionScale), 0.0, 0.95)
        : 0.0;
    vec3 bentNormal = normalize(mix(currentBent, previousBent,
        historyWeight));
    if (dot(bentNormal, normal) <= 0.0)
        bentNormal = currentBent;
    float visibility = mix(current.z, previous.z, historyWeight);
    float confidence = mix(current.w,
        max(current.w, previous.w * 0.98), historyWeight);
    uint age = acceptHistory
        ? min(previousAge + 1u, pc.MaximumHistoryAge)
        : 0u;
    imageStore(CurrentHistory, pixel, vec4(
        EncodeOctahedral(bentNormal),
        clamp(visibility, 0.0, 1.0),
        clamp(confidence, 0.0, 1.0)));
    imageStore(CurrentGeometryHistory, pixel, uvec4(
        PackGeometry(normal, viewDepth, age, rejection), 0u, 0u));
}
