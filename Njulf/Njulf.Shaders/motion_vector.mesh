#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require

#include "common.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 126) out;

struct MotionVectorTaskPayload
{
    uint DrawCommandIndex;
    uint Visible;
};

taskPayloadSharedEXT MotionVectorTaskPayload motionPayload;
shared uint meshNegativeDeterminant;

layout(location = 0) noperspective out vec2 meshCurrentUv[];
layout(location = 1) noperspective out vec2 meshPreviousUv[];
layout(location = 2) flat out uint meshReceiverSignature[];
layout(location = 3) flat out uint meshHistoryFrameAndFlags[];

layout(push_constant) uniform MotionVectorPushConstantBlock
{
    GPUMotionVectorPushConstants Push;
} pc;

vec2 ClipToUv(vec4 clip)
{
    vec2 ndc = clip.xy / max(abs(clip.w), 0.000001);
    return ndc * 0.5 + vec2(0.5);
}

void main()
{
    if (motionPayload.Visible == 0u)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }

    GPUMeshletDrawCommand command = ReadMeshletDrawCommandFromBase(
        pc.Push.MeshletDrawBufferBaseIndex,
        pc.Push.CurrentFrameIndex,
        motionPayload.DrawCommandIndex);
    GPUMeshlet meshlet = ReadMeshlet(command.MeshletIndex);
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) + pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId * uint(SIZEOF_GPU_OBJECT_DATA / 4);

    if (gl_LocalInvocationIndex == 0u)
    {
        SetMeshOutputsEXT(meshlet.LocalVertexCount, meshlet.LocalTriangleCount);
        meshNegativeDeterminant =
            ReadRowMajorLinearDeterminant(instanceBufferIndex, objectWordOffset) < 0.0
                ? 1u
                : 0u;
    }

    barrier();

    GPUObjectData objectData = ReadInstanceData(pc.Push.CurrentFrameIndex, command.InstanceId);

    for (uint vertexSlot = gl_LocalInvocationIndex;
         vertexSlot < meshlet.LocalVertexCount;
         vertexSlot += gl_WorkGroupSize.x)
    {
        uint localVertexIndex = ReadStorageWord(
            uint(MESHLET_VERTEX_INDEX_BUFFER_INDEX),
            meshlet.LocalVertexOffset + vertexSlot);
        vec3 position = FetchRenderableVertexPosition(meshlet, localVertexIndex, objectData, pc.Push.CurrentFrameIndex);

        vec4 currentWorldPosition = TransformRowMajorPoint(position, instanceBufferIndex, objectWordOffset);
        vec4 previousWorldPosition = TransformRowMajorPoint(position, instanceBufferIndex, objectWordOffset + 36u);
        vec4 currentClip = MulRowMajor(currentWorldPosition, pc.Push.ViewProjectionMatrix);
        vec4 previousClip = MulRowMajor(previousWorldPosition, pc.Push.PreviousViewProjectionMatrix);

        gl_MeshVerticesEXT[vertexSlot].gl_Position = currentClip;
        meshCurrentUv[vertexSlot] = ClipToUv(currentClip);
        meshPreviousUv[vertexSlot] = (pc.Push.PreviousFrameValid & 1u) != 0u
            ? ClipToUv(previousClip)
            : meshCurrentUv[vertexSlot];
        meshReceiverSignature[vertexSlot] =
            (command.InstanceId * 0x9e3779b9u) ^
            (command.MaterialIndex * 0x85ebca6bu) ^ 0x51ed270bu;
        meshHistoryFrameAndFlags[vertexSlot] =
            (pc.Push.CurrentFrameIndex & 0xffu) |
            ((pc.Push.PreviousFrameValid & 2u) << 7u);
    }

    for (uint triangleSlot = gl_LocalInvocationIndex;
         triangleSlot < meshlet.LocalTriangleCount;
         triangleSlot += gl_WorkGroupSize.x)
    {
        uint triangleOffset = meshlet.LocalTriangleOffset + triangleSlot * 3u;
        uint i0 = ReadStorageWord(uint(MESHLET_TRIANGLE_INDEX_BUFFER_INDEX), triangleOffset + 0u);
        uint i1 = ReadStorageWord(uint(MESHLET_TRIANGLE_INDEX_BUFFER_INDEX), triangleOffset + 1u);
        uint i2 = ReadStorageWord(uint(MESHLET_TRIANGLE_INDEX_BUFFER_INDEX), triangleOffset + 2u);
        gl_PrimitiveTriangleIndicesEXT[triangleSlot] = ResolveMirroredInstanceTriangle(
            i0,
            i1,
            i2,
            meshNegativeDeterminant != 0u);
    }
}
