#if SIMPLE_DDGI_TRACE_SHADER_ROLE != SIMPLE_DDGI_TRACE_SHADER_ROLE_REUSE
bool TraceSimpleDdgiBackfaceVisibilityDistance(
    vec3 origin,
    vec3 direction,
    float maxDistance,
    out float hitDistance)
{
    hitDistance = max(maxDistance, 0.0);
    if (maxDistance <= DDGI_PROBE_TRACE_EPSILON)
        return false;

    // This query never shades or enters the V2 transport source cache. Its
    // covered distance makes thin architectural shells two-sided occluders for
    // receiver visibility. If that backface is the nearest hit, the packed
    // visibility kind also lets relocation evacuate a probe immediately behind
    // a one-sided floor or wall instead of leaving a bright probe there.
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query,
        SceneTlas,
        gl_RayFlagsCullFrontFacingTrianglesEXT,
        0xff,
        origin,
        DDGI_PROBE_TRACE_EPSILON,
        direction,
        maxDistance);

    uint alphaCandidateCount = 0u;
    while (rayQueryProceedEXT(query))
    {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT)
            continue;

        uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, false);
        bool frontFacing = rayQueryGetIntersectionFrontFaceEXT(query, false);
        GPUDdgiRayQueryInstance instance =
            ReadDdgiRayQueryInstance(instanceIndex);
        if (DdgiRayQueryInstanceIsValid(instance) &&
            DdgiRayGeometryIsDecal(instance))
        {
            continue;
        }
        if (!DdgiRayQueryInstanceIsValid(instance))
        {
            AddRendererDiagnostic(
                pc.CurrentFrameIndex,
                DDGI_RAY_METADATA_INVALID_COUNTER,
                1u);
            rayQueryConfirmIntersectionEXT(query);
            rayQueryTerminateEXT(query);
            break;
        }

        alphaCandidateCount++;
        if (alphaCandidateCount > DDGI_HIT_ALPHA_CANDIDATE_LIMIT)
        {
            RecordDdgiAlphaCandidateLimitReached();
            rayQueryConfirmIntersectionEXT(query);
            rayQueryTerminateEXT(query);
            break;
        }

        if (DdgiCandidatePassesTwoSidedOpacity(
                instanceIndex,
                primitiveIndex,
                barycentrics,
                frontFacing))
        {
            rayQueryConfirmIntersectionEXT(query);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT)
        return false;

    hitDistance = rayQueryGetIntersectionTEXT(query, true);
    return true;
}
#endif

bool SimpleDdgiRaySegmentIntersectsAabb(
    vec3 origin,
    vec3 direction,
    float segmentLength,
    vec3 minimum,
    vec3 maximum,
    float padding)
{
    if (any(isnan(origin)) || any(isinf(origin)) ||
        any(isnan(direction)) || any(isinf(direction)) ||
        isnan(segmentLength) || isinf(segmentLength) ||
        segmentLength < 0.0 || any(isnan(minimum)) || any(isinf(minimum)) ||
        any(isnan(maximum)) || any(isinf(maximum)))
    {
        return true;
    }

    vec3 boxMinimum = min(minimum, maximum) - vec3(max(padding, 0.0));
    vec3 boxMaximum = max(minimum, maximum) + vec3(max(padding, 0.0));
    float intervalMinimum = 0.0;
    float intervalMaximum = segmentLength;
    for (uint axis = 0u; axis < 3u; axis++)
    {
        float axisDirection = direction[axis];
        if (abs(axisDirection) <= 1.0e-8)
        {
            if (origin[axis] < boxMinimum[axis] ||
                origin[axis] > boxMaximum[axis])
                return false;
            continue;
        }

        float inverseDirection = 1.0 / axisDirection;
        float first = (boxMinimum[axis] - origin[axis]) * inverseDirection;
        float second = (boxMaximum[axis] - origin[axis]) * inverseDirection;
        intervalMinimum = max(intervalMinimum, min(first, second));
        intervalMaximum = min(intervalMaximum, max(first, second));
        if (intervalMaximum < intervalMinimum)
            return false;
    }
    return intervalMaximum >= intervalMinimum;
}

// Returns true when this cached ray must be replaced. Structural changes can
// alter a direct-light visibility path from any cached surface hit, so hits are
// conservatively re-traced for every influencing structural region. Misses and
// material-only edits use the exact cached primary segment.
bool SimpleDdgiSegmentSelectiveTouchesRay(
    vec3 probePosition,
    vec3 direction,
    float cachedDistance,
    float cachedHitKind,
    float probeSpacing)
{
    if (pc.SchedulerArenaBufferIndex == 0xffffffffu)
        return true;
    uint dirtyCount = min(
        ReadStorageWordUniform(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerFrameOffsetWords + 24u),
        ReadStorageWordUniform(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerFrameOffsetWords + 25u));
    dirtyCount = min(dirtyCount, SIMPLE_DDGI_TRACE_MAX_DIRTY_REGIONS);
    if (dirtyCount == 0u)
        return true;

    bool sawInfluencingRegion = false;
    float segmentPadding = max(0.02, probeSpacing * 0.005);
    // dirtyCount is already clamped to the frozen upper bound above. Looping
    // over that value preserves the same safety proof while avoiding a
    // 1,024-iteration static loop with an internal continue for every cached
    // ray. Some native compilers aggressively expand that shape, and the
    // resulting program is both slower and needlessly difficult to compile.
    for (uint regionIndex = 0u; regionIndex < dirtyCount; regionIndex++)
    {
        uint base = pc.SchedulerDirtyRegionOffsetWords +
            regionIndex * SIMPLE_DDGI_TRACE_DIRTY_REGION_WORDS;
        uint reasonFlags = ReadStorageWordUniform(
            pc.SchedulerArenaBufferIndex,
            base + 16u);
        if (reasonFlags == 0u ||
            (reasonFlags & ~SIMPLE_DDGI_DIRTY_SEGMENT_SAFE_MASK) != 0u)
        {
            return true;
        }

        vec3 influenceMinimum = vec3(
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 0u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 1u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 2u))) - vec3(probeSpacing);
        vec3 influenceMaximum = vec3(
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 4u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 5u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 6u))) + vec3(probeSpacing);
        bool influencesProbe = all(greaterThanEqual(
                probePosition,
                min(influenceMinimum, influenceMaximum))) &&
            all(lessThanEqual(
                probePosition,
                max(influenceMinimum, influenceMaximum)));
        if (!influencesProbe)
            continue;
        sawInfluencingRegion = true;

        bool cachedSurfaceHit = cachedHitKind !=
            SIMPLE_DDGI_RAY_HIT_KIND_MISS;
        if (cachedSurfaceHit &&
            (reasonFlags & SIMPLE_DDGI_DIRTY_STRUCTURAL_MASK) != 0u)
        {
            return true;
        }

        vec3 segmentMinimum = vec3(
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 8u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 9u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 10u)));
        vec3 segmentMaximum = vec3(
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 12u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 13u)),
            uintBitsToFloat(ReadStorageWordUniform(
                pc.SchedulerArenaBufferIndex, base + 14u)));
        if (SimpleDdgiRaySegmentIntersectsAabb(
                probePosition,
                direction,
                cachedDistance,
                segmentMinimum,
                segmentMaximum,
                segmentPadding))
        {
            return true;
        }
    }

    // A scheduler/trace influence disagreement is uncertain provenance. It is
    // cheaper to re-trace than to risk a false-negative segment copy.
    return !sawInfluencingRegion;
}

// All calls below are in main(), where params is the authoritative uploaded
// simple-DDGI state. Remapping the counter helper here keeps disabled captures
// free of the otherwise high-contention per-ray atomic operations.
#define AddRendererDiagnostic(frameIndex, counterIndex, value) AddSimpleDdgiDiagnostic(params, frameIndex, counterIndex, value)

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    simpleDdgiCurrentDetailedDiagnostics = SimpleDdgiDetailedDiagnosticsEnabled(params);
    uint dispatchRay = gl_GlobalInvocationID.x;
    bool gpuScheduler = SimpleDdgiGpuSchedulerActive(pc.SchedulerArenaBufferIndex);
    uint schedulerQueueOffset = 0u;
    uint schedulerProbeCount = 0u;
    uint schedulerRaysPerProbe = 0u;
    if (gpuScheduler)
    {
        SimpleDdgiResolveSchedulerRayBucket(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerRayBucketMetadataOffsetWords,
            pc.SchedulerRayBucketIndex,
            schedulerQueueOffset,
            schedulerProbeCount,
            schedulerRaysPerProbe);
    }
    uint dispatchProbeCount;
    uint dispatchRaysPerProbe;
    if (gpuScheduler)
    {
        // Resident dispatch dimensions and queue addressing are an ABI owned by
        // the emitted metadata record. Push constants are intentionally ignored
        // here so a stale per-pass batch cannot select another queue slice.
        dispatchProbeCount = schedulerProbeCount;
        dispatchRaysPerProbe = schedulerRaysPerProbe;
    }
    else
    {
        dispatchProbeCount = pc.DispatchProbeCount > 0u
            ? pc.DispatchProbeCount
            : params.probesToUpdate;
        dispatchRaysPerProbe = pc.DispatchRaysPerProbe > 0u
            ? pc.DispatchRaysPerProbe
            : params.raysPerProbe;
    }
    uint dispatchRayCount = dispatchProbeCount * dispatchRaysPerProbe;
    if (dispatchRay >= dispatchRayCount || params.probeCount == 0u)
        return;

    uint updateProbeOffset = (gpuScheduler ? schedulerQueueOffset : pc.DispatchQueueOffset) +
        dispatchRay / dispatchRaysPerProbe;
    uint rayIndex = dispatchRay % dispatchRaysPerProbe;
    if (!gpuScheduler && updateProbeOffset >= params.probesToUpdate)
        return;
    // Scratch remains addressed by the canonical queue-wide ray stride so later
    // probe-oriented passes are independent of dispatch batching.
    uint globalRay = updateProbeOffset * params.raysPerProbe + rayIndex;
    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, updateProbeOffset);
    simpleDdgiCurrentVolumeIndex = update.volumeIndex;
    simpleDdgiCurrentReceiverInstanceIndex = 0xffffffffu;
    simpleDdgiCurrentReceiverPrimitiveIndex = 0xffffffffu;
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    if (rayIndex >= activeRayCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }

    uint probeIndex = update.probeIndex;
    if (probeIndex >= params.probeCount)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    if (!SimpleDdgiUpdateMatchesLiveAddress(params, update))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(probeIndex, params, volume, localProbeIndex))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 2u);
        return;
    }
    SimpleDdgiProbeState probeState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGenerationAndRecord(
            params,
            update,
            probeState))
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 0u);
        return;
    }

    uint volumeCascade = SimpleDdgiVolumeQualityCascade(volume);
    simpleDdgiCurrentVolumeCascade = volumeCascade;
    int materialTextureMaxCascade = SimpleDdgiUpdateMaterialTextureMaxCascade(update);
    simpleDdgiCurrentMaterialTextureMaxCascade = materialTextureMaxCascade < 0
        ? DDGI_MATERIAL_TEXTURE_DISABLED_CASCADE
        : uint(materialTextureMaxCascade);
    simpleDdgiCurrentMaxShadedLights = SimpleDdgiUpdateMaxShadedLights(update, pc.MaxShadedLights);
    vec3 probePosition = SimpleDdgiProbeLogicalPosition(volume, localProbeIndex) + probeState.relocation;
    // Maintenance rays are a stratified subset of the full sequence. This keeps
    // the estimator's directional support stable when the scheduler changes tier.
    uint sourceRayCount = SimpleDdgiUpdateSourceRayCount(update, params);
    float sourceRayAngularRadius = sqrt(
        4.0 / max(float(sourceRayCount), 1.0));
    // Cache keys remain indices in the global Fibonacci sequence. Map through
    // the per-probe source sequence so a 24-ray far ring stays uniformly
    // distributed across the 64/128-ray shared sequence and maintenance picks
    // an exact subset of those cached directions.
    uint directionRayIndex = SimpleDdgiUpdateDirectionRayIndex(
        rayIndex,
        activeRayCount,
        sourceRayCount,
        params);
    // The physical slot plus its non-zero ownership generation is stable for
    // the lifetime of a cached source sequence and changes on reassignment.
    // Frame number is intentionally absent from every sampling decision.
    simpleDdgiCurrentWorldProbeStableKey = uvec2(
        probeIndex,
        SimpleDdgiProbeGeneration(probeState));
    simpleDdgiCurrentDirectionRayOrdinal = directionRayIndex;
    simpleDdgiCurrentSourceLightingEpoch = update.sourceEpoch;
#if SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_PACKED
    vec3 direction = SimpleDdgiReconstructRayDirection(
        probeIndex,
        directionRayIndex,
        update.sourceEpoch,
        params);
#else
    vec3 direction = (params.flags & SIMPLE_DDGI_FLAG_DIRECTION_CODEBOOK) != 0u
        ? SimpleDdgiReconstructRayDirection(
            probeIndex,
            directionRayIndex,
            update.sourceEpoch,
            params)
        : SimpleDdgiFibonacciDirection(
            directionRayIndex,
            params.raysPerProbe,
            SimpleDdgiPerProbeRayRotation(probeIndex, params.rayRotation));
#endif
    // C3 payloads are source-cache records, not transient guide lookups.  The
    // packed direction and generation-time PDF therefore remain authoritative
    // even if a newer distribution bank is built before this source sequence
    // is consumed.  A backed-but-invalid payload aborts the probe transaction:
    // falling back only that ray would mix proposal families without a valid
    // balance denominator and bias the published irradiance.
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
    bool guidingRecordPresent = false;
    vec3 guidingDirection;
    bool guidingPayloadValid = TryReadSimpleDdgiGuidingTraceDirection(
        update.physicalProbeIndex,
        update.probeIndex,
        update.pageMappingGeneration,
        update.sourceEpoch,
        update.sourceLightingGeneration,
        simpleDdgiCurrentWorldProbeStableKey,
        directionRayIndex,
        params.raysPerProbe,
        params.guidingPhysicalProbeCapacity,
        guidingRecordPresent,
        guidingDirection);
    if (guidingRecordPresent && !guidingPayloadValid)
    {
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 1u);
        return;
    }
    if (guidingPayloadValid)
        direction = guidingDirection;
#endif
    bool transportV2 = (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) != 0u;
    bool sourceRefresh = SimpleDdgiUpdateRequiresSourceRefresh(update);
    bool environmentMissRelight =
        SimpleDdgiUpdateRelightsEnvironmentMisses(update);
    bool cachedHitRelight =
        SimpleDdgiUpdateRelightsCachedHits(update);
    bool cachedGeometryReuse =
        SimpleDdgiUpdateReusesCachedGeometry(update);
    bool privateUrgentRelight =
        (pc.Flags & SIMPLE_DDGI_TRACE_FLAG_PRIVATE_URGENT_RELIGHT) != 0u;
    bool segmentSelective = sourceRefresh &&
        SimpleDdgiUpdateSourceRefreshMode(update) ==
            SIMPLE_DDGI_SOURCE_MODE_SEGMENT_SELECTIVE;
    bool intentionalSegmentRetrace = false;
    // Invalidating source work commits the next physical generation only
    // after every producer completes. Stamp cache entries with that future
    // generation now so the committed public state and complete source
    // sequence become current atomically from the next transaction onward.
    uint sourceCacheProbeGeneration = SimpleDdgiProbeGeneration(probeState);
    if (sourceRefresh &&
        (update.flags & SIMPLE_DDGI_UPDATE_INVALIDATE) != 0u)
    {
        sourceCacheProbeGeneration =
            NextSimpleDdgiPhysicalGeneration(sourceCacheProbeGeneration);
    }
    bool relocationRetryPending =
        (probeState.flags & SIMPLE_DDGI_PROBE_FLAG_RELOCATION_PENDING) != 0u;
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_REUSE
    // Clearing first makes a cache miss observable to the ordered source
    // kernel without growing the public queue ABI or relying on stale scratch.
    ClearSimpleDdgiRayResultStorage(
        pc.RayResultScratchBufferIndex,
        globalRay,
        volume);
#endif
    // Probe density and transport horizon are independent. In particular, a
    // compact refinement brick must solve the same incident-light domain as
    // the base field it replaces; deriving this from its small grid extent
    // turned every hit beyond the brick into a false environment miss.
    float maxDistance = volume.maximumTraceDistance;
    bool farFieldOnlyRing = volume.spacing >= 15.999;
#if defined(SIMPLE_DDGI_TRACE_FAR_FIELD_MODE) && SIMPLE_DDGI_TRACE_FAR_FIELD_MODE == 1
    const bool farFieldEnabled = false;
    const bool completeRayScene = true;
#elif defined(SIMPLE_DDGI_TRACE_FAR_FIELD_MODE) && SIMPLE_DDGI_TRACE_FAR_FIELD_MODE == 2
    const bool farFieldEnabled = true;
    const bool completeRayScene = false;
#else
    bool farFieldEnabled = (pc.Flags & SIMPLE_DDGI_FLAG_FAR_FIELD_ENABLED) != 0u;
    bool completeRayScene = (pc.Flags & SIMPLE_DDGI_TRACE_FLAG_COMPLETE_RAY_SCENE) != 0u;
#endif
    float nearTlasMaxDistance = farFieldEnabled && !completeRayScene
        ? min(maxDistance, max(params.farFieldStartDistance, volume.spacing))
        : maxDistance;

    // A full source refresh is the authoritative repair boundary. Clear any
    // older recovery request before tracing its complete sequence; transport
    // will set it again if the just-written cache still cannot be consumed.
    if (transportV2 && sourceRefresh && rayIndex == 0u && !gpuScheduler)
        ClearSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, probeIndex);

    // Cached V2 source data includes the original deterministic direction, hit
    // distance, normal, and albedo. A solver-only update therefore does no ray
    // query or shadow work yet still gets an exact source hit point for bounce.
    // Visibility moments are retained until the next source refresh, where the
    // frontface source and backface-only visibility queries run together.
    // A relocation-pending probe is the one exception: the GPU committed a new
    // origin after the prior rays were traced, while CPU readback can lag by a
    // frame. Force fresh source work from that authoritative new origin so a
    // stale cache can never be published at the relocated location.
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_SINGLE || \
    SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_REUSE
    if (transportV2 && cachedGeometryReuse &&
        !relocationRetryPending)
    {
#if SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_PACKED
        vec4 cachedSourceRadianceDistance;
        float cachedSourceHitKind;
        bool cacheRead = ReadSimpleDdgiPackedTransportRayCacheForTrace(
            pc.TransportSourceCacheBufferIndex,
            update.cacheProbeBaseWordPlusOne &
                SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
            directionRayIndex,
            volume,
            params,
            SimpleDdgiProbeGeneration(probeState),
            update.sourceLightingGeneration,
            update.sourceEpoch,
            sourceRayCount,
            cachedSourceRadianceDistance,
            cachedSourceHitKind);
        if (cacheRead && environmentMissRelight &&
            cachedSourceHitKind == SIMPLE_DDGI_RAY_HIT_KIND_MISS)
        {
            cachedSourceRadianceDistance.rgb =
                SampleSimpleDdgiEnvironmentMissRadiance(direction, params);
            if (!privateUrgentRelight)
                cacheRead = UpdateSimpleDdgiTransportRayCacheRadiance(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                directionRayIndex,
                volume,
                params,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceEpoch,
                cachedSourceRadianceDistance.rgb);
        }
        else if (cacheRead && cachedHitRelight &&
            cachedSourceHitKind != SIMPLE_DDGI_RAY_HIT_KIND_MISS)
        {
            vec3 relitSourceRadiance;
            cacheRead = TryEvaluateSimpleDdgiExactCachedHitRelight(
                cachedSourceRadianceDistance.rgb,
                params.sourceRelightScale,
                relitSourceRadiance);
            cachedSourceRadianceDistance.rgb = relitSourceRadiance;
            if (cacheRead && !privateUrgentRelight)
                cacheRead = UpdateSimpleDdgiTransportRayCacheRadiance(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                directionRayIndex,
                volume,
                params,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceEpoch,
                cachedSourceRadianceDistance.rgb);
        }
        if (cacheRead && segmentSelective &&
            SimpleDdgiSegmentSelectiveTouchesRay(
                probePosition,
                direction,
                cachedSourceRadianceDistance.w,
                cachedSourceHitKind,
                volume.spacing))
        {
            intentionalSegmentRetrace = true;
            cacheRead = false;
        }
        if (cacheRead)
        {
            WriteSimpleRayResult(
                globalRay,
                params,
                volume,
                probeIndex,
                directionRayIndex,
                update.sourceEpoch,
                cachedSourceRadianceDistance.rgb,
                cachedSourceRadianceDistance.w,
                cachedSourceRadianceDistance.w,
                direction,
                cachedSourceHitKind);
#elif SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_LEGACY
        vec4 cachedSourceRadianceDistance;
        vec3 cachedSourceDirection;
        float cachedSourceHitKind;
        bool cacheRead = ReadSimpleDdgiLegacyTransportRayCacheForTrace(
            pc.TransportSourceCacheBufferIndex,
            update.cacheProbeBaseWordPlusOne &
                SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
            directionRayIndex,
            volume,
            params,
            SimpleDdgiProbeGeneration(probeState),
            update.sourceLightingGeneration,
            update.sourceEpoch,
            sourceRayCount,
            cachedSourceRadianceDistance,
            cachedSourceDirection,
            cachedSourceHitKind);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        if (cacheRead && guidingPayloadValid)
            cachedSourceDirection = guidingDirection;
#endif
        if (cacheRead && environmentMissRelight &&
            cachedSourceHitKind == SIMPLE_DDGI_RAY_HIT_KIND_MISS)
        {
            cachedSourceRadianceDistance.rgb =
                SampleSimpleDdgiEnvironmentMissRadiance(
                    cachedSourceDirection,
                    params);
            if (!privateUrgentRelight)
                cacheRead = UpdateSimpleDdgiTransportRayCacheRadiance(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                directionRayIndex,
                volume,
                params,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceEpoch,
                cachedSourceRadianceDistance.rgb);
        }
        else if (cacheRead && cachedHitRelight &&
            cachedSourceHitKind != SIMPLE_DDGI_RAY_HIT_KIND_MISS)
        {
            vec3 relitSourceRadiance;
            cacheRead = TryEvaluateSimpleDdgiExactCachedHitRelight(
                cachedSourceRadianceDistance.rgb,
                params.sourceRelightScale,
                relitSourceRadiance);
            cachedSourceRadianceDistance.rgb = relitSourceRadiance;
            if (cacheRead && !privateUrgentRelight)
                cacheRead = UpdateSimpleDdgiTransportRayCacheRadiance(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                directionRayIndex,
                volume,
                params,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceEpoch,
                cachedSourceRadianceDistance.rgb);
        }
        if (cacheRead && segmentSelective &&
            SimpleDdgiSegmentSelectiveTouchesRay(
                probePosition,
                cachedSourceDirection,
                cachedSourceRadianceDistance.w,
                cachedSourceHitKind,
                volume.spacing))
        {
            intentionalSegmentRetrace = true;
            cacheRead = false;
        }
        if (cacheRead)
        {
#if SIMPLE_DDGI_DIRECTION_VALIDATION
            if ((params.flags & SIMPLE_DDGI_FLAG_DIRECTION_VALIDATE) != 0u)
            {
                RecordSimpleDdgiDirectionComparison(
                    params,
                    pc.CurrentFrameIndex,
                    probeIndex,
                    directionRayIndex,
                    cachedSourceDirection,
                    SimpleDdgiReconstructRayDirection(
                        probeIndex,
                        directionRayIndex,
                        update.sourceEpoch,
                        params));
            }
#endif
            WriteSimpleRayResult(
                globalRay,
                params,
                volume,
                probeIndex,
                directionRayIndex,
                update.sourceEpoch,
                cachedSourceRadianceDistance.rgb,
                cachedSourceRadianceDistance.w,
                cachedSourceRadianceDistance.w,
                cachedSourceDirection,
                cachedSourceHitKind);
#else
        SimpleDdgiTransportRayCache cachedSource;
        bool cacheRead = ReadSimpleDdgiTransportRayCache(
                pc.ParamsBufferIndex,
                pc.TransportSourceCacheBufferIndex,
                update.volumeIndex,
                update.physicalProbeIndex,
                probeIndex,
                directionRayIndex,
                params,
                pc.CurrentFrameIndex,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceLightingGeneration,
                update.sourceEpoch,
                sourceRayCount,
                cachedSource);
#if SIMPLE_DDGI_DIRECTIONAL_GUIDING_TRANSPORT
        if (cacheRead && guidingPayloadValid)
            cachedSource.direction = guidingDirection;
#endif
        if (cacheRead && environmentMissRelight &&
            !SimpleDdgiTransportRayCacheIsHit(cachedSource))
        {
            cachedSource.sourceRadiance =
                SampleSimpleDdgiEnvironmentMissRadiance(
                    cachedSource.direction,
                    params);
            if (!privateUrgentRelight)
                cacheRead = UpdateSimpleDdgiTransportRayCacheRadiance(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                directionRayIndex,
                volume,
                params,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceEpoch,
                cachedSource.sourceRadiance);
        }
        else if (cacheRead && cachedHitRelight &&
            SimpleDdgiTransportRayCacheIsHit(cachedSource))
        {
            vec3 relitSourceRadiance;
            cacheRead = TryEvaluateSimpleDdgiExactCachedHitRelight(
                cachedSource.sourceRadiance,
                params.sourceRelightScale,
                relitSourceRadiance);
            cachedSource.sourceRadiance = relitSourceRadiance;
            if (cacheRead && !privateUrgentRelight)
                cacheRead = UpdateSimpleDdgiTransportRayCacheRadiance(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                directionRayIndex,
                volume,
                params,
                SimpleDdgiProbeGeneration(probeState),
                update.sourceEpoch,
                cachedSource.sourceRadiance);
        }
        if (cacheRead && segmentSelective &&
            SimpleDdgiSegmentSelectiveTouchesRay(
                probePosition,
                cachedSource.direction,
                cachedSource.distance,
                SimpleDdgiTransportRayCacheHitKind(cachedSource),
                volume.spacing))
        {
            intentionalSegmentRetrace = true;
            cacheRead = false;
        }
        if (cacheRead)
        {
            WriteSimpleRayResult(
                globalRay,
                params,
                volume,
                probeIndex,
                directionRayIndex,
                update.sourceEpoch,
                cachedSource.sourceRadiance,
                cachedSource.distance,
                cachedSource.distance,
                cachedSource.direction,
                SimpleDdgiTransportRayCacheHitKind(cachedSource));
#endif
            SimpleDdgiSchedulerRayComplete(
                pc.SchedulerArenaBufferIndex,
                pc.SchedulerOutcomesOffsetWords,
                update.outcomeIndex,
                activeRayCount,
                1u << 0u);
            return;
        }

        // The CPU normally schedules solver-only work only after a complete
        // source refresh. If an individual entry is nevertheless absent (for
        // example after a live allocation transition), trace this ray now for
        // a safe frame and request a full source-cache repair through the
        // bounded probe-state readback path.
        if (!intentionalSegmentRetrace)
        {
            atomicOr(
                BindlessStorageBuffers[nonuniformEXT(
                    pc.ProbeUpdateQueueBufferIndex)].Words[
                        updateProbeOffset *
                            SIMPLE_DDGI_PROBE_UPDATE_STRIDE_WORDS +
                        11u],
                SIMPLE_DDGI_TRACE_CACHE_FALLBACK_FLAG);
            MarkSimpleDdgiProbeSourceCacheInvalid(
                pc.ProbeStateBufferIndex,
                probeIndex);
            if (gpuScheduler)
            {
                SimpleDdgiSchedulerFailOutcome(
                    pc.SchedulerArenaBufferIndex,
                    pc.SchedulerOutcomesOffsetWords,
                    update.outcomeIndex,
                    1u << 1u);
            }
        }
    }
#endif

#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_REUSE
    // Cache hits completed their scheduler producer above. Misses deliberately
    // leave the cleared record invalid so the source kernel traces a safe
    // fallback while the existing failure/repair path prevents bad commit.
    return;
#elif SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_SOURCE
    if (transportV2 && cachedGeometryReuse &&
        !relocationRetryPending &&
        SimpleDdgiRayResultStorageIsPopulatedForEpoch(
            pc.RayResultScratchBufferIndex,
            globalRay,
            volume,
            update.sourceEpoch))
    {
        return;
    }
#elif SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
    bool splitSourceWork = !transportV2 ||
        !cachedGeometryReuse ||
        segmentSelective ||
        relocationRetryPending ||
        (update.cacheProbeBaseWordPlusOne &
            SIMPLE_DDGI_TRACE_CACHE_FALLBACK_FLAG) != 0u;
    if (!splitSourceWork)
        return;

    vec4 splitNearRadianceDistance;
    vec3 splitNearDirection;
    vec2 splitNearVisibilityHit;
    uint splitNearDirectionEpoch;
    if (!ReadSimpleDdgiRayResultStorage(
            pc.RayResultScratchBufferIndex,
            globalRay,
            volume,
            params,
            probeIndex,
            directionRayIndex,
            update.sourceEpoch,
            splitNearRadianceDistance,
            splitNearDirection,
            splitNearVisibilityHit,
            splitNearDirectionEpoch))
    {
        MarkSimpleDdgiProbeSourceCacheInvalid(
            pc.ProbeStateBufferIndex,
            probeIndex);
        SimpleDdgiSchedulerFailOutcome(
            pc.SchedulerArenaBufferIndex,
            pc.SchedulerOutcomesOffsetWords,
            update.outcomeIndex,
            1u << 1u);
        return;
    }
    bool splitNearHit = splitNearVisibilityHit.y >= 0.5;
#endif

#if SIMPLE_DDGI_TRACE_SHADER_ROLE != SIMPLE_DDGI_TRACE_SHADER_ROLE_REUSE
    // A valid probe owns its complete low-frequency field, including environment
    // misses. Forward composition evaluates diffuse IBL only for probe ownership
    // gaps, so sky energy is represented exactly once.
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
    vec3 radiance = splitNearRadianceDistance.rgb;
#else
    vec3 radiance = SampleSimpleDdgiEnvironmentMissRadiance(
        direction,
        params);
#endif
    vec3 traceDirectDiffuse = vec3(0.0);
    vec3 traceDirectNoShadowDiffuse = vec3(0.0);
    vec3 traceEmissiveDiffuse = vec3(0.0);
    vec3 traceBounceDiffuse = vec3(0.0);
    vec3 traceSkyDiffuse = radiance;
    vec3 cacheNormal = vec3(0.0, 1.0, 0.0);
    vec3 cacheAlbedo = vec3(0.0);
    vec3 cacheTransmission = vec3(0.0);
    vec3 cacheSpecularF0 = vec3(0.0);
    float cacheRoughness = 1.0;
    uint traceSurfaceFlags = 0u;
    float cacheMaterialOcclusion = 1.0;
    float hitDistance =
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
        splitNearRadianceDistance.w;
    float hitKind = splitNearVisibilityHit.y;
#else
        maxDistance;
    float hitKind = 0.0;
#endif
    // A detailed near segment is authoritative. The coarse far field begins only
    // after it, so a coarse voxel can never suppress closer TLAS geometry.
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_SINGLE || \
    SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_SOURCE
    if (nearTlasMaxDistance > DDGI_PROBE_TRACE_EPSILON)
    {
        rayQueryEXT query;
        // Do not cull back faces here. A culled one-sided shell turns an
        // embedded probe ray into a false sky miss. Commit the reverse face and
        // classify it explicitly below instead.
        rayQueryInitializeEXT(
            query,
            SceneTlas,
            gl_RayFlagsNoneEXT,
            0xff,
            probePosition,
            DDGI_PROBE_TRACE_EPSILON,
            direction,
            nearTlasMaxDistance);
        uint alphaCandidateCount = 0u;
        uint decalCandidateCount = 0u;
        SimpleDdgiDecalCandidate decalCandidates[
            SIMPLE_DDGI_DECAL_CANDIDATE_LIMIT];
        while (rayQueryProceedEXT(query))
        {
            if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
            {
                uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
                uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
                vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, false);
                bool candidateFrontFace = rayQueryGetIntersectionFrontFaceEXT(query, false);
                GPUDdgiRayQueryInstance candidateInstance =
                    ReadDdgiRayQueryInstance(instanceIndex);
                if (DdgiRayQueryInstanceIsValid(candidateInstance) &&
                    DdgiRayGeometryIsDecal(candidateInstance))
                {
                    SimpleDdgiDecalCandidate candidate;
                    candidate.InstanceIndex = instanceIndex;
                    candidate.PrimitiveIndex = primitiveIndex;
                    candidate.Barycentrics = barycentrics;
                    candidate.Distance =
                        rayQueryGetIntersectionTEXT(query, false);
                    candidate.FrontFacing = candidateFrontFace;
                    AddRendererDiagnostic(
                        pc.CurrentFrameIndex,
                        DDGI_DECAL_CANDIDATE_COUNTER,
                        1u);

                    uint effectiveDecalCandidateLimit =
                        SimpleDdgiDecalCandidateLimit();
                    if (effectiveDecalCandidateLimit == 0u)
                    {
                        AddRendererDiagnostic(
                            pc.CurrentFrameIndex,
                            DDGI_DECAL_CANDIDATE_LIMIT_COUNTER,
                            1u);
                        continue;
                    }

                    if (decalCandidateCount <
                        effectiveDecalCandidateLimit)
                    {
                        decalCandidates[decalCandidateCount++] = candidate;
                        AddRendererDiagnostic(
                            pc.CurrentFrameIndex,
                            DDGI_DECAL_RETAINED_COUNTER,
                            1u);
                    }
                    else
                    {
                        uint farthest = 0u;
                        for (uint decalIndex = 1u;
                             decalIndex < effectiveDecalCandidateLimit;
                             decalIndex++)
                        {
                            SimpleDdgiDecalCandidate retained =
                                decalCandidates[decalIndex];
                            SimpleDdgiDecalCandidate currentFarthest =
                                decalCandidates[farthest];
                            if (SimpleDdgiDecalIsFarther(
                                    retained,
                                    currentFarthest))
                                farthest = decalIndex;
                        }

                        SimpleDdgiDecalCandidate currentFarthest =
                            decalCandidates[farthest];
                        bool replace = SimpleDdgiDecalIsFarther(
                            currentFarthest,
                            candidate);
                        if (replace)
                            decalCandidates[farthest] = candidate;
                        AddRendererDiagnostic(
                            pc.CurrentFrameIndex,
                            DDGI_DECAL_CANDIDATE_LIMIT_COUNTER,
                            1u);
                    }
                    continue;
                }

                alphaCandidateCount++;
                if (alphaCandidateCount > DDGI_HIT_ALPHA_CANDIDATE_LIMIT)
                {
                    RecordDdgiAlphaCandidateLimitReached();
                    rayQueryConfirmIntersectionEXT(query);
                    rayQueryTerminateEXT(query);
                    break;
                }
                if (DdgiCandidatePassesOpacityPolicy(
                    instanceIndex,
                    primitiveIndex,
                    barycentrics,
                    candidateFrontFace,
                    false))
                    rayQueryConfirmIntersectionEXT(query);
            }
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT)
        {
            hitDistance = rayQueryGetIntersectionTEXT(query, true);
            bool frontFace = rayQueryGetIntersectionFrontFaceEXT(query, true);
            uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
            simpleDdgiCurrentReceiverInstanceIndex = instanceIndex;
            uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            simpleDdgiCurrentReceiverPrimitiveIndex = primitiveIndex;
            vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
            vec3 hitPosition = probePosition + direction * hitDistance;
            GPUDdgiRayQueryInstance hitInstance = ReadDdgiRayQueryInstance(instanceIndex);
            GPUMaterialData hitMaterial = ReadMaterial(hitInstance.MaterialIndex);
            bool hitDoubleSided = GiMaterialHasFlag(
                hitMaterial.TransportFlags,
                GI_MATERIAL_DOUBLE_SIDED);
            if (!frontFace && !hitDoubleSided)
            {
                hitKind = SIMPLE_DDGI_RAY_HIT_KIND_ONE_SIDED_BACK_FACE;
                radiance = vec3(0.0);
                traceSkyDiffuse = vec3(0.0);
                RecordSimpleDdgiOneSidedBackFaceDiagnostic(
                    params,
                    pc.CurrentFrameIndex,
                    update.volumeIndex);
                AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_TRACE_ONE_SIDED_BACKFACE_COUNT_COUNTER, 1u);
            }
            else
            {
            GiSurfaceSample surface;
            bool sampleMaterialTextures = ShouldSampleDdgiMaterialTextures(volumeCascade);
            if (ResolveCommittedHitSurface(
                instanceIndex,
                primitiveIndex,
                barycentrics,
                direction,
                frontFace,
                volumeCascade,
                sampleMaterialTextures,
                hitDistance,
                max(volume.spacing, 0.001),
                sourceRayAngularRadius,
                surface))
            {
                // Candidate traversal order is implementation-defined. Sort the
                // retained bounded set by the authored overlay order before
                // composition so capture/replay and vendors agree exactly.
                for (uint sortIndex = 0u;
                     sortIndex < decalCandidateCount;
                     sortIndex++)
                {
                    uint selected = sortIndex;
                    for (uint candidateIndex = sortIndex + 1u;
                         candidateIndex < decalCandidateCount;
                         candidateIndex++)
                    {
                        if (SimpleDdgiDecalComesBefore(
                                decalCandidates[candidateIndex],
                                decalCandidates[selected]))
                        {
                            selected = candidateIndex;
                        }
                    }
                    if (selected != sortIndex)
                    {
                        SimpleDdgiDecalCandidate temporary =
                            decalCandidates[sortIndex];
                        decalCandidates[sortIndex] =
                            decalCandidates[selected];
                        decalCandidates[selected] = temporary;
                    }
                }

                for (uint decalIndex = 0u;
                     decalIndex < decalCandidateCount;
                     decalIndex++)
                {
                    SimpleDdgiDecalCandidate decalCandidate =
                        decalCandidates[decalIndex];
                    GPUDdgiRayQueryInstance decalInstance =
                        ReadDdgiRayQueryInstance(
                            decalCandidate.InstanceIndex);
                    GiSurfaceSample decalSurface;
                    if (!ResolveCommittedHitSurface(
                            decalCandidate.InstanceIndex,
                            decalCandidate.PrimitiveIndex,
                            decalCandidate.Barycentrics,
                            direction,
                            decalCandidate.FrontFacing,
                            volumeCascade,
                            sampleMaterialTextures,
                            decalCandidate.Distance,
                            max(volume.spacing, 0.001),
                            sourceRayAngularRadius,
                            decalSurface))
                    {
                        AddRendererDiagnostic(
                            pc.CurrentFrameIndex,
                            DDGI_DECAL_FACING_REJECT_COUNTER,
                            1u);
                        continue;
                    }

                    // Depth bias/tolerance are authored in world-space normal
                    // distance. Ray t separation grows at grazing incidence,
                    // so project it onto the decal normal before association.
                    float projectedDepthSeparation =
                        (hitDistance - decalCandidate.Distance) *
                        abs(dot(
                            direction,
                            decalSurface.CanonicalGeometricNormal));
                    if (abs(
                            projectedDepthSeparation -
                            max(decalInstance.DecalDepthBias, 0.0)) >
                        max(decalInstance.DecalDepthTolerance, 0.0))
                    {
                        AddRendererDiagnostic(
                            pc.CurrentFrameIndex,
                            DDGI_DECAL_DEPTH_REJECT_COUNTER,
                            1u);
                        continue;
                    }
                    if (dot(
                            surface.CanonicalGeometricNormal,
                            decalSurface.CanonicalGeometricNormal) <= 0.1)
                    {
                        AddRendererDiagnostic(
                            pc.CurrentFrameIndex,
                            DDGI_DECAL_FACING_REJECT_COUNTER,
                            1u);
                        continue;
                    }

                    ApplyGiDecalOverlay(
                        surface,
                        decalSurface,
                        DdgiRayGeometryHasFlag(
                            decalInstance,
                            DDGI_RAY_GEOMETRY_FLAG_PREMULTIPLIED_ALPHA));
                    AddRendererDiagnostic(
                        pc.CurrentFrameIndex,
                        DDGI_DECAL_ASSOCIATED_COUNTER,
                        1u);
                }

                if ((params.flags & SIMPLE_DDGI_FLAG_THIN_SURFACE_TRANSMISSION) == 0u)
                {
                    surface.TransmittedDiffuseReflectance = vec3(0.0);
                    surface.Flags &= ~GI_MATERIAL_THIN_SURFACE_TRANSMISSION;
                }
                vec3 bounce = vec3(0.0);
                float bounceOwnership = 0.0;
                if (!transportV2)
                {
                    bounce = SampleSimpleDdgiUnifiedIrradiance(
                        params,
                        hitPosition + surface.GeometricNormal * max(0.03, volume.spacing * 0.02),
                        surface.ShadingNormal,
                        -direction,
                        true,
                        bounceOwnership);
                    bounce = ApplyGiMaterialOcclusion(
                        EvaluateGiDiffuseFromIrradiance(
                            bounce,
                            surface.DiffuseReflectance),
                        surface.MaterialOcclusion);
                }
                vec3 directNoShadowDiffuse;
                vec3 directDiffuse = EvaluateDirectDiffuseRadianceAtHit(
                    hitPosition,
                    surface,
                    -direction,
                    max(volume.spacing, 0.001),
                    directNoShadowDiffuse);
                vec3 emissiveProxyDiffuse = EvaluateSelectedDdgiEmissiveDiffuseRadianceAtHit(
                    hitPosition,
                    surface,
                    -direction,
                    max(volume.spacing, 0.001));
                // Direct emissive hits and next-event triangle sampling represent
                // different paths. Transport-atlas ownership only gates the
                // recursive irradiance term; applying it here biases the emitter
                // estimator and makes energy depend on cache residency.
                vec3 emissiveDiffuse = surface.EmissiveRadiance + emissiveProxyDiffuse;
                vec3 glossyBounce = EvaluateSimpleDdgiOneBounceGlossyRadiance(
                    params,
                    hitPosition,
                    surface,
                    -direction,
                    max(volume.spacing, 0.001));
                radiance = emissiveDiffuse + directDiffuse + bounce +
                    glossyBounce;
                traceDirectDiffuse = directDiffuse;
                traceDirectNoShadowDiffuse = directNoShadowDiffuse;
                traceEmissiveDiffuse = emissiveDiffuse;
                traceBounceDiffuse = bounce + glossyBounce;
                traceSkyDiffuse = vec3(0.0);
                cacheNormal = surface.CanonicalGeometricNormal;
                cacheAlbedo = surface.DiffuseReflectance;
                cacheTransmission = surface.TransmittedDiffuseReflectance;
                cacheSpecularF0 = surface.SpecularF0;
                cacheRoughness = surface.Roughness;
                traceSurfaceFlags = surface.Flags;
                float albedoLuminance = dot(
                    max(surface.DiffuseReflectance, vec3(0.0)),
                    vec3(0.2126, 0.7152, 0.0722));
                uint albedoCounter = DDGI_TRACE_OPAQUE_ALBEDO_LUMINANCE_COUNTER;
                uint albedoCountCounter = DDGI_TRACE_OPAQUE_COUNT_COUNTER;
                if (!GiMaterialHasFlag(surface.Flags, GI_MATERIAL_REFLECTS_INDIRECT_DIFFUSE))
                {
                    albedoCounter = DDGI_TRACE_REFLECT_DISABLED_ALBEDO_LUMINANCE_COUNTER;
                    albedoCountCounter = DDGI_TRACE_REFLECT_DISABLED_COUNT_COUNTER;
                }
                else if (GiMaterialHasFlag(surface.Flags, GI_MATERIAL_THIN_SURFACE_TRANSMISSION))
                {
                    albedoCounter = DDGI_TRACE_THIN_ALBEDO_LUMINANCE_COUNTER;
                    albedoCountCounter = DDGI_TRACE_THIN_COUNT_COUNTER;
                }
                else if (GiMaterialHasFlag(surface.Flags, GI_MATERIAL_TRANSMISSION_REMOVES_OPAQUE_DIFFUSE))
                {
                    albedoCounter = DDGI_TRACE_UNSUPPORTED_ALBEDO_LUMINANCE_COUNTER;
                    albedoCountCounter = DDGI_TRACE_UNSUPPORTED_COUNT_COUNTER;
                }
                AddRendererDiagnostic(
                    pc.CurrentFrameIndex,
                    albedoCounter,
                    uint(round(clamp(albedoLuminance, 0.0, 16.0) * 4096.0)));
                AddRendererDiagnostic(pc.CurrentFrameIndex, albedoCountCounter, 1u);
                cacheMaterialOcclusion = surface.MaterialOcclusion;
                if (dot(max(directDiffuse, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) > 0.0001)
                    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_DIRECT_LIGHT_HIT_COUNTER, 1u);
                if (dot(max(surface.EmissiveRadiance + emissiveProxyDiffuse, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) > 0.0001)
                    AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_EMISSIVE_HIT_COUNTER, 1u);
                hitKind = frontFace
                    ? SIMPLE_DDGI_RAY_HIT_KIND_FRONT_FACE
                    : SIMPLE_DDGI_RAY_HIT_KIND_BACK_FACE;
            }
            }
        }
    }

#endif

#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_SINGLE || \
    SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
    if (hitKind < 0.5 && farFieldEnabled && !completeRayScene &&
        (((pc.Flags & SIMPLE_DDGI_FLAG_FAR_FIELD_FORCE_ALL) != 0u) || farFieldOnlyRing || maxDistance > nearTlasMaxDistance))
    {
        AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_RAY_COUNTER, 1u);
        vec3 farNormal;
        vec3 farAlbedo;
        vec3 farEmission;
        float farMaterialOcclusion;
        bool farStepExhausted;
        uint farVisitedSteps;
        if (TraceFarFieldClipmapDetailed(probePosition, direction, nearTlasMaxDistance, maxDistance,
                hitDistance,
                farNormal,
                farAlbedo,
                farEmission,
                farMaterialOcclusion,
                farStepExhausted,
                farVisitedSteps))
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_HIT_COUNTER, 1u);
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_FAR_FIELD_HIT_COUNTER, 1u);
            if ((globalRay & (DDGI_MATERIAL_PROVENANCE_DIAGNOSTIC_SAMPLE_WEIGHT - 1u)) == 0u)
            {
                AddRendererDiagnostic(
                    pc.CurrentFrameIndex,
                    MATERIAL_GI_FAR_FIELD_TRANSPORT_HIT_COUNTER,
                    DDGI_MATERIAL_PROVENANCE_DIAGNOSTIC_SAMPLE_WEIGHT);
            }
            vec3 hitPosition = probePosition + direction * hitDistance;
            vec3 directNoShadowDiffuse;
            vec3 safeFarNormal = normalize(farNormal);
            GiSurfaceSample farSurface = EmptyGiSurfaceSample(
                safeFarNormal,
                safeFarNormal,
                GI_MATERIAL_REFLECTS_INDIRECT_DIFFUSE);
            // Far-field V2 stores the canonical hemispherical response but not
            // a directional-F0 profile. Preserve its explicitly approximate
            // Lambertian fallback instead of leaving the directional fields
            // zero and silently dropping direct illumination.
            farSurface.DiffuseReflectance = clamp(farAlbedo, vec3(0.0), vec3(1.0));
            farSurface.DirectionalDiffuseBase = farSurface.DiffuseReflectance;
            farSurface.DielectricF0 = vec3(0.0);
            farSurface.EmissiveRadiance = clamp(farEmission, vec3(0.0), vec3(65504.0));
            farSurface.MaterialOcclusion = clamp(farMaterialOcclusion, 0.0, 1.0);
            vec3 bounce = vec3(0.0);
            float bounceOwnership = 0.0;
            if (!transportV2)
            {
                bounce = SampleSimpleDdgiUnifiedIrradiance(
                    params,
                    hitPosition + safeFarNormal * max(0.03, volume.spacing * 0.02),
                    safeFarNormal,
                    -direction,
                    true,
                    bounceOwnership);
                bounce = ApplyGiMaterialOcclusion(
                    EvaluateGiDiffuseFromIrradiance(
                        bounce,
                        farSurface.DiffuseReflectance),
                    farSurface.MaterialOcclusion);
            }
            vec3 directDiffuse = EvaluateDirectDiffuseRadianceAtHit(
                hitPosition,
                farSurface,
                -direction,
                max(volume.spacing, 0.001),
                directNoShadowDiffuse);
            vec3 emissiveProxyDiffuse = EvaluateSelectedDdgiEmissiveDiffuseRadianceAtHit(
                hitPosition,
                farSurface,
                -direction,
                max(volume.spacing, 0.001));
            vec3 farEmissiveDiffuse = farSurface.EmissiveRadiance + emissiveProxyDiffuse;
            vec3 glossyBounce = EvaluateSimpleDdgiOneBounceGlossyRadiance(
                params,
                hitPosition,
                farSurface,
                -direction,
                max(volume.spacing, 0.001));
            radiance = directDiffuse + farEmissiveDiffuse + bounce +
                glossyBounce;
            traceDirectDiffuse = directDiffuse;
            traceDirectNoShadowDiffuse = directNoShadowDiffuse;
            traceEmissiveDiffuse = farEmissiveDiffuse;
            traceBounceDiffuse = bounce + glossyBounce;
            traceSkyDiffuse = vec3(0.0);
            cacheNormal = safeFarNormal;
            cacheAlbedo = farSurface.DiffuseReflectance;
            cacheSpecularF0 = farSurface.SpecularF0;
            cacheRoughness = farSurface.Roughness;
            cacheMaterialOcclusion = farSurface.MaterialOcclusion;
            hitKind = dot(direction, safeFarNormal) > 0.0
                ? SIMPLE_DDGI_RAY_HIT_KIND_FAR_FIELD_BACK_FACE
                : SIMPLE_DDGI_RAY_HIT_KIND_FRONT_FACE;
        }
        else if (farStepExhausted)
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, FAR_FIELD_STEP_EXHAUSTED_COUNTER, 1u);
        }

        if (hitKind < 0.5)
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_FAR_FIELD_MISS_COUNTER, 1u);

        uint stepBucket = farVisitedSteps <= 4u
            ? FAR_FIELD_STEP_BUCKET_0_COUNTER
            : (farVisitedSteps <= 8u
                ? FAR_FIELD_STEP_BUCKET_1_COUNTER
                : (farVisitedSteps <= 16u
                    ? FAR_FIELD_STEP_BUCKET_2_COUNTER
                    : (farVisitedSteps <= 32u
                        ? FAR_FIELD_STEP_BUCKET_3_COUNTER
                        : FAR_FIELD_STEP_BUCKET_4_COUNTER)));
        AddRendererDiagnostic(pc.CurrentFrameIndex, stepBucket, 1u);
    }
#endif

    bool recordTraceDiagnostics =
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
        !splitNearHit;
#else
        true;
#endif
    if (recordTraceDiagnostics)
    {
        if (hitKind >= 0.5)
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_HIT_COUNTER, 1u);
            if (dot(max(radiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) <= 0.0001)
            {
                AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_ZERO_RADIANCE_HIT_COUNTER, 1u);
                bool thinSurface = GiMaterialHasFlag(traceSurfaceFlags, GI_MATERIAL_THIN_SURFACE_TRANSMISSION);
                bool unsupportedTransmission = !thinSurface && GiMaterialHasFlag(
                    traceSurfaceFlags,
                    GI_MATERIAL_TRANSMISSION_REMOVES_OPAQUE_DIFFUSE);
                AddRendererDiagnostic(
                    pc.CurrentFrameIndex,
                    thinSurface
                        ? DDGI_THIN_ZERO_RADIANCE_THIN_COUNTER
                        : (unsupportedTransmission
                            ? DDGI_THIN_ZERO_RADIANCE_UNSUPPORTED_COUNTER
                            : DDGI_THIN_ZERO_RADIANCE_OPAQUE_COUNTER),
                    1u);
            }
            if (!GiMaterialHasFlag(traceSurfaceFlags, GI_MATERIAL_THIN_SURFACE_TRANSMISSION) &&
                GiMaterialHasFlag(traceSurfaceFlags, GI_MATERIAL_TRANSMISSION_REMOVES_OPAQUE_DIFFUSE))
            {
                AddRendererDiagnostic(
                    pc.CurrentFrameIndex,
                    DDGI_THIN_UNSUPPORTED_TRANSMISSION_HIT_COUNTER,
                    1u);
            }
        }
        else
        {
            AddRendererDiagnostic(pc.CurrentFrameIndex, DDGI_INVESTIGATION_SIMPLE_TRACE_MISS_COUNTER, 1u);
        }

        // In V2 these counters describe the traced source term, while transport
        // counters in the CPU diagnostic snapshot identify how much of the queue
        // reused that source for recursive solves. V1 retains the historical
        // source-plus-bounce trace accounting.
        RecordSimpleDdgiTraceEnergyDiagnostics(
            params,
            pc.CurrentFrameIndex,
            probeIndex,
            rayIndex,
            radiance,
            traceDirectDiffuse,
            traceDirectNoShadowDiffuse,
            traceEmissiveDiffuse,
            traceBounceDiffuse,
            traceSkyDiffuse,
            hitKind >= 0.5);
    }

    float visibilityDistance = hitDistance;
    float visibilityHitKind = hitKind;
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_SINGLE || \
    SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
    float backfaceVisibilityDistance;
    if (TraceSimpleDdgiBackfaceVisibilityDistance(
            probePosition,
            direction,
            nearTlasMaxDistance,
            backfaceVisibilityDistance))
    {
        if (backfaceVisibilityDistance < visibilityDistance)
        {
            visibilityDistance = backfaceVisibilityDistance;
            visibilityHitKind =
                SIMPLE_DDGI_RAY_HIT_KIND_ONE_SIDED_BACK_FACE;
        }
    }
#endif
    // A failed cached lookup may trace a safe scratch result for this frame,
    // but it is not a complete source transaction. Persisting that maintenance
    // subset would replace one cache entry with the wrong cardinality and
    // source identity, poisoning all later solves and the frozen audit.
    //
    // Persist the exact projection classification after the ordered backface
    // visibility query. This is the same hit kind written to scratch, consumed
    // by cached reuse, and reconstructed by the fixed-point audit.
    if (transportV2 && sourceRefresh)
    {
#if SIMPLE_DDGI_TRACE_SHADER_ROLE == SIMPLE_DDGI_TRACE_SHADER_ROLE_FINAL
        if (splitNearHit)
        {
            // SOURCE already published the complete near-hit payload. FINAL
            // owns the subsequent backface-only query and patches just its
            // exact classification before the transaction may commit.
            if (visibilityHitKind != hitKind)
            {
                UpdateSimpleDdgiTransportRayCacheHitKind(
                    pc.TransportSourceCacheBufferIndex,
                    update.cacheProbeBaseWordPlusOne &
                        SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                    directionRayIndex,
                    volume,
                    params,
                    sourceCacheProbeGeneration,
                    update.sourceEpoch,
                    visibilityHitKind);
            }
        }
        else
#endif
        {
            WriteSimpleDdgiTransportRayCache(
                pc.TransportSourceCacheBufferIndex,
                update.cacheProbeBaseWordPlusOne &
                    SIMPLE_DDGI_TRACE_CACHE_BASE_MASK,
                update.volumeIndex,
                update.physicalProbeIndex,
                directionRayIndex,
                volume,
                params,
                radiance,
                hitDistance,
                direction,
                cacheNormal,
                cacheAlbedo,
                cacheTransmission,
                cacheMaterialOcclusion,
                cacheSpecularF0,
                cacheRoughness,
                visibilityHitKind,
                sourceCacheProbeGeneration,
                update.sourceLightingGeneration,
                update.sourceEpoch,
                sourceRayCount);
        }
    }
    WriteSimpleRayResult(
        globalRay,
        params,
        volume,
        probeIndex,
        directionRayIndex,
        update.sourceEpoch,
        radiance,
        hitDistance,
        visibilityDistance,
        direction,
        visibilityHitKind);
#if SIMPLE_DDGI_TRACE_SHADER_ROLE != SIMPLE_DDGI_TRACE_SHADER_ROLE_SOURCE
    SimpleDdgiSchedulerRayComplete(
        pc.SchedulerArenaBufferIndex,
        pc.SchedulerOutcomesOffsetWords,
        update.outcomeIndex,
        activeRayCount,
        1u << 0u);
#endif
#endif
}

#undef AddRendererDiagnostic
