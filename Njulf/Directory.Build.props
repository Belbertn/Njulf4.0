<Project>
  <PropertyGroup>
    <Configurations>Debug;Release;ShippingPerformance;ProfileSymbols;DetailedInvestigation</Configurations>
    <!-- GpuMemoryAllocator.vma ships an unused macos-arm64 asset. Njulf does not target macOS. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>

    <!--
      Every project owns a checked-in NuGet dependency lock. Release and CI
      restores are fail-closed: dependency changes must first be reviewed and
      regenerated deliberately with a force-evaluated `dotnet restore`.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode
      Condition="'$(RestoreLockedMode)' == '' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ShippingPerformance' or '$(Configuration)' == 'ProfileSymbols' or '$(Configuration)' == 'DetailedInvestigation' or '$(ContinuousIntegrationBuild)' == 'true')">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ShippingPerformance' or '$(Configuration)' == 'ProfileSymbols' or '$(Configuration)' == 'DetailedInvestigation'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);TRACE;RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ShippingPerformance'">
    <DefineConstants>$(DefineConstants);NJULF_SHIPPING_PERFORMANCE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ProfileSymbols'">
    <DefineConstants>$(DefineConstants);NJULF_PROFILE_SYMBOLS</DefineConstants>
    <NjulfShaderDebugInformation>true</NjulfShaderDebugInformation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DetailedInvestigation'">
    <DefineConstants>$(DefineConstants);NJULF_DETAILED_INVESTIGATION</DefineConstants>
  </PropertyGroup>
</Project>
