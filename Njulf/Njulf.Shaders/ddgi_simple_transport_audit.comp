uint SimpleDdgiAuditWord(uint relativeWord)
{
    return pc.AuditSummaryBaseWord + relativeWord;
}

void SimpleDdgiAuditAtomicAdd(uint relativeWord, uint value)
{
    if (pc.AuditSummaryBufferIndex != 0u)
    {
        uint previous = atomicAdd(
            BindlessStorageBuffers[nonuniformEXT(pc.AuditSummaryBufferIndex)].Words[
                SimpleDdgiAuditWord(relativeWord)],
            value);
        if (value != 0u && previous > uint(0xffffffffu) - value)
        {
            atomicOr(
                BindlessStorageBuffers[nonuniformEXT(pc.AuditSummaryBufferIndex)].Words[
                    SimpleDdgiAuditWord(SIMPLE_DDGI_AUDIT_COUNTER_OVERFLOW_WORD)],
                1u);
        }
    }
}

void SimpleDdgiAuditAtomicMax(uint relativeWord, uint value)
{
    if (pc.AuditSummaryBufferIndex != 0u)
        atomicMax(BindlessStorageBuffers[nonuniformEXT(pc.AuditSummaryBufferIndex)].Words[
            SimpleDdgiAuditWord(relativeWord)], value);
}

void SimpleDdgiAuditRecordFirstIdentity(
    uint relativeWord,
    uint virtualProbeIndex,
    uint physicalProbeIndex)
{
    if (pc.AuditSummaryBufferIndex == 0u)
        return;
    uint virtualPlusOne = min(virtualProbeIndex + 1u, 0xffffu);
    uint physicalPlusOne = physicalProbeIndex == 0xffffffffu
        ? 0u
        : min(physicalProbeIndex + 1u, 0xffffu);
    uint packedIdentity = virtualPlusOne | (physicalPlusOne << 16u);
    atomicCompSwap(
        BindlessStorageBuffers[nonuniformEXT(pc.AuditSummaryBufferIndex)].Words[
            SimpleDdgiAuditWord(relativeWord)],
        0u,
        packedIdentity);
}

void SimpleDdgiAuditWrite(uint relativeWord, uint value)
{
    if (pc.AuditSummaryBufferIndex != 0u)
        WriteStorageWordUniform(
            pc.AuditSummaryBufferIndex,
            SimpleDdgiAuditWord(relativeWord),
            value);
}

uint SimpleDdgiAuditWorkspaceProbeWord(uint chunkProbeIndex)
{
    return pc.AuditWorkspaceBaseWord +
        chunkProbeIndex * SIMPLE_DDGI_AUDIT_WORKSPACE_WORDS_PER_PROBE;
}

uint SimpleDdgiAuditReadWorkspaceStatus(uint chunkProbeIndex)
{
    return ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        SimpleDdgiAuditWorkspaceProbeWord(chunkProbeIndex));
}

void SimpleDdgiAuditOrWorkspaceStatus(uint chunkProbeIndex, uint flags)
{
    atomicOr(
        BindlessStorageBuffers[nonuniformEXT(pc.SchedulerArenaBufferIndex)].Words[
            SimpleDdgiAuditWorkspaceProbeWord(chunkProbeIndex)],
        flags);
}

void SimpleDdgiAuditRecordCacheFailureMask(uint failureMask)
{
    if ((failureMask & SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY) != 0u)
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_CACHE_IDENTITY_FAILURE_WORD, 1u);
    if ((failureMask & SIMPLE_DDGI_AUDIT_CACHE_FAILURE_CARDINALITY) != 0u)
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_CACHE_CARDINALITY_FAILURE_WORD, 1u);
    if ((failureMask & SIMPLE_DDGI_AUDIT_CACHE_FAILURE_SOURCE_GENERATION) != 0u)
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_CACHE_SOURCE_GENERATION_FAILURE_WORD, 1u);
    if ((failureMask & SIMPLE_DDGI_AUDIT_CACHE_FAILURE_SOURCE_EPOCH) != 0u)
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_CACHE_SOURCE_EPOCH_FAILURE_WORD, 1u);
    if ((failureMask & SIMPLE_DDGI_AUDIT_CACHE_FAILURE_PHYSICAL_GENERATION) != 0u)
        SimpleDdgiAuditAtomicAdd(
            SIMPLE_DDGI_AUDIT_CACHE_PHYSICAL_GENERATION_FAILURE_WORD,
            1u);
}

uint SimpleDdgiAuditSchedulerFrame(uint relativeWord)
{
    return ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        pc.AuditSchedulerFrameOffsetWords + relativeWord);
}

// Return a conservative half-storage rounding interval for a non-negative
// finite canonical value. Positive half encodings are monotonically ordered,
// so adjacent encoded values provide the exact local spacing without a
// device-specific nextafter implementation. The maximum interval across the
// frozen field is reported separately from the fixed-point defect.
float SimpleDdgiAuditHalfQuantizationFloor(float value)
{
    if (isnan(value) || isinf(value) || value < 0.0)
        return 0.0;

    uint bits = packHalf2x16(vec2(value, 0.0)) & 0xffffu;
    uint previousBits = bits > 0u ? bits - 1u : 0u;
    float previous = unpackHalf2x16(previousBits).x;
    float next = value;
    if (bits < 0x7bffu)
        next = unpackHalf2x16(bits + 1u).x;

    return 0.5 * max(max(value - previous, 0.0), max(next - value, 0.0));
}

bool SimpleDdgiAuditGenerationsMatch(SimpleDdgiParams params)
{
    // The params and scheduler frame are the GPU-resident witnesses for the
    // CPU-frozen generation tuple.  The remaining solve/audit/canonical
    // generations are carried as non-zero push constants and are checked by
    // the delayed CPU acceptance path; they have no mutable shader-side field.
    bool pushGenerationsValid =
        pc.AuditVolumeTableGeneration != 0u &&
        pc.AuditPhysicalOwnershipGeneration != 0u &&
        pc.AuditSourceLightingGeneration != 0u &&
        pc.AuditSourceEpochGeneration != 0u &&
        pc.AuditTransportOperatorGeneration != 0u &&
        pc.AuditCanonicalFieldGeneration != 0u &&
        pc.AuditSolveGeneration != 0u &&
        pc.AuditEpochGeneration != 0u &&
        pc.AuditQueueGeneration != 0u &&
        pc.AuditSchedulerResourceGeneration != 0u;
    if (!pushGenerationsValid || pc.SchedulerArenaBufferIndex == 0u)
        return false;

    return params.transportGeneration == pc.TransportGeneration &&
        SimpleDdgiAuditSchedulerFrame(14u) == pc.AuditVolumeTableGeneration &&
        SimpleDdgiAuditSchedulerFrame(15u) == pc.AuditSchedulerResourceGeneration &&
        SimpleDdgiAuditSchedulerFrame(16u) == pc.AuditQueueGeneration &&
        SimpleDdgiAuditSchedulerFrame(17u) == pc.AuditSourceLightingGeneration &&
        SimpleDdgiAuditSchedulerFrame(18u) == pc.TransportGeneration &&
        pc.AuditSchedulerProbeStateOffsetWords != 0u &&
        pc.AuditSolveEpoch != 0u &&
        SimpleDdgiAuditSchedulerFrame(19u) == pc.AuditSolveEpoch;
}

vec3 SimpleDdgiAuditTexelDirection(uint texel, uint texelsPerProbe)
{
    uint x = texel % texelsPerProbe;
    uint y = texel / texelsPerProbe;
    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(texelsPerProbe);
    return SimpleDdgiOctDecode(uv);
}

#if SIMPLE_DDGI_AUDIT_SHADER_ROLE == SIMPLE_DDGI_AUDIT_SHADER_ROLE_REDUCE
bool SimpleDdgiTransportFinite(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}
#endif

struct SimpleDdgiAuditProbeContext
{
    SimpleDdgiProbeState state;
    SimpleDdgiVolume volume;
    uint localProbeIndex;
    uint volumeIndex;
    uint physicalProbeIndex;
    uint sourceEpoch;
    uint sourceRayCount;
    uint cacheProbeBaseWordPlusOne;
};

#if SIMPLE_DDGI_AUDIT_SHADER_ROLE != SIMPLE_DDGI_AUDIT_SHADER_ROLE_RAYS
uint ResolveSimpleDdgiAuditProbe(
    SimpleDdgiParams params,
    uint probeIndex,
    out SimpleDdgiAuditProbeContext context,
    out uint failureMask,
    out bool participantEligible)
{
    failureMask = 0u;
    participantEligible = false;
    context.localProbeIndex = 0u;
    context.volumeIndex = 0xffffffffu;
    context.physicalProbeIndex = 0xffffffffu;
    context.sourceEpoch = 0u;
    context.sourceRayCount = 0u;
    context.cacheProbeBaseWordPlusOne = 0u;
    context.state = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, probeIndex);
    if (isnan(context.state.activeWeight) || isinf(context.state.activeWeight))
        return SIMPLE_DDGI_AUDIT_STATUS_NONFINITE;
    if (!ResolveSimpleDdgiProbeVolume(
            probeIndex,
            params,
            context.volume,
            context.localProbeIndex))
    {
        return SIMPLE_DDGI_AUDIT_STATUS_NONFINITE;
    }
    for (uint volumeIndex = 0u;
         volumeIndex < params.volumeCount;
         volumeIndex++)
    {
        SimpleDdgiVolume candidate = ReadSimpleDdgiVolume(
            pc.ParamsBufferIndex,
            volumeIndex);
        if (candidate.firstProbeIndex == context.volume.firstProbeIndex)
            context.volumeIndex = volumeIndex;
    }
    if (context.volumeIndex == 0xffffffffu)
        return SIMPLE_DDGI_AUDIT_STATUS_NONFINITE;

    SimpleDdgiVolumePaging paging = ReadSimpleDdgiVolumePaging(
        pc.ParamsBufferIndex,
        context.volumeIndex);
    SimpleDdgiProbeAddress address = ResolveSimpleDdgiProbeAddress(
        params,
        context.volume,
        paging,
        SimpleDdgiProbeCoord(context.localProbeIndex, context.volume));
    uint schedulerStateBase = pc.AuditSchedulerProbeStateOffsetWords +
        probeIndex * SIMPLE_DDGI_SCHEDULER_PROBE_STATE_WORDS;
    uint sourceLightingGeneration = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 2u);
    context.sourceEpoch = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 3u);
    uint volumeGeneration = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 4u);
    uint schedulerMetadata = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 5u);
    uint packedLifecycle = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 7u);
    uint solveEpoch = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 9u);
    context.cacheProbeBaseWordPlusOne = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 10u);
    context.physicalProbeIndex = address.physicalProbeIndex;
    uint requiredSourceRayCount = SimpleDdgiRequiredSourceRayCount(
        params,
        context.volume);
    context.sourceRayCount = packedLifecycle & 0x1ffu;

    bool eligible = SimpleDdgiTransportParticipantEligible(
        true,
        address.resident,
        address.published,
        context.state.classification,
        context.state.flags,
        context.state.activeWeight,
        context.sourceRayCount,
        requiredSourceRayCount,
        sourceLightingGeneration,
        pc.AuditSourceLightingGeneration,
        context.sourceEpoch,
        volumeGeneration,
        pc.AuditVolumeTableGeneration,
        schedulerMetadata,
        context.cacheProbeBaseWordPlusOne);
    participantEligible = eligible;
    if (!eligible)
    {
        if (context.state.classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE ||
            (context.state.flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ||
            context.state.activeWeight <= 0.001)
        {
            return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE;
        }
        if (!address.resident || !address.published)
            return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE;
        if (sourceLightingGeneration != pc.AuditSourceLightingGeneration ||
            context.sourceEpoch == 0u ||
            volumeGeneration != pc.AuditVolumeTableGeneration)
        {
            return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE;
        }
        failureMask = context.sourceRayCount != requiredSourceRayCount ||
            requiredSourceRayCount == 0u ||
            requiredSourceRayCount > params.raysPerProbe
                ? SIMPLE_DDGI_AUDIT_CACHE_FAILURE_CARDINALITY
                : SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY;
        return SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE;
    }
    if (requiredSourceRayCount > params.raysPerProbe)
    {
        failureMask = SIMPLE_DDGI_AUDIT_CACHE_FAILURE_CARDINALITY;
        return SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE;
    }
    if (solveEpoch != pc.AuditSolveEpoch)
        return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE;

    return SIMPLE_DDGI_AUDIT_STATUS_VALID;
}
#endif

#if SIMPLE_DDGI_AUDIT_SHADER_ROLE == SIMPLE_DDGI_AUDIT_SHADER_ROLE_RAYS
uint ResolveSimpleDdgiAuditRayProbe(
    SimpleDdgiParams params,
    uint probeIndex,
    out SimpleDdgiAuditProbeContext context,
    out uint failureMask)
{
    failureMask = 0u;
    context.localProbeIndex = 0u;
    context.volumeIndex = 0xffffffffu;
    context.physicalProbeIndex = 0xffffffffu;
    context.sourceEpoch = 0u;
    context.sourceRayCount = 0u;
    context.cacheProbeBaseWordPlusOne = 0u;
    context.state = ReadSimpleDdgiProbeState(
        pc.ProbeStateBufferIndex,
        probeIndex);
    if (isnan(context.state.activeWeight) ||
        isinf(context.state.activeWeight))
    {
        return SIMPLE_DDGI_AUDIT_STATUS_NONFINITE;
    }
    if (context.state.classification == SIMPLE_DDGI_CLASSIFICATION_INACTIVE ||
        (context.state.flags & SIMPLE_DDGI_PROBE_FLAG_INACTIVE) != 0u ||
        context.state.activeWeight <= 0.001)
    {
        return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE;
    }
    uint schedulerStateBase = pc.AuditSchedulerProbeStateOffsetWords +
        probeIndex * SIMPLE_DDGI_SCHEDULER_PROBE_STATE_WORDS;
    uint sourceLightingGeneration = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 2u);
    context.sourceEpoch = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 3u);
    uint volumeGeneration = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 4u);
    uint schedulerMetadata = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 5u);
    uint packedLifecycle = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 7u);
    uint solveEpoch = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 9u);
    context.cacheProbeBaseWordPlusOne = ReadStorageWordUniform(
        pc.SchedulerArenaBufferIndex,
        schedulerStateBase + 10u);
    if (!ResolveSimpleDdgiProbeVolume(
            probeIndex,
            params,
            context.volume,
            context.localProbeIndex))
    {
        return SIMPLE_DDGI_AUDIT_STATUS_NONFINITE;
    }
    uint requiredSourceRayCount = SimpleDdgiRequiredSourceRayCount(
        params,
        context.volume);
    context.sourceRayCount = packedLifecycle & 0x1ffu;
    bool addressAvailable = context.cacheProbeBaseWordPlusOne != 0u;
    bool eligible = SimpleDdgiTransportParticipantEligible(
        true,
        addressAvailable,
        addressAvailable,
        context.state.classification,
        context.state.flags,
        context.state.activeWeight,
        context.sourceRayCount,
        requiredSourceRayCount,
        sourceLightingGeneration,
        pc.AuditSourceLightingGeneration,
        context.sourceEpoch,
        volumeGeneration,
        pc.AuditVolumeTableGeneration,
        schedulerMetadata,
        context.cacheProbeBaseWordPlusOne);
    if (!eligible)
    {
        if (!addressAvailable)
            return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE;
        if (sourceLightingGeneration != pc.AuditSourceLightingGeneration ||
            context.sourceEpoch == 0u ||
            volumeGeneration != pc.AuditVolumeTableGeneration)
        {
            return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE;
        }
        failureMask = context.sourceRayCount != requiredSourceRayCount ||
            requiredSourceRayCount == 0u ||
            requiredSourceRayCount > params.raysPerProbe
                ? SIMPLE_DDGI_AUDIT_CACHE_FAILURE_CARDINALITY
                : SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY;
        return SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE;
    }
    if (requiredSourceRayCount > params.raysPerProbe)
    {
        failureMask = SIMPLE_DDGI_AUDIT_CACHE_FAILURE_CARDINALITY;
        return SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE;
    }
    if (solveEpoch != pc.AuditSolveEpoch)
        return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE;
    return SIMPLE_DDGI_AUDIT_STATUS_VALID;
}
#endif

void SimpleDdgiAuditRecordStatus(
    uint status,
    uint failureMask,
    uint virtualProbeIndex,
    uint physicalProbeIndex)
{
    if (status == SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE)
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_EXCLUDED_INACTIVE_WORD, 1u);
    else if (status == SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE)
    {
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_EXCLUDED_NOT_VISIBLE_WORD, 1u);
        SimpleDdgiAuditRecordFirstIdentity(
            SIMPLE_DDGI_AUDIT_FIRST_NOT_RESIDENT_IDENTITY_WORD,
            virtualProbeIndex,
            physicalProbeIndex);
    }
    else if (status == SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE)
    {
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_EXCLUDED_STALE_SOURCE_WORD, 1u);
        SimpleDdgiAuditRecordFirstIdentity(
            SIMPLE_DDGI_AUDIT_FIRST_STALE_SOURCE_IDENTITY_WORD,
            virtualProbeIndex,
            physicalProbeIndex);
    }
    else if (status == SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE)
    {
        SimpleDdgiAuditRecordCacheFailureMask(failureMask);
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_INVALID_CACHE_WORD, 1u);
        SimpleDdgiAuditRecordFirstIdentity(
            SIMPLE_DDGI_AUDIT_FIRST_INVALID_CACHE_IDENTITY_WORD,
            virtualProbeIndex,
            physicalProbeIndex);
    }
    else
    {
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_NONFINITE_WORD, 1u);
        SimpleDdgiAuditRecordFirstIdentity(
            SIMPLE_DDGI_AUDIT_FIRST_NONFINITE_IDENTITY_WORD,
            virtualProbeIndex,
            physicalProbeIndex);
    }
}

uint SimpleDdgiAuditWorkspaceFlagsForStatus(uint status, uint failureMask)
{
    if (status == SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE)
        return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE_FLAG;
    if (status == SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE)
        return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE_FLAG;
    if (status == SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE)
        return SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE_FLAG;
    if (status == SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE)
    {
        uint resolvedFailureMask = failureMask != 0u
            ? failureMask
            : SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY;
        return (resolvedFailureMask & SIMPLE_DDGI_AUDIT_STATUS_FAILURE_MASK) <<
            SIMPLE_DDGI_AUDIT_STATUS_FAILURE_SHIFT;
    }
    return SIMPLE_DDGI_AUDIT_STATUS_CONTEXT_NONFINITE_FLAG;
}

#if SIMPLE_DDGI_AUDIT_SHADER_ROLE == SIMPLE_DDGI_AUDIT_SHADER_ROLE_RAYS
void SimpleDdgiAuditRunRayPhase()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint raysPerDispatchProbe = pc.DispatchRaysPerProbe;
    if (raysPerDispatchProbe == 0u ||
        raysPerDispatchProbe != params.raysPerProbe ||
        pc.SchedulerArenaBufferIndex == 0u ||
        pc.RayResultScratchBufferIndex == 0u)
    {
        return;
    }

    uint dispatchRay = gl_GlobalInvocationID.x;
    uint dispatchRayCount = pc.DispatchProbeCount * raysPerDispatchProbe;
    if (dispatchRay >= dispatchRayCount)
        return;
    uint chunkProbeIndex = dispatchRay / raysPerDispatchProbe;
    uint ray = dispatchRay % raysPerDispatchProbe;
    uint probeIndex = pc.AuditProbeOffset + chunkProbeIndex;
    if (chunkProbeIndex >= SIMPLE_DDGI_AUDIT_WORKSPACE_PROBE_CAPACITY ||
        probeIndex >= pc.AuditProbeCount || probeIndex >= params.probeCount)
    {
        return;
    }
    if (!SimpleDdgiAuditGenerationsMatch(params))
    {
        if (ray == 0u)
            SimpleDdgiAuditOrWorkspaceStatus(
                chunkProbeIndex,
                SIMPLE_DDGI_AUDIT_STATUS_CONTEXT_NONFINITE_FLAG);
        return;
    }

    SimpleDdgiAuditProbeContext context;
    uint contextFailureMask;
    uint contextStatus = ResolveSimpleDdgiAuditRayProbe(
        params,
        probeIndex,
        context,
        contextFailureMask);
    if (contextStatus != SIMPLE_DDGI_AUDIT_STATUS_VALID)
    {
        if (ray == 0u)
            SimpleDdgiAuditOrWorkspaceStatus(
                chunkProbeIndex,
                SimpleDdgiAuditWorkspaceFlagsForStatus(
                    contextStatus,
                    contextFailureMask));
        return;
    }
    if (ray >= context.sourceRayCount)
        return;

    SimpleDdgiParams auditParams = params;
    auditParams.publishedIrradianceAtlasBufferIndex =
        pc.TransportReadIrradianceAtlasBufferIndex;
    auditParams.transportSourceCacheBufferIndex =
        pc.TransportSourceCacheBufferIndex;
    uint directionRayIndex = SimpleDdgiUpdateDirectionRayIndex(
        ray,
        context.sourceRayCount,
        context.sourceRayCount,
        auditParams);

    uint sourceBase;
    uint sourceFormat;
    bool addressValid = TryResolveSimpleDdgiTransportCacheAddressFromProbeBase(
        context.cacheProbeBaseWordPlusOne,
        directionRayIndex,
        auditParams.raysPerProbe,
        context.volume.cacheStrideWords,
        context.volume.cacheLayoutFlags,
        sourceBase,
        sourceFormat);
    uint sourceStride = SimpleDdgiStorageExpectedStride(sourceFormat);
    uint generationAndFlags = addressValid && sourceStride != 0u
        ? ReadStorageWordUniform(
            auditParams.transportSourceCacheBufferIndex,
            SimpleDdgiStorageGenerationWord(
                sourceBase,
                sourceFormat,
                context.volume.cacheLayoutFlags))
        : 0u;
    uint failureMask = !addressValid || sourceStride == 0u ||
            !SimpleDdgiTransportCacheHitKindIsValid(generationAndFlags)
        ? SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY
        : 0u;
    if (addressValid && sourceStride != 0u &&
        (generationAndFlags & SIMPLE_DDGI_TRANSPORT_CACHE_GENERATION_MASK) !=
            (SimpleDdgiProbeGeneration(context.state) &
                SIMPLE_DDGI_TRANSPORT_CACHE_GENERATION_MASK))
    {
        failureMask |= SIMPLE_DDGI_AUDIT_CACHE_FAILURE_PHYSICAL_GENERATION;
    }
    uint cachedEpoch = (generationAndFlags &
        SIMPLE_DDGI_TRANSPORT_CACHE_DIRECTION_EPOCH_MASK) >>
            SIMPLE_DDGI_TRANSPORT_CACHE_DIRECTION_EPOCH_SHIFT;
    if (addressValid && sourceStride != 0u &&
        cachedEpoch != SimpleDdgiDirectionEpoch(context.sourceEpoch))
    {
        failureMask |= SIMPLE_DDGI_AUDIT_CACHE_FAILURE_SOURCE_EPOCH;
    }

    SimpleDdgiTransportRayCache source;
    uint diagnosticFrameIndex =
        SimpleDdgiStorageDiagnosticFrame(auditParams);
#if SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_PACKED
    bool sourceValid = ReadSimpleDdgiPackedTransportRayCacheForSolve(
        auditParams.transportSourceCacheBufferIndex,
        context.cacheProbeBaseWordPlusOne,
        probeIndex,
        directionRayIndex,
        context.volume,
        auditParams,
        SimpleDdgiProbeGeneration(context.state),
        pc.AuditSourceLightingGeneration,
        context.sourceEpoch,
        context.sourceRayCount,
        source);
#elif SIMPLE_DDGI_STORAGE_SHADER_MODE == SIMPLE_DDGI_STORAGE_SHADER_MODE_LEGACY
    bool sourceValid = ReadSimpleDdgiLegacyTransportRayCacheForSolve(
            auditParams.transportSourceCacheBufferIndex,
            context.cacheProbeBaseWordPlusOne,
            probeIndex,
            directionRayIndex,
            context.volume,
            auditParams,
            SimpleDdgiProbeGeneration(context.state),
            pc.AuditSourceLightingGeneration,
            context.sourceEpoch,
            context.sourceRayCount,
            source);
#else
    bool sourceValid = sourceFormat == SIMPLE_DDGI_CACHE_FORMAT_LEGACY_36
        ? ReadSimpleDdgiLegacyTransportRayCacheForSolve(
            auditParams.transportSourceCacheBufferIndex,
            context.cacheProbeBaseWordPlusOne,
            probeIndex,
            directionRayIndex,
            context.volume,
            auditParams,
            SimpleDdgiProbeGeneration(context.state),
            pc.AuditSourceLightingGeneration,
            context.sourceEpoch,
            context.sourceRayCount,
            source)
        : ReadSimpleDdgiPackedTransportRayCacheForSolve(
            auditParams.transportSourceCacheBufferIndex,
            context.cacheProbeBaseWordPlusOne,
            probeIndex,
            directionRayIndex,
            context.volume,
            auditParams,
            SimpleDdgiProbeGeneration(context.state),
            pc.AuditSourceLightingGeneration,
            context.sourceEpoch,
            context.sourceRayCount,
            source);
#endif
    if (!sourceValid)
        failureMask |= SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY;
    if (failureMask != 0u)
    {
        SimpleDdgiAuditOrWorkspaceStatus(
            chunkProbeIndex,
            (failureMask & SIMPLE_DDGI_AUDIT_STATUS_FAILURE_MASK) <<
                SIMPLE_DDGI_AUDIT_STATUS_FAILURE_SHIFT);
        return;
    }

#if SIMPLE_DDGI_DIRECTION_VALIDATION
    // Audit reuses the same successful consumer-boundary comparison as trace
    // and transport. The cache decoder stays side-effect free so each consumed
    // ray contributes at most one sample per pass.
    RecordSimpleDdgiDirectionComparison(
        auditParams,
        diagnosticFrameIndex,
        probeIndex,
        directionRayIndex,
        source.direction,
        SimpleDdgiReconstructRayDirection(
            probeIndex,
            directionRayIndex,
            source.sourceEpoch,
            auditParams));
#endif

    vec3 reflectedBounce;
    vec3 transmittedBounce;
    uint gatherCount;
    float ownershipSum;
    float fallbackWeightSum;
    bool malformedOperatorInput;
    float enforcedThroughput;
    vec3 bounce = EvaluateSimpleDdgiCachedRecursiveBounce(
        auditParams,
        context.volume,
        context.localProbeIndex,
        context.state,
        source,
        reflectedBounce,
        transmittedBounce,
        gatherCount,
        ownershipSum,
        fallbackWeightSum,
        malformedOperatorInput,
        enforcedThroughput);
    if (!malformedOperatorInput &&
        !isnan(enforcedThroughput) && !isinf(enforcedThroughput) &&
        enforcedThroughput >= 0.0)
    {
        SimpleDdgiAuditAtomicMax(
            SIMPLE_DDGI_AUDIT_OBSERVED_CONTRACTION_WORD,
            floatBitsToUint(enforcedThroughput));
    }

    vec3 radiance = source.sourceRadiance + bounce;
    if (malformedOperatorInput ||
        !SimpleDdgiTransportFinite(radiance) ||
        any(lessThan(radiance, vec3(0.0))))
    {
        SimpleDdgiAuditOrWorkspaceStatus(
            chunkProbeIndex,
            SIMPLE_DDGI_AUDIT_STATUS_RAY_NONFINITE);
        return;
    }
    radiance = SimpleDdgiClampTransportRadiance(radiance);
    if (!SimpleDdgiTransportFinite(radiance))
    {
        SimpleDdgiAuditOrWorkspaceStatus(
            chunkProbeIndex,
            SIMPLE_DDGI_AUDIT_STATUS_RAY_NONFINITE);
        return;
    }

    WriteSimpleDdgiRayResultStorage(
        pc.RayResultScratchBufferIndex,
        chunkProbeIndex * auditParams.raysPerProbe + ray,
        context.volume,
        auditParams,
        probeIndex,
        directionRayIndex,
        context.sourceEpoch,
        radiance,
        source.distance,
        source.distance,
        source.direction,
        SimpleDdgiTransportRayCacheHitKind(source));
}
#endif

#if SIMPLE_DDGI_AUDIT_SHADER_ROLE == SIMPLE_DDGI_AUDIT_SHADER_ROLE_REDUCE
void SimpleDdgiAuditRunReducePhase()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint localTexel = gl_LocalInvocationID.x;
    uint chunkProbeIndex = gl_WorkGroupID.x;
    uint probeIndex = pc.AuditProbeOffset + chunkProbeIndex;
    if (chunkProbeIndex >= pc.DispatchProbeCount ||
        probeIndex >= pc.AuditProbeCount || probeIndex >= params.probeCount ||
        pc.RayResultScratchBufferIndex == 0u)
    {
        return;
    }
    if (!SimpleDdgiAuditGenerationsMatch(params))
    {
        if (localTexel == 0u)
        {
            SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_NONFINITE_WORD, 1u);
            SimpleDdgiAuditRecordFirstIdentity(
                SIMPLE_DDGI_AUDIT_FIRST_NONFINITE_IDENTITY_WORD,
                probeIndex,
                0xffffffffu);
        }
        return;
    }
    if (localTexel == 0u)
    {
        SimpleDdgiAuditAtomicMax(
            SIMPLE_DDGI_AUDIT_CHUNK_WORD,
            pc.AuditChunkIndex);
    }

    SimpleDdgiAuditProbeContext context;
    uint contextFailureMask;
    bool participantEligible;
    uint currentStatus = ResolveSimpleDdgiAuditProbe(
        params,
        probeIndex,
        context,
        contextFailureMask,
        participantEligible);
    if (localTexel == 0u && participantEligible)
    {
        SimpleDdgiAuditAtomicAdd(
            SIMPLE_DDGI_AUDIT_EXPECTED_PARTICIPANT_WORD,
            1u);
        SimpleDdgiAuditAtomicAdd(
            SIMPLE_DDGI_AUDIT_EXPECTED_TEXEL_WORD,
            params.irradianceTexels * params.irradianceTexels);
    }
    if (currentStatus != SIMPLE_DDGI_AUDIT_STATUS_VALID)
    {
        if (localTexel == 0u)
            SimpleDdgiAuditRecordStatus(
                currentStatus,
                contextFailureMask,
                probeIndex,
                context.physicalProbeIndex);
        return;
    }

    // The lean ray role intentionally avoids the sparse page-table resolver so
    // it remains below the NVIDIA compiler's practical complexity boundary.
    // Consequently, a virtual probe with no persisted cache base is marked
    // excluded-not-visible by that role. Resolve current publication first here
    // so inactive, stale, or unpublished reasons remain authoritative; any
    // independent cache failure on a published participant remains fail-closed.
    uint packedStatus = SimpleDdgiAuditReadWorkspaceStatus(chunkProbeIndex);
    uint status = SIMPLE_DDGI_AUDIT_STATUS_VALID;
    uint failureMask = (packedStatus >>
        SIMPLE_DDGI_AUDIT_STATUS_FAILURE_SHIFT) &
            SIMPLE_DDGI_AUDIT_STATUS_FAILURE_MASK;
    if (failureMask != 0u)
        status = SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE;
    else if ((packedStatus & (SIMPLE_DDGI_AUDIT_STATUS_CONTEXT_NONFINITE_FLAG |
            SIMPLE_DDGI_AUDIT_STATUS_RAY_NONFINITE)) != 0u)
        status = SIMPLE_DDGI_AUDIT_STATUS_NONFINITE;
    else if ((packedStatus &
            SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE_FLAG) != 0u)
        status = SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_STALE_SOURCE;
    else if ((packedStatus &
            SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE_FLAG) != 0u)
        status = SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_NOT_VISIBLE;
    else if ((packedStatus &
            SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE_FLAG) != 0u)
        status = SIMPLE_DDGI_AUDIT_STATUS_EXCLUDED_INACTIVE;
    if (status != SIMPLE_DDGI_AUDIT_STATUS_VALID)
    {
        if (localTexel == 0u)
            SimpleDdgiAuditRecordStatus(
                status,
                failureMask,
                probeIndex,
                context.physicalProbeIndex);
        return;
    }

    if (localTexel == 0u)
        SharedAuditScratchInvalid = 0u;
    barrier();
    for (uint ray = localTexel;
         ray < context.sourceRayCount;
         ray += gl_WorkGroupSize.x)
    {
        uint directionRayIndex = SimpleDdgiUpdateDirectionRayIndex(
            ray,
            context.sourceRayCount,
            context.sourceRayCount,
            params);
        vec4 radianceDistance;
        vec3 direction;
        vec2 visibilityHit;
        uint directionEpoch;
        bool valid = ReadSimpleDdgiRayResultStorage(
            pc.RayResultScratchBufferIndex,
            chunkProbeIndex * params.raysPerProbe + ray,
            context.volume,
            params,
            probeIndex,
            directionRayIndex,
            context.sourceEpoch,
            radianceDistance,
            direction,
            visibilityHit,
            directionEpoch);
        SharedAuditRadiance[ray] = valid
            ? radianceDistance.rgb
            : vec3(0.0);
        SharedAuditDirection[ray] = valid
            ? normalize(direction)
            : vec3(0.0, 1.0, 0.0);
        SharedAuditBackface[ray] = valid &&
                SimpleDdgiRayHitKindIsOneSidedBackFace(visibilityHit.y)
            ? 1u
            : 0u;
        SharedAuditValid[ray] = valid ? 1u : 0u;
        if (!valid)
            atomicOr(SharedAuditScratchInvalid, 1u);
    }
    barrier();
    if (SharedAuditScratchInvalid != 0u)
    {
        if (localTexel == 0u)
            SimpleDdgiAuditRecordStatus(
                SIMPLE_DDGI_AUDIT_STATUS_INVALID_CACHE,
                SIMPLE_DDGI_AUDIT_CACHE_FAILURE_IDENTITY,
                probeIndex,
                context.physicalProbeIndex);
        return;
    }

    uint texelCount = min(
        params.irradianceTexels * params.irradianceTexels,
        gl_WorkGroupSize.x);
    if (localTexel >= texelCount)
        return;
    vec3 texelDirection = SimpleDdgiAuditTexelDirection(
        localTexel,
        params.irradianceTexels);
    vec3 accumulated = vec3(0.0);
    float weightSum = 0.0;
    for (uint ray = 0u; ray < context.sourceRayCount; ray++)
    {
        if (SharedAuditValid[ray] == 0u ||
            SharedAuditBackface[ray] != 0u)
        {
            continue;
        }
        float weight = SimpleDdgiPositiveCosineWeight(
            texelDirection,
            SharedAuditDirection[ray]);
        accumulated += SharedAuditRadiance[ray] * weight;
        weightSum += weight;
    }
    if (!SimpleDdgiTransportFinite(accumulated) ||
        isnan(weightSum) || isinf(weightSum))
    {
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_NONFINITE_WORD, 1u);
        SimpleDdgiAuditRecordFirstIdentity(
            SIMPLE_DDGI_AUDIT_FIRST_NONFINITE_IDENTITY_WORD,
            probeIndex,
            context.physicalProbeIndex);
        return;
    }
    vec3 candidate = SimpleDdgiEvaluatePositiveIrradiance(
        accumulated,
        weightSum);
    vec3 canonical = ReadSimpleDdgiIrradianceTexel(
        pc.TransportReadIrradianceAtlasBufferIndex,
        context.physicalProbeIndex,
        localTexel,
        params.irradianceTexels).rgb;
    if (!SimpleDdgiTransportFinite(candidate) ||
        !SimpleDdgiTransportFinite(canonical) ||
        any(lessThan(candidate, vec3(0.0))) ||
        any(lessThan(canonical, vec3(0.0))))
    {
        SimpleDdgiAuditAtomicAdd(SIMPLE_DDGI_AUDIT_NONFINITE_WORD, 1u);
        SimpleDdgiAuditRecordFirstIdentity(
            SIMPLE_DDGI_AUDIT_FIRST_NONFINITE_IDENTITY_WORD,
            probeIndex,
            context.physicalProbeIndex);
        return;
    }

    // Re-evaluate the prior audit's maximum-defect witness exactly. Selection
    // is host-frozen for this audit, so precisely one invocation writes these
    // words and VALID is the final publication store. This avoids coupling a
    // multiword diagnostic payload to racing global maximum atomics.
    if (probeIndex == pc.AuditWitnessProbeIndex &&
        localTexel == pc.AuditWitnessTexelIndex)
    {
        vec3 privateTarget = ReadSimpleDdgiIrradianceTexel(
            params.transportTargetIrradianceAtlasBufferIndex,
            context.physicalProbeIndex,
            localTexel,
            params.irradianceTexels).rgb;
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PROBE_WORD,
            probeIndex);
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_TEXEL_WORD,
            localTexel);
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_WEIGHT_WORD,
            floatBitsToUint(max(weightSum, 0.0)));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANDIDATE_R_WORD,
            floatBitsToUint(candidate.r));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANDIDATE_G_WORD,
            floatBitsToUint(candidate.g));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANDIDATE_B_WORD,
            floatBitsToUint(candidate.b));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANONICAL_R_WORD,
            floatBitsToUint(canonical.r));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANONICAL_G_WORD,
            floatBitsToUint(canonical.g));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_CANONICAL_B_WORD,
            floatBitsToUint(canonical.b));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_RESIDUAL_WORD,
            floatBitsToUint(max(context.state.luminanceChangeEma, 0.0)));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_SOURCE_RAYS_WORD,
            context.sourceRayCount);
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PRIVATE_R_WORD,
            floatBitsToUint(privateTarget.r));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PRIVATE_G_WORD,
            floatBitsToUint(privateTarget.g));
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_PRIVATE_B_WORD,
            floatBitsToUint(privateTarget.b));
        memoryBarrierBuffer();
        SimpleDdgiAuditWrite(
            SIMPLE_DDGI_AUDIT_DETAILED_WITNESS_VALID_WORD,
            1u);
    }

    float defect = max(
        abs(candidate.r - canonical.r),
        max(
            abs(candidate.g - canonical.g),
            abs(candidate.b - canonical.b)));
    float fieldMagnitude = max(
        canonical.r,
        max(canonical.g, canonical.b));
    uint defectBits = floatBitsToUint(max(defect, 0.0));
    SimpleDdgiAuditAtomicMax(
        SIMPLE_DDGI_AUDIT_DEFECT_WORD,
        defectBits);
    uint witnessAddress = ((probeIndex << 6u) | localTexel) &
        SIMPLE_DDGI_AUDIT_WITNESS_ADDRESS_MASK;
    uint witnessKey = (defectBits >> SIMPLE_DDGI_AUDIT_WITNESS_ADDRESS_BITS) <<
        SIMPLE_DDGI_AUDIT_WITNESS_ADDRESS_BITS;
    witnessKey |= witnessAddress;
    SimpleDdgiAuditAtomicMax(
        SIMPLE_DDGI_AUDIT_MAXIMUM_DEFECT_WITNESS_WORD,
        witnessKey);
    SimpleDdgiAuditAtomicMax(
        SIMPLE_DDGI_AUDIT_FIELD_MAGNITUDE_WORD,
        floatBitsToUint(max(fieldMagnitude, 0.0)));
    float quantizationFloor = max(
        SimpleDdgiAuditHalfQuantizationFloor(canonical.r),
        max(
            SimpleDdgiAuditHalfQuantizationFloor(canonical.g),
            SimpleDdgiAuditHalfQuantizationFloor(canonical.b)));
    SimpleDdgiAuditAtomicMax(
        SIMPLE_DDGI_AUDIT_QUANTIZATION_FLOOR_WORD,
        floatBitsToUint(max(quantizationFloor, 0.0)));
    SimpleDdgiAuditAtomicAdd(
        SIMPLE_DDGI_AUDIT_AUDITED_TEXEL_WORD,
        1u);
    if (localTexel == 0u)
        SimpleDdgiAuditAtomicAdd(
            SIMPLE_DDGI_AUDIT_AUDITED_PARTICIPANT_WORD,
            1u);
}
#endif

void main()
{
#if SIMPLE_DDGI_AUDIT_SHADER_ROLE == SIMPLE_DDGI_AUDIT_SHADER_ROLE_RAYS
    SimpleDdgiAuditRunRayPhase();
#else
    SimpleDdgiAuditRunReducePhase();
#endif
}
