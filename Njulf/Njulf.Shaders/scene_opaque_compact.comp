uint OpaqueBucketOverflowCounterWord(uint bucket)
{
    return bucket == SCENE_OPAQUE_BUCKET_SIMPLE
        ? SCENE_SUBMISSION_COUNTER_SIMPLE_OPAQUE_OVERFLOW
