#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "directional_csm_sampling.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform DirectionalCsmResolvePushBlock
{
    mat4 InverseViewProjectionMatrix;
    vec4 CameraPositionAndReceiverDistance;
    vec4 RayDirectionAndMaximumDistance;
    uint ScreenWidth;
    uint ScreenHeight;
    uint OutputBufferIndex;
    uint InstanceMask;
    uint OutputMode;
    uint TemporalSampleIndex;
    uint TraceSampleCount;
    uint DebugFlags;
} pc;

bool Finite(float value) { return !isnan(value) && !isinf(value); }
bool Finite(vec3 value) { return !any(isnan(value)) && !any(isinf(value)); }

bool ReconstructPosition(ivec2 pixel, out vec3 worldPosition, out float depth)
{
    worldPosition = vec3(0.0);
    depth = texelFetch(
        BindlessTextures[nonuniformEXT(DEPTH_TEXTURE_INDEX)],
        pixel,
        0).r;
    if (!Finite(depth) || depth <= 0.0 || depth > 1.0)
        return false;
    vec2 uv = (vec2(pixel) + vec2(0.5)) /
        vec2(pc.ScreenWidth, pc.ScreenHeight);
    vec4 world = MulRowMajor(
        vec4(uv * 2.0 - vec2(1.0), depth, 1.0),
        pc.InverseViewProjectionMatrix);
    if (any(isnan(world)) || any(isinf(world)) || abs(world.w) <= 1.0e-7)
        return false;
    worldPosition = world.xyz / world.w;
    return Finite(worldPosition);
}

vec3 SelectDerivative(vec3 center, vec3 negative, bool hasNegative, vec3 positive, bool hasPositive)
{
    if (hasNegative && hasPositive)
    {
        vec3 left = center - negative;
        vec3 right = positive - center;
        return dot(left, left) < dot(right, right) ? left : right;
    }
    return hasNegative ? center - negative : (hasPositive ? positive - center : vec3(0.0));
}

vec3 ReconstructNormal(ivec2 pixel, vec3 center)
{
    ivec2 maximum = ivec2(pc.ScreenWidth, pc.ScreenHeight) - ivec2(1);
    vec3 left;
    vec3 right;
    vec3 upper;
    vec3 lower;
    float ignored;
    bool hasLeft = pixel.x > 0 && ReconstructPosition(pixel + ivec2(-1, 0), left, ignored);
    bool hasRight = pixel.x < maximum.x && ReconstructPosition(pixel + ivec2(1, 0), right, ignored);
    bool hasUpper = pixel.y > 0 && ReconstructPosition(pixel + ivec2(0, -1), upper, ignored);
    bool hasLower = pixel.y < maximum.y && ReconstructPosition(pixel + ivec2(0, 1), lower, ignored);
    vec3 normal = cross(
        SelectDerivative(center, left, hasLeft, right, hasRight),
        SelectDerivative(center, upper, hasUpper, lower, hasLower));
    float lengthSquared = dot(normal, normal);
    if (!Finite(normal) || lengthSquared <= 1.0e-12)
        return normalize(-pc.RayDirectionAndMaximumDistance.xyz);
    normal *= inversesqrt(lengthSquared);
    if (dot(normal, pc.CameraPositionAndReceiverDistance.xyz - center) < 0.0)
        normal = -normal;
    return normal;
}

uint SelectCascade(float distance, vec4 splits, uint cascadeCount)
{
    for (uint cascade = 0u; cascade + 1u < cascadeCount; cascade++)
    {
        if (distance <= splits[int(cascade)])
            return cascade;
    }
    return cascadeCount - 1u;
}

float PcfAxisWeight(
    int offset,
    int radius,
    float fraction,
    int filterMode)
{
    if (radius == 0)
        return offset == 0 ? 1.0 - fraction : fraction;
    if (filterMode == 1)
    {
        return max(
            float(radius + 1) - abs(float(offset) - fraction),
            0.0);
    }
    return offset == -radius
        ? 1.0 - fraction
        : (offset == radius + 1 ? fraction : 1.0);
}

float SampleCascade(uint cascade, vec3 worldPosition, vec3 normal, out bool valid)
{
    vec4 shadowSettings = ReadShadowSettings();
    vec4 filterAndBias = ReadDirectionalShadowFilterAndBias();
    vec4 texelSizes = ReadDirectionalShadowWorldTexelSizes();
    float normalBias = shadowSettings.y;
    if (int(round(filterAndBias.y)) == 1)
    {
        normalBias = min(
            max(texelSizes[int(cascade)], 0.0) * max(filterAndBias.z, 0.0),
            max(filterAndBias.w, 0.0));
    }
    vec4 clip = MulRowMajor(
        vec4(worldPosition + normal * normalBias, 1.0),
        ReadShadowMatrix(cascade));
    if (any(isnan(clip)) || any(isinf(clip)) || abs(clip.w) <= 1.0e-7)
    {
        valid = false;
        return 1.0;
    }
    vec3 coordinate = clip.xyz / clip.w;
    vec2 uv = coordinate.xy * 0.5 + vec2(0.5);
    valid = all(greaterThanEqual(uv, vec2(0.0))) &&
        all(lessThanEqual(uv, vec2(1.0))) &&
        coordinate.z >= 0.0 && coordinate.z <= 1.0;
    if (!valid)
        return 1.0;

    float mapSize = max(shadowSettings.z, 1.0);
    vec2 texelPosition = uv * mapSize - vec2(0.5);
    ivec2 base = ivec2(floor(texelPosition));
    ivec2 maximum = ivec2(max(int(mapSize) - 1, 0));
    vec2 fraction = fract(texelPosition);
    int radius = ResolveDirectionalShadowPcfRadius(
        cascade,
        int(clamp(round(shadowSettings.w), 0.0, 3.0)),
        texelSizes);
    int minimumOffset = radius == 0 ? 0 : -radius;
    int maximumOffset = radius == 0 ? 1 : radius + 1;
    int filterMode = int(clamp(round(filterAndBias.x), 0.0, 1.0));
    float visibility = 0.0;
    float totalWeight = 0.0;
    for (int y = minimumOffset; y <= maximumOffset; y += 2)
    {
        float weightY0 = PcfAxisWeight(
            y, radius, fraction.y, filterMode);
        float weightY1 = PcfAxisWeight(
            y + 1, radius, fraction.y, filterMode);
        for (int x = minimumOffset; x <= maximumOffset; x += 2)
        {
            float weightX0 = PcfAxisWeight(
                x, radius, fraction.x, filterMode);
            float weightX1 = PcfAxisWeight(
                x + 1, radius, fraction.x, filterMode);
            vec4 weights = vec4(
                weightX0 * weightY0,
                weightX1 * weightY0,
                weightX0 * weightY1,
                weightX1 * weightY1);
            vec4 compared = DirectionalShadowCompareGather(
                DirectionalShadowGatherDepthBlock(
                    uint(DIRECTIONAL_SHADOW_TEXTURE_BASE) + cascade,
                    base + ivec2(x, y),
                    maximum,
                    mapSize),
                coordinate.z);
            visibility += dot(compared, weights);
            totalWeight += dot(weights, vec4(1.0));
        }
    }
    return visibility / max(totalWeight, 1.0e-6);
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.ScreenWidth || pixel.y >= pc.ScreenHeight)
        return;
    uint pixelIndex = pixel.y * pc.ScreenWidth + pixel.x;
    vec3 worldPosition;
    float depth;
    float visibility = 1.0;
    if (ReconstructPosition(ivec2(pixel), worldPosition, depth))
    {
        vec3 normal = ReconstructNormal(ivec2(pixel), worldPosition);
        vec3 cameraForward = normalize(
            pc.RayDirectionAndMaximumDistance.xyz);
        float cameraDistance = max(dot(
            worldPosition - pc.CameraPositionAndReceiverDistance.xyz,
            cameraForward), 0.0);
        vec4 splits = ReadShadowCascadeSplits();
        vec4 transition = ReadShadowCascadeTransitionData();
        uint cascadeCount = clamp(
            uint(round(ReadShadowIndices().y)),
            1u,
            uint(MAX_DIRECTIONAL_SHADOW_TEXTURES));
        uint cascade = SelectCascade(cameraDistance, splits, cascadeCount);
        bool valid;
        visibility = SampleCascade(cascade, worldPosition, normal, valid);
        if (!valid)
        {
            for (uint offset = 1u; offset < cascadeCount && !valid; offset++)
            {
                if (cascade >= offset)
                    visibility = SampleCascade(cascade - offset, worldPosition, normal, valid);
                if (!valid && cascade + offset < cascadeCount)
                    visibility = SampleCascade(cascade + offset, worldPosition, normal, valid);
            }
        }

        if (cascade + 1u < cascadeCount)
        {
            float boundary = splits[int(cascade)];
            float previousBoundary = cascade == 0u
                ? transition.y
                : splits[int(cascade - 1u)];
            float nextBoundary = cascade + 2u >= cascadeCount
                ? transition.z
                : splits[int(cascade + 1u)];
            float width = min(
                max(boundary - previousBoundary, 0.001),
                max(nextBoundary - boundary, 0.001)) *
                clamp(transition.x, 0.02, 0.30);
            if (cameraDistance >= boundary - width)
            {
                bool nextValid;
                float nextVisibility = SampleCascade(
                    cascade + 1u,
                    worldPosition,
                    normal,
                    nextValid);
                if (valid && nextValid)
                {
                    visibility = mix(
                        visibility,
                        nextVisibility,
                        smoothstep(boundary - width, boundary + width, cameraDistance));
                }
            }
        }
        visibility = mix(
            1.0,
            visibility,
            clamp(ReadShadowSettings().x, 0.0, 1.0));
    }
    WriteStorageWord(
        pc.OutputBufferIndex,
        pixelIndex,
        packHalf2x16(vec2(clamp(visibility, 0.0, 1.0), 0.0)));
}
