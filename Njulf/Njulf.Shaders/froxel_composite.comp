#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "froxel_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

float FroxelSurfaceDistance(vec2 uv, float depth)
{
    if (depth <= 1.0e-7)
        return FroxelFrame.DepthParameters.y;
    vec4 world = MulRowMajor(
        vec4(uv * 2.0 - vec2(1.0), depth, 1.0),
        FroxelFrame.InverseViewProjectionMatrix);
    world.xyz /= max(abs(world.w), 1.0e-6);
    return length(world.xyz - FroxelFrame.CameraPositionAndTime.xyz);
}

vec4 FroxelDepthAwareResolved(vec2 fullPixel, float centerDistance)
{
    uint divisor = uint(max(round(
        FroxelFrame.LightingGridDimensions.w), 1.0));
    uvec2 resolveDimensions = uvec2(
        (uint(FroxelFrame.ScreenDimensions.x) + divisor - 1u) / divisor,
        (uint(FroxelFrame.ScreenDimensions.y) + divisor - 1u) / divisor);
    vec2 coordinate = (fullPixel + vec2(0.5)) / float(divisor) - vec2(0.5);
    ivec2 base = ivec2(floor(coordinate));
    vec2 fraction = fract(coordinate);
    vec4 accumulated = vec4(0.0);
    float totalWeight = 0.0;
    for (int y = 0; y <= 1; y++)
    for (int x = 0; x <= 1; x++)
    {
        ivec2 sampleCoordinate = clamp(
            base + ivec2(x, y),
            ivec2(0),
            ivec2(resolveDimensions) - ivec2(1));
        vec2 sampleFullPixel = (vec2(sampleCoordinate) + vec2(0.5)) *
            float(divisor) - vec2(0.5);
        vec2 sampleUv = clamp(
            (sampleFullPixel + vec2(0.5)) *
                FroxelFrame.ScreenDimensions.zw,
            vec2(0.0),
            vec2(1.0));
        float sampleDepth = texture(BindlessTextures[nonuniformEXT(
            DEPTH_TEXTURE_INDEX)], sampleUv).r;
        float sampleDistance = FroxelSurfaceDistance(sampleUv, sampleDepth);
        float bilinearWeight = (x == 0 ? 1.0 - fraction.x : fraction.x) *
            (y == 0 ? 1.0 - fraction.y : fraction.y);
        float depthWeight = exp(-abs(sampleDistance - centerDistance) /
            max(centerDistance * 0.01, 0.15));
        float weight = bilinearWeight * max(depthWeight, 1.0e-4);
        accumulated += imageLoad(
            FroxelResolvedHalf,
            ivec3(sampleCoordinate, 0)) * weight;
        totalWeight += weight;
    }
    return accumulated / max(totalWeight, 1.0e-6);
}

ivec3 FroxelNearestLightingCoordinate(ivec3 coordinate)
{
    return ivec3(clamp(
        floor(FroxelLightingCoordinate(vec3(coordinate)) + vec3(0.5)),
        vec3(0.0),
        vec3(FroxelLightingGridSize()) - vec3(1.0)));
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 dimensions = uvec2(max(round(
        FroxelFrame.ScreenDimensions.xy), vec2(1.0)));
    if (any(greaterThanEqual(pixel, dimensions)))
        return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) *
        FroxelFrame.ScreenDimensions.zw;
    float depth = texture(BindlessTextures[nonuniformEXT(
        DEPTH_TEXTURE_INDEX)], uv).r;
    float surfaceDistance = FroxelSurfaceDistance(uv, depth);
    vec4 integrated = FroxelDepthAwareResolved(
        vec2(pixel), surfaceDistance);

    float pixelSize = max(FroxelFrame.GridDimensions.w, 1.0);
    vec2 debugCoordinate = (vec2(pixel) + vec2(0.5)) / pixelSize +
        vec2(FroxelFrame.DepthParameters.w) - vec2(0.5);
    ivec2 froxelXY = ivec2(clamp(
        floor(debugCoordinate + vec2(0.5)),
        vec2(0.0), FroxelFrame.GridDimensions.xy - vec2(1.0)));
    int debugSlice = int(round(FroxelFrame.GridProjection.w));
    uint surfaceSlice = uint(clamp(
        floor(FroxelContinuousSlice(surfaceDistance)),
        0.0, FroxelFrame.GridDimensions.z - 1.0));
    uint projection = uint(max(round(FroxelFrame.MultipleScattering.z), 0.0));
    uint slice = debugSlice >= 0
        ? uint(clamp(debugSlice, 0, int(FroxelFrame.GridDimensions.z) - 1))
        : projection == 2u
            ? uint(FroxelFrame.GridDimensions.z * 0.5)
            : surfaceSlice;
    uint firstDebugSlice = projection == 0u && debugSlice < 0 ? 0u : slice;
    uint lastDebugSlice = projection == 0u && debugSlice < 0
        ? surfaceSlice
        : slice;
    uint debugView = uint(max(round(FroxelFrame.CountsAndDebug.w), 0.0));
    vec3 outputColor;

    float projectedDensity = 0.0;
    float projectedExtinction = 0.0;
    vec3 projectedDirect = vec3(0.0);
    vec3 projectedIndirect = vec3(0.0);
    float projectedConfidence = 0.0;
    float projectedVisibility = 0.0;
    if (debugView >= 9u && debugView <= 15u && debugView != 14u)
    {
        for (uint z = firstDebugSlice; z <= lastDebugSlice; z++)
        {
            ivec3 texel = ivec3(froxelXY, int(z));
            float extinction = imageLoad(FroxelHistoryWrite, texel).a;
            projectedDensity = max(projectedDensity, extinction);
            projectedExtinction = max(projectedExtinction, extinction);
            ivec3 lightingTexel = FroxelNearestLightingCoordinate(texel);
            vec4 directSample = imageLoad(
                FroxelDirectRadiance, lightingTexel);
            projectedDirect = max(projectedDirect, directSample.rgb);
            projectedIndirect = max(projectedIndirect,
                imageLoad(FroxelIndirectRadiance, lightingTexel).rgb);
            projectedConfidence = max(projectedConfidence,
                imageLoad(FroxelHistoryConfidenceWrite, texel).r);
            projectedVisibility = max(projectedVisibility, directSample.a);
        }
    }

    if (debugView == 9u)
        outputColor = vec3(1.0 - exp(-projectedDensity * 8.0));
    else if (debugView == 10u)
    {
        float extinction = 1.0 - exp(-projectedExtinction * 8.0);
        outputColor = vec3(extinction, extinction * 0.35, 0.0);
    }
    else if (debugView == 11u)
        outputColor = vec3(1.0) - exp(-projectedDirect * 0.15);
    else if (debugView == 12u)
        outputColor = vec3(1.0) - exp(-projectedIndirect * 0.5);
    else if (debugView == 13u)
        outputColor = vec3(projectedConfidence);
    else if (debugView == 14u || debugView == 2u)
        outputColor = vec3(integrated.a);
    else if (debugView == 15u)
        outputColor = vec3(projectedVisibility);
    else if (debugView == 1u)
        outputColor = vec3(1.0 - integrated.a);
    else if (debugView == 3u)
    {
        float distanceFog = 1.0 - exp(-max(
            FroxelFrame.GlobalExtinction.x, 0.0) * surfaceDistance);
        outputColor = vec3(distanceFog);
    }
    else if (debugView == 4u)
    {
        float distanceFog = 1.0 - exp(-max(
            FroxelFrame.GlobalExtinction.x, 0.0) * surfaceDistance);
        outputColor = vec3(clamp(
            (1.0 - integrated.a) - distanceFog, 0.0, 1.0));
    }
    else if (debugView == 5u)
        outputColor = vec3(1.0) - exp(-max(integrated.rgb, vec3(0.0)) * 0.25);
    else if (debugView == 6u)
        outputColor = vec3(surfaceDistance /
            max(FroxelFrame.DepthParameters.y, 0.001));
    else if (debugView == 7u)
        outputColor = vec3(FroxelWorldPosition(uvec3(
            froxelXY, int(slice))).y * 0.02 + 0.5);
    else
    {
        vec3 sceneColor = texture(BindlessTextures[nonuniformEXT(
            HDR_SCENE_COLOR_TEXTURE_INDEX)], uv).rgb;
        outputColor = sceneColor * integrated.a + integrated.rgb;
    }
    imageStore(FroxelOutput, ivec2(pixel),
        vec4(max(outputColor, vec3(0.0)), 1.0));
}
