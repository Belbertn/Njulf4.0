#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "common.glsl"
#include "gi_material_transport.glsl"
#define SIMPLE_DDGI_DISABLE_SAMPLED_ATLAS 1
#include "ddgi_simple_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform SimpleDdgiPushBlock
{
    uint ParamsBufferIndex;
    uint IrradianceAtlasBufferIndex;
    uint VisibilityAtlasBufferIndex;
    uint RayResultScratchBufferIndex;
    uint CurrentFrameIndex;
    uint LightCount;
    uint DirectionalLightCount;
    uint LocalLightCount;
    uint MaxShadedLights;
    uint EmissiveSourceCount;
    uint FarFieldParamsBufferIndex;
    uint FarFieldVoxelBufferIndex;
    uint FarFieldInstanceBufferIndex;
    uint Flags;
    uint MaterialTextureMaxCascade;
    uint ProbeStateBufferIndex;
    uint ProbeUpdateQueueBufferIndex;
    uint RelocationClassificationBufferIndex;
    uint TransportSourceCacheBufferIndex;
    uint TransportReadIrradianceAtlasBufferIndex;
    uint TransportWriteIrradianceAtlasBufferIndex;
    uint TransportGeneration;
    uint PrimaryDirectionalLightIndex;
} pc;

void WriteSimpleTransportRayResult(
    uint rayResultIndex,
    vec3 radiance,
    float surfaceDistance,
    float visibilityDistance,
    vec3 direction,
    float hitKind)
{
    uint baseWord = rayResultIndex * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS;
    WriteStorageVec4(pc.RayResultScratchBufferIndex, baseWord, vec4(clamp(radiance, vec3(0.0), vec3(65504.0)), max(surfaceDistance, 0.0)));
    WriteStorageFloat(pc.RayResultScratchBufferIndex, baseWord + 4u, direction.x);
    WriteStorageFloat(pc.RayResultScratchBufferIndex, baseWord + 5u, direction.y);
    WriteStorageFloat(pc.RayResultScratchBufferIndex, baseWord + 6u, direction.z);
    WriteStorageWord(
        pc.RayResultScratchBufferIndex,
        baseWord + 7u,
        PackSimpleDdgiRayVisibilityHit(visibilityDistance, hitKind));
}

void main()
{
    SimpleDdgiParams params = ReadSimpleDdgiParams(pc.ParamsBufferIndex);
    uint globalRay = gl_GlobalInvocationID.x;
    uint totalRays = params.probesToUpdate * params.raysPerProbe;
    if (globalRay >= totalRays || params.probeCount == 0u ||
        (params.flags & SIMPLE_DDGI_FLAG_TRANSPORT_V2) == 0u)
    {
        return;
    }

    uint queueOffset = globalRay / params.raysPerProbe;
    uint rayIndex = globalRay - queueOffset * params.raysPerProbe;
    SimpleDdgiProbeUpdate update = ReadSimpleDdgiProbeUpdate(pc.ProbeUpdateQueueBufferIndex, queueOffset);
    uint activeRayCount = SimpleDdgiUpdateRayCount(update, params);
    if (rayIndex >= activeRayCount || update.probeIndex >= params.probeCount)
        return;

    SimpleDdgiVolume volume;
    uint localProbeIndex;
    if (!ResolveSimpleDdgiProbeVolume(update.probeIndex, params, volume, localProbeIndex))
        return;
    SimpleDdgiProbeState probeState = ReadSimpleDdgiProbeState(pc.ProbeStateBufferIndex, update.probeIndex);
    if (!SimpleDdgiUpdateMatchesProbeGeneration(update, probeState))
        return;

    uint sourceRayCount = SimpleDdgiUpdateSourceRayCount(update, params);
    uint sourceRayOrdinal = min(
        rayIndex * sourceRayCount / max(activeRayCount, 1u),
        sourceRayCount - 1u);
    uint directionRayIndex = sourceRayOrdinal * params.raysPerProbe / sourceRayCount;
    SimpleDdgiTransportRayCache source;
    if (!ReadSimpleDdgiTransportRayCache(
            pc.TransportSourceCacheBufferIndex,
            update.probeIndex,
            directionRayIndex,
            params,
            SimpleDdgiProbeGeneration(probeState),
            source))
    {
        // A stale/corrupt cache cannot inject old energy. Preserve the source
        // scratch result (or zero if trace was skipped), then atomically request
        // a full source refresh through the next probe-state readback.
        MarkSimpleDdgiProbeSourceCacheInvalid(pc.ProbeStateBufferIndex, update.probeIndex);
        uint scratchBase = globalRay * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS;
        vec4 sourceRadianceDistance = ReadStorageVec4(pc.RayResultScratchBufferIndex, scratchBase);
        vec4 sourceDirectionHit = ReadStorageVec4(pc.RayResultScratchBufferIndex, scratchBase + 4u);
        vec2 sourceVisibilityHit =
            UnpackSimpleDdgiRayVisibilityHit(
                ReadStorageWord(
                    pc.RayResultScratchBufferIndex,
                    scratchBase + 7u));
        RecordSimpleDdgiTransportEnergyDiagnostics(
            params,
            pc.CurrentFrameIndex,
            update.volumeIndex,
            update.probeIndex,
            directionRayIndex,
            false,
            sourceRadianceDistance.rgb,
            vec3(0.0),
            sourceRadianceDistance.rgb,
            0u,
            0.0,
            0.0);
        WriteSimpleTransportRayResult(
            globalRay,
            sourceRadianceDistance.rgb,
            sourceRadianceDistance.w,
            sourceVisibilityHit.x,
            sourceDirectionHit.xyz,
            sourceVisibilityHit.y);
        return;
    }

    float hitKind = SimpleDdgiTransportRayCacheHitKind(source);
    vec3 totalRadiance = source.sourceRadiance;
    vec3 bounceRadiance = vec3(0.0);
    vec3 reflectedBounceRadiance = vec3(0.0);
    vec3 transmittedBounceRadiance = vec3(0.0);
    uint solverGatherCount = 0u;
    float solverOwnershipSum = 0.0;
    float solverFallbackWeightSum = 0.0;
    bool bounceableSurface = hitKind >= 0.5 &&
        !SimpleDdgiRayHitKindIsOneSidedBackFace(hitKind);
    if (bounceableSurface)
    {
        vec3 probePosition = SimpleDdgiProbeLogicalPosition(volume, localProbeIndex) + probeState.relocation;
        vec3 canonicalNormal = length(source.normal) > 0.00001 ? normalize(source.normal) : vec3(0.0, 1.0, 0.0);
        vec3 normal = hitKind > 1.5 ? -canonicalNormal : canonicalNormal;
        vec3 diffuseReflectance = clamp(
            source.diffuseReflectance,
            vec3(0.0),
            vec3(params.transportAlbedoClamp));
        vec3 hitPosition = probePosition + source.direction * source.distance;
        float reflectedSolverOwnership;
        float reflectedFallbackWeight;
        vec3 bouncedIrradiance = SampleSimpleDdgiSolverBounceIrradiance(
            hitPosition + normal * max(0.03, volume.spacing * 0.02),
            normal,
            -source.direction,
            reflectedSolverOwnership,
            reflectedFallbackWeight);
        solverGatherCount++;
        solverOwnershipSum += reflectedSolverOwnership;
        solverFallbackWeightSum += reflectedFallbackWeight;
        // Material AO is a receiver-side approximation. Geometry visibility is
        // already present in the traced field, so applying baked AO at every
        // recursive surface double-counts occlusion and compounds energy loss.
        reflectedBounceRadiance = EvaluateGiDiffuseFromIrradiance(
            bouncedIrradiance,
            diffuseReflectance);
        vec3 transmittedReflectance = clamp(
            source.transmittedDiffuseReflectance,
            vec3(0.0),
            vec3(params.transportAlbedoClamp));
        if ((params.flags & SIMPLE_DDGI_FLAG_THIN_SURFACE_TRANSMISSION) == 0u)
            transmittedReflectance = vec3(0.0);
        if (max(transmittedReflectance.r, max(transmittedReflectance.g, transmittedReflectance.b)) > 0.0)
        {
            float transmittedSolverOwnership;
            float transmittedFallbackWeight;
            vec3 transmittedIrradiance = SampleSimpleDdgiSolverBounceIrradiance(
                hitPosition - normal * max(0.03, volume.spacing * 0.02),
                -normal,
                source.direction,
                transmittedSolverOwnership,
                transmittedFallbackWeight);
            solverGatherCount++;
            solverOwnershipSum += transmittedSolverOwnership;
            solverFallbackWeightSum += transmittedFallbackWeight;
            transmittedBounceRadiance = EvaluateGiDiffuseFromIrradiance(
                transmittedIrradiance,
                transmittedReflectance);
        }
        bounceRadiance = reflectedBounceRadiance + transmittedBounceRadiance;
        totalRadiance += bounceRadiance;
    }

    if ((params.flags & SIMPLE_DDGI_FLAG_DETAILED_DIAGNOSTICS_ENABLED) != 0u &&
        max(source.transmittedDiffuseReflectance.r,
            max(source.transmittedDiffuseReflectance.g, source.transmittedDiffuseReflectance.b)) > 0.0)
    {
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            DDGI_THIN_REFLECTED_RECURSIVE_LUMINANCE_COUNTER,
            uint(round(clamp(
                dot(max(reflectedBounceRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * DDGI_THIN_LUMINANCE_SCALE,
                0.0,
                4294967295.0))));
        AddRendererDiagnostic(
            pc.CurrentFrameIndex,
            DDGI_THIN_TRANSMITTED_RECURSIVE_LUMINANCE_COUNTER,
            uint(round(clamp(
                dot(max(transmittedBounceRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * DDGI_THIN_LUMINANCE_SCALE,
                0.0,
                4294967295.0))));
    }

    RecordSimpleDdgiTransportEnergyDiagnostics(
        params,
        pc.CurrentFrameIndex,
        update.volumeIndex,
        update.probeIndex,
        directionRayIndex,
        true,
        source.sourceRadiance,
        bounceRadiance,
        totalRadiance,
        solverGatherCount,
        solverOwnershipSum,
        solverFallbackWeightSum);

    vec2 visibilityHit = UnpackSimpleDdgiRayVisibilityHit(
        ReadStorageWord(
            pc.RayResultScratchBufferIndex,
            globalRay * SIMPLE_DDGI_RAY_RESULT_STRIDE_WORDS + 7u));
    WriteSimpleTransportRayResult(
        globalRay,
        totalRadiance,
        source.distance,
        visibilityHit.x,
        source.direction,
        visibilityHit.y);
}
