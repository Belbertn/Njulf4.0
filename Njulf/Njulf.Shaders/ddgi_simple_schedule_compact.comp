#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "ddgi_simple_schedule_shared.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

shared uint CandidateLanes[SIMPLE_DDGI_SCHEDULER_WORKGROUP_SIZE];

void main()
{
    if (SchedulerCertifiedQuiesced())
        return;

    uint candidateIndex = gl_GlobalInvocationID.x;
    uint localIndex = gl_LocalInvocationIndex;
    bool inRange = candidateIndex < SchedulerCandidateCapacity();
    uint inputBase = pc.CandidateInputOffsetWords +
        candidateIndex * SIMPLE_DDGI_SCHEDULER_CANDIDATE_WORDS;
    uint probeIndex = inRange
        ? SchedulerCandidateWord(inputBase, 0u)
        : SIMPLE_DDGI_SCHEDULER_INVALID_PROBE;
    uint volumeIndex = 0u;
    uint workClassAndTransport = 0u;
    uint rayTierAndReason = 0u;
    uint lane = SIMPLE_DDGI_SCHEDULER_MAX_LANES;
    if (probeIndex != SIMPLE_DDGI_SCHEDULER_INVALID_PROBE)
    {
        volumeIndex = SchedulerCandidateWord(inputBase, 1u);
        workClassAndTransport = SchedulerCandidateWord(inputBase, 2u);
        rayTierAndReason = SchedulerCandidateWord(inputBase, 3u);
        uint workClass = workClassAndTransport & 7u;
        uint transport = (workClassAndTransport >> 3u) & 3u;
        uint rayTier = rayTierAndReason & 0xffu;
        if (volumeIndex < SIMPLE_DDGI_SCHEDULER_MAX_VOLUMES &&
            workClass < SIMPLE_DDGI_SCHEDULER_WORK_CLASSES &&
            transport < SIMPLE_DDGI_SCHEDULER_TRANSPORT_CATEGORIES &&
            rayTier < SIMPLE_DDGI_SCHEDULER_RAY_TIERS)
        {
            lane = SchedulerLaneIndex(
                volumeIndex,
                workClass,
                transport,
                rayTier);
        }
    }
    CandidateLanes[localIndex] = lane;
    barrier();
    if (lane >= SIMPLE_DDGI_SCHEDULER_MAX_LANES)
        return;

    uint group = candidateIndex / SIMPLE_DDGI_SCHEDULER_WORKGROUP_SIZE;
    uint localRank = 0u;
    // Candidate metadata was previously re-read from the storage buffer for
    // every preceding lane in this workgroup. Publish the resolved lane once
    // to shared memory instead: ordering is identical and the O(64) comparison
    // becomes on-chip rather than millions of uncached SSBO word reads.
    for (uint prior = 0u; prior < localIndex; prior++)
    {
        if (CandidateLanes[prior] == lane)
            localRank++;
    }

    uint outputIndex = SchedulerArenaRead(pc.LanePrefixesOffsetWords + lane) +
        SchedulerGroupLaneCount(group, lane) + localRank;
    if (outputIndex >= SchedulerCandidateCapacity())
    {
        SchedulerArenaAtomicAdd(
            pc.CountersOffsetWords + SIMPLE_DDGI_SCHEDULER_COUNTER_OVERFLOW, 1u);
        return;
    }

    uint outputBase = pc.CandidateOutputOffsetWords +
        outputIndex * SIMPLE_DDGI_SCHEDULER_COMPACT_OUTPUT_WORDS;
    // Store the deterministic input index.  The full candidate remains in the
    // input pool, so admission can dereference it without a second 32-byte
    // record allocation or an atomic append order dependency.
    SchedulerArenaWrite(outputBase, candidateIndex);
}
