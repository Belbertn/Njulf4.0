    <!-- Establish solution/static-graph ordering for the task project without
         introducing a runtime reference into Njulf.Shaders. The target below
         still self-hosts direct project builds before AssignTargetPaths. -->
    <ItemGroup>
      <ProjectReference Include="..\Njulf.ShaderBuild\Njulf.ShaderBuild.csproj"
                        ReferenceOutputAssembly="false"
                        PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
      <NjulfShaderOptimizationOptions Condition="'$(Configuration)' == 'Development' or '$(Configuration)' == 'Release' or '$(Configuration)' == 'ShippingPerformance' or '$(Configuration)' == 'ProfileSymbols' or '$(Configuration)' == 'DetailedInvestigation'">-Os</NjulfShaderOptimizationOptions>
      <NjulfShaderDebugInformation Condition="'$(NJULF_SHADER_PROFILE)' == '1'">true</NjulfShaderDebugInformation>
      <NjulfShaderDebugOptions Condition="'$(NjulfShaderDebugInformation)' == 'true'">-gVS</NjulfShaderDebugOptions>
      <NjulfShaderVisualDebugOptions>-DNJULF_DDGI_VISUAL_DEBUG_VIEWS=0</NjulfShaderVisualDebugOptions>
      <NjulfShaderVisualDebugOptions Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Development' or '$(Configuration)' == 'DetailedInvestigation'">-DNJULF_DDGI_VISUAL_DEBUG_VIEWS=1</NjulfShaderVisualDebugOptions>
      <NjulfShaderDetailedDiagnosticsOptions>-DNJULF_DDGI_DETAILED_COUNTERS=0</NjulfShaderDetailedDiagnosticsOptions>
      <NjulfShaderDetailedDiagnosticsOptions Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'DetailedInvestigation'">-DNJULF_DDGI_DETAILED_COUNTERS=1</NjulfShaderDetailedDiagnosticsOptions>
      <NjulfDirectionalShadowDetailedCountersOptions>-DNJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS=0</NjulfDirectionalShadowDetailedCountersOptions>
      <NjulfDirectionalShadowDetailedCountersOptions Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'DetailedInvestigation'">-DNJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS=1</NjulfDirectionalShadowDetailedCountersOptions>
      <NjulfShaderCompileOptions>$(NjulfShaderOptimizationOptions) $(NjulfShaderDebugOptions) $(NjulfShaderVisualDebugOptions) $(NjulfShaderDetailedDiagnosticsOptions) $(NjulfDirectionalShadowDetailedCountersOptions)</NjulfShaderCompileOptions>
      <!-- Detailed transport-audit counters create a particularly expensive
           NVIDIA native pipeline in Debug. Optimize only this shader family;
           the counter ABI stays enabled and all other Debug shaders retain
           the ordinary unoptimized investigation profile. -->
      <NjulfSimpleDdgiAuditOptimizationOptions Condition="'$(Configuration)' == 'Debug'">-Os</NjulfSimpleDdgiAuditOptimizationOptions>
      <!-- B1 graphics variants already publish their own exact per-producer,
           overflow, validity, and timing telemetry. Combining that path with
           the much larger generic per-fragment investigation counter graph
           exceeds the NVIDIA Debug-driver compiler on the RTX 3060 class and
           adds unrelated atomics to a measured producer. Keep the ordinary
           diagnostic variants available, but freeze B1 graphics to the
           production counter profile in every configuration. -->
      <NjulfReceiverFeedbackGraphicsCompileOptions>$(NjulfShaderOptimizationOptions) $(NjulfShaderDebugOptions) -DNJULF_DDGI_DETAILED_COUNTERS=0 -DNJULF_DIRECTIONAL_SHADOW_DETAILED_COUNTERS=0</NjulfReceiverFeedbackGraphicsCompileOptions>
      <!-- glslang's -Os pass exhaustively inlines the large forward ray-query
           call graph and already approaches the SPIR-V ID ceiling before
           subsurface transport is enabled. Keep function boundaries in every
           ray-query variant; -Od is appended after -Os by the build task. -->
      <NjulfForwardRayQueryOptimizationOptions>-Od</NjulfForwardRayQueryOptimizationOptions>
      <!-- Keep function boundaries in exact receiver-attribution programs.
           Appending -Od after the ordinary -Os recipe avoids the pathological
           single-function native programs seen on the NVIDIA driver while
           preserving the shader's arithmetic and public ABI. -->
      <NjulfReceiverAttributionOptimizationOptions>-Od</NjulfReceiverAttributionOptimizationOptions>
      <NjulfShaderBuildMode Condition="'$(NjulfShaderBuildMode)' == ''">Compile</NjulfShaderBuildMode>
      <NjulfShaderMaxParallelism Condition="'$(NjulfShaderMaxParallelism)' == ''">0</NjulfShaderMaxParallelism>
      <NjulfShaderCacheMode Condition="'$(NjulfShaderCacheMode)' == ''">ReadWrite</NjulfShaderCacheMode>
      <NjulfShaderCacheDirectory Condition="'$(NjulfShaderCacheDirectory)' == ''">$(MSBuildProjectDirectory)\..\artifacts\shader-cache\v1</NjulfShaderCacheDirectory>
      <NjulfGlslangValidator Condition="'$(NjulfGlslangValidator)' == ''">glslangValidator</NjulfGlslangValidator>
      <NjulfShaderBuildTaskProject>$(MSBuildProjectDirectory)\..\Njulf.ShaderBuild\Njulf.ShaderBuild.csproj</NjulfShaderBuildTaskProject>
      <NjulfShaderBuildTaskSource>$(MSBuildProjectDirectory)\..\Njulf.ShaderBuild\CompileNjulfShaderArtifacts.cs</NjulfShaderBuildTaskSource>
      <NjulfShaderBuildTaskLockFile>$(MSBuildProjectDirectory)\..\Njulf.ShaderBuild\packages.lock.json</NjulfShaderBuildTaskLockFile>
      <NjulfShaderBuildTaskImplementationAssembly>$(MSBuildProjectDirectory)\..\Njulf.ShaderBuild\bin\Release\net10.0\Njulf.ShaderBuild.dll</NjulfShaderBuildTaskImplementationAssembly>
      <!-- MSBuild holds a loaded task assembly open for the lifetime of its node.
           Load a content-versioned shadow copy so repeated project evaluations
           resolve the same path while an implementation change gets a new,
           unlocked path. Include the toolchain because it can affect the DLL. -->
      <NjulfShaderBuildTaskSourceHash>$([MSBuild]::StableStringHash($([System.IO.File]::ReadAllText('$(NjulfShaderBuildTaskSource)')), 'Sha256'))</NjulfShaderBuildTaskSourceHash>
      <NjulfShaderBuildTaskProjectHash>$([MSBuild]::StableStringHash($([System.IO.File]::ReadAllText('$(NjulfShaderBuildTaskProject)')), 'Sha256'))</NjulfShaderBuildTaskProjectHash>
      <NjulfShaderBuildTaskLockHash>$([MSBuild]::StableStringHash($([System.IO.File]::ReadAllText('$(NjulfShaderBuildTaskLockFile)')), 'Sha256'))</NjulfShaderBuildTaskLockHash>
      <NjulfShaderBuildTaskFingerprintInput>$(MSBuildVersion)|$(NETCoreSdkVersion)|$(NjulfShaderBuildTaskSourceHash)|$(NjulfShaderBuildTaskProjectHash)|$(NjulfShaderBuildTaskLockHash)</NjulfShaderBuildTaskFingerprintInput>
      <NjulfShaderBuildTaskFingerprint>$([MSBuild]::StableStringHash('$(NjulfShaderBuildTaskFingerprintInput)', 'Sha256'))</NjulfShaderBuildTaskFingerprint>
      <NjulfShaderBuildTaskAssembly>$(MSBuildProjectDirectory)\obj\shader-build-task\$(NjulfShaderBuildTaskFingerprint)\Njulf.ShaderBuild.dll</NjulfShaderBuildTaskAssembly>
    </PropertyGroup>

    <!-- Shader files are compiled by a custom target and therefore are not
         ordinary Compile/EmbeddedResource inputs during IDE evaluation. Make
         them explicit fast-up-to-date inputs so Rider/Visual Studio cannot
         reuse a Njulf.Shaders.dll that predates the generated SPIR-V. The
         direct MSBuild path still validates the generated resources before
         CoreCompile; this closes the project-level shortcut around that path. -->
    <ItemGroup>
      <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\*.task;$(MSBuildProjectDirectory)\*.mesh;$(MSBuildProjectDirectory)\*.vert;$(MSBuildProjectDirectory)\*.frag;$(MSBuildProjectDirectory)\*.comp;$(MSBuildProjectDirectory)\*.glsl" />
      <UpToDateCheckInput Include="$(NjulfShaderBuildTaskProject);$(NjulfShaderBuildTaskSource);$(NjulfShaderBuildTaskLockFile)" />
    </ItemGroup>

    <UsingTask TaskName="Njulf.ShaderBuild.CompileNjulfShaderArtifacts"
               AssemblyFile="$(NjulfShaderBuildTaskAssembly)" />

    <Target Name="BuildNjulfShaderBuildTask"
            Inputs="$(NjulfShaderBuildTaskProject);$(NjulfShaderBuildTaskSource);$(NjulfShaderBuildTaskLockFile)"
            Outputs="$(NjulfShaderBuildTaskAssembly)">
      <MSBuild Projects="$(NjulfShaderBuildTaskProject)"
               Targets="Restore;Build"
               Properties="Configuration=Release;RestoreLockedMode=false"
               RemoveProperties="ArtifactsPath;BaseIntermediateOutputPath;IntermediateOutputPath;MSBuildProjectExtensionsPath;OutputPath;OutDir"
               BuildInParallel="false" />
      <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(NjulfShaderBuildTaskAssembly)'))" />
      <Copy SourceFiles="$(NjulfShaderBuildTaskImplementationAssembly)"
            DestinationFiles="$(NjulfShaderBuildTaskAssembly)"
            SkipUnchangedFiles="true"
            Retries="5"
            RetryDelayMilliseconds="100"
            Condition="!Exists('$(NjulfShaderBuildTaskAssembly)')" />
      <Error Condition="!Exists('$(NjulfShaderBuildTaskAssembly)')"
             Text="Failed to materialize the Njulf shader build task at '$(NjulfShaderBuildTaskAssembly)'." />
    </Target>

    <Target Name="CompileNjulfShaders"
            BeforeTargets="AssignTargetPaths"
            DependsOnTargets="BuildNjulfShaderBuildTask"
            Condition="'$(DesignTimeBuild)' != 'true'">
      <ItemGroup>
        <NjulfShaderArtifact Include="@(ShaderSource)">
          <Source>%(ShaderSource.FullPath)</Source>
          <Defines></Defines>
          <AdditionalCompileOptions>%(ShaderSource.AdditionalCompileOptions)</AdditionalCompileOptions>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiTraceShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiTraceShaderVariant.Source)</Source>
          <Defines>%(SimpleDdgiTraceShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiTraceShaderVariant.StorageMode) -DSIMPLE_DDGI_TRACE_SHADER_ROLE=%(SimpleDdgiTraceShaderVariant.Role)</Defines>
          <AdditionalCompileOptions>%(SimpleDdgiTraceShaderVariant.AdditionalCompileOptions)</AdditionalCompileOptions>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiTransportShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiTransportShaderVariant.Source)</Source>
          <Defines>%(SimpleDdgiTransportShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiTransportShaderVariant.StorageMode)</Defines>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiGuidedShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiGuidedShaderVariant.Source)</Source>
          <Defines>%(SimpleDdgiGuidedShaderVariant.Defines)</Defines>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiGuidingExtractShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiGuidingExtractShaderVariant.Source)</Source>
          <Defines>%(SimpleDdgiGuidingExtractShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiGuidingExtractShaderVariant.StorageMode)</Defines>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiAuditShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiAuditShaderVariant.Source)</Source>
          <Defines>%(SimpleDdgiAuditShaderVariant.Defines) -DSIMPLE_DDGI_STORAGE_SHADER_MODE=%(SimpleDdgiAuditShaderVariant.StorageMode) -DSIMPLE_DDGI_AUDIT_SHADER_ROLE=%(SimpleDdgiAuditShaderVariant.Role)</Defines>
          <AdditionalCompileOptions>$(NjulfSimpleDdgiAuditOptimizationOptions)</AdditionalCompileOptions>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiAdmissionShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiAdmissionShaderVariant.Source)</Source>
          <Defines>-DSIMPLE_DDGI_SCHEDULER_ADMISSION_ROLE=%(SimpleDdgiAdmissionShaderVariant.Role)</Defines>
        </NjulfShaderArtifact>
        <NjulfShaderArtifact Include="@(SimpleDdgiFeedbackShaderVariant)">
          <Source>$(MSBuildProjectDirectory)\%(SimpleDdgiFeedbackShaderVariant.Source)</Source>
          <Defines>%(SimpleDdgiFeedbackShaderVariant.Defines)</Defines>
