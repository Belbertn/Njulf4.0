#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require

#include "common.glsl"


#ifndef NJULF_MESH_LOCAL_SIZE
#ifdef FORWARD_COMPACTED_MESH
#define FORWARD_MESH_LOCAL_SIZE 64
#else
#define FORWARD_MESH_LOCAL_SIZE 128
#endif
#define NJULF_MESH_LOCAL_SIZE FORWARD_MESH_LOCAL_SIZE
#endif
#ifndef NJULF_MESH_MAX_VERTICES
#ifdef FORWARD_COMPACTED_MESH
#define NJULF_MESH_MAX_VERTICES 48
#define NJULF_MESH_MAX_PRIMITIVES 64
#else
#define NJULF_MESH_MAX_VERTICES 64
#define NJULF_MESH_MAX_PRIMITIVES 126
#endif
#endif
layout(local_size_x = NJULF_MESH_LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = NJULF_MESH_MAX_VERTICES, max_primitives = NJULF_MESH_MAX_PRIMITIVES) out;

#ifndef FORWARD_COMPACTED_MESH
struct ForwardTaskPayload
{
    uint DrawCommandIndex;
    uint Visible;
};

taskPayloadSharedEXT ForwardTaskPayload forwardPayload;
#endif
shared uint meshNegativeDeterminant;

layout(location = 0) out vec3 meshNormal[];
layout(location = 1) out vec2 meshTexCoord[];
layout(location = 2, component = 0) perprimitiveEXT flat out uint meshMaterialIndex[];
layout(location = 2, component = 1) perprimitiveEXT flat out uint meshObjectIndex[];
layout(location = 2, component = 2) perprimitiveEXT flat out uint meshMeshletIndex[];
layout(location = 3) out vec3 meshWorldPosition[];
// Bit zero is the fragment-side Plan-4 coverage gate. It deliberately carries
// only geometry facts unavailable from GPUMaterialData.
#if NJULF_COMMON_SURFACE_COVERAGE_DIAGNOSTICS
layout(location = 2, component = 3) perprimitiveEXT flat out uint meshCommonSurfaceEligibility[];
#endif

layout(push_constant) uniform ForwardPushConstantBlock
{
    GPUForwardPushConstants Push;
} pc;

void main()
{
#ifdef FORWARD_COMPACTED_MESH
    uint localDrawIndex = gl_WorkGroupID.x;
    if (localDrawIndex >= pc.Push.MeshletDrawCount)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint drawCommandIndex = localDrawIndex +
        ForwardFirstDraw(pc.Push.MeshletDrawBufferBaseIndex);
#else
    if (forwardPayload.Visible == 0u)
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint drawCommandIndex = forwardPayload.DrawCommandIndex;
#endif

    uint drawBufferBaseIndex = ForwardDrawBufferBaseIndex(
        pc.Push.MeshletDrawBufferBaseIndex);
    GPUMeshletDrawCommand command = ReadMeshletDrawCommandFromBase(
        drawBufferBaseIndex,
        pc.Push.CurrentFrameIndex,
        drawCommandIndex);
    GPUMeshlet meshlet = ReadMeshlet(
        command.MeshletIndex,
        pc.Push.CurrentFrameIndex);
    if (meshlet.LocalVertexCount > uint(NJULF_MESH_MAX_VERTICES) ||
        meshlet.LocalTriangleCount > uint(NJULF_MESH_MAX_PRIMITIVES))
    {
        if (gl_LocalInvocationIndex == 0u)
            SetMeshOutputsEXT(0u, 0u);
        return;
    }
    uint instanceBufferIndex = uint(INSTANCE_BUFFER_BASE_INDEX) + pc.Push.CurrentFrameIndex;
    uint objectWordOffset = command.InstanceId * uint(SIZEOF_GPU_OBJECT_DATA / 4);

    if (gl_LocalInvocationIndex == 0u)
    {
        SetMeshOutputsEXT(meshlet.LocalVertexCount, meshlet.LocalTriangleCount);
        meshNegativeDeterminant =
            ReadRowMajorLinearDeterminant(instanceBufferIndex, objectWordOffset) < 0.0
                ? 1u
                : 0u;
    }

    barrier();

    GPUObjectData objectData = ReadInstanceData(pc.Push.CurrentFrameIndex, command.InstanceId);
#if NJULF_COMMON_SURFACE_COVERAGE_DIAGNOSTICS
    uint commonSurfaceEligibility =
        objectData.SkinningEnabled == 0 &&
        (command.Flags & MESHLET_COMMAND_FLAG_LOD_DITHER_TRANSITION) == 0u
            ? 1u
            : 0u;
#endif

    for (uint vertexSlot = gl_LocalInvocationIndex;
         vertexSlot < meshlet.LocalVertexCount;
         vertexSlot += gl_WorkGroupSize.x)
    {
        uint localVertexIndex = ReadMeshletLocalVertexIndex(
            meshlet,
            vertexSlot);
        GPUVertexSimple vertex = FetchRenderableVertexSimple(meshlet, localVertexIndex, objectData, pc.Push.CurrentFrameIndex);

        vec4 worldPosition = TransformRowMajorPoint(vertex.Position, instanceBufferIndex, objectWordOffset);
        vec3 worldNormal = normalize(TransformRowMajorVector(vertex.Normal, instanceBufferIndex, objectWordOffset + 16u));

        gl_MeshVerticesEXT[vertexSlot].gl_Position = MulRowMajor(worldPosition, pc.Push.ViewProjectionMatrix);
        meshNormal[vertexSlot] = worldNormal;
        meshTexCoord[vertexSlot] = vertex.TexCoord;
        meshWorldPosition[vertexSlot] = worldPosition.xyz;
    }

    for (uint triangleSlot = gl_LocalInvocationIndex;
         triangleSlot < meshlet.LocalTriangleCount;
         triangleSlot += gl_WorkGroupSize.x)
    {
        uint triangleOffset = triangleSlot * 3u;
        uint i0 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 0u);
        uint i1 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 1u);
        uint i2 = ReadMeshletLocalTriangleIndex(meshlet, triangleOffset + 2u);
        meshMaterialIndex[triangleSlot] = command.MaterialIndex;
        meshObjectIndex[triangleSlot] = command.InstanceId;
        meshMeshletIndex[triangleSlot] = command.MeshletIndex;
#if NJULF_COMMON_SURFACE_COVERAGE_DIAGNOSTICS
        meshCommonSurfaceEligibility[triangleSlot] =
            commonSurfaceEligibility;
#endif
        gl_PrimitiveTriangleIndicesEXT[triangleSlot] = ResolveMirroredInstanceTriangle(
            i0,
            i1,
            i2,
            meshNegativeDeterminant != 0u);
        gl_MeshPrimitivesEXT[triangleSlot].gl_CullPrimitiveEXT =
            !MeshletLodTransitionTriangleVisible(
                command.Flags,
                command.InstanceId,
                command.MeshletIndex,
                triangleSlot);
    }
}
