        <StorageMode>2</StorageMode>
        <Role>3</Role>
      </SimpleDdgiAuditShaderVariant>
      <!-- Admission's generic policy and mutually-exclusive tail source/solve
           policy share one source, but compile into separate native programs.
           This removes the generic private quota workspace from the
           latency-sensitive tail program without creating a second algorithm. -->
      <SimpleDdgiAdmissionShaderVariant Include="ddgi_simple_schedule_admit_tail.comp">
        <Source>ddgi_simple_schedule_admit.comp</Source>
        <Role>1</Role>
      </SimpleDdgiAdmissionShaderVariant>
      <GpuDiagnosticTaskShader Include="depth.task;forward.task;forward_compacted.task" />
      <GpuDiagnosticMeshShader Include="foliage_grass.mesh;foliage_mesh.mesh" />
      <!-- Compile the exact production compaction source with bounded caster
           attribution enabled. Keeping this as a separate native program
           avoids diagnostic atomics in the production culling path. -->
      <GpuDiagnosticComputeShader Include="scene_opaque_compact_diagnostics.comp">
        <Source>scene_opaque_compact.comp</Source>
      </GpuDiagnosticComputeShader>
      <ForwardSimpleFragmentShader Include="forward.frag" />
      <ForwardWeightedOitFragmentShader Include="forward.frag" />
      <FoliageForwardFragmentShader Include="foliage_forward.frag" />
      <MaterialTransportProvenanceShaderVariant Include="forward_opaque_ddgi_provenance.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_OPAQUE=1 -DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <MaterialTransportProvenanceShaderVariant Include="forward_opaque_simple_ddgi_provenance.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <MaterialTransportProvenanceShaderVariant Include="forward_opaque_simple_full_input_ddgi_provenance.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <MaterialTransportProvenanceShaderVariant Include="foliage_forward_ddgi_provenance.frag">
        <Source>foliage_forward.frag</Source>
        <Defines>-DNJULF_MATERIAL_TRANSPORT_PROVENANCE_OUTPUT=1</Defines>
      </MaterialTransportProvenanceShaderVariant>
      <!-- C5's pre-DDGI trace source is a separate opaque/alpha-mask MRT
           program. Never add these defines to the generic or transparent
           forward artifacts: the additional outputs are valid only when the C5
           attachment contract has been admitted by the renderer. -->
      <NearFieldDirectSourceShaderVariant Include="forward_opaque_ddgi_near_field_direct_source.frag">
        <Source>forward.frag</Source>
      <Defines>-DFORWARD_OPAQUE=1 -DNJULF_C5_DIRECT_DIFFUSE_EMISSIVE_OUTPUT=1 -DNJULF_C5_DIRECT_SOURCE_SEMANTICS_VERSION=3</Defines>
      </NearFieldDirectSourceShaderVariant>
      <NearFieldDirectSourceShaderVariant Include="forward_opaque_simple_ddgi_near_field_direct_source.frag">
        <Source>forward.frag</Source>
      <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DNJULF_C5_DIRECT_DIFFUSE_EMISSIVE_OUTPUT=1 -DNJULF_C5_DIRECT_SOURCE_SEMANTICS_VERSION=3</Defines>
      </NearFieldDirectSourceShaderVariant>
      <NearFieldDirectSourceShaderVariant Include="forward_opaque_simple_full_input_ddgi_near_field_direct_source.frag">
        <Source>forward.frag</Source>
      <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DNJULF_C5_DIRECT_DIFFUSE_EMISSIVE_OUTPUT=1 -DNJULF_C5_DIRECT_SOURCE_SEMANTICS_VERSION=3</Defines>
      </NearFieldDirectSourceShaderVariant>
      <!-- C4 receiver facts use a distinct two-attachment opaque MRT variant. -->
      <NearFieldDirectSourceShaderVariant Include="forward_opaque_ddgi_c4_receiver.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_OPAQUE=1 -DNJULF_C4_RECEIVER_OUTPUT=1 -DNJULF_C4_RECEIVER_SEMANTICS_VERSION=1</Defines>
      </NearFieldDirectSourceShaderVariant>
      <NearFieldDirectSourceShaderVariant Include="forward_opaque_simple_ddgi_c4_receiver.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DFORWARD_SIMPLE_VERTEX_INPUT=1 -DNJULF_C4_RECEIVER_OUTPUT=1 -DNJULF_C4_RECEIVER_SEMANTICS_VERSION=1</Defines>
      </NearFieldDirectSourceShaderVariant>
      <NearFieldDirectSourceShaderVariant Include="forward_opaque_simple_full_input_ddgi_c4_receiver.frag">
        <Source>forward.frag</Source>
        <Defines>-DFORWARD_SIMPLE_OPAQUE=1 -DNJULF_C4_RECEIVER_OUTPUT=1 -DNJULF_C4_RECEIVER_SEMANTICS_VERSION=1</Defines>
      </NearFieldDirectSourceShaderVariant>
      <!-- When C4 and C5 are both admitted, a single four-attachment program
           writes both immutable producer contracts. This avoids multiple
           forward geometry submissions and preserves their independent data
           ownership: SceneColor, C4 receiver, C5 source, C5 receiver. -->
